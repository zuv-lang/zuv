    header = header.cat "define ptr @zuv_prm_new(i32 %mode) {\nentry:\n  %p = call ptr @malloc(i64 64)\n  store i64 1347571249, ptr %p\n  %gepState = getelementptr inbounds i64, ptr %p, i64 1\n  store i64 0, ptr %gepState\n  %gepMode = getelementptr inbounds i64, ptr %p, i64 2\n  %mode64 = sext i32 %mode to i64\n  store i64 %mode64, ptr %gepMode\n  %gepVal = getelementptr inbounds i64, ptr %p, i64 3\n  store i64 0, ptr %gepVal\n  %gepSettled = getelementptr inbounds i64, ptr %p, i64 4\n  store i64 0, ptr %gepSettled\n  ret ptr %p\n}\n\n"
    header = header.cat "define void @zuv_prm_resolve(ptr %p, i64 %val) {\nentry:\n  %isNull = icmp eq ptr %p, null\n  br i1 %isNull, label %ret_lbl, label %chk_magic\nchk_magic:\n  %magic = load i64, ptr %p\n  %isPrm = icmp eq i64 %magic, 1347571249\n  br i1 %isPrm, label %chk_settled, label %ret_lbl\nchk_settled:\n  %gepSettled = getelementptr inbounds i64, ptr %p, i64 4\n  %s = load i64, ptr %gepSettled\n  %isSet = icmp ne i64 %s, 0\n  br i1 %isSet, label %ret_lbl, label %do_res\ndo_res:\n  %gepState = getelementptr inbounds i64, ptr %p, i64 1\n  store i64 1, ptr %gepState\n  %gepVal = getelementptr inbounds i64, ptr %p, i64 3\n  store i64 %val, ptr %gepVal\n  store i64 1, ptr %gepSettled\n  br label %ret_lbl\nret_lbl:\n  ret void\n}\n\n"
    header = header.cat "define void @zuv_prm_reject(ptr %p, i64 %err) {\nentry:\n  %isNull = icmp eq ptr %p, null\n  br i1 %isNull, label %ret_lbl, label %chk_magic\nchk_magic:\n  %magic = load i64, ptr %p\n  %isPrm = icmp eq i64 %magic, 1347571249\n  br i1 %isPrm, label %chk_settled, label %ret_lbl\nchk_settled:\n  %gepSettled = getelementptr inbounds i64, ptr %p, i64 4\n  %s = load i64, ptr %gepSettled\n  %isSet = icmp ne i64 %s, 0\n  br i1 %isSet, label %ret_lbl, label %do_rej\ndo_rej:\n  %gepState = getelementptr inbounds i64, ptr %p, i64 1\n  store i64 2, ptr %gepState\n  %gepVal = getelementptr inbounds i64, ptr %p, i64 3\n  store i64 %err, ptr %gepVal\n  store i64 1, ptr %gepSettled\n  br label %ret_lbl\nret_lbl:\n  ret void\n}\n\n"
    header = header.cat "define double @zuv_prm_cb_resolve(double %valDbl) {\nentry:\n  %val = fptosi double %valDbl to i64\n  %p = load ptr, ptr @zuv_active_prm\n  call void @zuv_prm_resolve(ptr %p, i64 %val)\n  ret double 0.0\n}\n\n"
