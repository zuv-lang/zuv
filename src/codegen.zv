    header = header.cat "define i32 @zuv_truncate_file(ptr %path, i64 %len) {\nentry:\n  %fd = call i32 (ptr, i32, ...) @_open(ptr %path, i32 2, i32 438)\n  %isNeg = icmp slt i32 %fd, 0\n  br i1 %isNeg, label %err, label %do_trunc\n\ndo_trunc:\n  %res = call i32 @_chsize_s(i32 %fd, i64 %len)\n  %cl = call i32 @_close(i32 %fd)\n  ret i32 %res\n\nerr:\n  ret i32 -1\n}\n\n"
