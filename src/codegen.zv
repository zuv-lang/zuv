// Full LLVM IR Code Generator for Zuv Self-Hosting Compiler (src/codegen.zv)
imp str, arr

isUpperChar c {
    if c == "A" || c == "B" || c == "C" || c == "D" || c == "E" || c == "F" ||
       c == "G" || c == "H" || c == "I" || c == "J" || c == "K" || c == "L" ||
       c == "M" || c == "N" || c == "O" || c == "P" || c == "Q" || c == "R" ||
       c == "S" || c == "T" || c == "U" || c == "V" || c == "W" || c == "X" ||
       c == "Y" || c == "Z" {
        -> 1
    }
    -> 0
}

createCodegen {
    let syms = []
    let strConsts = []
    let fields = [
        "kind", "val", "line", "col", "name", "value", "left", "right", "op",
        "callee", "args", "elements", "array", "index", "object",
        "property", "typeName", "fields", "init", "condition",
        "increment", "body", "statements", "params", "isAsync",
        "isMut", "elseBranch", "thenBranch", "level", "symbols",
        "paths", "fromPath", "target", "okVar", "okBody", "errVar", "errBody",
        "src", "pos", "totalLen", "ch", "tokens", "curTok", "peekTok", "errors",
        "regCount", "labelCount", "strCount", "strConstants", "fieldNames",
        "breakLabels", "continueLabels", "funcs", "mainBody", "isMain",
        "destructKind", "bindNames", "source",
        "enums", "enumKeys", "enumVals",
        "symKeys", "symIds", "bigintNames", "strNames",
        "__keys", "__vals",
        "tryBody", "catchName", "catchBody", "finallyBody", "tryFrames"
    ]
    let brkStack = []
    let contStack = []
    let tryStack = []
    let exts = []
    let glbDeclList = []
    let enumsList = []
    let enumKeys = []
    let enumVals = []
    let symKeys = []
    let symIds = []
    let bigintNames = []
    let strNames = []
    let restNames = []
    let restIdxs = []
    res = {
        regCount: 0,
        labelCount: 0,
        strCount: 0,
        symbols: syms,
        strConstants: strConsts,
        externDecls: exts,
        fieldNames: fields,
        breakLabels: brkStack,
        continueLabels: contStack,
        tryFrames: tryStack,
        funcs: "",
        mainBody: "",
        isMain: 0,
        glbDeclList: glbDeclList,
        enums: enumsList,
        enumKeys: enumKeys,
        enumVals: enumVals,
        symKeys: symKeys,
        symIds: symIds,
        bigintNames: bigintNames,
        strNames: strNames,
        restNames: restNames,
        restIdxs: restIdxs
    }
    -> res
}

findRestIdx cg, name {
    let i = 0
    wh i < cg.restNames.ln {
        if (strEq cg.restNames[i], name) == 1 {
            -> cg.restIdxs[i]
        }
        i = i + 1
    }
    missing = 0 - 1
    -> missing
}

ensureGlbProp cg, prop {
    // Register LLVM module global `@glb_<prop>` for project-wide storage
    gKey = `glb_${prop}`
    gName = `@${gKey}`
    gSym = findCgSymbol cg, gKey
    if gSym.name == "" {
        addCgSymbol cg, gKey, gName
        cg.glbDeclList.psh (`${gName} = global i64 0\n`)
    }
    -> gName
}

registerEnum cg, enumDecl {
    // Variants packed in enumDecl.src as "Pending,Active,Archived"
    let joined = enumDecl.src
    let start = 0
    let i = 0
    let disc = 0
    wh i <= joined.ln {
        let atEnd = 0
        if i == joined.ln { atEnd = 1 }
        let isComma = 0
        if atEnd == 0 {
            c = joined.sub i, 1
            if (strEq c, ",") == 1 { isComma = 1 }
        }
        if isComma == 1 || atEnd == 1 {
            let vLen = i - start
            if vLen > 0 {
                v = joined.sub start, vLen
                dot = "."
                q1 = enumDecl.name.cat dot
                qKey = q1.cat v
                cg.enumKeys.psh qKey
                cg.enumVals.psh disc
                cg.enumKeys.psh v
                cg.enumVals.psh disc
                disc = disc + 1
            }
            start = i + 1
        }
        i = i + 1
    }
}

lookupEnumDisc cg, pattern {
    let i = 0
    wh i < cg.enumKeys.ln {
        if (strEq cg.enumKeys[i], pattern) == 1 {
            -> cg.enumVals[i]
        }
        i = i + 1
    }
    -> 0 - 1
}

enumDiscLit disc {
    if disc == 0 { -> "0.0" }
    if disc == 1 { -> "1.0" }
    if disc == 2 { -> "2.0" }
    if disc == 3 { -> "3.0" }
    if disc == 4 { -> "4.0" }
    if disc == 5 { -> "5.0" }
    if disc == 6 { -> "6.0" }
    if disc == 7 { -> "7.0" }
    if disc == 8 { -> "8.0" }
    if disc == 9 { -> "9.0" }
    if disc == 10 { -> "10.0" }
    if disc == 11 { -> "11.0" }
    if disc == 12 { -> "12.0" }
    if disc == 13 { -> "13.0" }
    if disc == 14 { -> "14.0" }
    if disc == 15 { -> "15.0" }
    -> "0.0"
}

isEnumName cg, name {
    let i = 0
    wh i < cg.enumKeys.ln {
        k = cg.enumKeys[i]
        if (k.cnt ".") == 1 {
            let j = 0
            wh j < k.ln {
                c = k.sub j, 1
                if (strEq c, ".") == 1 {
                    prefix = k.sub 0, j
                    if (strEq prefix, name) == 1 {
                        -> 1
                    }
                    j = k.ln
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    -> 0
}

strEq s1, s2 {
    if s1 == s2 {
        -> 1
    }
    -> 0
}

// und sentinel: bitcast i64 1 → double (distinct from nil 0.0)
undLit {
    -> "bitcast (i64 1 to double)"
}

emitTruthyI1 cg, condReg, outBuf {
    bits = newReg cg
    outBuf.code = outBuf.code.cat (`  ${bits} = bitcast double ${condReg} to i64\n`)
    isNil = newReg cg
    outBuf.code = outBuf.code.cat (`  ${isNil} = icmp eq i64 ${bits}, 0\n`)
    isUnd = newReg cg
    outBuf.code = outBuf.code.cat (`  ${isUnd} = icmp eq i64 ${bits}, 1\n`)
    isFalsy = newReg cg
    outBuf.code = outBuf.code.cat (`  ${isFalsy} = or i1 ${isNil}, ${isUnd}\n`)
    isTruthy = newReg cg
    outBuf.code = outBuf.code.cat (`  ${isTruthy} = xor i1 ${isFalsy}, true\n`)
    -> isTruthy
}

internSymId cg, key {
    let i = 0
    wh i < cg.symKeys.ln {
        if (strEq cg.symKeys[i], key) == 1 {
            -> cg.symIds[i]
        }
        i = i + 1
    }
    let id = cg.symKeys.ln + 2
    cg.symKeys.psh key
    cg.symIds.psh id
    -> id
}

symDiscLit id {
    if id == 2 { -> "bitcast (i64 2 to double)" }
    if id == 3 { -> "bitcast (i64 3 to double)" }
    if id == 4 { -> "bitcast (i64 4 to double)" }
    if id == 5 { -> "bitcast (i64 5 to double)" }
    if id == 6 { -> "bitcast (i64 6 to double)" }
    if id == 7 { -> "bitcast (i64 7 to double)" }
    if id == 8 { -> "bitcast (i64 8 to double)" }
    if id == 9 { -> "bitcast (i64 9 to double)" }
    if id == 10 { -> "bitcast (i64 10 to double)" }
    if id == 11 { -> "bitcast (i64 11 to double)" }
    if id == 12 { -> "bitcast (i64 12 to double)" }
    if id == 13 { -> "bitcast (i64 13 to double)" }
    if id == 14 { -> "bitcast (i64 14 to double)" }
    if id == 15 { -> "bitcast (i64 15 to double)" }
    if id == 16 { -> "bitcast (i64 16 to double)" }
    -> "bitcast (i64 2 to double)"
}

findFieldOffset cg, fieldName {
    let i = 0
    wh i < cg.fieldNames.ln {
        if (strEq cg.fieldNames[i], fieldName) == 1 {
            -> i
        }
        i = i + 1
    }
    cg.fieldNames.psh fieldName
    -> i
}

newReg cg {
    r = `%r${cg.regCount}`
    cg.regCount = cg.regCount + 1
    -> r
}

newLbl cg, prefix {
    l = `${prefix}_${cg.labelCount}`
    cg.labelCount = cg.labelCount + 1
    -> l
}

findCgSymbol cg, name {
    let i = cg.symbols.ln - 1
    wh i >= 0 {
        s = cg.symbols[i]
        if (strEq s.name, name) == 1 {
            -> s
        }
        i = i - 1
    }
    emptySym = { name: "", reg: "" }
    -> emptySym
}

addCgSymbol cg, name, reg {
    s = { name: name, reg: reg }
    cg.symbols.psh s
}

clearCgLocals cg {
    // Keep only module globals (@...) between function bodies
    let kept = []
    let i = 0
    wh i < cg.symbols.ln {
        s = cg.symbols[i]
        r = s.reg
        if r.ln > 0 {
            pref = r.chr 0
            if pref == "@" {
                kept.psh s
            }
        }
        i = i + 1
    }
    cg.symbols = kept
}

markBigIntVar cg, name {
    cg.bigintNames.psh name
}

isBigIntVar cg, name {
    let i = 0
    wh i < cg.bigintNames.ln {
        if (strEq cg.bigintNames[i], name) == 1 {
            -> 1
        }
        i = i + 1
    }
    -> 0
}

markStrVar cg, name {
    cg.strNames.psh name
}

unmarkStrVar cg, name {
    let kept = []
    let i = 0
    wh i < cg.strNames.ln {
        if (strEq cg.strNames[i], name) == 0 {
            kept.psh cg.strNames[i]
        }
        i = i + 1
    }
    cg.strNames = kept
}

isStrVar cg, name {
    let i = 0
    wh i < cg.strNames.ln {
        if (strEq cg.strNames[i], name) == 1 {
            -> 1
        }
        i = i + 1
    }
    -> 0
}

// True if this expr should participate in string + (concat / number coercion)
isStrPlusOperand cg, expr {
    if expr.kind == "StringExpr" {
        -> 1
    }
    if expr.kind == "UnaryExpr" {
        if expr.op == "typ" {
            -> 1
        }
    }
    if expr.kind == "CastExpr" {
        if expr.targetType == "str" {
            -> 1
        }
    }
    if expr.kind == "VariableExpr" {
        if (isStrVar cg, expr.name) == 1 {
            -> 1
        }
        n = expr.name
        if n == "name" || n == "msg" || n == "str" || n == "text" || n == "path" || n == "file" || n == "cmd" || n == "greeting" || n == "content" {
            -> 1
        }
    }
    if expr.kind == "BinaryExpr" {
        if expr.op == "+" {
            if (isStrPlusOperand cg, expr.left) == 1 {
                -> 1
            }
            if (isStrPlusOperand cg, expr.right) == 1 {
                -> 1
            }
        }
        if expr.op == "??" {
            binL = expr.left
            binR = expr.right
            if (isStrPlusOperand cg, binL) == 1 {
                -> 1
            }
            if (isStrPlusOperand cg, binR) == 1 {
                -> 1
            }
        }
    }
    -> 0
}

addCgExtern cg, extDecl {
    cg.externDecls.psh extDecl
}

findCgExtern cg, name {
    let i = 0
    wh i < cg.externDecls.ln {
        e = cg.externDecls[i]
        if (strEq e.name, name) == 1 {
            -> e
        }
        i = i + 1
    }
    emptyExt = { name: "", typeName: "" }
    -> emptyExt
}

// Known equality type tag for strict == / != (empty = unknown)
strictEqTypTag cg, expr {
    if expr.kind == "StringExpr" { -> "str" }
    if expr.kind == "NumberExpr" {
        // Single-digit 0 / 1 are bool-compatible for == / !=
        if expr.val == "0" {
            -> "bool"
        }
        if expr.val == "1" {
            -> "bool"
        }
        -> "num"
    }
    if expr.kind == "BoolExpr" { -> "bool" }
    if expr.kind == "BigIntExpr" { -> "bigint" }
    if expr.kind == "ArrayExpr" { -> "arr" }
    if expr.kind == "StructLiteral" { -> "obj" }
    if expr.kind == "NilExpr" {
        if expr.val == "und" { -> "und" }
        -> "nil"
    }
    if expr.kind == "BinaryExpr" {
        if expr.op == "==" || expr.op == "!=" || expr.op == "<" || expr.op == ">" || expr.op == "<=" || expr.op == ">=" || expr.op == "and" || expr.op == "or" || expr.op == "&&" || expr.op == "||" {
            -> "bool"
        }
        if expr.op == "+" {
            binL = expr.left
            binR = expr.right
            if (isStrPlusOperand cg, binL) == 1 { -> "str" }
            if (isStrPlusOperand cg, binR) == 1 { -> "str" }
            -> "num"
        }
        if expr.op == "-" || expr.op == "*" || expr.op == "/" || expr.op == "%" || expr.op == "**" || expr.op == "&" || expr.op == "|" || expr.op == "^" || expr.op == "<<" || expr.op == ">>" || expr.op == ">>>" {
            -> "num"
        }
        -> ""
    }
    if expr.kind == "UnaryExpr" {
        if expr.op == "!" || expr.op == "not" { -> "bool" }
        if expr.op == "typ" { -> "str" }
        if expr.op == "-" { -> "num" }
        -> ""
    }
    if expr.kind == "CastExpr" {
        if expr.targetType == "str" { -> "str" }
        if expr.targetType == "bool" { -> "bool" }
        if expr.targetType == "int" || expr.targetType == "i32" || expr.targetType == "i64" || expr.targetType == "num" || expr.targetType == "double" {
            -> "num"
        }
        -> ""
    }
    if expr.kind == "TernaryExpr" {
        // Temps required: avoid `(f cg, expr).thenExpr` juxta/dot misparse
        thenE = expr.thenExpr
        elseE = expr.elseExpr
        tl = strictEqTypTag cg, thenE
        tr = strictEqTypTag cg, elseE
        if tl != "" {
            if (strEq tl, tr) == 1 {
                -> tl
            }
        }
        -> ""
    }
    if expr.kind == "VariableExpr" {
        // Temps required: `isStrVar cg, expr.name` → `(isStrVar cg, expr).name`
        vName = expr.name
        if (isStrVar cg, vName) == 1 { -> "str" }
        if (isBigIntVar cg, vName) == 1 { -> "bigint" }
        -> ""
    }
    -> ""
}

getStrPtrVal cg, expr, outBuf {
    if expr.kind == "StringExpr" {
        sName = addStrConstant cg, expr.val
        -> sName
    } els if expr.kind == "BigIntExpr" {
        sName = addStrConstant cg, expr.val
        -> sName
    } els if expr.kind == "NumberExpr" {
        // Format number as string constant at codegen time when possible
        sName = addStrConstant cg, expr.val
        -> sName
    } els {
        sReg = codegenExpr cg, expr, outBuf
        // Heuristic: VariableExpr/PropertyAccess with string-ish names are pointers;
        // otherwise format the numeric value with snprintf.
        mut isStr = 0
        if expr.kind == "StringExpr" {
            isStr = 1
        }
        if expr.kind == "VariableExpr" {
            n = expr.name
            if (isStrVar cg, n) == 1 {
                isStr = 1
            }
            if n == "name" || n == "msg" || n == "str" || n == "text" || n == "path" || n == "file" || n == "cmd" || n == "greeting" || n == "content" || (n.cnt "type") == 1 || (n.cnt "Type") == 1 {
                isStr = 1
            }
            if (isBigIntVar cg, n) == 1 {
                isStr = 1
            }
        }
        if expr.kind == "CallExpr" {
            if expr.callee == "BigInt" {
                isStr = 1
            }
        }
        if expr.kind == "PropertyAccess" {
            prop = expr.property
            if prop == "name" || prop == "appName" || prop == "msg" || prop == "str" || prop == "text" || prop == "path" || prop == "file" || prop == "cmd" || prop == "kind" {
                isStr = 1
            }
            if expr.object.kind == "VariableExpr" {
                if expr.object.name == "glb" {
                    if prop == "appName" || prop == "name" || prop == "msg" || prop == "str" || prop == "text" || prop == "path" {
                        isStr = 1
                    } els {
                        isStr = 0
                    }
                }
            }
        }
        if expr.kind == "BinaryExpr" {
            if expr.op == "+" {
                if (isStrPlusOperand cg, expr.left) == 1 {
                    isStr = 1
                }
                if (isStrPlusOperand cg, expr.right) == 1 {
                    isStr = 1
                }
            }
        }
        if expr.kind == "UnaryExpr" {
            if expr.op == "typ" {
                isStr = 1
            }
        }
        if isStr == 1 {
            sInt = newReg cg
            outBuf.code = outBuf.code.cat (`  ${sInt} = fptosi double ${sReg} to i64\n`)
            sPtr = newReg cg
            outBuf.code = outBuf.code.cat (`  ${sPtr} = inttoptr i64 ${sInt} to ptr\n`)
            -> sPtr
        } els {
            bufReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${bufReg} = call ptr @malloc(i64 64)\n`)
            snpReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${snpReg} = call i32 (ptr, i64, ptr, ...) @snprintf(ptr ${bufReg}, i64 64, ptr @fmt_g, double ${sReg})\n`)
            -> bufReg
        }
    }
}

addStrConstant cg, strVal {
    sName = `@str_${cg.strCount}`
    cg.strCount = cg.strCount + 1
    let escaped = ""
    let byteCount = 0
    let i = 0
    wh i < strVal.ln {
        c = strVal.sub i, 1
        if c == `"` {
            escaped = escaped.cat "\\22"
            byteCount = byteCount + 1
        } els if c == "\\" {
            escaped = escaped.cat "\\5C"
            byteCount = byteCount + 1
        } els if c == "\n" {
            escaped = escaped.cat "\\0A"
            byteCount = byteCount + 1
        } els {
            escaped = escaped.cat c
            byteCount = byteCount + 1
        }
        i = i + 1
    }
    l = byteCount + 1
    decl = `${sName} = private unnamed_addr constant [${l} x i8] c"${escaped}\\00"\n`
    cg.strConstants.psh decl
    -> sName
}

digitValue ch {
    if ch == "0" { -> 0 }
    if ch == "1" { -> 1 }
    if ch == "2" { -> 2 }
    if ch == "3" { -> 3 }
    if ch == "4" { -> 4 }
    if ch == "5" { -> 5 }
    if ch == "6" { -> 6 }
    if ch == "7" { -> 7 }
    if ch == "8" { -> 8 }
    if ch == "9" { -> 9 }
    if ch == "a" || ch == "A" { -> 10 }
    if ch == "b" || ch == "B" { -> 11 }
    if ch == "c" || ch == "C" { -> 12 }
    if ch == "d" || ch == "D" { -> 13 }
    if ch == "e" || ch == "E" { -> 14 }
    if ch == "f" || ch == "F" { -> 15 }
    -> 0
}

formatFloat valStr {
    // IEEE specials (must run before 0x base conversion)
    if valStr == "nan" {
        -> "0x7FF8000000000000"
    }
    if valStr == "inf" {
        -> "0x7FF0000000000000"
    }
    // Convert 0x / 0b / 0o literals to decimal before emitting LLVM constants
    if valStr.ln >= 3 {
        p0 = valStr.sub 0, 1
        p1 = valStr.sub 1, 1
        if p0 == "0" {
            digLen = valStr.ln - 2
            digs = valStr.sub 2, digLen
            mut base = 0
            if p1 == "x" || p1 == "X" { base = 16 }
            if p1 == "b" || p1 == "B" { base = 2 }
            if p1 == "o" || p1 == "O" { base = 8 }
            if base != 0 {
                let n = 0
                let i = 0
                wh i < digs.ln {
                    ch = digs.sub i, 1
                    d = digitValue ch
                    n = n * base + d
                    i = i + 1
                }
                -> `${n}.0`
            }
        }
    }
    // LLVM requires a decimal point in float constants (123e2 → 123.0e2)
    if (valStr.cnt "e") == 1 || (valStr.cnt "E") == 1 {
        if (valStr.cnt ".") == 1 {
            -> valStr
        }
        let out = ""
        let i = 0
        wh i < valStr.ln {
            c = valStr.sub i, 1
            if c == "e" || c == "E" {
                out = out.cat ".0"
                out = out.cat c
            } els {
                out = out.cat c
            }
            i = i + 1
        }
        -> out
    }
    if (valStr.cnt ".") == 1 {
        -> valStr
    }
    resStr = `${valStr}.0`
    -> resStr
}

classifyTyp cg, expr {
    if expr.kind == "" || expr.kind == "NilExpr" {
        if expr.val == "und" {
            -> "und"
        }
        -> "nil"
    }
    if expr.kind == "StringExpr" {
        -> "str"
    }
    if expr.kind == "NumberExpr" {
        -> "num"
    }
    if expr.kind == "BigIntExpr" {
        -> "bigint"
    }
    if expr.kind == "BoolExpr" {
        -> "bool"
    }
    if expr.kind == "ArrayExpr" {
        -> "arr"
    }
    if expr.kind == "StructLiteral" {
        -> "obj"
    }
    if expr.kind == "ResultExpr" {
        -> "obj"
    }
    if expr.kind == "TypExpr" || (expr.kind == "UnaryExpr" && expr.op == "typ") {
        -> "str"
    }
    if expr.kind == "UnaryExpr" && expr.op == "sym" {
        -> "sym"
    }
    if expr.kind == "UnaryExpr" {
        if expr.op == "!" || expr.op == "not" {
            -> "bool"
        }
        if expr.op == "-" {
            -> "num"
        }
        -> classifyTyp cg, expr.right
    }
    if expr.kind == "BinaryExpr" {
        if expr.op == "+" {
            if (isStrPlusOperand cg, expr.left) == 1 {
                -> "str"
            }
            if (isStrPlusOperand cg, expr.right) == 1 {
                -> "str"
            }
        }
        if expr.op == "==" || expr.op == "!=" || expr.op == "<" || expr.op == ">" || expr.op == "<=" || expr.op == ">=" || expr.op == "and" || expr.op == "or" {
            -> "bool"
        }
        if expr.op == "=" {
            -> classifyTyp cg, expr.right
        }
        -> "num"
    }
    if expr.kind == "CastExpr" {
        castTypStr = expr.targetType
        if castTypStr == "str" {
            -> "str"
        }
        if castTypStr == "bool" {
            -> "bool"
        }
        if castTypStr == "ptr" {
            -> "str"
        }
        if castTypStr == "*byte" {
            -> "str"
        }
        if castTypStr == "*num" {
            -> "str"
        }
        if castTypStr == "*any" {
            -> "str"
        }
        -> "num"
    }
    if expr.kind == "CallExpr" {
        if expr.callee == "BigInt" {
            -> "bigint"
        }
        if expr.callee == "isNan" || expr.callee == "isnan" || expr.callee == "isFin" || expr.callee == "isfinite" || expr.callee == "isFinite" {
            -> "bool"
        }
        if expr.callee == "rF" || expr.callee == "sub" || expr.callee == "substr" || expr.callee == "slc" || expr.callee == "slice" || expr.callee == "cat" || expr.callee == "concat" || expr.callee == "chr" || expr.callee == "charAt" || expr.callee == "addStrConstant" || expr.callee == "newReg" || expr.callee == "newLbl" {
            -> "str"
        }
        -> "num"
    }
    if expr.kind == "PropertyAccess" {
        if expr.property == "ln" || expr.property == "len" || expr.property == "length" {
            -> "num"
        }
        if expr.property == "title" || expr.property == "name" || expr.property == "msg" || expr.property == "str" || expr.property == "text" || expr.property == "content" || expr.property == "path" || expr.property == "file" || expr.property == "cmd" || expr.property == "kind" || expr.property == "ch" || expr.property == "src" || expr.property == "code" || expr.property == "reg" || expr.property == "lbl" || expr.property == "callee" || expr.property == "op" {
            -> "str"
        }
        -> "num"
    }
    if expr.kind == "IndexExpr" {
        if expr.array.kind == "StringExpr" {
            -> "str"
        }
        -> "num"
    }
    if expr.kind == "VariableExpr" {
        n = expr.name
        if (isBigIntVar cg, n) == 1 {
            -> "bigint"
        }
        if (isStrVar cg, n) == 1 {
            -> "str"
        }
        if n == "ch" || n == "char" || (n.cnt "str") == 1 || (n.cnt "name") == 1 || (n.cnt "path") == 1 || (n.cnt "msg") == 1 || (n.cnt "text") == 1 || (n.cnt "code") == 1 || (n.cnt "file") == 1 {
            -> "str"
        }
        -> "num"
    }
    -> "und"
}

codegenExpr cg, expr, outBuf {
    if expr.kind == "NumberExpr" {
        -> formatFloat expr.val
    } els if expr.kind == "BigIntExpr" {
        sName = addStrConstant cg, expr.val
        intReg = newReg cg
        outBuf.code = outBuf.code.cat (`  ${intReg} = ptrtoint ptr ${sName} to i64\n`)
        dblReg = newReg cg
        outBuf.code = outBuf.code.cat (`  ${dblReg} = sitofp i64 ${intReg} to double\n`)
        -> dblReg
    } els if expr.kind == "BoolExpr" {
        if expr.val == "yes" || expr.val == "true" {
            -> "1.0"
        }
        -> "0.0"
    } els if expr.kind == "NilExpr" {
        if expr.val == "und" {
            -> undLit
        }
        -> "0.0"
    } els if expr.kind == "StringExpr" {
        sName = addStrConstant cg, expr.val
        intReg = newReg cg
        outBuf.code = outBuf.code.cat (`  ${intReg} = ptrtoint ptr ${sName} to i64\n`)
        dblReg = newReg cg
        outBuf.code = outBuf.code.cat (`  ${dblReg} = sitofp i64 ${intReg} to double\n`)
        -> dblReg
    } els if expr.kind == "VariableExpr" {
        extInfo = findCgExtern cg, expr.name
        if extInfo.name != "" {
            let retType = "i32"
            if extInfo.typeName == "void" {
                retType = "void"
            } els if extInfo.typeName == "str" || extInfo.typeName == "ptr" {
                retType = "ptr"
            } els if extInfo.typeName == "double" {
                retType = "double"
            } els if extInfo.typeName == "i64" {
                retType = "i64"
            } els if extInfo.typeName == "num" || extInfo.typeName == "i32" {
                retType = "i32"
            }
            if retType == "void" {
                outBuf.code = outBuf.code.cat (`  call void @${expr.name}()\n`)
                -> "0.0"
            }
            cReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${cReg} = call ${retType} @${expr.name}()\n`)
            if retType == "i32" {
                dReg = newReg cg
                outBuf.code = outBuf.code.cat (`  ${dReg} = sitofp i32 ${cReg} to double\n`)
                -> dReg
            } els if retType == "i64" {
                dReg = newReg cg
                outBuf.code = outBuf.code.cat (`  ${dReg} = sitofp i64 ${cReg} to double\n`)
                -> dReg
            } els if retType == "ptr" {
                pInt = newReg cg
                outBuf.code = outBuf.code.cat (`  ${pInt} = ptrtoint ptr ${cReg} to i64\n`)
                dReg = newReg cg
                outBuf.code = outBuf.code.cat (`  ${dReg} = sitofp i64 ${pInt} to double\n`)
                -> dReg
            }
            -> cReg
        }
        cgSym = findCgSymbol cg, expr.name
        if cgSym.name != "" {
            valReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${valReg} = load double, ptr ${cgSym.reg}\n`)
            -> valReg
        }
        if expr.name == "PI" { -> "3.141592653589793" }
        if expr.name == "E" { -> "2.718281828459045" }
        if expr.name == "rand" {
            rI = newReg cg
            outBuf.code = outBuf.code.cat (`  ${rI} = call i32 @rand()\n`)
            rD = newReg cg
            outBuf.code = outBuf.code.cat (`  ${rD} = sitofp i32 ${rI} to double\n`)
            resReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${resReg} = fdiv double ${rD}, 32767.0\n`)
            -> resReg
        }
        -> "0.0"
    } els if expr.kind == "BinaryExpr" {
        // Nullish coalescing: left ?? right — use right only if left is nil/und
        if expr.op == "??" {
            leftE = expr.left
            rightE = expr.right
            slot = newReg cg
            outBuf.code = outBuf.code.cat (`  ${slot} = alloca double\n`)
            leftReg = codegenExpr cg, leftE, outBuf
            bits = newReg cg
            outBuf.code = outBuf.code.cat (`  ${bits} = bitcast double ${leftReg} to i64\n`)
            isNil = newReg cg
            outBuf.code = outBuf.code.cat (`  ${isNil} = icmp eq i64 ${bits}, 0\n`)
            isUnd = newReg cg
            outBuf.code = outBuf.code.cat (`  ${isUnd} = icmp eq i64 ${bits}, 1\n`)
            isNullish = newReg cg
            outBuf.code = outBuf.code.cat (`  ${isNullish} = or i1 ${isNil}, ${isUnd}\n`)
            useRight = newLbl cg, "nullish_rhs"
            useLeft = newLbl cg, "nullish_lhs"
            mergeLbl = newLbl cg, "nullish_merge"
            outBuf.code = outBuf.code.cat (`  br i1 ${isNullish}, label %${useRight}, label %${useLeft}\n\n`)
            outBuf.code = outBuf.code.cat (`${useLeft}:\n`)
            outBuf.code = outBuf.code.cat (`  store double ${leftReg}, ptr ${slot}\n`)
            outBuf.code = outBuf.code.cat (`  br label %${mergeLbl}\n\n`)
            outBuf.code = outBuf.code.cat (`${useRight}:\n`)
            rightReg = codegenExpr cg, rightE, outBuf
            outBuf.code = outBuf.code.cat (`  store double ${rightReg}, ptr ${slot}\n`)
            outBuf.code = outBuf.code.cat (`  br label %${mergeLbl}\n\n`)
            outBuf.code = outBuf.code.cat (`${mergeLbl}:\n`)
            resReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${resReg} = load double, ptr ${slot}\n`)
            -> resReg
        }
        if expr.op == "=" {
            rightReg = codegenExpr cg, expr.right, outBuf
            if expr.left.kind == "DerefExpr" {
                ptrVal = codegenExpr cg, expr.left.operand, outBuf
                ptrInt = newReg cg
                outBuf.code = outBuf.code.cat (`  ${ptrInt} = fptosi double ${ptrVal} to i64\n`)
                rawPtr = newReg cg
                outBuf.code = outBuf.code.cat (`  ${rawPtr} = inttoptr i64 ${ptrInt} to ptr\n`)
                outBuf.code = outBuf.code.cat (`  store double ${rightReg}, ptr ${rawPtr}\n`)
                -> rightReg
            } els if expr.left.kind == "VariableExpr" {
                cgSym = findCgSymbol cg, expr.left.name
                if cgSym.name != "" {
                    outBuf.code = outBuf.code.cat (`  store double ${rightReg}, ptr ${cgSym.reg}\n`)
                }
                // Propagate string-ness from RHS variable or keys index
                if expr.right.kind == "VariableExpr" {
                    rn = expr.right.name
                    if (rn.cnt "__fin_i") == 1 {
                        unmarkStrVar cg, expr.left.name
                    } els if (isStrVar cg, rn) == 1 {
                        markStrVar cg, expr.left.name
                    }
                }
                if expr.right.kind == "IndexExpr" {
                    if expr.right.array.kind == "VariableExpr" {
                        an = expr.right.array.name
                        // Only mark when the keys temp name is uniquely object-side
                        if (an.cnt "__fin_ks") == 1 {
                            markStrVar cg, expr.left.name
                        }
                    }
                }
            } els if expr.left.kind == "PropertyAccess" {
                // Project-wide `glb.prop` → LLVM store to module global @glb_<prop>
                if expr.left.object.kind == "VariableExpr" {
                    if expr.left.object.name == "glb" {
                        gName = ensureGlbProp cg, expr.left.property
                        rInt = newReg cg
                        outBuf.code = outBuf.code.cat (`  ${rInt} = bitcast double ${rightReg} to i64\n`)
                        outBuf.code = outBuf.code.cat (`  store i64 ${rInt}, ptr ${gName}\n`)
                        -> rightReg
                    }
                    let isTypeObj = 0
                    if expr.left.object.name.ln > 0 {
                        c0TO = expr.left.object.name.chr 0
                        if c0TO == "A" || c0TO == "B" || c0TO == "C" || c0TO == "D" || c0TO == "E" || c0TO == "F" ||
                           c0TO == "G" || c0TO == "H" || c0TO == "I" || c0TO == "J" || c0TO == "K" || c0TO == "L" ||
                           c0TO == "M" || c0TO == "N" || c0TO == "O" || c0TO == "P" || c0TO == "Q" || c0TO == "R" ||
                           c0TO == "S" || c0TO == "T" || c0TO == "U" || c0TO == "V" || c0TO == "W" || c0TO == "X" ||
                           c0TO == "Y" || c0TO == "Z" {
                            isTypeObj = 1
                        }
                    }
                    if isTypeObj == 1 {
                        -> rightReg
                    }
                }
                objReg = codegenExpr cg, expr.left.object, outBuf
                objInt = newReg cg
                outBuf.code = outBuf.code.cat (`  ${objInt} = fptosi double ${objReg} to i64\n`)
                objPtr = newReg cg
                outBuf.code = outBuf.code.cat (`  ${objPtr} = inttoptr i64 ${objInt} to ptr\n`)
                fOffset = findFieldOffset cg, expr.left.property
                gepReg = newReg cg
                outBuf.code = outBuf.code.cat (`  ${gepReg} = getelementptr inbounds i64, ptr ${objPtr}, i64 ${fOffset}\n`)
                rInt = newReg cg
                outBuf.code = outBuf.code.cat (`  ${rInt} = bitcast double ${rightReg} to i64\n`)
                outBuf.code = outBuf.code.cat (`  store i64 ${rInt}, ptr ${gepReg}\n`)
            } els if expr.left.kind == "IndexExpr" {
                arrReg = codegenExpr cg, expr.left.array, outBuf
                idxReg = codegenExpr cg, expr.left.index, outBuf
                arrInt = newReg cg
                outBuf.code = outBuf.code.cat (`  ${arrInt} = fptosi double ${arrReg} to i64\n`)
                arrPtr = newReg cg
                outBuf.code = outBuf.code.cat (`  ${arrPtr} = inttoptr i64 ${arrInt} to ptr\n`)
                idxInt = newReg cg
                outBuf.code = outBuf.code.cat (`  ${idxInt} = fptosi double ${idxReg} to i64\n`)
                elemIdx = newReg cg
                outBuf.code = outBuf.code.cat (`  ${elemIdx} = add i64 ${idxInt}, 1\n`)
                gepReg = newReg cg
                outBuf.code = outBuf.code.cat (`  ${gepReg} = getelementptr inbounds i64, ptr ${arrPtr}, i64 ${elemIdx}\n`)
                rInt = newReg cg
                outBuf.code = outBuf.code.cat (`  ${rInt} = bitcast double ${rightReg} to i64\n`)
                outBuf.code = outBuf.code.cat (`  store i64 ${rInt}, ptr ${gepReg}\n`)
            }
            -> rightReg
        }

        leftReg = codegenExpr cg, expr.left, outBuf
        rightReg = codegenExpr cg, expr.right, outBuf

        mut isStrAdd = 0
        if (isStrPlusOperand cg, expr.left) == 1 {
            isStrAdd = 1
        }
        if (isStrPlusOperand cg, expr.right) == 1 {
            isStrAdd = 1
        }

        if expr.op == "+" {
            if isStrAdd == 1 {
                s1Ptr = getStrPtrVal cg, expr.left, outBuf
                s2Ptr = getStrPtrVal cg, expr.right, outBuf
                l1 = newReg cg
                outBuf.code = outBuf.code.cat (`  ${l1} = call i64 @strlen(ptr ${s1Ptr})\n`)
                l2 = newReg cg
                outBuf.code = outBuf.code.cat (`  ${l2} = call i64 @strlen(ptr ${s2Ptr})\n`)
                totLen = newReg cg
                outBuf.code = outBuf.code.cat (`  ${totLen} = add i64 ${l1}, ${l2}\n`)
                allocLen = newReg cg
                outBuf.code = outBuf.code.cat (`  ${allocLen} = add i64 ${totLen}, 1\n`)
                bufReg = newReg cg
                outBuf.code = outBuf.code.cat (`  ${bufReg} = call ptr @malloc(i64 ${allocLen})\n`)
                cpy1 = newReg cg
                outBuf.code = outBuf.code.cat (`  ${cpy1} = call ptr @memcpy(ptr ${bufReg}, ptr ${s1Ptr}, i64 ${l1})\n`)
                dest2 = newReg cg
                outBuf.code = outBuf.code.cat (`  ${dest2} = getelementptr inbounds i8, ptr ${bufReg}, i64 ${l1}\n`)
                cpy2 = newReg cg
                outBuf.code = outBuf.code.cat (`  ${cpy2} = call ptr @memcpy(ptr ${dest2}, ptr ${s2Ptr}, i64 ${l2})\n`)
                nullTerm = newReg cg
                outBuf.code = outBuf.code.cat (`  ${nullTerm} = getelementptr inbounds i8, ptr ${bufReg}, i64 ${totLen}\n`)
                outBuf.code = outBuf.code.cat (`  store i8 0, ptr ${nullTerm}\n`)
                bufInt = newReg cg
                outBuf.code = outBuf.code.cat (`  ${bufInt} = ptrtoint ptr ${bufReg} to i64\n`)
                resReg = newReg cg
                outBuf.code = outBuf.code.cat (`  ${resReg} = sitofp i64 ${bufInt} to double\n`)
                -> resReg
            }
            resReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${resReg} = fadd double ${leftReg}, ${rightReg}\n`)
            -> resReg
        }

        if expr.op == "-" {
            resReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${resReg} = fsub double ${leftReg}, ${rightReg}\n`)
            -> resReg
        }

        if expr.op == "*" {
            resReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${resReg} = fmul double ${leftReg}, ${rightReg}\n`)
            -> resReg
        }

        if expr.op == "**" {
            resReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${resReg} = call double @llvm.pow.f64(double ${leftReg}, double ${rightReg})\n`)
            -> resReg
        }

        if expr.op == "/" {
            resReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${resReg} = fdiv double ${leftReg}, ${rightReg}\n`)
            -> resReg
        }

        if expr.op == "%" {
            resReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${resReg} = frem double ${leftReg}, ${rightReg}\n`)
            -> resReg
        }

        // `as` cast may arrive as BinaryExpr if infix path used
        if expr.op == "as" {
            mut t = ""
            if expr.right.kind == "VariableExpr" {
                t = expr.right.name
            }
            if expr.right.kind == "UnaryExpr" {
                if expr.right.op == "*" {
                    if expr.right.right.kind == "VariableExpr" {
                        t = "*" + expr.right.right.name
                    }
                }
            }
            if t == "int" || t == "i32" || t == "i64" {
                asInt = newReg cg
                outBuf.code = outBuf.code.cat (`  ${asInt} = fptosi double ${leftReg} to i64\n`)
                asDbl = newReg cg
                outBuf.code = outBuf.code.cat (`  ${asDbl} = sitofp i64 ${asInt} to double\n`)
                -> asDbl
            }
            if t == "num" || t == "double" {
                -> leftReg
            }
        if t == "bool" {
            bBits = newReg cg
            outBuf.code = outBuf.code.cat (`  ${bBits} = bitcast double ${leftReg} to i64\n`)
            bIsNil = newReg cg
            outBuf.code = outBuf.code.cat (`  ${bIsNil} = icmp eq i64 ${bBits}, 0\n`)
            bIsUnd = newReg cg
            outBuf.code = outBuf.code.cat (`  ${bIsUnd} = icmp eq i64 ${bBits}, 1\n`)
            bFalsy = newReg cg
            outBuf.code = outBuf.code.cat (`  ${bFalsy} = or i1 ${bIsNil}, ${bIsUnd}\n`)
            boolI1 = newReg cg
            outBuf.code = outBuf.code.cat (`  ${boolI1} = xor i1 ${bFalsy}, true\n`)
            asDbl = newReg cg
            outBuf.code = outBuf.code.cat (`  ${asDbl} = uitofp i1 ${boolI1} to double\n`)
            -> asDbl
        }
            if t == "*byte" || t == "*num" || t == "*any" || t == "ptr" {
                bits = newReg cg
                outBuf.code = outBuf.code.cat (`  ${bits} = bitcast double ${leftReg} to i64\n`)
                asDbl = newReg cg
                outBuf.code = outBuf.code.cat (`  ${asDbl} = sitofp i64 ${bits} to double\n`)
                -> asDbl
            }
            if t == "str" {
                buf = newReg cg
                outBuf.code = outBuf.code.cat (`  ${buf} = call ptr @malloc(i64 64)\n`)
                snp = newReg cg
                outBuf.code = outBuf.code.cat (`  ${snp} = call i32 (ptr, i64, ptr, ...) @snprintf(ptr ${buf}, i64 64, ptr @fmt_g, double ${leftReg})\n`)
                asInt = newReg cg
                outBuf.code = outBuf.code.cat (`  ${asInt} = ptrtoint ptr ${buf} to i64\n`)
                asDbl = newReg cg
                outBuf.code = outBuf.code.cat (`  ${asDbl} = sitofp i64 ${asInt} to double\n`)
                -> asDbl
            }
            -> leftReg
        }

        if expr.op == "&" || expr.op == "|" || expr.op == "^" || expr.op == "<<" || expr.op == ">>" || expr.op == ">>>" {
            li = newReg cg
            outBuf.code = outBuf.code.cat (`  ${li} = fptosi double ${leftReg} to i64\n`)
            ri = newReg cg
            outBuf.code = outBuf.code.cat (`  ${ri} = fptosi double ${rightReg} to i64\n`)
            bit = newReg cg
            if expr.op == "&" {
                outBuf.code = outBuf.code.cat (`  ${bit} = and i64 ${li}, ${ri}\n`)
            } els if expr.op == "|" {
                outBuf.code = outBuf.code.cat (`  ${bit} = or i64 ${li}, ${ri}\n`)
            } els if expr.op == "^" {
                outBuf.code = outBuf.code.cat (`  ${bit} = xor i64 ${li}, ${ri}\n`)
            } els if expr.op == "<<" {
                outBuf.code = outBuf.code.cat (`  ${bit} = shl i64 ${li}, ${ri}\n`)
            } els if expr.op == ">>" {
                outBuf.code = outBuf.code.cat (`  ${bit} = ashr i64 ${li}, ${ri}\n`)
            } els {
                outBuf.code = outBuf.code.cat (`  ${bit} = lshr i64 ${li}, ${ri}\n`)
            }
            resReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${resReg} = sitofp i64 ${bit} to double\n`)
            -> resReg
        }

        mut isStrCmp = 0
        if expr.left.kind == "StringExpr" {
            isStrCmp = 1
        }
        if expr.right.kind == "StringExpr" {
            isStrCmp = 1
        }
        if expr.left.kind == "BigIntExpr" {
            isStrCmp = 1
        }
        if expr.right.kind == "BigIntExpr" {
            isStrCmp = 1
        }
        if expr.left.kind == "CallExpr" {
            if expr.left.callee == "BigInt" {
                isStrCmp = 1
            }
        }
        if expr.right.kind == "CallExpr" {
            if expr.right.callee == "BigInt" {
                isStrCmp = 1
            }
        }
        if expr.left.kind == "VariableExpr" {
            if (isBigIntVar cg, expr.left.name) == 1 {
                isStrCmp = 1
            }
        }
        if expr.right.kind == "VariableExpr" {
            if (isBigIntVar cg, expr.right.name) == 1 {
                isStrCmp = 1
            }
        }
        if expr.left.kind == "UnaryExpr" {
            if expr.left.op == "typ" {
                isStrCmp = 1
            }
        }
        if expr.right.kind == "UnaryExpr" {
            if expr.right.op == "typ" {
                isStrCmp = 1
            }
        }
        // Don't strcmp against bare numbers/bools (123n != 123 must stay unequal)
        mut isNumSide = 0
        if expr.left.kind == "NumberExpr" || expr.left.kind == "BoolExpr" {
            isNumSide = 1
        }
        if expr.right.kind == "NumberExpr" || expr.right.kind == "BoolExpr" {
            isNumSide = 1
        }
        if isNumSide == 1 {
            isStrCmp = 0
        }

        // Strict == / != across known typ tags only
        if expr.op == "==" || expr.op == "!=" {
            leftE = expr.left
            rightE = expr.right
            eqTypL = strictEqTypTag cg, leftE
            eqTypR = strictEqTypTag cg, rightE
            // Use strEq (not !=) so empty checks don't depend on string != codegen
            if (strEq eqTypL, "") == 0 {
                if (strEq eqTypR, "") == 0 {
                    if (strEq eqTypL, eqTypR) == 0 {
                        if expr.op == "==" {
                            -> "0.0"
                        }
                        -> "1.0"
                    }
                }
            }
        }

        if expr.op == "==" {
            if isStrCmp == 1 {
                s1Ptr = getStrPtrVal cg, expr.left, outBuf
                s2Ptr = getStrPtrVal cg, expr.right, outBuf
                cmpReg = newReg cg
                outBuf.code = outBuf.code.cat (`  ${cmpReg} = call i32 @strcmp(ptr ${s1Ptr}, ptr ${s2Ptr})\n`)
                eqReg = newReg cg
                outBuf.code = outBuf.code.cat (`  ${eqReg} = icmp eq i32 ${cmpReg}, 0\n`)
                resReg = newReg cg
                outBuf.code = outBuf.code.cat (`  ${resReg} = uitofp i1 ${eqReg} to double\n`)
                -> resReg
            }
            cmpReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${cmpReg} = fcmp oeq double ${leftReg}, ${rightReg}\n`)
            resReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${resReg} = uitofp i1 ${cmpReg} to double\n`)
            -> resReg
        }

        if expr.op == "!=" {
            if isStrCmp == 1 {
                s1Ptr = getStrPtrVal cg, expr.left, outBuf
                s2Ptr = getStrPtrVal cg, expr.right, outBuf
                cmpReg = newReg cg
                outBuf.code = outBuf.code.cat (`  ${cmpReg} = call i32 @strcmp(ptr ${s1Ptr}, ptr ${s2Ptr})\n`)
                neReg = newReg cg
                outBuf.code = outBuf.code.cat (`  ${neReg} = icmp ne i32 ${cmpReg}, 0\n`)
                resReg = newReg cg
                outBuf.code = outBuf.code.cat (`  ${resReg} = uitofp i1 ${neReg} to double\n`)
                -> resReg
            }
            cmpReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${cmpReg} = fcmp one double ${leftReg}, ${rightReg}\n`)
            resReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${resReg} = uitofp i1 ${cmpReg} to double\n`)
            -> resReg
        }

        if expr.op == "<" {
            cmpReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${cmpReg} = fcmp olt double ${leftReg}, ${rightReg}\n`)
            resReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${resReg} = uitofp i1 ${cmpReg} to double\n`)
            -> resReg
        }

        if expr.op == "<=" {
            cmpReg = newReg cg
