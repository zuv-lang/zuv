    header = header.cat "define i64 @zuv_prm_await(i64 %val) {\nentry:\n  %isSmall = icmp ult i64 %val, 65536\n  br i1 %isSmall, label %ret_val, label %chk_align\nchk_align:\n  %lowBits = and i64 %val, 7\n  %isAligned = icmp eq i64 %lowBits, 0\n  br i1 %isAligned, label %chk_high, label %ret_val\nchk_high:\n  %isTooHigh = icmp ugt i64 %val, 140737488355327\n  br i1 %isTooHigh, label %ret_val, label %chk_ptr\nchk_ptr:\n  %ptr = inttoptr i64 %val to ptr\n  %magic = load i64, ptr %ptr\n  %isPrm = icmp eq i64 %magic, 1347571249\n  br i1 %isPrm, label %wait_loop, label %ret_val\nwait_loop:\n  %gepSettled = getelementptr inbounds i64, ptr %ptr, i64 4\n  %st = load i64, ptr %gepSettled\n  %isDone = icmp ne i64 %st, 0\n  br i1 %isDone, label %unpack, label %poll_step\npoll_step:\n  call void @Sleep(i32 1)\n  br label %wait_loop\nunpack:\n  %gepState = getelementptr inbounds i64, ptr %ptr, i64 1\n  %state = load i64, ptr %gepState\n  %gepVal = getelementptr inbounds i64, ptr %ptr, i64 3\n  %v = load i64, ptr %gepVal\n  %isRej = icmp eq i64 %state, 2\n  br i1 %isRej, label %handle_rej, label %handle_ok\nhandle_rej:\n  store i64 %v, ptr @zuv_exc_value\n  store i32 1, ptr @zuv_prm_is_rejected\n  ret i64 %v\nhandle_ok:\n  store i32 0, ptr @zuv_prm_is_rejected\n  ret i64 %v\nret_val:\n  store i32 0, ptr @zuv_prm_is_rejected\n  ret i64 %val\n}\n\n"
    header = header.cat "define ptr @zuv_prm_all(ptr %arr) {\nentry:\n  %mode = call i32 @zuv_get_async_context()\n  %parentPrm = call ptr @zuv_prm_new(i32 %mode)\n  %isNull = icmp eq ptr %arr, null\n  br i1 %isNull, label %ret_empty, label %chk_len\nchk_len:\n  %dLen = load double, ptr %arr\n  %iLen = fptosi double %dLen to i64\n  %isZero = icmp sle i64 %iLen, 0\n  br i1 %isZero, label %ret_empty, label %alloc_res\nret_empty:\n  %empty = call ptr @malloc(i64 16)\n  store double 0.0, ptr %empty\n  %emptyInt = ptrtoint ptr %empty to i64\n  call void @zuv_prm_resolve(ptr %parentPrm, i64 %emptyInt)\n  ret ptr %parentPrm\nalloc_res:\n  %arrBytes = add i64 %iLen, 1\n  %arrBytesMul = mul i64 %arrBytes, 8\n  %resArr = call ptr @malloc(i64 %arrBytesMul)\n  store double %dLen, ptr %resArr\n  %pIdx = alloca i64\n  store i64 0, ptr %pIdx\n  br label %all_loop\nall_loop:\n  %idx = load i64, ptr %pIdx\n  %cmp = icmp slt i64 %idx, %iLen\n  br i1 %cmp, label %all_body, label %all_done\nall_body:\n  %slotIdx = add i64 %idx, 1\n  %pItem = getelementptr inbounds i64, ptr %arr, i64 %slotIdx\n  %rawItemBits = load i64, ptr %pItem\n  %rawItemDbl = bitcast i64 %rawItemBits to double\n  %rawItem = fptosi double %rawItemDbl to i64\n  %unwrapped = call i64 @zuv_prm_await(i64 %rawItem)\n  %isRej = load i32, ptr @zuv_prm_is_rejected\n  %hasRej = icmp ne i32 %isRej, 0\n  br i1 %hasRej, label %all_rej, label %all_next\nall_rej:\n  call void @zuv_prm_reject(ptr %parentPrm, i64 %unwrapped)\n  ret ptr %parentPrm\nall_next:\n  %unwrappedDbl = sitofp i64 %unwrapped to double\n  %unwrappedBits = bitcast double %unwrappedDbl to i64\n  %pDest = getelementptr inbounds i64, ptr %resArr, i64 %slotIdx\n  store i64 %unwrappedBits, ptr %pDest\n  %nextIdx = add i64 %idx, 1\n  store i64 %nextIdx, ptr %pIdx\n  br label %all_loop\nall_done:\n  %resArrInt = ptrtoint ptr %resArr to i64\n  call void @zuv_prm_resolve(ptr %parentPrm, i64 %resArrInt)\n  ret ptr %parentPrm\n}\n\n"
    header = header.cat "define ptr @zuv_prm_race(ptr %arr) {\nentry:\n  %mode = call i32 @zuv_get_async_context()\n  %parentPrm = call ptr @zuv_prm_new(i32 %mode)\n  %isNull = icmp eq ptr %arr, null\n  br i1 %isNull, label %ret_race, label %chk_len_race\nchk_len_race:\n  %dLenR = load double, ptr %arr\n  %len = fptosi double %dLenR to i64\n  %isZero = icmp sle i64 %len, 0\n  br i1 %isZero, label %ret_race, label %poll_race\npoll_race:\n  %pIdx = alloca i64\n  br label %race_poll_step\nrace_poll_step:\n  store i64 0, ptr %pIdx\n  br label %race_loop\nrace_loop:\n  %idx = load i64, ptr %pIdx\n  %cmp = icmp slt i64 %idx, %len\n  br i1 %cmp, label %race_chk, label %race_sleep\nrace_chk:\n  %slotIdx = add i64 %idx, 1\n  %pItem = getelementptr inbounds i64, ptr %arr, i64 %slotIdx\n  %rawBits = load i64, ptr %pItem\n  %rawDbl = bitcast i64 %rawBits to double\n  %rawItem = fptosi double %rawDbl to i64\n  %isSmall = icmp ult i64 %rawItem, 65536\n  br i1 %isSmall, label %race_win_val, label %race_chk_align\nrace_chk_align:\n  %lowBits = and i64 %rawItem, 7\n  %isAligned = icmp eq i64 %lowBits, 0\n  br i1 %isAligned, label %race_chk_high, label %race_win_val\nrace_chk_high:\n  %isTooHigh = icmp ugt i64 %rawItem, 140737488355327\n  br i1 %isTooHigh, label %race_win_val, label %race_chk_magic\nrace_chk_magic:\n  %pSub = inttoptr i64 %rawItem to ptr\n  %magic = load i64, ptr %pSub\n  %isPrm = icmp eq i64 %magic, 1347571249\n  br i1 %isPrm, label %race_chk_settled, label %race_win_val\nrace_chk_settled:\n  %pSet = getelementptr inbounds i64, ptr %pSub, i64 4\n  %setVal = load i64, ptr %pSet\n  %isSet = icmp ne i64 %setVal, 0\n  br i1 %isSet, label %race_unpack, label %race_next\nrace_unpack:\n  %pState = getelementptr inbounds i64, ptr %pSub, i64 1\n  %st = load i64, ptr %pState\n  %pVal = getelementptr inbounds i64, ptr %pSub, i64 3\n  %v = load i64, ptr %pVal\n  %isRej = icmp eq i64 %st, 2\n  br i1 %isRej, label %race_rej, label %race_res\nrace_rej:\n  call void @zuv_prm_reject