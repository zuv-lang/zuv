    termIR = termIR.cat "@.zuv_term_code_magenta = private unnamed_addr constant [6 x i8] c\"\\1B[35m\\00\"\n"
    termIR = termIR.cat "@.zuv_term_code_cyan = private unnamed_addr constant [6 x i8] c\"\\1B[36m\\00\"\n\n"

