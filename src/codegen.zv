    let bOff = findFieldOffset cg, "body"
    let vOff = findFieldOffset cg, "version"
    header = header.cat (`define internal ptr @zuv_http_parse_req(ptr %raw) {\nentry:\n  %obj = call ptr @malloc(i64 8192)\n  call ptr @memset(ptr %obj, i32 0, i64 8192)\n  %space1 = call ptr @strchr(ptr %raw, i32 32)\n  %cmpSp1 = icmp ne ptr %space1, null\n  br i1 %cmpSp1, label %parse_method, label %done\nparse_method:\n  %rawInt = ptrtoint ptr %raw to i64\n  %sp1Int = ptrtoint ptr %space1 to i64\n  %mLen = sub i64 %sp1Int, %rawInt\n  %mLenPlus1 = add i64 %mLen, 1\n  %mBuf = call ptr @malloc(i64 %mLenPlus1)\n  call ptr @memcpy(ptr %mBuf, ptr %raw, i64 %mLen)\n  %mEnd = getelementptr inbounds i8, ptr %mBuf, i64 %mLen\n  store i8 0, ptr %mEnd\n  %mInt = ptrtoint ptr %mBuf to i64\n  %mDbl = sitofp i64 %mInt to double\n  %mBits = bitcast double %mDbl to i64\n  %gepM = getelementptr inbounds i64, ptr %obj, i64 ${mOff}\n  store i64 %mBits, ptr %gepM\n  %pathStart = getelementptr inbounds i8, ptr %space1, i64 1\n  %space2 = call ptr @strchr(ptr %pathStart, i32 32)\n  %cmpSp2 = icmp ne ptr %space2, null\n  br i1 %cmpSp2, label %parse_path, label %check_body\nparse_path:\n  %pStartInt = ptrtoint ptr %pathStart to i64\n  %sp2Int = ptrtoint ptr %space2 to i64\n  %pLen = sub i64 %sp2Int, %pStartInt\n  %pLenPlus1 = add i64 %pLen, 1\n  %pBuf = call ptr @malloc(i64 %pLenPlus1)\n  call ptr @memcpy(ptr %pBuf, ptr %pathStart, i64 %pLen)\n  %pEnd = getelementptr inbounds i8, ptr %pBuf, i64 %pLen\n  store i8 0, ptr %pEnd\n  %pInt = ptrtoint ptr %pBuf to i64\n  %pDbl = sitofp i64 %pInt to double\n  %pBits = bitcast double %pDbl to i64\n  %gepP = getelementptr inbounds i64, ptr %obj, i64 ${pOff}\n  store i64 %pBits, ptr %gepP\n  br label %check_body\ncheck_body:\n  %bodySep = call ptr @strstr(ptr %raw, ptr @str_crlf2)\n  %hasBody = icmp ne ptr %bodySep, null\n  br i1 %hasBody, label %parse_body, label %no_body\nparse_body:\n  %bodyPtr = getelementptr inbounds i8, ptr %bodySep, i64 4\n  %bLen = call i64 @strlen(ptr %bodyPtr)\n  %bLenPlus1 = add i64 %bLen, 1\n  %bBuf = call ptr @malloc(i64 %bLenPlus1)\n  call ptr @memcpy(ptr %bBuf, ptr %bodyPtr, i64 %bLenPlus1)\n  %bInt = ptrtoint ptr %bBuf to i64\n  %bDbl = sitofp i64 %bInt to double\n  %bBits = bitcast double %bDbl to i64\n  %gepB = getelementptr inbounds i64, ptr %obj, i64 ${bOff}\n  store i64 %bBits, ptr %gepB\n  br label %set_version\nno_body:\n  %empInt = ptrtoint ptr @empty_str to i64\n  %empDbl = sitofp i64 %empInt to double\n  %empBits = bitcast double %empDbl to i64\n  %gepB2 = getelementptr inbounds i64, ptr %obj, i64 ${bOff}\n  store i64 %empBits, ptr %gepB2\n  br label %set_version\nset_version:\n  %vInt = ptrtoint ptr @str_http_ver to i64\n  %vDbl = sitofp i64 %vInt to double\n  %vBits = bitcast double %vDbl to i64\n  %gepV = getelementptr inbounds i64, ptr %obj, i64 ${vOff}\n  store i64 %vBits, ptr %gepV\n  br label %done\ndone:\n  ret ptr %obj\n}\n\n`)

    header = header.cat "define internal i64 @zuv_ws_conn(ptr %url) {\nentry:\n  %s = call i64 @zuv_net_sock(i32 2, i32 1, i32 6)\n  %res = call double @zuv_net_connect(i64 %s, ptr @str_localhost, i32 80)\n  ret i64 %s\n}\n\n"

    header = header.cat "define internal i64 @zuv_ws_send(i64 %s, ptr %msg) {\nentry:\n  %len = call i64 @strlen(ptr %msg)\n  %frameSz = add i64 %len, 2\n  %fbuf = call ptr @malloc(i64 %frameSz)\n  store i8 -127, ptr %fbuf\n  %lenTrunc = trunc i64 %len to i8\n  %gep1 = getelementptr inbounds i8, ptr %fbuf, i64 1\n  store i8 %lenTrunc, ptr %gep1\n  %gep2 = getelementptr inbounds i8, ptr %fbuf, i64 2\n  call ptr @memcpy(ptr %gep2, ptr %msg, i64 %len)\n  %sz32 = trunc i64 %frameSz to i32\n  %sent = call i32 @send(i64 %s, ptr %fbuf, i32 %sz32, i32 0)\n  call void @free(ptr %fbuf)\n  %sent64 = sext i32 %sent to i64\n  ret i64 %sent64\n}\n\n"

    header = header.cat "define internal ptr @zuv_ws_recv(i64 %s) {\nentry:\n  %hdr = alloca [2 x i8], align 1\n  %n1 = call i32 @recv(i64 %s, ptr %hdr, i32 2, i32 0)\n  %cmpBad = icmp slt i32 %n1, 2\n  br i1 %cmpBad, label %err, label %read_body\nread_body:\n  %gepLen = getelementptr inbounds i8, ptr %hdr, i64 1\n  %rawLen = load i8, ptr %gepLen\n  %pLen8 = and i8 %rawLen, 127\n  %pLen32 = zext i8 %pLen8 to i32\n  %pLen64 = zext i8 %pLen8 to i64\n  %allocSz = add i64 %pLen64, 1\n  %buf = call ptr @malloc(i64 %allocSz)\n  %n2 = call i32 @recv(i64 %s, ptr %buf, i32 %pLen32, i32 0)\n  %endPtr = getelementptr inbounds i8, ptr %buf, i64 %pLen64\n  store i8 0, ptr %endPtr\n  ret ptr %buf\nerr:\n  ret ptr @empty_str\n}\n\n"

    let mainBuf = { code: "define i32 @main(i32 %argc, ptr %argv) {\nentry:\n  call void @zuv_init_args(i32 %argc, ptr %argv)\n  call void @zuv_init_crash_handler()\n" }
    mIdx = cg.funcCount
    cg.funcCount = cg.funcCount + 1
    mNameStr = addStrConstant cg, "main"
    mFileStr = addStrConstant cg, "main.zv"
    if mIdx > 0 {
        cg.funcDescsStr = cg.funcDescsStr.cat ",\n"
    }
    cg.funcDescsStr = cg.funcDescsStr.cat (`  %struct.ZuvFuncDesc { ptr @main, ptr ${mNameStr}, ptr ${mFileStr}, i32 1 }`)

    // Built-in project-wide `glb` — properties registered as LLVM globals `@glb_<prop>`
    header = header.cat "@glb = global i64 0\n"
    addCgSymbol cg, "glb", "@glb"

    // Pass 1: Declare top-level variables as global variables and register externs
    let gi = 0
    wh gi < program.statements.ln {
        stmt = program.statements[gi]
        if stmt.kind == "VarDecl" {
            gSym = findCgSymbol cg, stmt.name
            if gSym.name == "" {
                gReg = `@${stmt.name}`
                header = header.cat (`${gReg} = global double 0.0\n`)
                addCgSymbol cg, stmt.name, gReg
            }
        } els if stmt.kind == "ForStmt" {
            if stmt.init.kind == "VarDecl" {
                gSym = findCgSymbol cg, stmt.init.name
                if gSym.name == "" {
                    gReg = `@${stmt.init.name}`
                    header = header.cat (`${gReg} = global double 0.0\n`)
                    addCgSymbol cg, stmt.init.name, gReg
                }
            }
        } els if stmt.kind == "ExternDecl" {
            let extParams = ""
            let pi = 0
            wh pi < stmt.params.ln {
                p = stmt.params[pi]
                let pt = "i32"
                if p.typeName == "str" || p.typeName == "ptr" {
                    pt = "ptr"
                } els if p.typeName == "double" || p.typeName == "num" {
                    pt = "double"
                } els if p.typeName == "i64" {
                    pt = "i64"
                }
                if pi > 0 {
                    extParams = `${extParams}, `
                }
                extParams = extParams + pt
                pi = pi + 1
            }
            let retType = "i32"
            if stmt.typeName == "void" {
                retType = "void"
            } els if stmt.typeName == "ptr" || stmt.typeName == "str" {
                retType = "ptr"
            } els if stmt.typeName == "double" {
                retType = "double"
            } els if stmt.typeName == "i64" {
                retType = "i64"
            } els if stmt.typeName == "num" || stmt.typeName == "i32" {
                retType = "i32"
            }
            declSig = `@${stmt.name}(`
            if (header.cnt declSig) == 0 {
                header = header.cat (`declare ${retType} @${stmt.name}(${extParams})\n`)
            }
            addCgExtern cg, stmt
        } els if stmt.kind == "StmtSequence" {
            let seqg = 0
            wh seqg < stmt.statements.ln {
                subG = stmt.statements[seqg]
                if subG.kind == "ExternDecl" {
                    let extParams2 = ""
                    let pi2 = 0
                    wh pi2 < subG.params.ln {
                        p2 = subG.params[pi2]
                        let pt2 = "i32"
                        if p2.typeName == "str" || p2.typeName == "ptr" {
                            pt2 = "ptr"
                        } els if p2.typeName == "double" || p2.typeName == "num" {
                            pt2 = "double"
                        } els if p2.typeName == "i64" {
                            pt2 = "i64"
                        }
                        if pi2 > 0 {
                            extParams2 = `${extParams2}, `
                        }
                        extParams2 = extParams2 + pt2
                        pi2 = pi2 + 1
                    }
                    let retType2 = "i32"
                    if subG.typeName == "void" {
                        retType2 = "void"
                    } els if subG.typeName == "ptr" || subG.typeName == "str" {
                        retType2 = "ptr"
                    } els if subG.typeName == "double" {
                        retType2 = "double"
                    } els if subG.typeName == "i64" {
                        retType2 = "i64"
                    } els if subG.typeName == "num" || subG.typeName == "i32" {
                        retType2 = "i32"
                    }
                    declSig2 = `@${subG.name}(`
                    if (header.cnt declSig2) == 0 {
                        header = header.cat (`declare ${retType2} @${subG.name}(${extParams2})\n`)
                    }
                    addCgExtern cg, subG
                }
                seqg = seqg + 1
            }
        }
        gi = gi + 1
    }

    // Pass: register rest-param indices before generating any function bodies
    let ri = 0
    wh ri < program.statements.ln {
        rst = program.statements[ri]
        if rst.kind == "FunctionDecl" {
            if rst.hasRest == 1 {
                if rst.params.ln > 0 {
                    cg.restNames.psh rst.name
                    rIdx = rst.params.ln - 1
                    cg.restIdxs.psh rIdx
                }
            }
        } els if rst.kind == "StmtSequence" {
            let seqr = 0
            wh seqr < rst.statements.ln {
                subR = rst.statements[seqr]
                if subR.kind == "FunctionDecl" && subR.hasRest == 1 && subR.params.ln > 0 {
                    cg.restNames.psh subR.name
                    rIdx = subR.params.ln - 1
                    cg.restIdxs.psh rIdx
                }
                seqr = seqr + 1
            }
        }
        ri = ri + 1
    }

    // Pass 2a: Generate all function definitions
    cg.isMain = 0
    let fi = 0
    wh fi < program.statements.ln {
        stmt = program.statements[fi]
        if stmt.kind == "FunctionDecl" {
            codegenFunctionDecl cg, stmt
        } els if stmt.kind == "StmtSequence" {
            let seqi = 0
            wh seqi < stmt.statements.ln {
                subS = stmt.statements[seqi]
                if subS.kind == "FunctionDecl" {
                    codegenFunctionDecl cg, subS
                }
                seqi = seqi + 1
            }
        }
        fi = fi + 1
    }

    // Pass 2b: Generate top-level statements into main
    cg.isMain = 1
    clearCgLocals cg
    let ti = 0
    wh ti < program.statements.ln {
        stmt = program.statements[ti]
        if stmt.kind != "FunctionDecl" && stmt.kind != "ExternDecl" && stmt.kind != "ImportStmt" {
            if stmt.kind == "StmtSequence" {
                let seqti = 0
                wh seqti < stmt.statements.ln {
                    subS = stmt.statements[seqti]
                    if subS.kind != "FunctionDecl" && subS.kind != "ExternDecl" && subS.kind != "ImportStmt" {
                        codegenStmt cg, subS, mainBuf
                    }
                    seqti = seqti + 1
                }
            } els {
                codegenStmt cg, stmt, mainBuf
            }
        }
        ti = ti + 1
    }

    if (cg.funcs.cnt "@main_user(") > 0 {
        mainBuf.code = mainBuf.code.cat "  %arg1_alloc = alloca double\n  %arg2_alloc = alloca double\n  %arg3_alloc = alloca double\n  %arg4_alloc = alloca double\n"
        mainBuf.code = mainBuf.code.cat "  store double 0.0, ptr %arg1_alloc\n  store double 0.0, ptr %arg2_alloc\n  store double 0.0, ptr %arg3_alloc\n  store double 0.0, ptr %arg4_alloc\n"
        mainBuf.code = mainBuf.code.cat "  %hasArg1 = icmp sgt i32 %argc, 1\n  br i1 %hasArg1, label %get_arg1, label %no_arg1\n\nget_arg1:\n  %p1 = getelementptr inbounds ptr, ptr %argv, i64 1\n  %v1 = load ptr, ptr %p1, align 8\n  %l1 = call i64 @strlen(ptr %v1)\n  %l1p = add i64 %l1, 1\n  %h1 = call ptr @malloc(i64 %l1p)\n  %c1 = call ptr @memcpy(ptr %h1, ptr %v1, i64 %l1p)\n  %v1Int = ptrtoint ptr %h1 to i64\n  %v1Dbl = sitofp i64 %v1Int to double\n  store double %v1Dbl, ptr %arg1_alloc\n  br label %next_arg1\n\nno_arg1:\n  %e1 = call ptr @malloc(i64 1)\n  store i8 0, ptr %e1\n  %e1Int = ptrtoint ptr %e1 to i64\n  %e1Dbl = sitofp i64 %e1Int to double\n  store double %e1Dbl, ptr %arg1_alloc\n  br label %next_arg1\n\nnext_arg1:\n"
        mainBuf.code = mainBuf.code.cat "  %hasArg2 = icmp sgt i32 %argc, 2\n  br i1 %hasArg2, label %get_arg2, label %no_arg2\n\nget_arg2:\n  %p2 = getelementptr inbounds ptr, ptr %argv, i64 2\n  %v2 = load ptr, ptr %p2, align 8\n  %l2 = call i64 @strlen(ptr %v2)\n  %l2p = add i64 %l2, 1\n  %h2 = call ptr @malloc(i64 %l2p)\n  %c2 = call ptr @memcpy(ptr %h2, ptr %v2, i64 %l2p)\n  %v2Int = ptrtoint ptr %h2 to i64\n  %v2Dbl = sitofp i64 %v2Int to double\n  store double %v2Dbl, ptr %arg2_alloc\n  br label %next_arg2\n\nno_arg2:\n  %e2 = call ptr @malloc(i64 1)\n  store i8 0, ptr %e2\n  %e2Int = ptrtoint ptr %e2 to i64\n  %e2Dbl = sitofp i64 %e2Int to double\n  store double %e2Dbl, ptr %arg2_alloc\n  br label %next_arg2\n\nnext_arg2:\n"
        mainBuf.code = mainBuf.code.cat "  %hasArg3 = icmp sgt i32 %argc, 3\n  br i1 %hasArg3, label %get_arg3, label %no_arg3\n\nget_arg3:\n  %p3 = getelementptr inbounds ptr, ptr %argv, i64 3\n  %v3 = load ptr, ptr %p3, align 8\n  %l3 = call i64 @strlen(ptr %v3)\n  %l3p = add i64 %l3, 1\n  %h3 = call ptr @malloc(i64 %l3p)\n  %c3 = call ptr @memcpy(ptr %h3, ptr %v3, i64 %l3p)\n  %v3Int = ptrtoint ptr %h3 to i64\n  %v3Dbl = sitofp i64 %v3Int to double\n  store double %v3Dbl, ptr %arg3_alloc\n  br label %next_arg3\n\nno_arg3:\n  %e3 = call ptr @malloc(i64 1)\n  store i8 0, ptr %e3\n  %e3Int = ptrtoint ptr %e3 to i64\n  %e3Dbl = sitofp i64 %e3Int to double\n  store double %e3Dbl, ptr %arg3_alloc\n  br label %next_arg3\n\nnext_arg3:\n"
        mainBuf.code = mainBuf.code.cat "  %hasArg4 = icmp sgt i32 %argc, 4\n  br i1 %hasArg4, label %get_arg4, label %no_arg4\n\nget_arg4:\n  %p4 = getelementptr inbounds ptr, ptr %argv, i64 4\n  %v4 = load ptr, ptr %p4, align 8\n  %l4 = call i64 @strlen(ptr %v4)\n  %l4p = add i64 %l4, 1\n  %h4 = call ptr @malloc(i64 %l4p)\n  %c4 = call ptr @memcpy(ptr %h4, ptr %v4, i64 %l4p)\n  %v4Int = ptrtoint ptr %h4 to i64\n  %v4Dbl = sitofp i64 %v4Int to double\n  store double %v4Dbl, ptr %arg4_alloc\n  br label %next_arg4\n\nno_arg4:\n  %e4 = call ptr @malloc(i64 1)\n  store i8 0, ptr %e4\n  %e4Int = ptrtoint ptr %e4 to i64\n  %e4Dbl = sitofp i64 %e4Int to double\n  store double %e4Dbl, ptr %arg4_alloc\n  br label %next_arg4\n\nnext_arg4:\n"
        mainBuf.code = mainBuf.code.cat "  %a1 = load double, ptr %arg1_alloc\n  %a2 = load double, ptr %arg2_alloc\n  %a3 = load double, ptr %arg3_alloc\n  %a4 = load double, ptr %arg4_alloc\n"
        mainBuf.code = mainBuf.code.cat "  %call_res = call double @main_user(double %a1, double %a2, double %a3, double %a4)\n"
    }

    mainBuf.code = mainBuf.code.cat ("  ret i32 0\n}\n")

    // Merge constant declarations
    let constsStr = ""
    let ci = 0
    wh ci < cg.strConstants.ln {
        constsStr = constsStr.cat cg.strConstants[ci]
        ci = ci + 1
    }

    let glbDeclsStr = ""
    let gdi = 0
    wh gdi < cg.glbDeclList.ln {
        glbDeclsStr = glbDeclsStr.cat cg.glbDeclList[gdi]
        gdi = gdi + 1
    }

    btRuntimeStr = emitBacktraceRuntime cg
    sigRuntimeStr = emitSignalRuntime cg
    ipcRuntimeStr = emitIpcRuntime cg
    termRuntimeStr = emitTermRuntime cg
    ptyRuntimeStr = emitPtyRuntime cg
    fullIR = `${header}${glbDeclsStr}${constsStr}\n${cg.funcs}\n${mainBuf.code}\n${btRuntimeStr}\n${sigRuntimeStr}\n${ipcRuntimeStr}\n${termRuntimeStr}\n${ptyRuntimeStr}`
    -> fullIR
}

emitBacktraceRuntime cg {
    mut count = cg.funcCount
    if count == 0 {
        mNameStr = addStrConstant cg, "main"
        mFileStr = addStrConstant cg, "main.zv"
        cg.funcDescsStr = `  %struct.ZuvFuncDesc { ptr @main, ptr ${mNameStr}, ptr ${mFileStr}, i32 1 }`
        count = 1
    }
    mut btIR = "\n; --- Zuv Embedded PC-Line Table & Runtime Crash Backtraces ---\n"
    btIR = btIR.cat "%struct.ZuvFuncDesc = type { ptr, ptr, ptr, i32 }\n\n"
    btIR = btIR.cat (`\n@zuv_fn_descs = internal global [${count} x %struct.ZuvFuncDesc] [\n`)
    btIR = btIR.cat cg.funcDescsStr
    btIR = btIR.cat "\n]\n"
    btIR = btIR.cat (`@zuv_fn_count = internal constant i64 ${count}\n`)
    btIR = btIR.cat "@zuv_fn_sorted = internal global i32 0\n\n"

    btIR = btIR.cat "@zuv_fmt_panic_msg = private unnamed_addr constant [37 x i8] c\"\\0Afatal runtime error: %s\\0A  at %s:%d\\0A\\00\"\n"
    btIR = btIR.cat "@zuv_fmt_panic_simple = private unnamed_addr constant [26 x i8] c\"\\0Afatal runtime error: %s\\0A\\00\"\n"
    btIR = btIR.cat "@zuv_fmt_bt_header = private unnamed_addr constant [18 x i8] c\"stack backtrace:\\0A\\00\"\n"
    btIR = btIR.cat "@zuv_fmt_bt_frame_sym = private unnamed_addr constant [37 x i8] c\"  %2d: %s\\0A       at %s:%d (+0x%llx)\\0A\\00\"\n"
    btIR = btIR.cat "@zuv_fmt_bt_frame_unk = private unnamed_addr constant [30 x i8] c\"  %2d: [unknown] (0x%016llx)\\0A\\00\"\n"
    btIR = btIR.cat "@zuv_fmt_bt_hint = private unnamed_addr constant [78 x i8] c\"note: run with 'ZUV_BACKTRACE=1' environment variable to display a backtrace\\0A\\00\"\n"
    btIR = btIR.cat "@zuv_env_backtrace = private unnamed_addr constant [14 x i8] c\"ZUV_BACKTRACE\\00\"\n"
    btIR = btIR.cat "@zuv_fmt_crash_msg = private unnamed_addr constant [58 x i8] c\"\\0Afatal runtime error: hardware crash 0x%08X at 0x%016llx\\0A\\00\"\n\n"

    btIR = btIR.cat "define internal void @zuv_ensure_fn_sorted() {\nentry:\n  %flag = load i32, ptr @zuv_fn_sorted\n  %already = icmp ne i32 %flag, 0\n  br i1 %already, label %ret, label %do_sort\n\ndo_sort:\n  store i32 1, ptr @zuv_fn_sorted\n  %count = load i64, ptr @zuv_fn_count\n  %has_elems = icmp sgt i64 %count, 1\n  br i1 %has_elems, label %init_i, label %ret\n\ninit_i:\n  %p_i = alloca i64, align 8\n  %p_j = alloca i64, align 8\n  store i64 1, ptr %p_i\n  br label %cond_i\n\ncond_i:\n  %i_val = load i64, ptr %p_i\n  %i_cmp = icmp slt i64 %i_val, %count\n  br i1 %i_cmp, label %body_i, label %ret\n\nbody_i:\n  %i_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr @zuv_fn_descs, i64 %i_val\n  %key_fn = load ptr, ptr %i_ptr\n  %key_fn_int = ptrtoint ptr %key_fn to i64\n  %key_name_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr %i_ptr, i32 0, i32 1\n  %key_name = load ptr, ptr %key_name_ptr\n  %key_file_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr %i_ptr, i32 0, i32 2\n  %key_file = load ptr, ptr %key_file_ptr\n  %key_line_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr %i_ptr, i32 0, i32 3\n  %key_line = load i32, ptr %key_line_ptr\n  store i64 %i_val, ptr %p_j\n  br label %cond_j\n\ncond_j:\n  %j_val = load i64, ptr %p_j\n  %j_gt_zero = icmp sgt i64 %j_val, 0\n  br i1 %j_gt_zero, label %check_prev, label %insert\n\ncheck_prev:\n  %j_prev = sub i64 %j_val, 1\n  %prev_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr @zuv_fn_descs, i64 %j_prev\n  %prev_fn = load ptr, ptr %prev_ptr\n  %prev_fn_int = ptrtoint ptr %prev_fn to i64\n  %prev_gt = icmp ugt i64 %prev_fn_int, %key_fn_int\n  br i1 %prev_gt, label %shift_j, label %insert\n\nshift_j:\n  %cur_j_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr @zuv_fn_descs, i64 %j_val\n  %prev_name_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr %prev_ptr, i32 0, i32 1\n  %prev_name = load ptr, ptr %prev_name_ptr\n  %prev_file_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr %prev_ptr, i32 0, i32 2\n  %prev_file = load ptr, ptr %prev_file_ptr\n  %prev_line_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr %prev_ptr, i32 0, i32 3\n  %prev_line = load i32, ptr %prev_line_ptr\n  store ptr %prev_fn, ptr %cur_j_ptr\n  %cur_name_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr %cur_j_ptr, i32 0, i32 1\n  store ptr %prev_name, ptr %cur_name_ptr\n  %cur_file_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr %cur_j_ptr, i32 0, i32 2\n  store ptr %prev_file, ptr %cur_file_ptr\n  %cur_line_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr %cur_j_ptr, i32 0, i32 3\n  store i32 %prev_line, ptr %cur_line_ptr\n  store i64 %j_prev, ptr %p_j\n  br label %cond_j\n\ninsert:\n  %ins_j = load i64, ptr %p_j\n  %pos_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr @zuv_fn_descs, i64 %ins_j\n  store ptr %key_fn, ptr %pos_ptr\n  %ins_name_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr %pos_ptr, i32 0, i32 1\n  store ptr %key_name, ptr %ins_name_ptr\n  %ins_file_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr %pos_ptr, i32 0, i32 2\n  store ptr %key_file, ptr %ins_file_ptr\n  %ins_line_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr %pos_ptr, i32 0, i32 3\n  store i32 %key_line, ptr %ins_line_ptr\n  %i_next = add i64 %i_val, 1\n  store i64 %i_next, ptr %p_i\n  br label %cond_i\n\nret:\n  ret void\n}\n\n"

    btIR = btIR.cat "define internal ptr @zuv_resolve_pc(ptr %pc) {\nentry:\n  call void @zuv_ensure_fn_sorted()\n  %count = load i64, ptr @zuv_fn_count\n  %has_elems = icmp sgt i64 %count, 0\n  br i1 %has_elems, label %init, label %not_found\n\ninit:\n  %p_k = alloca i64, align 8\n  %init_idx = sub i64 %count, 1\n  store i64 %init_idx, ptr %p_k\n  %target = ptrtoint ptr %pc to i64\n  br label %loop\n\nloop:\n  %k = load i64, ptr %p_k\n  %k_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr @zuv_fn_descs, i64 %k\n  %entry_fn = load ptr, ptr %k_ptr\n  %entry_fn_int = ptrtoint ptr %entry_fn to i64\n  %is_le = icmp ule i64 %entry_fn_int, %target\n  br i1 %is_le, label %check_dist, label %step_back\n\ncheck_dist:\n  %dist = sub i64 %target, %entry_fn_int\n  %in_range = icmp ult i64 %dist, 2097152\n  br i1 %in_range, label %found, label %not_found\n\nfound:\n  ret ptr %k_ptr\n\nstep_back:\n  %k_is_zero = icmp eq i64 %k, 0\n  br i1 %k_is_zero, label %not_found, label %do_step\n\ndo_step:\n  %k_prev = sub i64 %k, 1\n  store i64 %k_prev, ptr %p_k\n  br label %loop\n\nnot_found:\n  ret ptr null\n}\n\n"

    btIR = btIR.cat "define internal void @zuv_walk_stack(i32 %skip, i32 %maxFrames) {\nentry:\n  %buf = alloca [32 x ptr], align 8\n  %frames = call i32 @RtlCaptureStackBackTrace(i32 %skip, i32 %maxFrames, ptr %buf, ptr null)\n  %has_frames = icmp sgt i32 %frames, 0\n  br i1 %has_frames, label %init, label %done\n\ninit:\n  %p_idx = alloca i32, align 4\n  store i32 0, ptr %p_idx\n  br label %loop\n\nloop:\n  %idx = load i32, ptr %p_idx\n  %slot = getelementptr inbounds [32 x ptr], ptr %buf, i32 0, i32 %idx\n  %pc = load ptr, ptr %slot\n  %desc = call ptr @zuv_resolve_pc(ptr %pc)\n  %is_null = icmp eq ptr %desc, null\n  br i1 %is_null, label %print_unk, label %print_sym\n\nprint_sym:\n  %fn_name_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr %desc, i32 0, i32 1\n  %fn_name = load ptr, ptr %fn_name_ptr\n  %file_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr %desc, i32 0, i32 2\n  %file = load ptr, ptr %file_ptr\n  %line_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr %desc, i32 0, i32 3\n  %line = load i32, ptr %line_ptr\n  %fn_entry_ptr = load ptr, ptr %desc\n  %pc_int = ptrtoint ptr %pc to i64\n  %entry_int = ptrtoint ptr %fn_entry_ptr to i64\n  %offset = sub i64 %pc_int, %entry_int\n  call i32 (ptr, ...) @printf(ptr @zuv_fmt_bt_frame_sym, i32 %idx, ptr %fn_name, ptr %file, i32 %line, i64 %offset)\n  br label %cont\n\nprint_unk:\n  %pc_as_i64 = ptrtoint ptr %pc to i64\n  call i32 (ptr, ...) @printf(ptr @zuv_fmt_bt_frame_unk, i32 %idx, i64 %pc_as_i64)\n  br label %cont\n\ncont:\n  %next_idx = add i32 %idx, 1\n  store i32 %next_idx, ptr %p_idx\n  %more = icmp slt i32 %next_idx, %frames\n  br i1 %more, label %loop, label %done\n\ndone:\n  ret void\n}\n\n"

    btIR = btIR.cat "define void @zuv_panic(ptr %msg, ptr %file, i32 %line) {\nentry:\n  %has_file = icmp ne ptr %file, null\n  br i1 %has_file, label %p_file, label %p_simple\n\np_file:\n  call i32 (ptr, ...) @printf(ptr @zuv_fmt_panic_msg, ptr %msg, ptr %file, i32 %line)\n  br label %check_env\n\np_simple:\n  call i32 (ptr, ...) @printf(ptr @zuv_fmt_panic_simple, ptr %msg)\n  br label %check_env\n\ncheck_env:\n  %env = call ptr @getenv(ptr @zuv_env_backtrace)\n  %has_env = icmp ne ptr %env, null\n  br i1 %has_env, label %check_val, label %print_hint\n\ncheck_val:\n  %ch = load i8, ptr %env\n  %is_zero = icmp eq i8 %ch, 48\n  br i1 %is_zero, label %print_hint, label %print_bt\n\nprint_bt:\n  call i32 (ptr, ...) @printf(ptr @zuv_fmt_bt_header)\n  call void @zuv_walk_stack(i32 1, i32 32)\n  br label %do_exit\n\nprint_hint:\n  call i32 (ptr, ...) @printf(ptr @zuv_fmt_bt_hint)\n  br label %do_exit\n\ndo_exit:\n  call void @exit(i32 101)\n  unreachable\n}\n\n"

    btIR = btIR.cat "define void @zuv_dump_stack() {\nentry:\n  call i32 (ptr, ...) @printf(ptr @zuv_fmt_bt_header)\n  call void @zuv_walk_stack(i32 1, i32 32)\n  ret void\n}\n\n"

    btIR = btIR.cat "define ptr @zuv_backtrace() {\nentry:\n  %buf = alloca [32 x ptr], align 8\n  %frames = call i32 @RtlCaptureStackBackTrace(i32 1, i32 32, ptr %buf, ptr null)\n  %out = call ptr @malloc(i64 4096)\n  store i8 0, ptr %out\n  %has_frames = icmp sgt i32 %frames, 0\n  br i1 %has_frames, label %init, label %done\n\ninit:\n  %p_bidx = alloca i32, align 4\n  store i32 0, ptr %p_bidx\n  br label %loop\n\nloop:\n  %idx = load i32, ptr %p_bidx\n  %cur_len = call i64 @strlen(ptr %out)\n  %slot = getelementptr inbounds [32 x ptr], ptr %buf, i32 0, i32 %idx\n  %pc = load ptr, ptr %slot\n  %desc = call ptr @zuv_resolve_pc(ptr %pc)\n  %is_null = icmp eq ptr %desc, null\n  %dest_ptr = getelementptr inbounds i8, ptr %out, i64 %cur_len\n  %avail = sub i64 4000, %cur_len\n  br i1 %is_null, label %fmt_unk, label %fmt_sym\n\nfmt_sym:\n  %fn_name_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr %desc, i32 0, i32 1\n  %fn_name = load ptr, ptr %fn_name_ptr\n  %file_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr %desc, i32 0, i32 2\n  %file = load ptr, ptr %file_ptr\n  %line_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr %desc, i32 0, i32 3\n  %line = load i32, ptr %line_ptr\n  %fn_entry_ptr = load ptr, ptr %desc\n  %pc_int = ptrtoint ptr %pc to i64\n  %entry_int = ptrtoint ptr %fn_entry_ptr to i64\n  %offset = sub i64 %pc_int, %entry_int\n  call i32 (ptr, i64, ptr, ...) @snprintf(ptr %dest_ptr, i64 %avail, ptr @zuv_fmt_bt_frame_sym, i32 %idx, ptr %fn_name, ptr %file, i32 %line, i64 %offset)\n  br label %cont\n\nfmt_unk:\n  %pc_as_i64 = ptrtoint ptr %pc to i64\n  call i32 (ptr, i64, ptr, ...) @snprintf(ptr %dest_ptr, i64 %avail, ptr @zuv_fmt_bt_frame_unk, i32 %idx, i64 %pc_as_i64)\n  br label %cont\n\ncont:\n  %next_idx = add i32 %idx, 1\n  store i32 %next_idx, ptr %p_bidx\n  %more = icmp slt i32 %next_idx, %frames\n  br i1 %more, label %loop, label %done\n\ndone:\n  ret ptr %out\n}\n\n"

    btIR = btIR.cat "define internal i32 @zuv_crash_handler(ptr %pExc) {\nentry:\n  %rec_ptr = load ptr, ptr %pExc\n  %code = load i32, ptr %rec_ptr\n  %is_av = icmp eq i32 %code, -1073741819\n  %is_dz = icmp eq i32 %code, -1073741676\n  %is_ab = icmp eq i32 %code, -1073741684\n  %is_so = icmp eq i32 %code, -1073741571\n  %fatal1 = or i1 %is_av, %is_dz\n  %fatal2 = or i1 %is_ab, %is_so\n  %is_fatal = or i1 %fatal1, %fatal2\n  br i1 %is_fatal, label %handle_crash, label %pass\n\nhandle_crash:\n  %addr_ptr = getelementptr inbounds i8, ptr %rec_ptr, i64 16\n  %fault_pc = load ptr, ptr %addr_ptr\n  %fault_pc_i64 = ptrtoint ptr %fault_pc to i64\n  call i32 (ptr, ...) @printf(ptr @zuv_fmt_crash_msg, i32 %code, i64 %fault_pc_i64)\n  %env = call ptr @getenv(ptr @zuv_env_backtrace)\n  %has_env = icmp ne ptr %env, null\n  br i1 %has_env, label %check_crash_env, label %print_crash_hint\n\ncheck_crash_env:\n  %ch = load i8, ptr %env\n  %is_zero = icmp eq i8 %ch, 48\n  br i1 %is_zero, label %print_crash_hint, label %print_crash_bt\n\nprint_crash_bt:\n  call i32 (ptr, ...) @printf(ptr @zuv_fmt_bt_header)\n  call void @zuv_walk_stack(i32 0, i32 32)\n  br label %exit_crash\n\nprint_crash_hint:\n  call i32 (ptr, ...) @printf(ptr @zuv_fmt_bt_hint)\n  br label %exit_crash\n\nexit_crash:\n  call void @exit(i32 101)\n  ret i32 0\n\npass:\n  ret i32 0\n}\n\n"

    btIR = btIR.cat "define void @zuv_init_crash_handler() {\nentry:\n  call ptr @AddVectoredExceptionHandler(i32 1, ptr @zuv_crash_handler)\n  ret void\n}\n"

    -> btIR
}

emitSignalRuntime cg {
    mut sigIR = "\n; --- Zuv OS Signal Handling & Process Traps (`os/signal`, `signal.on`) ---\n"
    sigIR = sigIR.cat "@zuv_sig_trampoline_installed = internal global i32 0\n"
    sigIR = sigIR.cat "@zuv_sig_handlers = internal global [32 x ptr] zeroinitializer\n"
    sigIR = sigIR.cat "@zuv_sig_channels = internal global [32 x ptr] zeroinitializer\n"
    sigIR = sigIR.cat "@zuv_sig_disposition = internal global [32 x i32] zeroinitializer\n\n"

    sigIR = sigIR.cat "@zuv_sig_name_int = private unnamed_addr constant [4 x i8] c\"INT\\00\"\n"
    sigIR = sigIR.cat "@zuv_sig_name_sigint = private unnamed_addr constant [7 x i8] c\"SIGINT\\00\"\n"
    sigIR = sigIR.cat "@zuv_sig_name_term = private unnamed_addr constant [5 x i8] c\"TERM\\00\"\n"
    sigIR = sigIR.cat "@zuv_sig_name_sigterm = private unnamed_addr constant [8 x i8] c\"SIGTERM\\00\"\n"
    sigIR = sigIR.cat "@zuv_sig_name_hup = private unnamed_addr constant [4 x i8] c\"HUP\\00\"\n"
    sigIR = sigIR.cat "@zuv_sig_name_sighup = private unnamed_addr constant [7 x i8] c\"SIGHUP\\00\"\n"
    sigIR = sigIR.cat "@zuv_sig_name_quit = private unnamed_addr constant [5 x i8] c\"QUIT\\00\"\n"
    sigIR = sigIR.cat "@zuv_sig_name_sigquit = private unnamed_addr constant [8 x i8] c\"SIGQUIT\\00\"\n"
    sigIR = sigIR.cat "@zuv_sig_name_break = private unnamed_addr constant [6 x i8] c\"BREAK\\00\"\n"
    sigIR = sigIR.cat "@zuv_sig_name_sigbreak = private unnamed_addr constant [9 x i8] c\"SIGBREAK\\00\"\n"
    sigIR = sigIR.cat "@zuv_sig_name_usr1 = private unnamed_addr constant [5 x i8] c\"USR1\\00\"\n"
    sigIR = sigIR.cat "@zuv_sig_name_sigusr1 = private unnamed_addr constant [8 x i8] c\"SIGUSR1\\00\"\n"
    sigIR = sigIR.cat "@zuv_sig_name_usr2 = private unnamed_addr constant [5 x i8] c\"USR2\\00\"\n"
    sigIR = sigIR.cat "@zuv_sig_name_sigusr2 = private unnamed_addr constant [8 x i8] c\"SIGUSR2\\00\"\n\n"

    sigIR = sigIR.cat "define internal i32 @zuv_signal_map_name(ptr %str) {\nentry:\n  %isNull = icmp eq ptr %str, null\n  br i1 %isNull, label %ret_default, label %check_first_char\n\ncheck_first_char:\n  %c0 = load i8, ptr %str\n  %isDigit = icmp uge i8 %c0, 48\n  %isDigit2 = icmp ule i8 %c0, 57\n  %isNum = and i1 %isDigit, %isDigit2\n  br i1 %isNum, label %do_atoi, label %check_int\n\ndo_atoi:\n  %numVal = call i32 @atoi(ptr %str)\n  ret i32 %numVal\n\ncheck_int:\n  %cmpInt = call i32 @_stricmp(ptr %str, ptr @zuv_sig_name_int)\n  %isInt = icmp eq i32 %cmpInt, 0\n  br i1 %isInt, label %ret_int, label %check_sigint\n\ncheck_sigint:\n  %cmpSigInt = call i32 @_stricmp(ptr %str, ptr @zuv_sig_name_sigint)\n  %isSigInt = icmp eq i32 %cmpSigInt, 0\n  br i1 %isSigInt, label %ret_int, label %check_term\n\nret_int:\n  ret i32 2\n\ncheck_term:\n  %cmpTerm = call i32 @_stricmp(ptr %str, ptr @zuv_sig_name_term)\n  %isTerm = icmp eq i32 %cmpTerm, 0\n  br i1 %isTerm, label %ret_term, label %check_sigterm\n\ncheck_sigterm:\n  %cmpSigTerm = call i32 @_stricmp(ptr %str, ptr @zuv_sig_name_sigterm)\n  %isSigTerm = icmp eq i32 %cmpSigTerm, 0\n  br i1 %isSigTerm, label %ret_term, label %check_hup\n\nret_term:\n  ret i32 15\n\ncheck_hup:\n  %cmpHup = call i32 @_stricmp(ptr %str, ptr @zuv_sig_name_hup)\n  %isHup = icmp eq i32 %cmpHup, 0\n  br i1 %isHup, label %ret_hup, label %check_sighup\n\ncheck_sighup:\n  %cmpSigHup = call i32 @_stricmp(ptr %str, ptr @zuv_sig_name_sighup)\n  %isSigHup = icmp eq i32 %cmpSigHup, 0\n  br i1 %isSigHup, label %ret_hup, label %check_quit\n\nret_hup:\n  ret i32 1\n\ncheck_quit:\n  %cmpQuit = call i32 @_stricmp(ptr %str, ptr @zuv_sig_name_quit)\n  %isQuit = icmp eq i32 %cmpQuit, 0\n  br i1 %isQuit, label %ret_quit, label %check_sigquit\n\ncheck_sigquit:\n  %cmpSigQuit = call i32 @_stricmp(ptr %str, ptr @zuv_sig_name_sigquit)\n  %isSigQuit = icmp eq i32 %cmpSigQuit, 0\n  br i1 %isSigQuit, label %ret_quit, label %check_break\n\nret_quit:\n  ret i32 3\n\ncheck_break:\n  %cmpBreak = call i32 @_stricmp(ptr %str, ptr @zuv_sig_name_break)\n  %isBreak = icmp eq i32 %cmpBreak, 0\n  br i1 %isBreak, label %ret_break, label %check_sigbreak\n\ncheck_sigbreak:\n  %cmpSigBreak = call i32 @_stricmp(ptr %str, ptr @zuv_sig_name_sigbreak)\n  %isSigBreak = icmp eq i32 %cmpSigBreak, 0\n  br i1 %isSigBreak, label %ret_break, label %check_usr1\n\nret_break:\n  ret i32 21\n\ncheck_usr1:\n  %cmpUsr1 = call i32 @_stricmp(ptr %str, ptr @zuv_sig_name_usr1)\n  %isUsr1 = icmp eq i32 %cmpUsr1, 0\n  br i1 %isUsr1, label %ret_usr1, label %check_sigusr1\n\ncheck_sigusr1:\n  %cmpSigUsr1 = call i32 @_stricmp(ptr %str, ptr @zuv_sig_name_sigusr1)\n  %isSigUsr1 = icmp eq i32 %cmpSigUsr1, 0\n  br i1 %isSigUsr1, label %ret_usr1, label %check_usr2\n\nret_usr1:\n  ret i32 10\n\ncheck_usr2:\n  %cmpUsr2 = call i32 @_stricmp(ptr %str, ptr @zuv_sig_name_usr2)\n  %isUsr2 = icmp eq i32 %cmpUsr2, 0\n  br i1 %isUsr2, label %ret_usr2, label %check_sigusr2\n\ncheck_sigusr2:\n  %cmpSigUsr2 = call i32 @_stricmp(ptr %str, ptr @zuv_sig_name_sigusr2)\n  %isSigUsr2 = icmp eq i32 %cmpSigUsr2, 0\n  br i1 %isSigUsr2, label %ret_usr2, label %ret_default\n\nret_usr2:\n  ret i32 12\n\nret_default:\n  ret i32 2\n}\n\n"

    sigIR = sigIR.cat "define internal void @zuv_signal_dispatch(i32 %sigId) {\nentry:\n  %isGtZero = icmp sgt i32 %sigId, 0\n  %isLt32 = icmp slt i32 %sigId, 32\n  %inRange = and i1 %isGtZero, %isLt32\n  br i1 %inRange, label %check_disp, label %ret_lbl\n\ncheck_disp:\n  %dispSlot = getelementptr inbounds i32, ptr @zuv_sig_disposition, i32 %sigId\n  %disp = load i32, ptr %dispSlot\n  %isIgnored = icmp eq i32 %disp, 2\n  br i1 %isIgnored, label %ret_lbl, label %check_chan\n\ncheck_chan:\n  %chanSlot = getelementptr inbounds ptr, ptr @zuv_sig_channels, i32 %sigId\n  %chan = load ptr, ptr %chanSlot\n  %hasChan = icmp ne ptr %chan, null\n  br i1 %hasChan, label %do_send_chan, label %check_handler\n\ndo_send_chan:\n  %sig64 = sext i32 %sigId to i64\n  %sndRes = call i32 @zuv_chan_send(ptr %chan, i64 %sig64)\n  br label %check_handler\n\ncheck_handler:\n  %fnSlot = getelementptr inbounds ptr, ptr @zuv_sig_handlers, i32 %sigId\n  %fn = load ptr, ptr %fnSlot\n  %hasFn = icmp ne ptr %fn, null\n  br i1 %hasFn, label %do_call_handler, label %ret_lbl\n\ndo_call_handler:\n  %sigDbl = sitofp i32 %sigId to double\n  %callRes = call double %fn(double %sigDbl)\n  br label %ret_lbl\n\nret_lbl:\n  ret void\n}\n\n"

    sigIR = sigIR.cat "define internal i32 @zuv_win_ctrl_handler(i32 %ctrlType) {\nentry:\n  %isC = icmp eq i32 %ctrlType, 0\n  br i1 %isC, label %sig_int, label %check_brk\n\ncheck_brk:\n  %isBrk = icmp eq i32 %ctrlType, 1\n  br i1 %isBrk, label %sig_break, label %check_cls\n\ncheck_cls:\n  %isCls = icmp eq i32 %ctrlType, 2\n  br i1 %isCls, label %sig_term, label %check_logoff\n\ncheck_logoff:\n  %isLogoff = icmp eq i32 %ctrlType, 5\n  br i1 %isLogoff, label %sig_hup, label %check_shutdown\n\ncheck_shutdown:\n  %isShutdown = icmp eq i32 %ctrlType, 6\n  br i1 %isShutdown, label %sig_term, label %sig_int\n\nsig_int:\n  br label %eval_sig\n\nsig_break:\n  br label %eval_sig\n\nsig_term:\n  br label %eval_sig\n\nsig_hup:\n  br label %eval_sig\n\neval_sig:\n  %sig = phi i32 [ 2, %sig_int ], [ 21, %sig_break ], [ 15, %sig_term ], [ 1, %sig_hup ]\n  %dispSlot = getelementptr inbounds i32, ptr @zuv_sig_disposition, i32 %sig\n  %disp = load i32, ptr %dispSlot\n  %isUnhandled = icmp eq i32 %disp, 0\n  br i1 %isUnhandled, label %ret_false, label %do_handle\n\ndo_handle:\n  call void @zuv_signal_dispatch(i32 %sig)\n  ret i32 1\n\nret_false:\n  ret i32 0\n}\n\n"

    sigIR = sigIR.cat "define internal void @zuv_signal_init_trampoline() {\nentry:\n  %inst = load i32, ptr @zuv_sig_trampoline_installed\n  %isInst = icmp ne i32 %inst, 0\n  br i1 %isInst, label %done, label %do_install\n\ndo_install:\n  store i32 1, ptr @zuv_sig_trampoline_installed\n  %res = call i32 @SetConsoleCtrlHandler(ptr @zuv_win_ctrl_handler, i32 1)\n  br label %done\n\ndone:\n  ret void\n}\n\n"

    sigIR = sigIR.cat "define internal void @zuv_signal_on(i32 %sigId, ptr %fnPtr) {\nentry:\n  call void @zuv_signal_init_trampoline()\n  %isGtZero = icmp sgt i32 %sigId, 0\n  %isLt32 = icmp slt i32 %sigId, 32\n  %inRange = and i1 %isGtZero, %isLt32\n  br i1 %inRange, label %store_fn, label %ret_lbl\n\nstore_fn:\n  %fnSlot = getelementptr inbounds ptr, ptr @zuv_sig_handlers, i32 %sigId\n  store ptr %fnPtr, ptr %fnSlot\n  %dispSlot = getelementptr inbounds i32, ptr @zuv_sig_disposition, i32 %sigId\n  store i32 1, ptr %dispSlot\n  br label %ret_lbl\n\nret_lbl:\n  ret void\n}\n\n"

    sigIR = sigIR.cat "define internal void @zuv_signal_notify(ptr %pChan, i32 %sigId) {\nentry:\n  call void @zuv_signal_init_trampoline()\n  %isGtZero = icmp sgt i32 %sigId, 0\n  %isLt32 = icmp slt i32 %sigId, 32\n  %inRange = and i1 %isGtZero, %isLt32\n  br i1 %inRange, label %store_ch, label %ret_lbl\n\nstore_ch:\n  %chanSlot = getelementptr inbounds ptr, ptr @zuv_sig_channels, i32 %sigId\n  store ptr %pChan, ptr %chanSlot\n  %dispSlot = getelementptr inbounds i32, ptr @zuv_sig_disposition, i32 %sigId\n  store i32 1, ptr %dispSlot\n  br label %ret_lbl\n\nret_lbl:\n  ret void\n}\n\n"

    sigIR = sigIR.cat "define internal void @zuv_signal_raise(i32 %sigId) {\nentry:\n  call void @zuv_signal_dispatch(i32 %sigId)\n  ret void\n}\n\n"

    sigIR = sigIR.cat "define internal void @zuv_signal_reset(i32 %sigId) {\nentry:\n  %isGtZero = icmp sgt i32 %sigId, 0\n  %isLt32 = icmp slt i32 %sigId, 32\n  %inRange = and i1 %isGtZero, %isLt32\n  br i1 %inRange, label %do_reset, label %ret_lbl\n\ndo_reset:\n  %fnSlot = getelementptr inbounds ptr, ptr @zuv_sig_handlers, i32 %sigId\n  store ptr null, ptr %fnSlot\n  %chanSlot = getelementptr inbounds ptr, ptr @zuv_sig_channels, i32 %sigId\n  store ptr null, ptr %chanSlot\n  %dispSlot = getelementptr inbounds i32, ptr @zuv_sig_disposition, i32 %sigId\n  store i32 0, ptr %dispSlot\n  br label %ret_lbl\n\nret_lbl:\n  ret void\n}\n\n"

    sigIR = sigIR.cat "define internal void @zuv_signal_ignore(i32 %sigId) {\nentry:\n  call void @zuv_signal_init_trampoline()\n  %isGtZero = icmp sgt i32 %sigId, 0\n  %isLt32 = icmp slt i32 %sigId, 32\n  %inRange = and i1 %isGtZero, %isLt32\n  br i1 %inRange, label %do_ignore, label %ret_lbl\n\ndo_ignore:\n  %fnSlot = getelementptr inbounds ptr, ptr @zuv_sig_handlers, i32 %sigId\n  store ptr null, ptr %fnSlot\n  %chanSlot = getelementptr inbounds ptr, ptr @zuv_sig_channels, i32 %sigId\n  store ptr null, ptr %chanSlot\n  %dispSlot = getelementptr inbounds i32, ptr @zuv_sig_disposition, i32 %sigId\n  store i32 2, ptr %dispSlot\n  br label %ret_lbl\n\nret_lbl:\n  ret void\n}\n"

    -> sigIR
}

emitIpcRuntime cg {
    mut ipcIR = "\n; --- Zuv Inter-Process Communication (IPC) & Shared Memory ---\n"
    ipcIR = ipcIR.cat "@str_pipe_fmt = private unnamed_addr constant [12 x i8] c\"\\5C\\5C.\\5Cpipe\\5C%s\\00\"\n"
    ipcIR = ipcIR.cat "@str_pipe_pattern = private unnamed_addr constant [9 x i8] c\"\\5C\\5C.\\5Cpipe\\00\"\n\n"

    ipcIR = ipcIR.cat "define internal ptr @zuv_ipc_format_pipename(ptr %name) {\nentry:\n  %isNameNull = icmp eq ptr %name, null\n  br i1 %isNameNull, label %ret_default, label %check_pattern\nret_default:\n  %defBuf = call ptr @malloc(i64 32)\n  %defRet = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %defBuf, i64 32, ptr @str_pipe_fmt, ptr @empty_str)\n  ret ptr %defBuf\ncheck_pattern:\n  %buf = call ptr @malloc(i64 260)\n  %hasPattern = call ptr @strstr(ptr %name, ptr @str_pipe_pattern)\n  %cmpHas = icmp ne ptr %hasPattern, null\n  br i1 %cmpHas, label %copy_direct, label %do_fmt\ncopy_direct:\n  %len = call i64 @strlen(ptr %name)\n  %allocSz = add i64 %len, 1\n  call ptr @memcpy(ptr %buf, ptr %name, i64 %allocSz)\n  ret ptr %buf\ndo_fmt:\n  %n = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %buf, i64 260, ptr @str_pipe_fmt, ptr %name)\n  ret ptr %buf\n}\n\n"

    ipcIR = ipcIR.cat "define internal i64 @zuv_ipc_pipe_server(ptr %name) {\nentry:\n  %pipeName = call ptr @zuv_ipc_format_pipename(ptr %name)\n  %h = call ptr @CreateNamedPipeA(ptr %pipeName, i32 3, i32 0, i32 255, i32 65536, i32 65536, i32 0, ptr null)\n  call void @free(ptr %pipeName)\n  %inv = inttoptr i64 -1 to ptr\n  %cmpBad = icmp eq ptr %h, %inv\n  br i1 %cmpBad, label %ret_err, label %ret_ok\nret_err:\n  ret i64 -1\nret_ok:\n  %hInt = ptrtoint ptr %h to i64\n  %tagged = or i64 %hInt, 281474976710656\n  ret i64 %tagged\n}\n\n"

    ipcIR = ipcIR.cat "define internal i64 @zuv_ipc_pipe_client(ptr %name) {\nentry:\n  %pipeName = call ptr @zuv_ipc_format_pipename(ptr %name)\n  %h = call ptr @CreateFileA(ptr %pipeName, i32 -1073741824, i32 0, ptr null, i32 3, i32 0, ptr null)\n  call void @free(ptr %pipeName)\n  %inv = inttoptr i64 -1 to ptr\n  %cmpBad = icmp eq ptr %h, %inv\n  br i1 %cmpBad, label %ret_err, label %ret_ok\nret_err:\n  ret i64 -1\nret_ok:\n  %hInt = ptrtoint ptr %h to i64\n  %tagged = or i64 %hInt, 281474976710656\n  ret i64 %tagged\n}\n\n"

    ipcIR = ipcIR.cat "define internal ptr @zuv_ipc_mmap(ptr %path, i64 %len) {\nentry:\n  %hFile = call ptr @CreateFileA(ptr %path, i32 -1073741824, i32 3, ptr null, i32 4, i32 128, ptr null)\n  %inv = inttoptr i64 -1 to ptr\n  %cmpBad = icmp eq ptr %hFile, %inv\n  br i1 %cmpBad, label %ret_null, label %check_len\ncheck_len:\n  %cmpLe = icmp sle i64 %len, 0\n  br i1 %cmpLe, label %query_sz, label %do_map_create\nquery_sz:\n  %fsz = call i32 @GetFileSize(ptr %hFile, ptr null)\n  %fsz64 = zext i32 %fsz to i64\n  br label %do_map_create\ndo_map_create:\n  %actualLen = phi i64 [ %len, %check_len ], [ %fsz64, %query_sz ]\n  %len32 = trunc i64 %actualLen to i32\n  %hMap = call ptr @CreateFileMappingA(ptr %hFile, ptr null, i32 4, i32 0, i32 %len32, ptr null)\n  call i32 @CloseHandle(ptr %hFile)\n  %cmpBadMap = icmp eq ptr %hMap, null\n  br i1 %cmpBadMap, label %ret_null, label %do_view\ndo_view:\n  %viewPtr = call ptr @MapViewOfFile(ptr %hMap, i32 6, i32 0, i32 0, i64 %actualLen)\n  call i32 @CloseHandle(ptr %hMap)\n  ret ptr %viewPtr\nret_null:\n  ret ptr null\n}\n\n"

    ipcIR = ipcIR.cat "define internal ptr @zuv_ipc_shm(ptr %name, i64 %size) {\nentry:\n  %inv = inttoptr i64 -1 to ptr\n  %sizeHigh = lshr i64 %size, 32\n  %sizeHigh32 = trunc i64 %sizeHigh to i32\n  %sizeLow32 = trunc i64 %size to i32\n  %isNameNull = icmp eq ptr %name, null\n  br i1 %isNameNull, label %check_empty_done, label %check_empty\ncheck_empty:\n  %c0 = load i8, ptr %name\n  %isEmpty = icmp eq i8 %c0, 0\n  br label %check_empty_done\ncheck_empty_done:\n  %noName = phi i1 [ true, %entry ], [ %isEmpty, %check_empty ]\n  %realName = select i1 %noName, ptr null, ptr %name\n  %hMap = call ptr @CreateFileMappingA(ptr %inv, ptr null, i32 4, i32 %sizeHigh32, i32 %sizeLow32, ptr %realName)\n  %cmpBad = icmp eq ptr %hMap, null\n  br i1 %cmpBad, label %ret_null, label %do_view\ndo_view:\n  %viewPtr = call ptr @MapViewOfFile(ptr %hMap, i32 6, i32 0, i32 0, i64 %size)\n  br i1 %noName, label %close_h, label %done\nclose_h:\n  call i32 @CloseHandle(ptr %hMap)\n  br label %done\ndone:\n  ret ptr %viewPtr\nret_null:\n  ret ptr null\n}\n\n"

    ipcIR = ipcIR.cat "define internal ptr @zuv_ipc_open_shm(ptr %name, i64 %size) {\nentry:\n  %isNameNull = icmp eq ptr %name, null\n  br i1 %isNameNull, label %ret_null, label %do_open\ndo_open:\n  %hMap = call ptr @OpenFileMappingA(i32 6, i32 0, ptr %name)\n  %cmpBad = icmp eq ptr %hMap, null\n  br i1 %cmpBad, label %ret_null, label %do_view\ndo_view:\n  %viewPtr = call ptr @MapViewOfFile(ptr %hMap, i32 6, i32 0, i32 0, i64 %size)\n  call i32 @CloseHandle(ptr %hMap)\n  ret ptr %viewPtr\nret_null:\n  ret ptr null\n}\n\n"

    ipcIR = ipcIR.cat "define internal double @zuv_ipc_unmap(ptr %ptr) {\nentry:\n  %isN = icmp eq ptr %ptr, null\n  br i1 %isN, label %ret_zero, label %do_unmap\ndo_unmap:\n  %res = call i32 @UnmapViewOfFile(ptr %ptr)\n  %dres = sitofp i32 %res to double\n  ret double %dres\nret_zero:\n  ret double 0.0\n}\n\n"

    ipcIR = ipcIR.cat "define internal double @zuv_ipc_flush(ptr %ptr, i64 %len) {\nentry:\n  %isN = icmp eq ptr %ptr, null\n  br i1 %isN, label %ret_zero, label %do_flush\ndo_flush:\n  %res = call i32 @FlushViewOfFile(ptr %ptr, i64 %len)\n  %dres = sitofp i32 %res to double\n  ret double %dres\nret_zero:\n  ret double 0.0\n}\n\n"

    ipcIR = ipcIR.cat "define internal i64 @zuv_ipc_write(ptr %ptr, i64 %offset, ptr %data) {\nentry:\n  %cmpP = icmp eq ptr %ptr, null\n  %cmpD = icmp eq ptr %data, null\n  %cmpOr = or i1 %cmpP, %cmpD\n  br i1 %cmpOr, label %ret_zero, label %do_write\ndo_write:\n  %dst = getelementptr inbounds i8, ptr %ptr, i64 %offset\n  %len = call i64 @strlen(ptr %data)\n  call ptr @memcpy(ptr %dst, ptr %data, i64 %len)\n  ret i64 %len\nret_zero:\n  ret i64 0\n}\n\n"

    ipcIR = ipcIR.cat "define internal ptr @zuv_ipc_read(ptr %ptr, i64 %offset, i64 %len) {\nentry:\n  %cmpP = icmp eq ptr %ptr, null\n  %cmpL = icmp sle i64 %len, 0\n  %cmpOr = or i1 %cmpP, %cmpL\n  br i1 %cmpOr, label %ret_empty, label %do_read\ndo_read:\n  %allocSz = add i64 %len, 1\n  %buf = call ptr @malloc(i64 %allocSz)\n  %src = getelementptr inbounds i8, ptr %ptr, i64 %offset\n  call ptr @memcpy(ptr %buf, ptr %src, i64 %len)\n  %endPtr = getelementptr inbounds i8, ptr %buf, i64 %len\n  store i8 0, ptr %endPtr\n  ret ptr %buf\nret_empty:\n  ret ptr @empty_str\n}\n\n"

    ipcIR = ipcIR.cat "define internal ptr @zuv_ipc_read_str(ptr %ptr, i64 %offset) {\nentry:\n  %cmpP = icmp eq ptr %ptr, null\n  br i1 %cmpP, label %ret_empty, label %do_read\ndo_read:\n  %src = getelementptr inbounds i8, ptr %ptr, i64 %offset\n  %len = call i64 @strlen(ptr %src)\n  %allocSz = add i64 %len, 1\n  %buf = call ptr @malloc(i64 %allocSz)\n  call ptr @memcpy(ptr %buf, ptr %src, i64 %allocSz)\n  ret ptr %buf\nret_empty:\n  ret ptr @empty_str\n}\n\n"

    ipcIR = ipcIR.cat "define internal i64 @zuv_ipc_mutex(ptr %name) {\nentry:\n  %h = call ptr @CreateMutexA(ptr null, i32 0, ptr %name)\n  %h64 = ptrtoint ptr %h to i64\n  ret i64 %h64\n}\n\n"

    ipcIR = ipcIR.cat "define internal double @zuv_ipc_mutex_lock(i64 %h) {\nentry:\n  %rawI64 = and i64 %h, -281474976710657\n  %hPtr = inttoptr i64 %rawI64 to ptr\n  %res = call i32 @WaitForSingleObject(ptr %hPtr, i32 -1)\n  %cmp = icmp eq i32 %res, 0\n  %sel = select i1 %cmp, double 1.0, double 0.0\n  ret double %sel\n}\n\n"

    ipcIR = ipcIR.cat "define internal double @zuv_ipc_mutex_trylock(i64 %h) {\nentry:\n  %rawI64 = and i64 %h, -281474976710657\n  %hPtr = inttoptr i64 %rawI64 to ptr\n  %res = call i32 @WaitForSingleObject(ptr %hPtr, i32 0)\n  %cmp = icmp eq i32 %res, 0\n  %sel = select i1 %cmp, double 1.0, double 0.0\n  ret double %sel\n}\n\n"

    ipcIR = ipcIR.cat "define internal double @zuv_ipc_mutex_unlock(i64 %h) {\nentry:\n  %rawI64 = and i64 %h, -281474976710657\n  %hPtr = inttoptr i64 %rawI64 to ptr\n  %res = call i32 @ReleaseMutex(ptr %hPtr)\n  %dres = sitofp i32 %res to double\n  ret double %dres\n}\n\n"

    ipcIR = ipcIR.cat "define internal i64 @zuv_ipc_sem(ptr %name, i32 %init, i32 %max) {\nentry:\n  %h = call ptr @CreateSemaphoreA(ptr null, i32 %init, i32 %max, ptr %name)\n  %h64 = ptrtoint ptr %h to i64\n  ret i64 %h64\n}\n\n"

    ipcIR = ipcIR.cat "define internal double @zuv_ipc_sem_wait(i64 %h, i32 %timeoutMs) {\nentry:\n  %rawI64 = and i64 %h, -281474976710657\n  %hPtr = inttoptr i64 %rawI64 to ptr\n  %res = call i32 @WaitForSingleObject(ptr %hPtr, i32 %timeoutMs)\n  %cmp = icmp eq i32 %res, 0\n  %sel = select i1 %cmp, double 1.0, double 0.0\n  ret double %sel\n}\n\n"

    ipcIR = ipcIR.cat "define internal double @zuv_ipc_sem_post(i64 %h, i32 %count) {\nentry:\n  %rawI64 = and i64 %h, -281474976710657\n  %hPtr = inttoptr i64 %rawI64 to ptr\n  %cmpLe = icmp sle i32 %count, 0\n  %c = select i1 %cmpLe, i32 1, i32 %count\n  %res = call i32 @ReleaseSemaphore(ptr %hPtr, i32 %c, ptr null)\n  %dres = sitofp i32 %res to double\n  ret double %dres\n}\n\n"

    ipcIR = ipcIR.cat "define internal i64 @zuv_ipc_event(ptr %name, i32 %manualReset, i32 %initialState) {\nentry:\n  %h = call ptr @CreateEventA(ptr null, i32 %manualReset, i32 %initialState, ptr %name)\n  %h64 = ptrtoint ptr %h to i64\n  ret i64 %h64\n}\n\n"

    ipcIR = ipcIR.cat "define internal double @zuv_ipc_event_set(i64 %h) {\nentry:\n  %rawI64 = and i64 %h, -281474976710657\n  %hPtr = inttoptr i64 %rawI64 to ptr\n  %res = call i32 @SetEvent(ptr %hPtr)\n  %dres = sitofp i32 %res to double\n  ret double %dres\n}\n\n"

    ipcIR = ipcIR.cat "define internal double @zuv_ipc_event_reset(i64 %h) {\nentry:\n  %rawI64 = and i64 %h, -281474976710657\n  %hPtr = inttoptr i64 %rawI64 to ptr\n  %res = call i32 @ResetEvent(ptr %hPtr)\n  %dres = sitofp i32 %res to double\n  ret double %dres\n}\n\n"

    ipcIR = ipcIR.cat "define internal double @zuv_ipc_event_wait(i64 %h, i32 %timeoutMs) {\nentry:\n  %rawI64 = and i64 %h, -281474976710657\n  %hPtr = inttoptr i64 %rawI64 to ptr\n  %res = call i32 @WaitForSingleObject(ptr %hPtr, i32 %timeoutMs)\n  %cmp = icmp eq i32 %res, 0\n  %sel = select i1 %cmp, double 1.0, double 0.0\n  ret double %sel\n}\n\n"

    ipcIR = ipcIR.cat "define internal double @zuv_ipc_close(i64 %h) {\nentry:\n  %rawI64 = and i64 %h, -281474976710657\n  %hPtr = inttoptr i64 %rawI64 to ptr\n  %res = call i32 @CloseHandle(ptr %hPtr)\n  %dres = sitofp i32 %res to double\n  ret double %dres\n}\n"

    -> ipcIR
}

emitTermRuntime cg {
