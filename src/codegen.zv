    termIR = termIR.cat "@.zuv_term_show_cur = private unnamed_addr constant [7 x i8] c\"\\1B[?25h\\00\"\n"
    termIR = termIR.cat "@.zuv_term_enter_alt = private unnamed_addr constant [9 x i8] c\"\\1B[?1049h\\00\"\n"
    termIR = termIR.cat "@.zuv_term_exit_alt = private unnamed_addr constant [9 x i8] c\"\\1B[?1049l\\00\"\n"
