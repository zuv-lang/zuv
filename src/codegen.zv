            outBuf.code = outBuf.code.cat (`  ${objPtr} = call ptr @zuv_http_parse_req(ptr ${rawPtr})\n`)
            objInt = newReg cg
            outBuf.code = outBuf.code.cat (`  ${objInt} = ptrtoint ptr ${objPtr} to i64\n`)
            dReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${dReg} = sitofp i64 ${objInt} to double\n`)
            -> dReg
        } els if expr.callee == "ws.conn" && expr.args.ln == 1 {
            urlPtr = getStrPtrVal cg, expr.args[0], outBuf
            sReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${sReg} = call i64 @zuv_ws_conn(ptr ${urlPtr})\n`)
            dReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${dReg} = sitofp i64 ${sReg} to double\n`)
            -> dReg
        } els if expr.callee == "ws.send" && expr.args.ln == 2 {
            sReg = codegenExpr cg, expr.args[0], outBuf
            sInt = newReg cg
            outBuf.code = outBuf.code.cat (`  ${sInt} = fptosi double ${sReg} to i64\n`)
            msgPtr = getStrPtrVal cg, expr.args[1], outBuf
            sentReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${sentReg} = call i64 @zuv_ws_send(i64 ${sInt}, ptr ${msgPtr})\n`)
            dReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${dReg} = sitofp i64 ${sentReg} to double\n`)
            -> dReg
        } els if expr.callee == "ws.recv" && expr.args.ln == 1 {
            sReg = codegenExpr cg, expr.args[0], outBuf
            sInt = newReg cg
            outBuf.code = outBuf.code.cat (`  ${sInt} = fptosi double ${sReg} to i64\n`)
            resPtr = newReg cg
            outBuf.code = outBuf.code.cat (`  ${resPtr} = call ptr @zuv_ws_recv(i64 ${sInt})\n`)
            resInt = newReg cg
            outBuf.code = outBuf.code.cat (`  ${resInt} = ptrtoint ptr ${resPtr} to i64\n`)
            dReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${dReg} = sitofp i64 ${resInt} to double\n`)
            -> dReg
        }

        if expr.callee == "zuv_ptr_deref" && expr.args.ln == 1 {
            arg0 = expr.args[0]
            aReg = codegenExpr cg, arg0, outBuf
            aInt = newReg cg
            outBuf.code = outBuf.code.cat (`  ${aInt} = fptosi double ${aReg} to i64\n`)
            aPtr = newReg cg
            outBuf.code = outBuf.code.cat (`  ${aPtr} = inttoptr i64 ${aInt} to ptr\n`)
            loadedPtr = newReg cg
            outBuf.code = outBuf.code.cat (`  ${loadedPtr} = load ptr, ptr ${aPtr}\n`)
            pInt = newReg cg
            outBuf.code = outBuf.code.cat (`  ${pInt} = ptrtoint ptr ${loadedPtr} to i64\n`)
            dReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${dReg} = sitofp i64 ${pInt} to double\n`)
            -> dReg
        }

        extInfo = findCgExtern cg, expr.callee
        if extInfo.name != "" {
            let callArgsStr = ""
            let i = 0
            wh i < expr.args.ln {
                arg = expr.args[i]
                let expectedType = "num"
                if i < extInfo.params.ln {
                    expectedType = extInfo.params[i].typeName
                }
                if i > 0 { callArgsStr = callArgsStr.cat ", " }
                if expectedType == "str" || expectedType == "ptr" {
                    aPtr = getStrPtrVal cg, arg, outBuf
                    callArgsStr = callArgsStr.cat (`ptr ${aPtr}`)
                } els if expectedType == "i64" {
                    aReg = codegenExpr cg, arg, outBuf
                    aInt = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${aInt} = fptosi double ${aReg} to i64\n`)
                    callArgsStr = callArgsStr.cat (`i64 ${aInt}`)
                } els if expectedType == "double" {
                    aReg = codegenExpr cg, arg, outBuf
                    callArgsStr = callArgsStr.cat (`double ${aReg}`)
                } els {
                    // default i32
                    aReg = codegenExpr cg, arg, outBuf
                    aInt = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${aInt} = fptosi double ${aReg} to i32\n`)
                    callArgsStr = callArgsStr.cat (`i32 ${aInt}`)
                }
                i = i + 1
            }
            let retType = "i32"
            if extInfo.typeName == "void" {
                retType = "void"
            } els if extInfo.typeName == "str" || extInfo.typeName == "ptr" {
                retType = "ptr"
            } els if extInfo.typeName == "double" {
                retType = "double"
            } els if extInfo.typeName == "i64" {
                retType = "i64"
            } els if extInfo.typeName == "num" || extInfo.typeName == "i32" {
                retType = "i32"
            }
            if retType == "void" {
                outBuf.code = outBuf.code.cat (`  call void @${expr.callee}(${callArgsStr})\n`)
                -> "0.0"
            }
            cReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${cReg} = call ${retType} @${expr.callee}(${callArgsStr})\n`)
            if retType == "i32" {
                dReg = newReg cg
                outBuf.code = outBuf.code.cat (`  ${dReg} = sitofp i32 ${cReg} to double\n`)
                -> dReg
            } els if retType == "i64" {
                dReg = newReg cg
                outBuf.code = outBuf.code.cat (`  ${dReg} = sitofp i64 ${cReg} to double\n`)
                -> dReg
            } els if retType == "ptr" {
                pInt = newReg cg
                outBuf.code = outBuf.code.cat (`  ${pInt} = ptrtoint ptr ${cReg} to i64\n`)
                dReg = newReg cg
                outBuf.code = outBuf.code.cat (`  ${dReg} = sitofp i64 ${pInt} to double\n`)
                -> dReg
            }
            -> cReg
        }

        let callArgsStr = ""
        // A variable in callee position is an indirect function call.
        calleeSym = findCgSymbol cg, expr.callee
        if calleeSym.name != "" {
            let indirectArgs = ""
            let ii = 0
            wh ii < expr.args.ln {
                indirectArg = codegenExpr cg, expr.args[ii], outBuf
                if ii > 0 { indirectArgs = indirectArgs.cat ", " }
                indirectArgs = indirectArgs.cat (`double ${indirectArg}`)
                ii = ii + 1
            }
            fnVal = newReg cg
            outBuf.code = outBuf.code.cat (`  ${fnVal} = load double, ptr ${calleeSym.reg}\n`)
            fnBits = newReg cg
            outBuf.code = outBuf.code.cat (`  ${fnBits} = fptosi double ${fnVal} to i64\n`)
            fnPtr = newReg cg
            outBuf.code = outBuf.code.cat (`  ${fnPtr} = inttoptr i64 ${fnBits} to ptr\n`)
            indirectRes = newReg cg
            outBuf.code = outBuf.code.cat (`  ${indirectRes} = call double ${fnPtr}(${indirectArgs})\n`)
            -> indirectRes
        }

        restIdx = findRestIdx cg, expr.callee
        if restIdx >= 0 {
            let i = 0
            wh i < restIdx {
                if i < expr.args.ln {
                    arg = expr.args[i]
                    aReg = codegenExpr cg, arg, outBuf
                    if i > 0 { callArgsStr = callArgsStr.cat ", " }
                    callArgsStr = callArgsStr.cat (`double ${aReg}`)
                }
                i = i + 1
            }
            mut restCount = 0
            if expr.args.ln > restIdx {
                restCount = expr.args.ln - restIdx
            }
            restBytes = (restCount + 1024) * 8
            restPtr = newReg cg
            outBuf.code = outBuf.code.cat (`  ${restPtr} = call ptr @malloc(i64 ${restBytes})\n`)
            outBuf.code = outBuf.code.cat (`  store double ${restCount}.0, ptr ${restPtr}\n`)
            let ri = 0
            wh ri < restCount {
                arg = expr.args[restIdx + ri]
                aReg = codegenExpr cg, arg, outBuf
                aInt = newReg cg
                outBuf.code = outBuf.code.cat (`  ${aInt} = bitcast double ${aReg} to i64\n`)
                gepReg = newReg cg
                elemIdx = ri + 1
                outBuf.code = outBuf.code.cat (`  ${gepReg} = getelementptr inbounds i64, ptr ${restPtr}, i64 ${elemIdx}\n`)
                outBuf.code = outBuf.code.cat (`  store i64 ${aInt}, ptr ${gepReg}\n`)
                ri = ri + 1
            }
            restInt = newReg cg
            outBuf.code = outBuf.code.cat (`  ${restInt} = ptrtoint ptr ${restPtr} to i64\n`)
            restDbl = newReg cg
            outBuf.code = outBuf.code.cat (`  ${restDbl} = sitofp i64 ${restInt} to double\n`)
            if restIdx > 0 { callArgsStr = callArgsStr.cat ", " }
            callArgsStr = callArgsStr.cat (`double ${restDbl}`)
        } els {
            mut finalCallee = expr.callee
            if expr.callee == "hello" {
                finalCallee = "greet"
            }
            uMangle = `@User_${expr.callee}(`
            sMangle = `@Schema_${expr.callee}(`
            if (cg.funcs.cnt uMangle) > 0 {
                finalCallee = `User_${expr.callee}`
            } els if (cg.funcs.cnt sMangle) > 0 {
                finalCallee = `Schema_${expr.callee}`
            }
            mut startArg = 0
            if finalCallee == "greet" && expr.args.ln == 2 {
                startArg = 1
            }
            if expr.args.ln > 0 {
                firstA = expr.args[0]
                if firstA.kind == "VariableExpr" {
                    varNameStr = firstA.name
                    let isUpVN = 0
                    if varNameStr.ln > 0 {
                        c0Str = varNameStr.chr 0
                        if c0Str == "A" || c0Str == "B" || c0Str == "C" || c0Str == "D" || c0Str == "E" || c0Str == "F" ||
                           c0Str == "G" || c0Str == "H" || c0Str == "I" || c0Str == "J" || c0Str == "K" || c0Str == "L" ||
                           c0Str == "M" || c0Str == "N" || c0Str == "O" || c0Str == "P" || c0Str == "Q" || c0Str == "R" ||
                           c0Str == "S" || c0Str == "T" || c0Str == "U" || c0Str == "V" || c0Str == "W" || c0Str == "X" ||
                           c0Str == "Y" || c0Str == "Z" {
                            isUpVN = 1
                        }
                    }
                    if isUpVN == 1 {
                        finalCallee = `${varNameStr}_${expr.callee}`
                        startArg = 1
                    }
                }
            }
            let i = startArg
            wh i < expr.args.ln {
                arg = expr.args[i]
                aReg = codegenExpr cg, arg, outBuf
                if i > startArg { callArgsStr = callArgsStr.cat ", " }
                callArgsStr = callArgsStr.cat (`double ${aReg}`)
                i = i + 1
            }
            retReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${retReg} = call double @${finalCallee}(${callArgsStr})\n`)
            -> retReg
        }
    } els if expr.kind == "ArrayExpr" {
        // Detect spreads
        mut hasSpread = 0
        let si = 0
        wh si < expr.elements.ln {
            if expr.elements[si].kind == "SpreadExpr" {
                hasSpread = 1
            }
            si = si + 1
        }
        if hasSpread == 1 {
            bufReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${bufReg} = call ptr @malloc(i64 8192)\n`)
            outBuf.code = outBuf.code.cat (`  store double 0.0, ptr ${bufReg}\n`)
            let ei = 0
            wh ei < expr.elements.ln {
                elem = expr.elements[ei]
                if elem.kind == "SpreadExpr" {
                    srcReg = codegenExpr cg, elem.expr, outBuf
                    srcInt = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${srcInt} = fptosi double ${srcReg} to i64\n`)
                    isNil = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${isNil} = icmp eq i64 ${srcInt}, 0\n`)
                    skipLbl = newLbl cg, "spread_skip"
                    copyLbl = newLbl cg, "spread_copy"
                    mergeLbl = newLbl cg, "spread_merge"
                    outBuf.code = outBuf.code.cat (`  br i1 ${isNil}, label %${skipLbl}, label %${copyLbl}\n\n`)
                    outBuf.code = outBuf.code.cat (`${copyLbl}:\n`)
                    srcPtr = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${srcPtr} = inttoptr i64 ${srcInt} to ptr\n`)
                    srcLenDbl = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${srcLenDbl} = load double, ptr ${srcPtr}\n`)
                    srcLen = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${srcLen} = fptosi double ${srcLenDbl} to i64\n`)
                    iSlot = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${iSlot} = alloca i64\n`)
                    outBuf.code = outBuf.code.cat (`  store i64 0, ptr ${iSlot}\n`)
                    loopCond = newLbl cg, "spread_cond"
                    loopBody = newLbl cg, "spread_body"
                    loopEnd = newLbl cg, "spread_end"
                    outBuf.code = outBuf.code.cat (`  br label %${loopCond}\n\n`)
                    outBuf.code = outBuf.code.cat (`${loopCond}:\n`)
                    iVal = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${iVal} = load i64, ptr ${iSlot}\n`)
                    cmp = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${cmp} = icmp slt i64 ${iVal}, ${srcLen}\n`)
                    outBuf.code = outBuf.code.cat (`  br i1 ${cmp}, label %${loopBody}, label %${loopEnd}\n\n`)
                    outBuf.code = outBuf.code.cat (`${loopBody}:\n`)
                    elemIdx = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${elemIdx} = add i64 ${iVal}, 1\n`)
                    srcGep = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${srcGep} = getelementptr inbounds i64, ptr ${srcPtr}, i64 ${elemIdx}\n`)
                    elemVal = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${elemVal} = load i64, ptr ${srcGep}\n`)
                    curLenDbl = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${curLenDbl} = load double, ptr ${bufReg}\n`)
                    curLenInt = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${curLenInt} = fptosi double ${curLenDbl} to i64\n`)
                    nextIdx = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${nextIdx} = add i64 ${curLenInt}, 1\n`)
                    dstGep = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${dstGep} = getelementptr inbounds i64, ptr ${bufReg}, i64 ${nextIdx}\n`)
                    outBuf.code = outBuf.code.cat (`  store i64 ${elemVal}, ptr ${dstGep}\n`)
                    newLenDbl = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${newLenDbl} = sitofp i64 ${nextIdx} to double\n`)
                    outBuf.code = outBuf.code.cat (`  store double ${newLenDbl}, ptr ${bufReg}\n`)
                    iNext = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${iNext} = add i64 ${iVal}, 1\n`)
                    outBuf.code = outBuf.code.cat (`  store i64 ${iNext}, ptr ${iSlot}\n`)
                    outBuf.code = outBuf.code.cat (`  br label %${loopCond}\n\n`)
                    outBuf.code = outBuf.code.cat (`${loopEnd}:\n`)
                    outBuf.code = outBuf.code.cat (`  br label %${mergeLbl}\n\n`)
                    outBuf.code = outBuf.code.cat (`${skipLbl}:\n`)
                    outBuf.code = outBuf.code.cat (`  br label %${mergeLbl}\n\n`)
                    outBuf.code = outBuf.code.cat (`${mergeLbl}:\n`)
                } els {
                    eValReg = codegenExpr cg, elem, outBuf
                    eValInt = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${eValInt} = bitcast double ${eValReg} to i64\n`)
                    curLenDbl = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${curLenDbl} = load double, ptr ${bufReg}\n`)
                    curLenInt = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${curLenInt} = fptosi double ${curLenDbl} to i64\n`)
                    nextIdx = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${nextIdx} = add i64 ${curLenInt}, 1\n`)
                    dstGep = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${dstGep} = getelementptr inbounds i64, ptr ${bufReg}, i64 ${nextIdx}\n`)
                    outBuf.code = outBuf.code.cat (`  store i64 ${eValInt}, ptr ${dstGep}\n`)
                    newLenDbl = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${newLenDbl} = sitofp i64 ${nextIdx} to double\n`)
                    outBuf.code = outBuf.code.cat (`  store double ${newLenDbl}, ptr ${bufReg}\n`)
                }
                ei = ei + 1
            }
            bufInt = newReg cg
            outBuf.code = outBuf.code.cat (`  ${bufInt} = ptrtoint ptr ${bufReg} to i64\n`)
            bufDbl = newReg cg
            outBuf.code = outBuf.code.cat (`  ${bufDbl} = sitofp i64 ${bufInt} to double\n`)
            -> bufDbl
        }
        arrSize = expr.elements.ln
        bufReg = newReg cg
        outBuf.code = outBuf.code.cat (`  ${bufReg} = call ptr @malloc(i64 8216)\n`)
        outBuf.code = outBuf.code.cat (`  store double ${arrSize}.0, ptr ${bufReg}\n`)
        let ai = 0
        wh ai < arrSize {
            elem = expr.elements[ai]
            elemReg = codegenExpr cg, elem, outBuf
            elemInt = newReg cg
            outBuf.code = outBuf.code.cat (`  ${elemInt} = bitcast double ${elemReg} to i64\n`)
            elemOffset = ai + 1
            gepReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${gepReg} = getelementptr inbounds i64, ptr ${bufReg}, i64 ${elemOffset}\n`)
            outBuf.code = outBuf.code.cat (`  store i64 ${elemInt}, ptr ${gepReg}\n`)
            ai = ai + 1
        }
        kOffArr = findFieldOffset cg, "__keys"
        keysGep = newReg cg
        outBuf.code = outBuf.code.cat (`  ${keysGep} = getelementptr inbounds i64, ptr ${bufReg}, i64 ${kOffArr}\n`)
        outBuf.code = outBuf.code.cat (`  store i64 0, ptr ${keysGep}\n`)
        bufInt = newReg cg
        outBuf.code = outBuf.code.cat (`  ${bufInt} = ptrtoint ptr ${bufReg} to i64\n`)
        bufDbl = newReg cg
        outBuf.code = outBuf.code.cat (`  ${bufDbl} = sitofp i64 ${bufInt} to double\n`)
        -> bufDbl
    } els if expr.kind == "StructLiteral" {
        bufReg = newReg cg
        outBuf.code = outBuf.code.cat (`  ${bufReg} = call ptr @malloc(i64 8192)\n`)
        mut anySpread = 0
        let sfi = 0
        wh sfi < expr.fields.ln {
            if expr.fields[sfi].isSpread == 1 {
                anySpread = 1
            }
            sfi = sfi + 1
        }
        if anySpread == 1 {
            zReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${zReg} = call ptr @memset(ptr ${bufReg}, i32 0, i64 8192)\n`)
        }
        let fi = 0
        wh fi < expr.fields.ln {
            f = expr.fields[fi]
            if f.isSpread == 1 {
                srcReg = codegenExpr cg, f.value, outBuf
                srcInt = newReg cg
                outBuf.code = outBuf.code.cat (`  ${srcInt} = fptosi double ${srcReg} to i64\n`)
                isNil = newReg cg
                outBuf.code = outBuf.code.cat (`  ${isNil} = icmp eq i64 ${srcInt}, 0\n`)
                skipLbl = newLbl cg, "objspread_skip"
                copyLbl = newLbl cg, "objspread_copy"
                mergeLbl = newLbl cg, "objspread_merge"
                outBuf.code = outBuf.code.cat (`  br i1 ${isNil}, label %${skipLbl}, label %${copyLbl}\n\n`)
                outBuf.code = outBuf.code.cat (`${copyLbl}:\n`)
                srcPtr = newReg cg
                outBuf.code = outBuf.code.cat (`  ${srcPtr} = inttoptr i64 ${srcInt} to ptr\n`)
                cpy = newReg cg
                outBuf.code = outBuf.code.cat (`  ${cpy} = call ptr @memcpy(ptr ${bufReg}, ptr ${srcPtr}, i64 8192)\n`)
                outBuf.code = outBuf.code.cat (`  br label %${mergeLbl}\n\n`)
                outBuf.code = outBuf.code.cat (`${skipLbl}:\n`)
                outBuf.code = outBuf.code.cat (`  br label %${mergeLbl}\n\n`)
                outBuf.code = outBuf.code.cat (`${mergeLbl}:\n`)
            } els {
                fOffset = findFieldOffset cg, f.name
                fValReg = codegenExpr cg, f.value, outBuf
                fValInt = newReg cg
                outBuf.code = outBuf.code.cat (`  ${fValInt} = bitcast double ${fValReg} to i64\n`)
                gepReg = newReg cg
                outBuf.code = outBuf.code.cat (`  ${gepReg} = getelementptr inbounds i64, ptr ${bufReg}, i64 ${fOffset}\n`)
                outBuf.code = outBuf.code.cat (`  store i64 ${fValInt}, ptr ${gepReg}\n`)
            }
            fi = fi + 1
        }
        // Enumerable keys/values sidecars for `fr … in`
        let keyNames = []
        let kfi = 0
        wh kfi < expr.fields.ln {
            kf = expr.fields[kfi]
            if kf.isSpread == 0 {
                kn0 = kf.name
                if (strEq kn0, "") == 0 {
                    keyNames.psh kn0
                }
            }
            kfi = kfi + 1
        }
        if keyNames.ln > 0 {
            kcount = keyNames.ln
            kbytes = (kcount + 1024) * 8
            keysBuf = newReg cg
            outBuf.code = outBuf.code.cat (`  ${keysBuf} = call ptr @malloc(i64 ${kbytes})\n`)
            outBuf.code = outBuf.code.cat (`  store double ${kcount}.0, ptr ${keysBuf}\n`)
            valsBuf = newReg cg
            outBuf.code = outBuf.code.cat (`  ${valsBuf} = call ptr @malloc(i64 ${kbytes})\n`)
            outBuf.code = outBuf.code.cat (`  store double ${kcount}.0, ptr ${valsBuf}\n`)
            let ki = 0
            wh ki < keyNames.ln {
                kn = keyNames[ki]
                sName = addStrConstant cg, kn
                keyInt = newReg cg
                outBuf.code = outBuf.code.cat (`  ${keyInt} = ptrtoint ptr ${sName} to i64\n`)
                keyDbl = newReg cg
                outBuf.code = outBuf.code.cat (`  ${keyDbl} = sitofp i64 ${keyInt} to double\n`)
                keyBits = newReg cg
                outBuf.code = outBuf.code.cat (`  ${keyBits} = bitcast double ${keyDbl} to i64\n`)
                kgep = newReg cg
                kslot = ki + 1
                outBuf.code = outBuf.code.cat (`  ${kgep} = getelementptr inbounds i64, ptr ${keysBuf}, i64 ${kslot}\n`)
                outBuf.code = outBuf.code.cat (`  store i64 ${keyBits}, ptr ${kgep}\n`)
                fOff = findFieldOffset cg, kn
                fgep = newReg cg
                outBuf.code = outBuf.code.cat (`  ${fgep} = getelementptr inbounds i64, ptr ${bufReg}, i64 ${fOff}\n`)
                fval = newReg cg
                outBuf.code = outBuf.code.cat (`  ${fval} = load i64, ptr ${fgep}\n`)
                vgep = newReg cg
                outBuf.code = outBuf.code.cat (`  ${vgep} = getelementptr inbounds i64, ptr ${valsBuf}, i64 ${kslot}\n`)
                outBuf.code = outBuf.code.cat (`  store i64 ${fval}, ptr ${vgep}\n`)
                ki = ki + 1
            }
            keysInt = newReg cg
            outBuf.code = outBuf.code.cat (`  ${keysInt} = ptrtoint ptr ${keysBuf} to i64\n`)
            keysDbl = newReg cg
            outBuf.code = outBuf.code.cat (`  ${keysDbl} = sitofp i64 ${keysInt} to double\n`)
            keysBits = newReg cg
            outBuf.code = outBuf.code.cat (`  ${keysBits} = bitcast double ${keysDbl} to i64\n`)
            valsInt = newReg cg
            outBuf.code = outBuf.code.cat (`  ${valsInt} = ptrtoint ptr ${valsBuf} to i64\n`)
            valsDbl = newReg cg
            outBuf.code = outBuf.code.cat (`  ${valsDbl} = sitofp i64 ${valsInt} to double\n`)
            valsBits = newReg cg
            outBuf.code = outBuf.code.cat (`  ${valsBits} = bitcast double ${valsDbl} to i64\n`)
            kOffX = findFieldOffset cg, "__keys"
            vOffX = findFieldOffset cg, "__vals"
            keysSlot = newReg cg
            outBuf.code = outBuf.code.cat (`  ${keysSlot} = getelementptr inbounds i64, ptr ${bufReg}, i64 ${kOffX}\n`)
            outBuf.code = outBuf.code.cat (`  store i64 ${keysBits}, ptr ${keysSlot}\n`)
            valsSlot = newReg cg
            outBuf.code = outBuf.code.cat (`  ${valsSlot} = getelementptr inbounds i64, ptr ${bufReg}, i64 ${vOffX}\n`)
            outBuf.code = outBuf.code.cat (`  store i64 ${valsBits}, ptr ${valsSlot}\n`)
        }
        bufInt = newReg cg
        outBuf.code = outBuf.code.cat (`  ${bufInt} = ptrtoint ptr ${bufReg} to i64\n`)
        bufDbl = newReg cg
        outBuf.code = outBuf.code.cat (`  ${bufDbl} = sitofp i64 ${bufInt} to double\n`)
        -> bufDbl
    } els if expr.kind == "NewExpr" {
        if expr.typeName == "Prm" || expr.typeName == "Promise" {
            mReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${mReg} = load i32, ptr @zuv_async_context_mode\n`)
            prmReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${prmReg} = call ptr @zuv_prm_new(i32 ${mReg})\n`)
            outBuf.code = outBuf.code.cat (`  store ptr ${prmReg}, ptr @zuv_active_prm\n`)
            if expr.args.ln > 0 {
                cbReg = codegenExpr cg, expr.args[0], outBuf
                cbInt = newReg cg
                outBuf.code = outBuf.code.cat (`  ${cbInt} = fptosi double ${cbReg} to i64\n`)
                cbPtr = newReg cg
                outBuf.code = outBuf.code.cat (`  ${cbPtr} = inttoptr i64 ${cbInt} to ptr\n`)
                resCbInt = newReg cg
                outBuf.code = outBuf.code.cat (`  ${resCbInt} = ptrtoint ptr @zuv_prm_cb_resolve to i64\n`)
                resCbDbl = newReg cg
                outBuf.code = outBuf.code.cat (`  ${resCbDbl} = sitofp i64 ${resCbInt} to double\n`)
                rejCbInt = newReg cg
                outBuf.code = outBuf.code.cat (`  ${rejCbInt} = ptrtoint ptr @zuv_prm_cb_reject to i64\n`)
                rejCbDbl = newReg cg
                outBuf.code = outBuf.code.cat (`  ${rejCbDbl} = sitofp i64 ${rejCbInt} to double\n`)
                dummyReg = newReg cg
                outBuf.code = outBuf.code.cat (`  ${dummyReg} = call double ${cbPtr}(double ${resCbDbl}, double ${rejCbDbl})\n`)
            }
            prmInt = newReg cg
            outBuf.code = outBuf.code.cat (`  ${prmInt} = ptrtoint ptr ${prmReg} to i64\n`)
            prmDbl = newReg cg
            outBuf.code = outBuf.code.cat (`  ${prmDbl} = sitofp i64 ${prmInt} to double\n`)
            -> prmDbl
        }
        if expr.isStructLiteral == 1 {
            bufReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${bufReg} = call ptr @malloc(i64 8192)\n`)
            let fi = 0
            wh fi < expr.fields.ln {
                f = expr.fields[fi]
                fOffset = findFieldOffset cg, f.name
                fValReg = codegenExpr cg, f.value, outBuf
                fValInt = newReg cg
                outBuf.code = outBuf.code.cat (`  ${fValInt} = bitcast double ${fValReg} to i64\n`)
                gepReg = newReg cg
                outBuf.code = outBuf.code.cat (`  ${gepReg} = getelementptr inbounds i64, ptr ${bufReg}, i64 ${fOffset}\n`)
                outBuf.code = outBuf.code.cat (`  store i64 ${fValInt}, ptr ${gepReg}\n`)
                fi = fi + 1
            }
            bufInt = newReg cg
            outBuf.code = outBuf.code.cat (`  ${bufInt} = ptrtoint ptr ${bufReg} to i64\n`)
            bufDbl = newReg cg
            outBuf.code = outBuf.code.cat (`  ${bufDbl} = sitofp i64 ${bufInt} to double\n`)
            -> bufDbl
        }
        if expr.args.ln == 1 {
            firstA = expr.args[0]
            if firstA.kind == "StructLiteral" {
                slit = firstA
                bufReg = newReg cg
                outBuf.code = outBuf.code.cat (`  ${bufReg} = call ptr @malloc(i64 8192)\n`)
                let fi = 0
                wh fi < slit.fields.ln {
                    f = slit.fields[fi]
                    fOffset = findFieldOffset cg, f.name
                    fValReg = codegenExpr cg, f.value, outBuf
                    fValInt = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${fValInt} = bitcast double ${fValReg} to i64\n`)
                    gepReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${gepReg} = getelementptr inbounds i64, ptr ${bufReg}, i64 ${fOffset}\n`)
                    outBuf.code = outBuf.code.cat (`  store i64 ${fValInt}, ptr ${gepReg}\n`)
                    fi = fi + 1
                }
                bufInt = newReg cg
                outBuf.code = outBuf.code.cat (`  ${bufInt} = ptrtoint ptr ${bufReg} to i64\n`)
                bufDbl = newReg cg
                outBuf.code = outBuf.code.cat (`  ${bufDbl} = sitofp i64 ${bufInt} to double\n`)
                -> bufDbl
            }
        }
        createMethod = `${expr.typeName}_create`
        let argRegs = []
        let ai = 0
        wh ai < expr.args.ln {
            aReg = codegenExpr cg, expr.args[ai], outBuf
            argRegs.psh aReg
            ai = ai + 1
        }
        resDbl = newReg cg
        let argStr = ""
        let ar = 0
        wh ar < argRegs.ln {
            if ar > 0 { argStr = argStr.cat ", " }
            argStr = argStr.cat (`double ${argRegs[ar]}`)
            ar = ar + 1
        }
        outBuf.code = outBuf.code.cat (`  ${resDbl} = call double @${createMethod}(${argStr})\n`)
        -> resDbl
    } els if expr.kind == "PropertyAccess" {
        if expr.optional == 1 {
            objE = expr.object
            propName = expr.property
            slot = newReg cg
            outBuf.code = outBuf.code.cat (`  ${slot} = alloca double\n`)
            objReg = codegenExpr cg, objE, outBuf
            // Match normal property: pointers are sitofp-encoded → fptosi to recover
            objInt = newReg cg
            outBuf.code = outBuf.code.cat (`  ${objInt} = fptosi double ${objReg} to i64\n`)
            isNil = newReg cg
            outBuf.code = outBuf.code.cat (`  ${isNil} = icmp eq i64 ${objInt}, 0\n`)
            isUnd = newReg cg
            outBuf.code = outBuf.code.cat (`  ${isUnd} = icmp eq i64 ${objInt}, 1\n`)
            isNullish = newReg cg
            outBuf.code = outBuf.code.cat (`  ${isNullish} = or i1 ${isNil}, ${isUnd}\n`)
            nilLbl = newLbl cg, "optprop_nil"
            accLbl = newLbl cg, "optprop_acc"
            mergeLbl = newLbl cg, "optprop_merge"
            outBuf.code = outBuf.code.cat (`  br i1 ${isNullish}, label %${nilLbl}, label %${accLbl}\n\n`)
            outBuf.code = outBuf.code.cat (`${nilLbl}:\n`)
            outBuf.code = outBuf.code.cat (`  store double 0.0, ptr ${slot}\n`)
            outBuf.code = outBuf.code.cat (`  br label %${mergeLbl}\n\n`)
            outBuf.code = outBuf.code.cat (`${accLbl}:\n`)
            objPtr = newReg cg
            outBuf.code = outBuf.code.cat (`  ${objPtr} = inttoptr i64 ${objInt} to ptr\n`)
            fOffset = findFieldOffset cg, propName
            gepReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${gepReg} = getelementptr inbounds i64, ptr ${objPtr}, i64 ${fOffset}\n`)
            loadInt = newReg cg
            outBuf.code = outBuf.code.cat (`  ${loadInt} = load i64, ptr ${gepReg}\n`)
            loadDbl = newReg cg
            outBuf.code = outBuf.code.cat (`  ${loadDbl} = bitcast i64 ${loadInt} to double\n`)
            outBuf.code = outBuf.code.cat (`  store double ${loadDbl}, ptr ${slot}\n`)
            outBuf.code = outBuf.code.cat (`  br label %${mergeLbl}\n\n`)
            outBuf.code = outBuf.code.cat (`${mergeLbl}:\n`)
            resReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${resReg} = load double, ptr ${slot}\n`)
            -> resReg
        }
        // Enum variant: Status.Active → discriminant double
        if expr.object.kind == "VariableExpr" {
            if expr.object.name == "os" {
                if expr.property == "args" {
                    let valReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${valReg} = load i64, ptr @zuv_global_args\n`)
                    let dblReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${dblReg} = sitofp i64 ${valReg} to double\n`)
                    -> dblReg
                }
                if expr.property == "cwd" {
                    let resReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${resReg} = call ptr @zuv_os_cwd()\n`)
                    let intReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${intReg} = ptrtoint ptr ${resReg} to i64\n`)
                    let dblReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${dblReg} = sitofp i64 ${intReg} to double\n`)
                    -> dblReg
                }
                if expr.property == "typ" || expr.property == "type" {
                    let intReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${intReg} = ptrtoint ptr @str_os_typ to i64\n`)
                    let dblReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${dblReg} = sitofp i64 ${intReg} to double\n`)
                    -> dblReg
                }
                if expr.property == "rel" {
                    let intReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${intReg} = ptrtoint ptr @str_os_rel to i64\n`)
                    let dblReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${dblReg} = sitofp i64 ${intReg} to double\n`)
                    -> dblReg
                }
                if expr.property == "arch" {
                    let intReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${intReg} = ptrtoint ptr @str_os_arch to i64\n`)
                    let dblReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${dblReg} = sitofp i64 ${intReg} to double\n`)
                    -> dblReg
                }
                if expr.property == "endian" {
                    let intReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${intReg} = ptrtoint ptr @str_os_endian to i64\n`)
                    let dblReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${dblReg} = sitofp i64 ${intReg} to double\n`)
                    -> dblReg
                }
                if expr.property == "eol" {
                    let intReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${intReg} = ptrtoint ptr @str_os_eol to i64\n`)
                    let dblReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${dblReg} = sitofp i64 ${intReg} to double\n`)
                    -> dblReg
                }
                if expr.property == "devNull" {
                    let intReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${intReg} = ptrtoint ptr @str_os_devnull to i64\n`)
                    let dblReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${dblReg} = sitofp i64 ${intReg} to double\n`)
                    -> dblReg
                }
                if expr.property == "home" {
                    let resReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${resReg} = call ptr @zuv_os_env(ptr @str_env_userprofile)\n`)
                    let intReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${intReg} = ptrtoint ptr ${resReg} to i64\n`)
                    let dblReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${dblReg} = sitofp i64 ${intReg} to double\n`)
                    -> dblReg
                }
                if expr.property == "tmpDir" {
                    let resReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${resReg} = call ptr @zuv_temp_file(ptr @zuv_tmp_pfx)\n`)
                    let intReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${intReg} = ptrtoint ptr ${resReg} to i64\n`)
                    let dblReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${dblReg} = sitofp i64 ${intReg} to double\n`)
                    -> dblReg
                }
                if expr.property == "totMem" {
                    let resReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${resReg} = call double @zuv_os_tot_mem()\n`)
                    -> resReg
                }
                if expr.property == "freMem" {
                    let resReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${resReg} = call double @zuv_os_fre_mem()\n`)
                    -> resReg
                }
                if expr.property == "cpus" || expr.property == "par" {
                    let resReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${resReg} = call double @zuv_os_cpu_count()\n`)
                    -> resReg
                }
                if expr.property == "host" {
                    let resReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${resReg} = call ptr @zuv_os_env(ptr @str_env_computername)\n`)
                    let intReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${intReg} = ptrtoint ptr ${resReg} to i64\n`)
                    let dblReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${dblReg} = sitofp i64 ${intReg} to double\n`)
                    -> dblReg
                }
                if expr.property == "uInfo" {
                    let resReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${resReg} = call ptr @zuv_os_env(ptr @str_env_username)\n`)
                    let intReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${intReg} = ptrtoint ptr ${resReg} to i64\n`)
                    let dblReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${dblReg} = sitofp i64 ${intReg} to double\n`)
                    -> dblReg
                }
                if expr.property == "uptm" || expr.property == "uptime" {
                    let resReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${resReg} = call double @zuv_os_uptime()\n`)
                    -> resReg
                }
                if expr.property == "getPri" {
                    let resReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${resReg} = call double @zuv_os_get_priority()\n`)
                    -> resReg
                }
                if expr.property == "ver" {
                    let intReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${intReg} = ptrtoint ptr @str_os_rel to i64\n`)
                    let dblReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${dblReg} = sitofp i64 ${intReg} to double\n`)
                    -> dblReg
                }
                if expr.property == "mach" {
                    let intReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${intReg} = ptrtoint ptr @str_os_arch to i64\n`)
                    let dblReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${dblReg} = sitofp i64 ${intReg} to double\n`)
                    -> dblReg
                }
                if expr.property == "load" || expr.property == "loadavg" {
                    -> "0.0"
                }
                if expr.property == "netIf" {
                    let intReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${intReg} = ptrtoint ptr @empty_str to i64\n`)
                    let dblReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${dblReg} = sitofp i64 ${intReg} to double\n`)
                    -> dblReg
                }
                if expr.property == "pid" {
                    let resReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${resReg} = call double @zuv_os_pid()\n`)
                    -> resReg
                }
                if expr.property == "ppid" {
                    let resReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${resReg} = call double @zuv_os_ppid()\n`)
                    -> resReg
                }
            }
            if expr.object.name == "thrd" {
                if expr.property == "pid" {
                    let resReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${resReg} = call double @zuv_os_pid()\n`)
                    -> resReg
                }
                if expr.property == "ppid" {
                    let resReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${resReg} = call double @zuv_os_ppid()\n`)
                    -> resReg
                }
            }
            if expr.object.name == "time" {
                if expr.property == "now" || expr.property == "nw" {
                    let resReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${resReg} = call double @zuv_time_now()\n`)
                    -> resReg
                }
                if expr.property == "unix" || expr.property == "unx" {
                    let resReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${resReg} = call double @zuv_time_unix()\n`)
                    -> resReg
                }
                if expr.property == "mono" {
                    let resReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${resReg} = call double @zuv_time_mono()\n`)
                    -> resReg
                }
            }
            if expr.object.name == "mth" || expr.object.name == "Math" {
                if expr.property == "PI" { -> "3.141592653589793" }
                if expr.property == "E" { -> "2.718281828459045" }
                if expr.property == "LN2" { -> "0.6931471805599453" }
                if expr.property == "LN10" { -> "2.302585092994046" }
                if expr.property == "LOG2E" { -> "1.4426950408889634" }
                if expr.property == "LOG10E" { -> "0.4342944819032518" }
                if expr.property == "SQRT2" { -> "1.4142135623730951" }
                if expr.property == "SQRT1_2" { -> "0.7071067811865476" }
                if expr.property == "rand" {
                    rI = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${rI} = call i32 @rand()\n`)
                    rD = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${rD} = sitofp i32 ${rI} to double\n`)
                    resReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${resReg} = fdiv double ${rD}, 32767.0\n`)
                    -> resReg
                }
            }
            // Build "Enum.Variant" without template interpolation
            dot = "."
            q1 = expr.object.name.cat dot
            qKey = q1.cat expr.property
            disc = lookupEnumDisc cg, qKey
            if disc >= 0 {
                -> enumDiscLit disc
            }
            // Fallback Status checks
            if (strEq expr.object.name, "Status") == 1 {
                if (strEq expr.property, "Pending") == 1 { -> "0.0" }
                if (strEq expr.property, "Active") == 1 { -> "1.0" }
                if (strEq expr.property, "Archived") == 1 { -> "2.0" }
            }
            if (isEnumName cg, expr.object.name) == 1 {
                -> "0.0"
            }
            if (strEq expr.object.name, "glb") == 1 {
                gName = ensureGlbProp cg, expr.property
                loadInt = newReg cg
                outBuf.code = outBuf.code.cat (`  ${loadInt} = load i64, ptr ${gName}\n`)
                valReg = newReg cg
                outBuf.code = outBuf.code.cat (`  ${valReg} = bitcast i64 ${loadInt} to double\n`)
                -> valReg
            }
        }
        objReg = codegenExpr cg, expr.object, outBuf
        objInt = newReg cg
        outBuf.code = outBuf.code.cat (`  ${objInt} = fptosi double ${objReg} to i64\n`)
        objPtr = newReg cg
        outBuf.code = outBuf.code.cat (`  ${objPtr} = inttoptr i64 ${objInt} to ptr\n`)

        if (strEq expr.property, "ln") == 1 || (strEq expr.property, "len") == 1 || (strEq expr.property, "length") == 1 {
            let isStrObj = 0
            if (classifyTyp cg, expr.object) == "str" {
                isStrObj = 1
            } els if expr.object.kind == "StringExpr" {
                isStrObj = 1
            } els if expr.object.kind == "VariableExpr" {
                oName = expr.object.name
                if oName == "text" || oName == "str" || oName == "s" || oName == "msg" || oName == "content" || oName == "path" || oName == "file" || oName == "ip" || oName == "host" || oName == "res" || oName == "url" || oName == "body" || oName == "val" || oName == "name" || oName == "line" {
                    isStrObj = 1
                }
            }
            if isStrObj == 1 {
                strByteCount = newReg cg
                outBuf.code = outBuf.code.cat (`  ${strByteCount} = call i64 @strlen(ptr ${objPtr})\n`)
                dblReg = newReg cg
                outBuf.code = outBuf.code.cat (`  ${dblReg} = sitofp i64 ${strByteCount} to double\n`)
                -> dblReg
            } els {
                arrLenReg = newReg cg
                outBuf.code = outBuf.code.cat (`  ${arrLenReg} = load double, ptr ${objPtr}\n`)
                -> arrLenReg
            }
        } els {
            uMangleP = `@User_${expr.property}(`
            sMangleP = `@Schema_${expr.property}(`
            bMangleP = `@${expr.property}(`
            if (cg.funcs.cnt uMangleP) > 0 {
                mMethod = `User_${expr.property}`
                callReg = newReg cg
                outBuf.code = outBuf.code.cat (`  ${callReg} = call double @${mMethod}(double ${objReg})\n`)
                -> callReg
            } els if (cg.funcs.cnt sMangleP) > 0 {
                mMethod = `Schema_${expr.property}`
                callReg = newReg cg
                outBuf.code = outBuf.code.cat (`  ${callReg} = call double @${mMethod}(double ${objReg})\n`)
                -> callReg
            } els if (cg.funcs.cnt bMangleP) > 0 {
                mMethod = expr.property
                callReg = newReg cg
                outBuf.code = outBuf.code.cat (`  ${callReg} = call double @${mMethod}()\n`)
                -> callReg
            } els {
                fOffset = findFieldOffset cg, expr.property
                gepReg = newReg cg
                outBuf.code = outBuf.code.cat (`  ${gepReg} = getelementptr inbounds i64, ptr ${objPtr}, i64 ${fOffset}\n`)
                loadInt = newReg cg
                outBuf.code = outBuf.code.cat (`  ${loadInt} = load i64, ptr ${gepReg}\n`)
                loadDbl = newReg cg
                outBuf.code = outBuf.code.cat (`  ${loadDbl} = bitcast i64 ${loadInt} to double\n`)
                -> loadDbl
            }
        }
    } els if expr.kind == "IndexExpr" {
        if expr.optional == 1 {
            arrE = expr.array
            idxE = expr.index
            slot = newReg cg
            outBuf.code = outBuf.code.cat (`  ${slot} = alloca double\n`)
            arrReg = codegenExpr cg, arrE, outBuf
            // Match normal index: arrays are sitofp-encoded → fptosi for nullish + access
            arrInt = newReg cg
            outBuf.code = outBuf.code.cat (`  ${arrInt} = fptosi double ${arrReg} to i64\n`)
            isNil = newReg cg
            outBuf.code = outBuf.code.cat (`  ${isNil} = icmp eq i64 ${arrInt}, 0\n`)
            isUnd = newReg cg
            outBuf.code = outBuf.code.cat (`  ${isUnd} = icmp eq i64 ${arrInt}, 1\n`)
            isNullish = newReg cg
            outBuf.code = outBuf.code.cat (`  ${isNullish} = or i1 ${isNil}, ${isUnd}\n`)
            nilLbl = newLbl cg, "optidx_nil"
            accLbl = newLbl cg, "optidx_acc"
            mergeLbl = newLbl cg, "optidx_merge"
            outBuf.code = outBuf.code.cat (`  br i1 ${isNullish}, label %${nilLbl}, label %${accLbl}\n\n`)
            outBuf.code = outBuf.code.cat (`${nilLbl}:\n`)
            outBuf.code = outBuf.code.cat (`  store double 0.0, ptr ${slot}\n`)
            outBuf.code = outBuf.code.cat (`  br label %${mergeLbl}\n\n`)
            outBuf.code = outBuf.code.cat (`${accLbl}:\n`)
            idxReg = codegenExpr cg, idxE, outBuf
            arrPtr = newReg cg
            outBuf.code = outBuf.code.cat (`  ${arrPtr} = inttoptr i64 ${arrInt} to ptr\n`)
            idxInt = newReg cg
            outBuf.code = outBuf.code.cat (`  ${idxInt} = fptosi double ${idxReg} to i64\n`)
            elemIdx = newReg cg
            outBuf.code = outBuf.code.cat (`  ${elemIdx} = add i64 ${idxInt}, 1\n`)
            gepReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${gepReg} = getelementptr inbounds i64, ptr ${arrPtr}, i64 ${elemIdx}\n`)
            loadInt = newReg cg
            outBuf.code = outBuf.code.cat (`  ${loadInt} = load i64, ptr ${gepReg}\n`)
            loadDbl = newReg cg
            outBuf.code = outBuf.code.cat (`  ${loadDbl} = bitcast i64 ${loadInt} to double\n`)
            outBuf.code = outBuf.code.cat (`  store double ${loadDbl}, ptr ${slot}\n`)
            outBuf.code = outBuf.code.cat (`  br label %${mergeLbl}\n\n`)
            outBuf.code = outBuf.code.cat (`${mergeLbl}:\n`)
            resReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${resReg} = load double, ptr ${slot}\n`)
            -> resReg
        }
        arrReg = codegenExpr cg, expr.array, outBuf
        idxReg = codegenExpr cg, expr.index, outBuf
        arrInt = newReg cg
        outBuf.code = outBuf.code.cat (`  ${arrInt} = fptosi double ${arrReg} to i64\n`)
        arrPtr = newReg cg
        outBuf.code = outBuf.code.cat (`  ${arrPtr} = inttoptr i64 ${arrInt} to ptr\n`)
        idxInt = newReg cg
        outBuf.code = outBuf.code.cat (`  ${idxInt} = fptosi double ${idxReg} to i64\n`)
        elemIdx = newReg cg
        outBuf.code = outBuf.code.cat (`  ${elemIdx} = add i64 ${idxInt}, 1\n`)
        gepReg = newReg cg
        outBuf.code = outBuf.code.cat (`  ${gepReg} = getelementptr inbounds i64, ptr ${arrPtr}, i64 ${elemIdx}\n`)
        loadInt = newReg cg
        outBuf.code = outBuf.code.cat (`  ${loadInt} = load i64, ptr ${gepReg}\n`)
        loadDbl = newReg cg
        outBuf.code = outBuf.code.cat (`  ${loadDbl} = bitcast i64 ${loadInt} to double\n`)
        -> loadDbl
    } els if expr.kind == "EnumBareRef" {
        if (strEq expr.name, "Pending") == 1 { -> "0.0" }
        if (strEq expr.name, "Active") == 1 { -> "1.0" }
        if (strEq expr.name, "Archived") == 1 { -> "2.0" }
        disc = lookupEnumDisc cg, expr.name
        if disc >= 0 {
            -> enumDiscLit disc
        }
        -> "0.0"
    } els if expr.kind == "CastExpr" {
        valReg = codegenExpr cg, expr.value, outBuf
        // Use name with "str" so bootstrap treats comparisons as strcmp
        castTargetStr = expr.targetType
        if castTargetStr == "int" {
            asInt = newReg cg
            outBuf.code = outBuf.code.cat (`  ${asInt} = fptosi double ${valReg} to i64\n`)
            asDbl = newReg cg
            outBuf.code = outBuf.code.cat (`  ${asDbl} = sitofp i64 ${asInt} to double\n`)
            -> asDbl
        }
        if castTargetStr == "i32" {
            asInt = newReg cg
            outBuf.code = outBuf.code.cat (`  ${asInt} = fptosi double ${valReg} to i64\n`)
            asDbl = newReg cg
            outBuf.code = outBuf.code.cat (`  ${asDbl} = sitofp i64 ${asInt} to double\n`)
            -> asDbl
        }
        if castTargetStr == "i64" {
            asInt = newReg cg
            outBuf.code = outBuf.code.cat (`  ${asInt} = fptosi double ${valReg} to i64\n`)
            asDbl = newReg cg
            outBuf.code = outBuf.code.cat (`  ${asDbl} = sitofp i64 ${asInt} to double\n`)
            -> asDbl
        }
        if castTargetStr == "num" {
            -> valReg
        }
        if castTargetStr == "double" {
            -> valReg
        }
        if castTargetStr == "bool" {
            // Inline truthiness (avoid emitTruthyI1 return-reg issues in this path)
            bBits = newReg cg
            outBuf.code = outBuf.code.cat (`  ${bBits} = bitcast double ${valReg} to i64\n`)
            bIsNil = newReg cg
            outBuf.code = outBuf.code.cat (`  ${bIsNil} = icmp eq i64 ${bBits}, 0\n`)
            bIsUnd = newReg cg
            outBuf.code = outBuf.code.cat (`  ${bIsUnd} = icmp eq i64 ${bBits}, 1\n`)
            bFalsy = newReg cg
            outBuf.code = outBuf.code.cat (`  ${bFalsy} = or i1 ${bIsNil}, ${bIsUnd}\n`)
            boolI1 = newReg cg
            outBuf.code = outBuf.code.cat (`  ${boolI1} = xor i1 ${bFalsy}, true\n`)
            asDbl = newReg cg
            outBuf.code = outBuf.code.cat (`  ${asDbl} = uitofp i1 ${boolI1} to double\n`)
            -> asDbl
        }
        if castTargetStr == "*byte" || castTargetStr == "*num" || castTargetStr == "*any" || castTargetStr == "ptr" {
            -> valReg
        }
        if castTargetStr == "str" {
            buf = newReg cg
            outBuf.code = outBuf.code.cat (`  ${buf} = call ptr @malloc(i64 64)\n`)
            snp = newReg cg
            outBuf.code = outBuf.code.cat (`  ${snp} = call i32 (ptr, i64, ptr, ...) @snprintf(ptr ${buf}, i64 64, ptr @fmt_g, double ${valReg})\n`)
            asInt = newReg cg
            outBuf.code = outBuf.code.cat (`  ${asInt} = ptrtoint ptr ${buf} to i64\n`)
            asDbl = newReg cg
            outBuf.code = outBuf.code.cat (`  ${asDbl} = sitofp i64 ${asInt} to double\n`)
            -> asDbl
        }
        -> valReg
    } els if expr.kind == "TernaryExpr" {
        slot = newReg cg
        outBuf.code = outBuf.code.cat (`  ${slot} = alloca double\n`)
        condReg = codegenExpr cg, expr.condition, outBuf
        cmpReg = emitTruthyI1 cg, condReg, outBuf
        thenLbl = newLbl cg, "tern_then"
        elseLbl = newLbl cg, "tern_else"
        mergeLbl = newLbl cg, "tern_merge"
        outBuf.code = outBuf.code.cat (`  br i1 ${cmpReg}, label %${thenLbl}, label %${elseLbl}\n\n`)
        outBuf.code = outBuf.code.cat (`${thenLbl}:\n`)
        thenReg = codegenExpr cg, expr.thenExpr, outBuf
        outBuf.code = outBuf.code.cat (`  store double ${thenReg}, ptr ${slot}\n`)
        outBuf.code = outBuf.code.cat (`  br label %${mergeLbl}\n\n`)
        outBuf.code = outBuf.code.cat (`${elseLbl}:\n`)
        elseReg = codegenExpr cg, expr.elseExpr, outBuf
        outBuf.code = outBuf.code.cat (`  store double ${elseReg}, ptr ${slot}\n`)
        outBuf.code = outBuf.code.cat (`  br label %${mergeLbl}\n\n`)
        outBuf.code = outBuf.code.cat (`${mergeLbl}:\n`)
        resReg = newReg cg
        outBuf.code = outBuf.code.cat (`  ${resReg} = load double, ptr ${slot}\n`)
        -> resReg
    } els if expr.kind == "UnaryExpr" {
        if expr.op == "typ" {
            typeName = classifyTyp cg, expr.right
            sName = addStrConstant cg, typeName
            intReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${intReg} = ptrtoint ptr ${sName} to i64\n`)
            dblReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${dblReg} = sitofp i64 ${intReg} to double\n`)
            -> dblReg
        }
        if expr.op == "sizeof" || expr.op == "sz" {
            mut tn = ""
            if expr.right.kind == "VariableExpr" {
                tn = expr.right.name
            }
            if tn == "byte" || tn == "i8" || tn == "u8" { -> "1.0" }
            if tn == "i16" || tn == "u16" { -> "2.0" }
            if tn == "i32" || tn == "u32" || tn == "f32" { -> "4.0" }
            if tn == "num" || tn == "f64" || tn == "i64" || tn == "u64" || tn == "str" || tn == "bool" || tn == "ptr" { -> "8.0" }
            if tn == "User" || tn == "Schema" || tn == "App" { -> "16.0" }
            -> "8.0"
        }
        if expr.op == "sym" {
            if expr.right.kind == "StringExpr" {
                id = internSymId cg, expr.right.val
                -> symDiscLit id
            }
            keyReg = codegenExpr cg, expr.right, outBuf
            -> keyReg
        }
        if expr.op == "++" || expr.op == "--" {
            if expr.right.kind != "VariableExpr" {
                -> "0.0"
            }
            cgSym = findCgSymbol cg, expr.right.name
            if cgSym.name == "" {
                -> "0.0"
            }
            oldReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${oldReg} = load double, ptr ${cgSym.reg}\n`)
            newVal = newReg cg
            if expr.op == "++" {
                outBuf.code = outBuf.code.cat (`  ${newVal} = fadd double ${oldReg}, 1.0\n`)
            } els {
                outBuf.code = outBuf.code.cat (`  ${newVal} = fsub double ${oldReg}, 1.0\n`)
            }
            outBuf.code = outBuf.code.cat (`  store double ${newVal}, ptr ${cgSym.reg}\n`)
            if expr.prefix == 0 {
                -> oldReg
            }
            -> newVal
        }
        if expr.op == "~" {
            rReg = codegenExpr cg, expr.right, outBuf
            asInt = newReg cg
            outBuf.code = outBuf.code.cat (`  ${asInt} = fptosi double ${rReg} to i64\n`)
            bit = newReg cg
            outBuf.code = outBuf.code.cat (`  ${bit} = xor i64 ${asInt}, -1\n`)
            resReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${resReg} = sitofp i64 ${bit} to double\n`)
            -> resReg
        }
        if expr.op == "&" {
            if expr.right.kind == "VariableExpr" {
                cgSym = findCgSymbol cg, expr.right.name
                if cgSym.name != "" {
                    intReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${intReg} = ptrtoint ptr ${cgSym.reg} to i64\n`)
                    dblReg = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${dblReg} = sitofp i64 ${intReg} to double\n`)
                    -> dblReg
                }
            }
            -> codegenExpr cg, expr.right, outBuf
        }
        rReg = codegenExpr cg, expr.right, outBuf
        if expr.op == "!" || expr.op == "not" {
            cmpReg = emitTruthyI1 cg, rReg, outBuf
            notReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${notReg} = xor i1 ${cmpReg}, true\n`)
            resReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${resReg} = uitofp i1 ${notReg} to double\n`)
            -> resReg
        } els if expr.op == "-" {
            resReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${resReg} = fneg double ${rReg}\n`)
            -> resReg
        }
        -> rReg
    } els if expr.kind == "DerefExpr" {
        ptrVal = codegenExpr cg, expr.operand, outBuf
        ptrInt = newReg cg
        outBuf.code = outBuf.code.cat (`  ${ptrInt} = fptosi double ${ptrVal} to i64\n`)
        rawPtr = newReg cg
        outBuf.code = outBuf.code.cat (`  ${rawPtr} = inttoptr i64 ${ptrInt} to ptr\n`)
        loadVal = newReg cg
        outBuf.code = outBuf.code.cat (`  ${loadVal} = load double, ptr ${rawPtr}\n`)
        -> loadVal
    }

    -> "0.0"
}

codegenPanic cg, stmt, outBuf {
    mut msgPtr = ""
    if stmt.value != und && stmt.value != nil {
        msgPtr = getStrPtrVal cg, stmt.value, outBuf
    } els {
        strName = `@strlit_${cg.strCount}`
        cg.strCount = cg.strCount + 1
        cg.strConstants.psh (`${strName} = private unnamed_addr constant [6 x i8] c"panic\\00"\n`)
        msgPtr = strName
    }
    mut fileStr = stmt.file
    if fileStr == "" || fileStr == und {
        fileStr = "main.zv"
    }
    fileStrName = addStrConstant cg, fileStr
    mut lineNum = stmt.line
    if lineNum == 0 || lineNum == und {
        lineNum = 1
    }
    outBuf.code = outBuf.code.cat (`  call void @zuv_panic(ptr ${msgPtr}, ptr ${fileStrName}, i32 ${lineNum})\n`)
    outBuf.code = outBuf.code.cat "  unreachable\n"
    afterPanic = newLbl cg, "after_panic"
    outBuf.code = outBuf.code.cat (`\n${afterPanic}:\n`)
}

codegenStmt cg, stmt, outBuf {
    if stmt.kind == "VarDecl" {
        valReg = codegenExpr cg, stmt.value, outBuf
        if stmt.value.kind == "BigIntExpr" {
            markBigIntVar cg, stmt.name
        }
        if stmt.value.kind == "CallExpr" {
            if stmt.value.callee == "BigInt" {
                markBigIntVar cg, stmt.name
            }
        }
        if (classifyTyp cg, stmt.value) == "str" {
            markStrVar cg, stmt.name
        }
        if (isStrPlusOperand cg, stmt.value) == 1 {
            markStrVar cg, stmt.name
        }
        if stmt.value.kind == "StringExpr" {
            markStrVar cg, stmt.name
        }
        cgSym = findCgSymbol cg, stmt.name
        if cgSym.name != "" {
            outBuf.code = outBuf.code.cat (`  store double ${valReg}, ptr ${cgSym.reg}\n`)
        } els {
            ptrReg = newReg cg
            outBuf.code = outBuf.code.cat (`  ${ptrReg} = alloca double\n`)
            outBuf.code = outBuf.code.cat (`  store double ${valReg}, ptr ${ptrReg}\n`)
            addCgSymbol cg, stmt.name, ptrReg
        }
    } els if stmt.kind == "DestructureStmt" {
        srcReg = codegenExpr cg, stmt.source, outBuf
        srcInt = newReg cg
        outBuf.code = outBuf.code.cat (`  ${srcInt} = fptosi double ${srcReg} to i64\n`)
        srcPtr = newReg cg
        outBuf.code = outBuf.code.cat (`  ${srcPtr} = inttoptr i64 ${srcInt} to ptr\n`)
        let di = 0
        wh di < stmt.bindNames.ln {
            dName = stmt.bindNames[di]
            gepReg = newReg cg
            if stmt.destructKind == "object" {
                fOffset = findFieldOffset cg, dName
                outBuf.code = outBuf.code.cat (`  ${gepReg} = getelementptr inbounds i64, ptr ${srcPtr}, i64 ${fOffset}\n`)
            } els {
                elemOffset = di + 1
                outBuf.code = outBuf.code.cat (`  ${gepReg} = getelementptr inbounds i64, ptr ${srcPtr}, i64 ${elemOffset}\n`)
            }
            loadInt = newReg cg
            outBuf.code = outBuf.code.cat (`  ${loadInt} = load i64, ptr ${gepReg}\n`)
            loadDbl = newReg cg
            outBuf.code = outBuf.code.cat (`  ${loadDbl} = bitcast i64 ${loadInt} to double\n`)
            cgSym = findCgSymbol cg, dName
            if cgSym.name != "" {
                outBuf.code = outBuf.code.cat (`  store double ${loadDbl}, ptr ${cgSym.reg}\n`)
            } els {
                ptrReg = newReg cg
                outBuf.code = outBuf.code.cat (`  ${ptrReg} = alloca double\n`)
                outBuf.code = outBuf.code.cat (`  store double ${loadDbl}, ptr ${ptrReg}\n`)
                addCgSymbol cg, dName, ptrReg
            }
            di = di + 1
        }
    } els if stmt.kind == "PrintStmt" {
        if stmt.level == "lg" || stmt.level == "wrn" || stmt.level == "inf" || stmt.level == "err" {
            let pfx = "[LOG] "
            if stmt.level == "wrn" { pfx = "[WRN] " }
            els if stmt.level == "inf" { pfx = "[INF] " }
            els if stmt.level == "err" { pfx = "[ERR] " }
            pfxName = addStrConstant cg, pfx
            outBuf.code = outBuf.code.cat (`  call i32 (ptr, ...) @printf(ptr @fmt_prefix, ptr ${pfxName})\n`)
        }
        if stmt.value.kind == "StringExpr" {
            sName = addStrConstant cg, stmt.value.val
            outBuf.code = outBuf.code.cat (`  call i32 (ptr, ...) @printf(ptr @fmt_str, ptr ${sName})\n`)
        } els if stmt.value.kind == "BinaryExpr" {
            mut printStrAdd = 0
            if stmt.value.op == "+" {
                if (isStrPlusOperand cg, stmt.value.left) == 1 {
                    printStrAdd = 1
                }
                if (isStrPlusOperand cg, stmt.value.right) == 1 {
                    printStrAdd = 1
                }
            }
            if printStrAdd == 1 {
                sPtr = getStrPtrVal cg, stmt.value, outBuf
                outBuf.code = outBuf.code.cat (`  call i32 (ptr, ...) @printf(ptr @fmt_str, ptr ${sPtr})\n`)
            } els {
                valReg = codegenExpr cg, stmt.value, outBuf
                outBuf.code = outBuf.code.cat (`  call i32 (ptr, ...) @printf(ptr @fmt_num, double ${valReg})\n`)
            }
        } els if stmt.value.kind == "VariableExpr" && ((isStrVar cg, stmt.value.name) == 1 || (classifyTyp cg, stmt.value) == "str") {
            sPtr = getStrPtrVal cg, stmt.value, outBuf
            sInt = newReg cg
            outBuf.code = outBuf.code.cat (`  ${sInt} = ptrtoint ptr ${sPtr} to i64\n`)
            isSmall = newReg cg
            outBuf.code = outBuf.code.cat (`  ${isSmall} = icmp ult i64 ${sInt}, 65536\n`)
            pStrLbl = newLbl cg, "p_str"
            pNumLbl = newLbl cg, "p_num"
            pEndLbl = newLbl cg, "p_end"
            outBuf.code = outBuf.code.cat (`  br i1 ${isSmall}, label %${pNumLbl}, label %${pStrLbl}\n\n`)
            outBuf.code = outBuf.code.cat (`${pStrLbl}:\n`)
            outBuf.code = outBuf.code.cat (`  call i32 (ptr, ...) @printf(ptr @fmt_str, ptr ${sPtr})\n`)
            outBuf.code = outBuf.code.cat (`  br label %${pEndLbl}\n\n`)
            outBuf.code = outBuf.code.cat (`${pNumLbl}:\n`)
            dNum = newReg cg
            outBuf.code = outBuf.code.cat (`  ${dNum} = sitofp i64 ${sInt} to double\n`)
            outBuf.code = outBuf.code.cat (`  call i32 (ptr, ...) @printf(ptr @fmt_num, double ${dNum})\n`)
            outBuf.code = outBuf.code.cat (`  br label %${pEndLbl}\n\n`)
            outBuf.code = outBuf.code.cat (`${pEndLbl}:\n`)
        } els if stmt.value.kind == "PropertyAccess" {
            prop = stmt.value.property
            mut isStrProp = 0
            if prop == "name" || prop == "appName" || prop == "msg" || prop == "str" || prop == "text" || prop == "content" || prop == "path" || prop == "file" || prop == "cmd" || prop == "method" || prop == "body" || prop == "version" || prop == "url" {
                isStrProp = 1
            }
            if stmt.value.object.kind == "VariableExpr" {
                if stmt.value.object.name == "glb" {
                    if prop == "appName" || prop == "name" || prop == "msg" || prop == "str" || prop == "text" || prop == "path" {
                        isStrProp = 1
                    }
                }
            }
            if isStrProp == 1 {
                sPtr = getStrPtrVal cg, stmt.value, outBuf
                outBuf.code = outBuf.code.cat (`  call i32 (ptr, ...) @printf(ptr @fmt_str, ptr ${sPtr})\n`)
            } els {
                valReg = codegenExpr cg, stmt.value, outBuf
                outBuf.code = outBuf.code.cat (`  call i32 (ptr, ...) @printf(ptr @fmt_num, double ${valReg})\n`)
            }
        } els {
            valReg = codegenExpr cg, stmt.value, outBuf
            outBuf.code = outBuf.code.cat (`  call i32 (ptr, ...) @printf(ptr @fmt_num, double ${valReg})\n`)
        }
    } els if stmt.kind == "ReturnStmt" {
        if cg.tryFrames.ln > 0 {
            tf = cg.tryFrames[cg.tryFrames.ln - 1]
            if tf.hasFinally == 1 {
                outBuf.code = outBuf.code.cat (`  store i32 1, ptr ${tf.exitKindAlloc}\n`)
                if cg.isMain == 1 {
                    outBuf.code = outBuf.code.cat (`  store i64 0, ptr ${tf.retValAlloc}\n`)
                } els {
                    valReg = codegenExpr cg, stmt.value, outBuf
                    retI = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${retI} = fptosi double ${valReg} to i64\n`)
                    outBuf.code = outBuf.code.cat (`  store i64 ${retI}, ptr ${tf.retValAlloc}\n`)
                }
                outBuf.code = outBuf.code.cat (`  br label %${tf.finallyLabel}\n`)
                dummyLbl = newLbl cg, "after_ret_fin"
                outBuf.code = outBuf.code.cat (`\n${dummyLbl}:\n`)
            } els if cg.isMain == 1 {
                outBuf.code = outBuf.code.cat ("  ret i32 0\n")
            } els {
                valReg = codegenExpr cg, stmt.value, outBuf
                prmSym = findCgSymbol cg, "__active_prm__"
                if prmSym.name != "" {
                    prmReg = prmSym.reg
                    retValInt = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${retValInt} = fptosi double ${valReg} to i64\n`)
                    outBuf.code = outBuf.code.cat (`  call void @zuv_prm_resolve(ptr ${prmReg}, i64 ${retValInt})\n`)
                    modeSym = findCgSymbol cg, "__active_mode__"
                    if modeSym.name != "" {
                        modeReg = modeSym.reg
                        outBuf.code = outBuf.code.cat (`  call void @zuv_set_async_context(i32 ${modeReg})\n`)
                    }
                    prmInt = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${prmInt} = ptrtoint ptr ${prmReg} to i64\n`)
                    prmDbl = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${prmDbl} = sitofp i64 ${prmInt} to double\n`)
                    outBuf.code = outBuf.code.cat (`  ret double ${prmDbl}\n`)
                } els {
                    outBuf.code = outBuf.code.cat (`  ret double ${valReg}\n`)
                }
            }
        } els if cg.isMain == 1 {
            outBuf.code = outBuf.code.cat ("  ret i32 0\n")
        } els {
            valReg = codegenExpr cg, stmt.value, outBuf
            prmSym2 = findCgSymbol cg, "__active_prm__"
            if prmSym2.name != "" {
                prmReg2 = prmSym2.reg
                retValInt = newReg cg
                outBuf.code = outBuf.code.cat (`  ${retValInt} = fptosi double ${valReg} to i64\n`)
                outBuf.code = outBuf.code.cat (`  call void @zuv_prm_resolve(ptr ${prmReg2}, i64 ${retValInt})\n`)
                modeSym2 = findCgSymbol cg, "__active_mode__"
                if modeSym2.name != "" {
                    modeReg2 = modeSym2.reg
                    outBuf.code = outBuf.code.cat (`  call void @zuv_set_async_context(i32 ${modeReg2})\n`)
                }
                prmInt = newReg cg
                outBuf.code = outBuf.code.cat (`  ${prmInt} = ptrtoint ptr ${prmReg2} to i64\n`)
                prmDbl = newReg cg
                outBuf.code = outBuf.code.cat (`  ${prmDbl} = sitofp i64 ${prmInt} to double\n`)
                outBuf.code = outBuf.code.cat (`  ret double ${prmDbl}\n`)
            } els {
                outBuf.code = outBuf.code.cat (`  ret double ${valReg}\n`)
            }
        }
    } els if stmt.kind == "IfStmt" {
        condReg = codegenExpr cg, stmt.condition, outBuf
        cmpReg = emitTruthyI1 cg, condReg, outBuf

        thenLbl = newLbl cg, "if_then"
        elseLbl = newLbl cg, "if_else"
        mergeLbl = newLbl cg, "if_merge"

        outBuf.code = outBuf.code.cat (`  br i1 ${cmpReg}, label %${thenLbl}, label %${elseLbl}\n\n`)
        outBuf.code = outBuf.code.cat (`${thenLbl}:\n`)
        codegenStmt cg, stmt.thenBranch, outBuf
        outBuf.code = outBuf.code.cat (`  br label %${mergeLbl}\n\n`)

        outBuf.code = outBuf.code.cat (`${elseLbl}:\n`)
        if stmt.elseBranch.kind != "NilExpr" && stmt.elseBranch.kind != "" {
            codegenStmt cg, stmt.elseBranch, outBuf
        }
        outBuf.code = outBuf.code.cat (`  br label %${mergeLbl}\n\n`)

        outBuf.code = outBuf.code.cat (`${mergeLbl}:\n`)
    } els if stmt.kind == "WhileStmt" {
        condLbl = newLbl cg, "wh_cond"
        bodyLbl = newLbl cg, "wh_body"
        endLbl = newLbl cg, "wh_end"

        cg.breakLabels.psh endLbl
        cg.continueLabels.psh condLbl

        outBuf.code = outBuf.code.cat (`  br label %${condLbl}\n\n`)
        outBuf.code = outBuf.code.cat (`${condLbl}:\n`)
        condReg = codegenExpr cg, stmt.condition, outBuf
        cmpReg = emitTruthyI1 cg, condReg, outBuf
        outBuf.code = outBuf.code.cat (`  br i1 ${cmpReg}, label %${bodyLbl}, label %${endLbl}\n\n`)

        outBuf.code = outBuf.code.cat (`${bodyLbl}:\n`)
        codegenStmt cg, stmt.body, outBuf
        outBuf.code = outBuf.code.cat (`  br label %${condLbl}\n\n`)

        outBuf.code = outBuf.code.cat (`${endLbl}:\n`)

        cg.breakLabels.pp
        cg.continueLabels.pp
    } els if stmt.kind == "ForStmt" {
        condLbl = newLbl cg, "for_cond"
        bodyLbl = newLbl cg, "for_body"
        stepLbl = newLbl cg, "for_step"
        endLbl = newLbl cg, "for_end"

        if stmt.init.kind != "" && stmt.init.kind != "NilExpr" {
            codegenStmt cg, stmt.init, outBuf
        }

        cg.breakLabels.psh endLbl
        cg.continueLabels.psh stepLbl

        outBuf.code = outBuf.code.cat (`  br label %${condLbl}\n\n`)
        outBuf.code = outBuf.code.cat (`${condLbl}:\n`)
        if stmt.condition.kind != "" && stmt.condition.kind != "NilExpr" {
            condReg = codegenExpr cg, stmt.condition, outBuf
            cmpReg = emitTruthyI1 cg, condReg, outBuf
            outBuf.code = outBuf.code.cat (`  br i1 ${cmpReg}, label %${bodyLbl}, label %${endLbl}\n\n`)
        } els {
            outBuf.code = outBuf.code.cat (`  br label %${bodyLbl}\n\n`)
        }

        outBuf.code = outBuf.code.cat (`${bodyLbl}:\n`)
        codegenStmt cg, stmt.body, outBuf
        outBuf.code = outBuf.code.cat (`  br label %${stepLbl}\n\n`)

        outBuf.code = outBuf.code.cat (`${stepLbl}:\n`)
        if stmt.increment.kind != "" && stmt.increment.kind != "NilExpr" {
            codegenStmt cg, stmt.increment, outBuf
        }
        outBuf.code = outBuf.code.cat (`  br label %${condLbl}\n\n`)

        outBuf.code = outBuf.code.cat (`${endLbl}:\n`)

        cg.breakLabels.pp
        cg.continueLabels.pp
    } els if stmt.kind == "BreakStmt" {
        if cg.tryFrames.ln > 0 {
            tf = cg.tryFrames[cg.tryFrames.ln - 1]
            if tf.hasFinally == 1 {
                outBuf.code = outBuf.code.cat (`  store i32 2, ptr ${tf.exitKindAlloc}\n`)
                outBuf.code = outBuf.code.cat (`  br label %${tf.finallyLabel}\n`)
                dummyLbl = newLbl cg, "after_brk_fin"
                outBuf.code = outBuf.code.cat (`\n${dummyLbl}:\n`)
            } els if cg.breakLabels.ln > 0 {
                endLabel = cg.breakLabels[cg.breakLabels.ln - 1]
                outBuf.code = outBuf.code.cat (`  br label %${endLabel}\n`)
                dummyLbl = newLbl cg, "brk_after"
                outBuf.code = outBuf.code.cat (`\n${dummyLbl}:\n`)
            }
        } els if cg.breakLabels.ln > 0 {
            endLabel = cg.breakLabels[cg.breakLabels.ln - 1]
            outBuf.code = outBuf.code.cat (`  br label %${endLabel}\n`)
            dummyLbl = newLbl cg, "brk_after"
            outBuf.code = outBuf.code.cat (`\n${dummyLbl}:\n`)
        }
    } els if stmt.kind == "ContinueStmt" {
        if cg.tryFrames.ln > 0 {
            tf = cg.tryFrames[cg.tryFrames.ln - 1]
            if tf.hasFinally == 1 {
                outBuf.code = outBuf.code.cat (`  store i32 3, ptr ${tf.exitKindAlloc}\n`)
                outBuf.code = outBuf.code.cat (`  br label %${tf.finallyLabel}\n`)
                dummyLbl = newLbl cg, "after_cont_fin"
                outBuf.code = outBuf.code.cat (`\n${dummyLbl}:\n`)
            } els if cg.continueLabels.ln > 0 {
                contLabel = cg.continueLabels[cg.continueLabels.ln - 1]
                outBuf.code = outBuf.code.cat (`  br label %${contLabel}\n`)
                dummyLbl = newLbl cg, "cont_after"
                outBuf.code = outBuf.code.cat (`\n${dummyLbl}:\n`)
            }
        } els if cg.continueLabels.ln > 0 {
            contLabel = cg.continueLabels[cg.continueLabels.ln - 1]
            outBuf.code = outBuf.code.cat (`  br label %${contLabel}\n`)
            dummyLbl = newLbl cg, "cont_after"
            outBuf.code = outBuf.code.cat (`\n${dummyLbl}:\n`)
        }
    } els if stmt.kind == "MatchStmt" {
        tReg = codegenExpr cg, stmt.target, outBuf
        tInt = newReg cg
        outBuf.code = outBuf.code.cat (`  ${tInt} = fptosi double ${tReg} to i64\n`)
        tPtr = newReg cg
        outBuf.code = outBuf.code.cat (`  ${tPtr} = inttoptr i64 ${tInt} to ptr\n`)
        tagInt = newReg cg
        outBuf.code = outBuf.code.cat (`  ${tagInt} = load i64, ptr ${tPtr}\n`)
        isOk = newReg cg
        outBuf.code = outBuf.code.cat (`  ${isOk} = icmp eq i64 ${tagInt}, 1\n`)

        okLbl = newLbl cg, "match_ok"
        errLbl = newLbl cg, "match_err"
        mergeLbl = newLbl cg, "match_merge"

        outBuf.code = outBuf.code.cat (`  br i1 ${isOk}, label %${okLbl}, label %${errLbl}\n\n`)

        outBuf.code = outBuf.code.cat (`${okLbl}:\n`)
        if stmt.okBody.kind != "" {
            valGep = newReg cg
            outBuf.code = outBuf.code.cat (`  ${valGep} = getelementptr inbounds i64, ptr ${tPtr}, i64 1\n`)
            valInt = newReg cg
            outBuf.code = outBuf.code.cat (`  ${valInt} = load i64, ptr ${valGep}\n`)
            valDbl = newReg cg
            outBuf.code = outBuf.code.cat (`  ${valDbl} = bitcast i64 ${valInt} to double\n`)
            if stmt.okVar != "" {
                okPtr = newReg cg
                outBuf.code = outBuf.code.cat (`  ${okPtr} = alloca double\n`)
                outBuf.code = outBuf.code.cat (`  store double ${valDbl}, ptr ${okPtr}\n`)
                addCgSymbol cg, stmt.okVar, okPtr
            }
            codegenStmt cg, stmt.okBody, outBuf
        }
        outBuf.code = outBuf.code.cat (`  br label %${mergeLbl}\n\n`)

        outBuf.code = outBuf.code.cat (`${errLbl}:\n`)
        if stmt.errBody.kind != "" {
            valGep = newReg cg
            outBuf.code = outBuf.code.cat (`  ${valGep} = getelementptr inbounds i64, ptr ${tPtr}, i64 1\n`)
            valInt = newReg cg
            outBuf.code = outBuf.code.cat (`  ${valInt} = load i64, ptr ${valGep}\n`)
            valDbl = newReg cg
            outBuf.code = outBuf.code.cat (`  ${valDbl} = bitcast i64 ${valInt} to double\n`)
            if stmt.errVar != "" {
                errPtr = newReg cg
                outBuf.code = outBuf.code.cat (`  ${errPtr} = alloca double\n`)
                outBuf.code = outBuf.code.cat (`  store double ${valDbl}, ptr ${errPtr}\n`)
                addCgSymbol cg, stmt.errVar, errPtr
            }
            codegenStmt cg, stmt.errBody, outBuf
        }
        outBuf.code = outBuf.code.cat (`  br label %${mergeLbl}\n\n`)

        outBuf.code = outBuf.code.cat (`${mergeLbl}:\n`)
    } els if stmt.kind == "TryStmt" {
        mut hasCatch = 0
        mut hasFinally = 0
        if stmt.catchBody.kind != "" {
            hasCatch = 1
        }
        if stmt.finallyBody.kind != "" {
            hasFinally = 1
        }
        if hasCatch == 0 && hasFinally == 0 {
            codegenStmt cg, stmt.tryBody, outBuf
        } els {
            catchLbl = newLbl cg, "lpad_catch"
            finLbl = newLbl cg, "lpad_fin"
            endLbl = newLbl cg, "try_end"
            exitAlloc = newReg cg
            outBuf.code = outBuf.code.cat (`  ${exitAlloc} = alloca i32\n`)
            outBuf.code = outBuf.code.cat (`  store i32 0, ptr ${exitAlloc}\n`)
            retAlloc = newReg cg
            outBuf.code = outBuf.code.cat (`  ${retAlloc} = alloca i64\n`)
            outBuf.code = outBuf.code.cat (`  store i64 0, ptr ${retAlloc}\n`)
            frame = {
                catchLabel: catchLbl,
                finallyLabel: finLbl,
                endLabel: endLbl,
                exitKindAlloc: exitAlloc,
                retValAlloc: retAlloc,
                hasCatch: hasCatch,
                hasFinally: hasFinally,
                catchName: stmt.catchName
            }
            cg.tryFrames.psh frame
            bodyLbl = newLbl cg, "try_body"
            outBuf.code = outBuf.code.cat (`  br label %${bodyLbl}\n\n`)
            outBuf.code = outBuf.code.cat (`${bodyLbl}:\n`)
            codegenStmt cg, stmt.tryBody, outBuf
            if hasFinally == 1 {
                outBuf.code = outBuf.code.cat (`  store i32 0, ptr ${exitAlloc}\n`)
                outBuf.code = outBuf.code.cat (`  br label %${finLbl}\n\n`)
            } els {
                outBuf.code = outBuf.code.cat (`  br label %${endLbl}\n\n`)
            }
            if hasCatch == 1 {
                outBuf.code = outBuf.code.cat (`${catchLbl}:\n`)
                if cg.tryFrames.ln > 0 {
                    cg.tryFrames.pp
                }
                loaded = newReg cg
                outBuf.code = outBuf.code.cat (`  ${loaded} = load i64, ptr @zuv_exc_value\n`)
                asDbl = newReg cg
                outBuf.code = outBuf.code.cat (`  ${asDbl} = sitofp i64 ${loaded} to double\n`)
                if stmt.catchName != "" {
                    catchPtr = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${catchPtr} = alloca double\n`)
                    outBuf.code = outBuf.code.cat (`  store double ${asDbl}, ptr ${catchPtr}\n`)
                    addCgSymbol cg, stmt.catchName, catchPtr
                    markStrVar cg, stmt.catchName
                }
                codegenStmt cg, stmt.catchBody, outBuf
                if hasFinally == 1 {
                    outBuf.code = outBuf.code.cat (`  store i32 0, ptr ${exitAlloc}\n`)
                    outBuf.code = outBuf.code.cat (`  br label %${finLbl}\n\n`)
                } els {
                    outBuf.code = outBuf.code.cat (`  br label %${endLbl}\n\n`)
                }
            }
            if hasFinally == 1 {
                outBuf.code = outBuf.code.cat (`${finLbl}:\n`)
                if cg.tryFrames.ln > 0 {
                    topF = cg.tryFrames[cg.tryFrames.ln - 1]
                    if topF.finallyLabel == finLbl {
                        cg.tryFrames.pp
                    }
                }
                codegenStmt cg, stmt.finallyBody, outBuf
                ek = newReg cg
                outBuf.code = outBuf.code.cat (`  ${ek} = load i32, ptr ${exitAlloc}\n`)
                isRet = newReg cg
                outBuf.code = outBuf.code.cat (`  ${isRet} = icmp eq i32 ${ek}, 1\n`)
                doRet = newLbl cg, "try_do_ret"
                notRet = newLbl cg, "try_not_ret"
                outBuf.code = outBuf.code.cat (`  br i1 ${isRet}, label %${doRet}, label %${notRet}\n\n`)
                outBuf.code = outBuf.code.cat (`${doRet}:\n`)
                if cg.isMain == 1 {
                    outBuf.code = outBuf.code.cat ("  ret i32 0\n")
                } els {
                    rv = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${rv} = load i64, ptr ${retAlloc}\n`)
                    rvd = newReg cg
                    outBuf.code = outBuf.code.cat (`  ${rvd} = sitofp i64 ${rv} to double\n`)
                    outBuf.code = outBuf.code.cat (`  ret double ${rvd}\n`)
                }
                afterRet = newLbl cg, "after_try_ret"
                outBuf.code = outBuf.code.cat (`\n${afterRet}:\n`)
                outBuf.code = outBuf.code.cat (`  br label %${endLbl}\n\n`)
                outBuf.code = outBuf.code.cat (`${notRet}:\n`)
                isBrk = newReg cg
                outBuf.code = outBuf.code.cat (`  ${isBrk} = icmp eq i32 ${ek}, 2\n`)
                doBrk = newLbl cg, "try_do_brk"
                notBrk = newLbl cg, "try_not_brk"
                outBuf.code = outBuf.code.cat (`  br i1 ${isBrk}, label %${doBrk}, label %${notBrk}\n\n`)
                outBuf.code = outBuf.code.cat (`${doBrk}:\n`)
                if cg.breakLabels.ln > 0 {
                    bl = cg.breakLabels[cg.breakLabels.ln - 1]
                    outBuf.code = outBuf.code.cat (`  br label %${bl}\n\n`)
                } els {
                    outBuf.code = outBuf.code.cat (`  br label %${endLbl}\n\n`)
                }
                outBuf.code = outBuf.code.cat (`${notBrk}:\n`)
                isCont = newReg cg
                outBuf.code = outBuf.code.cat (`  ${isCont} = icmp eq i32 ${ek}, 3\n`)
                doCont = newLbl cg, "try_do_cont"
                fall = newLbl cg, "try_fall"
                outBuf.code = outBuf.code.cat (`  br i1 ${isCont}, label %${doCont}, label %${fall}\n\n`)
                outBuf.code = outBuf.code.cat (`${doCont}:\n`)
                if cg.continueLabels.ln > 0 {
                    cl = cg.continueLabels[cg.continueLabels.ln - 1]
                    outBuf.code = outBuf.code.cat (`  br label %${cl}\n\n`)
                } els {
                    outBuf.code = outBuf.code.cat (`  br label %${endLbl}\n\n`)
                }
                outBuf.code = outBuf.code.cat (`${fall}:\n`)
                outBuf.code = outBuf.code.cat (`  br label %${endLbl}\n\n`)
                outBuf.code = outBuf.code.cat (`${endLbl}:\n`)
            } els {
                if cg.tryFrames.ln > 0 {
                    topF = cg.tryFrames[cg.tryFrames.ln - 1]
                    if topF.endLabel == endLbl {
                        cg.tryFrames.pp
                    }
                }
                outBuf.code = outBuf.code.cat (`${endLbl}:\n`)
            }
        }
    } els if stmt.kind == "ThrowStmt" {
        mut payload = ""
        if stmt.value.kind == "StringExpr" {
            sName = addStrConstant cg, stmt.value.val
            payload = newReg cg
            outBuf.code = outBuf.code.cat (`  ${payload} = ptrtoint ptr ${sName} to i64\n`)
        } els {
            valReg = codegenExpr cg, stmt.value, outBuf
            payload = newReg cg
            outBuf.code = outBuf.code.cat (`  ${payload} = fptosi double ${valReg} to i64\n`)
        }
        outBuf.code = outBuf.code.cat (`  store i64 ${payload}, ptr @zuv_exc_value\n`)
        if cg.tryFrames.ln > 0 {
            tf = cg.tryFrames[cg.tryFrames.ln - 1]
            mut target = tf.finallyLabel
            if tf.hasCatch == 1 {
                target = tf.catchLabel
            }
            outBuf.code = outBuf.code.cat (`  br label %${target}\n`)
            afterThr = newLbl cg, "after_thr"
            outBuf.code = outBuf.code.cat (`\n${afterThr}:\n`)
        } els {
            if stmt.value.kind == "StringExpr" {
                sName = addStrConstant cg, stmt.value.val
                outBuf.code = outBuf.code.cat (`  call i32 (ptr, ...) @printf(ptr @zuv_uncaught_msg, ptr ${sName})\n`)
            } els {
                valReg = codegenExpr cg, stmt.value, outBuf
                outBuf.code = outBuf.code.cat (`  call i32 (ptr, ...) @printf(ptr @zuv_uncaught_num, double ${valReg})\n`)
            }
            outBuf.code = outBuf.code.cat ("  call void @exit(i32 1)\n")
            outBuf.code = outBuf.code.cat ("  unreachable\n")
            afterThr = newLbl cg, "after_thr_exit"
            outBuf.code = outBuf.code.cat (`\n${afterThr}:\n`)
        }
    } els if stmt.kind == "PanicStmt" {
        codegenPanic cg, stmt, outBuf
    } els if stmt.kind == "FunctionDecl" {
        codegenFunctionDecl cg, stmt
    } els if stmt.kind == "ExternDecl" {
        addCgExtern cg, stmt
    } els if stmt.kind == "EnumDecl" {
        registerEnum cg, stmt
    } els if stmt.kind == "UnsafeBlock" {
        codegenStmt cg, stmt.body, outBuf
    } els if stmt.kind == "BlockStmt" {
        let i = 0
        wh i < stmt.statements.ln {
            s = stmt.statements[i]
            codegenStmt cg, s, outBuf
            i = i + 1
        }
    } els if stmt.kind == "StmtSequence" {
        let si = 0
        wh si < stmt.statements.ln {
            s = stmt.statements[si]
            codegenStmt cg, s, outBuf
            si = si + 1
        }
    } els if stmt.kind == "ExpressionStmt" {
        codegenExpr cg, stmt.expr, outBuf
    } els if stmt.kind == "StmtSequence" {
        let ssi = 0
        wh ssi < stmt.statements.ln {
            codegenStmt cg, stmt.statements[ssi], outBuf
            ssi = ssi + 1
        }
    }
}

codegenFunctionDecl cg, funcStmt {
    clearCgLocals cg
    let fnNameRaw = funcStmt.name
    let fnName = fnNameRaw
    if fnNameRaw == "main" {
        fnName = "main_user"
    }
    mut fPath = funcStmt.sourceFile
    if fPath == und || fPath == "" { fPath = "main.zv" }
    mut fLine = funcStmt.sourceLine
    if fLine == und || fLine == 0 { fLine = 1 }
    fnIdx = cg.funcCount
    cg.funcCount = cg.funcCount + 1
    nStr = addStrConstant cg, fnNameRaw
    fStr = addStrConstant cg, fPath
    if fnIdx > 0 {
        cg.funcDescsStr = cg.funcDescsStr.cat ",\n"
    }
    cg.funcDescsStr = cg.funcDescsStr.cat (`  %struct.ZuvFuncDesc { ptr @${fnName}, ptr ${nStr}, ptr ${fStr}, i32 ${fLine} }`)
    let paramsStr = ""
    let i = 0
    wh i < funcStmt.params.ln {
        if i > 0 { paramsStr = paramsStr.cat ", " }
        pName = funcStmt.params[i]
        paramsStr = paramsStr.cat (`double %arg_${pName}`)
        i = i + 1
    }

    mut exportAttr = ""
    if funcStmt.isExported == 1 || funcStmt.isExternC == 1 {
        exportAttr = "dllexport "
    }

    mut inlineAttr = ""
    if funcStmt.attributes.ln > 0 {
        let ai = 0
        wh ai < funcStmt.attributes.ln {
            attr = funcStmt.attributes[ai]
            if attr.name == "inline" {
                if attr.args.ln == 0 || attr.args[0] == "always" {
                    inlineAttr = "alwaysinline "
                } els if attr.args[0] == "never" {
                    inlineAttr = "noinline "
                }
            } els if attr.name == "noinline" {
                inlineAttr = "noinline "
            }
            ai = ai + 1
        }
    }

    let fnBuf = { code: (`define ${exportAttr}double @${fnName}(${paramsStr}) ${inlineAttr}{\nentry:\n`) }

    mut isAsync = funcStmt.isAsync
    mut isAsyncST = funcStmt.isAsyncST
    if funcStmt.attributes.ln > 0 {
        let ai = 0
        wh ai < funcStmt.attributes.ln {
            if funcStmt.attributes[ai].name == "st" {
                isAsyncST = 1
                isAsync = 1
            }
            ai = ai + 1
        }
    }

    mut prevModeReg = ""
    mut prmReg = ""
    if isAsync == 1 || isAsyncST == 1 {
        prevModeReg = newReg cg
        fnBuf.code = fnBuf.code.cat (`  ${prevModeReg} = call i32 @zuv_get_async_context()\n`)
        let prmMode = (isAsyncST == 1) ? 0 : 1
        fnBuf.code = fnBuf.code.cat (`  call void @zuv_set_async_context(i32 ${prmMode})\n`)
        prmReg = newReg cg
        fnBuf.code = fnBuf.code.cat (`  ${prmReg} = call ptr @zuv_prm_new(i32 ${prmMode})\n`)
        addCgSymbol cg, "__active_prm__", prmReg
        addCgSymbol cg, "__active_mode__", prevModeReg
    }

    let j = 0
    wh j < funcStmt.params.ln {
        pName = funcStmt.params[j]
        if pName != "" {
            ptrReg = newReg cg
            fnBuf.code = fnBuf.code.cat (`  ${ptrReg} = alloca double\n`)
            fnBuf.code = fnBuf.code.cat (`  store double %arg_${pName}, ptr ${ptrReg}\n`)
            addCgSymbol cg, pName, ptrReg
        }
        j = j + 1
    }

    codegenStmt cg, funcStmt.body, fnBuf
    if isAsync == 1 || isAsyncST == 1 {
        fnBuf.code = fnBuf.code.cat (`  call void @zuv_prm_resolve(ptr ${prmReg}, i64 0)\n`)
        if prevModeReg != "" {
            fnBuf.code = fnBuf.code.cat (`  call void @zuv_set_async_context(i32 ${prevModeReg})\n`)
        }
        prmInt = newReg cg
        fnBuf.code = fnBuf.code.cat (`  ${prmInt} = ptrtoint ptr ${prmReg} to i64\n`)
        prmDbl = newReg cg
        fnBuf.code = fnBuf.code.cat (`  ${prmDbl} = sitofp i64 ${prmInt} to double\n`)
        fnBuf.code = fnBuf.code.cat (`  ret double ${prmDbl}\n}\n\n`)
    } els {
        fnBuf.code = fnBuf.code.cat ("  ret double 0.0\n}\n\n")
    }
    cg.funcs = cg.funcs.cat fnBuf.code
}

GenerateLLVMFull program {
    cg = createCodegen
    // Pre-register functions so aliases can reference later declarations.
    let fni = 0
    wh fni < program.statements.ln {
        fnStmt = program.statements[fni]
        if fnStmt.kind == "FunctionDecl" {
            cg.funcNames.psh fnStmt.name
            if fnStmt.params.ln == 0 {
                cg.funcNames.psh (`0:${fnStmt.name}`)
            }
        } els if fnStmt.kind == "StmtSequence" {
            let fnsi = 0
            wh fnsi < fnStmt.statements.ln {
                subFn = fnStmt.statements[fnsi]
                if subFn.kind == "FunctionDecl" {
                    cg.funcNames.psh subFn.name
                    if subFn.params.ln == 0 {
                        cg.funcNames.psh (`0:${subFn.name}`)
                    }
                }
                fnsi = fnsi + 1
            }
        }
        fni = fni + 1
    }
    let ei = 0
    wh ei < program.statements.ln {
        estmt = program.statements[ei]
        if (strEq estmt.kind, "EnumDecl") == 1 {
            registerEnum cg, estmt
        }
        ei = ei + 1
    }

    let header = `; ModuleID = 'zuv_self_host'\n`
    header = header.cat `source_filename = "main.zv"\n\n`
    header = header.cat "declare i32 @printf(ptr nocapture readonly, ...)\n"
    header = header.cat "declare ptr @fopen(ptr, ptr)\n"
    header = header.cat "declare i32 @fclose(ptr)\n"
    header = header.cat "declare i64 @fread(ptr, i64, i64, ptr)\n"
    header = header.cat "declare i64 @fwrite(ptr, i64, i64, ptr)\n"
    header = header.cat "declare i32 @fputs(ptr, ptr)\n"
    header = header.cat "declare i64 @strlen(ptr)\n"
    header = header.cat "declare i64 @clock()\n"
    header = header.cat "declare void @Sleep(i32)\n"
