    termIR = termIR.cat "@.zuv_term_fmt_color_only = private unnamed_addr constant [6 x i8] c\"\\1B[%dm\\00\"\n\n"

    termIR = termIR.cat "@.zuv_term_code_bold = private unnamed_addr constant [5 x i8] c\"\\1B[1m\\00\"\n"
    termIR = termIR.cat "@.zuv_term_code_dim = private unnamed_addr constant [5 x i8] c\"\\1B[2m\\00\"\n"
    termIR = termIR.cat "@.zuv_term_code_italic = private unnamed_addr constant [5 x i8] c\"\\1B[3m\\00\"\n"
    termIR = termIR.cat "@.zuv_term_code_underline = private unnamed_addr constant [5 x i8] c\"\\1B[4m\\00\"\n"
    termIR = termIR.cat "@.zuv_term_code_red = private unnamed_addr constant [6 x i8] c\"\\1B[31m\\00\"\n"
