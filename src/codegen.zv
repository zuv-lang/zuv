    termIR = termIR.cat "@.zuv_term_fmt_cur = private unnamed_addr constant [9 x i8] c\"\\1B[%d;%dH\\00\"\n"
    termIR = termIR.cat "@.zuv_term_fmt_up = private unnamed_addr constant [6 x i8] c\"\\1B[%dA\\00\"\n"
    termIR = termIR.cat "@.zuv_term_fmt_down = private unnamed_addr constant [6 x i8] c\"\\1B[%dB\\00\"\n"
    termIR = termIR.cat "@.zuv_term_fmt_fwd = private unnamed_addr constant [6 x i8] c\"\\1B[%dC\\00\"\n"
    termIR = termIR.cat "@.zuv_term_fmt_back = private unnamed_addr constant [6 x i8] c\"\\1B[%dD\\00\"\n"
    termIR = termIR.cat "@.zuv_term_clear = private unnamed_addr constant [8 x i8] c\"\\1B[2J\\1B[H\\00\"\n"
    termIR = termIR.cat "@.zuv_term_clear_line = private unnamed_addr constant [6 x i8] c\"\\1B[2K\\0D\\00\"\n"
