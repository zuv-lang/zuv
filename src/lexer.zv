// Full Lexer Scanner Engine for Zuv Self-Hosting Compiler (src/lexer.zv)
imp str, arr
imp CreateToken frm tokens

CreateLexer code {
    l = code.ln
    let lexer = { src: code, pos: 0, totalLen: l, line: 1, col: 0, ch: "" }
    readLexerChar lexer
    -> lexer
}

readLexerChar lexer {
    if lexer.pos >= lexer.totalLen {
        lexer.ch = ""
    } els {
        lexer.ch = lexer.src.chr lexer.pos
        lexer.pos = lexer.pos + 1
        lexer.col = lexer.col + 1
    }
}

peekLexerChar lexer {
    if lexer.pos >= lexer.totalLen {
        -> ""
    }
    nextCh = lexer.src.chr lexer.pos
    -> nextCh
}

skipLexerWhitespace lexer {
    wh lexer.ch == " " || lexer.ch == "\t" || lexer.ch == "\n" || lexer.ch == "\r" {
        if lexer.ch == "\n" {
            lexer.line = lexer.line + 1
            lexer.col = 0
        }
        readLexerChar lexer
    }
}

isLexerDigit ch {
    if ch == "0" || ch == "1" || ch == "2" || ch == "3" || ch == "4" ||
       ch == "5" || ch == "6" || ch == "7" || ch == "8" || ch == "9" {
        -> 1
    }
    -> 0
}

isLexerHexDigit ch {
    if (isLexerDigit ch) == 1 {
        -> 1
    }
    if ch == "a" || ch == "b" || ch == "c" || ch == "d" || ch == "e" || ch == "f" ||
       ch == "A" || ch == "B" || ch == "C" || ch == "D" || ch == "E" || ch == "F" {
        -> 1
    }
    -> 0
}

isLexerBinDigit ch {
    if ch == "0" || ch == "1" {
        -> 1
    }
    -> 0
}

isLexerOctDigit ch {
    if ch == "0" || ch == "1" || ch == "2" || ch == "3" ||
       ch == "4" || ch == "5" || ch == "6" || ch == "7" {
        -> 1
    }
    -> 0
}

isLexerLetter ch {
    if ch == "a" || ch == "b" || ch == "c" || ch == "d" || ch == "e" ||
       ch == "f" || ch == "g" || ch == "h" || ch == "i" || ch == "j" ||
       ch == "k" || ch == "l" || ch == "m" || ch == "n" || ch == "o" ||
       ch == "p" || ch == "q" || ch == "r" || ch == "s" || ch == "t" ||
       ch == "u" || ch == "v" || ch == "w" || ch == "x" || ch == "y" ||
       ch == "z" || ch == "_" {
        -> 1
    }
    if ch == "A" || ch == "B" || ch == "C" || ch == "D" || ch == "E" ||
       ch == "F" || ch == "G" || ch == "H" || ch == "I" || ch == "J" ||
       ch == "K" || ch == "L" || ch == "M" || ch == "N" || ch == "O" ||
       ch == "P" || ch == "Q" || ch == "R" || ch == "S" || ch == "T" ||
       ch == "U" || ch == "V" || ch == "W" || ch == "X" || ch == "Y" ||
       ch == "Z" {
        -> 1
    }
    -> 0
}

isLexerKeyword word {
    if word == "imp" || word == "frm" || word == "wrk" || word == "prnt" ||
       word == "lg" || word == "wrn" || word == "inf" || word == "nan" || word == "Infinity" || word == "ret" {
        -> 1
    }
    if word == "els" || word == "wh" || word == "fr" || word == "of" || word == "in" || word == "brk" ||
       word == "cont" || word == "dn" || word == "mch" || word == "sw" || word == "ok" {
        -> 1
    }
    if word == "err" || word == "if" || word == "and" || word == "or" ||
       word == "not" || word == "mut" || word == "let" || word == "asc" || word == "awt" {
        -> 1
    }
    if word == "typ" || word == "sym" || word == "enum" || word == "as" ||
       word == "obj" || word == "num" || word == "bool" || word == "str" ||
       word == "sizeof" || word == "sz" {
        -> 1
    }
    if word == "extern" || word == "main" || word == "pub" ||
       word == "try" || word == "cth" || word == "fin" || word == "thr" || word == "new" || word == "unsafe" {
        -> 1
    }
    -> 0
}

isLexerBoolLit word {
    if word == "true" || word == "false" || word == "yes" || word == "no" {
        -> 1
    }
    -> 0
}

isLexerNilLit word {
    if word == "nil" || word == "und" {
        -> 1
    }
    -> 0
}

readLexerString lexer, quoteChar {
    startLine = lexer.line
    startCol = lexer.col
    readLexerChar lexer

    let strVal = ""
    wh lexer.ch != quoteChar && lexer.ch != "" {
        if lexer.ch == "\n" {
            lexer.line = lexer.line + 1
            lexer.col = 0
            strVal = strVal.cat "\n"
        } els if lexer.ch == "\\" {
            readLexerChar lexer
            if lexer.ch == "n" { strVal = strVal.cat "\n" }
            els if lexer.ch == "t" { strVal = strVal.cat "\t" }
            els if lexer.ch == "r" { strVal = strVal.cat "\r" }
            els if lexer.ch == `"` { strVal = strVal.cat `"` }
            els if lexer.ch == `'` { strVal = strVal.cat `'` }
            els if lexer.ch == "`" { strVal = strVal.cat "`" }
            els if lexer.ch == "$" { strVal = strVal.cat "$" }
            els if lexer.ch == "\\" { strVal = strVal.cat "\\" }
            els { strVal = strVal.cat lexer.ch }
        } els {
            strVal = strVal.cat lexer.ch
        }
        readLexerChar lexer
    }

    if lexer.ch == quoteChar {
        readLexerChar lexer
    }

    tok = CreateToken "STRING", strVal, startLine, startCol
    -> tok
}

readLexerNumber lexer {
    startLine = lexer.line
    startCol = lexer.col
    let numVal = ""

    // Base prefixes: 0xFF, 0b1010, 0o755 (require ≥1 digit after prefix)
    if lexer.ch == "0" {
        p = peekLexerChar lexer
        mut p2 = ""
        if lexer.pos + 1 < lexer.totalLen {
            p2Idx = lexer.pos + 1
            p2 = lexer.src.chr p2Idx
        }
        if (p == "x" || p == "X") && (isLexerHexDigit p2) == 1 {
            numVal = numVal.cat lexer.ch
            readLexerChar lexer
            numVal = numVal.cat lexer.ch
            readLexerChar lexer
            wh (isLexerHexDigit lexer.ch) == 1 {
                numVal = numVal.cat lexer.ch
                readLexerChar lexer
            }
            tok = CreateToken "NUMBER", numVal, startLine, startCol
            -> tok
        }
        if (p == "b" || p == "B") && (isLexerBinDigit p2) == 1 {
            numVal = numVal.cat lexer.ch
            readLexerChar lexer
            numVal = numVal.cat lexer.ch
            readLexerChar lexer
            wh (isLexerBinDigit lexer.ch) == 1 {
                numVal = numVal.cat lexer.ch
                readLexerChar lexer
            }
            tok = CreateToken "NUMBER", numVal, startLine, startCol
            -> tok
        }
        if (p == "o" || p == "O") && (isLexerOctDigit p2) == 1 {
            numVal = numVal.cat lexer.ch
            readLexerChar lexer
            numVal = numVal.cat lexer.ch
            readLexerChar lexer
            wh (isLexerOctDigit lexer.ch) == 1 {
                numVal = numVal.cat lexer.ch
                readLexerChar lexer
            }
            tok = CreateToken "NUMBER", numVal, startLine, startCol
            -> tok
        }
    }

    mut hasDot = 0

    wh (isLexerDigit lexer.ch) || (lexer.ch == "." && (isLexerDigit (peekLexerChar lexer))) {
        if lexer.ch == "." {
            hasDot = 1
        }
        numVal = numVal.cat lexer.ch
        readLexerChar lexer
    }

    // Scientific exponent: 123e5, 1.5E-2, 10e+3
    if lexer.ch == "e" || lexer.ch == "E" {
        nxt = peekLexerChar lexer
        mut expOk = 0
        if (isLexerDigit nxt) == 1 {
            expOk = 1
        }
        if nxt == "+" || nxt == "-" {
            // Digit must follow the sign (lookahead two chars)
            if lexer.pos + 1 < lexer.totalLen {
                signIdx = lexer.pos + 1
                afterSign = lexer.src.chr signIdx
                if (isLexerDigit afterSign) == 1 {
                    expOk = 1
                }
            }
        }
        if expOk == 1 {
            numVal = numVal.cat lexer.ch
            readLexerChar lexer
            if lexer.ch == "+" || lexer.ch == "-" {
                numVal = numVal.cat lexer.ch
                readLexerChar lexer
            }
            wh (isLexerDigit lexer.ch) == 1 {
                numVal = numVal.cat lexer.ch
                readLexerChar lexer
            }
            tok = CreateToken "NUMBER", numVal, startLine, startCol
            -> tok
        }
    }

    // BigInt suffix: 123n / 123N (integers only — no decimal point, no exponent)
    if hasDot == 0 {
        if lexer.ch == "n" || lexer.ch == "N" {
            readLexerChar lexer
            tok = CreateToken "BIGINT", numVal, startLine, startCol
            -> tok
        }
    }

    tok = CreateToken "NUMBER", numVal, startLine, startCol
    -> tok
}

readLexerIdentifier lexer {
    startLine = lexer.line
    startCol = lexer.col
    let word = ""

    wh (isLexerLetter lexer.ch) || (isLexerDigit lexer.ch) {
        word = word.cat lexer.ch
        readLexerChar lexer
    }

    if isLexerBoolLit word {
        tok = CreateToken "BOOL", word, startLine, startCol
        -> tok
    } els if isLexerNilLit word {
        tok = CreateToken "NIL", word, startLine, startCol
        -> tok
    } els if isLexerKeyword word {
        tok = CreateToken "KEYWORD", word, startLine, startCol
        -> tok
    } els {
        tok = CreateToken "IDENT", word, startLine, startCol
        -> tok
    }
}

nextLexerToken lexer {
    skipLexerWhitespace lexer

    startLine = lexer.line
    startCol = lexer.col

    if lexer.ch == "" {
        tok = CreateToken "EOF", "", startLine, startCol
        -> tok
    }

    if lexer.ch == "/" && (peekLexerChar lexer) == "/" {
        // Skip single line comment
        wh lexer.ch != "\n" && lexer.ch != "" {
            readLexerChar lexer
        }
        -> nextLexerToken lexer
    }

    if lexer.ch == "/" && (peekLexerChar lexer) == "*" {
        // Skip multi-line comment: /* ... */
        readLexerChar lexer
        readLexerChar lexer
        wh lexer.ch != "" {
            if lexer.ch == "\n" {
                lexer.line = lexer.line + 1
                lexer.col = 0
            }
            if lexer.ch == "*" && (peekLexerChar lexer) == "/" {
                readLexerChar lexer
                readLexerChar lexer
                brk
            }
            readLexerChar lexer
        }
        -> nextLexerToken lexer
    }

    if lexer.ch == "=" {
        if (peekLexerChar lexer) == "=" {
            readLexerChar lexer
            readLexerChar lexer
            -> CreateToken "SYM", "==", startLine, startCol
        } els if (peekLexerChar lexer) == ">" {
            readLexerChar lexer
            readLexerChar lexer
            -> CreateToken "SYM", "=>", startLine, startCol
        } els {
            readLexerChar lexer
            -> CreateToken "SYM", "=", startLine, startCol
        }
    }

    if lexer.ch == "-" {
        if (peekLexerChar lexer) == ">" {
            readLexerChar lexer
            readLexerChar lexer
            -> CreateToken "ARROW", "->", startLine, startCol
        } els if (peekLexerChar lexer) == "-" {
            readLexerChar lexer
            readLexerChar lexer
            -> CreateToken "SYM", "--", startLine, startCol
        } els if (peekLexerChar lexer) == "=" {
            readLexerChar lexer
            readLexerChar lexer
            -> CreateToken "SYM", "-=", startLine, startCol
        } els {
            readLexerChar lexer
            -> CreateToken "SYM", "-", startLine, startCol
        }
    }

    if lexer.ch == "+" {
        if (peekLexerChar lexer) == "+" {
            readLexerChar lexer
            readLexerChar lexer
            -> CreateToken "SYM", "++", startLine, startCol
        } els if (peekLexerChar lexer) == "=" {
            readLexerChar lexer
            readLexerChar lexer
            -> CreateToken "SYM", "+=", startLine, startCol
        } els {
            readLexerChar lexer
            -> CreateToken "SYM", "+", startLine, startCol
        }
    }

    if lexer.ch == "!" {
        if (peekLexerChar lexer) == "=" {
            readLexerChar lexer
            readLexerChar lexer
            -> CreateToken "SYM", "!=", startLine, startCol
        } els {
            readLexerChar lexer
            -> CreateToken "SYM", "!", startLine, startCol
        }
    }

    if lexer.ch == "<" {
        if (peekLexerChar lexer) == "=" {
            readLexerChar lexer
            readLexerChar lexer
            -> CreateToken "SYM", "<=", startLine, startCol
        } els if (peekLexerChar lexer) == "<" {
            readLexerChar lexer
            readLexerChar lexer
            -> CreateToken "SYM", "<<", startLine, startCol
        } els {
            readLexerChar lexer
            -> CreateToken "SYM", "<", startLine, startCol
        }
    }

    if lexer.ch == ">" {
        if (peekLexerChar lexer) == ">" {
            readLexerChar lexer
            if (peekLexerChar lexer) == ">" {
                readLexerChar lexer
                readLexerChar lexer
                -> CreateToken "SYM", ">>>", startLine, startCol
            } els {
                readLexerChar lexer
                -> CreateToken "SYM", ">>", startLine, startCol
            }
        } els if (peekLexerChar lexer) == "=" {
            readLexerChar lexer
            readLexerChar lexer
            -> CreateToken "SYM", ">=", startLine, startCol
        } els {
            readLexerChar lexer
            -> CreateToken "SYM", ">", startLine, startCol
        }
    }

    if lexer.ch == "&" {
        if (peekLexerChar lexer) == "&" {
            readLexerChar lexer
            readLexerChar lexer
            -> CreateToken "SYM", "&&", startLine, startCol
        } els if (peekLexerChar lexer) == "=" {
            readLexerChar lexer
            readLexerChar lexer
            -> CreateToken "SYM", "&=", startLine, startCol
        } els {
            readLexerChar lexer
            -> CreateToken "SYM", "&", startLine, startCol
        }
    }

    if lexer.ch == "|" {
        if (peekLexerChar lexer) == "|" {
            readLexerChar lexer
            readLexerChar lexer
            -> CreateToken "SYM", "||", startLine, startCol
        } els if (peekLexerChar lexer) == "=" {
            readLexerChar lexer
            readLexerChar lexer
            -> CreateToken "SYM", "|=", startLine, startCol
        } els {
            readLexerChar lexer
            -> CreateToken "SYM", "|", startLine, startCol
        }
    }

    if lexer.ch == "*" {
        if (peekLexerChar lexer) == "*" {
            readLexerChar lexer
            if (peekLexerChar lexer) == "=" {
                readLexerChar lexer
                readLexerChar lexer
                -> CreateToken "SYM", "**=", startLine, startCol
            } els {
                readLexerChar lexer
                -> CreateToken "SYM", "**", startLine, startCol
            }
        } els if (peekLexerChar lexer) == "=" {
            readLexerChar lexer
            readLexerChar lexer
            -> CreateToken "SYM", "*=", startLine, startCol
        } els {
            readLexerChar lexer
            -> CreateToken "SYM", "*", startLine, startCol
        }
    }

    if lexer.ch == "/" {
        if (peekLexerChar lexer) == "=" {
            readLexerChar lexer
            readLexerChar lexer
            -> CreateToken "SYM", "/=", startLine, startCol
        } els {
            readLexerChar lexer
            -> CreateToken "SYM", "/", startLine, startCol
        }
    }

    if lexer.ch == "%" {
        if (peekLexerChar lexer) == "=" {
            readLexerChar lexer
            readLexerChar lexer
            -> CreateToken "SYM", "%=", startLine, startCol
        } els {
            readLexerChar lexer
            -> CreateToken "SYM", "%", startLine, startCol
        }
    }

    if lexer.ch == "^" {
        if (peekLexerChar lexer) == "=" {
            readLexerChar lexer
            readLexerChar lexer
            -> CreateToken "SYM", "^=", startLine, startCol
        } els {
            readLexerChar lexer
            -> CreateToken "SYM", "^", startLine, startCol
        }
    }

    if lexer.ch == "?" {
        readLexerChar lexer
        if lexer.ch == "?" {
            readLexerChar lexer
            -> CreateToken "SYM", "??", startLine, startCol
        }
        if lexer.ch == "." {
            readLexerChar lexer
            -> CreateToken "SYM", "?.", startLine, startCol
        }
        -> CreateToken "SYM", "?", startLine, startCol
    }

    if lexer.ch == ":" {
        if (peekLexerChar lexer) == ":" {
            readLexerChar lexer
            readLexerChar lexer
            -> CreateToken "SYM", "::", startLine, startCol
        }
        readLexerChar lexer
        -> CreateToken "SYM", ":", startLine, startCol
    }

    if lexer.ch == "~" || lexer.ch == "(" || lexer.ch == ")" || lexer.ch == "{" || lexer.ch == "}" ||
       lexer.ch == "[" || lexer.ch == "]" || lexer.ch == "," || lexer.ch == ";" || lexer.ch == "@" {
        c = lexer.ch
        readLexerChar lexer
        -> CreateToken "SYM", c, startLine, startCol
    }

    if lexer.ch == "." {
        readLexerChar lexer
        if lexer.ch == "." {
            readLexerChar lexer
            if lexer.ch == "." {
                readLexerChar lexer
                -> CreateToken "SYM", "...", startLine, startCol
            }
            -> CreateToken "ILLEGAL", "..", startLine, startCol
        }
        -> CreateToken "SYM", ".", startLine, startCol
    }

    if lexer.ch == `"` || lexer.ch == `'` || lexer.ch == "`" {
        q = lexer.ch
        -> readLexerString lexer, q
    }

    if isLexerDigit lexer.ch {
        -> readLexerNumber lexer
    }

    if isLexerLetter lexer.ch {
        -> readLexerIdentifier lexer
    }

    c = lexer.ch
    readLexerChar lexer
    -> CreateToken "ILLEGAL", c, startLine, startCol
}

TokenizeFull lexer {
    let tokensList = []

    let done = 0
    wh done == 0 {
        tok = nextLexerToken lexer
        tokensList.psh tok
        if tok.kind == "EOF" {
            done = 1
        }
    }

    -> tokensList
}
