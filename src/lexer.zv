// Full Lexer Scanner Engine for Zuv Self-Hosting Compiler (src/lexer.zv)
imp str, arr
imp createToken frm tokens

createLexer code {
    l = code.ln
    let lexer = { src: code, pos: 0, totalLen: l, line: 1, col: 0, ch: "" }
    readLexerChar lexer
    -> lexer
}

readLexerChar lexer {
    if lexer.pos >= lexer.totalLen {
        lexer.ch = ""
    } els {
        lexer.ch = lexer.src.chr lexer.pos
        lexer.pos = lexer.pos + 1
        lexer.col = lexer.col + 1
    }
}

peekLexerChar lexer {
    if lexer.pos >= lexer.totalLen {
        -> ""
    }
    nextCh = lexer.src.chr lexer.pos
    -> nextCh
}

skipLexerWhitespace lexer {
    wh lexer.ch == " " || lexer.ch == "\t" || lexer.ch == "\n" || lexer.ch == "\r" {
        if lexer.ch == "\n" {
            lexer.line = lexer.line + 1
            lexer.col = 0
        }
        readLexerChar lexer
    }
}

isLexerDigit ch {
    if ch == "0" || ch == "1" || ch == "2" || ch == "3" || ch == "4" ||
       ch == "5" || ch == "6" || ch == "7" || ch == "8" || ch == "9" {
        -> 1
    }
    -> 0
}

isLexerLetter ch {
    if ch == "a" || ch == "b" || ch == "c" || ch == "d" || ch == "e" ||
       ch == "f" || ch == "g" || ch == "h" || ch == "i" || ch == "j" ||
       ch == "k" || ch == "l" || ch == "m" || ch == "n" || ch == "o" ||
       ch == "p" || ch == "q" || ch == "r" || ch == "s" || ch == "t" ||
       ch == "u" || ch == "v" || ch == "w" || ch == "x" || ch == "y" ||
       ch == "z" || ch == "_" ||
       ch == "A" || ch == "B" || ch == "C" || ch == "D" || ch == "E" ||
       ch == "F" || ch == "G" || ch == "H" || ch == "I" || ch == "J" ||
       ch == "K" || ch == "L" || ch == "M" || ch == "N" || ch == "O" ||
       ch == "P" || ch == "Q" || ch == "R" || ch == "S" || ch == "T" ||
       ch == "U" || ch == "V" || ch == "W" || ch == "X" || ch == "Y" ||
       ch == "Z" {
        -> 1
    }
    -> 0
}

isLexerKeyword word {
    if word == "imp" || word == "frm" || word == "wrk" || word == "prnt" ||
       word == "lg" || word == "wrn" || word == "inf" || word == "ret" ||
       word == "els" || word == "wh" || word == "fr" || word == "brk" ||
       word == "cont" || word == "dn" || word == "mch" || word == "ok" ||
       word == "err" || word == "if" || word == "and" || word == "or" ||
       word == "not" || word == "mut" || word == "let" || word == "asc" || word == "awt" ||
       word == "typ" || word == "sym" || word == "enum" ||
       word == "obj" || word == "num" || word == "bool" || word == "str" ||
       word == "extern" || word == "ffi" || word == "main" {
        -> 1
    }
    -> 0
}

isLexerBoolLit word {
    if word == "true" || word == "false" || word == "yes" || word == "no" {
        -> 1
    }
    -> 0
}

isLexerNilLit word {
    if word == "nil" || word == "und" {
        -> 1
    }
    -> 0
}

readLexerString lexer, quoteChar {
    startLine = lexer.line
    startCol = lexer.col
    readLexerChar lexer

    let strVal = ""
    wh lexer.ch != quoteChar && lexer.ch != "" {
        if lexer.ch == "\n" {
            lexer.line = lexer.line + 1
            lexer.col = 0
            strVal = strVal.cat "\n"
        } els if lexer.ch == "\\" {
            readLexerChar lexer
            if lexer.ch == "n" { strVal = strVal.cat "\n" }
            els if lexer.ch == "t" { strVal = strVal.cat "\t" }
            els if lexer.ch == "r" { strVal = strVal.cat "\r" }
            els if lexer.ch == `"` { strVal = strVal.cat `"` }
            els if lexer.ch == `'` { strVal = strVal.cat `'` }
            els if lexer.ch == "`" { strVal = strVal.cat "`" }
            els if lexer.ch == "$" { strVal = strVal.cat "$" }
            els if lexer.ch == "\\" { strVal = strVal.cat "\\" }
            els { strVal = strVal.cat lexer.ch }
        } els {
            strVal = strVal.cat lexer.ch
        }
        readLexerChar lexer
    }

    if lexer.ch == quoteChar {
        readLexerChar lexer
    }

    tok = createToken "STRING", strVal, startLine, startCol
    -> tok
}

readLexerNumber lexer {
    startLine = lexer.line
    startCol = lexer.col
    let numVal = ""

    wh (isLexerDigit lexer.ch) || (lexer.ch == "." && (isLexerDigit (peekLexerChar lexer))) {
        numVal = numVal.cat lexer.ch
        readLexerChar lexer
    }

    tok = createToken "NUMBER", numVal, startLine, startCol
    -> tok
}

readLexerIdentifier lexer {
    startLine = lexer.line
    startCol = lexer.col
    let word = ""

    wh (isLexerLetter lexer.ch) || (isLexerDigit lexer.ch) {
        word = word.cat lexer.ch
        readLexerChar lexer
    }

    if isLexerBoolLit word {
        tok = createToken "BOOL", word, startLine, startCol
        -> tok
    } els if isLexerNilLit word {
        tok = createToken "NIL", word, startLine, startCol
        -> tok
    } els if isLexerKeyword word {
        tok = createToken "KEYWORD", word, startLine, startCol
        -> tok
    } els {
        tok = createToken "IDENT", word, startLine, startCol
        -> tok
    }
}

nextLexerToken lexer {
    skipLexerWhitespace lexer

    startLine = lexer.line
    startCol = lexer.col

    if lexer.ch == "" {
        tok = createToken "EOF", "", startLine, startCol
        -> tok
    }

    if lexer.ch == "/" && (peekLexerChar lexer) == "/" {
        // Skip single line comment
        wh lexer.ch != "\n" && lexer.ch != "" {
            readLexerChar lexer
        }
        -> nextLexerToken lexer
    }

    if lexer.ch == "/" && (peekLexerChar lexer) == "*" {
        // Skip multi-line comment: /* ... */
        readLexerChar lexer
        readLexerChar lexer
        wh lexer.ch != "" {
            if lexer.ch == "\n" {
                lexer.line = lexer.line + 1
                lexer.col = 0
            }
            if lexer.ch == "*" && (peekLexerChar lexer) == "/" {
                readLexerChar lexer
                readLexerChar lexer
                brk
            }
            readLexerChar lexer
        }
        -> nextLexerToken lexer
    }

    if lexer.ch == "=" {
        if (peekLexerChar lexer) == "=" {
            readLexerChar lexer
            readLexerChar lexer
            -> createToken "SYM", "==", startLine, startCol
        } els if (peekLexerChar lexer) == ">" {
            readLexerChar lexer
            readLexerChar lexer
            -> createToken "SYM", "=>", startLine, startCol
        } els {
            readLexerChar lexer
            -> createToken "SYM", "=", startLine, startCol
        }
    }

    if lexer.ch == "-" {
        if (peekLexerChar lexer) == ">" {
            readLexerChar lexer
            readLexerChar lexer
            -> createToken "ARROW", "->", startLine, startCol
        } els {
            readLexerChar lexer
            -> createToken "SYM", "-", startLine, startCol
        }
    }

    if lexer.ch == "!" {
        if (peekLexerChar lexer) == "=" {
            readLexerChar lexer
            readLexerChar lexer
            -> createToken "SYM", "!=", startLine, startCol
        } els {
            readLexerChar lexer
            -> createToken "SYM", "!", startLine, startCol
        }
    }

    if lexer.ch == "<" {
        if (peekLexerChar lexer) == "=" {
            readLexerChar lexer
            readLexerChar lexer
            -> createToken "SYM", "<=", startLine, startCol
        } els {
            readLexerChar lexer
            -> createToken "SYM", "<", startLine, startCol
        }
    }

    if lexer.ch == ">" {
        if (peekLexerChar lexer) == "=" {
            readLexerChar lexer
            readLexerChar lexer
            -> createToken "SYM", ">=", startLine, startCol
        } els {
            readLexerChar lexer
            -> createToken "SYM", ">", startLine, startCol
        }
    }

    if lexer.ch == "&" {
        if (peekLexerChar lexer) == "&" {
            readLexerChar lexer
            readLexerChar lexer
            -> createToken "SYM", "&&", startLine, startCol
        } els {
            readLexerChar lexer
            -> createToken "SYM", "&", startLine, startCol
        }
    }

    if lexer.ch == "|" {
        if (peekLexerChar lexer) == "|" {
            readLexerChar lexer
            readLexerChar lexer
            -> createToken "SYM", "||", startLine, startCol
        } els {
            readLexerChar lexer
            -> createToken "SYM", "|", startLine, startCol
        }
    }

    if lexer.ch == "+" || lexer.ch == "*" || lexer.ch == "/" || lexer.ch == "%" ||
       lexer.ch == "(" || lexer.ch == ")" || lexer.ch == "{" || lexer.ch == "}" ||
       lexer.ch == "[" || lexer.ch == "]" || lexer.ch == "." || lexer.ch == "," ||
       lexer.ch == ":" || lexer.ch == ";" || lexer.ch == "?" {
        c = lexer.ch
        readLexerChar lexer
        -> createToken "SYM", c, startLine, startCol
    }

    if lexer.ch == `"` || lexer.ch == `'` || lexer.ch == "`" {
        q = lexer.ch
        -> readLexerString lexer, q
    }

    if isLexerDigit lexer.ch {
        -> readLexerNumber lexer
    }

    if isLexerLetter lexer.ch {
        -> readLexerIdentifier lexer
    }

    c = lexer.ch
    readLexerChar lexer
    -> createToken "ILLEGAL", c, startLine, startCol
}

tokenizeFull lexer {
    let tokensList = []

    let done = 0
    wh done == 0 {
        tok = nextLexerToken lexer
        tokensList.psh tok
        if tok.kind == "EOF" {
            done = 1
        }
    }

    -> tokensList
}
