/*
 * =============================================================================
 * Zuv Bootstrap Compiler — Main Entry Point
 * Path: sub_projects/zuv/src/bootstrap/main.zv
 * =============================================================================
 */

imp os, fs, str, arr
imp Token, TokenType frm tokens
imp TypeInfo, TypeKind, TypeKindToStr, AreTypesCompatible, StrToTypeKind frm types
imp ASTNode, NodeKind frm ast
imp Diagnostic frm diagnostics

imp Lexer frm lexer
imp Parser frm parser/parser
imp ParseDeclaration frm parser/decl
imp ParseStatement frm parser/stmt
imp ParseExpression frm parser/expr
imp Checker, Symbol, Scope frm checker/checker
imp InferExpression, InferStatement, InferDeclaration, InferProgram frm checker/infer
imp BorrowChecker, BorrowVar, BorrowScope, ReferenceAlias, BorrowCheckProgram, BorrowCheckStatement, BorrowCheckExpression frm checker/borrow

main {
    prnt "=== Zuv Bootstrap Compiler v0.6.0 (Phase 1 & Phase 2 Foundations) ==="

    // 1. Token Verification via Token.create and instance methods
    tok = Token.create TokenType.TOK_LET, "let", 1, 1, 3
    tokName: str = tok.toString
    prnt `1. Token kind: ${tokName}`
    if tok.isKeyword {
        prnt "   Token keyword check: OK"
    }

    // 2. Type System Verification via TypeInfo factories and helpers
    tDbl = TypeKind.Double
    tI32 = TypeKind.I32
    dblType = TypeInfo.createPrimitive tDbl, "double"
    prnt `2. Type kind: ${dblType.toString} (isNumeric: ${dblType.isNumeric})`
    compat: bool = AreTypesCompatible tDbl, tI32
    if compat {
        prnt "   Type compatibility: i32 -> double OK"
    }
    parsedKind = StrToTypeKind "i64"
    ptrType = TypeInfo.createPointer parsedKind, "i64"
    prnt `   Pointer type: ${ptrType.toString} (isPointer: ${ptrType.isPointer})`
    fnParams: str[] = ["num", "num"]
    fnType = TypeInfo.createFunc TypeKind.Double, "num", fnParams
    prnt `   Function type: ${fnType.toString}`

    // 3. AST Verification via ASTNode factories and methods
    numNode = ASTNode.createNum 42, 1, 5
    nodeName: str = numNode.toString
    nodeTyp: str = TypeKindToStr numNode.inferredType
    prnt `3. AST Node: ${nodeName} (inferred: ${nodeTyp}, val: ${numNode.numVal})`

    num10 = ASTNode.createNum 10, 1, 10
    binNode = ASTNode.createBinary "+", numNode, num10, 1, 8
    prnt `   AST Binary: ${binNode.toString} (op: '${binNode.op}', isExpr: ${binNode.isExpr})`

    varNode = ASTNode.createVarDecl "total", "num", false, binNode, 1, 1
    prnt `   AST VarDecl: ${varNode.toString} (name: '${varNode.name}', isDecl: ${varNode.isDecl})`

    condNode = ASTNode.createBool true, 2, 5
    thenBlock = ASTNode.createBlock [], 2, 12
    elseBlock = ASTNode.createNil 2, 20
    ifNode = ASTNode.createIf condNode, thenBlock, elseBlock, 2, 1
    prnt `   AST IfStmt: ${ifNode.toString} (isStmt: ${ifNode.isStmt})`

    // 4. Diagnostics Verification via Diagnostic.create and diag.format
    diag = Diagnostic.create "E0102", "Expected next token to be {, got IDENTIFIER instead", "example.zv", 2, 11, 1, "add '{' here"
    mockSource: str = "fn square x {\n    -> x * x\n}"
    formatted: str = diag.format mockSource
    prnt "4. Formatted Diagnostic:"
    prnt formatted

    // 5. Lexer Verification (Phase 2 Task 2.1)
    prnt "5. Lexer Verification:"
    sampleCode: str = "let x = 0xFF\n&let ref = x\n// comment\nprnt r\"raw\\nstr\"\nfr i = 0; i < 5; i++ {\n    -> `val: ${i}`\n}"
    lex = Lexer.create sampleCode
    scannedTokens: Token[] = lex.tokenizeAll
    count: num = scannedTokens.ln
    prnt `   Tokenized ${count} tokens successfully`
    fr tokItem, i of scannedTokens {
        prnt `   Token ${i}: ${tokItem.toString} ('${tokItem.val}')`
    }

    // 6. Parser Coordinator Verification (Phase 2 Task 2.2)
    prnt "6. Parser Coordinator Verification:"
    parser = Parser.create scannedTokens, "test.zv", sampleCode
    curTok: Token = parser.cur
    prnt `   Parser initial cur: ${curTok.toString} ('${curTok.val}')`
    peekTok: Token = parser.peek
    prnt `   Parser peek: ${peekTok.toString} ('${peekTok.val}')`
    peek2Tok: Token = parser.peekAhead 2
    prnt `   Parser peekAhead(2): ${peek2Tok.toString} ('${peek2Tok.val}')`
    matchedLet: bool = parser.matchToken TokenType.TOK_LET
    prnt `   Parser matched 'let': ${matchedLet}`
    curAfterMatch: Token = parser.cur
    prnt `   Parser cur after match: ${curAfterMatch.toString} ('${curAfterMatch.val}')`
    consumedIdent: Token = parser.consume TokenType.TOK_IDENT, "Expected identifier"
    prnt `   Parser consumed ident: '${consumedIdent.val}'`
    isEnd: bool = parser.isAtEnd
    prnt `   Parser isAtEnd: ${isEnd}`

    // 7. Declaration Parser Verification (Phase 2 Task 2.3)
    prnt "7. Declaration Parser Verification:"
    typeDeclCode: str = "type Point = { x: num, y: num }"
    lexType = Lexer.create typeDeclCode
    pType = Parser.create lexType.tokenizeAll, "type.zv", typeDeclCode
    astType: ASTNode = ParseDeclaration pType
    prnt `   Parsed TypeDecl: '${astType.name}', fields count: ${astType.fields.ln}`

    objDeclCode: str = "obj User { name: str, age: num }"
    lexObj = Lexer.create objDeclCode
    pObj = Parser.create lexObj.tokenizeAll, "obj.zv", objDeclCode
    astObj: ASTNode = ParseDeclaration pObj
    prnt `   Parsed ObjDecl: '${astObj.name}', fields count: ${astObj.fields.ln}`

    fnDeclCode: str = "pub fn add a: num, b: num :: num"
    lexFn = Lexer.create fnDeclCode
    pFn = Parser.create lexFn.tokenizeAll, "fn.zv", fnDeclCode
    astFn: ASTNode = ParseDeclaration pFn
    prnt `   Parsed FuncDecl: '${astFn.name}', params count: ${astFn.params.ln}, ret: '${astFn.typeAnnotation}', pub: ${astFn.isPub}`

    enumDeclCode: str = "enum Color { Red, Green, Blue = 10 }"
    lexEnum = Lexer.create enumDeclCode
    pEnum = Parser.create lexEnum.tokenizeAll, "enum.zv", enumDeclCode
    astEnum: ASTNode = ParseDeclaration pEnum
    prnt `   Parsed EnumDecl: '${astEnum.name}', variants count: ${astEnum.fields.ln}`

    impDeclCode: str = "imp Token, TokenType frm ../tokens"
    lexImp = Lexer.create impDeclCode
    pImp = Parser.create lexImp.tokenizeAll, "imp.zv", impDeclCode
    astImp: ASTNode = ParseDeclaration pImp
    prnt `   Parsed ImportDecl: path: '${astImp.val}', symbols count: ${astImp.fields.ln}`

    // 8. Statement Parser Verification (Phase 2 Task 2.4)
    prnt "8. Statement Parser Verification:"
    varStmtCode: str = "let total: num = 100"
    lexVar = Lexer.create varStmtCode
    pVar = Parser.create lexVar.tokenizeAll, "var.zv", varStmtCode
    astVar: ASTNode = ParseStatement pVar
    prnt `   Parsed VarDecl: '${astVar.name}', type: '${astVar.typeAnnotation}', isBorrow: ${astVar.isBorrow}`

    borrowStmtCode: str = "&let ref = total"
    lexBorrow = Lexer.create borrowStmtCode
    pBorrow = Parser.create lexBorrow.tokenizeAll, "borrow.zv", borrowStmtCode
    astBorrow: ASTNode = ParseStatement pBorrow
    prnt `   Parsed BorrowDecl: '${astBorrow.name}', isBorrow: ${astBorrow.isBorrow}`

    ifStmtCode: str = "if total > 50 { -> true } els { -> false }"
    lexIf = Lexer.create ifStmtCode
    pIf = Parser.create lexIf.tokenizeAll, "if.zv", ifStmtCode
    astIf: ASTNode = ParseStatement pIf
    prnt `   Parsed IfStmt: children: ${astIf.children.ln}, kind: ${astIf.toString}`

    whStmtCode: str = "wh i < 10 { i++ }"
    lexWh = Lexer.create whStmtCode
    pWh = Parser.create lexWh.tokenizeAll, "wh.zv", whStmtCode
    astWh: ASTNode = ParseStatement pWh
    prnt `   Parsed WhileStmt: children: ${astWh.children.ln}, kind: ${astWh.toString}`

    frStmtCode: str = "fr item in items { -> item }"
    lexFr = Lexer.create frStmtCode
    pFr = Parser.create lexFr.tokenizeAll, "fr.zv", frStmtCode
    astFr: ASTNode = ParseStatement pFr
    prnt `   Parsed ForStmt: item: '${astFr.name}', kind: ${astFr.toString}`

    retStmtCode: str = "-> x + 1"
    lexRet = Lexer.create retStmtCode
    pRet = Parser.create lexRet.tokenizeAll, "ret.zv", retStmtCode
    astRet: ASTNode = ParseStatement pRet
    prnt `   Parsed RetStmt: children: ${astRet.children.ln}, kind: ${astRet.toString}`

    brkStmtCode: str = "brk"
    lexBrk = Lexer.create brkStmtCode
    pBrk = Parser.create lexBrk.tokenizeAll, "brk.zv", brkStmtCode
    astBrk: ASTNode = ParseStatement pBrk
    prnt `   Parsed BreakStmt: kind: ${astBrk.toString}`

    contStmtCode: str = "cont"
    lexCont = Lexer.create contStmtCode
    pCont = Parser.create lexCont.tokenizeAll, "cont.zv", contStmtCode
    astCont: ASTNode = ParseStatement pCont
    prnt `   Parsed ContinueStmt: kind: ${astCont.toString}`

    panicStmtCode: str = "panic \"fatal error\""
    lexPanic = Lexer.create panicStmtCode
    pPanic = Parser.create lexPanic.tokenizeAll, "panic.zv", panicStmtCode
    astPanic: ASTNode = ParseStatement pPanic
    prnt `   Parsed PanicStmt: children: ${astPanic.children.ln}, kind: ${astPanic.toString}`

    tryStmtCode: str = "try { doTask } cth err { panic err }"
    lexTry = Lexer.create tryStmtCode
    pTry = Parser.create lexTry.tokenizeAll, "try.zv", tryStmtCode
    astTry: ASTNode = ParseStatement pTry
    prnt `   Parsed TryCthStmt: errVar: '${astTry.name}', children: ${astTry.children.ln}`

    swStmtCode: str = "sw status { 1 => { -> true }, _ => { -> false } }"
    lexSw = Lexer.create swStmtCode
    pSw = Parser.create lexSw.tokenizeAll, "sw.zv", swStmtCode
    astSw: ASTNode = ParseStatement pSw
    prnt `   Parsed SwStmt: cases: ${astSw.cases.ln}, children: ${astSw.children.ln}`

    // 9. Expression Parser Verification (Phase 2 Task 2.5)
    prnt "9. Expression Parser Verification:"
    arithCode: str = "1 + 2 * 3"
    lexArith = Lexer.create arithCode
    pArith = Parser.create lexArith.tokenizeAll, "arith.zv", arithCode
    astArith: ASTNode = ParseExpression pArith, 1
    prnt `   Parsed Binary Precedence: op: '${astArith.op}', left: ${astArith.children[0].val}, right op: '${astArith.children[1].op}'`

    logicCode: str = "x > 0 && y <= 10"
    lexLogic = Lexer.create logicCode
    pLogic = Parser.create lexLogic.tokenizeAll, "logic.zv", logicCode
    astLogic: ASTNode = ParseExpression pLogic, 1
    prnt `   Parsed Logic Precedence: op: '${astLogic.op}', left op: '${astLogic.children[0].op}', right op: '${astLogic.children[1].op}'`

    accessCode: str = "user.profile.name[0]"
    lexAccess = Lexer.create accessCode
    pAccess = Parser.create lexAccess.tokenizeAll, "access.zv", accessCode
    astAccess: ASTNode = ParseExpression pAccess, 1
    prnt `   Parsed Index & Member Access: kind: ${astAccess.toString}`

    safeCode: str = "config?.debug"
    lexSafe = Lexer.create safeCode
    pSafe = Parser.create lexSafe.tokenizeAll, "safe.zv", safeCode
    astSafe: ASTNode = ParseExpression pSafe, 1
    prnt `   Parsed Safe Navigation: op: '${astSafe.op}', name: '${astSafe.name}'`

    callCode: str = "add(x, y * 2)"
    lexCall = Lexer.create callCode
    pCall = Parser.create lexCall.tokenizeAll, "call.zv", callCode
    astCall: ASTNode = ParseExpression pCall, 1
    prnt `   Parsed CallExpr: kind: ${astCall.toString}, children: ${astCall.children.ln}`

    incCode: str = "count++"
    lexInc = Lexer.create incCode
    pInc = Parser.create lexInc.tokenizeAll, "inc.zv", incCode
    astInc: ASTNode = ParseExpression pInc, 1
    prnt `   Parsed Postfix Unary: op: '${astInc.op}', isPrefix: ${astInc.isPrefix}`

    ternaryCode: str = "isReady ? 100 : 0"
    lexTernary = Lexer.create ternaryCode
    pTernary = Parser.create lexTernary.tokenizeAll, "ternary.zv", ternaryCode
    astTernary: ASTNode = ParseExpression pTernary, 1
    prnt `   Parsed Ternary: kind: ${astTernary.toString}, children: ${astTernary.children.ln}`

    castCode: str = "total as i64"
    lexCast = Lexer.create castCode
    pCast = Parser.create lexCast.tokenizeAll, "cast.zv", castCode
    astCast: ASTNode = ParseExpression pCast, 1
    prnt `   Parsed Type Cast: kind: ${astCast.toString}, typeAnnotation: '${astCast.typeAnnotation}'`

    arrLitCode: str = "[1, 2, 3 + 4]"
    lexArrLit = Lexer.create arrLitCode
    pArrLit = Parser.create lexArrLit.tokenizeAll, "arrlit.zv", arrLitCode
    astArrLit: ASTNode = ParseExpression pArrLit, 1
    prnt `   Parsed ArrExpr: kind: ${astArrLit.toString}, count: ${astArrLit.children.ln}`

    objLitCode: str = "{ name: \"alice\", count: 42 }"
    lexObjLit = Lexer.create objLitCode
    pObjLit = Parser.create lexObjLit.tokenizeAll, "objlit.zv", objLitCode
    astObjLit: ASTNode = ParseExpression pObjLit, 1
    prnt `   Parsed ObjLitExpr: kind: ${astObjLit.toString}, fields: ${astObjLit.fields.ln}`

    // 10. Scope Management & Symbol Table Verification (Phase 3 Task 3.1)
    prnt "10. Scope Management & Symbol Table Verification:"
    checker = Checker.create "main.zv", sampleCode
    hasOs: bool = checker.hasSymbol "os"
    hasPrnt: bool = checker.hasSymbol "prnt"
    prnt `    Global builtins present: os=${hasOs}, prnt=${hasPrnt}`

    symVar = Symbol.create "counter", TypeKind.Double, "num", false, true, 0, 1, 1
    defRoot: bool = checker.defineSymbol symVar
    prnt `    Defined root symbol 'counter': ${defRoot}`

    checker.enterScope
    nestedLvl: num = checker.currentLevel
    prnt `    Entered nested scope level: ${nestedLvl}`
    symNested = Symbol.create "temp", TypeKind.Str, "str", false, true, 1, 2, 5
    defNested: bool = checker.defineSymbol symNested
    prnt `    Defined nested symbol 'temp': ${defNested}`
    hasTempLocal: bool = checker.hasSymbolInCurrentScope "temp"
    hasCounterFromNested: bool = checker.hasSymbol "counter"
    prnt `    Scope lookup: temp (local)=${hasTempLocal}, counter (enclosing)=${hasCounterFromNested}`

    // Duplicate definition test in same scope
    defDup: bool = checker.defineSymbol symNested
    prnt `    Duplicate definition rejection: ${!defDup}, error logged: ${checker.hasErrors}`

    checker.exitScope
    prnt `    Exited scope, restored level: ${checker.currentLevel}`
    hasTempAfterExit: bool = checker.hasSymbol "temp"
    hasCounterAfterExit: bool = checker.hasSymbol "counter"
    prnt `    Scope lookup after exit: temp=${hasTempAfterExit}, counter=${hasCounterAfterExit}`

    customPoint = TypeInfo.createObject "Point"
    checker.registerType customPoint
    resolvedPoint: TypeInfo = checker.resolveType "Point"
    prnt `    Custom type resolution: '${resolvedPoint.name}' (kind: ${resolvedPoint.kind})`

    // 11. Type Inference & AST Annotation Verification (Phase 3 Task 3.2)
    prnt "11. Type Inference & AST Annotation Verification:"
    cInfer = Checker.create "infer_test.zv", ""

    // 11.1 Literal Inferences
    numLitNode = ASTNode.createNum 42, 1, 1
    numLitNode.val = "42"
    inferredNumKind = InferExpression cInfer, numLitNode
    prnt `    Inferred NumExpr (42): kind=${TypeKindToStr inferredNumKind}, annotated=${TypeKindToStr numLitNode.inferredType}`

    floatLitNode = ASTNode.createNum 3.14, 1, 1
    floatLitNode.val = "3.14"
    inferredFloatKind = InferExpression cInfer, floatLitNode
    prnt `    Inferred NumExpr (3.14): kind=${TypeKindToStr inferredFloatKind}, annotated=${TypeKindToStr floatLitNode.inferredType}`

    strLitNode = ASTNode.createStr "hello", 1, 1
    inferredStrKind = InferExpression cInfer, strLitNode
    prnt `    Inferred StrExpr ('hello'): kind=${TypeKindToStr inferredStrKind}, annotated=${TypeKindToStr strLitNode.inferredType}`

    boolLitNode = ASTNode.createBool true, 1, 1
    inferredBoolKind = InferExpression cInfer, boolLitNode
    prnt `    Inferred BoolExpr (true): kind=${TypeKindToStr inferredBoolKind}, annotated=${TypeKindToStr boolLitNode.inferredType}`

    arrLitNode = ASTNode.createArr [numLitNode, floatLitNode], 1, 1
    inferredArrKind = InferExpression cInfer, arrLitNode
    prnt `    Inferred ArrExpr ([42, 3.14]): kind=${TypeKindToStr inferredArrKind}, annotated=${TypeKindToStr arrLitNode.inferredType}`

    // 11.2 Binary Expression Inference (Arithmetic & String Coercion)
    binAddNode = ASTNode.createBinary "+", numLitNode, floatLitNode, 1, 1
    inferredAddKind = InferExpression cInfer, binAddNode
    prnt `    Inferred Binary '+' (42 + 3.14): kind=${TypeKindToStr inferredAddKind}`

    binConcatNode = ASTNode.createBinary "+", strLitNode, numLitNode, 1, 1
    inferredConcatKind = InferExpression cInfer, binConcatNode
    prnt `    Inferred Binary '+' ('hello' + 42): kind=${TypeKindToStr inferredConcatKind}`

    binCmpNode = ASTNode.createBinary "<", numLitNode, floatLitNode, 1, 1
    inferredCmpKind = InferExpression cInfer, binCmpNode
    prnt `    Inferred Binary '<' (42 < 3.14): kind=${TypeKindToStr inferredCmpKind}`

    // 11.3 Struct Member Verification (E0302 on invalid field)
    pointType = TypeInfo.createObject "Point"
    pointType.addField "x", TypeKind.Double
    pointType.addField "y", TypeKind.Double
    cInfer.registerType pointType

    symPointVar = Symbol.create "pt", TypeKind.Obj, "Point", false, true, 0, 1, 1
    cInfer.defineSymbol symPointVar

    ptIdent = ASTNode.createIdent "pt", 1, 1
    validPropNode = ASTNode.createProp ptIdent, "x", 1, 1
    inferredPropKind = InferExpression cInfer, validPropNode
    prnt `    Inferred Struct Property 'pt.x': kind=${TypeKindToStr inferredPropKind}, errors=${cInfer.errors.ln}`

    invalidPropNode = ASTNode.createProp ptIdent, "z", 1, 1
    inferredInvalidKind = InferExpression cInfer, invalidPropNode
    prnt `    Inferred Invalid Property 'pt.z': kind=${TypeKindToStr inferredInvalidKind}, errors=${cInfer.errors.ln}`
    if cInfer.errors.ln > 0 {
        lastErr = cInfer.errors[cInfer.errors.ln - 1]
        prnt `    Reported Diagnostic: ${lastErr.code} - ${lastErr.message}`
    }

    // 11.4 Function Call Signature & Parameter Validation (E0308 on arg count mismatch)
    fnAddType = TypeInfo.createFunc TypeKind.Double, "num", ["num", "num"]
    fnAddType.name = "fn_add"
    cInfer.registerType fnAddType
    symFnAdd = Symbol.create "add", TypeKind.Func, "fn_add", false, true, 0, 1, 1
    cInfer.defineSymbol symFnAdd

    addIdent = ASTNode.createIdent "add", 1, 1
    callArgs: ASTNode[] = [numLitNode, floatLitNode]
    validCallNode = ASTNode.createCall addIdent, callArgs, 1, 1
    inferredCallKind = InferExpression cInfer, validCallNode
    prnt `    Inferred Function Call 'add(42, 3.14)': kind=${TypeKindToStr inferredCallKind}`

    singleArg: ASTNode[] = [numLitNode]
    invalidCallNode = ASTNode.createCall addIdent, singleArg, 1, 1
    errsBeforeCall = cInfer.errors.ln
    inferredInvalidCall = InferExpression cInfer, invalidCallNode
    prnt `    Function Call with missing arg 'add(42)': errors logged=${cInfer.errors.ln > errsBeforeCall}`
    if cInfer.errors.ln > errsBeforeCall {
        callErr = cInfer.errors[cInfer.errors.ln - 1]
        prnt `    Reported Diagnostic: ${callErr.code} - ${callErr.message}`
    }

    // 12. Borrow Checker & Reference Aliasing Verification (Phase 3 Task 3.3)
    prnt "12. Borrow Checker & Reference Aliasing Verification:"
    bCheck = BorrowChecker.create "borrow_test.zv", "let x = 10\n&let r = x\n&let r2 = r\nx = 20\n"

    // 12.1 Root variable & borrow reference definition
    bCheck.defineVar "x", false, "", true, 1, 1
    xVar = bCheck.getVar "x"
    prnt `    Defined root variable 'x': isBorrow=${xVar.isBorrow}, activeBorrows=${xVar.activeBorrows}`

    bCheck.defineVar "r", true, "x", false, 2, 1
    bCheck.recordBorrow "x", "r", 2, 1
    xAfterBorrow = bCheck.getVar "x"
    prnt `    Created borrow '&let r = x': 'x' activeBorrows=${xAfterBorrow.activeBorrows}`

    // 12.2 Chained / Transitive reference alias resolution
    bCheck.defineVar "r2", true, "r", false, 3, 1
    bCheck.recordBorrow "r", "r2", 3, 1
    r2Target: str = bCheck.resolveReferenceTarget "r2"
    rTarget: str = bCheck.resolveReferenceTarget "r"
    prnt `    Chained reference alias: 'r' -> '${rTarget}', 'r2' -> '${r2Target}' (transitive: ${r2Target == "x"})`

    // 12.3 Mutation rejection while borrowed (E0204)
    mutationAllowed: bool = bCheck.checkMutation "x", 4, 1
    prnt `    Mutation on borrowed 'x = 20' permitted: ${mutationAllowed}`
    if bCheck.hasErrors {
        lastErr = bCheck.errors[bCheck.errors.ln - 1]
        prnt `    Reported Diagnostic: ${lastErr.code} - ${lastErr.message}`
    }

    // 12.4 Borrow of moved value rejection (E0202)
    bCheck.defineVar "y", false, "", true, 5, 1
    bCheck.markMoved "y", 6, 1
    moveAllowed: bool = bCheck.recordBorrow "y", "ry", 7, 1
    prnt `    Borrowing moved value 'y' permitted: ${moveAllowed}`
    if bCheck.hasErrors {
        lastErr = bCheck.errors[bCheck.errors.ln - 1]
        prnt `    Reported Diagnostic: ${lastErr.code} - ${lastErr.message}`
    }

    // 12.5 Scope lifetime enforcement (E0204)
    // Reference in outer scope cannot borrow value defined in inner scope
    bCheck.defineVar "outerRef", true, "", false, 8, 1
    bCheck.enterScope
    bCheck.defineVar "innerVal", false, "", true, 9, 5
    lifetimeOk: bool = bCheck.recordBorrow "innerVal", "outerRef", 10, 5
    prnt `    Borrow of short-lived 'innerVal' into outer 'outerRef' permitted: ${lifetimeOk}`
    if bCheck.hasErrors {
        lastErr = bCheck.errors[bCheck.errors.ln - 1]
        prnt `    Reported Diagnostic: ${lastErr.code} - ${lastErr.message}`
    }
    bCheck.exitScope

    // 12.6 Scope exit borrow release
    bCheckScope = BorrowChecker.create "scope_release_test.zv", "let a = 100\n{\n    &let refA = a\n}\na = 200\n"
    bCheckScope.defineVar "a", false, "", true, 1, 1
    bCheckScope.enterScope
    bCheckScope.defineVar "refA", true, "a", false, 3, 5
    bCheckScope.recordBorrow "a", "refA", 3, 5
    aDuringScope = bCheckScope.getVar "a"
    prnt `    'a' activeBorrows inside scope: ${aDuringScope.activeBorrows}`
    bCheckScope.exitScope
    aAfterScope = bCheckScope.getVar "a"
    prnt `    'a' activeBorrows after scope exit: ${aAfterScope.activeBorrows}`
    canMutateAfterExit: bool = bCheckScope.checkMutation "a", 5, 1
    prnt `    Mutation 'a = 200' after inner scope ended permitted: ${canMutateAfterExit}`
}






