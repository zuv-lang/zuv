/*
 * =============================================================================
 * Zuv Bootstrap Compiler — Main Entry Point
 * Path: sub_projects/zuv/src/bootstrap/main.zv
 * =============================================================================
 *
 * Direct entrypoint for the Zuv Bootstrap Compiler (`zuv_bootstrap.exe`).
 * Instantiates the CLI coordinator (`Cli`) with system arguments (`os.args`),
 * executes the appropriate compiler subcommand, and returns the exit status.
 */

imp os
imp Cli frm cli

main {
    cli: Cli = Cli.create os.args
    exitCode: num = cli.run
    if exitCode != 0 {
        -> exitCode
    }
}
