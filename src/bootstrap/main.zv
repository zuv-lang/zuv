/*
 * =============================================================================
 * Zuv Bootstrap Compiler — Main Entry Point
 * Path: sub_projects/zuv/src/bootstrap/main.zv
 * =============================================================================
 */

imp os, fs, str, arr
imp Token, TokenType frm tokens
imp TypeInfo, TypeKind, TypeKindToStr, AreTypesCompatible, StrToTypeKind frm types
imp ASTNode, NodeKind frm ast
imp Diagnostic frm diagnostics

imp Lexer frm lexer
imp Parser frm parser/parser
imp ParseDeclaration frm parser/decl

main {
    prnt "=== Zuv Bootstrap Compiler v0.6.0 (Phase 1 & Phase 2 Foundations) ==="

    // 1. Token Verification via Token.create and instance methods
    let tok = Token.create TokenType.TOK_LET, "let", 1, 1, 3
    let tokName: str = tok.toString
    prnt `1. Token kind: ${tokName}`
    if tok.isKeyword {
        prnt "   Token keyword check: OK"
    }

    // 2. Type System Verification via TypeInfo factories and helpers
    let tDbl: TypeKind = TypeKind.Double
    let tI32: TypeKind = TypeKind.I32
    let dblType = TypeInfo.createPrimitive tDbl, "double"
    prnt `2. Type kind: ${dblType.toString} (isNumeric: ${dblType.isNumeric})`
    let compat: bool = AreTypesCompatible tDbl, tI32
    if compat {
        prnt "   Type compatibility: i32 -> double OK"
    }
    let parsedKind = StrToTypeKind "i64"
    let ptrType = TypeInfo.createPointer parsedKind, "i64"
    prnt `   Pointer type: ${ptrType.toString} (isPointer: ${ptrType.isPointer})`
    let fnParams: str[] = ["num", "num"]
    let fnType = TypeInfo.createFunc TypeKind.Double, "num", fnParams
    prnt `   Function type: ${fnType.toString}`

    // 3. AST Verification via ASTNode factories and methods
    let numNode = ASTNode.createNum 42, 1, 5
    let nodeName: str = numNode.toString
    let nodeTyp: str = TypeKindToStr numNode.inferredType
    prnt `3. AST Node: ${nodeName} (inferred: ${nodeTyp}, val: ${numNode.numVal})`

    let num10 = ASTNode.createNum 10, 1, 10
    let binNode = ASTNode.createBinary "+", numNode, num10, 1, 8
    prnt `   AST Binary: ${binNode.toString} (op: '${binNode.op}', isExpr: ${binNode.isExpr})`

    let varNode = ASTNode.createVarDecl "total", "num", false, binNode, 1, 1
    prnt `   AST VarDecl: ${varNode.toString} (name: '${varNode.name}', isDecl: ${varNode.isDecl})`

    let condNode = ASTNode.createBool true, 2, 5
    let thenBlock = ASTNode.createBlock [], 2, 12
    let elseBlock = ASTNode.createNil 2, 20
    let ifNode = ASTNode.createIf condNode, thenBlock, elseBlock, 2, 1
    prnt `   AST IfStmt: ${ifNode.toString} (isStmt: ${ifNode.isStmt})`

    // 4. Diagnostics Verification via Diagnostic.create and diag.format
    let diag = Diagnostic.create "E0102", "Expected next token to be {, got IDENTIFIER instead", "example.zv", 2, 11, 1, "add '{' here"
    let mockSource: str = "fn square x {\n    -> x * x\n}"
    let formatted: str = diag.format mockSource
    prnt "4. Formatted Diagnostic:"
    prnt formatted

    // 5. Lexer Verification (Phase 2 Task 2.1)
    prnt "5. Lexer Verification:"
    let sampleCode: str = "let x = 0xFF\n&let ref = x\n// comment\nprnt r\"raw\\nstr\"\nfr i = 0; i < 5; i++ {\n    -> `val: ${i}`\n}"
    let lex = Lexer.create sampleCode
    let scannedTokens: Token[] = lex.tokenizeAll
    let count: num = scannedTokens.ln
    prnt `   Tokenized ${count} tokens successfully`
    let i: num = 0
    wh i < count {
        let t: Token = scannedTokens[i]
        prnt `   Token ${i}: ${t.toString} ('${t.val}')`
        i = i + 1
    }

    // 6. Parser Coordinator Verification (Phase 2 Task 2.2)
    prnt "6. Parser Coordinator Verification:"
    let parser = Parser.create scannedTokens, "test.zv", sampleCode
    let curTok: Token = parser.cur
    prnt `   Parser initial cur: ${curTok.toString} ('${curTok.val}')`
    let peekTok: Token = parser.peek
    prnt `   Parser peek: ${peekTok.toString} ('${peekTok.val}')`
    let peek2Tok: Token = parser.peekAhead 2
    prnt `   Parser peekAhead(2): ${peek2Tok.toString} ('${peek2Tok.val}')`
    let matchedLet: bool = parser.matchToken TokenType.TOK_LET
    prnt `   Parser matched 'let': ${matchedLet}`
    let curAfterMatch: Token = parser.cur
    prnt `   Parser cur after match: ${curAfterMatch.toString} ('${curAfterMatch.val}')`
    let consumedIdent: Token = parser.consume TokenType.TOK_IDENT, "Expected identifier"
    prnt `   Parser consumed ident: '${consumedIdent.val}'`
    let isEnd: bool = parser.isAtEnd
    prnt `   Parser isAtEnd: ${isEnd}`

    // 7. Declaration Parser Verification (Phase 2 Task 2.3)
    prnt "7. Declaration Parser Verification:"
    let typeDeclCode: str = "type Point = { x: num, y: num }"
    let lexType = Lexer.create typeDeclCode
    let pType = Parser.create lexType.tokenizeAll, "type.zv", typeDeclCode
    let astType: ASTNode = ParseDeclaration pType
    prnt `   Parsed TypeDecl: '${astType.name}', fields count: ${astType.fields.ln}`

    let objDeclCode: str = "obj User { name: str, age: num }"
    let lexObj = Lexer.create objDeclCode
    let pObj = Parser.create lexObj.tokenizeAll, "obj.zv", objDeclCode
    let astObj: ASTNode = ParseDeclaration pObj
    prnt `   Parsed ObjDecl: '${astObj.name}', fields count: ${astObj.fields.ln}`

    let fnDeclCode: str = "pub fn add a: num, b: num :: num"
    let lexFn = Lexer.create fnDeclCode
    let pFn = Parser.create lexFn.tokenizeAll, "fn.zv", fnDeclCode
    let astFn: ASTNode = ParseDeclaration pFn
    prnt `   Parsed FuncDecl: '${astFn.name}', params count: ${astFn.params.ln}, ret: '${astFn.typeAnnotation}', pub: ${astFn.isPub}`

    let enumDeclCode: str = "enum Color { Red, Green, Blue = 10 }"
    let lexEnum = Lexer.create enumDeclCode
    let pEnum = Parser.create lexEnum.tokenizeAll, "enum.zv", enumDeclCode
    let astEnum: ASTNode = ParseDeclaration pEnum
    prnt `   Parsed EnumDecl: '${astEnum.name}', variants count: ${astEnum.fields.ln}`

    let impDeclCode: str = "imp Token, TokenType frm ../tokens"
    let lexImp = Lexer.create impDeclCode
    let pImp = Parser.create lexImp.tokenizeAll, "imp.zv", impDeclCode
    let astImp: ASTNode = ParseDeclaration pImp
    prnt `   Parsed ImportDecl: path: '${astImp.val}', symbols count: ${astImp.fields.ln}`
}




