/*
 * =============================================================================
 * Zuv Bootstrap Compiler — Type Lowering & LLVM Type Code Generation
 * Path: sub_projects/zuv/src/bootstrap/codegen/types.zv
 *
 * Implements direct semantic TypeKind to LLVM IR type mapping and zero
 * name-guessing instruction selection directly from AST inferred types.
 * =============================================================================
 */

imp str, arr
imp TypeKind frm ../types
imp ASTNode frm ../ast

/**
 * Maps a semantic TypeKind directly to its canonical LLVM IR type string representation.
 *
 * @param {TypeKind} typeKind - Semantic type kind
 * @returns {str} LLVM IR type ("void", "i1", "i8", "i16", "i32", "i64", "double", "ptr")
 */
llvmType typeKind: TypeKind :: str => sw typeKind {
    TypeKind.Void => "void"
    TypeKind.Bool => "i1"
    TypeKind.I8   => "i8"
    TypeKind.U8   => "i8"
    TypeKind.I16  => "i16"
    TypeKind.U16  => "i16"
    TypeKind.I32  => "i32"
    TypeKind.U32  => "i32"
    TypeKind.I64  => "i64"
    TypeKind.U64  => "i64"
    TypeKind.I128 => "i128"
    TypeKind.U128 => "i128"
    TypeKind.F32  => "float"
    TypeKind.Num  => "double"
    TypeKind.Str  => "ptr"
    TypeKind.Ptr  => "ptr"
    TypeKind.Arr  => "ptr"
    TypeKind.Obj  => "ptr"
    TypeKind.Func => "ptr"
    TypeKind.Und  => "i64"
    TypeKind.Nil  => "i64"
    _             => "i64"
}

/**
 * Maps a TypeKind to its 64-bit runtime boxed representation in Zuv ABI.
 *
 * @param {TypeKind} typeKind - Semantic type kind
 * @returns {str} LLVM IR boxed type ("double" or "i64")
 */
llvmBoxedType typeKind: TypeKind :: str {
    if typeKind == TypeKind.Num {
        -> "double"
    }
    -> "i64"
}

/**
 * Maps a TypeKind to its stack allocation (alloca) type representation.
 *
 * @param {TypeKind} typeKind - Semantic type kind
 * @returns {str} LLVM IR stack allocation type
 */
llvmStackType typeKind: TypeKind :: str => sw typeKind {
    TypeKind.Num  => "double"
    TypeKind.F32  => "float"
    TypeKind.Bool => "i1"
    TypeKind.I8   => "i8"
    TypeKind.U8   => "i8"
    TypeKind.I16  => "i16"
    TypeKind.U16  => "i16"
    TypeKind.I32  => "i32"
    TypeKind.U32  => "i32"
    TypeKind.I64  => "i64"
    TypeKind.U64  => "i64"
    TypeKind.I128 => "i128"
    TypeKind.U128 => "i128"
    TypeKind.Void => "void"
    TypeKind.Str  => "ptr"
    TypeKind.Ptr  => "ptr"
    TypeKind.Arr  => "ptr"
    TypeKind.Obj  => "ptr"
    TypeKind.Func => "ptr"
    _             => "i64"
}

/**
 * Determines whether a TypeKind represents an integer or integral scalar.
 *
 * @param {TypeKind} typeKind - Semantic type kind
 * @returns {bool} True if integral scalar
 */
isIntegerType typeKind: TypeKind :: bool => sw typeKind {
    TypeKind.I8   => true
    TypeKind.U8   => true
    TypeKind.I16  => true
    TypeKind.U16  => true
    TypeKind.I32  => true
    TypeKind.U32  => true
    TypeKind.I64  => true
    TypeKind.U64  => true
    TypeKind.I128 => true
    TypeKind.U128 => true
    TypeKind.Bool => true
    _             => false
}

/**
 * Determines whether a TypeKind represents a floating point number.
 *
 * @param {TypeKind} typeKind - Semantic type kind
 * @returns {bool} True if floating point
 */
isFloatType typeKind: TypeKind :: bool {
    if typeKind == TypeKind.Num || typeKind == TypeKind.F32 {
        -> true
    }
    -> false
}

/**
 * Determines whether a TypeKind represents an unsigned integer type.
 *
 * @param {TypeKind} typeKind - Semantic type kind
 * @returns {bool} True if unsigned integer or boolean
 */
isUnsignedType typeKind: TypeKind :: bool => sw typeKind {
    TypeKind.Bool => true
    TypeKind.U8   => true
    TypeKind.U16  => true
    TypeKind.U32  => true
    TypeKind.U64  => true
    TypeKind.U128 => true
    _             => false
}

/**
 * Returns the bit width of a scalar integer or floating point type.
 *
 * @param {TypeKind} typeKind - Semantic type kind
 * @returns {num} Bit width in bits (1, 8, 16, 32, 64, 128)
 */
typeBitWidth typeKind: TypeKind :: num => sw typeKind {
    TypeKind.Bool => 1
    TypeKind.I8   => 8
    TypeKind.U8   => 8
    TypeKind.I16  => 16
    TypeKind.U16  => 16
    TypeKind.I32  => 32
    TypeKind.U32  => 32
    TypeKind.I64  => 64
    TypeKind.U64  => 64
    TypeKind.I128 => 128
    TypeKind.U128 => 128
    TypeKind.F32  => 32
    TypeKind.Num  => 64
    _             => 64
}

/**
 * Determines whether a TypeKind represents a pointer or heap object reference.
 *
 * @param {TypeKind} typeKind - Semantic type kind
 * @returns {bool} True if reference or pointer type
 */
isPointerType typeKind: TypeKind :: bool => sw typeKind {
    TypeKind.Str  => true
    TypeKind.Ptr  => true
    TypeKind.Arr  => true
    TypeKind.Obj  => true
    TypeKind.Func => true
    _             => false
}

/**
 * Selects the default zero or null literal representation for a given TypeKind.
 *
 * @param {TypeKind} typeKind - Semantic type kind
 * @returns {str} LLVM literal string ("0.0", "false", "0", "null", or "")
 */
selectDefaultValue typeKind: TypeKind :: str => sw typeKind {
    TypeKind.Num  => "0.0"
    TypeKind.F32  => "0.0"
    TypeKind.Bool => "false"
    TypeKind.I8   => "0"
    TypeKind.U8   => "0"
    TypeKind.I16  => "0"
    TypeKind.U16  => "0"
    TypeKind.I32  => "0"
    TypeKind.U32  => "0"
    TypeKind.I64  => "0"
    TypeKind.U64  => "0"
    TypeKind.I128 => "0"
    TypeKind.U128 => "0"
    TypeKind.Und  => "0"
    TypeKind.Nil  => "0"
    TypeKind.Str  => "null"
    TypeKind.Ptr  => "null"
    TypeKind.Arr  => "null"
    TypeKind.Obj  => "null"
    TypeKind.Func => "null"
    _             => ""
}

/**
 * Selects the optimal LLVM IR binary arithmetic or bitwise instruction based purely on type.
 *
 * Employs zero name-guessing by selecting instruction variants exclusively from TypeKind.
 *
 * @param {str} op - Source operator symbol ("+", "-", "*", "/", "%", "&", "|", "^", "<<", ">>", ">>>")
 * @param {TypeKind} typeKind - Operand type kind
 * @returns {str} LLVM IR instruction mnemonic ("fadd", "add", "fsub", "sub", "sdiv", "and", etc.)
 */
selectBinaryOp op: str, typeKind: TypeKind :: str {
    if isFloatType typeKind {
        -> sw op {
            "+"  => "fadd"
            "-"  => "fsub"
            "*"  => "fmul"
            "/"  => "fdiv"
            "%"  => "frem"
            "**" => "pow"
            _    => "fadd"
        }
    }
    if typeKind == TypeKind.Str && op == "+" {
        -> "concat"
    }
    isUnsigned: bool = isUnsignedType typeKind
    if isUnsigned {
        -> sw op {
            "+"   => "add"
            "-"   => "sub"
            "*"   => "mul"
            "/"   => "udiv"
            "%"   => "urem"
            "&"   => "and"
            "|"   => "or"
            "^"   => "xor"
            "<<"  => "shl"
            ">>"  => "lshr"
            ">>>" => "lshr"
            _     => "add"
        }
    }
    -> sw op {
        "+"   => "add"
        "-"   => "sub"
        "*"   => "mul"
        "/"   => "sdiv"
        "%"   => "srem"
        "&"   => "and"
        "|"   => "or"
        "^"   => "xor"
        "<<"  => "shl"
        ">>"  => "ashr"
        ">>>" => "lshr"
        _     => "add"
    }
}

/**
 * Selects the optimal LLVM IR comparison instruction and predicate based on type.
 *
 * @param {str} op - Comparison operator ("==", "!=", "<", "<=", ">", ">=")
 * @param {TypeKind} typeKind - Operand type kind
 * @returns {str} LLVM comparison instruction with predicate ("fcmp olt", "icmp slt", etc.)
 */
selectCmpOp op: str, typeKind: TypeKind :: str {
    if isFloatType typeKind {
        -> sw op {
            "==" => "fcmp oeq"
            "!=" => "fcmp one"
            "<"  => "fcmp olt"
            "<=" => "fcmp ole"
            ">"  => "fcmp ogt"
            ">=" => "fcmp oge"
            _    => "fcmp oeq"
        }
    }
    if typeKind == TypeKind.Str {
        -> sw op {
            "==" => "icmp eq"
            "!=" => "icmp ne"
            _    => "icmp eq"
        }
    }
    if isUnsignedType typeKind {
        -> sw op {
            "==" => "icmp eq"
            "!=" => "icmp ne"
            "<"  => "icmp ult"
            "<=" => "icmp ule"
            ">"  => "icmp ugt"
            ">=" => "icmp uge"
            _    => "icmp eq"
        }
    }
    -> sw op {
        "==" => "icmp eq"
        "!=" => "icmp ne"
        "<"  => "icmp slt"
        "<=" => "icmp sle"
        ">"  => "icmp sgt"
        ">=" => "icmp sge"
        _    => "icmp eq"
    }
}

/**
 * Selects the optimal LLVM type conversion instruction between two semantic TypeKinds.
 *
 * @param {TypeKind} fromKind - Origin type kind
 * @param {TypeKind} toKind - Destination type kind
 * @returns {str} LLVM instruction mnemonic ("fptosi", "sitofp", "zext", "sext", "trunc", "ptrtoint", "inttoptr", "bitcast", or "")
 */
selectCastOp fromKind: TypeKind, toKind: TypeKind :: str {
    if fromKind == toKind {
        -> ""
    }
    fromFloat: bool = isFloatType fromKind
    toFloat: bool = isFloatType toKind
    fromInt: bool = isIntegerType fromKind
    toInt: bool = isIntegerType toKind

    if fromFloat && toFloat {
        fromW: num = typeBitWidth fromKind
        toW: num = typeBitWidth toKind
        if toW > fromW {
            -> "fpext"
        }
        if toW < fromW {
            -> "fptrunc"
        }
        -> ""
    }

    if fromFloat && toInt {
        if isUnsignedType toKind {
            -> "fptoui"
        }
        -> "fptosi"
    }

    if fromInt && toFloat {
        if isUnsignedType fromKind {
            -> "uitofp"
        }
        -> "sitofp"
    }

    if fromInt && toInt {
        fromW: num = typeBitWidth fromKind
        toW: num = typeBitWidth toKind
        if toW > fromW {
            if isUnsignedType fromKind {
                -> "zext"
            }
            -> "sext"
        }
        if toW < fromW {
            -> "trunc"
        }
        -> ""
    }

    if (isPointerType fromKind) && toInt {
        -> "ptrtoint"
    }
    if fromInt && (isPointerType toKind) {
        -> "inttoptr"
    }
    if (isPointerType fromKind) && (isPointerType toKind) {
        -> "bitcast"
    }

    -> ""
}

/**
 * Selects a binary instruction directly from an AST expression node's inferred type.
 *
 * @param {str} op - Arithmetic or bitwise operator
 * @param {ASTNode} expr - AST expression node
 * @returns {str} LLVM binary instruction mnemonic
 */
selectBinaryOpForExpr op: str, expr: ASTNode :: str {
    -> selectBinaryOp op, expr.inferredType
}

/**
 * Selects a comparison instruction directly from an AST expression node's inferred type.
 *
 * @param {str} op - Comparison operator
 * @param {ASTNode} expr - AST expression node
 * @returns {str} LLVM comparison instruction mnemonic with predicate
 */
selectCmpOpForExpr op: str, expr: ASTNode :: str {
    -> selectCmpOp op, expr.inferredType
}

/**
 * Selects a cast instruction directly from an AST expression node's inferred type.
 *
 * @param {ASTNode} expr - AST expression node
 * @param {TypeKind} toKind - Target type kind
 * @returns {str} LLVM cast instruction mnemonic
 */
selectCastOpForExpr expr: ASTNode, toKind: TypeKind :: str {
    -> selectCastOp expr.inferredType, toKind
}

/**
 * Formats a complete LLVM IR binary instruction statement.
 *
 * @param {str} op - Operator symbol
 * @param {str} leftReg - Left operand SSA register
 * @param {str} rightReg - Right operand SSA register
 * @param {TypeKind} typeKind - Operand type kind
 * @param {str} resReg - Destination SSA register
 * @returns {str} Formatted instruction (e.g. "%r2 = fadd double %r0, %r1")
 */
emitBinaryInstruction op: str, leftReg: str, rightReg: str, typeKind: TypeKind, resReg: str :: str {
    instr = selectBinaryOp op, typeKind
    typeName = llvmType typeKind
    -> resReg + " = " + instr + " " + typeName + " " + leftReg + ", " + rightReg
}

/**
 * Formats a complete LLVM IR comparison instruction statement.
 *
 * @param {str} op - Comparison operator symbol
 * @param {str} leftReg - Left operand SSA register
 * @param {str} rightReg - Right operand SSA register
 * @param {TypeKind} typeKind - Operand type kind
 * @param {str} resReg - Destination SSA register
 * @returns {str} Formatted instruction (e.g. "%r2 = fcmp olt double %r0, %r1")
 */
emitCmpInstruction op: str, leftReg: str, rightReg: str, typeKind: TypeKind, resReg: str :: str {
    instr = selectCmpOp op, typeKind
    typeName = llvmType typeKind
    -> resReg + " = " + instr + " " + typeName + " " + leftReg + ", " + rightReg
}

/**
 * Formats a complete LLVM IR type cast or conversion instruction statement.
 *
 * @param {str} valReg - Source SSA register
 * @param {TypeKind} fromKind - Source type kind
 * @param {TypeKind} toKind - Destination type kind
 * @param {str} resReg - Destination SSA register
 * @returns {str} Formatted instruction (e.g. "%res = zext i8 %val to i64")
 */
emitCastInstruction valReg: str, fromKind: TypeKind, toKind: TypeKind, resReg: str :: str {
    castOp = selectCastOp fromKind, toKind
    fromType = llvmType fromKind
    toType = llvmType toKind
    if castOp.ln == 0 {
        -> resReg + " = bitcast " + fromType + " " + valReg + " to " + toType
    }
    -> resReg + " = " + castOp + " " + fromType + " " + valReg + " to " + toType
}
