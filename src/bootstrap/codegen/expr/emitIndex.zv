/*
 * =============================================================================
 * Zuv Bootstrap Compiler — EmitIndex Expression Emitter
 * Path: sub_projects/zuv/src/bootstrap/codegen/expr/emitIndex.zv
 * =============================================================================
 */

imp TypeKind frm ../../types
imp ASTNode, NodeKind frm ../../ast
imp isPointerType, isFloatType frm ../types
imp unboxValueFromI64 frm ../array
imp StrToElemTypeKind, resolveFieldTypeKind frm ../decl
imp ExprCodegen, ExprResult frm ../expr

EmitIndex self: ExprCodegen, node: ASTNode :: ExprResult {
    targetNode: ASTNode = node.children[0]
    idxNode: ASTNode = node.children[1]
    targetRes: ExprResult = self.emitExpr targetNode
    idxRes: ExprResult = self.emitExpr idxNode

    idxReg: str = idxRes.reg
    if idxRes.typeKind == TypeKind.Num {
        cReg: str = self.codegen.newReg
        self.codegen.emit `${cReg} = fptosi double ${idxRes.reg} to i64`
        idxReg = cReg
    } els if idxRes.typeKind == TypeKind.I32 {
        cReg: str = self.codegen.newReg
        self.codegen.emit `${cReg} = sext i32 ${idxRes.reg} to i64`
        idxReg = cReg
    }

    if targetRes.typeKind == TypeKind.Str {
        charPtrReg: str = self.codegen.newReg
        self.codegen.emit `${charPtrReg} = getelementptr inbounds i8, ptr ${targetRes.reg}, i64 ${idxReg}`
        charValReg: str = self.codegen.newReg
        self.codegen.emit `${charValReg} = load i8, ptr ${charPtrReg}`
        bufReg: str = self.codegen.newReg
        self.codegen.emit `${bufReg} = call ptr @malloc(i64 2)`
        self.codegen.emit `store i8 ${charValReg}, ptr ${bufReg}`
        termPtrReg: str = self.codegen.newReg
        self.codegen.emit `${termPtrReg} = getelementptr inbounds i8, ptr ${bufReg}, i64 1`
        self.codegen.emit `store i8 0, ptr ${termPtrReg}`
        res: ExprResult = { reg: bufReg, typeKind: TypeKind.Str }
        -> res
    }

    arrPtrReg: str = targetRes.reg
    if isFloatType targetRes.typeKind {
        convReg: str = self.codegen.newReg
        self.codegen.emit `${convReg} = fptosi double ${targetRes.reg} to i64`
        arrPtrReg = convReg
    }
    if !(isPointerType targetRes.typeKind) {
        convReg: str = self.codegen.newReg
        self.codegen.emit `${convReg} = inttoptr i64 ${arrPtrReg} to ptr`
        arrPtrReg = convReg
    }
    isOpt: bool = (node.op == "?.")
    elemVal: str = self.arrGen.emitGetElement arrPtrReg, idxReg, isOpt, node.line
    targetKind = node.inferredType
    if targetKind == TypeKind.Num {
        targetKind = TypeKind.I64
    }
    if targetKind == TypeKind.Unknown || targetKind == TypeKind.I64 {
        targetNode: ASTNode = node.children[0]
        if targetNode.kind == NodeKind.PropExpr {
            propName: str = targetNode.name
            parentObj: ASTNode = targetNode.children[0]
            parentName: str = (parentObj.kind == NodeKind.PropExpr || parentObj.kind == NodeKind.IdentExpr) ? parentObj.name : ""
            fDesc: StructField = createStructField "", -1, TypeKind.Unknown, ""
            if parentName.ln > 0 {
                fr l of self.objGen.registry.layouts {
                    if (l.typeName == parentName || (l.typeName.cnt parentName)) && l.hasField propName {
                        fDesc = l.getField propName
                        brk
                    }
                }
            }
            if fDesc.name.ln == 0 {
                fDesc = self.objGen.registry.getFieldField "", propName
            }
            if fDesc.name.ln > 0 && fDesc.typeName.ln > 0 {
                resolvedType: str = self.objGen.registry.resolveAlias fDesc.typeName
                elemKind: TypeKind = StrToElemTypeKind resolvedType
                if elemKind != TypeKind.Unknown {
                    if elemKind == TypeKind.Num {
                        targetKind = TypeKind.I64
                    } els {
                        targetKind = elemKind
                    }
                }
            }
        } els if targetNode.kind == NodeKind.IdentExpr {
            targetSym = self.findSymbol targetNode.name
            if targetSym.name.ln > 0 && targetSym.typeName.ln > 0 {
                resolvedType: str = self.objGen.registry.resolveAlias targetSym.typeName
                elemKind: TypeKind = StrToElemTypeKind resolvedType
                if elemKind != TypeKind.Unknown {
                    if elemKind == TypeKind.Num {
                        targetKind = TypeKind.I64
                    } els {
                        targetKind = elemKind
                    }
                }
            }
        } els if targetNode.kind == NodeKind.IndexExpr && targetNode.children.ln >= 2 {
            baseNode: ASTNode = targetNode.children[0]
            rowNode: ASTNode = targetNode.children[1]
            rowVal: str = rowNode.val
            baseTypeName: str = ""
            if baseNode.kind == NodeKind.IdentExpr {
                baseSym: ScopeSymbol = self.findSymbol baseNode.name
                if baseSym.name.ln > 0 && baseSym.typeName.ln > 0 {
                    resolvedSymType: str = self.objGen.registry.resolveAlias baseSym.typeName
                    if (resolvedSymType.sub 0, 1) == "[" && (resolvedSymType.sub resolvedSymType.ln - 1, 1) == "]" {
                        baseTypeName = resolvedSymType
                    }
                }
            }
            if baseTypeName.ln == 0 {
                baseTypeName = targetNode.typeAnnotation
            }
            if baseTypeName.ln == 0 && baseNode.kind == NodeKind.IdentExpr {
                baseSym2: ScopeSymbol = self.findSymbol baseNode.name
                if baseSym2.name.ln > 0 && baseSym2.typeName.ln > 0 {
                    baseTypeName = self.objGen.registry.resolveAlias baseSym2.typeName
                }
            }
            if baseTypeName.ln >= 2 {
                if (baseTypeName.sub 0, 1) == "[" && (baseTypeName.sub baseTypeName.ln - 1, 1) == "]" && rowVal.ln > 0 {
                    rowIdx: num = 0
                    fr i = 0; i < rowVal.ln; i++ {
                        c: str = rowVal.sub i, 1
                        d: num = c == "0" ? 0 : (c == "1" ? 1 : (c == "2" ? 2 : (c == "3" ? 3 : (c == "4" ? 4 : (c == "5" ? 5 : (c == "6" ? 6 : (c == "7" ? 7 : (c == "8" ? 8 : (c == "9" ? 9 : -1)))))))))
                        if d >= 0 {
                            rowIdx = rowIdx * 10 + d
                        }
                    }
                    innerContent: str = baseTypeName.sub 1, baseTypeName.ln - 2
                    curPart: str = ""
                    pIdx: num = 0
                    bracketDepth: num = 0
                    fr i = 0; i < innerContent.ln; i++ {
                        ch: str = innerContent.sub i, 1
                        if ch == "[" {
                            bracketDepth = bracketDepth + 1
                            curPart = curPart + ch
                        } els if ch == "]" {
                            bracketDepth = bracketDepth - 1
                            curPart = curPart + ch
                        } els if ch == "," && bracketDepth == 0 {
                            if pIdx == rowIdx {
                                brk
                            }
                            curPart = ""
                            pIdx = pIdx + 1
                        } els if ch != " " || curPart.ln > 0 {
                            curPart = curPart + ch
                        }
                    }
                    if curPart.ln > 0 {
                        rowElemKind: TypeKind = StrToElemTypeKind curPart
                        if rowElemKind == TypeKind.Unknown {
                            rowElemKind = resolveFieldTypeKind curPart
                        }
                        if rowElemKind != TypeKind.Unknown {
                            if rowElemKind == TypeKind.Num {
                                targetKind = TypeKind.I64
                            } els {
                                targetKind = rowElemKind
                            }
                        }
                    }
                }
                if targetKind == TypeKind.Unknown || targetKind == TypeKind.I64 {
                    if (baseTypeName.sub baseTypeName.ln - 2, 2) == "[]" {
                        innerType: str = baseTypeName.sub 0, baseTypeName.ln - 2
                        elemKind: TypeKind = StrToElemTypeKind innerType
                        if elemKind == TypeKind.Unknown {
                            elemKind = resolveFieldTypeKind innerType
                        }
                        if elemKind != TypeKind.Unknown {
                            if elemKind == TypeKind.Num {
                                targetKind = TypeKind.I64
                            } els {
                                targetKind = elemKind
                            }
                        }
                    }
                }
            }
        }
    }
    if targetKind == TypeKind.Unknown {
        targetKind = TypeKind.I64
    }
    unboxedVal: str = unboxValueFromI64 self.codegen, elemVal, targetKind
    res: ExprResult = { reg: unboxedVal, typeKind: targetKind }
    -> res
}
