/*
 * =============================================================================
 * Zuv Bootstrap Compiler — EmitBinary Expression Emitter
 * Path: sub_projects/zuv/src/bootstrap/codegen/expr/emitBinary.zv
 * =============================================================================
 */

imp TypeKind, IsNumericType frm ../../types
imp ASTNode, NodeKind frm ../../ast
imp llvmType, llvmStackType, isPointerType, isFloatType, selectBinaryOp, selectCmpOp, selectCastOp frm ../types
imp ExprCodegen, ExprResult frm ../expr

EmitBinary self: ExprCodegen, node: ASTNode :: ExprResult {
    op: str = node.op

    isCompound: bool = (op == "+=" || op == "-=" || op == "*=" || op == "/=" || op == "%=" ||
                        op == "**=" || op == "&=" || op == "|=" || op == "^=")
    if op == "=" || isCompound {
        targetNode: ASTNode = node.children[0]
        valNode: ASTNode = node.children[1]
        rightRes: ExprResult = { reg: "", typeKind: TypeKind.Unknown }

        if isCompound {
            baseOp: str = op.sub 0, op.ln - 1
            binNode: ASTNode = ASTNode.createBinary baseOp, targetNode, valNode, node.line, node.col
            rightRes = self.emitBinary binNode
        } els {
            rightRes = self.emitExpr valNode
        }
        if targetNode.kind == NodeKind.IdentExpr {
            foundSym = self.findSymbol targetNode.name
            if foundSym.isAlloca {
                stType: str = llvmStackType foundSym.typeKind
                storeVal: str = rightRes.reg
                fromLLVM: str = llvmType rightRes.typeKind
                if fromLLVM != stType && rightRes.typeKind != TypeKind.Unknown {
                    castOp: str = selectCastOp rightRes.typeKind, foundSym.typeKind
                    if castOp.ln > 0 {
                        convReg: str = self.codegen.newReg
                        self.codegen.emit `${convReg} = ${castOp} ${fromLLVM} ${rightRes.reg} to ${stType}`
                        storeVal = convReg
                    } els if (isPointerType rightRes.typeKind) && (isPointerType foundSym.typeKind) {
                        convReg: str = self.codegen.newReg
                        self.codegen.emit `${convReg} = bitcast ${fromLLVM} ${rightRes.reg} to ${stType}`
                        storeVal = convReg
                    }
                }
                self.codegen.emit `store ${stType} ${storeVal}, ptr ${foundSym.reg}`
            }
        } els if targetNode.kind == NodeKind.IndexExpr {
            arrNode: ASTNode = targetNode.children[0]
            idxNode: ASTNode = targetNode.children[1]
            arrRes: ExprResult = self.emitExpr arrNode
            idxRes: ExprResult = self.emitExpr idxNode
            idxReg: str = idxRes.reg
            if idxRes.typeKind == TypeKind.Num {
                convIdx: str = self.codegen.newReg
                self.codegen.emit `${convIdx} = fptosi double ${idxRes.reg} to i64`
                idxReg = convIdx
            } els if idxRes.typeKind == TypeKind.I32 {
                convIdx: str = self.codegen.newReg
                self.codegen.emit `${convIdx} = sext i32 ${idxRes.reg} to i64`
                idxReg = convIdx
            }
            arrPtrReg: str = arrRes.reg
            if isFloatType arrRes.typeKind {
                convReg: str = self.codegen.newReg
                self.codegen.emit `${convReg} = fptosi double ${arrRes.reg} to i64`
                arrPtrReg = convReg
            }
            if !(isPointerType arrRes.typeKind) {
                convReg: str = self.codegen.newReg
                self.codegen.emit `${convReg} = inttoptr i64 ${arrPtrReg} to ptr`
                arrPtrReg = convReg
            }
            self.arrGen.emitSetElement arrPtrReg, idxReg, rightRes.reg, rightRes.typeKind, node.line
        } els if targetNode.kind == NodeKind.PropExpr {
            objNode: ASTNode = targetNode.children[0]
            propName: str = targetNode.name
            objRes: ExprResult = self.emitExpr objNode
            objPtrReg: str = objRes.reg
            if !(isPointerType objRes.typeKind) {
                convReg: str = self.codegen.newReg
                self.codegen.emit `${convReg} = inttoptr i64 ${objRes.reg} to ptr`
                objPtrReg = convReg
            }
            objTypeName: str = objNode.typeAnnotation
            if objTypeName.ln == 0 && objNode.kind == NodeKind.IdentExpr {
                targetSym = self.findSymbol objNode.name
                if targetSym.name.ln > 0 && targetSym.typeName.ln > 0 {
                    objTypeName = targetSym.typeName
                }
            }
            if objTypeName.ln == 0 || !(self.objGen.registry.hasType objTypeName) {
                fr l of self.objGen.registry.layouts {
                    if l.hasField propName {
                        objTypeName = l.typeName
                        brk
                    }
                }
            }
            if objTypeName.ln == 0 || !(self.objGen.registry.hasType objTypeName) {
                self.objGen.registry.setDynamicFieldType propName, rightRes.typeKind
            }
            off: num = self.objGen.registry.getFieldOffset objTypeName, propName
            if off < 0 {
                off = 0
            }
            fldType: TypeKind = self.objGen.registry.getFieldType objTypeName, propName
            setValReg: str = rightRes.reg
            setValType: TypeKind = rightRes.typeKind
            if fldType == TypeKind.Num && setValType != TypeKind.Num {
                convFlt: str = self.codegen.newReg
                self.codegen.emit `${convFlt} = sitofp i64 ${setValReg} to double`
                setValReg = convFlt
                setValType = TypeKind.Num
            } els if fldType == TypeKind.I64 && setValType == TypeKind.Num {
                convInt: str = self.codegen.newReg
                self.codegen.emit `${convInt} = fptosi double ${setValReg} to i64`
                setValReg = convInt
                setValType = TypeKind.I64
            }
            self.objGen.emitSetProperty objPtrReg, off, setValReg, setValType
        }
        -> rightRes
    }

    if op == "&&" || op == "and" {
        leftRes: ExprResult = self.emitExpr node.children[0]
        lReg: str = leftRes.reg
        if leftRes.typeKind != TypeKind.Bool {
            cmpReg: str = self.codegen.newReg
            lTypeStr: str = llvmType leftRes.typeKind
            if leftRes.typeKind == TypeKind.Num {
                self.codegen.emit `${cmpReg} = fcmp one double ${leftRes.reg}, 0.0`
            } els {
                self.codegen.emit `${cmpReg} = icmp ne ${lTypeStr} ${leftRes.reg}, 0`
            }
            lReg = cmpReg
        }
        slotReg: str = self.codegen.newReg
        self.codegen.emit `${slotReg} = alloca i1`
        self.codegen.emit `store i1 false, ptr ${slotReg}`

        rhsLbl: str = self.codegen.newLabel "land_rhs"
        mergeLbl: str = self.codegen.newLabel "land_merge"

        self.codegen.emit `br i1 ${lReg}, label %${rhsLbl}, label %${mergeLbl}`

        self.codegen.emitLabel rhsLbl
        rightRes: ExprResult = self.emitExpr node.children[1]
        rReg: str = rightRes.reg
        if rightRes.typeKind != TypeKind.Bool {
            cmpReg2: str = self.codegen.newReg
            rTypeStr: str = llvmType rightRes.typeKind
            if rightRes.typeKind == TypeKind.Num {
                self.codegen.emit `${cmpReg2} = fcmp one double ${rightRes.reg}, 0.0`
            } els {
                self.codegen.emit `${cmpReg2} = icmp ne ${rTypeStr} ${rightRes.reg}, 0`
            }
            rReg = cmpReg2
        }
        self.codegen.emit `store i1 ${rReg}, ptr ${slotReg}`
        self.codegen.emit `br label %${mergeLbl}`

        self.codegen.emitLabel mergeLbl
        resReg: str = self.codegen.newReg
        self.codegen.emit `${resReg} = load i1, ptr ${slotReg}`
        res: ExprResult = { reg: resReg, typeKind: TypeKind.Bool }
        -> res
    }

    if op == "||" || op == "or" {
        leftRes: ExprResult = self.emitExpr node.children[0]
        lReg: str = leftRes.reg
        if leftRes.typeKind != TypeKind.Bool {
            cmpReg: str = self.codegen.newReg
            lTypeStr: str = llvmType leftRes.typeKind
            if leftRes.typeKind == TypeKind.Num {
                self.codegen.emit `${cmpReg} = fcmp one double ${leftRes.reg}, 0.0`
            } els {
                self.codegen.emit `${cmpReg} = icmp ne ${lTypeStr} ${leftRes.reg}, 0`
            }
            lReg = cmpReg
        }
        slotReg: str = self.codegen.newReg
        self.codegen.emit `${slotReg} = alloca i1`
        self.codegen.emit `store i1 true, ptr ${slotReg}`

        rhsLbl: str = self.codegen.newLabel "lor_rhs"
        mergeLbl: str = self.codegen.newLabel "lor_merge"

        self.codegen.emit `br i1 ${lReg}, label %${mergeLbl}, label %${rhsLbl}`

        self.codegen.emitLabel rhsLbl
        rightRes: ExprResult = self.emitExpr node.children[1]
        rReg: str = rightRes.reg
        if rightRes.typeKind != TypeKind.Bool {
            cmpReg2: str = self.codegen.newReg
            rTypeStr: str = llvmType rightRes.typeKind
            if rightRes.typeKind == TypeKind.Num {
                self.codegen.emit `${cmpReg2} = fcmp one double ${rightRes.reg}, 0.0`
            } els {
                self.codegen.emit `${cmpReg2} = icmp ne ${rTypeStr} ${rightRes.reg}, 0`
            }
            rReg = cmpReg2
        }
        self.codegen.emit `store i1 ${rReg}, ptr ${slotReg}`
        self.codegen.emit `br label %${mergeLbl}`

        self.codegen.emitLabel mergeLbl
        resReg: str = self.codegen.newReg
        self.codegen.emit `${resReg} = load i1, ptr ${slotReg}`
        res: ExprResult = { reg: resReg, typeKind: TypeKind.Bool }
        -> res
    }

    if op == "??" {
        leftRes: ExprResult = self.emitExpr node.children[0]
        if leftRes.typeKind == TypeKind.Nil || leftRes.typeKind == TypeKind.Und {
            rightRes: ExprResult = self.emitExpr node.children[1]
            -> rightRes
        }
        if !(isPointerType leftRes.typeKind) && leftRes.typeKind != TypeKind.Unknown {
            -> leftRes
        }
        cmpReg: str = self.codegen.newReg
        self.codegen.emit `${cmpReg} = icmp eq ptr ${leftRes.reg}, null`
        nullLbl: str = self.codegen.newLabel "nullish_null"
        keepLbl: str = self.codegen.newLabel "nullish_keep"
        mergeLbl: str = self.codegen.newLabel "nullish_merge"
        targetT: TypeKind = leftRes.typeKind
        if targetT == TypeKind.Unknown {
            targetT = node.children[1].inferredType
        }
        if targetT == TypeKind.Unknown {
            targetT = TypeKind.Ptr
        }
        stType: str = llvmStackType targetT
        slotReg: str = self.codegen.newReg
        self.codegen.emit `${slotReg} = alloca ${stType}`
        self.codegen.emit `br i1 ${cmpReg}, label %${nullLbl}, label %${keepLbl}`

        self.codegen.emitLabel keepLbl
        self.codegen.emit `store ${stType} ${leftRes.reg}, ptr ${slotReg}`
        self.codegen.emit `br label %${mergeLbl}`

        self.codegen.emitLabel nullLbl
        rightRes: ExprResult = self.emitExpr node.children[1]
        self.codegen.emit `store ${stType} ${rightRes.reg}, ptr ${slotReg}`
        self.codegen.emit `br label %${mergeLbl}`

        self.codegen.emitLabel mergeLbl
        resReg: str = self.codegen.newReg
        self.codegen.emit `${resReg} = load ${stType}, ptr ${slotReg}`
        res: ExprResult = { reg: resReg, typeKind: targetT }
        -> res
    }

    leftRes: ExprResult = self.emitExpr node.children[0]
    rightRes: ExprResult = self.emitExpr node.children[1]

    if op == "+" && (leftRes.typeKind == TypeKind.Str || rightRes.typeKind == TypeKind.Str) {
        sLeft: str = leftRes.reg
        sRight: str = rightRes.reg
        if leftRes.typeKind != TypeKind.Str {
            if leftRes.typeKind == TypeKind.I64 || leftRes.typeKind == TypeKind.I32 || leftRes.typeKind == TypeKind.I16 || leftRes.typeKind == TypeKind.I8 {
                zReg: str = leftRes.reg
                if leftRes.typeKind == TypeKind.I32 || leftRes.typeKind == TypeKind.I16 || leftRes.typeKind == TypeKind.I8 {
                    exReg: str = self.codegen.newReg
                    lTypeStr: str = llvmType leftRes.typeKind
                    self.codegen.emit `${exReg} = sext ${lTypeStr} ${leftRes.reg} to i64`
                    zReg = exReg
                }
                buf: str = self.codegen.newReg
                self.codegen.emit `${buf} = call ptr @malloc(i64 32)`
                numFmt: str = self.codegen.addStringConstant "%lld"
                self.codegen.emit `call i32 (ptr, i64, ptr, ...) @snprintf(ptr ${buf}, i64 32, ptr ${numFmt}, i64 ${zReg})`
                sLeft = buf
            } els if leftRes.typeKind == TypeKind.Num {
                buf: str = self.codegen.newReg
                self.codegen.emit `${buf} = call ptr @malloc(i64 32)`
                dblFmt: str = self.codegen.addStringConstant "%g"
                self.codegen.emit `call i32 (ptr, i64, ptr, ...) @snprintf(ptr ${buf}, i64 32, ptr ${dblFmt}, double ${leftRes.reg})`
                sLeft = buf
            } els if leftRes.typeKind == TypeKind.Bool {
                strTrue: str = self.codegen.addStringConstant "true"
                strFalse: str = self.codegen.addStringConstant "false"
                boolPtr: str = self.codegen.newReg
                self.codegen.emit `${boolPtr} = select i1 ${leftRes.reg}, ptr ${strTrue}, ptr ${strFalse}`
                sLeft = boolPtr
            } els {
                pReg1: str = self.codegen.newReg
                self.codegen.emit `${pReg1} = inttoptr i64 ${leftRes.reg} to ptr`
                sLeft = pReg1
            }
        }
        if rightRes.typeKind != TypeKind.Str {
            if rightRes.typeKind == TypeKind.I64 || rightRes.typeKind == TypeKind.I32 || rightRes.typeKind == TypeKind.I16 || rightRes.typeKind == TypeKind.I8 {
                zReg: str = rightRes.reg
                if rightRes.typeKind == TypeKind.I32 || rightRes.typeKind == TypeKind.I16 || rightRes.typeKind == TypeKind.I8 {
                    exReg: str = self.codegen.newReg
                    rTypeStr: str = llvmType rightRes.typeKind
                    self.codegen.emit `${exReg} = sext ${rTypeStr} ${rightRes.reg} to i64`
                    zReg = exReg
                }
                buf: str = self.codegen.newReg
                self.codegen.emit `${buf} = call ptr @malloc(i64 32)`
                numFmt: str = self.codegen.addStringConstant "%lld"
                self.codegen.emit `call i32 (ptr, i64, ptr, ...) @snprintf(ptr ${buf}, i64 32, ptr ${numFmt}, i64 ${zReg})`
                sRight = buf
            } els if rightRes.typeKind == TypeKind.Num {
                buf: str = self.codegen.newReg
                self.codegen.emit `${buf} = call ptr @malloc(i64 32)`
                dblFmt: str = self.codegen.addStringConstant "%g"
                self.codegen.emit `call i32 (ptr, i64, ptr, ...) @snprintf(ptr ${buf}, i64 32, ptr ${dblFmt}, double ${rightRes.reg})`
                sRight = buf
            } els if rightRes.typeKind == TypeKind.Bool {
                strTrue: str = self.codegen.addStringConstant "true"
                strFalse: str = self.codegen.addStringConstant "false"
                boolPtr: str = self.codegen.newReg
                self.codegen.emit `${boolPtr} = select i1 ${rightRes.reg}, ptr ${strTrue}, ptr ${strFalse}`
                sRight = boolPtr
            } els {
                pReg2: str = self.codegen.newReg
                self.codegen.emit `${pReg2} = inttoptr i64 ${rightRes.reg} to ptr`
                sRight = pReg2
            }
        }

        len1: str = self.codegen.newReg
        self.codegen.emit `${len1} = call i64 @strlen(ptr ${sLeft})`
        len2: str = self.codegen.newReg
        self.codegen.emit `${len2} = call i64 @strlen(ptr ${sRight})`
        totLen: str = self.codegen.newReg
        self.codegen.emit `${totLen} = add i64 ${len1}, ${len2}`
        allocLen: str = self.codegen.newReg
        self.codegen.emit `${allocLen} = add i64 ${totLen}, 1`
        bufReg: str = self.codegen.newReg
        self.codegen.emit `${bufReg} = call ptr @malloc(i64 ${allocLen})`
        self.codegen.emit `call ptr @memcpy(ptr ${bufReg}, ptr ${sLeft}, i64 ${len1})`
        dest2: str = self.codegen.newReg
        self.codegen.emit `${dest2} = getelementptr inbounds i8, ptr ${bufReg}, i64 ${len1}`
        self.codegen.emit `call ptr @memcpy(ptr ${dest2}, ptr ${sRight}, i64 ${len2})`
        termPtr: str = self.codegen.newReg
        self.codegen.emit `${termPtr} = getelementptr inbounds i8, ptr ${bufReg}, i64 ${totLen}`
        self.codegen.emit `store i8 0, ptr ${termPtr}`
        sRes: ExprResult = { reg: bufReg, typeKind: TypeKind.Str }
        -> sRes
    }

    if op == "==" || op == "!=" {
        if leftRes.typeKind == TypeKind.Str && rightRes.typeKind == TypeKind.Str {
            cmpRes: str = self.codegen.newReg
            self.codegen.emit `${cmpRes} = call i32 @strcmp(ptr ${leftRes.reg}, ptr ${rightRes.reg})`
            condReg: str = self.codegen.newReg
            condOp: str = (op == "==") ? "eq" : "ne"
            self.codegen.emit `${condReg} = icmp ${condOp} i32 ${cmpRes}, 0`
            bRes: ExprResult = { reg: condReg, typeKind: TypeKind.Bool }
            -> bRes
        }
        if leftRes.typeKind == TypeKind.Str || rightRes.typeKind == TypeKind.Str {
            condReg: str = self.codegen.newReg
            condVal: str = (op == "==") ? "0" : "1"
            self.codegen.emit `${condReg} = icmp eq i32 ${condVal}, 1`
            bRes: ExprResult = { reg: condReg, typeKind: TypeKind.Bool }
            -> bRes
        }
        if leftRes.typeKind == TypeKind.Bool && rightRes.typeKind == TypeKind.Bool {
            condReg: str = self.codegen.newReg
            condOp: str = (op == "==") ? "eq" : "ne"
            self.codegen.emit `${condReg} = icmp ${condOp} i1 ${leftRes.reg}, ${rightRes.reg}`
            bRes: ExprResult = { reg: condReg, typeKind: TypeKind.Bool }
            -> bRes
        }
        isNumL: bool = IsNumericType leftRes.typeKind
        isNumR: bool = IsNumericType rightRes.typeKind
        if (leftRes.typeKind == TypeKind.Bool && isNumR) || (rightRes.typeKind == TypeKind.Bool && isNumL) {
            boolReg: str = leftRes.typeKind == TypeKind.Bool ? leftRes.reg : rightRes.reg
            numReg: str = leftRes.typeKind == TypeKind.Bool ? rightRes.reg : leftRes.reg
            numKind = leftRes.typeKind == TypeKind.Bool ? rightRes.typeKind : leftRes.typeKind

            extBool: str = self.codegen.newReg
            self.codegen.emit `${extBool} = zext i1 ${boolReg} to i64`
            if numKind == TypeKind.Num {
                extDbl: str = self.codegen.newReg
                self.codegen.emit `${extDbl} = sitofp i64 ${extBool} to double`
                cmpRes: str = self.codegen.newReg
                fcmpOp: str = (op == "==") ? "oeq" : "one"
                self.codegen.emit `${cmpRes} = fcmp ${fcmpOp} double ${extDbl}, ${numReg}`
                bRes: ExprResult = { reg: cmpRes, typeKind: TypeKind.Bool }
                -> bRes
            } els {
                i64Num: str = numReg
                if numKind == TypeKind.I8 || numKind == TypeKind.I16 || numKind == TypeKind.I32 {
                    convNum: str = self.codegen.newReg
                    srcT: str = llvmType numKind
                    self.codegen.emit `${convNum} = sext ${srcT} ${numReg} to i64`
                    i64Num = convNum
                }
                cmpRes: str = self.codegen.newReg
                icmpOp: str = (op == "==") ? "eq" : "ne"
                self.codegen.emit `${cmpRes} = icmp ${icmpOp} i64 ${extBool}, ${i64Num}`
                bRes: ExprResult = { reg: cmpRes, typeKind: TypeKind.Bool }
                -> bRes
            }
        }
        if leftRes.typeKind == TypeKind.Nil || rightRes.typeKind == TypeKind.Nil || leftRes.typeKind == TypeKind.Und || rightRes.typeKind == TypeKind.Und {
            if leftRes.typeKind == rightRes.typeKind {
                condReg: str = self.codegen.newReg
                condVal: str = (op == "==") ? "1" : "0"
                self.codegen.emit `${condReg} = icmp eq i32 ${condVal}, 1`
                bRes: ExprResult = { reg: condReg, typeKind: TypeKind.Bool }
                -> bRes
            }
            isPtrL: bool = (leftRes.typeKind == TypeKind.Ptr || leftRes.typeKind == TypeKind.Arr || leftRes.typeKind == TypeKind.Obj)
            isPtrR: bool = (rightRes.typeKind == TypeKind.Ptr || rightRes.typeKind == TypeKind.Arr || rightRes.typeKind == TypeKind.Obj)
            if (isPtrL && rightRes.typeKind == TypeKind.Nil) || (isPtrR && leftRes.typeKind == TypeKind.Nil) {
                ptrReg: str = isPtrL ? leftRes.reg : rightRes.reg
                cmpRes: str = self.codegen.newReg
                icmpOp: str = (op == "==") ? "eq" : "ne"
                self.codegen.emit `${cmpRes} = icmp ${icmpOp} ptr ${ptrReg}, null`
                bRes: ExprResult = { reg: cmpRes, typeKind: TypeKind.Bool }
                -> bRes
            }
            isI64L: bool = (leftRes.typeKind == TypeKind.I64 || leftRes.typeKind == TypeKind.I32)
            isI64R: bool = (rightRes.typeKind == TypeKind.I64 || rightRes.typeKind == TypeKind.I32)
            if (isI64L && (rightRes.typeKind == TypeKind.Nil || rightRes.typeKind == TypeKind.Und)) ||
               (isI64R && (leftRes.typeKind == TypeKind.Nil || leftRes.typeKind == TypeKind.Und)) {
                valReg: str = isI64L ? leftRes.reg : rightRes.reg
                cmpRes: str = self.codegen.newReg
                icmpOp: str = (op == "==") ? "eq" : "ne"
                self.codegen.emit `${cmpRes} = icmp ${icmpOp} i64 ${valReg}, 0`
                bRes: ExprResult = { reg: cmpRes, typeKind: TypeKind.Bool }
                -> bRes
            }
            if (leftRes.typeKind == TypeKind.Num && (rightRes.typeKind == TypeKind.Nil || rightRes.typeKind == TypeKind.Und)) ||
               (rightRes.typeKind == TypeKind.Num && (leftRes.typeKind == TypeKind.Nil || leftRes.typeKind == TypeKind.Und)) {
                valReg: str = (leftRes.typeKind == TypeKind.Num) ? leftRes.reg : rightRes.reg
                cmpRes: str = self.codegen.newReg
                fcmpOp: str = (op == "==") ? "fcmp oeq" : "fcmp one"
                self.codegen.emit `${cmpRes} = ${fcmpOp} double ${valReg}, 0.0`
                bRes: ExprResult = { reg: cmpRes, typeKind: TypeKind.Bool }
                -> bRes
            }
            condReg: str = self.codegen.newReg
            condVal: str = (op == "==") ? "0" : "1"
            self.codegen.emit `${condReg} = icmp eq i32 ${condVal}, 1`
            bRes: ExprResult = { reg: condReg, typeKind: TypeKind.Bool }
            -> bRes
        }
        if leftRes.typeKind != rightRes.typeKind && leftRes.typeKind != TypeKind.Unknown && rightRes.typeKind != TypeKind.Unknown {
            if !isNumL || !isNumR {
                condReg: str = self.codegen.newReg
                condVal: str = (op == "==") ? "0" : "1"
                self.codegen.emit `${condReg} = icmp eq i32 ${condVal}, 1`
                bRes: ExprResult = { reg: condReg, typeKind: TypeKind.Bool }
                -> bRes
            }
        }
    }

    if op == "-" && (leftRes.typeKind == TypeKind.Ptr || rightRes.typeKind == TypeKind.Ptr) {
        pLeft: str = leftRes.reg
        if leftRes.typeKind == TypeKind.Ptr {
            intReg: str = self.codegen.newReg
            self.codegen.emit `${intReg} = ptrtoint ptr ${leftRes.reg} to i64`
            pLeft = intReg
        }
        pRight: str = rightRes.reg
        if rightRes.typeKind == TypeKind.Ptr {
            intReg: str = self.codegen.newReg
            self.codegen.emit `${intReg} = ptrtoint ptr ${rightRes.reg} to i64`
            pRight = intReg
        }
        diffReg: str = self.codegen.newReg
        self.codegen.emit `${diffReg} = sub i64 ${pLeft}, ${pRight}`
        res: ExprResult = { reg: diffReg, typeKind: TypeKind.I64 }
        -> res
    }

    leftReg: str = leftRes.reg
    rightReg: str = rightRes.reg
    targetType = leftRes.typeKind

    if leftRes.typeKind != rightRes.typeKind {
        if leftRes.typeKind == TypeKind.Num || rightRes.typeKind == TypeKind.Num {
            targetType = TypeKind.Num
        } els if leftRes.typeKind == TypeKind.F32 || rightRes.typeKind == TypeKind.F32 {
            targetType = TypeKind.F32
        } els if leftRes.typeKind == TypeKind.U128 || rightRes.typeKind == TypeKind.U128 {
            targetType = TypeKind.U128
        } els if leftRes.typeKind == TypeKind.I128 || rightRes.typeKind == TypeKind.I128 {
            targetType = TypeKind.I128
        } els if leftRes.typeKind == TypeKind.U64 || rightRes.typeKind == TypeKind.U64 {
            targetType = TypeKind.U64
        } els if leftRes.typeKind == TypeKind.I64 || rightRes.typeKind == TypeKind.I64 {
            targetType = TypeKind.I64
        } els if leftRes.typeKind == TypeKind.U32 || rightRes.typeKind == TypeKind.U32 {
            targetType = TypeKind.U32
        } els if leftRes.typeKind == TypeKind.I32 || rightRes.typeKind == TypeKind.I32 {
            targetType = TypeKind.I32
        } els if leftRes.typeKind == TypeKind.U16 || rightRes.typeKind == TypeKind.U16 {
            targetType = TypeKind.U16
        } els if leftRes.typeKind == TypeKind.I16 || rightRes.typeKind == TypeKind.I16 {
            targetType = TypeKind.I16
        } els if leftRes.typeKind == TypeKind.U8 || rightRes.typeKind == TypeKind.U8 {
            targetType = TypeKind.U8
        } els if leftRes.typeKind == TypeKind.I8 || rightRes.typeKind == TypeKind.I8 {
            targetType = TypeKind.I8
        }

        if leftRes.typeKind != targetType {
            fromT: str = llvmType leftRes.typeKind
            toT: str = llvmType targetType
            if fromT != toT {
                castOp: str = selectCastOp leftRes.typeKind, targetType
                convReg: str = self.codegen.newReg
                if castOp.ln > 0 {
                    self.codegen.emit `${convReg} = ${castOp} ${fromT} ${leftReg} to ${toT}`
                } els if fromT == "i1" {
                    self.codegen.emit `${convReg} = zext i1 ${leftReg} to ${toT}`
                } els if toT == "i1" {
                    self.codegen.emit `${convReg} = trunc ${fromT} ${leftReg} to i1`
                } els if toT == "double" {
                    self.codegen.emit `${convReg} = sitofp ${fromT} ${leftReg} to double`
                } els if fromT == "double" {
                    self.codegen.emit `${convReg} = fptosi double ${leftReg} to ${toT}`
                } els {
                    self.codegen.emit `${convReg} = bitcast ${fromT} ${leftReg} to ${toT}`
                }
                leftReg = convReg
            }
        }
        if rightRes.typeKind != targetType {
            fromT: str = llvmType rightRes.typeKind
            toT: str = llvmType targetType
            if fromT != toT {
                castOp: str = selectCastOp rightRes.typeKind, targetType
                convReg: str = self.codegen.newReg
                if castOp.ln > 0 {
                    self.codegen.emit `${convReg} = ${castOp} ${fromT} ${rightReg} to ${toT}`
                } els if fromT == "i1" {
                    self.codegen.emit `${convReg} = zext i1 ${rightRes} to ${toT}`
                } els if toT == "i1" {
                    self.codegen.emit `${convReg} = trunc ${fromT} ${rightRes} to i1`
                } els if toT == "double" {
                    self.codegen.emit `${convReg} = sitofp ${fromT} ${rightReg} to double`
                } els if fromT == "double" {
                    self.codegen.emit `${convReg} = fptosi double ${rightRes} to ${toT}`
                } els {
                    self.codegen.emit `${convReg} = bitcast ${fromT} ${rightReg} to ${toT}`
                }
                rightReg = convReg
            }
        }
    }

    if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" {
        cmpInst: str = selectCmpOp op, targetType
        ltype: str = llvmType targetType
        resReg: str = self.codegen.newReg
        self.codegen.emit `${resReg} = ${cmpInst} ${ltype} ${leftReg}, ${rightReg}`
        res: ExprResult = { reg: resReg, typeKind: TypeKind.Bool }
        -> res
    }

    if op == "**" {
        ldbl: str = leftReg
        rdbl: str = rightReg
        if targetType != TypeKind.Num {
            c1: str = self.codegen.newReg
            self.codegen.emit `${c1} = sitofp i64 ${leftReg} to double`
            ldbl = c1
            c2: str = self.codegen.newReg
            self.codegen.emit `${c2} = sitofp i64 ${rightReg} to double`
            rdbl = c2
        }
        pReg: str = self.codegen.newReg
        self.codegen.emit `${pReg} = call double @llvm.pow.f64(double ${ldbl}, double ${rdbl})`
        if targetType == TypeKind.Num {
            res: ExprResult = { reg: pReg, typeKind: TypeKind.Num }
            -> res
        } els {
            iReg: str = self.codegen.newReg
            self.codegen.emit `${iReg} = fptosi double ${pReg} to i64`
            res: ExprResult = { reg: iReg, typeKind: targetType }
            -> res
        }
    }

    binInst: str = selectBinaryOp op, targetType
    ltype: str = llvmType targetType
    resReg: str = self.codegen.newReg
    self.codegen.emit `${resReg} = ${binInst} ${ltype} ${leftReg}, ${rightReg}`
    res: ExprResult = { reg: resReg, typeKind: targetType }
    -> res
}
