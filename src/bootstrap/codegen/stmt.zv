/*
 * =============================================================================
 * Zuv Bootstrap Compiler — Statement & Control Flow Code Generation
 * Path: sub_projects/zuv/src/bootstrap/codegen/stmt.zv
 *
 * Implements code generation for all statements and control flow structures:
 * - Variable declarations (alloca stack slot, initializer evaluation, symbol registration)
 * - If/else branching with block merging and deterministic label allocation
 * - While loops and for-of array iterations with break/continue tracking
 * - Pattern matching switches using LLVM switch i64 instruction tables
 * - Return statements with integer widening (zext i8 to i64, zext i1 to i64)
 * - Break and continue jumps within loop contexts
 * - Panic error statements and unreachable trap emissions
 * =============================================================================
 */

imp str, arr
imp TypeKind, TypeKindToStr frm ../types
imp ASTNode, NodeKind, MatchArm frm ../ast
imp Codegen frm codegen/codegen
imp llvmType, llvmStackType, isPointerType, selectDefaultValue frm codegen/types
imp boxValueToI64, unboxValueFromI64 frm codegen/array
imp resolveFieldTypeKind frm codegen/decl
imp ExprCodegen, ExprResult, ScopeSymbol frm codegen/expr

/**
 * Coordinates statement lowering and control flow graph construction.
 */
obj StmtCodegen {
    codegen: Codegen,
    exprGen: ExprCodegen,
    breakLabels: str[],
    continueLabels: str[],
    returnType: TypeKind,
    isTopLevel: bool,
    isAsync: bool,
    asyncPrmReg: str,
    asyncPrevModeReg: str,

    /**
     * Initializes a new StmtCodegen coordinator instance.
     *
     * @param {Codegen} codegen - LLVM module coordinator
     * @param {ExprCodegen} exprGen - Expression code generation coordinator
     * @returns {StmtCodegen} Initialized StmtCodegen instance
     */
    create: codegen: Codegen, exprGen: ExprCodegen :: StmtCodegen => {
        emptyBrk: str[] = []
        emptyCont: str[] = []
        -> {
            codegen,
            exprGen,
            breakLabels: emptyBrk,
            continueLabels: emptyCont,
            returnType: TypeKind.Void,
            isTopLevel: false,
            isAsync: false,
            asyncPrmReg: "",
            asyncPrevModeReg: ""
        }
    },

    setAsyncFunc: prmReg: str, prevModeReg: str :: void => {
        self.isAsync = true
        self.asyncPrmReg = prmReg
        self.asyncPrevModeReg = prevModeReg
    },

    clearAsyncFunc: :: void => {
        self.isAsync = false
        self.asyncPrmReg = ""
        self.asyncPrevModeReg = ""
    },

    /**
     * Sets whether current statement lowering is occurring at the module top level.
     *
     * @param {bool} isTop - True if top level module scope
     * @returns {void}
     */
    setTopLevel: isTop: bool :: void => {
        self.isTopLevel = isTop
    },

    /**
     * Sets the expected return type for the enclosing function body.
     *
     * @param {TypeKind} returnType - Semantic return type
     * @returns {void}
     */
    setReturnType: returnType: TypeKind :: void => {
        self.returnType = returnType
    },

    /**
     * Master statement dispatcher routing AST nodes to specialized emitters.
     *
     * @param {ASTNode} node - Statement AST node
     * @returns {void}
     */
    emitStmt: node: ASTNode :: void => sw node.kind {
        NodeKind.VarDecl   => self.emitVarDecl node
        NodeKind.BlockStmt => self.emitBlock node
        NodeKind.ExprStmt  => self.emitExprStmt node
        NodeKind.IfStmt    => self.emitIf node
        NodeKind.WhStmt    => self.emitWh node
        NodeKind.FrOfStmt  => self.emitFrOf node
        NodeKind.FrInStmt  => self.emitFrIn node
        NodeKind.SwStmt    => self.emitSw node
        NodeKind.RetStmt   => self.emitRet node
        NodeKind.BrkStmt    => self.emitBrk node
        NodeKind.ContStmt   => self.emitCont node
        NodeKind.PanicStmt  => self.emitPanic node
        NodeKind.TryCthStmt => self.emitTryCth node
        _                   => {
            self.exprGen.emitExpr node
        }
    },

    /**
     * Emits stack allocation and initialization for a variable declaration.
     *
     * @param {ASTNode} node - VarDecl AST node
     * @returns {void}
     */
    emitVarDecl: node: ASTNode :: void => {
        varType = node.inferredType
        if varType == TypeKind.Unknown && node.typeAnnotation.ln > 0 {
            varType = resolveFieldTypeKind node.typeAnnotation
        }
        initReg: str = ""
        initResKind = TypeKind.Unknown
        hasInit: bool = (node.children.ln > 0 && node.children[0].kind != NodeKind.NilExpr)

        if hasInit {
            initRes: ExprResult = self.exprGen.emitExpr node.children[0]
            initReg = initRes.reg
            initResKind = initRes.typeKind
            if varType == TypeKind.Unknown {
                varType = initRes.typeKind
            }
        } els {
            initReg = selectDefaultValue varType
        }

        if varType == TypeKind.Unknown {
            varType = TypeKind.I64
        }

        stType: str = llvmStackType varType
        slotReg: str = ""
        isGlobal: bool = false

        effTypeName: str = node.typeAnnotation
        if effTypeName.ln == 0 && node.children.ln > 0 {
            effTypeName = node.children[0].typeAnnotation
            if effTypeName.ln == 0 && node.children[0].name.ln > 0 {
                effTypeName = node.children[0].name
            }
        }

        if self.isTopLevel {
            existingGlobal: ScopeSymbol = self.exprGen.findGlobalSymbol node.name
            if existingGlobal.name.ln > 0 {
                slotReg = existingGlobal.reg
                isGlobal = true
                self.exprGen.setGlobalSymbolType node.name, varType, effTypeName
            }
        }

        if !isGlobal {
            slotReg = self.codegen.newReg
            self.codegen.emit `${slotReg} = alloca ${stType}`
            self.exprGen.addSymbolWithType node.name, slotReg, varType, effTypeName, false, true
        }
        if initReg.ln > 0 {
            storeVal: str = initReg
            if stType == "i64" && initResKind == TypeKind.Bool {
                extReg: str = self.codegen.newReg
                self.codegen.emit `${extReg} = zext i1 ${initReg} to i64`
                storeVal = extReg
            } els if stType == "i64" && initResKind == TypeKind.I8 {
                extReg: str = self.codegen.newReg
                self.codegen.emit `${extReg} = zext i8 ${initReg} to i64`
                storeVal = extReg
            } els if stType == "i64" && initResKind == TypeKind.I16 {
                extReg: str = self.codegen.newReg
                self.codegen.emit `${extReg} = zext i16 ${initReg} to i64`
                storeVal = extReg
            } els if stType == "i64" && initResKind == TypeKind.I32 {
                extReg: str = self.codegen.newReg
                self.codegen.emit `${extReg} = zext i32 ${initReg} to i64`
                storeVal = extReg
            } els if stType == "i64" && (initResKind == TypeKind.Str || initResKind == TypeKind.Ptr || initResKind == TypeKind.Arr || initResKind == TypeKind.Obj) {
                convReg: str = self.codegen.newReg
                self.codegen.emit `${convReg} = ptrtoint ptr ${initReg} to i64`
                storeVal = convReg
            } els if stType == "ptr" && initResKind == TypeKind.I64 {
                convReg: str = self.codegen.newReg
                self.codegen.emit `${convReg} = inttoptr i64 ${initReg} to ptr`
                storeVal = convReg
            } els if (stType == "i8" || stType == "i16" || stType == "i32") && initResKind == TypeKind.I64 {
                truncReg: str = self.codegen.newReg
                self.codegen.emit `${truncReg} = trunc i64 ${initReg} to ${stType}`
                storeVal = truncReg
            } els if stType == "double" && initResKind == TypeKind.I64 {
                convReg: str = self.codegen.newReg
                self.codegen.emit `${convReg} = sitofp i64 ${initReg} to double`
                storeVal = convReg
            } els if stType == "double" && initResKind == TypeKind.I32 {
                convReg: str = self.codegen.newReg
                self.codegen.emit `${convReg} = sitofp i32 ${initReg} to double`
                storeVal = convReg
            } els if stType == "double" && (initResKind == TypeKind.I16 || initResKind == TypeKind.I8) {
                convReg: str = self.codegen.newReg
                self.codegen.emit `${convReg} = sitofp i32 ${initReg} to double`
                storeVal = convReg
            } els if stType == "i64" && initResKind == TypeKind.Num {
                convReg: str = self.codegen.newReg
                self.codegen.emit `${convReg} = fptosi double ${initReg} to i64`
                storeVal = convReg
            } els if (stType == "i8" || stType == "i16" || stType == "i32") && initResKind == TypeKind.Num {
                convReg: str = self.codegen.newReg
                self.codegen.emit `${convReg} = fptosi double ${initReg} to ${stType}`
                storeVal = convReg
            }
            self.codegen.emit `store ${stType} ${storeVal}, ptr ${slotReg}`
        }
    },

    /**
     * Emits statements inside a block scope.
     *
     * @param {ASTNode} node - BlockStmt AST node
     * @returns {void}
     */
    emitBlock: node: ASTNode :: void => {
        fr child of node.children {
            self.emitStmt child
        }
    },

    /**
     * Emits an expression statement.
     *
     * @param {ASTNode} node - ExprStmt AST node
     * @returns {void}
     */
    emitExprStmt: node: ASTNode :: void => {
        if node.children.ln > 0 {
            self.exprGen.emitExpr node.children[0]
        }
    },

    /**
     * Emits an if/else conditional branch with merge label.
     *
     * @param {ASTNode} node - IfStmt AST node
     * @returns {void}
     */
    emitIf: node: ASTNode :: void => {
        condRes: ExprResult = self.exprGen.emitExpr node.children[0]
        thenLbl: str = self.codegen.newLabel "if_then"
        elseLbl: str = self.codegen.newLabel "if_else"
        mergeLbl: str = self.codegen.newLabel "if_merge"

        condReg: str = condRes.reg
        if condRes.typeKind != TypeKind.Bool {
            cType: str = llvmType condRes.typeKind
            cmpReg: str = self.codegen.newReg
            if condRes.typeKind == TypeKind.Num {
                self.codegen.emit `${cmpReg} = fcmp one double ${condReg}, 0.0`
            } els if isPointerType condRes.typeKind {
                self.codegen.emit `${cmpReg} = icmp ne ptr ${condReg}, null`
            } els {
                self.codegen.emit `${cmpReg} = icmp ne ${cType} ${condReg}, 0`
            }
            condReg = cmpReg
        }

        hasElse: bool = (node.children.ln > 2 && node.children[2].kind != NodeKind.NilExpr)
        targetElseLbl: str = mergeLbl
        if hasElse {
            targetElseLbl = elseLbl
        }

        self.codegen.emit `br i1 ${condReg}, label %${thenLbl}, label %${targetElseLbl}`

        self.codegen.emitLabel thenLbl
        self.emitStmt node.children[1]
        self.codegen.emit `br label %${mergeLbl}`

        if hasElse {
            self.codegen.emitLabel elseLbl
            self.emitStmt node.children[2]
            self.codegen.emit `br label %${mergeLbl}`
        }

        self.codegen.emitLabel mergeLbl
    },

    /**
     * Emits a while loop with condition check, loop body, and exit label.
     *
     * @param {ASTNode} node - WhStmt AST node
     * @returns {void}
     */
    emitWh: node: ASTNode :: void => {
        condLbl: str = self.codegen.newLabel "wh_cond"
        bodyLbl: str = self.codegen.newLabel "wh_body"
        endLbl: str = self.codegen.newLabel "wh_end"

        self.breakLabels.psh endLbl
        self.continueLabels.psh condLbl

        self.codegen.emit `br label %${condLbl}`
        self.codegen.emitLabel condLbl

        condRes: ExprResult = self.exprGen.emitExpr node.children[0]
        condReg: str = condRes.reg
        if condRes.typeKind != TypeKind.Bool {
            cType: str = llvmType condRes.typeKind
            cmpReg: str = self.codegen.newReg
            if condRes.typeKind == TypeKind.Num {
                self.codegen.emit `${cmpReg} = fcmp one double ${condReg}, 0.0`
            } els if isPointerType condRes.typeKind {
                self.codegen.emit `${cmpReg} = icmp ne ptr ${condReg}, null`
            } els {
                self.codegen.emit `${cmpReg} = icmp ne ${cType} ${condReg}, 0`
            }
            condReg = cmpReg
        }
        self.codegen.emit `br i1 ${condReg}, label %${bodyLbl}, label %${endLbl}`

        self.codegen.emitLabel bodyLbl
        self.emitStmt node.children[1]
        self.codegen.emit `br label %${condLbl}`

        self.codegen.emitLabel endLbl
        self.breakLabels.pp
        self.continueLabels.pp
    },

    /**
     * Emits a for-of loop iterating over an array collection.
     *
     * @param {ASTNode} node - FrOfStmt AST node
     * @returns {void}
     */
    emitFrOf: node: ASTNode :: void => {
        arrRes: ExprResult = self.exprGen.emitExpr node.children[0]
        arrPtrReg: str = arrRes.reg
        if !(isPointerType arrRes.typeKind) {
            convReg: str = self.codegen.newReg
            self.codegen.emit `${convReg} = inttoptr i64 ${arrRes.reg} to ptr`
            arrPtrReg = convReg
        }
        lenReg: str = self.exprGen.arrGen.emitLength arrPtrReg

        idxSlot: str = self.codegen.newReg
        self.codegen.emit `${idxSlot} = alloca i64`
        self.codegen.emit `store i64 0, ptr ${idxSlot}`

        itemType = node.inferredType
        if itemType == TypeKind.Unknown {
            itemType = TypeKind.I64
        }
        itemSlot: str = self.codegen.newReg
        stType: str = llvmStackType itemType
        self.codegen.emit `${itemSlot} = alloca ${stType}`
        self.exprGen.addSymbol node.name, itemSlot, itemType, false, true

        userIdxSlot: str = ""
        if node.val.ln > 0 {
            userIdxSlot = self.codegen.newReg
            self.codegen.emit `${userIdxSlot} = alloca double`
            self.exprGen.addSymbol node.val, userIdxSlot, TypeKind.Num, false, true
        }

        condLbl: str = self.codegen.newLabel "frof_cond"
        bodyLbl: str = self.codegen.newLabel "frof_body"
        stepLbl: str = self.codegen.newLabel "frof_step"
        endLbl: str = self.codegen.newLabel "frof_end"

        self.breakLabels.psh endLbl
        self.continueLabels.psh stepLbl

        self.codegen.emit `br label %${condLbl}`
        self.codegen.emitLabel condLbl

        curIdxReg: str = self.codegen.newReg
        self.codegen.emit `${curIdxReg} = load i64, ptr ${idxSlot}`
        hasMore: str = self.codegen.newReg
        self.codegen.emit `${hasMore} = icmp ult i64 ${curIdxReg}, ${lenReg}`
        self.codegen.emit `br i1 ${hasMore}, label %${bodyLbl}, label %${endLbl}`

        self.codegen.emitLabel bodyLbl
        elemRaw: str = self.exprGen.arrGen.emitGetElement arrPtrReg, curIdxReg, false, node.line
        elemVal: str = elemRaw
        if itemType == TypeKind.Num {
            elemDbl: str = self.codegen.newReg
            self.codegen.emit `${elemDbl} = sitofp i64 ${elemRaw} to double`
            elemVal = elemDbl
        } els {
            elemVal = unboxValueFromI64 self.codegen, elemRaw, itemType
        }
        self.codegen.emit `store ${stType} ${elemVal}, ptr ${itemSlot}`

        if userIdxSlot.ln > 0 {
            idxDbl: str = self.codegen.newReg
            self.codegen.emit `${idxDbl} = sitofp i64 ${curIdxReg} to double`
            self.codegen.emit `store double ${idxDbl}, ptr ${userIdxSlot}`
        }

        self.emitStmt node.children[1]
        self.codegen.emit `br label %${stepLbl}`

        self.codegen.emitLabel stepLbl
        sIdx: str = self.codegen.newReg
        self.codegen.emit `${sIdx} = load i64, ptr ${idxSlot}`
        nextIdx: str = self.codegen.newReg
        self.codegen.emit `${nextIdx} = add i64 ${sIdx}, 1`
        self.codegen.emit `store i64 ${nextIdx}, ptr ${idxSlot}`
        self.codegen.emit `br label %${condLbl}`

        self.codegen.emitLabel endLbl
        self.breakLabels.pp
        self.continueLabels.pp
    },

    /**
     * Emits a for-in loop iterating over collection keys or elements.
     *
     * @param {ASTNode} node - FrInStmt AST node
     * @returns {void}
     */
    emitFrIn: node: ASTNode :: void => {
        if node.children.ln == 4 {
            initNode: ASTNode = node.children[0]
            condNode: ASTNode = node.children[1]
            postNode: ASTNode = node.children[2]
            bodyNode: ASTNode = node.children[3]

            if initNode.kind == NodeKind.VarDecl {
                self.emitVarDecl initNode
            } els {
                self.emitStmt initNode
            }

            condLbl: str = self.codegen.newLabel "fr_cond"
            bodyLbl: str = self.codegen.newLabel "fr_body"
            stepLbl: str = self.codegen.newLabel "fr_step"
            endLbl: str = self.codegen.newLabel "fr_end"

            self.breakLabels.psh endLbl
            self.continueLabels.psh stepLbl

            self.codegen.emit `br label %${condLbl}`
            self.codegen.emitLabel condLbl

            condRes: ExprResult = self.exprGen.emitExpr condNode
            condI1: str = condRes.reg
            if condRes.typeKind != TypeKind.Bool {
                cmpReg: str = self.codegen.newReg
                itype: str = llvmType condRes.typeKind
                self.codegen.emit `${cmpReg} = icmp ne ${itype} ${condRes.reg}, 0`
                condI1 = cmpReg
            }
            self.codegen.emit `br i1 ${condI1}, label %${bodyLbl}, label %${endLbl}`

            self.codegen.emitLabel bodyLbl
            self.emitStmt bodyNode
            self.codegen.emit `br label %${stepLbl}`

            self.codegen.emitLabel stepLbl
            self.exprGen.emitExpr postNode
            self.codegen.emit `br label %${condLbl}`

            self.codegen.emitLabel endLbl
            self.breakLabels.pp
            self.continueLabels.pp
            ->
        }

        collRes: ExprResult = self.exprGen.emitExpr node.children[0]
        isArr: bool = (collRes.typeKind == TypeKind.Arr || node.children[0].inferredType == TypeKind.Arr)

        condLbl: str = self.codegen.newLabel "frin_cond"
        bodyLbl: str = self.codegen.newLabel "frin_body"
        stepLbl: str = self.codegen.newLabel "frin_step"
        endLbl: str = self.codegen.newLabel "frin_end"

        self.breakLabels.psh endLbl
        self.continueLabels.psh stepLbl

        idxSlot: str = self.codegen.newReg
        self.codegen.emit `${idxSlot} = alloca i64`
        self.codegen.emit `store i64 0, ptr ${idxSlot}`

        if isArr {
            arrPtrReg: str = collRes.reg
            if !(isPointerType collRes.typeKind) {
                convReg: str = self.codegen.newReg
                self.codegen.emit `${convReg} = inttoptr i64 ${collRes.reg} to ptr`
                arrPtrReg = convReg
            }
            lenReg: str = self.exprGen.arrGen.emitLength arrPtrReg
            firstSlot: str = self.codegen.newReg
            self.codegen.emit `${firstSlot} = alloca i64`
            self.exprGen.addSymbol node.name, firstSlot, TypeKind.I64, false, true

            secondSlot: str = ""
            if node.val.ln > 0 {
                secondSlot = self.codegen.newReg
                self.codegen.emit `${secondSlot} = alloca double`
                self.exprGen.addSymbol node.val, secondSlot, TypeKind.Num, false, true
            }

            self.codegen.emit `br label %${condLbl}`
            self.codegen.emitLabel condLbl

            curIdxReg: str = self.codegen.newReg
            self.codegen.emit `${curIdxReg} = load i64, ptr ${idxSlot}`
            hasMore: str = self.codegen.newReg
            self.codegen.emit `${hasMore} = icmp ult i64 ${curIdxReg}, ${lenReg}`
            self.codegen.emit `br i1 ${hasMore}, label %${bodyLbl}, label %${endLbl}`

            self.codegen.emitLabel bodyLbl
            self.codegen.emit `store i64 ${curIdxReg}, ptr ${firstSlot}`

            if secondSlot.ln > 0 {
                elemRaw: str = self.exprGen.arrGen.emitGetElement arrPtrReg, curIdxReg, false, node.line
                elemDbl: str = self.codegen.newReg
                self.codegen.emit `${elemDbl} = sitofp i64 ${elemRaw} to double`
                self.codegen.emit `store double ${elemDbl}, ptr ${secondSlot}`
            }

            self.emitStmt node.children[1]
            self.codegen.emit `br label %${stepLbl}`

            self.codegen.emitLabel stepLbl
            sIdx: str = self.codegen.newReg
            self.codegen.emit `${sIdx} = load i64, ptr ${idxSlot}`
            nextIdx: str = self.codegen.newReg
            self.codegen.emit `${nextIdx} = add i64 ${sIdx}, 1`
            self.codegen.emit `store i64 ${nextIdx}, ptr ${idxSlot}`
            self.codegen.emit `br label %${condLbl}`

            self.codegen.emitLabel endLbl
            self.breakLabels.pp
            self.continueLabels.pp
            ->
        }

        // Object iteration
        keysOff: num = self.exprGen.objGen.registry.getFieldOffset "", "__keys"
        kSlotGep: str = self.codegen.newReg
        self.codegen.emit `${kSlotGep} = getelementptr inbounds i64, ptr ${collRes.reg}, i64 ${keysOff}`
        keysInt: str = self.codegen.newReg
        self.codegen.emit `${keysInt} = load i64, ptr ${kSlotGep}`
        keysBuf: str = self.codegen.newReg
        self.codegen.emit `${keysBuf} = inttoptr i64 ${keysInt} to ptr`

        objLenReg: str = self.codegen.newReg
        self.codegen.emit `${objLenReg} = load i64, ptr ${keysBuf}`

        firstSlot: str = self.codegen.newReg
        self.codegen.emit `${firstSlot} = alloca ptr`
        self.exprGen.addSymbol node.name, firstSlot, TypeKind.Str, false, true

        secondSlot: str = ""
        valsBuf: str = ""
        if node.val.ln > 0 {
            valsOff: num = self.exprGen.objGen.registry.getFieldOffset "", "__vals"
            vSlotGep: str = self.codegen.newReg
            self.codegen.emit `${vSlotGep} = getelementptr inbounds i64, ptr ${collRes.reg}, i64 ${valsOff}`
            valsInt: str = self.codegen.newReg
            self.codegen.emit `${valsInt} = load i64, ptr ${vSlotGep}`
            valsBuf = self.codegen.newReg
            self.codegen.emit `${valsBuf} = inttoptr i64 ${valsInt} to ptr`

            secondSlot = self.codegen.newReg
            self.codegen.emit `${secondSlot} = alloca i64`
            self.exprGen.addSymbol node.val, secondSlot, TypeKind.I64, false, true
        }

        self.codegen.emit `br label %${condLbl}`
        self.codegen.emitLabel condLbl

        curIdxReg: str = self.codegen.newReg
        self.codegen.emit `${curIdxReg} = load i64, ptr ${idxSlot}`
        hasMore: str = self.codegen.newReg
        self.codegen.emit `${hasMore} = icmp ult i64 ${curIdxReg}, ${objLenReg}`
        self.codegen.emit `br i1 ${hasMore}, label %${bodyLbl}, label %${endLbl}`

        self.codegen.emitLabel bodyLbl
        kElemOffset: str = self.codegen.newReg
        self.codegen.emit `${kElemOffset} = add i64 ${curIdxReg}, 1`
        kGep: str = self.codegen.newReg
        self.codegen.emit `${kGep} = getelementptr inbounds i64, ptr ${keysBuf}, i64 ${kElemOffset}`
        kInt: str = self.codegen.newReg
        self.codegen.emit `${kInt} = load i64, ptr ${kGep}`
        kPtr: str = self.codegen.newReg
        self.codegen.emit `${kPtr} = inttoptr i64 ${kInt} to ptr`
        self.codegen.emit `store ptr ${kPtr}, ptr ${firstSlot}`

        if secondSlot.ln > 0 {
            vGep: str = self.codegen.newReg
            self.codegen.emit `${vGep} = getelementptr inbounds i64, ptr ${valsBuf}, i64 ${kElemOffset}`
            vInt: str = self.codegen.newReg
            self.codegen.emit `${vInt} = load i64, ptr ${vGep}`
            self.codegen.emit `store i64 ${vInt}, ptr ${secondSlot}`
        }

        self.emitStmt node.children[1]
        self.codegen.emit `br label %${stepLbl}`

        self.codegen.emitLabel stepLbl
        sIdx: str = self.codegen.newReg
        self.codegen.emit `${sIdx} = load i64, ptr ${idxSlot}`
        nextIdx: str = self.codegen.newReg
        self.codegen.emit `${nextIdx} = add i64 ${sIdx}, 1`
        self.codegen.emit `store i64 ${nextIdx}, ptr ${idxSlot}`
        self.codegen.emit `br label %${condLbl}`

        self.codegen.emitLabel endLbl
        self.breakLabels.pp
        self.continueLabels.pp
    },

    /**
     * Emits a pattern matching switch statement using LLVM switch i64 instruction.
     *
     * @param {ASTNode} node - SwStmt AST node
     * @returns {void}
     */
    emitSw: node: ASTNode :: void => {
        hasResultArm: bool = false
        fr arm of node.cases {
            if arm.patternKind == "ok" || arm.patternKind == "err" {
                hasResultArm = true
                brk
            }
        }

        if hasResultArm {
            targetRes: ExprResult = self.exprGen.emitExpr node.children[0]
            ptrTargetReg: str = targetRes.reg
            if !(isPointerType targetRes.typeKind) {
                intTargetReg: str = targetRes.reg
                if targetRes.typeKind == TypeKind.Num {
                    convReg: str = self.codegen.newReg
                    self.codegen.emit `${convReg} = fptosi double ${targetRes.reg} to i64`
                    intTargetReg = convReg
                }
                cPtrReg: str = self.codegen.newReg
                self.codegen.emit `${cPtrReg} = inttoptr i64 ${intTargetReg} to ptr`
                ptrTargetReg = cPtrReg
            }

            tagGep: str = self.codegen.newReg
            self.codegen.emit `${tagGep} = getelementptr inbounds { i64, i64 }, ptr ${ptrTargetReg}, i32 0, i32 0`
            tagVal: str = self.codegen.newReg
            self.codegen.emit `${tagVal} = load i64, ptr ${tagGep}`

            valGep: str = self.codegen.newReg
            self.codegen.emit `${valGep} = getelementptr inbounds { i64, i64 }, ptr ${ptrTargetReg}, i32 0, i32 1`
            valVal: str = self.codegen.newReg
            self.codegen.emit `${valVal} = load i64, ptr ${valGep}`

            okLabel: str = self.codegen.newLabel "match_ok"
            errLabel: str = self.codegen.newLabel "match_err"
            endLabel: str = self.codegen.newLabel "match_end"

            isOkReg: str = self.codegen.newReg
            self.codegen.emit `${isOkReg} = icmp eq i64 ${tagVal}, 1`
            self.codegen.emit `br i1 ${isOkReg}, label %${okLabel}, label %${errLabel}`

            // OK Arm
            self.codegen.emitLabel okLabel
            cIdx: num = 0
            fr arm of node.cases {
                if arm.patternKind == "ok" {
                    savedSyms: num = self.exprGen.symbols.ln
                    childIdx: num = cIdx + 1
                    if arm.varName.ln > 0 && arm.varName != "_" {
                        varSlot: str = self.codegen.newReg
                        self.codegen.emit `${varSlot} = alloca i64`
                        self.codegen.emit `store i64 ${valVal}, ptr ${varSlot}`
                        self.exprGen.addSymbol arm.varName, varSlot, TypeKind.I64, false, true
                    }
                    if childIdx < node.children.ln {
                        self.emitStmt node.children[childIdx]
                    }
                    wh self.exprGen.symbols.ln > savedSyms {
                        self.exprGen.symbols.pp
                    }
                    brk
                }
                cIdx++
            }
            self.codegen.emit `br label %${endLabel}`

            // ERR Arm
            self.codegen.emitLabel errLabel
            cIdx = 0
            fr arm of node.cases {
                if arm.patternKind == "err" {
                    savedSyms: num = self.exprGen.symbols.ln
                    childIdx: num = cIdx + 1
                    if arm.varName.ln > 0 && arm.varName != "_" {
                        varSlot: str = self.codegen.newReg
                        self.codegen.emit `${varSlot} = alloca i64`
                        self.codegen.emit `store i64 ${valVal}, ptr ${varSlot}`
                        self.exprGen.addSymbol arm.varName, varSlot, TypeKind.I64, false, true
                    }
                    if childIdx < node.children.ln {
                        self.emitStmt node.children[childIdx]
                    }
                    wh self.exprGen.symbols.ln > savedSyms {
                        self.exprGen.symbols.pp
                    }
                    brk
                }
                cIdx++
            }
            self.codegen.emit `br label %${endLabel}`

            self.codegen.emitLabel endLabel
            ->
        }

        targetRes: ExprResult = self.exprGen.emitExpr node.children[0]

        defaultLbl: str = self.codegen.newLabel "sw_def"
        mergeLbl: str = self.codegen.newLabel "sw_merge"

        isStrSw: bool = (targetRes.typeKind == TypeKind.Str || targetRes.typeKind == TypeKind.Ptr)
        if !isStrSw {
            fr arm of node.cases {
                if arm.patternKind == "str" {
                    isStrSw = true
                    brk
                }
            }
        }

        caseLabels: str[] = []
        armIdx: num = 0
        defArmIdx: num = -1
        fr arm of node.cases {
            if arm.litText == "_" || arm.patternKind == "_" || arm.varName == "_" {
                caseLabels.psh defaultLbl
                defArmIdx = armIdx
            } els {
                cLbl: str = self.codegen.newLabel `sw_case_${armIdx}`
                caseLabels.psh cLbl
            }
            armIdx++
        }

        if isStrSw {
            sPtr: str = targetRes.reg
            if targetRes.typeKind != TypeKind.Str && targetRes.typeKind != TypeKind.Ptr {
                cReg: str = self.codegen.newReg
                self.codegen.emit `${cReg} = inttoptr i64 ${targetRes.reg} to ptr`
                sPtr = cReg
            }

            caseIdx: num = 0
            fr arm of node.cases {
                if caseIdx != defArmIdx {
                    cLbl: str = caseLabels[caseIdx]
                    nextCheckLbl: str = self.codegen.newLabel `sw_chk_${caseIdx}`
                    litConst: str = self.codegen.addStringConstant arm.litText
                    litPtr: str = self.codegen.newReg
                    self.codegen.emit `${litPtr} = getelementptr inbounds i8, ptr ${litConst}, i64 0`
                    scmp: str = self.codegen.newReg
                    self.codegen.emit `${scmp} = call i32 @strcmp(ptr ${sPtr}, ptr ${litPtr})`
                    condReg: str = self.codegen.newReg
                    self.codegen.emit `${condReg} = icmp eq i32 ${scmp}, 0`
                    self.codegen.emit `br i1 ${condReg}, label %${cLbl}, label %${nextCheckLbl}`
                    self.codegen.emitLabel nextCheckLbl
                }
                caseIdx++
            }
            self.codegen.emit `br label %${defaultLbl}`
        } els {
            boxedTarget: str = boxValueToI64 self.codegen, targetRes.reg, targetRes.typeKind
            swTable: str = `switch i64 ${boxedTarget}, label %${defaultLbl} [\n`
            caseIdx: num = 0
            fr arm of node.cases {
                if caseIdx != defArmIdx {
                    tagVal: str = arm.litText
                    if tagVal == "yes" || tagVal == "true" {
                        tagVal = "1"
                    } els if tagVal == "no" || tagVal == "false" {
                        tagVal = "0"
                    }
                    if arm.patternKind != "ident" && arm.patternKind != "_" && arm.patternKind != "num" && arm.patternKind != "str" && arm.patternKind.ln > 0 {
                        disc: num = self.exprGen.objGen.registry.getEnumVariantVal arm.patternKind, arm.varName
                        if disc >= 0 {
                            tagVal = `${disc}`
                        }
                    }
                    if tagVal == arm.litText {
                        disc: num = self.exprGen.objGen.registry.findVariantVal arm.varName
                        if disc >= 0 {
                            tagVal = `${disc}`
                        }
                    }
                    if tagVal.ln == 0 {
                        tagVal = `${caseIdx}`
                    }
                    cLbl: str = caseLabels[caseIdx]
                    swTable = swTable + `    i64 ${tagVal}, label %${cLbl}\n`
                }
                caseIdx++
            }
            swTable = swTable + "  ]"
            self.codegen.emitRaw swTable
        }

        childArmIdx: num = 1
        labelArmIdx: num = 0
        fr arm of node.cases {
            cLbl: str = caseLabels[labelArmIdx]
            self.codegen.emitLabel cLbl
            if childArmIdx < node.children.ln {
                self.emitStmt node.children[childArmIdx]
            }
            self.codegen.emit `br label %${mergeLbl}`
            childArmIdx++
            labelArmIdx++
        }

        if defArmIdx < 0 {
            self.codegen.emitLabel defaultLbl
            self.codegen.emit `br label %${mergeLbl}`
        }

        self.codegen.emitLabel mergeLbl
    },

    /**
     * Emits a return statement with widening if applicable.
     *
     * @param {ASTNode} node - RetStmt AST node
     * @returns {void}
     */
    emitRet: node: ASTNode :: void => {
        hasVal: bool = (node.children.ln > 0 && node.children[0].kind != NodeKind.NilExpr)

        if self.isAsync {
            retValReg: str = "0"
            if hasVal {
                retRes: ExprResult = self.exprGen.emitExpr node.children[0]
                if retRes.typeKind == TypeKind.Num {
                    cReg: str = self.codegen.newReg
                    self.codegen.emit `${cReg} = fptosi double ${retRes.reg} to i64`
                    retValReg = cReg
                } els if retRes.typeKind == TypeKind.Bool || retRes.typeKind == TypeKind.I8 {
                    cReg: str = self.codegen.newReg
                    srcLLVM: str = (retRes.typeKind == TypeKind.Bool) ? "i1" : "i8"
                    self.codegen.emit `${cReg} = zext ${srcLLVM} ${retRes.reg} to i64`
                    retValReg = cReg
                } els if retRes.typeKind == TypeKind.I32 {
                    cReg: str = self.codegen.newReg
                    self.codegen.emit `${cReg} = sext i32 ${retRes.reg} to i64`
                    retValReg = cReg
                } els if retRes.typeKind == TypeKind.Str || retRes.typeKind == TypeKind.Ptr || retRes.typeKind == TypeKind.Arr || retRes.typeKind == TypeKind.Obj {
                    cReg: str = self.codegen.newReg
                    self.codegen.emit `${cReg} = ptrtoint ptr ${retRes.reg} to i64`
                    retValReg = cReg
                } els {
                    retValReg = retRes.reg
                }
            }
            self.codegen.emit `call void @zuv_prm_resolve(ptr ${self.asyncPrmReg}, i64 ${retValReg})`
            if self.asyncPrevModeReg.ln > 0 {
                self.codegen.emit `call void @zuv_set_async_context(i32 ${self.asyncPrevModeReg})`
            }
            prmInt: str = self.codegen.newReg
            self.codegen.emit `${prmInt} = ptrtoint ptr ${self.asyncPrmReg} to i64`
            self.codegen.emit `ret i64 ${prmInt}`
            ->
        }

        if hasVal {
            retRes: ExprResult = self.exprGen.emitExpr node.children[0]
            if self.returnType == TypeKind.I32 && retRes.typeKind == TypeKind.I64 {
                tReg: str = self.codegen.newReg
                self.codegen.emit `${tReg} = trunc i64 ${retRes.reg} to i32`
                self.codegen.emit `ret i32 ${tReg}`
            } els if self.returnType == TypeKind.I32 && retRes.typeKind == TypeKind.Num {
                tReg: str = self.codegen.newReg
                self.codegen.emit `${tReg} = fptosi double ${retRes.reg} to i32`
                self.codegen.emit `ret i32 ${tReg}`
            } els if self.returnType == TypeKind.I64 && retRes.typeKind == TypeKind.I8 {
                wReg: str = self.codegen.newReg
                self.codegen.emit `${wReg} = zext i8 ${retRes.reg} to i64`
                self.codegen.emit `ret i64 ${wReg}`
            } els if self.returnType == TypeKind.I64 && retRes.typeKind == TypeKind.I16 {
                wReg: str = self.codegen.newReg
                self.codegen.emit `${wReg} = zext i16 ${retRes.reg} to i64`
                self.codegen.emit `ret i64 ${wReg}`
            } els if self.returnType == TypeKind.I64 && retRes.typeKind == TypeKind.I32 {
                wReg: str = self.codegen.newReg
                self.codegen.emit `${wReg} = zext i32 ${retRes.reg} to i64`
                self.codegen.emit `ret i64 ${wReg}`
            } els if self.returnType == TypeKind.I64 && retRes.typeKind == TypeKind.Bool {
                wReg: str = self.codegen.newReg
                self.codegen.emit `${wReg} = zext i1 ${retRes.reg} to i64`
                self.codegen.emit `ret i64 ${wReg}`
            } els if self.returnType == TypeKind.I64 && retRes.typeKind == TypeKind.Num {
                cReg: str = self.codegen.newReg
                self.codegen.emit `${cReg} = fptosi double ${retRes.reg} to i64`
                self.codegen.emit `ret i64 ${cReg}`
            } els if self.returnType == TypeKind.Num && retRes.typeKind == TypeKind.I64 {
                cReg: str = self.codegen.newReg
                self.codegen.emit `${cReg} = sitofp i64 ${retRes.reg} to double`
                self.codegen.emit `ret double ${cReg}`
            } els if self.returnType == TypeKind.Num && retRes.typeKind == TypeKind.I32 {
                cReg: str = self.codegen.newReg
                self.codegen.emit `${cReg} = sitofp i32 ${retRes.reg} to double`
                self.codegen.emit `ret double ${cReg}`
            } els if self.returnType == TypeKind.I64 && (retRes.typeKind == TypeKind.Str || retRes.typeKind == TypeKind.Ptr || retRes.typeKind == TypeKind.Arr || retRes.typeKind == TypeKind.Obj) {
                cReg: str = self.codegen.newReg
                self.codegen.emit `${cReg} = ptrtoint ptr ${retRes.reg} to i64`
                self.codegen.emit `ret i64 ${cReg}`
            } els if (self.returnType == TypeKind.Str || self.returnType == TypeKind.Ptr || self.returnType == TypeKind.Arr || self.returnType == TypeKind.Obj) && retRes.typeKind == TypeKind.I64 {
                cReg: str = self.codegen.newReg
                self.codegen.emit `${cReg} = inttoptr i64 ${retRes.reg} to ptr`
                self.codegen.emit `ret ptr ${cReg}`
            } els if self.returnType == TypeKind.Void {
                self.codegen.emit `ret void`
            } els {
                retTypeStr: str = llvmType self.returnType
                self.codegen.emit `ret ${retTypeStr} ${retRes.reg}`
            }
        } els {
            if self.returnType == TypeKind.Void {
                self.codegen.emit `ret void`
            } els {
                rStr: str = llvmType self.returnType
                dVal: str = selectDefaultValue self.returnType
                self.codegen.emit `ret ${rStr} ${dVal}`
            }
        }
    },

    /**
     * Emits a break branch jumping to the enclosing loop's exit label.
     *
     * @param {ASTNode} node - BrkStmt AST node
     * @returns {void}
     */
    emitBrk: node: ASTNode :: void => {
        if self.breakLabels.ln > 0 {
            bLbl: str = self.breakLabels[self.breakLabels.ln - 1]
            self.codegen.emit `br label %${bLbl}`
        }
    },

    /**
     * Emits a continue branch jumping to the enclosing loop's condition/step label.
     *
     * @param {ASTNode} node - ContStmt AST node
     * @returns {void}
     */
    emitCont: node: ASTNode :: void => {
        if self.continueLabels.ln > 0 {
            cLbl: str = self.continueLabels[self.continueLabels.ln - 1]
            self.codegen.emit `br label %${cLbl}`
        }
    },

    /**
     * Emits a panic termination calling abort and emitting unreachable.
     *
     * @param {ASTNode} node - PanicStmt AST node
     * @returns {void}
     */
    emitPanic: node: ASTNode :: void => {
        msgPtr: str = ""
        if node.children.ln > 0 {
            cRes: ExprResult = self.exprGen.emitExpr node.children[0]
            if cRes.typeKind == TypeKind.Str || cRes.typeKind == TypeKind.Ptr {
                msgPtr = cRes.reg
            } els {
                msgPtr = self.codegen.addStringConstant "panic"
            }
        } els {
            msgPtr = self.codegen.addStringConstant "panic"
        }
        fileSym: str = self.codegen.addStringConstant "main.zv"
        self.codegen.emit `call void @zuv_panic(ptr ${msgPtr}, ptr ${fileSym}, i32 ${node.line})`
        self.codegen.emit `unreachable`
    },

    /**
     * Emits a try/catch block executing the guarded block safely.
     *
     * @param {ASTNode} node - TryCthStmt AST node
     * @returns {void}
     */
    emitTryCth: node: ASTNode :: void => {
        tryLbl: str = self.codegen.newLabel "try_body"
        catchLbl: str = self.codegen.newLabel "try_catch"
        endLbl: str = self.codegen.newLabel "try_end"

        oldCatch: str = self.exprGen.activeCatchLabel
        self.exprGen.activeCatchLabel = catchLbl

        self.codegen.emit `br label %${tryLbl}`
        self.codegen.emitLabel tryLbl

        if node.children.ln > 0 {
            self.emitStmt node.children[0]
        }

        self.codegen.emit `br label %${endLbl}`

        self.exprGen.activeCatchLabel = oldCatch

        self.codegen.emitLabel catchLbl
        errVarName: str = node.name
        if errVarName.ln > 0 {
            errSlot: str = self.codegen.newReg
            self.codegen.emit `${errSlot} = alloca i64`
            eLoaded: str = self.codegen.newReg
            self.codegen.emit `${eLoaded} = load i64, ptr @zuv_exc_value`
            self.codegen.emit `store i64 ${eLoaded}, ptr ${errSlot}`
            self.exprGen.addSymbol errVarName, errSlot, TypeKind.I64, false, true
        }

        if node.children.ln > 1 && node.children[1].kind != NodeKind.NilExpr {
            self.emitStmt node.children[1]
        }

        self.codegen.emit `br label %${endLbl}`
        self.codegen.emitLabel endLbl
    }
}
