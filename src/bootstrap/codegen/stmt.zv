/*
 * =============================================================================
 * Zuv Bootstrap Compiler — Statement & Control Flow Code Generation
 * Path: sub_projects/zuv/src/bootstrap/codegen/stmt.zv
 *
 * Implements code generation for all statements and control flow structures:
 * - Variable declarations (alloca stack slot, initializer evaluation, symbol registration)
 * - If/else branching with block merging and deterministic label allocation
 * - While loops and for-of array iterations with break/continue tracking
 * - Pattern matching switches using LLVM switch i64 instruction tables
 * - Return statements with integer widening (zext i8 to i64, zext i1 to i64)
 * - Break and continue jumps within loop contexts
 * - Panic error statements and unreachable trap emissions
 * =============================================================================
 */

imp TypeKind frm ../types
imp ASTNode frm ../ast
imp Codegen frm codegen/codegen
imp ExprCodegen frm codegen/expr

imp EmitStmt frm stmt/emitStmt
imp EmitVarDecl frm stmt/emitVarDecl
imp EmitBlock frm stmt/emitBlock
imp EmitExprStmt frm stmt/emitExprStmt
imp EmitIf frm stmt/emitIf
imp EmitWh frm stmt/emitWh
imp EmitFrOf frm stmt/emitFrOf
imp EmitFrIn frm stmt/emitFrIn
imp EmitSw frm stmt/emitSw
imp EmitRet frm stmt/emitRet
imp EmitBrk frm stmt/emitBrk
imp EmitCont frm stmt/emitCont
imp EmitPanic frm stmt/emitPanic
imp EmitTryCth frm stmt/emitTryCth
imp EmitDestructure frm stmt/emitDestructure

/**
 * Coordinates statement lowering and control flow graph construction.
 */
obj StmtCodegen {
    codegen: Codegen,
    exprGen: ExprCodegen,
    breakLabels: str[],
    continueLabels: str[],
    returnType: TypeKind,
    isTopLevel: bool,
    isAsync: bool,
    asyncPrmReg: str,
    asyncPrevModeReg: str,

    /**
     * Initializes a new StmtCodegen coordinator instance.
     *
     * @param {Codegen} codegen - LLVM module coordinator
     * @param {ExprCodegen} exprGen - Expression code generation coordinator
     * @returns {StmtCodegen} Initialized StmtCodegen instance
     */
    create: codegen: Codegen, exprGen: ExprCodegen :: StmtCodegen => {
        emptyBrk: str[] = []
        emptyCont: str[] = []
        -> {
            codegen,
            exprGen,
            breakLabels: emptyBrk,
            continueLabels: emptyCont,
            returnType: TypeKind.Void,
            isTopLevel: false,
            isAsync: false,
            asyncPrmReg: "",
            asyncPrevModeReg: ""
        }
    },

    setAsyncFunc: prmReg: str, prevModeReg: str :: void => {
        self.isAsync = true
        self.asyncPrmReg = prmReg
        self.asyncPrevModeReg = prevModeReg
    },

    clearAsyncFunc: :: void => {
        self.isAsync = false
        self.asyncPrmReg = ""
        self.asyncPrevModeReg = ""
    },

    /**
     * Sets whether current statement lowering is occurring at the module top level.
     *
     * @param {bool} isTop - True if top level module scope
     * @returns {void}
     */
    setTopLevel: isTop: bool :: void => {
        self.isTopLevel = isTop
    },

    /**
     * Sets the expected return type for the enclosing function body.
     *
     * @param {TypeKind} returnType - Semantic return type
     * @returns {void}
     */
    setReturnType: returnType: TypeKind :: void => {
        self.returnType = returnType
    },

    emitStmt: node: ASTNode :: void => EmitStmt(self, node),
    emitVarDecl: node: ASTNode :: void => EmitVarDecl(self, node),
    emitBlock: node: ASTNode :: void => EmitBlock(self, node),
    emitExprStmt: node: ASTNode :: void => EmitExprStmt(self, node),
    emitIf: node: ASTNode :: void => EmitIf(self, node),
    emitWh: node: ASTNode :: void => EmitWh(self, node),
    emitFrOf: node: ASTNode :: void => EmitFrOf(self, node),
    emitFrIn: node: ASTNode :: void => EmitFrIn(self, node),
    emitSw: node: ASTNode :: void => EmitSw(self, node),
    emitRet: node: ASTNode :: void => EmitRet(self, node),
    emitBrk: node: ASTNode :: void => EmitBrk(self, node),
    emitCont: node: ASTNode :: void => EmitCont(self, node),
    emitPanic: node: ASTNode :: void => EmitPanic(self, node),
    emitTryCth: node: ASTNode :: void => EmitTryCth(self, node),
    emitDestructure: node: ASTNode :: void => EmitDestructure(self, node)
}
