/*
 * =============================================================================
 * Zuv Bootstrap Compiler — EmitBrk Statement Emitter
 * Path: sub_projects/zuv/src/bootstrap/codegen/stmt/emitBrk.zv
 * =============================================================================
 */

imp ASTNode frm ../../ast
imp StmtCodegen frm ../stmt

EmitBrk self: StmtCodegen, node: ASTNode :: void {
        if self.breakLabels.ln > 0 {
            bLbl: str = self.breakLabels[self.breakLabels.ln - 1]
            self.codegen.emit `br label %${bLbl}`
        }
}
