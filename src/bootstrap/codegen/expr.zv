/*
 * =============================================================================
 * Zuv Bootstrap Compiler — Expression Code Generation
 * Path: sub_projects/zuv/src/bootstrap/codegen/expr.zv
 *
 * Implements SSA virtual register evaluation for all Zuv expression forms:
 * - Literals: numbers, deduplicated pooled strings (@str_N), booleans, nil, und, BigInt
 * - Scoped identifier loading from alloca stack slots or direct SSA registers
 * - Unary prefix/postfix operators: -, !, ~, ++, --
 * - Binary arithmetic, bitwise, comparison, logical, and assignment operators
 * - Function and method call dispatch with ABI argument type formatting
 * - Bounds-checked array indexing, property loads, and property mutations
 * - Array and object literal instantiation via runtime helpers
 * - Explicit type cast lowering and ternary conditional branch merging
 * =============================================================================
 */

imp TypeKind frm ../types
imp ASTNode, FieldEntry frm ../ast
imp Codegen frm codegen/codegen
imp ArrayCodegen frm codegen/array
imp ObjectCodegen frm codegen/decl

imp EmitExpr frm expr/emitExpr
imp EmitNum frm expr/emitNum
imp EmitStr frm expr/emitStr
imp EmitBool frm expr/emitBool
imp EmitNil frm expr/emitNil
imp EmitUnd frm expr/emitUnd
imp EmitBigInt frm expr/emitBigInt
imp EmitIdent frm expr/emitIdent
imp EmitUnary frm expr/emitUnary
imp EmitBinary frm expr/emitBinary
imp EmitCall frm expr/emitCall
imp EmitMethodCall frm expr/emitMethodCall
imp EmitIndex frm expr/emitIndex
imp EmitProp frm expr/emitProp
imp EmitArr frm expr/emitArr
imp EmitObjLit frm expr/emitObjLit
imp EmitCast frm expr/emitCast
imp EmitTernary frm expr/emitTernary
imp EmitTyp frm expr/emitTyp
imp EmitAwait frm expr/emitAwait
imp EmitNew frm expr/emitNew
imp EmitBorrow frm expr/emitBorrow
imp EmitSym frm expr/emitSym
imp EmitDefault frm expr/emitDefault
/**
 * Result descriptor produced by evaluating an expression AST node.
 */
type ExprResult = {
    reg: str;
    typeKind: TypeKind;
};

type FuncSignature = {
    name: str;
    retType: str;
    paramTypes: str[];
    hasRest: bool;
    retTypeKind: TypeKind;
    retTypeName: str;
};

/**
 * Symbol entry in the active function or block lexical scope.
 */
type ScopeSymbol = {
    name: str;
    reg: str;
    typeKind: TypeKind;
    typeName: str;
    isPtr: bool;
    isAlloca: bool;
    decorRole: num;
    initFlagReg: str;
};

/**
 * Coordinates expression evaluation and virtual register emission.
 */
obj ExprCodegen {
    codegen: Codegen,
    symbols: ScopeSymbol[],
    globalSymbols: ScopeSymbol[],
    objGen: ObjectCodegen,
    arrGen: ArrayCodegen,
    funcSigs: FuncSignature[],
    activeCatchLabel: str,
    decorRoles: FieldEntry[],
    decoratedMethods: str[],
    methodMappings: FieldEntry[],
    symNames: str[],

    /**
     * Initializes a new ExprCodegen coordinator.
     *
     * @param {Codegen} codegen - LLVM module coordinator
     * @param {ObjectCodegen} objGen - Object and struct layout coordinator
     * @param {ArrayCodegen} arrGen - Array runtime coordinator
     * @returns {ExprCodegen} Initialized ExprCodegen instance
     */
    create: codegen: Codegen, objGen: ObjectCodegen, arrGen: ArrayCodegen :: ExprCodegen => {
        emptySymbols: ScopeSymbol[] = []
        emptyGlobals: ScopeSymbol[] = []
        emptySigs: FuncSignature[] = []
        emptyDecorRoles: FieldEntry[] = []
        emptyDecorMethods: str[] = []
        emptyMappings: FieldEntry[] = []
        emptySymNames: str[] = []
        -> {
            codegen,
            symbols: emptySymbols,
            globalSymbols: emptyGlobals,
            objGen,
            arrGen,
            funcSigs: emptySigs,
            activeCatchLabel: "",
            decorRoles: emptyDecorRoles,
            decoratedMethods: emptyDecorMethods,
            methodMappings: emptyMappings,
            symNames: emptySymNames
        }
    },

    setDecorRole: name: str, role: num :: void => {
        entry: FieldEntry = {
            name: name,
            valStr: "" + role,
            isSpread: false,
            line: 0,
            col: 0
        }
        self.decorRoles.psh entry
    },

    getDecorRole: name: str :: num => {
        fr item of self.decorRoles {
            if item.name == name {
                if item.valStr == "1" { -> 1 }
                if item.valStr == "2" { -> 2 }
                if item.valStr == "3" { -> 3 }
            }
        }
        -> 0
    },

    addMethodMapping: mName: str, mangled: str :: void => {
        entry: FieldEntry = {
            name: mName,
            valStr: mangled,
            isSpread: false,
            line: 0,
            col: 0
        }
        self.methodMappings.psh entry
    },

    getMethodMapping: mName: str :: str => {
        fr item of self.methodMappings {
            if item.name == mName {
                -> item.valStr
            }
        }
        -> ""
    },

    isDecoratedMethod: name: str :: bool => {
        fr dm of self.decoratedMethods {
            if dm == name {
                -> true
            }
        }
        -> false
    },

    /**
     * Registers a named symbol into the lexical scope table.
     *
     * @param {str} name - Variable or parameter identifier
     * @param {str} reg - Allocated SSA register or alloca pointer
     * @param {TypeKind} typeKind - Semantic type of the symbol
     * @param {bool} isPtr - True if reference pointer
     * @param {bool} isAlloca - True if stack-allocated alloca slot
     * @returns {void}
     */
    addSymbol: name: str, reg: str, typeKind: TypeKind, isPtr: bool, isAlloca: bool :: void => {
        newSym: ScopeSymbol = {
            name,
            reg,
            typeKind,
            typeName: "",
            isPtr,
            isAlloca,
            decorRole: 0,
            initFlagReg: ""
        }
        self.symbols.psh newSym
    },

    addSymbolWithRole: name: str, reg: str, typeKind: TypeKind, isPtr: bool, isAlloca: bool, decorRole: num :: void => {
        newSym: ScopeSymbol = {
            name,
            reg,
            typeKind,
            typeName: "",
            isPtr,
            isAlloca,
            decorRole,
            initFlagReg: ""
        }
        self.symbols.psh newSym
    },

    addSymbolWithType: name: str, reg: str, typeKind: TypeKind, typeName: str, isPtr: bool, isAlloca: bool :: void => {
        newSym: ScopeSymbol = {
            name,
            reg,
            typeKind,
            typeName,
            isPtr,
            isAlloca,
            decorRole: 0,
            initFlagReg: ""
        }
        self.symbols.psh newSym
    },

    addSymbolWithInitFlag: name: str, reg: str, typeKind: TypeKind, typeName: str, isPtr: bool, isAlloca: bool, initFlagReg: str :: void => {
        newSym: ScopeSymbol = {
            name,
            reg,
            typeKind,
            typeName,
            isPtr,
            isAlloca,
            decorRole: 0,
            initFlagReg
        }
        self.symbols.psh newSym
    },

    /**
     * Registers a named module-level global symbol.
     *
     * @param {str} name - Variable identifier
     * @param {str} reg - LLVM global variable name (@global_xxx)
     * @param {TypeKind} typeKind - Semantic type of the global
     * @returns {void}
     */
    addGlobalSymbol: name: str, reg: str, typeKind: TypeKind :: void => {
        newSym: ScopeSymbol = {
            name,
            reg,
            typeKind,
            typeName: "",
            isPtr: false,
            isAlloca: true,
            decorRole: 0,
            initFlagReg: ""
        }
        self.globalSymbols.psh newSym
    },

    addGlobalSymbolWithType: name: str, reg: str, typeKind: TypeKind, typeName: str :: void => {
        newSym: ScopeSymbol = {
            name,
            reg,
            typeKind,
            typeName,
            isPtr: false,
            isAlloca: true,
            decorRole: 0,
            initFlagReg: ""
        }
        self.globalSymbols.psh newSym
    },

    addGlobalSymbolWithInitFlag: name: str, reg: str, typeKind: TypeKind, typeName: str, initFlagReg: str :: void => {
        newSym: ScopeSymbol = {
            name,
            reg,
            typeKind,
            typeName,
            isPtr: false,
            isAlloca: true,
            decorRole: 0,
            initFlagReg
        }
        self.globalSymbols.psh newSym
    },

    /**
     * Finds a module-level global symbol by identifier.
     *
     * @param {str} name - Global variable identifier to look up
     * @returns {ScopeSymbol} Found symbol or empty record
     */
    findGlobalSymbol: name: str :: ScopeSymbol => {
        found: ScopeSymbol = {
            name: "",
            reg: "",
            typeKind: TypeKind.Unknown,
            typeName: "",
            isPtr: false,
            isAlloca: false,
            decorRole: 0,
            initFlagReg: ""
        }
        fr gItem of self.globalSymbols {
            if gItem.name == name {
                found = gItem
            }
        }
        -> found
    },

    /**
     * Updates the semantic type of a module-level global symbol.
     *
     * @param {str} name - Global variable identifier
     * @param {TypeKind} typeKind - Updated semantic type
     * @param {str} typeName - Updated struct/type name annotation
     * @returns {void}
     */
    setGlobalSymbolType: name: str, typeKind: TypeKind, typeName: str :: void => {
        idx: num = 0
        fr gItem of self.globalSymbols {
            if gItem.name == name {
                effTypeName: str = typeName.ln > 0 ? typeName : gItem.typeName
                updated: ScopeSymbol = {
                    name: gItem.name,
                    reg: gItem.reg,
                    typeKind,
                    typeName: effTypeName,
                    isPtr: gItem.isPtr,
                    isAlloca: gItem.isAlloca,
                    decorRole: gItem.decorRole,
                    initFlagReg: gItem.initFlagReg
                }
                self.globalSymbols[idx] = updated
            }
            idx++
        }
    },

    setSymbolType: name: str, typeKind: TypeKind, typeName: str :: void => {
        idx: num = 0
        fr item of self.symbols {
            if item.name == name {
                effTypeName: str = typeName.ln > 0 ? typeName : item.typeName
                updated: ScopeSymbol = {
                    name: item.name,
                    reg: item.reg,
                    typeKind,
                    typeName: effTypeName,
                    isPtr: item.isPtr,
                    isAlloca: item.isAlloca,
                    decorRole: item.decorRole,
                    initFlagReg: item.initFlagReg
                }
                self.symbols[idx] = updated
            }
            idx++
        }
    },

    /**
     * Resolves a symbol by identifier from lexical scope table, falling back to globals.
     *
     * @param {str} name - Variable identifier to look up
     * @returns {ScopeSymbol} Found symbol or empty record
     */
    findSymbol: name: str :: ScopeSymbol => {
        found: ScopeSymbol = {
            name: "",
            reg: "",
            typeKind: TypeKind.Unknown,
            typeName: "",
            isPtr: false,
            isAlloca: false,
            decorRole: 0,
            initFlagReg: ""
        }
        fr item of self.symbols {
            if item.name == name {
                found = item
            }
        }
        if found.name.ln > 0 {
            -> found
        }
        fr gItem of self.globalSymbols {
            if gItem.name == name {
                found = gItem
            }
        }
        -> found
    },

    /**
     * Registers a user function signature for argument coercions.
     *
     * @param {str} name - Function name
     * @param {str} retType - LLVM return type string
     * @param {str[]} paramTypes - LLVM parameter type strings
     * @returns {void}
     */
    registerFunc: name: str, retType: str, paramTypes: str[], hasRest: bool, retTypeKind: TypeKind, retTypeName: str :: void => {
        self.funcSigs.psh {
            name,
            retType,
            paramTypes,
            hasRest,
            retTypeKind,
            retTypeName
        }
    },

    /**
     * Looks up a registered function signature by name.
     *
     * @param {str} name - Function name to find
     * @returns {FuncSignature} Found signature or empty
     */
    findFunc: name: str :: FuncSignature => {
        fr fnSig of self.funcSigs {
            if fnSig.name == name {
                -> fnSig
            }
        }
        emptyParams: str[] = []
        emptySig: FuncSignature = {
            name: "",
            retType: "",
            paramTypes: emptyParams,
            hasRest: false,
            retTypeKind: TypeKind.Unknown,
            retTypeName: ""
        }
        -> emptySig
    },

    hasFunc: name: str :: bool => {
        fr fnSig of self.funcSigs {
            if fnSig.name == name {
                -> true
            }
        }
        -> false
    },

    /**
     * Clears all local scope symbols.
     *
     * @returns {void}
     */
    clearSymbols: :: void => {
        self.symbols = []
    },

    emitExpr: node: ASTNode :: ExprResult => EmitExpr(self, node),
    emitNum: node: ASTNode :: ExprResult => EmitNum(self, node),
    emitStr: node: ASTNode :: ExprResult => EmitStr(self, node),
    emitBool: node: ASTNode :: ExprResult => EmitBool(self, node),
    emitNil: node: ASTNode :: ExprResult => EmitNil(self, node),
    emitUnd: node: ASTNode :: ExprResult => EmitUnd(self, node),
    emitBigInt: node: ASTNode :: ExprResult => EmitBigInt(self, node),
    emitIdent: node: ASTNode :: ExprResult => EmitIdent(self, node),
    emitUnary: node: ASTNode :: ExprResult => EmitUnary(self, node),
    emitBinary: node: ASTNode :: ExprResult => EmitBinary(self, node),
    emitCall: node: ASTNode :: ExprResult => EmitCall(self, node),
    emitMethodCall: node: ASTNode :: ExprResult => EmitMethodCall(self, node),
    emitIndex: node: ASTNode :: ExprResult => EmitIndex(self, node),
    emitProp: node: ASTNode :: ExprResult => EmitProp(self, node),
    emitArr: node: ASTNode :: ExprResult => EmitArr(self, node),
    emitObjLit: node: ASTNode :: ExprResult => EmitObjLit(self, node),
    emitCast: node: ASTNode :: ExprResult => EmitCast(self, node),
    emitTernary: node: ASTNode :: ExprResult => EmitTernary(self, node),
    emitTyp: node: ASTNode :: ExprResult => EmitTyp(self, node),
    emitAwait: node: ASTNode :: ExprResult => EmitAwait(self, node),
    emitNew: node: ASTNode :: ExprResult => EmitNew(self, node),
    emitBorrow: node: ASTNode :: ExprResult => EmitBorrow(self, node),
    emitSym: node: ASTNode :: ExprResult => EmitSym(self, node),
    emitDefault: node: ASTNode :: ExprResult => EmitDefault(self, node)
}
