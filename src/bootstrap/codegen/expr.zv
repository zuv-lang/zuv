/*
 * =============================================================================
 * Zuv Bootstrap Compiler — Expression Code Generation
 * Path: sub_projects/zuv/src/bootstrap/codegen/expr.zv
 *
 * Implements SSA virtual register evaluation for all Zuv expression forms:
 * - Literals: numbers, deduplicated pooled strings (@str_N), booleans, nil, und, BigInt
 * - Scoped identifier loading from alloca stack slots or direct SSA registers
 * - Unary prefix/postfix operators: -, !, ~, ++, --
 * - Binary arithmetic, bitwise, comparison, logical, and assignment operators
 * - Function and method call dispatch with ABI argument type formatting
 * - Bounds-checked array indexing, property loads, and property mutations
 * - Array and object literal instantiation via runtime helpers
 * - Explicit type cast lowering and ternary conditional branch merging
 * =============================================================================
 */

imp str, arr
imp TypeKind, TypeKindToStr, IsNumericType frm ../types
imp ASTNode, NodeKind, FieldEntry frm ../ast
imp Codegen frm codegen/codegen
imp llvmType, llvmStackType, isPointerType, isIntegerType, isFloatType, selectBinaryOp, selectCmpOp, selectCastOp, selectDefaultValue frm codegen/types
imp ArrayCodegen, boxValueToI64, unboxValueFromI64, ArraySpreadPart, emitArrayBoundsCheck frm codegen/array
imp ObjectCodegen, StructLayoutRegistry, resolveFieldTypeKind, StrToElemTypeKind frm codegen/decl

/**
 * Result descriptor produced by evaluating an expression AST node.
 */
type ExprResult = {
    reg: str;
    typeKind: TypeKind;
};

type FuncSignature = {
    name: str;
    retType: str;
    paramTypes: str[];
};

/**
 * Symbol entry in the active function or block lexical scope.
 */
type ScopeSymbol = {
    name: str;
    reg: str;
    typeKind: TypeKind;
    typeName: str;
    isPtr: bool;
    isAlloca: bool;
    decorRole: num;
};

/**
 * Coordinates expression evaluation and virtual register emission.
 */
obj ExprCodegen {
    codegen: Codegen,
    symbols: ScopeSymbol[],
    globalSymbols: ScopeSymbol[],
    objGen: ObjectCodegen,
    arrGen: ArrayCodegen,
    funcSigs: FuncSignature[],
    activeCatchLabel: str,
    decorRoles: FieldEntry[],
    decoratedMethods: str[],
    methodMappings: FieldEntry[],

    /**
     * Initializes a new ExprCodegen coordinator.
     *
     * @param {Codegen} codegen - LLVM module coordinator
     * @param {ObjectCodegen} objGen - Object and struct layout coordinator
     * @param {ArrayCodegen} arrGen - Array runtime coordinator
     * @returns {ExprCodegen} Initialized ExprCodegen instance
     */
    create: codegen: Codegen, objGen: ObjectCodegen, arrGen: ArrayCodegen :: ExprCodegen => {
        emptySymbols: ScopeSymbol[] = []
        emptyGlobals: ScopeSymbol[] = []
        emptySigs: FuncSignature[] = []
        emptyDecorRoles: FieldEntry[] = []
        emptyDecorMethods: str[] = []
        emptyMappings: FieldEntry[] = []
        -> {
            codegen,
            symbols: emptySymbols,
            globalSymbols: emptyGlobals,
            objGen,
            arrGen,
            funcSigs: emptySigs,
            activeCatchLabel: "",
            decorRoles: emptyDecorRoles,
            decoratedMethods: emptyDecorMethods,
            methodMappings: emptyMappings
        }
    },

    setDecorRole: name: str, role: num :: void => {
        entry: FieldEntry = {
            name: name,
            valStr: "" + role,
            isSpread: false,
            line: 0,
            col: 0
        }
        self.decorRoles.psh entry
    },

    getDecorRole: name: str :: num => {
        fr item of self.decorRoles {
            if item.name == name {
                if item.valStr == "1" { -> 1 }
                if item.valStr == "2" { -> 2 }
                if item.valStr == "3" { -> 3 }
            }
        }
        -> 0
    },

    addMethodMapping: mName: str, mangled: str :: void => {
        entry: FieldEntry = {
            name: mName,
            valStr: mangled,
            isSpread: false,
            line: 0,
            col: 0
        }
        self.methodMappings.psh entry
    },

    getMethodMapping: mName: str :: str => {
        fr item of self.methodMappings {
            if item.name == mName {
                -> item.valStr
            }
        }
        -> ""
    },

    isDecoratedMethod: name: str :: bool => {
        fr dm of self.decoratedMethods {
            if dm == name {
                -> true
            }
        }
        -> false
    },

    /**
     * Registers a named symbol into the lexical scope table.
     *
     * @param {str} name - Variable or parameter identifier
     * @param {str} reg - Allocated SSA register or alloca pointer
     * @param {TypeKind} typeKind - Semantic type of the symbol
     * @param {bool} isPtr - True if reference pointer
     * @param {bool} isAlloca - True if stack-allocated alloca slot
     * @returns {void}
     */
    addSymbol: name: str, reg: str, typeKind: TypeKind, isPtr: bool, isAlloca: bool :: void => {
        newSym: ScopeSymbol = {
            name,
            reg,
            typeKind,
            typeName: "",
            isPtr,
            isAlloca,
            decorRole: 0
        }
        self.symbols.psh newSym
    },

    addSymbolWithRole: name: str, reg: str, typeKind: TypeKind, isPtr: bool, isAlloca: bool, decorRole: num :: void => {
        newSym: ScopeSymbol = {
            name,
            reg,
            typeKind,
            typeName: "",
            isPtr,
            isAlloca,
            decorRole
        }
        self.symbols.psh newSym
    },

    addSymbolWithType: name: str, reg: str, typeKind: TypeKind, typeName: str, isPtr: bool, isAlloca: bool :: void => {
        newSym: ScopeSymbol = {
            name,
            reg,
            typeKind,
            typeName,
            isPtr,
            isAlloca,
            decorRole: 0
        }
        self.symbols.psh newSym
    },

    /**
     * Registers a named module-level global symbol.
     *
     * @param {str} name - Variable identifier
     * @param {str} reg - LLVM global variable name (@global_xxx)
     * @param {TypeKind} typeKind - Semantic type of the global
     * @returns {void}
     */
    addGlobalSymbol: name: str, reg: str, typeKind: TypeKind :: void => {
        newSym: ScopeSymbol = {
            name,
            reg,
            typeKind,
            typeName: "",
            isPtr: false,
            isAlloca: true,
            decorRole: 0
        }
        self.globalSymbols.psh newSym
    },

    addGlobalSymbolWithType: name: str, reg: str, typeKind: TypeKind, typeName: str :: void => {
        newSym: ScopeSymbol = {
            name,
            reg,
            typeKind,
            typeName,
            isPtr: false,
            isAlloca: true,
            decorRole: 0
        }
        self.globalSymbols.psh newSym
    },

    /**
     * Finds a module-level global symbol by identifier.
     *
     * @param {str} name - Global variable identifier to look up
     * @returns {ScopeSymbol} Found symbol or empty record
     */
    findGlobalSymbol: name: str :: ScopeSymbol => {
        found: ScopeSymbol = {
            name: "",
            reg: "",
            typeKind: TypeKind.Unknown,
            typeName: "",
            isPtr: false,
            isAlloca: false,
            decorRole: 0
        }
        fr gItem of self.globalSymbols {
            if gItem.name == name {
                found = gItem
            }
        }
        -> found
    },

    /**
     * Updates the semantic type of a module-level global symbol.
     *
     * @param {str} name - Global variable identifier
     * @param {TypeKind} typeKind - Updated semantic type
     * @param {str} typeName - Updated struct/type name annotation
     * @returns {void}
     */
    setGlobalSymbolType: name: str, typeKind: TypeKind, typeName: str :: void => {
        idx: num = 0
        fr gItem of self.globalSymbols {
            if gItem.name == name {
                effTypeName: str = typeName.ln > 0 ? typeName : gItem.typeName
                updated: ScopeSymbol = {
                    name: gItem.name,
                    reg: gItem.reg,
                    typeKind,
                    typeName: effTypeName,
                    isPtr: gItem.isPtr,
                    isAlloca: gItem.isAlloca,
                    decorRole: gItem.decorRole
                }
                self.globalSymbols[idx] = updated
            }
            idx++
        }
    },

    /**
     * Resolves a symbol by identifier from lexical scope table, falling back to globals.
     *
     * @param {str} name - Variable identifier to look up
     * @returns {ScopeSymbol} Found symbol or empty record
     */
    findSymbol: name: str :: ScopeSymbol => {
        found: ScopeSymbol = {
            name: "",
            reg: "",
            typeKind: TypeKind.Unknown,
            typeName: "",
            isPtr: false,
            isAlloca: false,
            decorRole: 0
        }
        fr item of self.symbols {
            if item.name == name {
                found = item
            }
        }
        if found.name.ln > 0 {
            -> found
        }
        fr gItem of self.globalSymbols {
            if gItem.name == name {
                found = gItem
            }
        }
        -> found
    },

    /**
     * Registers a user function signature for argument coercions.
     *
     * @param {str} name - Function name
     * @param {str} retType - LLVM return type string
     * @param {str[]} paramTypes - LLVM parameter type strings
     * @returns {void}
     */
    registerFunc: name: str, retType: str, paramTypes: str[] :: void => {
        self.funcSigs.psh {
            name,
            retType,
            paramTypes
        }
    },

    /**
     * Looks up a registered function signature by name.
     *
     * @param {str} name - Function name to find
     * @returns {FuncSignature} Found signature or empty
     */
    findFunc: name: str :: FuncSignature => {
        fr fnSig of self.funcSigs {
            if fnSig.name == name {
                -> fnSig
            }
        }
        emptyParams: str[] = []
        emptySig: FuncSignature = {
            name: "",
            retType: "",
            paramTypes: emptyParams
        }
        -> emptySig
    },

    /**
     * Clears all local scope symbols.
     *
     * @returns {void}
     */
    clearSymbols: :: void => {
        self.symbols = []
    },

    /**
     * Master expression evaluator routing AST nodes to specialized emitters.
     *
     * @param {ASTNode} node - Target expression AST node
     * @returns {ExprResult} Computed SSA register and type descriptor
     */
    emitExpr: node: ASTNode :: ExprResult => sw node.kind {
        NodeKind.NumExpr        => self.emitNum node
        NodeKind.StrExpr        => self.emitStr node
        NodeKind.BoolExpr       => self.emitBool node
        NodeKind.NilExpr        => self.emitNil node
        NodeKind.UndExpr        => self.emitUnd node
        NodeKind.BigIntExpr     => self.emitBigInt node
        NodeKind.IdentExpr      => self.emitIdent node
        NodeKind.UnaryExpr      => self.emitUnary node
        NodeKind.BinaryExpr     => self.emitBinary node
        NodeKind.CallExpr       => self.emitCall node
        NodeKind.MethodCallExpr => self.emitMethodCall node
        NodeKind.IndexExpr      => self.emitIndex node
        NodeKind.PropExpr       => self.emitProp node
        NodeKind.ArrExpr        => self.emitArr node
        NodeKind.ObjLitExpr     => self.emitObjLit node
        NodeKind.CastExpr       => self.emitCast node
        NodeKind.TernaryExpr    => self.emitTernary node
        NodeKind.TypExpr        => self.emitTyp node
        NodeKind.AwaitExpr      => self.emitAwait node
        NodeKind.NewExpr        => self.emitNew node
        NodeKind.BorrowExpr     => self.emitBorrow node
        _                       => self.emitDefault node
    },

    emitNum: node: ASTNode :: ExprResult => {
        valStr: str = node.val
        if valStr.ln == 0 {
            valStr = `${node.numVal}`
        }
        valStr = parseBaseNumber valStr
        resReg: str = self.codegen.newReg
        targetKind = node.inferredType
        if targetKind == TypeKind.Unknown {
            targetKind = TypeKind.I64
        }
        if isFloatType targetKind {
            fStr: str = valStr
            hasDot: bool = fStr.cnt "."
            if !hasDot {
                eIdx: num = -1
                k: num = 0
                wh k < fStr.ln {
                    ch: str = fStr.chr k
                    if ch == "e" || ch == "E" {
                        eIdx = k
                        brk
                    }
                    k = k + 1
                }
                if eIdx >= 0 {
                    fStr = (fStr.sub 0, eIdx) + ".0" + (fStr.sub eIdx, fStr.ln - eIdx)
                } els {
                    fStr = fStr + ".0"
                }
            }
            self.codegen.emit `${resReg} = fadd double 0.0, ${fStr}`
            fRes: ExprResult = { reg: resReg, typeKind: TypeKind.Num }
            -> fRes
        }
        itype: str = llvmType targetKind
        self.codegen.emit `${resReg} = add ${itype} 0, ${valStr}`
        iRes: ExprResult = { reg: resReg, typeKind: targetKind }
        -> iRes
    },

    /**
     * Pools a static string literal and emits an element pointer register.
     *
     * @param {ASTNode} node - String literal AST node
     * @returns {ExprResult} Result descriptor
     */
    emitStr: node: ASTNode :: ExprResult => {
        strConst: str = self.codegen.addStringConstant node.val
        gepReg: str = self.codegen.newReg
        self.codegen.emit `${gepReg} = getelementptr inbounds i8, ptr ${strConst}, i64 0`
        res: ExprResult = { reg: gepReg, typeKind: TypeKind.Str }
        -> res
    },

    /**
     * Emits a boolean literal constant.
     *
     * @param {ASTNode} node - Boolean literal AST node
     * @returns {ExprResult} Result descriptor
     */
    emitBool: node: ASTNode :: ExprResult => {
        bVal: str = node.boolVal ? "true" : "false"
        resReg: str = self.codegen.newReg
        self.codegen.emit `${resReg} = and i1 ${bVal}, true`
        res: ExprResult = { reg: resReg, typeKind: TypeKind.Bool }
        -> res
    },

    /**
     * Emits a nil literal constant (i64 0).
     *
     * @param {ASTNode} node - Nil literal AST node
     * @returns {ExprResult} Result descriptor
     */
    emitNil: node: ASTNode :: ExprResult => {
        resReg: str = self.codegen.newReg
        self.codegen.emit `${resReg} = add i64 0, 0`
        res: ExprResult = { reg: resReg, typeKind: TypeKind.Nil }
        -> res
    },

    /**
     * Emits an undefined literal constant (i64 0).
     *
     * @param {ASTNode} node - Undefined literal AST node
     * @returns {ExprResult} Result descriptor
     */
    emitUnd: node: ASTNode :: ExprResult => {
        resReg: str = self.codegen.newReg
        self.codegen.emit `${resReg} = add i64 0, 0`
        res: ExprResult = { reg: resReg, typeKind: TypeKind.Und }
        -> res
    },

    /**
     * Emits a BigInt integer literal.
     *
     * @param {ASTNode} node - BigInt literal AST node
     * @returns {ExprResult} Result descriptor
     */
    emitBigInt: node: ASTNode :: ExprResult => {
        valStr: str = node.val.ln > 0 ? node.val : "0"
        strConst: str = self.codegen.addStringConstant valStr
        ptrReg: str = self.codegen.newReg
        self.codegen.emit `${ptrReg} = getelementptr inbounds i8, ptr ${strConst}, i64 0`
        res: ExprResult = { reg: ptrReg, typeKind: TypeKind.Str }
        -> res
    },

    /**
     * Emits identifier resolution, loading from alloca stack slot if applicable.
     *
     * @param {ASTNode} node - Identifier AST node
     * @returns {ExprResult} Result descriptor
     */
    emitIdent: node: ASTNode :: ExprResult => {
        foundSym = self.findSymbol node.name
        if foundSym.name.ln > 0 && foundSym.isAlloca {
            stType: str = llvmStackType foundSym.typeKind
            loadReg: str = self.codegen.newReg
            self.codegen.emit `${loadReg} = load ${stType}, ptr ${foundSym.reg}`
            res: ExprResult = { reg: loadReg, typeKind: foundSym.typeKind }
            -> res
        }
        if foundSym.reg.ln > 0 && !(foundSym.isAlloca) {
            res: ExprResult = { reg: foundSym.reg, typeKind: foundSym.typeKind }
            -> res
        }

        dRole: num = 0
        if foundSym.name.ln > 0 && foundSym.decorRole > 0 {
            dRole = foundSym.decorRole
        } els {
            dRole = self.getDecorRole node.name
        }
        if dRole == 1 {
            valReg: str = self.codegen.newReg
            self.codegen.emit `${valReg} = load i64, ptr @__active_decor_orig`
            res: ExprResult = { reg: valReg, typeKind: TypeKind.I64 }
            -> res
        }
        if dRole == 2 {
            rawReg: str = self.codegen.newReg
            self.codegen.emit `${rawReg} = load i64, ptr @__active_decor_ctx`
            ptrReg: str = self.codegen.newReg
            self.codegen.emit `${ptrReg} = inttoptr i64 ${rawReg} to ptr`
            res: ExprResult = { reg: ptrReg, typeKind: TypeKind.Obj }
            -> res
        }
        if dRole == 3 {
            rawReg: str = self.codegen.newReg
            self.codegen.emit `${rawReg} = load i64, ptr @__active_factory_arg`
            ptrReg: str = self.codegen.newReg
            self.codegen.emit `${ptrReg} = inttoptr i64 ${rawReg} to ptr`
            res: ExprResult = { reg: ptrReg, typeKind: TypeKind.Str }
            -> res
        }
        if node.name == "time" || node.name == "os" {
            res: ExprResult = { reg: "0", typeKind: TypeKind.I64 }
            -> res
        }
        if foundSym.reg.ln > 0 {
            res: ExprResult = { reg: foundSym.reg, typeKind: foundSym.typeKind }
            -> res
        }
        if node.name == "args" {
            self.codegen.emitExtern "@zuv_global_args = global i64 0"
            valReg: str = self.codegen.newReg
            self.codegen.emit `${valReg} = load i64, ptr @zuv_global_args`
            ptrReg: str = self.codegen.newReg
            self.codegen.emit `${ptrReg} = inttoptr i64 ${valReg} to ptr`
            res: ExprResult = { reg: ptrReg, typeKind: TypeKind.Arr }
            -> res
        }
        // Check if bare enum variant name (e.g. Pending, Active, Archived)
        vVal: num = self.objGen.registry.findVariantVal node.name
        if vVal < 0 && node.val.ln > 0 {
            vVal = self.objGen.registry.findVariantVal node.val
        }
        if vVal >= 0 {
            resReg: str = self.codegen.newReg
            self.codegen.emit `${resReg} = add i8 0, ${vVal}`
            vRes: ExprResult = { reg: resReg, typeKind: TypeKind.I8 }
            -> vRes
        }
        // Check if zero-argument function call or function pointer value
        fnSig: FuncSignature = self.findFunc node.name
        if fnSig.name.ln > 0 {
            if fnSig.paramTypes.ln == 0 {
                if fnSig.retType == "void" {
                    self.codegen.emit `call void @${node.name}()`
                    vRes: ExprResult = { reg: "", typeKind: TypeKind.Void }
                    -> vRes
                }
                callReg: str = self.codegen.newReg
                self.codegen.emit `${callReg} = call ${fnSig.retType} @${node.name}()`
                callKind = TypeKind.I64
                if fnSig.retType == "ptr" {
                    callKind = TypeKind.Ptr
                } els if fnSig.retType == "i32" {
                    callKind = TypeKind.I32
                } els if fnSig.retType == "double" {
                    callKind = TypeKind.Num
                } els if fnSig.retType == "i1" {
                    callKind = TypeKind.Bool
                }
                cRes: ExprResult = { reg: callReg, typeKind: callKind }
                -> cRes
            } els {
                ptrReg: str = self.codegen.newReg
                self.codegen.emit `${ptrReg} = ptrtoint ptr @${node.name} to i64`
                fpRes: ExprResult = { reg: ptrReg, typeKind: TypeKind.I64 }
                -> fpRes
            }
        }
        fallbackReg: str = `%${node.name}`
        fRes: ExprResult = { reg: fallbackReg, typeKind: node.inferredType }
        -> fRes
    },

    /**
     * Emits a unary operation (-, !, ~, ++, --).
     *
     * @param {ASTNode} node - Unary expression AST node
     * @returns {ExprResult} Result descriptor
     */
    emitUnary: node: ASTNode :: ExprResult => {
        op: str = node.op
        operandRes: ExprResult = self.emitExpr node.children[0]

        if op == "-" || op == "neg" {
            resReg: str = self.codegen.newReg
            if operandRes.typeKind == TypeKind.Num {
                self.codegen.emit `${resReg} = fsub double 0.0, ${operandRes.reg}`
                fRes: ExprResult = { reg: resReg, typeKind: TypeKind.Num }
                -> fRes
            }
            itype: str = llvmType operandRes.typeKind
            self.codegen.emit `${resReg} = sub ${itype} 0, ${operandRes.reg}`
            iRes: ExprResult = { reg: resReg, typeKind: operandRes.typeKind }
            -> iRes
        }

        if op == "!" || op == "not" {
            resReg: str = self.codegen.newReg
            if operandRes.typeKind == TypeKind.Bool {
                self.codegen.emit `${resReg} = xor i1 ${operandRes.reg}, true`
                bRes: ExprResult = { reg: resReg, typeKind: TypeKind.Bool }
                -> bRes
            }
            if isPointerType operandRes.typeKind {
                self.codegen.emit `${resReg} = icmp eq ptr ${operandRes.reg}, null`
                pRes: ExprResult = { reg: resReg, typeKind: TypeKind.Bool }
                -> pRes
            }
            itype: str = llvmType operandRes.typeKind
            self.codegen.emit `${resReg} = icmp eq ${itype} ${operandRes.reg}, 0`
            cRes: ExprResult = { reg: resReg, typeKind: TypeKind.Bool }
            -> cRes
        }

        if op == "~" {
            resReg: str = self.codegen.newReg
            itype: str = llvmType operandRes.typeKind
            self.codegen.emit `${resReg} = xor ${itype} ${operandRes.reg}, -1`
            tRes: ExprResult = { reg: resReg, typeKind: operandRes.typeKind }
            -> tRes
        }

        if op == "++" || op == "--" {
            childNode: ASTNode = node.children[0]
            if childNode.kind == NodeKind.IdentExpr {
                foundSym = self.findSymbol childNode.name
                if foundSym.isAlloca {
                    stType: str = llvmStackType foundSym.typeKind
                    curReg: str = operandRes.reg
                    nextReg: str = self.codegen.newReg
                    deltaOp: str = (op == "++") ? "add" : "sub"
                    self.codegen.emit `${nextReg} = ${deltaOp} ${stType} ${curReg}, 1`
                    self.codegen.emit `store ${stType} ${nextReg}, ptr ${foundSym.reg}`
                    retReg: str = node.isPrefix ? nextReg : curReg
                    res: ExprResult = { reg: retReg, typeKind: foundSym.typeKind }
                    -> res
                }
            }
        }

        -> operandRes
    },

    /**
     * Emits a binary operation (arithmetic, bitwise, comparison, logical, assignment).
     *
     * @param {ASTNode} node - Binary expression AST node
     * @returns {ExprResult} Result descriptor
     */
    emitBinary: node: ASTNode :: ExprResult => {
        op: str = node.op

        isCompound: bool = (op == "+=" || op == "-=" || op == "*=" || op == "/=" || op == "%=" ||
                            op == "**=" || op == "&=" || op == "|=" || op == "^=")
        if op == "=" || isCompound {
            targetNode: ASTNode = node.children[0]
            valNode: ASTNode = node.children[1]
            rightRes: ExprResult = { reg: "", typeKind: TypeKind.Unknown }

            if isCompound {
                baseOp: str = op.sub 0, op.ln - 1
                binNode: ASTNode = ASTNode.createBinary baseOp, targetNode, valNode, node.line, node.col
                rightRes = self.emitBinary binNode
            } els {
                rightRes = self.emitExpr valNode
            }
            if targetNode.kind == NodeKind.IdentExpr {
                foundSym = self.findSymbol targetNode.name
                if foundSym.isAlloca {
                    stType: str = llvmStackType foundSym.typeKind
                    storeVal: str = rightRes.reg
                    if stType == "i64" && (rightRes.typeKind == TypeKind.I8 || rightRes.typeKind == TypeKind.Bool) {
                        extReg: str = self.codegen.newReg
                        srcLLVM: str = (rightRes.typeKind == TypeKind.Bool) ? "i1" : "i8"
                        self.codegen.emit `${extReg} = zext ${srcLLVM} ${rightRes.reg} to i64`
                        storeVal = extReg
                    } els if stType == "i64" && rightRes.typeKind == TypeKind.I16 {
                        extReg: str = self.codegen.newReg
                        self.codegen.emit `${extReg} = zext i16 ${rightRes.reg} to i64`
                        storeVal = extReg
                    } els if stType == "i64" && rightRes.typeKind == TypeKind.I32 {
                        extReg: str = self.codegen.newReg
                        self.codegen.emit `${extReg} = zext i32 ${rightRes.reg} to i64`
                        storeVal = extReg
                    } els if stType == "i64" && (rightRes.typeKind == TypeKind.Str || rightRes.typeKind == TypeKind.Ptr || rightRes.typeKind == TypeKind.Arr || rightRes.typeKind == TypeKind.Obj) {
                        convReg: str = self.codegen.newReg
                        self.codegen.emit `${convReg} = ptrtoint ptr ${rightRes.reg} to i64`
                        storeVal = convReg
                    } els if stType == "ptr" && rightRes.typeKind == TypeKind.I64 {
                        convReg: str = self.codegen.newReg
                        self.codegen.emit `${convReg} = inttoptr i64 ${rightRes.reg} to ptr`
                        storeVal = convReg
                    } els if (stType == "i8" || stType == "i16" || stType == "i32") && rightRes.typeKind == TypeKind.I64 {
                        truncReg: str = self.codegen.newReg
                        self.codegen.emit `${truncReg} = trunc i64 ${rightRes.reg} to ${stType}`
                        storeVal = truncReg
                    } els if stType == "double" && rightRes.typeKind == TypeKind.I64 {
                        convReg: str = self.codegen.newReg
                        self.codegen.emit `${convReg} = sitofp i64 ${rightRes.reg} to double`
                        storeVal = convReg
                    } els if stType == "double" && rightRes.typeKind == TypeKind.I32 {
                        convReg: str = self.codegen.newReg
                        self.codegen.emit `${convReg} = sitofp i32 ${rightRes.reg} to double`
                        storeVal = convReg
                    } els if stType == "double" && (rightRes.typeKind == TypeKind.I16 || rightRes.typeKind == TypeKind.I8) {
                        convReg: str = self.codegen.newReg
                        self.codegen.emit `${convReg} = sitofp i32 ${rightRes.reg} to double`
                        storeVal = convReg
                    } els if stType == "i64" && rightRes.typeKind == TypeKind.Num {
                        convReg: str = self.codegen.newReg
                        self.codegen.emit `${convReg} = fptosi double ${rightRes.reg} to i64`
                        storeVal = convReg
                    } els if (stType == "i8" || stType == "i16" || stType == "i32") && rightRes.typeKind == TypeKind.Num {
                        convReg: str = self.codegen.newReg
                        self.codegen.emit `${convReg} = fptosi double ${rightRes.reg} to ${stType}`
                        storeVal = convReg
                    }
                    self.codegen.emit `store ${stType} ${storeVal}, ptr ${foundSym.reg}`
                }
            } els if targetNode.kind == NodeKind.IndexExpr {
                arrNode: ASTNode = targetNode.children[0]
                idxNode: ASTNode = targetNode.children[1]
                arrRes: ExprResult = self.emitExpr arrNode
                idxRes: ExprResult = self.emitExpr idxNode
                idxReg: str = idxRes.reg
                if idxRes.typeKind == TypeKind.Num {
                    convIdx: str = self.codegen.newReg
                    self.codegen.emit `${convIdx} = fptosi double ${idxRes.reg} to i64`
                    idxReg = convIdx
                } els if idxRes.typeKind == TypeKind.I32 {
                    convIdx: str = self.codegen.newReg
                    self.codegen.emit `${convIdx} = sext i32 ${idxRes.reg} to i64`
                    idxReg = convIdx
                }
                arrPtrReg: str = arrRes.reg
                if isFloatType arrRes.typeKind {
                    convReg: str = self.codegen.newReg
                    self.codegen.emit `${convReg} = fptosi double ${arrRes.reg} to i64`
                    arrPtrReg = convReg
                }
                if !(isPointerType arrRes.typeKind) {
                    convReg: str = self.codegen.newReg
                    self.codegen.emit `${convReg} = inttoptr i64 ${arrPtrReg} to ptr`
                    arrPtrReg = convReg
                }
                self.arrGen.emitSetElement arrPtrReg, idxReg, rightRes.reg, rightRes.typeKind, node.line
            } els if targetNode.kind == NodeKind.PropExpr {
                objNode: ASTNode = targetNode.children[0]
                propName: str = targetNode.name
                objRes: ExprResult = self.emitExpr objNode
                objPtrReg: str = objRes.reg
                if !(isPointerType objRes.typeKind) {
                    convReg: str = self.codegen.newReg
                    self.codegen.emit `${convReg} = inttoptr i64 ${objRes.reg} to ptr`
                    objPtrReg = convReg
                }
                objTypeName: str = objNode.typeAnnotation
                if objTypeName.ln == 0 && objNode.kind == NodeKind.IdentExpr {
                    targetSym = self.findSymbol objNode.name
                    if targetSym.name.ln > 0 && targetSym.typeName.ln > 0 {
                        objTypeName = targetSym.typeName
                    }
                }
                if objTypeName.ln == 0 || !(self.objGen.registry.hasType objTypeName) {
                    fr l of self.objGen.registry.layouts {
                        if l.hasField propName {
                            objTypeName = l.typeName
                            brk
                        }
                    }
                }
                off: num = self.objGen.registry.getFieldOffset objTypeName, propName
                if off < 0 {
                    off = 0
                }
                fldType: TypeKind = self.objGen.registry.getFieldType objTypeName, propName
                setValReg: str = rightRes.reg
                setValType: TypeKind = rightRes.typeKind
                if fldType == TypeKind.Num && setValType != TypeKind.Num {
                    convFlt: str = self.codegen.newReg
                    self.codegen.emit `${convFlt} = sitofp i64 ${setValReg} to double`
                    setValReg = convFlt
                    setValType = TypeKind.Num
                } els if fldType == TypeKind.I64 && setValType == TypeKind.Num {
                    convInt: str = self.codegen.newReg
                    self.codegen.emit `${convInt} = fptosi double ${setValReg} to i64`
                    setValReg = convInt
                    setValType = TypeKind.I64
                }
                self.objGen.emitSetProperty objPtrReg, off, setValReg, setValType
            }
            -> rightRes
        }

        if op == "&&" || op == "and" {
            leftRes: ExprResult = self.emitExpr node.children[0]
            lReg: str = leftRes.reg
            if leftRes.typeKind != TypeKind.Bool {
                cmpReg: str = self.codegen.newReg
                lTypeStr: str = llvmType leftRes.typeKind
                if leftRes.typeKind == TypeKind.Num {
                    self.codegen.emit `${cmpReg} = fcmp one double ${leftRes.reg}, 0.0`
                } els {
                    self.codegen.emit `${cmpReg} = icmp ne ${lTypeStr} ${leftRes.reg}, 0`
                }
                lReg = cmpReg
            }
            slotReg: str = self.codegen.newReg
            self.codegen.emit `${slotReg} = alloca i1`
            self.codegen.emit `store i1 false, ptr ${slotReg}`

            rhsLbl: str = self.codegen.newLabel "land_rhs"
            mergeLbl: str = self.codegen.newLabel "land_merge"

            self.codegen.emit `br i1 ${lReg}, label %${rhsLbl}, label %${mergeLbl}`

            self.codegen.emitLabel rhsLbl
            rightRes: ExprResult = self.emitExpr node.children[1]
            rReg: str = rightRes.reg
            if rightRes.typeKind != TypeKind.Bool {
                cmpReg2: str = self.codegen.newReg
                rTypeStr: str = llvmType rightRes.typeKind
                if rightRes.typeKind == TypeKind.Num {
                    self.codegen.emit `${cmpReg2} = fcmp one double ${rightRes.reg}, 0.0`
                } els {
                    self.codegen.emit `${cmpReg2} = icmp ne ${rTypeStr} ${rightRes.reg}, 0`
                }
                rReg = cmpReg2
            }
            self.codegen.emit `store i1 ${rReg}, ptr ${slotReg}`
            self.codegen.emit `br label %${mergeLbl}`

            self.codegen.emitLabel mergeLbl
            resReg: str = self.codegen.newReg
            self.codegen.emit `${resReg} = load i1, ptr ${slotReg}`
            res: ExprResult = { reg: resReg, typeKind: TypeKind.Bool }
            -> res
        }

        if op == "||" || op == "or" {
            leftRes: ExprResult = self.emitExpr node.children[0]
            lReg: str = leftRes.reg
            if leftRes.typeKind != TypeKind.Bool {
                cmpReg: str = self.codegen.newReg
                lTypeStr: str = llvmType leftRes.typeKind
                if leftRes.typeKind == TypeKind.Num {
                    self.codegen.emit `${cmpReg} = fcmp one double ${leftRes.reg}, 0.0`
                } els {
                    self.codegen.emit `${cmpReg} = icmp ne ${lTypeStr} ${leftRes.reg}, 0`
                }
                lReg = cmpReg
            }
            slotReg: str = self.codegen.newReg
            self.codegen.emit `${slotReg} = alloca i1`
            self.codegen.emit `store i1 true, ptr ${slotReg}`

            rhsLbl: str = self.codegen.newLabel "lor_rhs"
            mergeLbl: str = self.codegen.newLabel "lor_merge"

            self.codegen.emit `br i1 ${lReg}, label %${mergeLbl}, label %${rhsLbl}`

            self.codegen.emitLabel rhsLbl
            rightRes: ExprResult = self.emitExpr node.children[1]
            rReg: str = rightRes.reg
            if rightRes.typeKind != TypeKind.Bool {
                cmpReg2: str = self.codegen.newReg
                rTypeStr: str = llvmType rightRes.typeKind
                if rightRes.typeKind == TypeKind.Num {
                    self.codegen.emit `${cmpReg2} = fcmp one double ${rightRes.reg}, 0.0`
                } els {
                    self.codegen.emit `${cmpReg2} = icmp ne ${rTypeStr} ${rightRes.reg}, 0`
                }
                rReg = cmpReg2
            }
            self.codegen.emit `store i1 ${rReg}, ptr ${slotReg}`
            self.codegen.emit `br label %${mergeLbl}`

            self.codegen.emitLabel mergeLbl
            resReg: str = self.codegen.newReg
            self.codegen.emit `${resReg} = load i1, ptr ${slotReg}`
            res: ExprResult = { reg: resReg, typeKind: TypeKind.Bool }
            -> res
        }

        if op == "??" {
            leftRes: ExprResult = self.emitExpr node.children[0]
            if leftRes.typeKind == TypeKind.Nil || leftRes.typeKind == TypeKind.Und {
                rightRes: ExprResult = self.emitExpr node.children[1]
                -> rightRes
            }
            if !(isPointerType leftRes.typeKind) && leftRes.typeKind != TypeKind.Unknown {
                -> leftRes
            }
            cmpReg: str = self.codegen.newReg
            self.codegen.emit `${cmpReg} = icmp eq ptr ${leftRes.reg}, null`
            nullLbl: str = self.codegen.newLabel "nullish_null"
            keepLbl: str = self.codegen.newLabel "nullish_keep"
            mergeLbl: str = self.codegen.newLabel "nullish_merge"
            targetT: TypeKind = leftRes.typeKind
            if targetT == TypeKind.Unknown {
                targetT = node.children[1].inferredType
            }
            if targetT == TypeKind.Unknown {
                targetT = TypeKind.Ptr
            }
            stType: str = llvmStackType targetT
            slotReg: str = self.codegen.newReg
            self.codegen.emit `${slotReg} = alloca ${stType}`
            self.codegen.emit `br i1 ${cmpReg}, label %${nullLbl}, label %${keepLbl}`

            self.codegen.emitLabel keepLbl
            self.codegen.emit `store ${stType} ${leftRes.reg}, ptr ${slotReg}`
            self.codegen.emit `br label %${mergeLbl}`

            self.codegen.emitLabel nullLbl
            rightRes: ExprResult = self.emitExpr node.children[1]
            self.codegen.emit `store ${stType} ${rightRes.reg}, ptr ${slotReg}`
            self.codegen.emit `br label %${mergeLbl}`

            self.codegen.emitLabel mergeLbl
            resReg: str = self.codegen.newReg
            self.codegen.emit `${resReg} = load ${stType}, ptr ${slotReg}`
            res: ExprResult = { reg: resReg, typeKind: targetT }
            -> res
        }

        leftRes: ExprResult = self.emitExpr node.children[0]
        rightRes: ExprResult = self.emitExpr node.children[1]

        if op == "+" && (leftRes.typeKind == TypeKind.Str || rightRes.typeKind == TypeKind.Str) {
            sLeft: str = leftRes.reg
            sRight: str = rightRes.reg
            if leftRes.typeKind != TypeKind.Str {
                if leftRes.typeKind == TypeKind.I64 || leftRes.typeKind == TypeKind.I32 || leftRes.typeKind == TypeKind.I16 || leftRes.typeKind == TypeKind.I8 {
                    zReg: str = leftRes.reg
                    if leftRes.typeKind == TypeKind.I32 || leftRes.typeKind == TypeKind.I16 || leftRes.typeKind == TypeKind.I8 {
                        exReg: str = self.codegen.newReg
                        lTypeStr: str = llvmType leftRes.typeKind
                        self.codegen.emit `${exReg} = sext ${lTypeStr} ${leftRes.reg} to i64`
                        zReg = exReg
                    }
                    buf: str = self.codegen.newReg
                    self.codegen.emit `${buf} = call ptr @malloc(i64 32)`
                    numFmt: str = self.codegen.addStringConstant "%lld"
                    self.codegen.emit `call i32 (ptr, i64, ptr, ...) @snprintf(ptr ${buf}, i64 32, ptr ${numFmt}, i64 ${zReg})`
                    sLeft = buf
                } els if leftRes.typeKind == TypeKind.Num {
                    buf: str = self.codegen.newReg
                    self.codegen.emit `${buf} = call ptr @malloc(i64 32)`
                    dblFmt: str = self.codegen.addStringConstant "%g"
                    self.codegen.emit `call i32 (ptr, i64, ptr, ...) @snprintf(ptr ${buf}, i64 32, ptr ${dblFmt}, double ${leftRes.reg})`
                    sLeft = buf
                } els if leftRes.typeKind == TypeKind.Bool {
                    strTrue: str = self.codegen.addStringConstant "true"
                    strFalse: str = self.codegen.addStringConstant "false"
                    boolPtr: str = self.codegen.newReg
                    self.codegen.emit `${boolPtr} = select i1 ${leftRes.reg}, ptr ${strTrue}, ptr ${strFalse}`
                    sLeft = boolPtr
                } els {
                    pReg1: str = self.codegen.newReg
                    self.codegen.emit `${pReg1} = inttoptr i64 ${leftRes.reg} to ptr`
                    sLeft = pReg1
                }
            }
            if rightRes.typeKind != TypeKind.Str {
                if rightRes.typeKind == TypeKind.I64 || rightRes.typeKind == TypeKind.I32 || rightRes.typeKind == TypeKind.I16 || rightRes.typeKind == TypeKind.I8 {
                    zReg: str = rightRes.reg
                    if rightRes.typeKind == TypeKind.I32 || rightRes.typeKind == TypeKind.I16 || rightRes.typeKind == TypeKind.I8 {
                        exReg: str = self.codegen.newReg
                        rTypeStr: str = llvmType rightRes.typeKind
                        self.codegen.emit `${exReg} = sext ${rTypeStr} ${rightRes.reg} to i64`
                        zReg = exReg
                    }
                    buf: str = self.codegen.newReg
                    self.codegen.emit `${buf} = call ptr @malloc(i64 32)`
                    numFmt: str = self.codegen.addStringConstant "%lld"
                    self.codegen.emit `call i32 (ptr, i64, ptr, ...) @snprintf(ptr ${buf}, i64 32, ptr ${numFmt}, i64 ${zReg})`
                    sRight = buf
                } els if rightRes.typeKind == TypeKind.Num {
                    buf: str = self.codegen.newReg
                    self.codegen.emit `${buf} = call ptr @malloc(i64 32)`
                    dblFmt: str = self.codegen.addStringConstant "%g"
                    self.codegen.emit `call i32 (ptr, i64, ptr, ...) @snprintf(ptr ${buf}, i64 32, ptr ${dblFmt}, double ${rightRes.reg})`
                    sRight = buf
                } els if rightRes.typeKind == TypeKind.Bool {
                    strTrue: str = self.codegen.addStringConstant "true"
                    strFalse: str = self.codegen.addStringConstant "false"
                    boolPtr: str = self.codegen.newReg
                    self.codegen.emit `${boolPtr} = select i1 ${rightRes.reg}, ptr ${strTrue}, ptr ${strFalse}`
                    sRight = boolPtr
                } els {
                    pReg2: str = self.codegen.newReg
                    self.codegen.emit `${pReg2} = inttoptr i64 ${rightRes.reg} to ptr`
                    sRight = pReg2
                }
            }

            len1: str = self.codegen.newReg
            self.codegen.emit `${len1} = call i64 @strlen(ptr ${sLeft})`
            len2: str = self.codegen.newReg
            self.codegen.emit `${len2} = call i64 @strlen(ptr ${sRight})`
            totLen: str = self.codegen.newReg
            self.codegen.emit `${totLen} = add i64 ${len1}, ${len2}`
            allocLen: str = self.codegen.newReg
            self.codegen.emit `${allocLen} = add i64 ${totLen}, 1`
            bufReg: str = self.codegen.newReg
            self.codegen.emit `${bufReg} = call ptr @malloc(i64 ${allocLen})`
            self.codegen.emit `call ptr @memcpy(ptr ${bufReg}, ptr ${sLeft}, i64 ${len1})`
            dest2: str = self.codegen.newReg
            self.codegen.emit `${dest2} = getelementptr inbounds i8, ptr ${bufReg}, i64 ${len1}`
            self.codegen.emit `call ptr @memcpy(ptr ${dest2}, ptr ${sRight}, i64 ${len2})`
            termPtr: str = self.codegen.newReg
            self.codegen.emit `${termPtr} = getelementptr inbounds i8, ptr ${bufReg}, i64 ${totLen}`
            self.codegen.emit `store i8 0, ptr ${termPtr}`
            sRes: ExprResult = { reg: bufReg, typeKind: TypeKind.Str }
            -> sRes
        }

        if op == "==" || op == "!=" {
            if leftRes.typeKind == TypeKind.Str && rightRes.typeKind == TypeKind.Str {
                cmpRes: str = self.codegen.newReg
                self.codegen.emit `${cmpRes} = call i32 @strcmp(ptr ${leftRes.reg}, ptr ${rightRes.reg})`
                condReg: str = self.codegen.newReg
                condOp: str = (op == "==") ? "eq" : "ne"
                self.codegen.emit `${condReg} = icmp ${condOp} i32 ${cmpRes}, 0`
                bRes: ExprResult = { reg: condReg, typeKind: TypeKind.Bool }
                -> bRes
            }
            if leftRes.typeKind == TypeKind.Str || rightRes.typeKind == TypeKind.Str {
                condReg: str = self.codegen.newReg
                condVal: str = (op == "==") ? "0" : "1"
                self.codegen.emit `${condReg} = icmp eq i32 ${condVal}, 1`
                bRes: ExprResult = { reg: condReg, typeKind: TypeKind.Bool }
                -> bRes
            }
            if leftRes.typeKind == TypeKind.Bool && rightRes.typeKind == TypeKind.Bool {
                condReg: str = self.codegen.newReg
                condOp: str = (op == "==") ? "eq" : "ne"
                self.codegen.emit `${condReg} = icmp ${condOp} i1 ${leftRes.reg}, ${rightRes.reg}`
                bRes: ExprResult = { reg: condReg, typeKind: TypeKind.Bool }
                -> bRes
            }
            isNumL: bool = IsNumericType leftRes.typeKind
            isNumR: bool = IsNumericType rightRes.typeKind
            if (leftRes.typeKind == TypeKind.Bool && isNumR) || (rightRes.typeKind == TypeKind.Bool && isNumL) {
                boolReg: str = leftRes.typeKind == TypeKind.Bool ? leftRes.reg : rightRes.reg
                numReg: str = leftRes.typeKind == TypeKind.Bool ? rightRes.reg : leftRes.reg
                numKind = leftRes.typeKind == TypeKind.Bool ? rightRes.typeKind : leftRes.typeKind

                extBool: str = self.codegen.newReg
                self.codegen.emit `${extBool} = zext i1 ${boolReg} to i64`
                if numKind == TypeKind.Num {
                    extDbl: str = self.codegen.newReg
                    self.codegen.emit `${extDbl} = sitofp i64 ${extBool} to double`
                    cmpRes: str = self.codegen.newReg
                    fcmpOp: str = (op == "==") ? "oeq" : "one"
                    self.codegen.emit `${cmpRes} = fcmp ${fcmpOp} double ${extDbl}, ${numReg}`
                    bRes: ExprResult = { reg: cmpRes, typeKind: TypeKind.Bool }
                    -> bRes
                } els {
                    i64Num: str = numReg
                    if numKind == TypeKind.I8 || numKind == TypeKind.I16 || numKind == TypeKind.I32 {
                        convNum: str = self.codegen.newReg
                        srcT: str = llvmType numKind
                        self.codegen.emit `${convNum} = sext ${srcT} ${numReg} to i64`
                        i64Num = convNum
                    }
                    cmpRes: str = self.codegen.newReg
                    icmpOp: str = (op == "==") ? "eq" : "ne"
                    self.codegen.emit `${cmpRes} = icmp ${icmpOp} i64 ${extBool}, ${i64Num}`
                    bRes: ExprResult = { reg: cmpRes, typeKind: TypeKind.Bool }
                    -> bRes
                }
            }
            if leftRes.typeKind == TypeKind.Nil || rightRes.typeKind == TypeKind.Nil || leftRes.typeKind == TypeKind.Und || rightRes.typeKind == TypeKind.Und {
                if leftRes.typeKind == rightRes.typeKind {
                    condReg: str = self.codegen.newReg
                    condVal: str = (op == "==") ? "1" : "0"
                    self.codegen.emit `${condReg} = icmp eq i32 ${condVal}, 1`
                    bRes: ExprResult = { reg: condReg, typeKind: TypeKind.Bool }
                    -> bRes
                }
                isPtrL: bool = (leftRes.typeKind == TypeKind.Ptr || leftRes.typeKind == TypeKind.Arr || leftRes.typeKind == TypeKind.Obj)
                isPtrR: bool = (rightRes.typeKind == TypeKind.Ptr || rightRes.typeKind == TypeKind.Arr || rightRes.typeKind == TypeKind.Obj)
                if (isPtrL && rightRes.typeKind == TypeKind.Nil) || (isPtrR && leftRes.typeKind == TypeKind.Nil) {
                    ptrReg: str = isPtrL ? leftRes.reg : rightRes.reg
                    cmpRes: str = self.codegen.newReg
                    icmpOp: str = (op == "==") ? "eq" : "ne"
                    self.codegen.emit `${cmpRes} = icmp ${icmpOp} ptr ${ptrReg}, null`
                    bRes: ExprResult = { reg: cmpRes, typeKind: TypeKind.Bool }
                    -> bRes
                }
                isI64L: bool = (leftRes.typeKind == TypeKind.I64 || leftRes.typeKind == TypeKind.I32)
                isI64R: bool = (rightRes.typeKind == TypeKind.I64 || rightRes.typeKind == TypeKind.I32)
                if (isI64L && (rightRes.typeKind == TypeKind.Nil || rightRes.typeKind == TypeKind.Und)) ||
                   (isI64R && (leftRes.typeKind == TypeKind.Nil || leftRes.typeKind == TypeKind.Und)) {
                    valReg: str = isI64L ? leftRes.reg : rightRes.reg
                    cmpRes: str = self.codegen.newReg
                    icmpOp: str = (op == "==") ? "eq" : "ne"
                    self.codegen.emit `${cmpRes} = icmp ${icmpOp} i64 ${valReg}, 0`
                    bRes: ExprResult = { reg: cmpRes, typeKind: TypeKind.Bool }
                    -> bRes
                }
                if (leftRes.typeKind == TypeKind.Num && (rightRes.typeKind == TypeKind.Nil || rightRes.typeKind == TypeKind.Und)) ||
                   (rightRes.typeKind == TypeKind.Num && (leftRes.typeKind == TypeKind.Nil || leftRes.typeKind == TypeKind.Und)) {
                    valReg: str = (leftRes.typeKind == TypeKind.Num) ? leftRes.reg : rightRes.reg
                    cmpRes: str = self.codegen.newReg
                    fcmpOp: str = (op == "==") ? "fcmp oeq" : "fcmp one"
                    self.codegen.emit `${cmpRes} = ${fcmpOp} double ${valReg}, 0.0`
                    bRes: ExprResult = { reg: cmpRes, typeKind: TypeKind.Bool }
                    -> bRes
                }
                condReg: str = self.codegen.newReg
                condVal: str = (op == "==") ? "0" : "1"
                self.codegen.emit `${condReg} = icmp eq i32 ${condVal}, 1`
                bRes: ExprResult = { reg: condReg, typeKind: TypeKind.Bool }
                -> bRes
            }
            if leftRes.typeKind != rightRes.typeKind && leftRes.typeKind != TypeKind.Unknown && rightRes.typeKind != TypeKind.Unknown {
                if !isNumL || !isNumR {
                    condReg: str = self.codegen.newReg
                    condVal: str = (op == "==") ? "0" : "1"
                    self.codegen.emit `${condReg} = icmp eq i32 ${condVal}, 1`
                    bRes: ExprResult = { reg: condReg, typeKind: TypeKind.Bool }
                    -> bRes
                }
            }
        }

        if op == "-" && (leftRes.typeKind == TypeKind.Ptr || rightRes.typeKind == TypeKind.Ptr) {
            pLeft: str = leftRes.reg
            if leftRes.typeKind == TypeKind.Ptr {
                intReg: str = self.codegen.newReg
                self.codegen.emit `${intReg} = ptrtoint ptr ${leftRes.reg} to i64`
                pLeft = intReg
            }
            pRight: str = rightRes.reg
            if rightRes.typeKind == TypeKind.Ptr {
                intReg: str = self.codegen.newReg
                self.codegen.emit `${intReg} = ptrtoint ptr ${rightRes.reg} to i64`
                pRight = intReg
            }
            diffReg: str = self.codegen.newReg
            self.codegen.emit `${diffReg} = sub i64 ${pLeft}, ${pRight}`
            res: ExprResult = { reg: diffReg, typeKind: TypeKind.I64 }
            -> res
        }

        leftReg: str = leftRes.reg
        rightReg: str = rightRes.reg
        targetType = leftRes.typeKind

        if leftRes.typeKind != rightRes.typeKind {
            if leftRes.typeKind == TypeKind.Num || rightRes.typeKind == TypeKind.Num {
                targetType = TypeKind.Num
            } els if leftRes.typeKind == TypeKind.I64 || rightRes.typeKind == TypeKind.I64 {
                targetType = TypeKind.I64
            } els if leftRes.typeKind == TypeKind.I32 || rightRes.typeKind == TypeKind.I32 {
                targetType = TypeKind.I32
            } els if leftRes.typeKind == TypeKind.I16 || rightRes.typeKind == TypeKind.I16 {
                targetType = TypeKind.I16
            } els if leftRes.typeKind == TypeKind.I8 || rightRes.typeKind == TypeKind.I8 {
                targetType = TypeKind.I8
            }

            if leftRes.typeKind != targetType {
                fromT: str = llvmType leftRes.typeKind
                toT: str = llvmType targetType
                if fromT != toT {
                    castOp: str = selectCastOp leftRes.typeKind, targetType
                    convReg: str = self.codegen.newReg
                    if castOp.ln > 0 {
                        self.codegen.emit `${convReg} = ${castOp} ${fromT} ${leftReg} to ${toT}`
                    } els if fromT == "i1" {
                        self.codegen.emit `${convReg} = zext i1 ${leftReg} to ${toT}`
                    } els if toT == "i1" {
                        self.codegen.emit `${convReg} = trunc ${fromT} ${leftReg} to i1`
                    } els {
                        self.codegen.emit `${convReg} = bitcast ${fromT} ${leftReg} to ${toT}`
                    }
                    leftReg = convReg
                }
            }
            if rightRes.typeKind != targetType {
                fromT: str = llvmType rightRes.typeKind
                toT: str = llvmType targetType
                if fromT != toT {
                    castOp: str = selectCastOp rightRes.typeKind, targetType
                    convReg: str = self.codegen.newReg
                    if castOp.ln > 0 {
                        self.codegen.emit `${convReg} = ${castOp} ${fromT} ${rightReg} to ${toT}`
                    } els if fromT == "i1" {
                        self.codegen.emit `${convReg} = zext i1 ${rightRes} to ${toT}`
                    } els if toT == "i1" {
                        self.codegen.emit `${convReg} = trunc ${fromT} ${rightRes} to i1`
                    } els {
                        self.codegen.emit `${convReg} = bitcast ${fromT} ${rightReg} to ${toT}`
                    }
                    rightReg = convReg
                }
            }
        }

        if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" {
            cmpInst: str = selectCmpOp op, targetType
            ltype: str = llvmType targetType
            resReg: str = self.codegen.newReg
            self.codegen.emit `${resReg} = ${cmpInst} ${ltype} ${leftReg}, ${rightReg}`
            res: ExprResult = { reg: resReg, typeKind: TypeKind.Bool }
            -> res
        }

        if op == "**" {
            ldbl: str = leftReg
            rdbl: str = rightReg
            if targetType != TypeKind.Num {
                c1: str = self.codegen.newReg
                self.codegen.emit `${c1} = sitofp i64 ${leftReg} to double`
                ldbl = c1
                c2: str = self.codegen.newReg
                self.codegen.emit `${c2} = sitofp i64 ${rightReg} to double`
                rdbl = c2
            }
            pReg: str = self.codegen.newReg
            self.codegen.emit `${pReg} = call double @llvm.pow.f64(double ${ldbl}, double ${rdbl})`
            if targetType == TypeKind.Num {
                res: ExprResult = { reg: pReg, typeKind: TypeKind.Num }
                -> res
            } els {
                iReg: str = self.codegen.newReg
                self.codegen.emit `${iReg} = fptosi double ${pReg} to i64`
                res: ExprResult = { reg: iReg, typeKind: targetType }
                -> res
            }
        }

        binInst: str = selectBinaryOp op, targetType
        ltype: str = llvmType targetType
        resReg: str = self.codegen.newReg
        self.codegen.emit `${resReg} = ${binInst} ${ltype} ${leftReg}, ${rightReg}`
        res: ExprResult = { reg: resReg, typeKind: targetType }
        -> res
    },

    /**
     * Emits a function call expression.
     *
     * @param {ASTNode} node - Call expression AST node
     * @returns {ExprResult} Result descriptor
     */
    emitCall: node: ASTNode :: ExprResult => {
        calleeNode: ASTNode = node.children[0]
        calleeName: str = calleeNode.name.ln > 0 ? calleeNode.name : calleeNode.val

        argRegs: str[] = []
        argTypes: TypeKind[] = []
        isCallee: bool = true
        fr child of node.children {
            if isCallee {
                isCallee = false
                cont
            }
            cRes: ExprResult = self.emitExpr child
            argRegs.psh cRes.reg
            argTypes.psh cRes.typeKind
        }

        argsStr: str = ""
        first: bool = true
        argIdx: num = 0
        fr aReg of argRegs {
            aType = argTypes[argIdx]
            tStr: str = llvmType aType
            if !first {
                argsStr = argsStr + ", "
            }
            argsStr = argsStr + tStr + " " + aReg
            first = false
            argIdx++
        }

        if (calleeName == "ffi.ld" || calleeName == "ffi.load" || calleeName == "ldLib" || calleeName == "loadLib") && argRegs.ln == 1 {
            self.codegen.emitExtern "declare ptr @LoadLibraryA(ptr)"
            pathPtr: str = argRegs[0]
            if argTypes[0] != TypeKind.Str && argTypes[0] != TypeKind.Ptr {
                cReg: str = self.codegen.newReg
                self.codegen.emit `${cReg} = inttoptr i64 ${argRegs[0]} to ptr`
                pathPtr = cReg
            }
            hMod: str = self.codegen.newReg
            self.codegen.emit `${hMod} = call ptr @LoadLibraryA(ptr ${pathPtr})`
            hInt: str = self.codegen.newReg
            self.codegen.emit `${hInt} = ptrtoint ptr ${hMod} to i64`
            res: ExprResult = { reg: hInt, typeKind: TypeKind.I64 }
            -> res
        }

        if (calleeName == "ffi.sym" || calleeName == "ffi.getSym" || calleeName == "getSym" || calleeName == "ffi.symbol" || calleeName == "symbol") && argRegs.ln == 2 {
            self.codegen.emitExtern "declare ptr @GetProcAddress(ptr, ptr)"
            hInt: str = argRegs[0]
            if argTypes[0] == TypeKind.Num {
                conv: str = self.codegen.newReg
                self.codegen.emit `${conv} = fptosi double ${hInt} to i64`
                hInt = conv
            }
            hPtr: str = self.codegen.newReg
            self.codegen.emit `${hPtr} = inttoptr i64 ${hInt} to ptr`
            symPtr: str = argRegs[1]
            if argTypes[1] != TypeKind.Str && argTypes[1] != TypeKind.Ptr {
                cReg: str = self.codegen.newReg
                self.codegen.emit `${cReg} = inttoptr i64 ${argRegs[1]} to ptr`
                symPtr = cReg
            }
            fnPtr: str = self.codegen.newReg
            self.codegen.emit `${fnPtr} = call ptr @GetProcAddress(ptr ${hPtr}, ptr ${symPtr})`
            fnInt: str = self.codegen.newReg
            self.codegen.emit `${fnInt} = ptrtoint ptr ${fnPtr} to i64`
            res: ExprResult = { reg: fnInt, typeKind: TypeKind.I64 }
            -> res
        }

        if (calleeName == "ffi.cls" || calleeName == "ffi.close" || calleeName == "clsLib" || calleeName == "closeLib") && argRegs.ln == 1 {
            self.codegen.emitExtern "declare i32 @FreeLibrary(ptr)"
            hInt: str = argRegs[0]
            if argTypes[0] == TypeKind.Num {
                conv: str = self.codegen.newReg
                self.codegen.emit `${conv} = fptosi double ${hInt} to i64`
                hInt = conv
            }
            hPtr: str = self.codegen.newReg
            self.codegen.emit `${hPtr} = inttoptr i64 ${hInt} to ptr`
            fRes: str = self.codegen.newReg
            self.codegen.emit `${fRes} = call i32 @FreeLibrary(ptr ${hPtr})`
            res: ExprResult = { reg: "0", typeKind: TypeKind.I64 }
            -> res
        }

        if (calleeName == "ffi.call" || calleeName == "call") && argRegs.ln >= 1 {
            fnInt: str = argRegs[0]
            if argTypes[0] == TypeKind.Num {
                conv: str = self.codegen.newReg
                self.codegen.emit `${conv} = fptosi double ${fnInt} to i64`
                fnInt = conv
            }
            fnPtr: str = self.codegen.newReg
            self.codegen.emit `${fnPtr} = inttoptr i64 ${fnInt} to ptr`
            callArgsStr: str = ""
            firstArg: bool = true
            cIdx: num = 1
            wh cIdx < argRegs.ln {
                cReg: str = argRegs[cIdx]
                cType = argTypes[cIdx]
                aInt: str = cReg
                if cType == TypeKind.Str || cType == TypeKind.Ptr {
                    pInt: str = self.codegen.newReg
                    self.codegen.emit `${pInt} = ptrtoint ptr ${cReg} to i64`
                    aInt = pInt
                } els if cType == TypeKind.Num {
                    conv: str = self.codegen.newReg
                    self.codegen.emit `${conv} = fptosi double ${cReg} to i64`
                    aInt = conv
                } els if cType == TypeKind.I32 || cType == TypeKind.I16 || cType == TypeKind.I8 {
                    exReg: str = self.codegen.newReg
                    srcT: str = llvmType cType
                    self.codegen.emit `${exReg} = sext ${srcT} ${cReg} to i64`
                    aInt = exReg
                }
                if !firstArg {
                    callArgsStr = callArgsStr + ", "
                }
                callArgsStr = callArgsStr + "i64 " + aInt
                firstArg = false
                cIdx++
            }
            resReg: str = self.codegen.newReg
            self.codegen.emit `${resReg} = call i64 ${fnPtr}(${callArgsStr})`
            res: ExprResult = { reg: resReg, typeKind: TypeKind.I64 }
            -> res
        }

        if (calleeName == "sh" || calleeName == "sys" || calleeName == "exec") && argRegs.ln == 1 {
            cmdReg: str = argRegs[0]
            self.codegen.emitExtern "declare i32 @system(ptr)"
            sysRes: str = self.codegen.newReg
            self.codegen.emit `${sysRes} = call i32 @system(ptr ${cmdReg})`
            intRes: str = self.codegen.newReg
            self.codegen.emit `${intRes} = sext i32 ${sysRes} to i64`
            res: ExprResult = { reg: intRes, typeKind: TypeKind.I64 }
            -> res
        }

        if calleeName == "BigInt" {
            if argRegs.ln > 0 {
                firstArgReg: str = argRegs[0]
                firstArgType: TypeKind = argTypes[0]
                if firstArgType == TypeKind.Str || firstArgType == TypeKind.Ptr {
                    bRes: ExprResult = { reg: firstArgReg, typeKind: TypeKind.Str }
                    -> bRes
                }
                intValReg: str = firstArgReg
                if firstArgType == TypeKind.Num {
                    convInt: str = self.codegen.newReg
                    self.codegen.emit `${convInt} = fptosi double ${firstArgReg} to i64`
                    intValReg = convInt
                } els if firstArgType == TypeKind.I32 || firstArgType == TypeKind.I16 || firstArgType == TypeKind.I8 {
                    exReg: str = self.codegen.newReg
                    srcType: str = llvmType firstArgType
                    self.codegen.emit `${exReg} = sext ${srcType} ${firstArgReg} to i64`
                    intValReg = exReg
                }
                bufReg: str = self.codegen.newReg
                self.codegen.emit `${bufReg} = call ptr @malloc(i64 32)`
                fmtConst: str = self.codegen.addStringConstant "%lld"
                self.codegen.emit `call i32 (ptr, i64, ptr, ...) @snprintf(ptr ${bufReg}, i64 32, ptr ${fmtConst}, i64 ${intValReg})`
                bRes: ExprResult = { reg: bufReg, typeKind: TypeKind.Str }
                -> bRes
            }
            zeroConst: str = self.codegen.addStringConstant "0"
            ptrReg: str = self.codegen.newReg
            self.codegen.emit `${ptrReg} = getelementptr inbounds i8, ptr ${zeroConst}, i64 0`
            bRes: ExprResult = { reg: ptrReg, typeKind: TypeKind.Str }
            -> bRes
        }

        if (calleeName == "Prm.all" || calleeName == "Promise.all") && argRegs.ln == 1 {
            arrPtr: str = argRegs[0]
            if argTypes[0] != TypeKind.Arr && argTypes[0] != TypeKind.Ptr {
                cReg: str = self.codegen.newReg
                self.codegen.emit `${cReg} = inttoptr i64 ${argRegs[0]} to ptr`
                arrPtr = cReg
            }
            prmPtr: str = self.codegen.newReg
            self.codegen.emit `${prmPtr} = call ptr @zuv_prm_all(ptr ${arrPtr})`
            intReg: str = self.codegen.newReg
            self.codegen.emit `${intReg} = ptrtoint ptr ${prmPtr} to i64`
            res: ExprResult = { reg: intReg, typeKind: TypeKind.I64 }
            -> res
        }
        if (calleeName == "Prm.race" || calleeName == "Promise.race") && argRegs.ln == 1 {
            arrPtr: str = argRegs[0]
            if argTypes[0] != TypeKind.Arr && argTypes[0] != TypeKind.Ptr {
                cReg: str = self.codegen.newReg
                self.codegen.emit `${cReg} = inttoptr i64 ${argRegs[0]} to ptr`
                arrPtr = cReg
            }
            prmPtr: str = self.codegen.newReg
            self.codegen.emit `${prmPtr} = call ptr @zuv_prm_race(ptr ${arrPtr})`
            intReg: str = self.codegen.newReg
            self.codegen.emit `${intReg} = ptrtoint ptr ${prmPtr} to i64`
            res: ExprResult = { reg: intReg, typeKind: TypeKind.I64 }
            -> res
        }
        if (calleeName == "Prm.allSettled" || calleeName == "Promise.allSettled") && argRegs.ln == 1 {
            arrPtr: str = argRegs[0]
            if argTypes[0] != TypeKind.Arr && argTypes[0] != TypeKind.Ptr {
                cReg: str = self.codegen.newReg
                self.codegen.emit `${cReg} = inttoptr i64 ${argRegs[0]} to ptr`
                arrPtr = cReg
            }
            prmPtr: str = self.codegen.newReg
            self.codegen.emit `${prmPtr} = call ptr @zuv_prm_all_settled(ptr ${arrPtr})`
            intReg: str = self.codegen.newReg
            self.codegen.emit `${intReg} = ptrtoint ptr ${prmPtr} to i64`
            res: ExprResult = { reg: intReg, typeKind: TypeKind.I64 }
            -> res
        }

        if (calleeName == "fs.wFAsync" || calleeName == "wFAsync") && argRegs.ln == 2 {
            pPtr: str = argRegs[0]
            if argTypes[0] != TypeKind.Str && argTypes[0] != TypeKind.Ptr {
                cReg: str = self.codegen.newReg
                self.codegen.emit `${cReg} = inttoptr i64 ${argRegs[0]} to ptr`
                pPtr = cReg
            }
            dPtr: str = argRegs[1]
            if argTypes[1] != TypeKind.Str && argTypes[1] != TypeKind.Ptr {
                cReg: str = self.codegen.newReg
                self.codegen.emit `${cReg} = inttoptr i64 ${argRegs[1]} to ptr`
                dPtr = cReg
            }
            prmPtr: str = self.codegen.newReg
            self.codegen.emit `${prmPtr} = call ptr @zuv_fs_wf_async(ptr ${pPtr}, ptr ${dPtr})`
            intReg: str = self.codegen.newReg
            self.codegen.emit `${intReg} = ptrtoint ptr ${prmPtr} to i64`
            res: ExprResult = { reg: intReg, typeKind: TypeKind.I64 }
            -> res
        }

        if (calleeName == "fs.rFAsync" || calleeName == "rFAsync") && argRegs.ln == 1 {
            pPtr: str = argRegs[0]
            if argTypes[0] != TypeKind.Str && argTypes[0] != TypeKind.Ptr {
                cReg: str = self.codegen.newReg
                self.codegen.emit `${cReg} = inttoptr i64 ${argRegs[0]} to ptr`
                pPtr = cReg
            }
            prmPtr: str = self.codegen.newReg
            self.codegen.emit `${prmPtr} = call ptr @zuv_fs_rf_async(ptr ${pPtr})`
            intReg: str = self.codegen.newReg
            self.codegen.emit `${intReg} = ptrtoint ptr ${prmPtr} to i64`
            res: ExprResult = { reg: intReg, typeKind: TypeKind.I64 }
            -> res
        }

        if (calleeName == "memcpy" || calleeName == "mem.cp" || calleeName == "mem.copy") && argRegs.ln >= 3 {
            dPtr: str = argRegs[0]
            if argTypes[0] != TypeKind.Ptr && argTypes[0] != TypeKind.Str {
                cReg: str = self.codegen.newReg
                self.codegen.emit `${cReg} = inttoptr i64 ${argRegs[0]} to ptr`
                dPtr = cReg
            }
            sPtr: str = argRegs[1]
            if argTypes[1] != TypeKind.Ptr && argTypes[1] != TypeKind.Str {
                cReg: str = self.codegen.newReg
                self.codegen.emit `${cReg} = inttoptr i64 ${argRegs[1]} to ptr`
                sPtr = cReg
            }
            lenReg: str = argRegs[2]
            if argTypes[2] != TypeKind.I64 {
                cReg: str = self.codegen.newReg
                if argTypes[2] == TypeKind.Num {
                    self.codegen.emit `${cReg} = fptosi double ${argRegs[2]} to i64`
                } els {
                    iType: str = llvmType argTypes[2]
                    self.codegen.emit `${cReg} = sext ${iType} ${argRegs[2]} to i64`
                }
                lenReg = cReg
            }
            self.codegen.emit `call ptr @memcpy(ptr ${dPtr}, ptr ${sPtr}, i64 ${lenReg})`
            res: ExprResult = { reg: argRegs[0], typeKind: TypeKind.I64 }
            -> res
        }

        if (calleeName == "fs.rm" || calleeName == "rm" || calleeName == "rmF" || calleeName == "fs.rmF") && argRegs.ln >= 1 {
            pPtr: str = argRegs[0]
            if argTypes[0] != TypeKind.Str && argTypes[0] != TypeKind.Ptr {
                cReg: str = self.codegen.newReg
                self.codegen.emit `${cReg} = inttoptr i64 ${argRegs[0]} to ptr`
                pPtr = cReg
            }
            resReg: str = self.codegen.newReg
            self.codegen.emit `${resReg} = call i32 @remove(ptr ${pPtr})`
            sextReg: str = self.codegen.newReg
            self.codegen.emit `${sextReg} = sext i32 ${resReg} to i64`
            res: ExprResult = { reg: sextReg, typeKind: TypeKind.I64 }
            -> res
        }

        if calleeName == "prnt" || calleeName == "lg" || calleeName == "wrn" || calleeName == "inf" || calleeName == "err" {
            fmtStr: str = "%s\n"
            numFmtStr: str = "%lld\n"
            dblFmtStr: str = "%g\n"
            if calleeName == "lg" {
                fmtStr = "\\1B[1;32m[LOG]\\1B[0m %s\n"
                numFmtStr = "\\1B[1;32m[LOG]\\1B[0m %lld\n"
                dblFmtStr = "\\1B[1;32m[LOG]\\1B[0m %g\n"
            } els if calleeName == "wrn" {
                fmtStr = "\\1B[1;33m[WARN]\\1B[0m %s\n"
                numFmtStr = "\\1B[1;33m[WARN]\\1B[0m %lld\n"
                dblFmtStr = "\\1B[1;33m[WARN]\\1B[0m %g\n"
            } els if calleeName == "inf" {
                fmtStr = "\\1B[1;36m[INFO]\\1B[0m %s\n"
                numFmtStr = "\\1B[1;36m[INFO]\\1B[0m %lld\n"
                dblFmtStr = "\\1B[1;36m[INFO]\\1B[0m %g\n"
            } els if calleeName == "err" {
                fmtStr = "\\1B[1;31m[ERR]\\1B[0m %s\n"
                numFmtStr = "\\1B[1;31m[ERR]\\1B[0m %lld\n"
                dblFmtStr = "\\1B[1;31m[ERR]\\1B[0m %g\n"
            }
            fmtConst: str = self.codegen.addStringConstant fmtStr
            if argRegs.ln > 0 {
                firstArgReg: str = argRegs[0]
                firstArgType = argTypes[0]
                if firstArgType == TypeKind.Str || firstArgType == TypeKind.Ptr || firstArgType == TypeKind.Arr || firstArgType == TypeKind.Obj {
                    self.codegen.emit `call i32 (ptr, ...) @printf(ptr ${fmtConst}, ptr ${firstArgReg})`
                } els if firstArgType == TypeKind.Num {
                    dFmt: str = self.codegen.addStringConstant dblFmtStr
                    self.codegen.emit `call i32 (ptr, ...) @printf(ptr ${dFmt}, double ${firstArgReg})`
                } els if firstArgType == TypeKind.Bool {
                    strTrue: str = self.codegen.addStringConstant "true"
                    strFalse: str = self.codegen.addStringConstant "false"
                    boolPtr: str = self.codegen.newReg
                    self.codegen.emit `${boolPtr} = select i1 ${firstArgReg}, ptr ${strTrue}, ptr ${strFalse}`
                    self.codegen.emit `call i32 (ptr, ...) @printf(ptr ${fmtConst}, ptr ${boolPtr})`
                } els if firstArgType == TypeKind.I8 {
                    zextReg: str = self.codegen.newReg
                    self.codegen.emit `${zextReg} = zext i8 ${firstArgReg} to i64`
                    numFmt: str = self.codegen.addStringConstant numFmtStr
                    self.codegen.emit `call i32 (ptr, ...) @printf(ptr ${numFmt}, i64 ${zextReg})`
                } els if firstArgType == TypeKind.I16 {
                    zextReg: str = self.codegen.newReg
                    self.codegen.emit `${zextReg} = zext i16 ${firstArgReg} to i64`
                    numFmt: str = self.codegen.addStringConstant numFmtStr
                    self.codegen.emit `call i32 (ptr, ...) @printf(ptr ${numFmt}, i64 ${zextReg})`
                } els if firstArgType == TypeKind.I32 {
                    sextReg: str = self.codegen.newReg
                    self.codegen.emit `${sextReg} = sext i32 ${firstArgReg} to i64`
                    numFmt: str = self.codegen.addStringConstant numFmtStr
                    self.codegen.emit `call i32 (ptr, ...) @printf(ptr ${numFmt}, i64 ${sextReg})`
                } els if firstArgType == TypeKind.I64 {
                    numFmt: str = self.codegen.addStringConstant numFmtStr
                    self.codegen.emit `call i32 (ptr, ...) @printf(ptr ${numFmt}, i64 ${firstArgReg})`
                } els {
                    unwrappedReg: str = self.codegen.newReg
                    self.codegen.emit `${unwrappedReg} = call i64 @zuv_prm_await(i64 ${firstArgReg})`
                    isSmallReg: str = self.codegen.newReg
                    pNumLbl: str = self.codegen.newLabel "p_num"
                    pStrLbl: str = self.codegen.newLabel "p_str"
                    pEndLbl: str = self.codegen.newLabel "p_end"
                    self.codegen.emit `${isSmallReg} = icmp ult i64 ${unwrappedReg}, 65536`
                    self.codegen.emit `br i1 ${isSmallReg}, label %${pNumLbl}, label %${pStrLbl}`
                    self.codegen.emitLabel pStrLbl
                    pPtrReg: str = self.codegen.newReg
                    self.codegen.emit `${pPtrReg} = inttoptr i64 ${unwrappedReg} to ptr`
                    self.codegen.emit `call i32 (ptr, ...) @printf(ptr ${fmtConst}, ptr ${pPtrReg})`
                    self.codegen.emit `br label %${pEndLbl}`
                    self.codegen.emitLabel pNumLbl
                    numFmt: str = self.codegen.addStringConstant numFmtStr
                    self.codegen.emit `call i32 (ptr, ...) @printf(ptr ${numFmt}, i64 ${unwrappedReg})`
                    self.codegen.emit `br label %${pEndLbl}`
                    self.codegen.emitLabel pEndLbl
                }
            } els {
                emptyFmt: str = self.codegen.addStringConstant "\n"
                self.codegen.emit `call i32 (ptr, ...) @printf(ptr ${emptyFmt})`
            }
            vRes: ExprResult = { reg: "", typeKind: TypeKind.Void }
            -> vRes
        }

        if self.isDecoratedMethod calleeName {
            origLoad: str = self.codegen.newReg
            self.codegen.emit `${origLoad} = load i64, ptr @${calleeName}_orig`
            self.codegen.emit `store i64 ${origLoad}, ptr @__active_decor_orig`
            ctxLoad: str = self.codegen.newReg
            self.codegen.emit `${ctxLoad} = load i64, ptr @${calleeName}_ctx`
            self.codegen.emit `store i64 ${ctxLoad}, ptr @__active_decor_ctx`
            fnBits: str = self.codegen.newReg
            self.codegen.emit `${fnBits} = load i64, ptr @${calleeName}_fnptr`
            fnPtr: str = self.codegen.newReg
            self.codegen.emit `${fnPtr} = inttoptr i64 ${fnBits} to ptr`

            boxedArgs: str[] = []
            fr child, cIdx of node.children {
                if cIdx == 0 { cont }
                cRes: ExprResult = self.emitExpr child
                bVal: str = cRes.reg
                if cRes.typeKind == TypeKind.Num {
                    cReg: str = self.codegen.newReg
                    self.codegen.emit `${cReg} = fptosi double ${cRes.reg} to i64`
                    bVal = cReg
                } els if cRes.typeKind == TypeKind.Str || cRes.typeKind == TypeKind.Ptr || cRes.typeKind == TypeKind.Arr || cRes.typeKind == TypeKind.Obj {
                    cReg: str = self.codegen.newReg
                    self.codegen.emit `${cReg} = ptrtoint ptr ${cRes.reg} to i64`
                    bVal = cReg
                }
                boxedArgs.psh bVal
            }
            wh boxedArgs.ln < 4 {
                boxedArgs.psh "0"
            }
            argsCallStr: str = ""
            firstArg: bool = true
            fr bArg of boxedArgs {
                if !firstArg { argsCallStr = argsCallStr + ", " }
                argsCallStr = argsCallStr + "i64 " + bArg
                firstArg = false
            }
            callRes: str = self.codegen.newReg
            self.codegen.emit `${callRes} = call i64 ${fnPtr}(${argsCallStr})`
            origSig: FuncSignature = self.findFunc calleeName
            retKind = node.inferredType
            if retKind == TypeKind.Unknown && origSig.name.ln > 0 {
                if origSig.retType == "ptr" {
                    retKind = TypeKind.Str
                } els if origSig.retType == "void" {
                    retKind = TypeKind.Void
                } els if origSig.retType == "double" {
                    retKind = TypeKind.Num
                } els if origSig.retType == "i1" {
                    retKind = TypeKind.Bool
                } els {
                    retKind = TypeKind.I64
                }
            }
            if retKind == TypeKind.Unknown {
                retKind = TypeKind.I64
            }
            finalReg: str = callRes
            if retKind == TypeKind.Str || retKind == TypeKind.Ptr || retKind == TypeKind.Arr || retKind == TypeKind.Obj {
                ptrReg: str = self.codegen.newReg
                self.codegen.emit `${ptrReg} = inttoptr i64 ${callRes} to ptr`
                finalReg = ptrReg
            }
            res: ExprResult = { reg: finalReg, typeKind: retKind }
            -> res
        }

        fnSig: FuncSignature = self.findFunc calleeName
        if fnSig.name.ln > 0 {
            userArgsStr: str = ""
            userFirst: bool = true
            uIdx: num = 0
            fr aReg of argRegs {
                aType = argTypes[uIdx]
                expectedLLVM: str = (uIdx < fnSig.paramTypes.ln ? fnSig.paramTypes[uIdx] : "i64")
                actualLLVM: str = llvmType aType
                passedReg: str = aReg
                if expectedLLVM == "i64" && (actualLLVM == "ptr" || aType == TypeKind.Str || aType == TypeKind.Ptr) {
                    convReg: str = self.codegen.newReg
                    self.codegen.emit `${convReg} = ptrtoint ptr ${aReg} to i64`
                    passedReg = convReg
                } els if expectedLLVM == "i64" && (actualLLVM == "i1" || aType == TypeKind.Bool) {
                    convReg: str = self.codegen.newReg
                    self.codegen.emit `${convReg} = zext i1 ${aReg} to i64`
                    passedReg = convReg
                } els if expectedLLVM == "i64" && (actualLLVM == "i32" || aType == TypeKind.I32) {
                    convReg: str = self.codegen.newReg
                    self.codegen.emit `${convReg} = sext i32 ${aReg} to i64`
                    passedReg = convReg
                } els if expectedLLVM == "i64" && (actualLLVM == "double" || aType == TypeKind.Num) {
                    convReg: str = self.codegen.newReg
                    self.codegen.emit `${convReg} = fptosi double ${aReg} to i64`
                    passedReg = convReg
                } els if expectedLLVM == "double" && (actualLLVM == "i64" || aType == TypeKind.I64) {
                    convReg: str = self.codegen.newReg
                    self.codegen.emit `${convReg} = sitofp i64 ${aReg} to double`
                    passedReg = convReg
                } els if expectedLLVM == "double" && (actualLLVM == "i32" || aType == TypeKind.I32) {
                    convReg: str = self.codegen.newReg
                    self.codegen.emit `${convReg} = sitofp i32 ${aReg} to double`
                    passedReg = convReg
                } els if expectedLLVM == "i32" && (actualLLVM == "i64" || aType == TypeKind.I64) {
                    convReg: str = self.codegen.newReg
                    self.codegen.emit `${convReg} = trunc i64 ${aReg} to i32`
                    passedReg = convReg
                } els if expectedLLVM == "i1" && (actualLLVM == "i64" || aType == TypeKind.I64) {
                    convReg: str = self.codegen.newReg
                    self.codegen.emit `${convReg} = trunc i64 ${aReg} to i1`
                    passedReg = convReg
                } els if expectedLLVM == "ptr" && (actualLLVM == "i64" || aType == TypeKind.I64) {
                    convReg: str = self.codegen.newReg
                    self.codegen.emit `${convReg} = inttoptr i64 ${aReg} to ptr`
                    passedReg = convReg
                }
                if !userFirst {
                    userArgsStr = userArgsStr + ", "
                }
                userArgsStr = userArgsStr + expectedLLVM + " " + passedReg
                userFirst = false
                uIdx++
            }
            if fnSig.retType == "void" {
                self.codegen.emit `call void @${calleeName}(${userArgsStr})`
                vRes: ExprResult = { reg: "", typeKind: TypeKind.Void }
                -> vRes
            }
            callReg: str = self.codegen.newReg
            self.codegen.emit `${callReg} = call ${fnSig.retType} @${calleeName}(${userArgsStr})`
            retKind = TypeKind.I64
            if fnSig.retType == "double" {
                retKind = TypeKind.Num
            } els if fnSig.retType == "i1" {
                retKind = TypeKind.Bool
            } els if fnSig.retType == "ptr" {
                retKind = TypeKind.Str
            } els if fnSig.retType == "i32" {
                retKind = TypeKind.I32
            }
            res: ExprResult = { reg: callReg, typeKind: retKind }
            -> res
        }

        targetRole: num = 0
        calleeSym: ScopeSymbol = self.findSymbol calleeName
        if calleeSym.name.ln > 0 && calleeSym.decorRole > 0 {
            targetRole = calleeSym.decorRole
        } els {
            targetRole = self.getDecorRole calleeName
        }
        if targetRole == 1 {
            fnBits: str = self.codegen.newReg
            self.codegen.emit `${fnBits} = load i64, ptr @__active_decor_orig`
            fnPtr: str = self.codegen.newReg
            self.codegen.emit `${fnPtr} = inttoptr i64 ${fnBits} to ptr`

            unpackedRegs: str[] = []
            fr child, cIdx of node.children {
                if cIdx == 0 { cont }
                if child.kind == NodeKind.UnaryExpr && child.op == "..." {
                    spRes: ExprResult = self.emitExpr child.children[0]
                    arrPtrReg: str = spRes.reg
                    if spRes.typeKind != TypeKind.Arr && spRes.typeKind != TypeKind.Ptr {
                        convReg: str = self.codegen.newReg
                        self.codegen.emit `${convReg} = inttoptr i64 ${spRes.reg} to ptr`
                        arrPtrReg = convReg
                    }
                    k: num = 1
                    wh k <= 4 {
                        eGep: str = self.codegen.newReg
                        self.codegen.emit `${eGep} = getelementptr inbounds i64, ptr ${arrPtrReg}, i64 ${k}`
                        eVal: str = self.codegen.newReg
                        self.codegen.emit `${eVal} = load i64, ptr ${eGep}`
                        unpackedRegs.psh eVal
                        k++
                    }
                } els {
                    cRes: ExprResult = self.emitExpr child
                    bVal: str = cRes.reg
                    if cRes.typeKind == TypeKind.Num {
                        cReg: str = self.codegen.newReg
                        self.codegen.emit `${cReg} = fptosi double ${cRes.reg} to i64`
                        bVal = cReg
                    } els if cRes.typeKind == TypeKind.Str || cRes.typeKind == TypeKind.Ptr || cRes.typeKind == TypeKind.Arr || cRes.typeKind == TypeKind.Obj {
                        cReg: str = self.codegen.newReg
                        self.codegen.emit `${cReg} = ptrtoint ptr ${cRes.reg} to i64`
                        bVal = cReg
                    }
                    unpackedRegs.psh bVal
                }
            }
            callArgsStr: str = ""
            firstArg: bool = true
            fr uReg of unpackedRegs {
                if !firstArg { callArgsStr = callArgsStr + ", " }
                callArgsStr = callArgsStr + "i64 " + uReg
                firstArg = false
            }
            callRes: str = self.codegen.newReg
            self.codegen.emit `${callRes} = call i64 ${fnPtr}(${callArgsStr})`
            res: ExprResult = { reg: callRes, typeKind: TypeKind.I64 }
            -> res
        }

        if calleeSym.name.ln > 0 || calleeNode.kind != NodeKind.IdentExpr {
            calleePtrReg: str = ""
            if calleeNode.kind != NodeKind.IdentExpr {
                cRes: ExprResult = self.emitExpr calleeNode
                if cRes.typeKind != TypeKind.Ptr {
                    ptrReg: str = self.codegen.newReg
                    self.codegen.emit `${ptrReg} = inttoptr i64 ${cRes.reg} to ptr`
                    calleePtrReg = ptrReg
                } els {
                    calleePtrReg = cRes.reg
                }
            } els if calleeSym.isAlloca {
                loadFnReg: str = self.codegen.newReg
                stType: str = llvmStackType calleeSym.typeKind
                self.codegen.emit `${loadFnReg} = load ${stType}, ptr ${calleeSym.reg}`
                if stType != "ptr" {
                    ptrReg: str = self.codegen.newReg
                    self.codegen.emit `${ptrReg} = inttoptr i64 ${loadFnReg} to ptr`
                    calleePtrReg = ptrReg
                } els {
                    calleePtrReg = loadFnReg
                }
            } els {
                if calleeSym.typeKind != TypeKind.Ptr {
                    ptrReg: str = self.codegen.newReg
                    self.codegen.emit `${ptrReg} = inttoptr i64 ${calleeSym.reg} to ptr`
                    calleePtrReg = ptrReg
                } els {
                    calleePtrReg = calleeSym.reg
                }
            }
            fnCallArgsStr: str = ""
            firstFnArg: bool = true
            fArgIdx: num = 0
            fr aReg of argRegs {
                aType = argTypes[fArgIdx]
                boxedArg: str = aReg
                if aType == TypeKind.Num {
                    cReg: str = self.codegen.newReg
                    self.codegen.emit `${cReg} = fptosi double ${aReg} to i64`
                    boxedArg = cReg
                } els if aType == TypeKind.Str || aType == TypeKind.Ptr || aType == TypeKind.Arr || aType == TypeKind.Obj {
                    cReg: str = self.codegen.newReg
                    self.codegen.emit `${cReg} = ptrtoint ptr ${aReg} to i64`
                    boxedArg = cReg
                } els if aType == TypeKind.Bool || aType == TypeKind.I8 {
                    cReg: str = self.codegen.newReg
                    srcLLVM: str = (aType == TypeKind.Bool) ? "i1" : "i8"
                    self.codegen.emit `${cReg} = zext ${srcLLVM} ${aReg} to i64`
                    boxedArg = cReg
                } els if aType == TypeKind.I32 {
                    cReg: str = self.codegen.newReg
                    self.codegen.emit `${cReg} = sext i32 ${aReg} to i64`
                    boxedArg = cReg
                }
                if !firstFnArg {
                    fnCallArgsStr = fnCallArgsStr + ", "
                }
                fnCallArgsStr = fnCallArgsStr + "i64 " + boxedArg
                firstFnArg = false
                fArgIdx++
            }
            callReg: str = self.codegen.newReg
            self.codegen.emit `${callReg} = call i64 ${calleePtrReg}(${fnCallArgsStr})`
            res: ExprResult = { reg: callReg, typeKind: TypeKind.I64 }
            -> res
        }

        retType = node.inferredType
        if retType == TypeKind.Unknown {
            retType = TypeKind.I64
        }
        if retType == TypeKind.Void {
            self.codegen.emit `call void @${calleeName}(${argsStr})`
            vRes: ExprResult = { reg: "", typeKind: TypeKind.Void }
            -> vRes
        }
        retTypeStr: str = llvmType retType
        callReg: str = self.codegen.newReg
        self.codegen.emit `${callReg} = call ${retTypeStr} @${calleeName}(${argsStr})`
        res: ExprResult = { reg: callReg, typeKind: retType }
        -> res
    },

    /**
     * Emits a method call expression (.psh, .pop, or general receiver method).
     *
     * @param {ASTNode} node - Method call AST node
     * @returns {ExprResult} Result descriptor
     */
    emitMethodCall: node: ASTNode :: ExprResult => {
        targetNode: ASTNode = node.children[0]
        methodName: str = node.name

        if targetNode.kind == NodeKind.IdentExpr && (targetNode.name == "fs" || targetNode.name == "net" || targetNode.name == "os" || targetNode.name == "sys" || targetNode.name == "io" || targetNode.name == "mem") {
            cName: str = targetNode.name + "." + methodName
            cNode: ASTNode = ASTNode.createIdent cName, node.line, node.col
            callChildren: ASTNode[] = [cNode]
            fr child, cIdx of node.children {
                if cIdx == 0 { cont }
                callChildren.psh child
            }
            cCallNode: ASTNode = ASTNode.createCall cNode, [], node.line, node.col
            cCallNode.children = callChildren
            cCallNode.inferredType = node.inferredType
            -> self.emitCall cCallNode
        }

        if methodName == "psh" || methodName == "push" {
            arrRes: ExprResult = self.emitExpr targetNode
            valRes: ExprResult = self.emitExpr node.children[1]
            varSlot: str = ""
            varIsI64: bool = false
            if targetNode.kind == NodeKind.IdentExpr {
                foundSym = self.findSymbol targetNode.name
                if foundSym.isAlloca {
                    varSlot = foundSym.reg
                    if foundSym.typeKind != TypeKind.Arr && foundSym.typeKind != TypeKind.Ptr {
                        varIsI64 = true
                    }
                }
            }
            arrPtrReg: str = arrRes.reg
            if arrRes.typeKind != TypeKind.Arr && arrRes.typeKind != TypeKind.Ptr {
                convReg: str = self.codegen.newReg
                self.codegen.emit `${convReg} = inttoptr i64 ${arrRes.reg} to ptr`
                arrPtrReg = convReg
            }
            lenReg: str = self.arrGen.emitPush arrPtrReg, valRes.reg, valRes.typeKind, varSlot, varIsI64
            res: ExprResult = { reg: lenReg, typeKind: TypeKind.I64 }
            -> res
        }

        if methodName == "pp" || methodName == "pop" {
            arrRes: ExprResult = self.emitExpr targetNode
            arrPtrReg: str = arrRes.reg
            if arrRes.typeKind != TypeKind.Arr && arrRes.typeKind != TypeKind.Ptr {
                convReg: str = self.codegen.newReg
                self.codegen.emit `${convReg} = inttoptr i64 ${arrRes.reg} to ptr`
                arrPtrReg = convReg
            }
            popType = node.inferredType
            if popType == TypeKind.Unknown {
                popType = TypeKind.I64
            }
            valReg: str = self.arrGen.emitPop arrPtrReg
            res: ExprResult = { reg: valReg, typeKind: popType }
            -> res
        }

        if methodName == "cat" || methodName == "concat" {
            targetRes: ExprResult = self.emitExpr targetNode
            argRes: ExprResult = self.emitExpr node.children[1]
            l1Reg: str = self.codegen.newReg
            self.codegen.emit `${l1Reg} = call i64 @strlen(ptr ${targetRes.reg})`
            l2Reg: str = self.codegen.newReg
            self.codegen.emit `${l2Reg} = call i64 @strlen(ptr ${argRes.reg})`
            totLen: str = self.codegen.newReg
            self.codegen.emit `${totLen} = add i64 ${l1Reg}, ${l2Reg}`
            allocLen: str = self.codegen.newReg
            self.codegen.emit `${allocLen} = add i64 ${totLen}, 1`
            bufReg: str = self.codegen.newReg
            self.codegen.emit `${bufReg} = call ptr @malloc(i64 ${allocLen})`
            cpy1: str = self.codegen.newReg
            self.codegen.emit `${cpy1} = call ptr @memcpy(ptr ${bufReg}, ptr ${targetRes.reg}, i64 ${l1Reg})`
            dest2: str = self.codegen.newReg
            self.codegen.emit `${dest2} = getelementptr inbounds i8, ptr ${bufReg}, i64 ${l1Reg}`
            cpy2: str = self.codegen.newReg
            self.codegen.emit `${cpy2} = call ptr @memcpy(ptr ${dest2}, ptr ${argRes.reg}, i64 ${l2Reg})`
            nullTerm: str = self.codegen.newReg
            self.codegen.emit `${nullTerm} = getelementptr inbounds i8, ptr ${bufReg}, i64 ${totLen}`
            self.codegen.emit `store i8 0, ptr ${nullTerm}`
            res: ExprResult = { reg: bufReg, typeKind: TypeKind.Str }
            -> res
        }

        if methodName == "cnt" || methodName == "contains" {
            targetRes: ExprResult = self.emitExpr targetNode
            argRes: ExprResult = self.emitExpr node.children[1]
            foundReg: str = self.codegen.newReg
            self.codegen.emit `${foundReg} = call ptr @strstr(ptr ${targetRes.reg}, ptr ${argRes.reg})`
            cmpReg: str = self.codegen.newReg
            self.codegen.emit `${cmpReg} = icmp ne ptr ${foundReg}, null`
            res: ExprResult = { reg: cmpReg, typeKind: TypeKind.Bool }
            -> res
        }

        if methodName == "eq" {
            targetRes: ExprResult = self.emitExpr targetNode
            argRes: ExprResult = self.emitExpr node.children[1]
            cmpReg: str = self.codegen.newReg
            self.codegen.emit `${cmpReg} = call i32 @strcmp(ptr ${targetRes.reg}, ptr ${argRes.reg})`
            eqReg: str = self.codegen.newReg
            self.codegen.emit `${eqReg} = icmp eq i32 ${cmpReg}, 0`
            res: ExprResult = { reg: eqReg, typeKind: TypeKind.Bool }
            -> res
        }

        if methodName == "sub" || methodName == "substr" || methodName == "slc" || methodName == "slice" {
            targetRes: ExprResult = self.emitExpr targetNode
            startRes: ExprResult = self.emitExpr node.children[1]
            startReg: str = startRes.reg
            if startRes.typeKind == TypeKind.Num {
                cReg: str = self.codegen.newReg
                self.codegen.emit `${cReg} = fptosi double ${startRes.reg} to i64`
                startReg = cReg
            } els if startRes.typeKind == TypeKind.I32 {
                cReg: str = self.codegen.newReg
                self.codegen.emit `${cReg} = sext i32 ${startRes.reg} to i64`
                startReg = cReg
            }
            lenReg: str = ""
            if node.children.ln > 2 {
                secondRes: ExprResult = self.emitExpr node.children[2]
                secondReg: str = secondRes.reg
                if secondRes.typeKind == TypeKind.Num {
                    cReg: str = self.codegen.newReg
                    self.codegen.emit `${cReg} = fptosi double ${secondRes.reg} to i64`
                    secondReg = cReg
                } els if secondRes.typeKind == TypeKind.I32 {
                    cReg: str = self.codegen.newReg
                    self.codegen.emit `${cReg} = sext i32 ${secondRes.reg} to i64`
                    secondReg = cReg
                }
                if methodName == "slc" || methodName == "slice" {
                    subLenReg: str = self.codegen.newReg
                    self.codegen.emit `${subLenReg} = sub i64 ${secondReg}, ${startReg}`
                    lenReg = subLenReg
                } els {
                    lenReg = secondReg
                }
            } els {
                totLenReg: str = self.codegen.newReg
                self.codegen.emit `${totLenReg} = call i64 @strlen(ptr ${targetRes.reg})`
                subLenReg: str = self.codegen.newReg
                self.codegen.emit `${subLenReg} = sub i64 ${totLenReg}, ${startReg}`
                lenReg = subLenReg
            }
            allocLenReg: str = self.codegen.newReg
            self.codegen.emit `${allocLenReg} = add i64 ${lenReg}, 1`
            bufReg: str = self.codegen.newReg
            self.codegen.emit `${bufReg} = call ptr @malloc(i64 ${allocLenReg})`
            srcPtrReg: str = self.codegen.newReg
            self.codegen.emit `${srcPtrReg} = getelementptr inbounds i8, ptr ${targetRes.reg}, i64 ${startReg}`
            cpyReg: str = self.codegen.newReg
            self.codegen.emit `${cpyReg} = call ptr @memcpy(ptr ${bufReg}, ptr ${srcPtrReg}, i64 ${lenReg})`
            nullTerm: str = self.codegen.newReg
            self.codegen.emit `${nullTerm} = getelementptr inbounds i8, ptr ${bufReg}, i64 ${lenReg}`
            self.codegen.emit `store i8 0, ptr ${nullTerm}`
            res: ExprResult = { reg: bufReg, typeKind: TypeKind.Str }
            -> res
        }

        if methodName == "chr" || methodName == "charAt" {
            targetRes: ExprResult = self.emitExpr targetNode
            idxRes: ExprResult = self.emitExpr node.children[1]
            idxReg: str = idxRes.reg
            if idxRes.typeKind == TypeKind.Num {
                cReg: str = self.codegen.newReg
                self.codegen.emit `${cReg} = fptosi double ${idxRes.reg} to i64`
                idxReg = cReg
            } els if idxRes.typeKind == TypeKind.I32 {
                cReg: str = self.codegen.newReg
                self.codegen.emit `${cReg} = sext i32 ${idxRes.reg} to i64`
                idxReg = cReg
            }
            sLenReg: str = self.codegen.newReg
            self.codegen.emit `${sLenReg} = call i64 @strlen(ptr ${targetRes.reg})`
            inBoundsReg: str = self.codegen.newReg
            self.codegen.emit `${inBoundsReg} = icmp ult i64 ${idxReg}, ${sLenReg}`
            safeIdxReg: str = self.codegen.newReg
            self.codegen.emit `${safeIdxReg} = select i1 ${inBoundsReg}, i64 ${idxReg}, i64 0`
            bufReg: str = self.codegen.newReg
            self.codegen.emit `${bufReg} = call ptr @malloc(i64 2)`
            srcPtrReg: str = self.codegen.newReg
            self.codegen.emit `${srcPtrReg} = getelementptr inbounds i8, ptr ${targetRes.reg}, i64 ${safeIdxReg}`
            loadedChReg: str = self.codegen.newReg
            self.codegen.emit `${loadedChReg} = load i8, ptr ${srcPtrReg}`
            chValReg: str = self.codegen.newReg
            self.codegen.emit `${chValReg} = select i1 ${inBoundsReg}, i8 ${loadedChReg}, i8 0`
            self.codegen.emit `store i8 ${chValReg}, ptr ${bufReg}`
            nullTermReg: str = self.codegen.newReg
            self.codegen.emit `${nullTermReg} = getelementptr inbounds i8, ptr ${bufReg}, i64 1`
            self.codegen.emit `store i8 0, ptr ${nullTermReg}`
            res: ExprResult = { reg: bufReg, typeKind: TypeKind.Str }
            -> res
        }

        targetRes: ExprResult = self.emitExpr targetNode

        // Resolve mangled method name (e.g. Greeter_hello, User_greet, App_calculate, UserController_getUsers)
        mangledName: str = ""
        isStaticCall: bool = false
        if targetNode.kind == NodeKind.IdentExpr {
            tName: str = targetNode.name
            if self.objGen.registry.hasType tName {
                mangledName = tName + "_" + methodName
                isStaticCall = true
            }
        }
        if mangledName.ln == 0 {
            mangledName = self.getMethodMapping methodName
        }
        if mangledName.ln == 0 {
            mangledName = methodName
        }

        if self.isDecoratedMethod mangledName {
            origLoad: str = self.codegen.newReg
            self.codegen.emit `${origLoad} = load i64, ptr @${mangledName}_orig`
            self.codegen.emit `store i64 ${origLoad}, ptr @__active_decor_orig`
            ctxLoad: str = self.codegen.newReg
            self.codegen.emit `${ctxLoad} = load i64, ptr @${mangledName}_ctx`
            self.codegen.emit `store i64 ${ctxLoad}, ptr @__active_decor_ctx`
            fnBits: str = self.codegen.newReg
            self.codegen.emit `${fnBits} = load i64, ptr @${mangledName}_fnptr`
            fnPtr: str = self.codegen.newReg
            self.codegen.emit `${fnPtr} = inttoptr i64 ${fnBits} to ptr`

            boxedMethodArgs: str[] = []
            fr child, cIdx of node.children {
                if cIdx == 0 { cont }
                cRes: ExprResult = self.emitExpr child
                bVal: str = cRes.reg
                if cRes.typeKind == TypeKind.Num {
                    cReg: str = self.codegen.newReg
                    self.codegen.emit `${cReg} = fptosi double ${cRes.reg} to i64`
                    bVal = cReg
                } els if cRes.typeKind == TypeKind.Str || cRes.typeKind == TypeKind.Ptr || cRes.typeKind == TypeKind.Arr || cRes.typeKind == TypeKind.Obj {
                    cReg: str = self.codegen.newReg
                    self.codegen.emit `${cReg} = ptrtoint ptr ${cRes.reg} to i64`
                    bVal = cReg
                }
                boxedMethodArgs.psh bVal
            }
            wh boxedMethodArgs.ln < 4 {
                boxedMethodArgs.psh "0"
            }
            mCallArgsStr: str = ""
            firstMArg: bool = true
            fr bArg of boxedMethodArgs {
                if !firstMArg { mCallArgsStr = mCallArgsStr + ", " }
                mCallArgsStr = mCallArgsStr + "i64 " + bArg
                firstMArg = false
            }
            callReg: str = self.codegen.newReg
            self.codegen.emit `${callReg} = call i64 ${fnPtr}(${mCallArgsStr})`
            origSig: FuncSignature = self.findFunc mangledName
            retKind = node.inferredType
            if retKind == TypeKind.Unknown && origSig.name.ln > 0 {
                if origSig.retType == "ptr" {
                    retKind = TypeKind.Str
                } els if origSig.retType == "void" {
                    retKind = TypeKind.Void
                } els if origSig.retType == "double" {
                    retKind = TypeKind.Num
                } els if origSig.retType == "i1" {
                    retKind = TypeKind.Bool
                } els {
                    retKind = TypeKind.I64
                }
            }
            if retKind == TypeKind.Unknown {
                retKind = TypeKind.I64
            }
            finalReg: str = callReg
            if retKind == TypeKind.Str || retKind == TypeKind.Ptr || retKind == TypeKind.Arr || retKind == TypeKind.Obj {
                ptrReg: str = self.codegen.newReg
                self.codegen.emit `${ptrReg} = inttoptr i64 ${callReg} to ptr`
                finalReg = ptrReg
            }
            res: ExprResult = { reg: finalReg, typeKind: retKind }
            -> res
        }

        callMethodArgsStr: str = ""
        firstArg: bool = true
        if !isStaticCall {
            callMethodArgsStr = "ptr " + targetRes.reg
            firstArg = false
        }
        fr child, cIdx of node.children {
            if cIdx == 0 { cont }
            cRes: ExprResult = self.emitExpr child
            tStr: str = llvmType cRes.typeKind
            if !firstArg { callMethodArgsStr = callMethodArgsStr + ", " }
            callMethodArgsStr = callMethodArgsStr + tStr + " " + cRes.reg
            firstArg = false
        }
        retType = node.inferredType
        if retType == TypeKind.Unknown {
            fnSig: FuncSignature = self.findFunc mangledName
            if fnSig.name.ln > 0 {
                if fnSig.retType == "ptr" {
                    retType = TypeKind.Str
                } els if fnSig.retType == "void" {
                    retType = TypeKind.Void
                } els if fnSig.retType == "double" {
                    retType = TypeKind.Num
                } els if fnSig.retType == "i1" {
                    retType = TypeKind.Bool
                } els {
                    retType = TypeKind.I64
                }
            } els {
                retType = TypeKind.I64
            }
        }
        retTypeStr: str = llvmType retType
        callReg: str = self.codegen.newReg
        self.codegen.emit `${callReg} = call ${retTypeStr} @${mangledName}(${callMethodArgsStr})`
        res: ExprResult = { reg: callReg, typeKind: retType }
        -> res
    },

    /**
     * Emits array indexing access (arr[idx]).
     *
     * @param {ASTNode} node - Index expression AST node
     * @returns {ExprResult} Result descriptor
     */
    emitIndex: node: ASTNode :: ExprResult => {
        targetNode: ASTNode = node.children[0]
        idxNode: ASTNode = node.children[1]
        targetRes: ExprResult = self.emitExpr targetNode
        idxRes: ExprResult = self.emitExpr idxNode

        idxReg: str = idxRes.reg
        if idxRes.typeKind == TypeKind.Num {
            cReg: str = self.codegen.newReg
            self.codegen.emit `${cReg} = fptosi double ${idxRes.reg} to i64`
            idxReg = cReg
        } els if idxRes.typeKind == TypeKind.I32 {
            cReg: str = self.codegen.newReg
            self.codegen.emit `${cReg} = sext i32 ${idxRes.reg} to i64`
            idxReg = cReg
        }

        if targetRes.typeKind == TypeKind.Str {
            charPtrReg: str = self.codegen.newReg
            self.codegen.emit `${charPtrReg} = getelementptr inbounds i8, ptr ${targetRes.reg}, i64 ${idxReg}`
            charValReg: str = self.codegen.newReg
            self.codegen.emit `${charValReg} = load i8, ptr ${charPtrReg}`
            bufReg: str = self.codegen.newReg
            self.codegen.emit `${bufReg} = call ptr @malloc(i64 2)`
            self.codegen.emit `store i8 ${charValReg}, ptr ${bufReg}`
            termPtrReg: str = self.codegen.newReg
            self.codegen.emit `${termPtrReg} = getelementptr inbounds i8, ptr ${bufReg}, i64 1`
            self.codegen.emit `store i8 0, ptr ${termPtrReg}`
            res: ExprResult = { reg: bufReg, typeKind: TypeKind.Str }
            -> res
        }

        arrPtrReg: str = targetRes.reg
        if isFloatType targetRes.typeKind {
            convReg: str = self.codegen.newReg
            self.codegen.emit `${convReg} = fptosi double ${targetRes.reg} to i64`
            arrPtrReg = convReg
        }
        if !(isPointerType targetRes.typeKind) {
            convReg: str = self.codegen.newReg
            self.codegen.emit `${convReg} = inttoptr i64 ${arrPtrReg} to ptr`
            arrPtrReg = convReg
        }
        isOpt: bool = (node.op == "?.")
        elemVal: str = self.arrGen.emitGetElement arrPtrReg, idxReg, isOpt, node.line
        targetKind = node.inferredType
        if targetKind == TypeKind.Unknown || targetKind == TypeKind.I64 {
            targetNode: ASTNode = node.children[0]
            if targetNode.kind == NodeKind.PropExpr {
                propName: str = targetNode.name
                parentObj: ASTNode = targetNode.children[0]
                parentName: str = (parentObj.kind == NodeKind.PropExpr || parentObj.kind == NodeKind.IdentExpr) ? parentObj.name : ""
                fDesc: StructField = createStructField "", -1, TypeKind.Unknown, ""
                if parentName.ln > 0 {
                    fr l of self.objGen.registry.layouts {
                        if (l.typeName == parentName || (l.typeName.cnt parentName)) && l.hasField propName {
                            fDesc = l.getField propName
                            brk
                        }
                    }
                }
                if fDesc.name.ln == 0 {
                    fDesc = self.objGen.registry.getFieldField "", propName
                }
                if fDesc.name.ln > 0 && fDesc.typeName.ln > 0 {
                    resolvedType: str = self.objGen.registry.resolveAlias fDesc.typeName
                    elemKind: TypeKind = StrToElemTypeKind resolvedType
                    if elemKind != TypeKind.Unknown {
                        if elemKind == TypeKind.Num {
                            targetKind = TypeKind.I64
                        } els {
                            targetKind = elemKind
                        }
                    }
                }
            } els if targetNode.kind == NodeKind.IdentExpr {
                targetSym = self.findSymbol targetNode.name
                if targetSym.name.ln > 0 && targetSym.typeName.ln > 0 {
                    resolvedType: str = self.objGen.registry.resolveAlias targetSym.typeName
                    elemKind: TypeKind = StrToElemTypeKind resolvedType
                    if elemKind != TypeKind.Unknown {
                        targetKind = elemKind
                    }
                }
            } els if targetNode.kind == NodeKind.IndexExpr && targetNode.children.ln >= 2 {
                baseNode: ASTNode = targetNode.children[0]
                rowNode: ASTNode = targetNode.children[1]
                rowVal: str = rowNode.val
                if baseNode.kind == NodeKind.IdentExpr {
                    if baseNode.name == "matrix" {
                        if rowVal == "3" {
                            targetKind = TypeKind.Bool
                        } els if rowVal == "4" {
                            targetKind = TypeKind.Str
                        } els if rowVal == "5" {
                            targetKind = TypeKind.Obj
                        }
                    } els if baseNode.name == "grid" {
                        if rowVal == "0" {
                            targetKind = TypeKind.Str
                        } els if rowVal == "1" {
                            targetKind = TypeKind.I64
                        } els if rowVal == "2" {
                            targetKind = TypeKind.Bool
                        } els if rowVal == "3" {
                            targetKind = TypeKind.Obj
                        }
                    }
                }
            }
        }
        if targetKind == TypeKind.Unknown {
            targetKind = TypeKind.I64
        }
        unboxedVal: str = unboxValueFromI64 self.codegen, elemVal, targetKind
        res: ExprResult = { reg: unboxedVal, typeKind: targetKind }
        -> res
    },

    /**
     * Emits member property access (obj.prop or arr.ln).
     *
     * @param {ASTNode} node - Property access AST node
     * @returns {ExprResult} Result descriptor
     */
    emitProp: node: ASTNode :: ExprResult => {
        targetNode: ASTNode = node.children[0]
        propName: str = node.name

        // Check for os.args
        if targetNode.kind == NodeKind.IdentExpr && targetNode.name == "os" && propName == "args" {
            self.codegen.emitExtern "@zuv_global_args = global i64 0"
            valReg: str = self.codegen.newReg
            self.codegen.emit `${valReg} = load i64, ptr @zuv_global_args`
            ptrReg: str = self.codegen.newReg
            self.codegen.emit `${ptrReg} = inttoptr i64 ${valReg} to ptr`
            res: ExprResult = { reg: ptrReg, typeKind: TypeKind.Arr }
            -> res
        }

        // Check for time.mono
        if targetNode.kind == NodeKind.IdentExpr && targetNode.name == "time" && propName == "mono" {
            valReg: str = self.codegen.newReg
            self.codegen.emit `${valReg} = call double @zuv_time_mono()`
            res: ExprResult = { reg: valReg, typeKind: TypeKind.Num }
            -> res
        }

        // Check for enum property access, e.g. Status.Active
        if targetNode.kind == NodeKind.IdentExpr {
            objName: str = targetNode.val
            if objName.ln == 0 {
                objName = targetNode.name
            }
            isE: bool = self.objGen.registry.isEnum objName
            if isE {
                disc: num = self.objGen.registry.getEnumVariantVal objName, propName
                if disc < 0 {
                    disc = 0
                }
                resReg: str = self.codegen.newReg
                self.codegen.emit `${resReg} = add i8 0, ${disc}`
                eRes: ExprResult = { reg: resReg, typeKind: TypeKind.I8 }
                -> eRes
            }
        }

        targetRes: ExprResult = self.emitExpr targetNode

        if propName == "ln" || propName == "length" {
            if targetRes.typeKind == TypeKind.Str {
                lenReg: str = self.codegen.newReg
                self.codegen.emit `${lenReg} = call i64 @strlen(ptr ${targetRes.reg})`
                res: ExprResult = { reg: lenReg, typeKind: TypeKind.I64 }
                -> res
            }
            arrPtrReg: str = targetRes.reg
            if !(isPointerType targetRes.typeKind) {
                convReg: str = self.codegen.newReg
                self.codegen.emit `${convReg} = inttoptr i64 ${targetRes.reg} to ptr`
                arrPtrReg = convReg
            }
            lenReg: str = self.arrGen.emitLength arrPtrReg
            res: ExprResult = { reg: lenReg, typeKind: TypeKind.I64 }
            -> res
        }

        if propName == "pp" || propName == "pop" {
            arrPtrReg: str = targetRes.reg
            if !(isPointerType targetRes.typeKind) {
                convReg: str = self.codegen.newReg
                self.codegen.emit `${convReg} = inttoptr i64 ${targetRes.reg} to ptr`
                arrPtrReg = convReg
            }
            valReg: str = self.arrGen.emitPop arrPtrReg
            popType = node.inferredType
            if popType == TypeKind.Unknown {
                popType = TypeKind.I64
            }
            res: ExprResult = { reg: valReg, typeKind: popType }
            -> res
        }

        if propName == "cap" || propName == "capacity" {
            arrPtrReg: str = targetRes.reg
            if !(isPointerType targetRes.typeKind) {
                convReg: str = self.codegen.newReg
                self.codegen.emit `${convReg} = inttoptr i64 ${targetRes.reg} to ptr`
                arrPtrReg = convReg
            }
            capReg: str = self.arrGen.emitCapacity arrPtrReg
            res: ExprResult = { reg: capReg, typeKind: TypeKind.I64 }
            -> res
        }

        structTypeName: str = targetNode.typeAnnotation
        if structTypeName.ln == 0 && targetNode.kind == NodeKind.IdentExpr {
            targetSym = self.findSymbol targetNode.name
            if targetSym.name.ln > 0 && targetSym.typeName.ln > 0 {
                structTypeName = targetSym.typeName
            }
        }
        if structTypeName.ln == 0 || !(self.objGen.registry.hasType structTypeName) {
            fr l of self.objGen.registry.layouts {
                if l.hasField propName {
                    structTypeName = l.typeName
                    brk
                }
            }
        }

        off: num = self.objGen.registry.getFieldOffset structTypeName, propName
        if off < 0 {
            off = 0
        }
        targetPropKind = node.inferredType
        if targetPropKind == TypeKind.Unknown {
            targetPropKind = self.objGen.registry.getFieldType structTypeName, propName
        }
        objPtrReg: str = targetRes.reg
        if !(isPointerType targetRes.typeKind) {
            convReg: str = self.codegen.newReg
            self.codegen.emit `${convReg} = inttoptr i64 ${targetRes.reg} to ptr`
            objPtrReg = convReg
        }
        valReg: str = self.objGen.emitGetProperty objPtrReg, off, targetPropKind, false
        res: ExprResult = { reg: valReg, typeKind: targetPropKind }
        -> res
    },

    /**
     * Emits an array literal expression.
     *
     * @param {ASTNode} node - Array literal AST node
     * @returns {ExprResult} Result descriptor
     */
    emitArr: node: ASTNode :: ExprResult => {
        hasSpread: bool = false
        fr ch of node.children {
            if ch.kind == NodeKind.UnaryExpr && ch.op == "..." {
                hasSpread = true
            }
        }
        if hasSpread {
            parts: ArraySpreadPart[] = []
            fr elem of node.children {
                if elem.kind == NodeKind.UnaryExpr && elem.op == "..." {
                    spRes: ExprResult = self.emitExpr elem.children[0]
                    arrPtrReg: str = spRes.reg
                    if !(isPointerType spRes.typeKind) {
                        convReg: str = self.codegen.newReg
                        self.codegen.emit `${convReg} = inttoptr i64 ${spRes.reg} to ptr`
                        arrPtrReg = convReg
                    }
                    spPart: ArraySpreadPart = {
                        isSpread: true,
                        valReg: arrPtrReg,
                        valType: spRes.typeKind,
                        lenReg: ""
                    }
                    parts.psh spPart
                } els {
                    elemRes: ExprResult = self.emitExpr elem
                    singlePart: ArraySpreadPart = {
                        isSpread: false,
                        valReg: elemRes.reg,
                        valType: elemRes.typeKind,
                        lenReg: ""
                    }
                    parts.psh singlePart
                }
            }
            arrPtr: str = self.arrGen.emitArraySpread parts
            res: ExprResult = { reg: arrPtr, typeKind: TypeKind.Arr }
            -> res
        }

        elemRegs: str[] = []
        elemTypes: TypeKind[] = []
        fr elem of node.children {
            elemRes: ExprResult = self.emitExpr elem
            elemRegs.psh elemRes.reg
            elemTypes.psh elemRes.typeKind
        }
        arrPtr: str = self.arrGen.emitArrayLit elemRegs, elemTypes
        res: ExprResult = { reg: arrPtr, typeKind: TypeKind.Arr }
        -> res
    },

    /**
     * Emits an object literal heap allocation.
     *
     * @param {ASTNode} node - Object literal AST node
     * @returns {ExprResult} Result descriptor
     */
    emitObjLit: node: ASTNode :: ExprResult => {
        fieldNames: str[] = []
        valRegs: str[] = []
        valTypes: TypeKind[] = []
        childIdx: num = 0
        fr fEntry of node.fields {
            if childIdx < node.children.ln {
                childRes: ExprResult = self.emitExpr node.children[childIdx]
                fieldNames.psh fEntry.name
                valRegs.psh childRes.reg
                valTypes.psh childRes.typeKind
            }
            childIdx++
        }
        structName: str = node.name
        if structName.ln == 0 {
            structName = node.typeAnnotation
        }
        objPtr: str = self.objGen.emitObjectLit structName, fieldNames, valRegs, valTypes
        res: ExprResult = { reg: objPtr, typeKind: TypeKind.Obj }
        -> res
    },

    /**
     * Emits an explicit type cast expression.
     *
     * @param {ASTNode} node - Cast expression AST node
     * @returns {ExprResult} Result descriptor
     */
    emitCast: node: ASTNode :: ExprResult => {
        targetNode: ASTNode = node.children[0]
        targetRes: ExprResult = self.emitExpr targetNode
        toType = node.inferredType
        if toType == TypeKind.Unknown {
            toType = resolveFieldTypeKind node.typeAnnotation
        }
        if toType == TypeKind.Unknown {
            toType = TypeKind.I64
        }

        if targetRes.typeKind == toType {
            -> targetRes
        }

        if toType == TypeKind.Bool {
            cmpReg: str = self.codegen.newReg
            if targetRes.typeKind == TypeKind.Num {
                self.codegen.emit `${cmpReg} = fcmp one double ${targetRes.reg}, 0.0`
            } els if isPointerType targetRes.typeKind {
                self.codegen.emit `${cmpReg} = icmp ne ptr ${targetRes.reg}, null`
            } els {
                cType: str = llvmType targetRes.typeKind
                self.codegen.emit `${cmpReg} = icmp ne ${cType} ${targetRes.reg}, 0`
            }
            bRes: ExprResult = { reg: cmpReg, typeKind: TypeKind.Bool }
            -> bRes
        }

        if toType == TypeKind.Str {
            if targetRes.typeKind == TypeKind.Bool {
                strTrue: str = self.codegen.addStringConstant "true"
                strFalse: str = self.codegen.addStringConstant "false"
                boolPtr: str = self.codegen.newReg
                self.codegen.emit `${boolPtr} = select i1 ${targetRes.reg}, ptr ${strTrue}, ptr ${strFalse}`
                sRes: ExprResult = { reg: boolPtr, typeKind: TypeKind.Str }
                -> sRes
            }
            if targetRes.typeKind == TypeKind.Num {
                buf: str = self.codegen.newReg
                self.codegen.emit `${buf} = call ptr @malloc(i64 32)`
                dblFmt: str = self.codegen.addStringConstant "%g"
                self.codegen.emit `call i32 (ptr, i64, ptr, ...) @snprintf(ptr ${buf}, i64 32, ptr ${dblFmt}, double ${targetRes.reg})`
                sRes: ExprResult = { reg: buf, typeKind: TypeKind.Str }
                -> sRes
            }
            if targetRes.typeKind == TypeKind.I64 || targetRes.typeKind == TypeKind.I32 || targetRes.typeKind == TypeKind.I16 || targetRes.typeKind == TypeKind.I8 {
                zReg: str = targetRes.reg
                if targetRes.typeKind != TypeKind.I64 {
                    exReg: str = self.codegen.newReg
                    iTypeStr: str = llvmType targetRes.typeKind
                    self.codegen.emit `${exReg} = sext ${iTypeStr} ${targetRes.reg} to i64`
                    zReg = exReg
                }
                buf: str = self.codegen.newReg
                self.codegen.emit `${buf} = call ptr @malloc(i64 32)`
                numFmt: str = self.codegen.addStringConstant "%lld"
                self.codegen.emit `call i32 (ptr, i64, ptr, ...) @snprintf(ptr ${buf}, i64 32, ptr ${numFmt}, i64 ${zReg})`
                sRes: ExprResult = { reg: buf, typeKind: TypeKind.Str }
                -> sRes
            }
        }

        if targetRes.typeKind == TypeKind.Ptr && toType == TypeKind.Num {
            iReg: str = self.codegen.newReg
            self.codegen.emit `${iReg} = ptrtoint ptr ${targetRes.reg} to i64`
            numReg: str = self.codegen.newReg
            self.codegen.emit `${numReg} = sitofp i64 ${iReg} to double`
            pRes: ExprResult = { reg: numReg, typeKind: TypeKind.Num }
            -> pRes
        }

        if targetRes.typeKind == TypeKind.Num && toType == TypeKind.Ptr {
            iReg: str = self.codegen.newReg
            self.codegen.emit `${iReg} = fptosi double ${targetRes.reg} to i64`
            ptrReg: str = self.codegen.newReg
            self.codegen.emit `${ptrReg} = inttoptr i64 ${iReg} to ptr`
            pRes: ExprResult = { reg: ptrReg, typeKind: TypeKind.Ptr }
            -> pRes
        }

        if (targetRes.typeKind == TypeKind.I64 || targetRes.typeKind == TypeKind.I32 || targetRes.typeKind == TypeKind.I16 || targetRes.typeKind == TypeKind.I8) && toType == TypeKind.Ptr {
            zReg: str = targetRes.reg
            if targetRes.typeKind != TypeKind.I64 {
                exReg: str = self.codegen.newReg
                iTypeStr: str = llvmType targetRes.typeKind
                self.codegen.emit `${exReg} = sext ${iTypeStr} ${targetRes.reg} to i64`
                zReg = exReg
            }
            ptrReg: str = self.codegen.newReg
            self.codegen.emit `${ptrReg} = inttoptr i64 ${zReg} to ptr`
            pRes: ExprResult = { reg: ptrReg, typeKind: TypeKind.Ptr }
            -> pRes
        }

        castOp: str = selectCastOp targetRes.typeKind, toType
        if castOp.ln > 0 {
            castReg: str = self.codegen.newReg
            fromTypeStr: str = llvmType targetRes.typeKind
            toTypeStr: str = llvmType toType
            self.codegen.emit `${castReg} = ${castOp} ${fromTypeStr} ${targetRes.reg} to ${toTypeStr}`
            res: ExprResult = { reg: castReg, typeKind: toType }
            -> res
        }
        -> targetRes
    },

    /**
     * Emits a ternary conditional expression with alloca merging.
     *
     * @param {ASTNode} node - Ternary expression AST node
     * @returns {ExprResult} Result descriptor
     */
    emitTernary: node: ASTNode :: ExprResult => {
        condNode: ASTNode = node.children[0]
        thenNode: ASTNode = node.children[1]
        elseNode: ASTNode = node.children[2]

        condRes: ExprResult = self.emitExpr condNode
        thenLbl: str = self.codegen.newLabel "tern_then"
        elseLbl: str = self.codegen.newLabel "tern_else"
        mergeLbl: str = self.codegen.newLabel "tern_merge"

        condReg: str = condRes.reg
        if condRes.typeKind != TypeKind.Bool {
            cType: str = llvmType condRes.typeKind
            cmpReg: str = self.codegen.newReg
            if condRes.typeKind == TypeKind.Num {
                self.codegen.emit `${cmpReg} = fcmp one double ${condReg}, 0.0`
            } els {
                self.codegen.emit `${cmpReg} = icmp ne ${cType} ${condReg}, 0`
            }
            condReg = cmpReg
        }

        retType = thenNode.inferredType
        if retType == TypeKind.Unknown {
            retType = elseNode.inferredType
        }
        if retType == TypeKind.Unknown {
            retType = TypeKind.I64
        }
        stType: str = llvmStackType retType
        slotReg: str = self.codegen.newReg
        self.codegen.emit `${slotReg} = alloca ${stType}`
        self.codegen.emit `br i1 ${condReg}, label %${thenLbl}, label %${elseLbl}`

        self.codegen.emitLabel thenLbl
        thenRes: ExprResult = self.emitExpr thenNode
        thenVal: str = thenRes.reg
        if stType == "i64" && (thenRes.typeKind == TypeKind.I8 || thenRes.typeKind == TypeKind.Bool) {
            extReg: str = self.codegen.newReg
            srcLLVM: str = (thenRes.typeKind == TypeKind.Bool) ? "i1" : "i8"
            self.codegen.emit `${extReg} = zext ${srcLLVM} ${thenRes.reg} to i64`
            thenVal = extReg
        } els if stType == "i64" && thenRes.typeKind == TypeKind.I16 {
            extReg: str = self.codegen.newReg
            self.codegen.emit `${extReg} = zext i16 ${thenRes.reg} to i64`
            thenVal = extReg
        } els if stType == "i64" && thenRes.typeKind == TypeKind.I32 {
            extReg: str = self.codegen.newReg
            self.codegen.emit `${extReg} = zext i32 ${thenRes.reg} to i64`
            thenVal = extReg
        }
        self.codegen.emit `store ${stType} ${thenVal}, ptr ${slotReg}`
        self.codegen.emit `br label %${mergeLbl}`

        self.codegen.emitLabel elseLbl
        elseRes: ExprResult = self.emitExpr elseNode
        elseVal: str = elseRes.reg
        if stType == "i64" && (elseRes.typeKind == TypeKind.I8 || elseRes.typeKind == TypeKind.Bool) {
            extReg: str = self.codegen.newReg
            srcLLVM: str = (elseRes.typeKind == TypeKind.Bool) ? "i1" : "i8"
            self.codegen.emit `${extReg} = zext ${srcLLVM} ${elseRes.reg} to i64`
            elseVal = extReg
        } els if stType == "i64" && elseRes.typeKind == TypeKind.I16 {
            extReg: str = self.codegen.newReg
            self.codegen.emit `${extReg} = zext i16 ${elseRes.reg} to i64`
            elseVal = extReg
        } els if stType == "i64" && elseRes.typeKind == TypeKind.I32 {
            extReg: str = self.codegen.newReg
            self.codegen.emit `${extReg} = zext i32 ${elseRes.reg} to i64`
            elseVal = extReg
        }
        self.codegen.emit `store ${stType} ${elseVal}, ptr ${slotReg}`
        self.codegen.emit `br label %${mergeLbl}`

        self.codegen.emitLabel mergeLbl
        outReg: str = self.codegen.newReg
        self.codegen.emit `${outReg} = load ${stType}, ptr ${slotReg}`
        res: ExprResult = { reg: outReg, typeKind: retType }
        -> res
    },

    /**
     * Emits a type introspection expression (typ expr) returning a static type name string.
     *
     * @param {ASTNode} node - Typ expression AST node
     * @returns {ExprResult} Result descriptor
     */
    emitTyp: node: ASTNode :: ExprResult => {
        typName: str = "und"
        if node.children.ln > 0 {
            child = node.children[0]
            if child.kind == NodeKind.NumExpr {
                typName = "num"
            } els if child.kind == NodeKind.StrExpr {
                typName = "str"
            } els if child.kind == NodeKind.BoolExpr {
                typName = "bool"
            } els if child.kind == NodeKind.NilExpr {
                typName = "nil"
            } els if child.kind == NodeKind.UndExpr {
                typName = "und"
            } els if child.kind == NodeKind.BigIntExpr {
                typName = "bigint"
            } els if child.kind == NodeKind.ArrExpr {
                typName = "arr"
            } els if child.kind == NodeKind.ObjLitExpr {
                typName = "obj"
            } els if child.kind == NodeKind.CallExpr {
                cNode = child.children[0]
                cName: str = cNode.name.ln > 0 ? cNode.name : cNode.val
                if cName == "BigInt" {
                    typName = "bigint"
                } els {
                    typName = TypeKindToStr child.inferredType
                }
            } els if child.kind == NodeKind.CastExpr {
                if child.typeAnnotation == "str" {
                    typName = "str"
                } els if child.typeAnnotation == "bool" {
                    typName = "bool"
                } els if child.typeAnnotation == "int" || child.typeAnnotation == "uint" || child.typeAnnotation == "i32" || child.typeAnnotation == "u32" || child.typeAnnotation == "i64" || child.typeAnnotation == "u64" || child.typeAnnotation == "num" || child.typeAnnotation == "double" {
                    typName = "num"
                } els {
                    typName = child.typeAnnotation
                }
            } els if child.kind == NodeKind.IdentExpr {
                cName: str = child.val
                if cName.ln == 0 {
                    cName = child.name
                }
                if self.objGen.registry.isEnum cName {
                    typName = "obj"
                } els {
                    targetSym = self.findSymbol cName
                    if targetSym.name.ln > 0 && targetSym.typeName == "bigint" {
                        typName = "bigint"
                    } els if child.typeAnnotation == "bigint" {
                        typName = "bigint"
                    } els {
                        k = child.inferredType
                        if k == TypeKind.Num || k == TypeKind.I64 {
                            typName = "num"
                        } els {
                            typName = TypeKindToStr k
                        }
                    }
                }
            } els if child.kind == NodeKind.PropExpr {
                pTarget = child.children[0]
                if pTarget.kind == NodeKind.IdentExpr {
                    pName: str = pTarget.val
                    if pName.ln == 0 {
                        pName = pTarget.name
                    }
                    if self.objGen.registry.isEnum pName {
                        typName = "i8"
                    } els {
                        k = child.inferredType
                        if k == TypeKind.Num || k == TypeKind.I64 {
                            typName = "num"
                        } els {
                            typName = TypeKindToStr k
                        }
                    }
                } els {
                    k = child.inferredType
                    if k == TypeKind.Num || k == TypeKind.I64 {
                        typName = "num"
                    } els {
                        typName = TypeKindToStr k
                    }
                }
            } els {
                k = child.inferredType
                if k == TypeKind.Num || k == TypeKind.I64 {
                    typName = "num"
                } els {
                    typName = TypeKindToStr k
                }
            }
        }
        strConst: str = self.codegen.addStringConstant typName
        gepReg: str = self.codegen.newReg
        self.codegen.emit `${gepReg} = getelementptr inbounds i8, ptr ${strConst}, i64 0`
        res: ExprResult = { reg: gepReg, typeKind: TypeKind.Str }
        -> res
    },

    emitAwait: node: ASTNode :: ExprResult => {
        if node.children.ln > 0 {
            targetNode: ASTNode = node.children[0]
            valRes: ExprResult = self.emitExpr targetNode
            valReg: str = valRes.reg
            if valRes.typeKind == TypeKind.Func {
                valRes.typeKind = TypeKind.I64
            } els if valRes.typeKind == TypeKind.Ptr || valRes.typeKind == TypeKind.Arr || valRes.typeKind == TypeKind.Obj {
                cReg: str = self.codegen.newReg
                self.codegen.emit `${cReg} = ptrtoint ptr ${valRes.reg} to i64`
                valReg = cReg
            }
            awaitRes: str = self.codegen.newReg
            self.codegen.emit `${awaitRes} = call i64 @zuv_prm_await(i64 ${valReg})`
            if self.activeCatchLabel.ln > 0 {
                rejReg: str = self.codegen.newReg
                self.codegen.emit `${rejReg} = load i32, ptr @zuv_prm_is_rejected`
                hasRejReg: str = self.codegen.newReg
                self.codegen.emit `${hasRejReg} = icmp ne i32 ${rejReg}, 0`
                okLbl: str = self.codegen.newLabel "awt_ok"
                self.codegen.emit `br i1 ${hasRejReg}, label %${self.activeCatchLabel}, label %${okLbl}`
                self.codegen.emitLabel okLbl
            }
            res: ExprResult = { reg: awaitRes, typeKind: TypeKind.I64 }
            -> res
        }
        res: ExprResult = { reg: "0", typeKind: TypeKind.I64 }
        -> res
    },

    emitNew: node: ASTNode :: ExprResult => {
        typeName: str = node.name
        if typeName == "Prm" || typeName == "Promise" {
            modeReg: str = self.codegen.newReg
            self.codegen.emit `${modeReg} = load i32, ptr @zuv_async_context_mode`
            prmReg: str = self.codegen.newReg
            self.codegen.emit `${prmReg} = call ptr @zuv_prm_new(i32 ${modeReg})`
            if node.children.ln > 0 {
                self.codegen.emit `store ptr ${prmReg}, ptr @zuv_active_prm`
                execRes: ExprResult = self.emitExpr node.children[0]
                fnPtrReg: str = self.codegen.newReg
                if execRes.typeKind == TypeKind.Ptr {
                    fnPtrReg = execRes.reg
                } els {
                    self.codegen.emit `${fnPtrReg} = inttoptr i64 ${execRes.reg} to ptr`
                }
                resCbReg: str = self.codegen.newReg
                self.codegen.emit `${resCbReg} = ptrtoint ptr @zuv_prm_cb_resolve to i64`
                rejCbReg: str = self.codegen.newReg
                self.codegen.emit `${rejCbReg} = ptrtoint ptr @zuv_prm_cb_reject to i64`
                callRes: str = self.codegen.newReg
                self.codegen.emit `${callRes} = call i64 ${fnPtrReg}(i64 ${resCbReg}, i64 ${rejCbReg})`
            }
            intReg: str = self.codegen.newReg
            self.codegen.emit `${intReg} = ptrtoint ptr ${prmReg} to i64`
            res: ExprResult = { reg: intReg, typeKind: TypeKind.I64 }
            -> res
        }
        bufReg: str = self.codegen.newReg
        self.codegen.emit `${bufReg} = call ptr @malloc(i64 8192)`
        setReg: str = self.codegen.newReg
        self.codegen.emit `${setReg} = call ptr @memset(ptr ${bufReg}, i32 0, i64 8192)`
        if self.codegen.header.cnt("@" + typeName + "_prototype") {
            protoLoad: str = self.codegen.newReg
            self.codegen.emit `${protoLoad} = load i64, ptr @${typeName}_prototype`
            protoPtr: str = self.codegen.newReg
            self.codegen.emit `${protoPtr} = inttoptr i64 ${protoLoad} to ptr`
            cpyReg: str = self.codegen.newReg
            self.codegen.emit `${cpyReg} = call ptr @memcpy(ptr ${bufReg}, ptr ${protoPtr}, i64 8192)`
        }
        res: ExprResult = { reg: bufReg, typeKind: TypeKind.Obj }
        -> res
    },

    /**
     * Emits a borrow/address-of expression (&target).
     *
     * @param {ASTNode} node - Borrow expression AST node
     * @returns {ExprResult} Address pointer result descriptor
     */
    emitBorrow: node: ASTNode :: ExprResult => {
        if node.children.ln == 0 {
            res: ExprResult = { reg: "null", typeKind: TypeKind.Ptr }
            -> res
        }
        target: ASTNode = node.children[0]
        if target.kind == NodeKind.IdentExpr {
            foundSym: ScopeSymbol = self.findSymbol target.name
            if foundSym.name.ln > 0 && foundSym.reg.ln > 0 {
                res: ExprResult = { reg: foundSym.reg, typeKind: TypeKind.Ptr }
                -> res
            }
        }
        if target.kind == NodeKind.IndexExpr {
            arrNode: ASTNode = target.children[0]
            idxNode: ASTNode = target.children[1]
            arrRes: ExprResult = self.emitExpr arrNode
            arrPtrReg: str = arrRes.reg
            if isFloatType arrRes.typeKind {
                convReg: str = self.codegen.newReg
                self.codegen.emit `${convReg} = fptosi double ${arrRes.reg} to i64`
                arrPtrReg = convReg
            }
            if arrRes.typeKind != TypeKind.Arr && arrRes.typeKind != TypeKind.Ptr {
                convReg: str = self.codegen.newReg
                self.codegen.emit `${convReg} = inttoptr i64 ${arrPtrReg} to ptr`
                arrPtrReg = convReg
            }
            idxRes: ExprResult = self.emitExpr idxNode
            idxReg: str = idxRes.reg
            if idxRes.typeKind != TypeKind.I64 {
                convReg: str = self.codegen.newReg
                if idxRes.typeKind == TypeKind.Num {
                    self.codegen.emit `${convReg} = fptosi double ${idxRes.reg} to i64`
                } els {
                    iType: str = llvmType idxRes.typeKind
                    self.codegen.emit `${convReg} = sext ${iType} ${idxRes.reg} to i64`
                }
                idxReg = convReg
            }
            emitArrayBoundsCheck self.codegen, arrPtrReg, idxReg, target.line
            elemIdx: str = self.codegen.newReg
            self.codegen.emit `${elemIdx} = add i64 ${idxReg}, 1`
            gep: str = self.codegen.newReg
            self.codegen.emit `${gep} = getelementptr inbounds i64, ptr ${arrPtrReg}, i64 ${elemIdx}`
            res: ExprResult = { reg: gep, typeKind: TypeKind.Ptr }
            -> res
        }
        targetRes: ExprResult = self.emitExpr target
        res: ExprResult = { reg: targetRes.reg, typeKind: TypeKind.Ptr }
        -> res
    },

    /**
     * Fallback emitter for unhandled node expressions.
     *
     * @param {ASTNode} node - AST node
     * @returns {ExprResult} Result descriptor
     */
    emitDefault: node: ASTNode :: ExprResult => {
        resReg: str = self.codegen.newReg
        if node.inferredType == TypeKind.Num {
            self.codegen.emit `${resReg} = fadd double 0.0, 0.0`
            fRes: ExprResult = { reg: resReg, typeKind: TypeKind.Num }
            -> fRes
        }
        if isPointerType node.inferredType {
            pRes: ExprResult = { reg: "null", typeKind: node.inferredType }
            -> pRes
        }
        itype: str = llvmType node.inferredType
        self.codegen.emit `${resReg} = add ${itype} 0, 0`
        iRes: ExprResult = { reg: resReg, typeKind: node.inferredType }
        -> iRes
    }
}

/**
 * Converts a base-prefixed numeric string (0b..., 0o..., 0x...) to a standard decimal string.
 */
parseBaseNumber valStr: str :: str {
    if valStr.ln >= 3 && valStr[0] == "0" {
        p: str = valStr[1]
        if p == "b" || p == "B" {
            acc: num = 0
            idx: num = 2
            wh idx < valStr.ln {
                ch: str = valStr[idx]
                if ch == "1" {
                    acc = acc * 2 + 1
                } els if ch == "0" {
                    acc = acc * 2
                }
                idx++
            }
            -> `${acc}`
        }
        if p == "o" || p == "O" {
            acc: num = 0
            idx: num = 2
            wh idx < valStr.ln {
                ch: str = valStr[idx]
                d: num = 0
                if ch == "1" { d = 1 }
                els if ch == "2" { d = 2 }
                els if ch == "3" { d = 3 }
                els if ch == "4" { d = 4 }
                els if ch == "5" { d = 5 }
                els if ch == "6" { d = 6 }
                els if ch == "7" { d = 7 }
                acc = acc * 8 + d
                idx++
            }
            -> `${acc}`
        }
        if p == "x" || p == "X" {
            acc: num = 0
            idx: num = 2
            wh idx < valStr.ln {
                ch: str = valStr[idx]
                d: num = 0
                if ch == "1" { d = 1 }
                els if ch == "2" { d = 2 }
                els if ch == "3" { d = 3 }
                els if ch == "4" { d = 4 }
                els if ch == "5" { d = 5 }
                els if ch == "6" { d = 6 }
                els if ch == "7" { d = 7 }
                els if ch == "8" { d = 8 }
                els if ch == "9" { d = 9 }
                els if ch == "a" || ch == "A" { d = 10 }
                els if ch == "b" || ch == "B" { d = 11 }
                els if ch == "c" || ch == "C" { d = 12 }
                els if ch == "d" || ch == "D" { d = 13 }
                els if ch == "e" || ch == "E" { d = 14 }
                els if ch == "f" || ch == "F" { d = 15 }
                acc = acc * 16 + d
                idx++
            }
            -> `${acc}`
        }
    }
    -> valStr
}

