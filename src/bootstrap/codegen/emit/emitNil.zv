/*
 * =============================================================================
 * Zuv Bootstrap Compiler — EmitNil Expression Emitter
 * Path: sub_projects/zuv/src/bootstrap/codegen/emit/emitNil.zv
 * =============================================================================
 */

imp TypeKind frm ../../types
imp ASTNode frm ../../ast
imp ExprCodegen, ExprResult frm ../expr

EmitNil self: ExprCodegen, node: ASTNode :: ExprResult {
    resReg: str = self.codegen.newReg
    self.codegen.emit `${resReg} = add i64 0, 0`
    res: ExprResult = { reg: resReg, typeKind: TypeKind.Nil }
    -> res
}
