    /**
     * Emits the runtime routines for pseudo-terminal (pty) operations.
     *
     * @returns {void}
     */
    emitPtyRuntime: :: void => {
        self.emitRuntimeDecl "declare i32 @CreatePipe(ptr, ptr, ptr, i32)", "@CreatePipe"
        self.emitRuntimeDecl "declare i32 @PeekNamedPipe(ptr, ptr, i32, ptr, ptr, ptr)", "@PeekNamedPipe"
        self.emitRuntimeDecl "declare i32 @CreatePseudoConsole(i32, ptr, ptr, i32, ptr)", "@CreatePseudoConsole"
        self.emitRuntimeDecl "declare i32 @ResizePseudoConsole(ptr, i32)", "@ResizePseudoConsole"
        self.emitRuntimeDecl "declare void @ClosePseudoConsole(ptr)", "@ClosePseudoConsole"
        self.emitRuntimeDecl "declare i32 @CreateProcessA(ptr, ptr, ptr, ptr, i32, i32, ptr, ptr, ptr, ptr)", "@CreateProcessA"
        self.emitRuntimeDecl "declare i32 @InitializeProcThreadAttributeList(ptr, i32, i32, ptr)", "@InitializeProcThreadAttributeList"
        self.emitRuntimeDecl "declare i32 @UpdateProcThreadAttribute(ptr, i32, i64, ptr, i64, ptr, ptr)", "@UpdateProcThreadAttribute"
        self.emitRuntimeDecl "declare void @DeleteProcThreadAttributeList(ptr)", "@DeleteProcThreadAttributeList"
