          %dres = sitofp i32 %res to double
          ret double %dres
        }

        define internal double @zuv_ipc_event_wait(i64 %h, i32 %timeoutMs) {
        entry:
          %rawI64 = and i64 %h, -281474976710657
          %hPtr = inttoptr i64 %rawI64 to ptr
          %res = call i32 @WaitForSingleObject(ptr %hPtr, i32 %timeoutMs)
          %cmp = icmp eq i32 %res, 0
          %sel = select i1 %cmp, double 1.0, double 0.0
          ret double %sel
        }

        define internal double @zuv_ipc_close(i64 %h) {
        entry:
          %rawI64 = and i64 %h, -281474976710657
          %hPtr = inttoptr i64 %rawI64 to ptr
          %res = call i32 @CloseHandle(ptr %hPtr)
          %dres = sitofp i32 %res to double
          ret double %dres
        }
        `
    },

    /**
