        define internal i64 @zuv_pty_open(i32 %cols, i32 %rows) {
        entry:
          %inRead = alloca ptr, align 8
          %inWrite = alloca ptr, align 8
          %outRead = alloca ptr, align 8
          %outWrite = alloca ptr, align 8
          %hPC = alloca ptr, align 8
          store ptr null, ptr %inRead
          store ptr null, ptr %inWrite
          store ptr null, ptr %outRead
          store ptr null, ptr %outWrite
          store ptr null, ptr %hPC
          call i32 @CreatePipe(ptr %inRead, ptr %inWrite, ptr null, i32 0)
          call i32 @CreatePipe(ptr %outRead, ptr %outWrite, ptr null, i32 0)
          %r16 = shl i32 %rows, 16
          %c16 = and i32 %cols, 65535
          %coord = or i32 %r16, %c16
          %inR = load ptr, ptr %inRead
          %outW = load ptr, ptr %outWrite
          %hr = call i32 @CreatePseudoConsole(i32 %coord, ptr %inR, ptr %outW, i32 0, ptr %hPC)
          %pcOk = icmp eq i32 %hr, 0
          br i1 %pcOk, label %pc_success, label %alloc_desc
        pc_success:
          call i32 @CloseHandle(ptr %inR)
          call i32 @CloseHandle(ptr %outW)
          br label %alloc_desc
        alloc_desc:
          %desc = call ptr @malloc(i64 32)
          %inW = load ptr, ptr %inWrite
          %outR = load ptr, ptr %outRead
          %pc = load ptr, ptr %hPC
          %inW64 = ptrtoint ptr %inW to i64
          %outR64 = ptrtoint ptr %outR to i64
          %pc64 = ptrtoint ptr %pc to i64
          %p0 = getelementptr inbounds i64, ptr %desc, i64 0
          %p1p = getelementptr inbounds i64, ptr %desc, i64 1
          %p2p = getelementptr inbounds i64, ptr %desc, i64 2
          %p3p = getelementptr inbounds i64, ptr %desc, i64 3
          store i64 %inW64, ptr %p0
          store i64 %outR64, ptr %p1p
          store i64 0, ptr %p2p
          store i64 %pc64, ptr %p3p
          %desc64 = ptrtoint ptr %desc to i64
          ret i64 %desc64
        }

        define internal i64 @zuv_pty_spawn(ptr %cmd, i32 %cols, i32 %rows) {
        entry:
          %p64 = call i64 @zuv_pty_open(i32 %cols, i32 %rows)
