/*
 * =============================================================================
 * Zuv Bootstrap Compiler — Runtime Intrinsics & Crash Handling Code Generation
 * Path: sub_projects/zuv/src/bootstrap/codegen/runtime.zv
 * =============================================================================
 *
 * Implements code generation for Zuv runtime intrinsics and panic/crash handling:
 * - Function descriptor metadata tracking (`FunctionDescriptor`)
 * - Global runtime constants, format strings, and metadata tables
 * - Runtime panic handling (`@zuv_panic`) with file/line reporting and exit 101
 * - Stack backtrace capture and unwinding (`@zuv_walk_stack`, `@zuv_dump_stack`, `@zuv_backtrace`)
 * - Symbol resolution against function descriptor tables (`@zuv_resolve_pc`, `@zuv_ensure_fn_sorted`)
 * - Runtime array bounds-check handler (`@zuv_check_bounds`)
 * - Win32 Vectored Exception Handling (`@zuv_init_crash_handler`, `@zuv_crash_handler`)
 *   for hardware access violations, division by zero, stack overflow, and aborts
 */

imp str, arr
imp Codegen frm codegen
imp StructLayoutRegistry frm decl
imp TypeKind frm ../types

/**
 * Holds function metadata for backtrace symbol resolution.
 */
obj FunctionDescriptor {
    llvmName: str,
    displayName: str,
    filePath: str,
    startLine: num,

    /**
     * Creates an initialized FunctionDescriptor record.
     *
     * @param {str} llvmName - LLVM IR symbol name (without @)
     * @param {str} displayName - Human-readable function name
     * @param {str} filePath - Source file path
     * @param {num} startLine - Source file starting line number
     * @returns {FunctionDescriptor} Initialized function descriptor
     */
    create: llvmName: str, displayName: str, filePath: str, startLine: num :: FunctionDescriptor => {
        -> {
            llvmName,
            displayName,
            filePath,
            startLine
        }
    }
}

/**
 * Manages runtime crash handling, panic emission, and stack unwinding IR generators.
 */
obj RuntimeCodegen {
    codegen: Codegen,
    runtimeEmitted: bool,
    funcDescs: FunctionDescriptor[],
    registry: StructLayoutRegistry,

    /**
     * Creates a new RuntimeCodegen coordinator.
     *
     * @param {Codegen} codegen - LLVM IR module coordinator
     * @returns {RuntimeCodegen} Initialized runtime code generator
     */
    create: codegen: Codegen :: RuntimeCodegen => {
        descs: FunctionDescriptor[] = []
        reg = StructLayoutRegistry.create()
        -> {
            codegen,
            runtimeEmitted: false,
            funcDescs: descs,
            registry: reg
        }
    },

    /**
     * Registers a function descriptor for symbol table backtrace resolution.
     *
     * @param {str} llvmName - LLVM IR function name (without @)
     * @param {str} displayName - Human-readable function name
     * @param {str} filePath - Source file path
     * @param {num} startLine - Source file starting line number
     * @returns {void}
     */
    registerFunction: llvmName: str, displayName: str, filePath: str, startLine: num :: void => {
        desc = FunctionDescriptor.create llvmName, displayName, filePath, startLine
        self.funcDescs.psh desc
    },

    /**
     * Emits an external C / Win32 runtime declaration into the module header if not already declared.
     *
     * @param {str} decl - Full declare statement (e.g. "declare i32 @printf(ptr, ...)")
     * @param {str} symbol - Symbol identifier to check for duplication (e.g. "@printf")
     * @returns {void}
     */
    emitRuntimeDecl: decl: str, symbol: str :: void => {
        if !(self.codegen.header.cnt symbol) {
            self.codegen.header += decl + "\n"
        }
    },

    /**
     * Emits all global runtime constants, format strings, and function descriptor tables.
     *
     * @returns {void}
     */
    emitRuntimeGlobals: :: void => {
        // Emit required external function declarations if not already declared
        self.emitRuntimeDecl "declare i32 @printf(ptr nocapture readonly, ...)", "@printf"
        self.emitRuntimeDecl "declare ptr @getenv(ptr)", "@getenv"
        self.emitRuntimeDecl "declare void @exit(i32) noreturn", "@exit"
        self.emitRuntimeDecl "declare i32 @RtlCaptureStackBackTrace(i32, i32, ptr, ptr)", "@RtlCaptureStackBackTrace"
        self.emitRuntimeDecl "declare ptr @AddVectoredExceptionHandler(i32, ptr)", "@AddVectoredExceptionHandler"
        self.emitRuntimeDecl "declare ptr @malloc(i64)", "@malloc"
        self.emitRuntimeDecl "declare i64 @strlen(ptr)", "@strlen"
        self.emitRuntimeDecl "declare i32 @snprintf(ptr, i64, ptr, ...)", "@snprintf"
        self.emitRuntimeDecl "declare double @llvm.pow.f64(double, double)", "@llvm.pow.f64"
        self.emitRuntimeDecl "declare void @Sleep(i32)", "@Sleep"
        self.emitRuntimeDecl "declare ptr @fopen(ptr, ptr)", "@fopen"
        self.emitRuntimeDecl "declare i32 @fseek(ptr, i64, i32)", "@fseek"
        self.emitRuntimeDecl "declare i64 @ftell(ptr)", "@ftell"
        self.emitRuntimeDecl "declare void @rewind(ptr)", "@rewind"
        self.emitRuntimeDecl "declare i64 @fread(ptr, i64, i64, ptr)", "@fread"
        self.emitRuntimeDecl "declare i64 @fwrite(ptr, i64, i64, ptr)", "@fwrite"
        self.emitRuntimeDecl "declare i32 @fclose(ptr)", "@fclose"
        self.emitRuntimeDecl "declare i32 @remove(ptr)", "@remove"
        self.emitRuntimeDecl "declare ptr @memcpy(ptr, ptr, i64)", "@memcpy"
        self.emitRuntimeDecl "declare i32 @system(ptr)", "@system"
        self.emitRuntimeDecl "@_zuv_empty_arr = internal constant [2 x i64] [i64 0, i64 0]", "@_zuv_empty_arr"
        self.emitRuntimeDecl "@zuv_global_args = global i64 0", "@zuv_global_args"

        // Type definition for function descriptor
        self.codegen.header += "%struct.ZuvFuncDesc = type { ptr, ptr, ptr, i32 }\n\n"
        self.codegen.header += `
        @zuv_active_prm = internal global ptr null
        @zuv_async_context_mode = internal global i32 0
        @zuv_prm_is_rejected = internal global i32 0
        @zuv_exc_value = internal global i64 0
        `

        numDescs: num = self.funcDescs.ln
        if numDescs == 0 {
            self.codegen.header += `
            @zuv_fn_descs = internal global [0 x %struct.ZuvFuncDesc] zeroinitializer
            @zuv_fn_count = internal constant i64 0
            @zuv_fn_sorted = internal global i32 0
            `
        } els {
            fr desc, i of self.funcDescs {
                nStr: str = `zuv_fn_n_${i}`
                fStr: str = `zuv_fn_f_${i}`
                dLen: num = desc.displayName.ln + 1
                fLen: num = desc.filePath.ln + 1
                self.codegen.header += `@${nStr} = private unnamed_addr constant [${dLen} x i8] c"${desc.displayName}\\00"\n`
                self.codegen.header += `@${fStr} = private unnamed_addr constant [${fLen} x i8] c"${desc.filePath}\\00"\n`
            }

            self.codegen.header += `\n@zuv_fn_descs = internal global [${numDescs} x %struct.ZuvFuncDesc] [\n`
            fr desc, i of self.funcDescs {
                nStr: str = `zuv_fn_n_${i}`
                fStr: str = `zuv_fn_f_${i}`
                comma: str = (i + 1 < numDescs) ? "," : ""
                self.codegen.header += `  %struct.ZuvFuncDesc { ptr @${desc.llvmName}, ptr @${nStr}, ptr @${fStr}, i32 ${desc.startLine} }${comma}\n`
            }
            self.codegen.header += "]\n"
            self.codegen.header += `@zuv_fn_count = internal constant i64 ${numDescs}\n`
            self.codegen.header += "@zuv_fn_sorted = internal global i32 0\n\n"
        }

        // Format strings and runtime constant literals
        self.codegen.header += `
        @zuv_fmt_panic_msg = private unnamed_addr constant [37 x i8] c"\\0Afatal runtime error: %s\\0A  at %s:%d\\0A\\00"
        @zuv_fmt_panic_simple = private unnamed_addr constant [26 x i8] c"\\0Afatal runtime error: %s\\0A\\00"
        @zuv_fmt_bt_header = private unnamed_addr constant [18 x i8] c"stack backtrace:\\0A\\00"
        @zuv_fmt_bt_frame_sym = private unnamed_addr constant [37 x i8] c"  %2d: %s\\0A       at %s:%d (+0x%llx)\\0A\\00"
        @zuv_fmt_bt_frame_unk = private unnamed_addr constant [30 x i8] c"  %2d: [unknown] (0x%016llx)\\0A\\00"
        @zuv_fmt_bt_hint = private unnamed_addr constant [78 x i8] c"note: run with 'ZUV_BACKTRACE=1' environment variable to display a backtrace\\0A\\00"
        @zuv_env_backtrace = private unnamed_addr constant [14 x i8] c"ZUV_BACKTRACE\\00"
        @zuv_fmt_crash_msg = private unnamed_addr constant [58 x i8] c"\\0Afatal runtime error: hardware crash 0x%08X at 0x%016llx\\0A\\00"
        @zuv_err_oob = private unnamed_addr constant [20 x i8] c"index out of bounds\\00"
        `
    },

    /**
     * Emits the internal helper function `@zuv_ensure_fn_sorted` for sorting symbol tables.
     *
     * @returns {void}
     */
    emitEnsureFnSorted: :: void => {
        self.codegen.funcs += `
        define internal void @zuv_ensure_fn_sorted() {
        entry:
            ; Check if symbol table was already sorted
            %flag = load i32, ptr @zuv_fn_sorted
            %already = icmp ne i32 %flag, 0
            br i1 %already, label %ret, label %do_sort

        do_sort:
            ; Mark table as sorted
            store i32 1, ptr @zuv_fn_sorted
            %count = load i64, ptr @zuv_fn_count
            %has_elems = icmp sgt i64 %count, 1
            br i1 %has_elems, label %init_i, label %ret

        init_i:
            ; Insertion sort outer loop initialization: i = 1
            %p_i = alloca i64, align 8
            %p_j = alloca i64, align 8
            store i64 1, ptr %p_i
            br label %cond_i

        cond_i:
            ; Loop condition: i < count
            %i_val = load i64, ptr %p_i
            %i_cmp = icmp slt i64 %i_val, %count
            br i1 %i_cmp, label %body_i, label %ret

        body_i:
            ; Extract key descriptor at index i
            %i_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr @zuv_fn_descs, i64 %i_val
            %key_fn = load ptr, ptr %i_ptr
            %key_fn_int = ptrtoint ptr %key_fn to i64
            %key_name_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr %i_ptr, i32 0, i32 1
            %key_name = load ptr, ptr %key_name_ptr
            %key_file_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr %i_ptr, i32 0, i32 2
            %key_file = load ptr, ptr %key_file_ptr
            %key_line_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr %i_ptr, i32 0, i32 3
            %key_line = load i32, ptr %key_line_ptr
            store i64 %i_val, ptr %p_j
            br label %cond_j

        cond_j:
            ; Inner loop condition: j > 0
            %j_val = load i64, ptr %p_j
            %j_gt_zero = icmp sgt i64 %j_val, 0
            br i1 %j_gt_zero, label %check_prev, label %insert

        check_prev:
            ; Compare preceding element: descs[j - 1].fn > key_fn
            %j_prev = sub i64 %j_val, 1
            %prev_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr @zuv_fn_descs, i64 %j_prev
            %prev_fn = load ptr, ptr %prev_ptr
            %prev_fn_int = ptrtoint ptr %prev_fn to i64
            %prev_gt = icmp ugt i64 %prev_fn_int, %key_fn_int
            br i1 %prev_gt, label %shift_j, label %insert

        shift_j:
            ; Shift preceding element forward to index j
            %cur_j_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr @zuv_fn_descs, i64 %j_val
            %prev_name_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr %prev_ptr, i32 0, i32 1
            %prev_name = load ptr, ptr %prev_name_ptr
            %prev_file_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr %prev_ptr, i32 0, i32 2
            %prev_file = load ptr, ptr %prev_file_ptr
            %prev_line_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr %prev_ptr, i32 0, i32 3
            %prev_line = load i32, ptr %prev_line_ptr
            store ptr %prev_fn, ptr %cur_j_ptr
            %cur_name_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr %cur_j_ptr, i32 0, i32 1
            store ptr %prev_name, ptr %cur_name_ptr
            %cur_file_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr %cur_j_ptr, i32 0, i32 2
            store ptr %prev_file, ptr %cur_file_ptr
            %cur_line_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr %cur_j_ptr, i32 0, i32 3
            store i32 %prev_line, ptr %cur_line_ptr
            store i64 %j_prev, ptr %p_j
            br label %cond_j

        insert:
            ; Insert key record at sorted position j
            %ins_j = load i64, ptr %p_j
            %pos_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr @zuv_fn_descs, i64 %ins_j
            store ptr %key_fn, ptr %pos_ptr
            %ins_name_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr %pos_ptr, i32 0, i32 1
            store ptr %key_name, ptr %ins_name_ptr
            %ins_file_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr %pos_ptr, i32 0, i32 2
            store ptr %key_file, ptr %ins_file_ptr
            %ins_line_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr %pos_ptr, i32 0, i32 3
            store i32 %key_line, ptr %ins_line_ptr
            %i_next = add i64 %i_val, 1
            store i64 %i_next, ptr %p_i
            br label %cond_i

        ret:
            ret void
        }
        `
    },

    /**
     * Emits the `@zuv_resolve_pc(ptr %pc) -> ptr` function for finding matching function descriptor.
     *
     * @returns {void}
     */
    emitResolvePc: :: void => {
        self.codegen.funcs += `
        define internal ptr @zuv_resolve_pc(ptr %pc) {
        entry:
            ; Ensure descriptor table is sorted by function entry address
            call void @zuv_ensure_fn_sorted()
            %count = load i64, ptr @zuv_fn_count
            %has_elems = icmp sgt i64 %count, 0
            br i1 %has_elems, label %init, label %not_found

        init:
            ; Start search from highest function entry downwards
            %p_k = alloca i64, align 8
            %init_idx = sub i64 %count, 1
            store i64 %init_idx, ptr %p_k
            %target = ptrtoint ptr %pc to i64
            br label %loop

        loop:
            %k = load i64, ptr %p_k
            %k_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr @zuv_fn_descs, i64 %k
            %entry_fn = load ptr, ptr %k_ptr
            %entry_fn_int = ptrtoint ptr %entry_fn to i64
            %is_le = icmp ule i64 %entry_fn_int, %target
            br i1 %is_le, label %check_dist, label %step_back

        check_dist:
            ; Verify target instruction pointer is within 2MB threshold of entry
            %dist = sub i64 %target, %entry_fn_int
            %in_range = icmp ult i64 %dist, 2097152
            br i1 %in_range, label %found, label %not_found

        found:
            ret ptr %k_ptr

        step_back:
            ; Decrement index to check preceding function descriptor
            %k_is_zero = icmp eq i64 %k, 0
            br i1 %k_is_zero, label %not_found, label %do_step

        do_step:
            %k_prev = sub i64 %k, 1
            store i64 %k_prev, ptr %p_k
            br label %loop

        not_found:
            ret ptr null
        }
        `
    },

    /**
     * Emits the `@zuv_walk_stack(i32 %skip, i32 %maxFrames)` stack unwinding function.
     *
     * Uses RtlCaptureStackBackTrace to capture frames, resolves symbol information
     * via `@zuv_resolve_pc`, and prints symbol name, file, line, and relative offset.
     *
     * @returns {void}
     */
    emitWalkStack: :: void => {
        self.codegen.funcs += `
        define internal void @zuv_walk_stack(i32 %skip, i32 %maxFrames) {
        entry:
            ; Allocate local frame buffer and capture return addresses
            %buf = alloca [32 x ptr], align 8
            %frames = call i32 @RtlCaptureStackBackTrace(i32 %skip, i32 %maxFrames, ptr %buf, ptr null)
            %has_frames = icmp sgt i32 %frames, 0
            br i1 %has_frames, label %init, label %done

        init:
            ; Loop index initialization: idx = 0
            %p_idx = alloca i32, align 4
            store i32 0, ptr %p_idx
            br label %loop

        loop:
            ; Retrieve program counter and resolve symbol metadata
            %idx = load i32, ptr %p_idx
            %slot = getelementptr inbounds [32 x ptr], ptr %buf, i32 0, i32 %idx
            %pc = load ptr, ptr %slot
            %desc = call ptr @zuv_resolve_pc(ptr %pc)
            %is_null = icmp eq ptr %desc, null
            br i1 %is_null, label %print_unk, label %print_sym

        print_sym:
            ; Print formatted frame
            %fn_name_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr %desc, i32 0, i32 1
            %fn_name = load ptr, ptr %fn_name_ptr
            %file_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr %desc, i32 0, i32 2
            %file = load ptr, ptr %file_ptr
            %line_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr %desc, i32 0, i32 3
            %line = load i32, ptr %line_ptr
            %fn_entry_ptr = load ptr, ptr %desc
            %pc_int = ptrtoint ptr %pc to i64
            %entry_int = ptrtoint ptr %fn_entry_ptr to i64
            %offset = sub i64 %pc_int, %entry_int
            call i32 (ptr, ...) @printf(ptr @zuv_fmt_bt_frame_sym, i32 %idx, ptr %fn_name, ptr %file, i32 %line, i64 %offset)
            br label %cont

        print_unk:
            ; Print unknown frame address: "  %2d: [unknown] (0x%016llx)"
            %pc_as_i64 = ptrtoint ptr %pc to i64
            call i32 (ptr, ...) @printf(ptr @zuv_fmt_bt_frame_unk, i32 %idx, i64 %pc_as_i64)
            br label %cont

        cont:
            ; Advance to next stack frame
            %next_idx = add i32 %idx, 1
            store i32 %next_idx, ptr %p_idx
            %more = icmp slt i32 %next_idx, %frames
            br i1 %more, label %loop, label %done

        done:
            ret void
        }
        `
    },

    /**
     * Emits the `@zuv_panic(ptr %msg, ptr %file, i32 %line)` handler function.
     *
     * Prints runtime panic message with file/line information to stderr/stdout,
     * checks ZUV_BACKTRACE environment variable, unwinds stack frames if enabled,
     * and exits with status code 101.
     *
     * @returns {void}
     */
    emitPanicHandler: :: void => {
        self.codegen.funcs += `
        define void @zuv_panic(ptr %msg, ptr %file, i32 %line) {
        entry:
            ; Check if source file and line information was provided
            %has_file = icmp ne ptr %file, null
            br i1 %has_file, label %p_file, label %p_simple

        p_file:
            ; Print fatal error message with location metadata: "fatal runtime error: %s at %s:%d"
            call i32 (ptr, ...) @printf(ptr @zuv_fmt_panic_msg, ptr %msg, ptr %file, i32 %line)
            br label %check_env

        p_simple:
            ; Print fatal error message without location: "fatal runtime error: %s"
            call i32 (ptr, ...) @printf(ptr @zuv_fmt_panic_simple, ptr %msg)
            br label %check_env

        check_env:
            ; Query ZUV_BACKTRACE environment variable
            %env = call ptr @getenv(ptr @zuv_env_backtrace)
            %has_env = icmp ne ptr %env, null
            br i1 %has_env, label %check_val, label %print_hint

        check_val:
            ; Check if backtrace is disabled (ZUV_BACKTRACE="0")
            %ch = load i8, ptr %env
            %is_zero = icmp eq i8 %ch, 48
            br i1 %is_zero, label %print_hint, label %print_bt

        print_bt:
            ; Print backtrace header and unwind stack frames (skip panic handler frame)
            call i32 (ptr, ...) @printf(ptr @zuv_fmt_bt_header)
            call void @zuv_walk_stack(i32 1, i32 32)
            br label %do_exit

        print_hint:
            ; Print diagnostic hint on how to enable stack unwinding
            call i32 (ptr, ...) @printf(ptr @zuv_fmt_bt_hint)
            br label %do_exit

        do_exit:
            ; Standard Rust/Zuv runtime panic exit code (101)
            call void @exit(i32 101)
            unreachable
        }
        `
    },

    /**
     * Emits the `@zuv_check_bounds(ptr %arr, i64 %idx, ptr %file, i32 %line)` handler.
     *
     * Validates array pointer non-null and index within [0, len). If validation fails,
     * calls `@zuv_panic` with "index out of bounds" and terminates with exit 101.
     *
     * @returns {void}
     */
    emitBoundsCheckHandler: :: void => {
        self.codegen.funcs += `
        define internal void @zuv_check_bounds(ptr %arr, i64 %idx, ptr %file, i32 %line) {
        entry:
            ; Reject null pointer dereference
            %is_null = icmp eq ptr %arr, null
            br i1 %is_null, label %fail, label %check

        check:
            ; Load array length header and check bounds: 0 <= idx < len
            %len = load i64, ptr %arr
            %in_bounds = icmp ult i64 %idx, %len
            br i1 %in_bounds, label %ok, label %fail

        fail:
            ; Out of bounds violation: invoke runtime panic with file and line metadata
            call void @zuv_panic(ptr @zuv_err_oob, ptr %file, i32 %line)
            unreachable

        ok:
            ; Index within valid range, proceed with operation
            ret void
        }
        `
    },

    /**
     * Emits the `@zuv_dump_stack()` function for runtime diagnostics.
     *
     * Captures and prints active backtrace frames to stdout/stderr.
     *
     * @returns {void}
     */
    emitDumpStackHandler: :: void => {
        self.codegen.funcs += `
        define void @zuv_dump_stack() {
        entry:
            ; Print stack backtrace header and dump active call frames
            call i32 (ptr, ...) @printf(ptr @zuv_fmt_bt_header)
            call void @zuv_walk_stack(i32 1, i32 32)
            ret void
        }
        `
    },

    /**
     * Emits the `@zuv_backtrace() -> ptr` function for collecting backtrace string.
     *
     * Allocates a buffer and formats captured stack frames into a heap-allocated C string.
     *
     * @returns {void}
     */
    emitBacktraceHandler: :: void => {
        self.codegen.funcs += `
        define ptr @zuv_backtrace() {
        entry:
            ; Capture stack frame return addresses and allocate 4KB output string buffer
            %buf = alloca [32 x ptr], align 8
            %frames = call i32 @RtlCaptureStackBackTrace(i32 1, i32 32, ptr %buf, ptr null)
            %out = call ptr @malloc(i64 4096)
            store i8 0, ptr %out
            %has_frames = icmp sgt i32 %frames, 0
            br i1 %has_frames, label %init, label %done

        init:
            ; Buffer formatting loop initialization: bidx = 0
            %p_bidx = alloca i32, align 4
            store i32 0, ptr %p_bidx
            br label %loop

        loop:
            ; Format frame at index into buffer using snprintf
            %idx = load i32, ptr %p_bidx
            %cur_len = call i64 @strlen(ptr %out)
            %slot = getelementptr inbounds [32 x ptr], ptr %buf, i32 0, i32 %idx
            %pc = load ptr, ptr %slot
            %desc = call ptr @zuv_resolve_pc(ptr %pc)
            %is_null = icmp eq ptr %desc, null
            %dest_ptr = getelementptr inbounds i8, ptr %out, i64 %cur_len
            %avail = sub i64 4000, %cur_len
            br i1 %is_null, label %fmt_unk, label %fmt_sym

        fmt_sym:
            ; Known symbol frame
            %fn_name_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr %desc, i32 0, i32 1
            %fn_name = load ptr, ptr %fn_name_ptr
            %file_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr %desc, i32 0, i32 2
            %file = load ptr, ptr %file_ptr
            %line_ptr = getelementptr inbounds %struct.ZuvFuncDesc, ptr %desc, i32 0, i32 3
            %line = load i32, ptr %line_ptr
            %fn_entry_ptr = load ptr, ptr %desc
            %pc_int = ptrtoint ptr %pc to i64
            %entry_int = ptrtoint ptr %fn_entry_ptr to i64
            %offset = sub i64 %pc_int, %entry_int
            call i32 (ptr, i64, ptr, ...) @snprintf(ptr %dest_ptr, i64 %avail, ptr @zuv_fmt_bt_frame_sym, i32 %idx, ptr %fn_name, ptr %file, i32 %line, i64 %offset)
            br label %cont

        fmt_unk:
            ; Unknown symbol: append "  %2d: [unknown] (0x%016llx)"
            %pc_as_i64 = ptrtoint ptr %pc to i64
            call i32 (ptr, i64, ptr, ...) @snprintf(ptr %dest_ptr, i64 %avail, ptr @zuv_fmt_bt_frame_unk, i32 %idx, i64 %pc_as_i64)
            br label %cont

        cont:
            ; Loop iteration step
            %next_idx = add i32 %idx, 1
            store i32 %next_idx, ptr %p_bidx
            %more = icmp slt i32 %next_idx, %frames
            br i1 %more, label %loop, label %done

        done:
            ; Return heap-allocated formatted backtrace string pointer
            ret ptr %out
        }
        `
    },

    /**
     * Emits the `@zuv_crash_handler(ptr %pExc) -> i32` vectored exception handler.
     *
     * Catches hardware exceptions (Access Violation 0xC0000005, Division by Zero 0xC0000094,
     * Stack Overflow 0xC00000FD, Assertion/Abort 0xC000008C), prints faulting instruction
     * pointer, checks ZUV_BACKTRACE, walks stack, and exits with code 101.
     *
     * @returns {void}
     */
    emitCrashHandler: :: void => {
        self.codegen.funcs += `
        define internal i32 @zuv_crash_handler(ptr %pExc) {
        entry:
            ; Inspect exception code from EXCEPTION_POINTERS -> EXCEPTION_RECORD
            %rec_ptr = load ptr, ptr %pExc
            %code = load i32, ptr %rec_ptr
            %is_av = icmp eq i32 %code, -1073741819 ; 0xC0000005: Access Violation
            %is_dz = icmp eq i32 %code, -1073741676 ; 0xC0000094: Integer Division by Zero
            %is_ab = icmp eq i32 %code, -1073741684 ; 0xC000008C: Array Bounds / Abort
            %is_so = icmp eq i32 %code, -1073741571 ; 0xC00000FD: Stack Overflow
            %fatal1 = or i1 %is_av, %is_dz
            %fatal2 = or i1 %is_ab, %is_so
            %is_fatal = or i1 %fatal1, %fatal2
            br i1 %is_fatal, label %handle_crash, label %pass

        handle_crash:
            ; Hardware crash detected: print exception code and faulting instruction pointer
            %addr_ptr = getelementptr inbounds i8, ptr %rec_ptr, i64 16
            %fault_pc = load ptr, ptr %addr_ptr
            %fault_pc_i64 = ptrtoint ptr %fault_pc to i64
            call i32 (ptr, ...) @printf(ptr @zuv_fmt_crash_msg, i32 %code, i64 %fault_pc_i64)
            %env = call ptr @getenv(ptr @zuv_env_backtrace)
            %has_env = icmp ne ptr %env, null
            br i1 %has_env, label %check_crash_env, label %print_crash_hint

        check_crash_env:
            ; Check if backtrace is disabled (ZUV_BACKTRACE="0")
            %ch = load i8, ptr %env
            %is_zero = icmp eq i8 %ch, 48
            br i1 %is_zero, label %print_crash_hint, label %print_crash_bt

        print_crash_bt:
            ; Unwind and dump crash backtrace
            call i32 (ptr, ...) @printf(ptr @zuv_fmt_bt_header)
            call void @zuv_walk_stack(i32 0, i32 32)
            br label %exit_crash

        print_crash_hint:
            ; Print crash diagnostic hint
            call i32 (ptr, ...) @printf(ptr @zuv_fmt_bt_hint)
            br label %exit_crash

        exit_crash:
            ; Terminate process with exit code 101
            call void @exit(i32 101)
            ret i32 0

        pass:
            ; Non-fatal exception: pass through to subsequent exception handlers
            ret i32 0
        }
        `
    },

    /**
     * Emits the `@zuv_init_crash_handler()` function.
     *
     * Registers the vectored exception handler with the Win32 API via AddVectoredExceptionHandler.
     *
     * @returns {void}
     */
    emitInitCrashHandler: :: void => {
        self.codegen.funcs += `
        define void @zuv_init_crash_handler() {
        entry:
            ; Register vectored exception handler at head of handler chain
            call ptr @AddVectoredExceptionHandler(i32 1, ptr @zuv_crash_handler)
            ret void
        }
        `
    },

    /**
     * Emits first-class Promise / Prm asynchronous runtime support functions.
     *
     * @returns {void}
     */
    emitPromiseRuntime: :: void => {
        rbConst: str = self.codegen.addStringConstant "rb"
        wbConst: str = self.codegen.addStringConstant "wb"
        self.codegen.funcs += `
        define internal i32 @zuv_get_async_context() {
        entry:
          %m = load i32, ptr @zuv_async_context_mode
          ret i32 %m
        }

        define internal void @zuv_set_async_context(i32 %m) {
        entry:
          store i32 %m, ptr @zuv_async_context_mode
          ret void
        }

        define internal ptr @zuv_prm_new(i32 %mode) {
        entry:
          %p = call ptr @malloc(i64 64)
          call ptr @memset(ptr %p, i32 0, i64 64)
          store i64 1347571249, ptr %p
          %gepMode = getelementptr inbounds i64, ptr %p, i64 2
          %m64 = zext i32 %mode to i64
          store i64 %m64, ptr %gepMode
          ret ptr %p
        }

        define internal void @zuv_prm_resolve(ptr %p, i64 %val) {
        entry:
          %isNull = icmp eq ptr %p, null
          br i1 %isNull, label %ret_lbl, label %chk_magic
        chk_magic:
          %magic = load i64, ptr %p
          %isPrm = icmp eq i64 %magic, 1347571249
          br i1 %isPrm, label %chk_settled, label %ret_lbl
        chk_settled:
          %gepSettled = getelementptr inbounds i64, ptr %p, i64 4
          %s = load i64, ptr %gepSettled
          %isSet = icmp ne i64 %s, 0
          br i1 %isSet, label %ret_lbl, label %do_res
        do_res:
          %gepState = getelementptr inbounds i64, ptr %p, i64 1
          store i64 1, ptr %gepState
          %gepVal = getelementptr inbounds i64, ptr %p, i64 3
          store i64 %val, ptr %gepVal
          store i64 1, ptr %gepSettled
          br label %ret_lbl
        ret_lbl:
          ret void
        }

        define internal void @zuv_prm_reject(ptr %p, i64 %err) {
        entry:
          %isNull = icmp eq ptr %p, null
          br i1 %isNull, label %ret_lbl, label %chk_magic
        chk_magic:
          %magic = load i64, ptr %p
          %isPrm = icmp eq i64 %magic, 1347571249
          br i1 %isPrm, label %chk_settled, label %ret_lbl
        chk_settled:
          %gepSettled = getelementptr inbounds i64, ptr %p, i64 4
          %s = load i64, ptr %gepSettled
          %isSet = icmp ne i64 %s, 0
          br i1 %isSet, label %ret_lbl, label %do_rej
        do_rej:
          %gepState = getelementptr inbounds i64, ptr %p, i64 1
          store i64 2, ptr %gepState
          %gepVal = getelementptr inbounds i64, ptr %p, i64 3
          store i64 %err, ptr %gepVal
          store i64 1, ptr %gepSettled
          br label %ret_lbl
        ret_lbl:
          ret void
        }

        define internal i64 @zuv_prm_cb_resolve(i64 %val) {
        entry:
          %p = load ptr, ptr @zuv_active_prm
          call void @zuv_prm_resolve(ptr %p, i64 %val)
          ret i64 0
        }

        define internal i64 @zuv_prm_cb_reject(i64 %err) {
        entry:
          %p = load ptr, ptr @zuv_active_prm
          call void @zuv_prm_reject(ptr %p, i64 %err)
          ret i64 0
        }

        define internal i64 @zuv_prm_await(i64 %val) {
        entry:
          %isSmall = icmp ult i64 %val, 268435456
          br i1 %isSmall, label %ret_val, label %chk_align
        chk_align:
          %lowBits = and i64 %val, 7
          %isAligned = icmp eq i64 %lowBits, 0
          br i1 %isAligned, label %chk_high, label %ret_val
        chk_high:
          %isTooHigh = icmp ugt i64 %val, 140737488355327
          br i1 %isTooHigh, label %ret_val, label %chk_ptr
        chk_ptr:
          %ptr = inttoptr i64 %val to ptr
          %magic = load i64, ptr %ptr
          %isPrm = icmp eq i64 %magic, 1347571249
          br i1 %isPrm, label %wait_loop, label %ret_val
        wait_loop:
          %gepSettled = getelementptr inbounds i64, ptr %ptr, i64 4
          %st = load i64, ptr %gepSettled
          %isDone = icmp ne i64 %st, 0
          br i1 %isDone, label %unpack, label %poll_step
        poll_step:
          call void @Sleep(i32 1)
          br label %wait_loop
        unpack:
          %gepState = getelementptr inbounds i64, ptr %ptr, i64 1
          %state = load i64, ptr %gepState
          %gepVal = getelementptr inbounds i64, ptr %ptr, i64 3
          %v = load i64, ptr %gepVal
          %isRej = icmp eq i64 %state, 2
          br i1 %isRej, label %handle_rej, label %handle_ok
        handle_rej:
          store i64 %v, ptr @zuv_exc_value
          store i32 1, ptr @zuv_prm_is_rejected
          ret i64 %v
        handle_ok:
          store i32 0, ptr @zuv_prm_is_rejected
          ret i64 %v
        ret_val:
          store i32 0, ptr @zuv_prm_is_rejected
          ret i64 %val
        }

        define internal ptr @zuv_prm_all(ptr %arr) {
        entry:
          %m = load i32, ptr @zuv_async_context_mode
          %pAll = call ptr @zuv_prm_new(i32 %m)
          %isNull = icmp eq ptr %arr, null
          br i1 %isNull, label %ret_empty, label %chk_len
        chk_len:
          %len = load i64, ptr %arr
          %isZero = icmp eq i64 %len, 0
          br i1 %isZero, label %ret_empty, label %alloc_res
        ret_empty:
          %empty = call ptr @malloc(i64 24)
          store i64 0, ptr %empty
          %emptyArr = getelementptr inbounds i64, ptr %empty, i64 1
          store i64 0, ptr %emptyArr
          %emptyInt = ptrtoint ptr %emptyArr to i64
          call void @zuv_prm_resolve(ptr %pAll, i64 %emptyInt)
          ret ptr %pAll
        alloc_res:
          %szElements = add i64 %len, 2
          %bytes = mul i64 %szElements, 8
          %rawRes = call ptr @malloc(i64 %bytes)
          store i64 %len, ptr %rawRes
          %resArr = getelementptr inbounds i64, ptr %rawRes, i64 1
          store i64 %len, ptr %resArr
          br label %loop_cond
        loop_cond:
          %i = phi i64 [ 1, %alloc_res ], [ %iNext, %loop_step ]
          %done = icmp ugt i64 %i, %len
          br i1 %done, label %finish, label %loop_body
        loop_body:
          %gepItem = getelementptr inbounds i64, ptr %arr, i64 %i
          %itemVal = load i64, ptr %gepItem
          %resVal = call i64 @zuv_prm_await(i64 %itemVal)
          %gepRes = getelementptr inbounds i64, ptr %resArr, i64 %i
          store i64 %resVal, ptr %gepRes
          br label %loop_step
        loop_step:
          %iNext = add i64 %i, 1
          br label %loop_cond
        finish:
          %resInt = ptrtoint ptr %resArr to i64
          call void @zuv_prm_resolve(ptr %pAll, i64 %resInt)
          ret ptr %pAll
        }

        define internal ptr @zuv_prm_race(ptr %arr) {
        entry:
          %m = load i32, ptr @zuv_async_context_mode
          %pRace = call ptr @zuv_prm_new(i32 %m)
          %isNull = icmp eq ptr %arr, null
          br i1 %isNull, label %ret_race, label %chk_len_race
        chk_len_race:
          %len = load i64, ptr %arr
          %isZero = icmp eq i64 %len, 0
          br i1 %isZero, label %ret_race, label %poll_race
        poll_race:
          br label %race_loop_cond
        race_loop_cond:
          %iR = phi i64 [ 1, %poll_race ], [ %iRNext, %race_loop_step ]
          %rDone = icmp ugt i64 %iR, %len
          br i1 %rDone, label %await_first, label %race_loop_body
        race_loop_body:
          %gepItemR = getelementptr inbounds i64, ptr %arr, i64 %iR
          %itemRVal = load i64, ptr %gepItemR
          %rPtr = inttoptr i64 %itemRVal to ptr
          %rMagic = load i64, ptr %rPtr
          %rIsPrm = icmp eq i64 %rMagic, 1347571249
          br i1 %rIsPrm, label %chk_r_set, label %race_loop_step
        chk_r_set:
          %gepRSet = getelementptr inbounds i64, ptr %rPtr, i64 4
          %rSet = load i64, ptr %gepRSet
          %rDoneSet = icmp ne i64 %rSet, 0
          br i1 %rDoneSet, label %race_win, label %race_loop_step
        race_win:
          %gepRVal = getelementptr inbounds i64, ptr %rPtr, i64 3
          %rVal = load i64, ptr %gepRVal
          call void @zuv_prm_resolve(ptr %pRace, i64 %rVal)
          ret ptr %pRace
        race_loop_step:
          %iRNext = add i64 %iR, 1
          br label %race_loop_cond
        await_first:
          %gepFirst = getelementptr inbounds i64, ptr %arr, i64 1
          %fVal = load i64, ptr %gepFirst
          %fRes = call i64 @zuv_prm_await(i64 %fVal)
          call void @zuv_prm_resolve(ptr %pRace, i64 %fRes)
          ret ptr %pRace
        ret_race:
          call void @zuv_prm_resolve(ptr %pRace, i64 0)
          ret ptr %pRace
        }

        define internal ptr @zuv_prm_all_settled(ptr %arr) {
        entry:
          %m = load i32, ptr @zuv_async_context_mode
          %pSettled = call ptr @zuv_prm_new(i32 %m)
          %isNull = icmp eq ptr %arr, null
          br i1 %isNull, label %ret_empty_s, label %chk_len_s
        chk_len_s:
          %len = load i64, ptr %arr
          %isZero = icmp eq i64 %len, 0
          br i1 %isZero, label %ret_empty_s, label %alloc_res_s
        ret_empty_s:
          %empty = call ptr @malloc(i64 24)
          store i64 0, ptr %empty
          %emptyArr = getelementptr inbounds i64, ptr %empty, i64 1
          store i64 0, ptr %emptyArr
          %emptyInt = ptrtoint ptr %emptyArr to i64
          call void @zuv_prm_resolve(ptr %pSettled, i64 %emptyInt)
          ret ptr %pSettled
        alloc_res_s:
          %szElements = add i64 %len, 2
          %bytes = mul i64 %szElements, 8
          %rawRes = call ptr @malloc(i64 %bytes)
          store i64 %len, ptr %rawRes
          %resArr = getelementptr inbounds i64, ptr %rawRes, i64 1
          store i64 %len, ptr %resArr
          br label %loop_cond_s
        loop_cond_s:
          %iS = phi i64 [ 1, %alloc_res_s ], [ %iSNext, %loop_step_s ]
          %sDone = icmp ugt i64 %iS, %len
          br i1 %sDone, label %finish_s, label %loop_body_s
        loop_body_s:
          %gepItemS = getelementptr inbounds i64, ptr %arr, i64 %iS
          %itemSVal = load i64, ptr %gepItemS
          %resSVal = call i64 @zuv_prm_await(i64 %itemSVal)
          %gepResS = getelementptr inbounds i64, ptr %resArr, i64 %iS
          store i64 %resSVal, ptr %gepResS
          br label %loop_step_s
        loop_step_s:
          %iSNext = add i64 %iS, 1
          br label %loop_cond_s
        finish_s:
          %resIntS = ptrtoint ptr %resArr to i64
          call void @zuv_prm_resolve(ptr %pSettled, i64 %resIntS)
          ret ptr %pSettled
        }

        define internal ptr @zuv_fs_rf_async(ptr %path) {
        entry:
          %m = load i32, ptr @zuv_async_context_mode
          %p = call ptr @zuv_prm_new(i32 %m)
          %fp = call ptr @fopen(ptr %path, ptr ${rbConst})
          %isNull = icmp eq ptr %fp, null
          br i1 %isNull, label %rf_err, label %rf_ok
        rf_ok:
          call i32 @fseek(ptr %fp, i64 0, i32 2)
          %sz = call i64 @ftell(ptr %fp)
          call void @rewind(ptr %fp)
          %sz1 = add i64 %sz, 1
          %buf = call ptr @malloc(i64 %sz1)
          %n = call i64 @fread(ptr %buf, i64 1, i64 %sz, ptr %fp)
          %endPtr = getelementptr inbounds i8, ptr %buf, i64 %n
          store i8 0, ptr %endPtr
          call i32 @fclose(ptr %fp)
          %strInt = ptrtoint ptr %buf to i64
          call void @zuv_prm_resolve(ptr %p, i64 %strInt)
          ret ptr %p
        rf_err:
          %emp = call ptr @malloc(i64 1)
          store i8 0, ptr %emp
          %empInt = ptrtoint ptr %emp to i64
          call void @zuv_prm_resolve(ptr %p, i64 %empInt)
          ret ptr %p
        }

        define internal ptr @zuv_fs_wf_async(ptr %path, ptr %data) {
        entry:
          %m = load i32, ptr @zuv_async_context_mode
          %p = call ptr @zuv_prm_new(i32 %m)
          %fp = call ptr @fopen(ptr %path, ptr ${wbConst})
          %isNull = icmp eq ptr %fp, null
          br i1 %isNull, label %wf_err, label %wf_ok
        wf_ok:
          %dLen = call i64 @strlen(ptr %data)
          %written = call i64 @fwrite(ptr %data, i64 1, i64 %dLen, ptr %fp)
          call i32 @fclose(ptr %fp)
          call void @zuv_prm_resolve(ptr %p, i64 %written)
          ret ptr %p
        wf_err:
          call void @zuv_prm_resolve(ptr %p, i64 0)
          ret ptr %p
        }
        `
    },

    /**
     * Emits the CLI arguments initialization handler `@zuv_init_args`.
     *
     * Constructs the global args array containing [executable, sourceFile, ...cliArgs].
     *
     * @returns {void}
     */
    emitInitArgs: :: void => {
        self.codegen.funcs += `
        define void @zuv_init_args(i32 %argc, ptr %argv, ptr %srcFile) {
        entry:
            %isArgcNeg = icmp slt i32 %argc, 0
            %isArgvNull = icmp eq ptr %argv, null
            %isBad = or i1 %isArgcNeg, %isArgvNull
            br i1 %isBad, label %init_empty, label %do_init

        init_empty:
            %empArr = getelementptr inbounds [2 x i64], ptr @_zuv_empty_arr, i64 0, i64 1
            %empInt = ptrtoint ptr %empArr to i64
            store i64 %empInt, ptr @zuv_global_args
            ret void

        do_init:
            %argc64 = sext i32 %argc to i64
            %hasArgv = icmp sgt i64 %argc64, 0
            %argcPlus1 = add i64 %argc64, 1
            %totCount = select i1 %hasArgv, i64 %argcPlus1, i64 1
            %szElements = add i64 %totCount, 2
            %bytes = mul i64 %szElements, 8
            %rawArr = call ptr @malloc(i64 %bytes)
            store i64 %totCount, ptr %rawArr
            %arr = getelementptr inbounds i64, ptr %rawArr, i64 1
            store i64 %totCount, ptr %arr
            br i1 %hasArgv, label %store_argv0, label %store_only_src

        store_argv0:
            %pArgv0 = load ptr, ptr %argv, align 8
            %isArgv0Null = icmp eq ptr %pArgv0, null
            br i1 %isArgv0Null, label %store_empty_argv0, label %copy_argv0

        store_empty_argv0:
            %emp0 = call ptr @malloc(i64 1)
            store i8 0, ptr %emp0
            %emp0Int = ptrtoint ptr %emp0 to i64
            %gepSlotArgv0 = getelementptr inbounds i64, ptr %arr, i64 1
            store i64 %emp0Int, ptr %gepSlotArgv0
            br label %store_src_file

        copy_argv0:
            %len0 = call i64 @strlen(ptr %pArgv0)
            %len0p1 = add i64 %len0, 1
            %copy0 = call ptr @malloc(i64 %len0p1)
            call ptr @memcpy(ptr %copy0, ptr %pArgv0, i64 %len0p1)
            %copy0Int = ptrtoint ptr %copy0 to i64
            %gepSlotArgv0b = getelementptr inbounds i64, ptr %arr, i64 1
            store i64 %copy0Int, ptr %gepSlotArgv0b
            br label %store_src_file

        store_src_file:
            %isSrcNull = icmp eq ptr %srcFile, null
            br i1 %isSrcNull, label %store_empty_src, label %copy_src

        store_empty_src:
            %empSrc = call ptr @malloc(i64 1)
            store i8 0, ptr %empSrc
            %empSrcInt = ptrtoint ptr %empSrc to i64
            %gepSlot1 = getelementptr inbounds i64, ptr %arr, i64 2
            store i64 %empSrcInt, ptr %gepSlot1
            br label %check_rest_args

        copy_src:
            %lenSrc = call i64 @strlen(ptr %srcFile)
            %lenSrcp1 = add i64 %lenSrc, 1
            %copySrc = call ptr @malloc(i64 %lenSrcp1)
            call ptr @memcpy(ptr %copySrc, ptr %srcFile, i64 %lenSrcp1)
            %copySrcInt = ptrtoint ptr %copySrc to i64
            %gepSlot1b = getelementptr inbounds i64, ptr %arr, i64 2
            store i64 %copySrcInt, ptr %gepSlot1b
            br label %check_rest_args

        store_only_src:
            %isSrcNull2 = icmp eq ptr %srcFile, null
            br i1 %isSrcNull2, label %store_empty_src2, label %copy_src2

        store_empty_src2:
            %empSrc2 = call ptr @malloc(i64 1)
            store i8 0, ptr %empSrc2
            %empSrc2Int = ptrtoint ptr %empSrc2 to i64
            %gepSlotSingle = getelementptr inbounds i64, ptr %arr, i64 1
            store i64 %empSrc2Int, ptr %gepSlotSingle
            br label %init_done

        copy_src2:
            %lenSrc2 = call i64 @strlen(ptr %srcFile)
            %lenSrc2p1 = add i64 %lenSrc2, 1
            %copySrc2 = call ptr @malloc(i64 %lenSrc2p1)
            call ptr @memcpy(ptr %copySrc2, ptr %srcFile, i64 %lenSrc2p1)
            %copySrc2Int = ptrtoint ptr %copySrc2 to i64
            %gepSlotSingleB = getelementptr inbounds i64, ptr %arr, i64 1
            store i64 %copySrc2Int, ptr %gepSlotSingleB
            br label %init_done

        check_rest_args:
            %iAlloc = alloca i64
            store i64 1, ptr %iAlloc
            br label %loop_cond

        loop_cond:
            %curI = load i64, ptr %iAlloc
            %cmp = icmp slt i64 %curI, %argc64
            br i1 %cmp, label %loop_body, label %init_done

        loop_body:
            %gepArgv = getelementptr inbounds ptr, ptr %argv, i64 %curI
            %argStr = load ptr, ptr %gepArgv, align 8
            %isArgNull = icmp eq ptr %argStr, null
            br i1 %isArgNull, label %store_empty_arg, label %copy_arg

        store_empty_arg:
            %nullStr = call ptr @malloc(i64 1)
            store i8 0, ptr %nullStr
            %nullInt = ptrtoint ptr %nullStr to i64
            %slotIdx0 = add i64 %curI, 2
            %gepSlot0 = getelementptr inbounds i64, ptr %arr, i64 %slotIdx0
            store i64 %nullInt, ptr %gepSlot0
            br label %next_iter

        copy_arg:
            %strLen = call i64 @strlen(ptr %argStr)
            %strLenPlus1 = add i64 %strLen, 1
            %newStr = call ptr @malloc(i64 %strLenPlus1)
            call ptr @memcpy(ptr %newStr, ptr %argStr, i64 %strLenPlus1)
            %strInt = ptrtoint ptr %newStr to i64
            %slotIdx = add i64 %curI, 2
            %gepSlot = getelementptr inbounds i64, ptr %arr, i64 %slotIdx
            store i64 %strInt, ptr %gepSlot
            br label %next_iter

        next_iter:
            %nextI = add i64 %curI, 1
            store i64 %nextI, ptr %iAlloc
            br label %loop_cond

        init_done:
            %arrInt = ptrtoint ptr %arr to i64
            store i64 %arrInt, ptr @zuv_global_args
            ret void
        }
        `
    },

    emitTimeMono: :: void => {
        self.codegen.emitExtern "declare i32 @QueryPerformanceCounter(ptr)"
        self.codegen.emitExtern "declare i32 @QueryPerformanceFrequency(ptr)"
        self.codegen.funcs += `
        define double @zuv_time_mono() {
        entry:
          %pCount = alloca i64
          %pFreq = alloca i64
          call i32 @QueryPerformanceCounter(ptr %pCount)
          call i32 @QueryPerformanceFrequency(ptr %pFreq)
          %count = load i64, ptr %pCount
          %freq = load i64, ptr %pFreq
          %countDbl = sitofp i64 %count to double
          %freqDbl = sitofp i64 %freq to double
          %sec = fdiv double %countDbl, %freqDbl
          %ns = fmul double %sec, 1000000000.0
          ret double %ns
        }
        `
    },

