/*
 * =============================================================================
 * Zuv Bootstrap Compiler — Runtime Intrinsics & Crash Handling Code Generation
 * Path: sub_projects/zuv/src/bootstrap/codegen/runtime.zv
 * =============================================================================
 *
 * Implements code generation for Zuv runtime intrinsics and panic/crash handling:
 * - Function descriptor metadata tracking (`FunctionDescriptor`)
 * - Global runtime constants, format strings, and metadata tables
 * - Runtime panic handling (`@zuv_panic`) with file/line reporting and exit 101
 * - Stack backtrace capture and unwinding (`@zuv_walk_stack`, `@zuv_dump_stack`, `@zuv_backtrace`)
 * - Symbol resolution against function descriptor tables (`@zuv_resolve_pc`, `@zuv_ensure_fn_sorted`)
 * - Runtime array bounds-check handler (`@zuv_check_bounds`)
 * - Win32 Vectored Exception Handling (`@zuv_init_crash_handler`, `@zuv_crash_handler`)
 *   for hardware access violations, division by zero, stack overflow, and aborts
 */

imp Codegen frm codegen
imp StructLayoutRegistry frm decl

imp EmitRuntimeDecl frm runtime/emitRuntimeDecl
imp EmitRuntimeGlobals frm runtime/emitRuntimeGlobals
imp EmitEnsureFnSorted frm runtime/emitEnsureFnSorted
imp EmitResolvePc frm runtime/emitResolvePc
imp EmitWalkStack frm runtime/emitWalkStack
imp EmitPanicHandler frm runtime/emitPanicHandler
imp EmitBoundsCheckHandler frm runtime/emitBoundsCheckHandler
imp EmitDumpStackHandler frm runtime/emitDumpStackHandler
imp EmitBacktraceHandler frm runtime/emitBacktraceHandler
imp EmitCrashHandler frm runtime/emitCrashHandler
imp EmitInitCrashHandler frm runtime/emitInitCrashHandler
imp EmitPromiseRuntime frm runtime/emitPromiseRuntime
imp EmitInitArgs frm runtime/emitInitArgs
imp EmitTimeMono frm runtime/emitTimeMono
imp EmitAll frm runtime/emitAll
imp EmitPanicCall frm runtime/emitPanicCall
imp EmitBoundsCheckCall frm runtime/emitBoundsCheckCall
imp EmitInitArgsCall frm runtime/emitInitArgsCall
imp EmitInitCrashHandlerCall frm runtime/emitInitCrashHandlerCall
imp EmitDumpStackCall frm runtime/emitDumpStackCall
imp EmitBacktraceCall frm runtime/emitBacktraceCall

/**
 * Holds function metadata for backtrace symbol resolution.
 */
obj FunctionDescriptor {
    llvmName: str,
    displayName: str,
    filePath: str,
    startLine: num,

    /**
     * Creates an initialized FunctionDescriptor record.
     *
     * @param {str} llvmName - LLVM IR symbol name (without @)
     * @param {str} displayName - Human-readable function name
     * @param {str} filePath - Source file path
     * @param {num} startLine - Source file starting line number
     * @returns {FunctionDescriptor} Initialized function descriptor
     */
    create: llvmName: str, displayName: str, filePath: str, startLine: num :: FunctionDescriptor => {
        -> {
            llvmName,
            displayName,
            filePath,
            startLine
        }
    }
}

/**
 * Manages runtime crash handling, panic emission, and stack unwinding IR generators.
 */
obj RuntimeCodegen {
    codegen: Codegen,
    runtimeEmitted: bool,
    funcDescs: FunctionDescriptor[],
    registry: StructLayoutRegistry,

    /**
     * Creates a new RuntimeCodegen coordinator.
     *
     * @param {Codegen} codegen - LLVM IR module coordinator
     * @returns {RuntimeCodegen} Initialized runtime code generator
     */
    create: codegen: Codegen :: RuntimeCodegen => {
        descs: FunctionDescriptor[] = []
        reg = StructLayoutRegistry.create()
        -> {
            codegen,
            runtimeEmitted: false,
            funcDescs: descs,
            registry: reg
        }
    },

    /**
     * Registers a function descriptor for symbol table backtrace resolution.
     *
     * @param {str} llvmName - LLVM IR function name (without @)
     * @param {str} displayName - Human-readable function name
     * @param {str} filePath - Source file path
     * @param {num} startLine - Source file starting line number
     * @returns {void}
     */
    registerFunction: llvmName: str, displayName: str, filePath: str, startLine: num :: void => {
        desc = FunctionDescriptor.create llvmName, displayName, filePath, startLine
        self.funcDescs.psh desc
    },

    emitRuntimeDecl: decl: str, symbol: str :: void => EmitRuntimeDecl(self, decl, symbol),
    emitRuntimeGlobals: :: void => EmitRuntimeGlobals(self),
    emitEnsureFnSorted: :: void => EmitEnsureFnSorted(self),
    emitResolvePc: :: void => EmitResolvePc(self),
    emitWalkStack: :: void => EmitWalkStack(self),
    emitPanicHandler: :: void => EmitPanicHandler(self),
    emitBoundsCheckHandler: :: void => EmitBoundsCheckHandler(self),
    emitDumpStackHandler: :: void => EmitDumpStackHandler(self),
    emitBacktraceHandler: :: void => EmitBacktraceHandler(self),
    emitCrashHandler: :: void => EmitCrashHandler(self),
    emitInitCrashHandler: :: void => EmitInitCrashHandler(self),
    emitPromiseRuntime: :: void => EmitPromiseRuntime(self),
    emitInitArgs: :: void => EmitInitArgs(self),
    emitTimeMono: :: void => EmitTimeMono(self),
    emitAll: :: void => EmitAll(self),
    emitPanicCall: msg: str, file: str, line: num :: void => EmitPanicCall(self, msg, file, line),
    emitBoundsCheckCall: arrReg: str, idxReg: str, file: str, line: num :: void => EmitBoundsCheckCall(self, arrReg, idxReg, file, line),
    emitInitArgsCall: srcFile: str :: void => EmitInitArgsCall(self, srcFile),
    emitInitCrashHandlerCall: :: void => EmitInitCrashHandlerCall(self),
    emitDumpStackCall: :: void => EmitDumpStackCall(self),
    emitBacktraceCall: :: str => EmitBacktraceCall(self)
}
