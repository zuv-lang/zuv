          %pcPtr = getelementptr inbounds i64, ptr %pPtr, i64 3
          %pc64 = load i64, ptr %pcPtr
          %hasPC = icmp ne i64 %pc64, 0
          br i1 %hasPC, label %spawn_conpty, label %done
        spawn_conpty:
          %pcHandle = inttoptr i64 %pc64 to ptr
          %attrSize = alloca i64, align 8
          store i64 0, ptr %attrSize
          call i32 @InitializeProcThreadAttributeList(ptr null, i32 1, i32 0, ptr %attrSize)
          %size = load i64, ptr %attrSize
          %attrList = call ptr @malloc(i64 %size)
          call i32 @InitializeProcThreadAttributeList(ptr %attrList, i32 1, i32 0, ptr %attrSize)
          %pcVar = alloca ptr, align 8
          store ptr %pcHandle, ptr %pcVar
          call i32 @UpdateProcThreadAttribute(ptr %attrList, i32 0, i64 131094, ptr %pcVar, i64 8, ptr null, ptr null)
          %siEx = alloca [112 x i8], align 8
          call ptr @memset(ptr %siEx, i32 0, i64 112)
          store i32 112, ptr %siEx
          %attrField = getelementptr inbounds i8, ptr %siEx, i64 104
          store ptr %attrList, ptr %attrField
          %pi = alloca [24 x i8], align 8
          call ptr @memset(ptr %pi, i32 0, i64 24)
          %cpOk = call i32 @CreateProcessA(ptr null, ptr %cmd, ptr null, ptr null, i32 0, i32 524288, ptr null, ptr null, ptr %siEx, ptr %pi)
          call void @DeleteProcThreadAttributeList(ptr %attrList)
          call void @free(ptr %attrList)
          %isOk = icmp ne i32 %cpOk, 0
          br i1 %isOk, label %save_proc, label %done
        save_proc:
          %hProc = load ptr, ptr %pi
          %hProc64 = ptrtoint ptr %hProc to i64
          %procField = getelementptr inbounds i64, ptr %pPtr, i64 2
          store i64 %hProc64, ptr %procField
          %hThrdPtr = getelementptr inbounds i8, ptr %pi, i64 8
          %hThrd = load ptr, ptr %hThrdPtr
          call i32 @CloseHandle(ptr %hThrd)
          br label %done
        done:
          ret i64 %p64
        }

        define internal i64 @zuv_pty_write(i64 %h, ptr %data) {
        entry:
          %cmpZ = icmp eq i64 %h, 0
          br i1 %cmpZ, label %ret_zero, label %do_write
        do_write:
          %rawI64 = and i64 %h, -281474976710657
          %desc = inttoptr i64 %rawI64 to ptr
          %inW64 = load i64, ptr %desc
          %inW = inttoptr i64 %inW64 to ptr
          %len = call i64 @strlen(ptr %data)
          %len32 = trunc i64 %len to i32
          %written = alloca i32, align 4
          store i32 0, ptr %written
          call i32 @WriteFile(ptr %inW, ptr %data, i32 %len32, ptr %written, ptr null)
          %w = load i32, ptr %written
          %w64 = zext i32 %w to i64
          ret i64 %w64
        ret_zero:
          ret i64 0
        }

        define internal ptr @zuv_pty_read(i64 %h, i32 %maxLen) {
        entry:
          %cmpZ = icmp eq i64 %h, 0
          br i1 %cmpZ, label %ret_empty, label %check_pipe
        check_pipe:
          %rawI64 = and i64 %h, -281474976710657
          %desc = inttoptr i64 %rawI64 to ptr
          %outRField = getelementptr inbounds i64, ptr %desc, i64 1
          %outR64 = load i64, ptr %outRField
          %outR = inttoptr i64 %outR64 to ptr
          %avail = alloca i32, align 4
          store i32 0, ptr %avail
          call i32 @PeekNamedPipe(ptr %outR, ptr null, i32 0, ptr null, ptr %avail, ptr null)
          %av = load i32, ptr %avail
          %hasData = icmp sgt i32 %av, 0
          br i1 %hasData, label %do_read, label %ret_empty
        do_read:
          %cmpMin = icmp slt i32 %av, %maxLen
          %toRead = select i1 %cmpMin, i32 %av, i32 %maxLen
          %toRead64 = zext i32 %toRead to i64
          %allocSize = add i64 %toRead64, 1
          %buf = call ptr @malloc(i64 %allocSize)
          %readBytes = alloca i32, align 4
          store i32 0, ptr %readBytes
          call i32 @ReadFile(ptr %outR, ptr %buf, i32 %toRead, ptr %readBytes, ptr null)
          %rb = load i32, ptr %readBytes
          %rb64 = zext i32 %rb to i64
          %nullByte = getelementptr inbounds i8, ptr %buf, i64 %rb64
          store i8 0, ptr %nullByte
          ret ptr %buf
        ret_empty:
          ret ptr @zuv_term_str_empty
        }

        define internal double @zuv_pty_resize(i64 %h, i32 %cols, i32 %rows) {
        entry:
          %cmpZ = icmp eq i64 %h, 0
          br i1 %cmpZ, label %done, label %do_resize
        do_resize:
          %rawI64 = and i64 %h, -281474976710657
          %desc = inttoptr i64 %rawI64 to ptr
          %pcField = getelementptr inbounds i64, ptr %desc, i64 3
          %pc64 = load i64, ptr %pcField
          %hasPC = icmp ne i64 %pc64, 0
          br i1 %hasPC, label %call_resize, label %done
        call_resize:
          %pcHandle = inttoptr i64 %pc64 to ptr
          %r16 = shl i32 %rows, 16
          %c16 = and i32 %cols, 65535
          %coord = or i32 %r16, %c16
          call i32 @ResizePseudoConsole(ptr %pcHandle, i32 %coord)
          br label %done
        done:
          ret double 0.0
        }

        define internal double @zuv_pty_close(i64 %h) {
        entry:
          %cmpZ = icmp eq i64 %h, 0
          br i1 %cmpZ, label %done, label %do_close
        do_close:
          %rawI64 = and i64 %h, -281474976710657
          %desc = inttoptr i64 %rawI64 to ptr
          %p0 = getelementptr inbounds i64, ptr %desc, i64 0
          %p1 = getelementptr inbounds i64, ptr %desc, i64 1
          %p2 = getelementptr inbounds i64, ptr %desc, i64 2
          %p3 = getelementptr inbounds i64, ptr %desc, i64 3
          %inW64 = load i64, ptr %p0
          %outR64 = load i64, ptr %p1
          %proc64 = load i64, ptr %p2
          %pc64 = load i64, ptr %p3
          %hasIn = icmp ne i64 %inW64, 0
          br i1 %hasIn, label %close_in, label %check_out
        close_in:
          %inH = inttoptr i64 %inW64 to ptr
          call i32 @CloseHandle(ptr %inH)
          br label %check_out
        check_out:
          %hasOut = icmp ne i64 %outR64, 0
          br i1 %hasOut, label %close_out, label %check_pc
        close_out:
          %outH = inttoptr i64 %outR64 to ptr
          call i32 @CloseHandle(ptr %outH)
          br label %check_pc
        check_pc:
          %hasPC = icmp ne i64 %pc64, 0
          br i1 %hasPC, label %close_pc, label %check_proc
        close_pc:
          %pcH = inttoptr i64 %pc64 to ptr
          call void @ClosePseudoConsole(ptr %pcH)
          br label %check_proc
        check_proc:
          %hasProc = icmp ne i64 %proc64, 0
          br i1 %hasProc, label %close_proc, label %free_desc
        close_proc:
          %procH = inttoptr i64 %proc64 to ptr
          call i32 @TerminateProcess(ptr %procH, i32 0)
          call i32 @CloseHandle(ptr %procH)
          br label %free_desc
        free_desc:
          call void @free(ptr %desc)
          br label %done
        done:
          ret double 0.0
        }
        `
    },

    /**
     * Emits a call to `@zuv_panic` with file and line metadata, followed by `unreachable`.
     *
     * @param {str} msg - Panic explanation text
     * @param {str} file - Source file path
     * @param {num} line - Source line number
     * @returns {void}
     */
    emitPanicCall: msg: str, file: str, line: num :: void => {
        msgSym: str = self.codegen.addStringConstant msg
        fileSym: str = self.codegen.addStringConstant file
        self.codegen.emit `call void @zuv_panic(ptr ${msgSym}, ptr ${fileSym}, i32 ${line})`
        self.codegen.emit "unreachable"
    },

    /**
     * Emits a call to array bounds checking handler `@zuv_check_bounds`.
     *
     * @param {str} arrReg - SSA virtual register containing array pointer
     * @param {str} idxReg - SSA virtual register containing index value (i64)
     * @param {str} file - Source file path
     * @param {num} line - Source line number
     * @returns {void}
     */
    emitBoundsCheckCall: arrReg: str, idxReg: str, file: str, line: num :: void => {
        fileSym: str = self.codegen.addStringConstant file
        self.codegen.emit `call void @zuv_check_bounds(ptr ${arrReg}, i64 ${idxReg}, ptr ${fileSym}, i32 ${line})`
    },

    /**
     * Emits a call to `@zuv_init_args` with program argc, argv, and source file name.
     *
     * @param {str} srcFile - Source file path string
     * @returns {void}
     */
    emitInitArgsCall: srcFile: str :: void => {
        fileSym: str = self.codegen.addStringConstant srcFile
        self.codegen.emit `call void @zuv_init_args(i32 %argc, ptr %argv, ptr ${fileSym})`
    },

    /**
     * Emits a call to `@zuv_init_crash_handler` to enable vectored exception trapping.
     *
     * @returns {void}
     */
    emitInitCrashHandlerCall: :: void => {
        self.codegen.emit "call void @zuv_init_crash_handler()"
    },

    /**
     * Emits a call to `@zuv_dump_stack` to dump the current backtrace to stderr.
     *
     * @returns {void}
     */
    emitDumpStackCall: :: void => {
        self.codegen.emit "call void @zuv_dump_stack()"
    },

    /**
     * Emits a call to `@zuv_backtrace` returning a heap-allocated formatted stack trace string.
     *
     * @returns {str} SSA virtual register holding string pointer (`ptr`)
     */
    emitBacktraceCall: :: str => {
        resReg: str = self.codegen.newReg
        self.codegen.emit `${resReg} = call ptr @zuv_backtrace()`
        -> resReg
    }
}
