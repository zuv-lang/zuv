    /**
     * Emits the complete suite of runtime intrinsics, crash handling, and backtrace handlers.
     *
     * @returns {void}
     */
    emitAll: :: void => {
        if self.runtimeEmitted {
            -> und
        }
        self.emitRuntimeGlobals
        self.emitEnsureFnSorted
        self.emitResolvePc
        self.emitWalkStack
        self.emitPanicHandler
        self.emitBoundsCheckHandler
        self.emitDumpStackHandler
        self.emitBacktraceHandler
        self.emitCrashHandler
        self.emitInitCrashHandler
        self.emitInitArgs
        self.emitPromiseRuntime
        self.emitTimeMono
        self.emitNetRuntime
        self.emitIpcRuntime
        self.emitTermRuntime
        self.emitPtyRuntime
        self.runtimeEmitted = true
    },

    /**
     * Emits the runtime routines for IPC and shared memory.
     *
     * @returns {void}
     */
    emitIpcRuntime: :: void => {
        self.emitRuntimeDecl "declare ptr @CreateNamedPipeA(ptr, i32, i32, i32, i32, i32, i32, ptr)", "@CreateNamedPipeA"
        self.emitRuntimeDecl "declare ptr @CreateFileA(ptr, i32, i32, ptr, i32, i32, ptr)", "@CreateFileA"
        self.emitRuntimeDecl "declare i32 @GetFileSize(ptr, ptr)", "@GetFileSize"
        self.emitRuntimeDecl "declare ptr @CreateFileMappingA(ptr, ptr, i32, i32, i32, ptr)", "@CreateFileMappingA"
        self.emitRuntimeDecl "declare ptr @OpenFileMappingA(i32, i32, ptr)", "@OpenFileMappingA"
        self.emitRuntimeDecl "declare ptr @MapViewOfFile(ptr, i32, i32, i32, i64)", "@MapViewOfFile"
        self.emitRuntimeDecl "declare i32 @UnmapViewOfFile(ptr)", "@UnmapViewOfFile"
        self.emitRuntimeDecl "declare i32 @FlushViewOfFile(ptr, i64)", "@FlushViewOfFile"
        self.emitRuntimeDecl "declare ptr @CreateMutexA(ptr, i32, ptr)", "@CreateMutexA"
        self.emitRuntimeDecl "declare i32 @WaitForSingleObject(ptr, i32)", "@WaitForSingleObject"
        self.emitRuntimeDecl "declare i32 @ReleaseMutex(ptr)", "@ReleaseMutex"
        self.emitRuntimeDecl "declare ptr @CreateSemaphoreA(ptr, i32, i32, ptr)", "@CreateSemaphoreA"
        self.emitRuntimeDecl "declare i32 @ReleaseSemaphore(ptr, i32, ptr)", "@ReleaseSemaphore"
        self.emitRuntimeDecl "declare ptr @CreateEventA(ptr, i32, i32, ptr)", "@CreateEventA"
        self.emitRuntimeDecl "declare i32 @SetEvent(ptr)", "@SetEvent"
        self.emitRuntimeDecl "declare i32 @ResetEvent(ptr)", "@ResetEvent"

        self.emitRuntimeDecl "@str_pipe_fmt = private unnamed_addr constant [12 x i8] c\"\\5C\\5C.\\5Cpipe\\5C%s\\00\"", "@str_pipe_fmt"
        self.emitRuntimeDecl "@str_pipe_pattern = private unnamed_addr constant [9 x i8] c\"\\5C\\5C.\\5Cpipe\\00\"", "@str_pipe_pattern"

        self.codegen.funcs += `
        define internal ptr @zuv_ipc_format_pipename(ptr %name) {
        entry:
          %isNameNull = icmp eq ptr %name, null
          br i1 %isNameNull, label %ret_default, label %check_pattern
        ret_default:
          %defBuf = call ptr @malloc(i64 32)
          %defRet = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %defBuf, i64 32, ptr @str_pipe_fmt, ptr @empty_str)
          ret ptr %defBuf
        check_pattern:
          %buf = call ptr @malloc(i64 260)
          %hasPattern = call ptr @strstr(ptr %name, ptr @str_pipe_pattern)
          %cmpHas = icmp ne ptr %hasPattern, null
          br i1 %cmpHas, label %copy_direct, label %do_fmt
        copy_direct:
          %len = call i64 @strlen(ptr %name)
          %allocSz = add i64 %len, 1
          call ptr @memcpy(ptr %buf, ptr %name, i64 %allocSz)
          ret ptr %buf
        do_fmt:
          %n = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %buf, i64 260, ptr @str_pipe_fmt, ptr %name)
          ret ptr %buf
        }

        define internal i64 @zuv_ipc_pipe_server(ptr %name) {
        entry:
          %pipeName = call ptr @zuv_ipc_format_pipename(ptr %name)
          %h = call ptr @CreateNamedPipeA(ptr %pipeName, i32 3, i32 0, i32 255, i32 65536, i32 65536, i32 0, ptr null)
          call void @free(ptr %pipeName)
          %inv = inttoptr i64 -1 to ptr
          %cmpBad = icmp eq ptr %h, %inv
          br i1 %cmpBad, label %ret_err, label %ret_ok
        ret_err:
          ret i64 -1
        ret_ok:
          %hInt = ptrtoint ptr %h to i64
          %tagged = or i64 %hInt, 281474976710656
          ret i64 %tagged
        }

        define internal i64 @zuv_ipc_pipe_client(ptr %name) {
        entry:
          %pipeName = call ptr @zuv_ipc_format_pipename(ptr %name)
          %h = call ptr @CreateFileA(ptr %pipeName, i32 -1073741824, i32 0, ptr null, i32 3, i32 0, ptr null)
          call void @free(ptr %pipeName)
          %inv = inttoptr i64 -1 to ptr
          %cmpBad = icmp eq ptr %h, %inv
          br i1 %cmpBad, label %ret_err, label %ret_ok
        ret_err:
          ret i64 -1
        ret_ok:
          %hInt = ptrtoint ptr %h to i64
          %tagged = or i64 %hInt, 281474976710656
          ret i64 %tagged
        }

        define internal ptr @zuv_ipc_mmap(ptr %path, i64 %len) {
        entry:
          %hFile = call ptr @CreateFileA(ptr %path, i32 -1073741824, i32 3, ptr null, i32 4, i32 128, ptr null)
          %inv = inttoptr i64 -1 to ptr
          %cmpBad = icmp eq ptr %hFile, %inv
          br i1 %cmpBad, label %ret_null, label %check_len
        check_len:
          %cmpLe = icmp sle i64 %len, 0
          br i1 %cmpLe, label %query_sz, label %do_map_create
        query_sz:
          %fsz = call i32 @GetFileSize(ptr %hFile, ptr null)
          %fsz64 = zext i32 %fsz to i64
          br label %do_map_create
        do_map_create:
          %actualLen = phi i64 [ %len, %check_len ], [ %fsz64, %query_sz ]
          %len32 = trunc i64 %actualLen to i32
          %hMap = call ptr @CreateFileMappingA(ptr %hFile, ptr null, i32 4, i32 0, i32 %len32, ptr null)
          call i32 @CloseHandle(ptr %hFile)
          %cmpBadMap = icmp eq ptr %hMap, null
          br i1 %cmpBadMap, label %ret_null, label %do_view
        do_view:
          %viewPtr = call ptr @MapViewOfFile(ptr %hMap, i32 6, i32 0, i32 0, i64 %actualLen)
          call i32 @CloseHandle(ptr %hMap)
          ret ptr %viewPtr
        ret_null:
          ret ptr null
        }

        define internal ptr @zuv_ipc_shm(ptr %name, i64 %size) {
        entry:
          %inv = inttoptr i64 -1 to ptr
          %sizeHigh = lshr i64 %size, 32
          %sizeHigh32 = trunc i64 %sizeHigh to i32
          %sizeLow32 = trunc i64 %size to i32
          %isNameNull = icmp eq ptr %name, null
          br i1 %isNameNull, label %check_empty_done, label %check_empty
        check_empty:
          %c0 = load i8, ptr %name
          %isEmpty = icmp eq i8 %c0, 0
          br label %check_empty_done
        check_empty_done:
          %noName = phi i1 [ true, %entry ], [ %isEmpty, %check_empty ]
          %realName = select i1 %noName, ptr null, ptr %name
          %hMap = call ptr @CreateFileMappingA(ptr %inv, ptr null, i32 4, i32 %sizeHigh32, i32 %sizeLow32, ptr %realName)
          %cmpBad = icmp eq ptr %hMap, null
          br i1 %cmpBad, label %ret_null, label %do_view
        do_view:
          %viewPtr = call ptr @MapViewOfFile(ptr %hMap, i32 6, i32 0, i32 0, i64 %size)
          br i1 %noName, label %close_h, label %done
        close_h:
          call i32 @CloseHandle(ptr %hMap)
          br label %done
        done:
          ret ptr %viewPtr
        ret_null:
          ret ptr null
        }

        define internal ptr @zuv_ipc_open_shm(ptr %name, i64 %size) {
        entry:
          %isNameNull = icmp eq ptr %name, null
          br i1 %isNameNull, label %ret_null, label %do_open
        do_open:
          %hMap = call ptr @OpenFileMappingA(i32 6, i32 0, ptr %name)
          %cmpBad = icmp eq ptr %hMap, null
          br i1 %cmpBad, label %ret_null, label %do_view
        do_view:
          %viewPtr = call ptr @MapViewOfFile(ptr %hMap, i32 6, i32 0, i32 0, i64 %size)
          call i32 @CloseHandle(ptr %hMap)
          ret ptr %viewPtr
        ret_null:
          ret ptr null
        }

        define internal double @zuv_ipc_unmap(ptr %ptr) {
        entry:
          %isN = icmp eq ptr %ptr, null
          br i1 %isN, label %ret_zero, label %do_unmap
        do_unmap:
          %res = call i32 @UnmapViewOfFile(ptr %ptr)
          %dres = sitofp i32 %res to double
          ret double %dres
        ret_zero:
          ret double 0.0
        }

        define internal double @zuv_ipc_flush(ptr %ptr, i64 %len) {
        entry:
          %isN = icmp eq ptr %ptr, null
          br i1 %isN, label %ret_zero, label %do_flush
        do_flush:
          %res = call i32 @FlushViewOfFile(ptr %ptr, i64 %len)
          %dres = sitofp i32 %res to double
          ret double %dres
        ret_zero:
          ret double 0.0
        }

        define internal i64 @zuv_ipc_write(ptr %ptr, i64 %offset, ptr %data) {
        entry:
          %cmpP = icmp eq ptr %ptr, null
          %cmpD = icmp eq ptr %data, null
          %cmpOr = or i1 %cmpP, %cmpD
          br i1 %cmpOr, label %ret_zero, label %do_write
        do_write:
          %dst = getelementptr inbounds i8, ptr %ptr, i64 %offset
          %len = call i64 @strlen(ptr %data)
          call ptr @memcpy(ptr %dst, ptr %data, i64 %len)
          ret i64 %len
        ret_zero:
          ret i64 0
        }

        define internal ptr @zuv_ipc_read(ptr %ptr, i64 %offset, i64 %len) {
        entry:
          %cmpP = icmp eq ptr %ptr, null
          %cmpL = icmp sle i64 %len, 0
          %cmpOr = or i1 %cmpP, %cmpL
          br i1 %cmpOr, label %ret_empty, label %do_read
        do_read:
          %allocSz = add i64 %len, 1
          %buf = call ptr @malloc(i64 %allocSz)
          %src = getelementptr inbounds i8, ptr %ptr, i64 %offset
          call ptr @memcpy(ptr %buf, ptr %src, i64 %len)
          %endPtr = getelementptr inbounds i8, ptr %buf, i64 %len
          store i8 0, ptr %endPtr
          ret ptr %buf
        ret_empty:
          ret ptr @empty_str
        }

        define internal ptr @zuv_ipc_read_str(ptr %ptr, i64 %offset) {
        entry:
          %cmpP = icmp eq ptr %ptr, null
          br i1 %cmpP, label %ret_empty, label %do_read
        do_read:
          %src = getelementptr inbounds i8, ptr %ptr, i64 %offset
          %len = call i64 @strlen(ptr %src)
          %allocSz = add i64 %len, 1
          %buf = call ptr @malloc(i64 %allocSz)
          call ptr @memcpy(ptr %buf, ptr %src, i64 %allocSz)
          ret ptr %buf
        ret_empty:
          ret ptr @empty_str
        }

        define internal i64 @zuv_ipc_mutex(ptr %name) {
        entry:
          %h = call ptr @CreateMutexA(ptr null, i32 0, ptr %name)
          %h64 = ptrtoint ptr %h to i64
          ret i64 %h64
        }

        define internal double @zuv_ipc_mutex_lock(i64 %h) {
        entry:
          %rawI64 = and i64 %h, -281474976710657
          %hPtr = inttoptr i64 %rawI64 to ptr
          %res = call i32 @WaitForSingleObject(ptr %hPtr, i32 -1)
          %cmp = icmp eq i32 %res, 0
          %sel = select i1 %cmp, double 1.0, double 0.0
          ret double %sel
        }

        define internal double @zuv_ipc_mutex_trylock(i64 %h) {
        entry:
          %rawI64 = and i64 %h, -281474976710657
          %hPtr = inttoptr i64 %rawI64 to ptr
          %res = call i32 @WaitForSingleObject(ptr %hPtr, i32 0)
          %cmp = icmp eq i32 %res, 0
          %sel = select i1 %cmp, double 1.0, double 0.0
          ret double %sel
        }

        define internal double @zuv_ipc_mutex_unlock(i64 %h) {
        entry:
          %rawI64 = and i64 %h, -281474976710657
          %hPtr = inttoptr i64 %rawI64 to ptr
          %res = call i32 @ReleaseMutex(ptr %hPtr)
          %dres = sitofp i32 %res to double
          ret double %dres
        }

        define internal i64 @zuv_ipc_sem(ptr %name, i32 %init, i32 %max) {
        entry:
          %h = call ptr @CreateSemaphoreA(ptr null, i32 %init, i32 %max, ptr %name)
