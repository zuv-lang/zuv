/*
 * =============================================================================
 * Zuv Bootstrap Compiler — Expression Parser (Pratt Precedence Climber)
 * Path: sub_projects/zuv/src/bootstrap/parser/expr.zv
 * =============================================================================
 *
 * Implements Top-Down Operator Precedence (Pratt) parsing for expressions:
 * - Literals: numbers, strings, template literals, booleans, nil, und, BigInt
 * - Primary expressions: identifiers, array literals `[a, b]`, object literals `{ k: v }`
 * - Unary prefix operators: `-`, `!`, `not`, `~`, `&`, `&let`, `await`
 * - Postfix access: member `.prop`, safe navigation `?.prop`, index `[idx]`, calls `f(a, b)`
 * - Postfix mutations: `x++`, `x--`
 * - Binary arithmetic, bitwise, comparison, logical, and assignment operators
 * - Ternary conditional expressions: `cond ? thenVal : elseVal`
 * - Type casts: `expr as Type`
 */

imp Token, TokenType frm ../tokens
imp ASTNode frm ../ast
imp Parser frm parser

imp ParseArrayLiteral frm expr/parseArrayLiteral
imp ParseObjectLiteral frm expr/parseObjectLiteral
imp ParseTemplateStringExpr frm expr/parseTemplateStringExpr
imp ParseLambda frm expr/parseLambda
imp ParsePrimary frm expr/parsePrimary
imp ParseNewExpr frm expr/parseNewExpr
imp ParsePrefixExpr frm expr/parsePrefixExpr
imp ParseCastType frm expr/parseCastType
imp ParseInfixExpr frm expr/parseInfixExpr

/**
 * Maps a TokenType to its numeric operator precedence level.
 *
 * Higher numeric values bind more tightly than lower values.
 *
 * @param {TokenType} kind - The token kind to evaluate
 * @returns {num} Precedence level from 1 (lowest) to 18 (highest)
 */
GetTokenPrecedence kind: TokenType :: num {
    if kind == TokenType.TOK_ASSIGN || kind == TokenType.TOK_PLUS_EQ || kind == TokenType.TOK_MINUS_EQ ||
       kind == TokenType.TOK_STAR_EQ || kind == TokenType.TOK_SLASH_EQ || kind == TokenType.TOK_PERCENT_EQ ||
       kind == TokenType.TOK_POW_EQ || kind == TokenType.TOK_AMP_EQ || kind == TokenType.TOK_PIPE_EQ || kind == TokenType.TOK_CARET_EQ {
        -> 2
    }
    if kind == TokenType.TOK_QUESTION {
        -> 3
    }
    if kind == TokenType.TOK_NULLISH {
        -> 4
    }
    if kind == TokenType.TOK_OR {
        -> 5
    }
    if kind == TokenType.TOK_AND {
        -> 6
    }
    if kind == TokenType.TOK_PIPE {
        -> 7
    }
    if kind == TokenType.TOK_CARET {
        -> 8
    }
    if kind == TokenType.TOK_AMP {
        -> 9
    }
    if kind == TokenType.TOK_EQ || kind == TokenType.TOK_NOT_EQ {
        -> 10
    }
    if kind == TokenType.TOK_LT || kind == TokenType.TOK_GT || kind == TokenType.TOK_LTE || kind == TokenType.TOK_GTE {
        -> 11
    }
    if kind == TokenType.TOK_SHL || kind == TokenType.TOK_SHR || kind == TokenType.TOK_USHR {
        -> 12
    }
    if kind == TokenType.TOK_PLUS || kind == TokenType.TOK_MINUS {
        -> 13
    }
    if kind == TokenType.TOK_ASTERISK || kind == TokenType.TOK_SLASH || kind == TokenType.TOK_PERCENT {
        -> 14
    }
    if kind == TokenType.TOK_POW {
        -> 15
    }
    if kind == TokenType.TOK_AS {
        -> 16
    }
    if kind == TokenType.TOK_LPAREN || kind == TokenType.TOK_LBRACKET || kind == TokenType.TOK_DOT || kind == TokenType.TOK_OPT_DOT ||
       kind == TokenType.TOK_COLON_COLON || kind == TokenType.TOK_INC || kind == TokenType.TOK_DEC {
        -> 18
    }
    -> 1
}

/**
 * Top-Down Operator Precedence (Pratt) Expression Parser.
 *
 * Climbs operator precedence to construct fully associative AST expressions.
 *
 * @param {Parser} parser - Parser coordinator instance
 * @param {num} minPrec - Minimum precedence boundary to continue climbing
 * @returns {ASTNode} Parsed expression AST node
 */
ParseExpression parser: Parser, minPrec: num :: ASTNode {
    left: ASTNode = ParsePrefixExpr parser

    wh !(parser.isAtEnd) {
        cTokPrec: Token = parser.cur
        curPrec: num = GetTokenPrecedence cTokPrec.kind
        if curPrec <= minPrec {
            brk
        }
        left = ParseInfixExpr parser, left, curPrec
    }

    -> left
}
