/*
 * =============================================================================
 * Zuv Bootstrap Compiler — Expression Parser (Pratt Precedence Climber)
 * Path: sub_projects/zuv/src/bootstrap/parser/expr.zv
 * =============================================================================
 *
 * Implements Top-Down Operator Precedence (Pratt) parsing for expressions:
 * - Literals: numbers, strings, template literals, booleans, nil, und, BigInt
 * - Primary expressions: identifiers, array literals `[a, b]`, object literals `{ k: v }`
 * - Unary prefix operators: `-`, `!`, `not`, `~`, `&`, `&let`, `await`
 * - Postfix access: member `.prop`, safe navigation `?.prop`, index `[idx]`, calls `f(a, b)`
 * - Postfix mutations: `x++`, `x--`
 * - Binary arithmetic, bitwise, comparison, logical, and assignment operators
 * - Ternary conditional expressions: `cond ? thenVal : elseVal`
 * - Type casts: `expr as Type`
 */

imp str, arr
imp Token, TokenType frm ../tokens
imp ASTNode, NodeKind, Param, FieldEntry, MatchArm frm ../ast
imp TypeInfo, TypeKind frm ../types
imp Diagnostic frm ../diagnostics
imp Parser frm parser
imp Lexer frm ../lexer

/**
 * Maps a TokenType to its numeric operator precedence level.
 *
 * Higher numeric values bind more tightly than lower values.
 *
 * @param {TokenType} kind - The token kind to evaluate
 * @returns {num} Precedence level from 1 (lowest) to 18 (highest)
 */
GetTokenPrecedence kind: TokenType :: num {
    if kind == TokenType.TOK_ASSIGN || kind == TokenType.TOK_PLUS_EQ || kind == TokenType.TOK_MINUS_EQ ||
       kind == TokenType.TOK_STAR_EQ || kind == TokenType.TOK_SLASH_EQ || kind == TokenType.TOK_PERCENT_EQ ||
       kind == TokenType.TOK_POW_EQ || kind == TokenType.TOK_AMP_EQ || kind == TokenType.TOK_PIPE_EQ || kind == TokenType.TOK_CARET_EQ {
        -> 2
    }
    if kind == TokenType.TOK_QUESTION {
        -> 3
    }
    if kind == TokenType.TOK_NULLISH {
        -> 4
    }
    if kind == TokenType.TOK_OR {
        -> 5
    }
    if kind == TokenType.TOK_AND {
        -> 6
    }
    if kind == TokenType.TOK_PIPE {
        -> 7
    }
    if kind == TokenType.TOK_CARET {
        -> 8
    }
    if kind == TokenType.TOK_AMP {
        -> 9
    }
    if kind == TokenType.TOK_EQ || kind == TokenType.TOK_NOT_EQ {
        -> 10
    }
    if kind == TokenType.TOK_LT || kind == TokenType.TOK_GT || kind == TokenType.TOK_LTE || kind == TokenType.TOK_GTE {
        -> 11
    }
    if kind == TokenType.TOK_SHL || kind == TokenType.TOK_SHR || kind == TokenType.TOK_USHR {
        -> 12
    }
    if kind == TokenType.TOK_PLUS || kind == TokenType.TOK_MINUS {
        -> 13
    }
    if kind == TokenType.TOK_ASTERISK || kind == TokenType.TOK_SLASH || kind == TokenType.TOK_PERCENT {
        -> 14
    }
    if kind == TokenType.TOK_POW {
        -> 15
    }
    if kind == TokenType.TOK_AS {
        -> 16
    }
    if kind == TokenType.TOK_LPAREN || kind == TokenType.TOK_LBRACKET || kind == TokenType.TOK_DOT || kind == TokenType.TOK_OPT_DOT ||
       kind == TokenType.TOK_COLON_COLON || kind == TokenType.TOK_INC || kind == TokenType.TOK_DEC {
        -> 18
    }
    -> 1
}

/**
 * Parses an array literal expression (`[elem1, elem2, ...]`).
 *
 * @param {Parser} parser - Parser coordinator instance
 * @returns {ASTNode} ArrExpr AST node
 */
ParseArrayLiteral parser: Parser :: ASTNode {
    lbTok: Token = parser.consume TokenType.TOK_LBRACKET, "Expected '['"
    elems: ASTNode[] = []

    wh !(parser.check TokenType.TOK_RBRACKET) && !(parser.isAtEnd) {
        el: ASTNode = ParseExpression parser, 1
        elems.psh el
        if parser.matchToken TokenType.TOK_COMMA {
            // continue parsing next element
        } els {
            brk
        }
    }

    parser.consume TokenType.TOK_RBRACKET, "Expected ']' after array literal"
    node = ASTNode.createBase NodeKind.ArrExpr, lbTok.line, lbTok.col
    node.children = elems
    -> node
}

/**
 * Parses an object literal expression (`{ key: value, field, ... }`).
 *
 * @param {Parser} parser - Parser coordinator instance
 * @returns {ASTNode} ObjLitExpr AST node
 */
ParseObjectLiteral parser: Parser :: ASTNode {
    lbTok: Token = parser.consume TokenType.TOK_LBRACE, "Expected '{'"
    entries: FieldEntry[] = []
    childExprs: ASTNode[] = []

    wh !(parser.check TokenType.TOK_RBRACE) && !(parser.isAtEnd) {
        isSpread: bool = false
        if parser.matchToken TokenType.TOK_ELLIPSIS {
            isSpread = true
        }

        kTok: Token = parser.cur
        parser.advance
        kName: str = kTok.val

        valNode = ASTNode.createNil kTok.line, kTok.col
        if parser.matchToken TokenType.TOK_COLON {
            valNode = ParseExpression parser, 1
        } els {
            // Shorthand field: { x } => { x: x }
            valNode = ASTNode.createIdent kName, kTok.line, kTok.col
        }

        entry: FieldEntry = {
            name: kName,
            valStr: kName,
            isSpread: isSpread,
            line: kTok.line,
            col: kTok.col
        }
        entries.psh entry
        childExprs.psh valNode

        if (parser.matchToken TokenType.TOK_COMMA) || (parser.matchToken TokenType.TOK_SEMICOLON) {
            // optional separator
        } els {
            brk
        }
    }

    parser.consume TokenType.TOK_RBRACE, "Expected '}' after object literal"
    node = ASTNode.createBase NodeKind.ObjLitExpr, lbTok.line, lbTok.col
    node.fields = entries
    node.children = childExprs
    -> node
}

ParseTemplateStringExpr parser: Parser, raw: str, line: num, col: num :: ASTNode {
    hasInterp: bool = false
    i: num = 0
    rawLen: num = raw.ln
    wh (i + 1 < rawLen) {
        if raw[i] == "$" && raw[i + 1] == "{" {
            hasInterp = true
            brk
        }
        i++
    }
    if !hasInterp {
        -> ASTNode.createStr raw, line, col
    }

    parts: ASTNode[] = []
    i = 0
    curText: str = ""
    wh i < rawLen {
        if raw[i] == "$" && (i + 1 < rawLen) && raw[i + 1] == "{" {
            if curText.ln > 0 {
                parts.psh (ASTNode.createStr curText, line, col)
                curText = ""
            }
            i = i + 2
            startExpr: num = i
            braceDepth: num = 1
            wh (i < rawLen) && (braceDepth > 0) {
                ch: str = raw[i]
                if ch == "{" {
                    braceDepth++
                } els if ch == "}" {
                    braceDepth--
                    if braceDepth == 0 {
                        brk
                    }
                }
                i++
            }
            exprStr: str = raw.slc startExpr, i
            if (i < rawLen) && (raw[i] == "}") {
                i++
            }
            if exprStr.ln > 0 {
                subLex = Lexer.create exprStr
                subTokens: Token[] = subLex.tokenizeAll
                subParser: Parser = Parser.create subTokens, parser.file, parser.source
                subNode: ASTNode = ParseExpression subParser, 0
                parts.psh subNode
            }
        } els {
            curText = curText + raw[i]
            i++
        }
    }
    if curText.ln > 0 {
        parts.psh (ASTNode.createStr curText, line, col)
    }

    if parts.ln == 0 {
        -> ASTNode.createStr "", line, col
    }
    if parts.ln == 1 {
        -> parts[0]
    }

    resNode: ASTNode = parts[0]
    pIdx: num = 1
    wh pIdx < parts.ln {
        resNode = ASTNode.createBinary "+", resNode, parts[pIdx], line, col
        pIdx++
    }
    -> resNode
}

/**
 * Parses an anonymous lambda expression and hoists it as a synthesized function.
 *
 * @param {Parser} parser - Parser coordinator instance
 * @param {str[]} paramNames - Parameter name identifiers
 * @param {num} line - Source line number
 * @param {num} col - Source column number
 * @returns {ASTNode} Identifier AST node referencing the synthesized function
 */
ParseLambda parser: Parser, paramNames: str[], line: num, col: num :: ASTNode {
    lambdaId: num = parser.lambdaCounter
    parser.lambdaCounter = lambdaId + 1
    lambdaName: str = "__lambda_" + lambdaId

    params: Param[] = []
    cleanNames: str[] = []
    fr pName of paramNames {
        isRest: bool = false
        cleanName: str = pName
        if pName.ln >= 3 && pName[0] == "." && pName[1] == "." && pName[2] == "." {
            isRest = true
            cleanName = pName.sub 3, (pName.ln - 3)
        }
        p: Param = {
            name: cleanName,
            typeAnnotation: "",
            isRest,
            isOptional: false,
            line,
            col
        }
        params.psh p
        cleanNames.psh cleanName
    }

    parser.enterScope()
    fr cName of cleanNames {
        parser.addVar cName
    }

    bodyBlock: ASTNode = ASTNode.createBlock [], line, col
    if parser.check TokenType.TOK_LBRACE {
        isObjLit: bool = false
        if parser.checkPeek TokenType.TOK_RBRACE {
            isObjLit = true
        } els if parser.checkPeek TokenType.TOK_IDENT {
            t2: Token = parser.peekAhead 2
            if t2.kind == TokenType.TOK_COLON {
                isObjLit = true
            }
        }

        if isObjLit {
            objExpr: ASTNode = ParseObjectLiteral parser
            retNode: ASTNode = ASTNode.createRet objExpr, objExpr.line, objExpr.col
            bodyBlock = ASTNode.createBlock [retNode], objExpr.line, objExpr.col
        } els {
            parser.consume TokenType.TOK_LBRACE, "Expected '{'"
            stmts: ASTNode[] = []
            wh !(parser.check TokenType.TOK_RBRACE) && !(parser.isAtEnd) {
                if parser.matchToken TokenType.TOK_SEMICOLON {
                    cont
                }
                cTok: Token = parser.cur
                pTok: Token = parser.peek
                if cTok.kind == TokenType.TOK_IDENT && pTok.kind == TokenType.TOK_ASSIGN && !(parser.hasVar cTok.val) {
                    nameTok: Token = parser.advance
                    parser.advance // consume '='
                    initVal: ASTNode = ParseExpression parser, 1
                    parser.addVar nameTok.val
                    emptyType: str = ""
                    stmts.psh (ASTNode.createVarDecl nameTok.val, emptyType, false, initVal, nameTok.line, nameTok.col)
                    if parser.matchToken TokenType.TOK_SEMICOLON {
                        // optional delimiter
                    }
                    cont
                }
                if cTok.kind == TokenType.TOK_RET || cTok.kind == TokenType.TOK_ARROW {
                    rTok: Token = parser.advance
                    rExpr: ASTNode = ParseExpression parser, 1
                    stmts.psh (ASTNode.createRet rExpr, rTok.line, rTok.col)
                    if parser.matchToken TokenType.TOK_SEMICOLON {
                        // optional delimiter
                    }
                    cont
                }
                if cTok.kind == TokenType.TOK_WH {
                    whTok: Token = parser.advance
                    condNode: ASTNode = ParseExpression parser, 1
                    whBlock: ASTNode = ASTNode.createBlock [], whTok.line, whTok.col
                    if parser.check TokenType.TOK_LBRACE {
                        parser.advance
                        whStmts: ASTNode[] = []
                        wh !(parser.check TokenType.TOK_RBRACE) && !(parser.isAtEnd) {
                            if parser.matchToken TokenType.TOK_SEMICOLON {
                                cont
                            }
                            whStmtExpr: ASTNode = ParseExpression parser, 1
                            whStmts.psh (ASTNode.createExprStmt whStmtExpr, whStmtExpr.line, whStmtExpr.col)
                            if parser.matchToken TokenType.TOK_SEMICOLON {
                                // optional delimiter
                            }
                        }
                        parser.consume TokenType.TOK_RBRACE, "Expected '}' after while body"
                        whBlock = ASTNode.createBlock whStmts, whTok.line, whTok.col
                    }
                    nodeWh: ASTNode = ASTNode.createBase NodeKind.WhStmt, whTok.line, whTok.col
                    nodeWh.children = [condNode, whBlock]
                    stmts.psh nodeWh
                    cont
                }
                sExpr: ASTNode = ParseExpression parser, 1
                stmts.psh (ASTNode.createExprStmt sExpr, sExpr.line, sExpr.col)
                if parser.matchToken TokenType.TOK_SEMICOLON {
                    // optional delimiter
                }
            }
            parser.consume TokenType.TOK_RBRACE, "Expected '}'"
            bodyBlock = ASTNode.createBlock stmts, line, col
        }
    } els {
        curLTok: Token = parser.cur
        if curLTok.line > line {
            indentCol: num = curLTok.col
            stmts: ASTNode[] = []
            wh !(parser.isAtEnd) && !(parser.check TokenType.TOK_RBRACE) && !(parser.check TokenType.TOK_RPAREN) && !(parser.check TokenType.TOK_RBRACKET) {
                pTok: Token = parser.cur
                if pTok.line > line && pTok.col < indentCol {
                    brk
                }
                stmtNode: ASTNode = ParseStatement parser
                stmts.psh stmtNode
                nextTok: Token = parser.cur
                if nextTok.line > pTok.line && nextTok.col < indentCol {
                    brk
                }
            }
            if stmts.ln > 0 {
                lastIdx: num = stmts.ln - 1
                lastNode: ASTNode = stmts[lastIdx]
                if lastNode.kind == NodeKind.ExprStmt && lastNode.children.ln > 0 {
                    stmts[lastIdx] = ASTNode.createRet lastNode.children[0], lastNode.line, lastNode.col
                }
                bodyBlock = ASTNode.createBlock stmts, line, col
            } els {
                nilNode: ASTNode = ASTNode.createNil line, col
                retNode: ASTNode = ASTNode.createRet nilNode, line, col
                bodyBlock = ASTNode.createBlock [retNode], line, col
            }
        } els {
            sExpr: ASTNode = ParseExpression parser, 1
            retNode: ASTNode = ASTNode.createRet sExpr, sExpr.line, sExpr.col
            bodyBlock = ASTNode.createBlock [retNode], line, col
        }
    }

    parser.exitScope()

    lambdaFunc: ASTNode = ASTNode.createFuncDecl lambdaName, "", false, false, line, col
    lambdaFunc.params = params
    lambdaFunc.val = parser.curFuncName
    lambdaFunc.children.psh bodyBlock

    parser.lambdas.psh lambdaFunc

    identNode: ASTNode = ASTNode.createIdent lambdaName, line, col
    -> identNode
}

/**
 * Parses a primary atom expression (literal, identifier, grouped, array, or object literal).
 *
 * @param {Parser} parser - Parser coordinator instance
 * @returns {ASTNode} Primary AST node
 */
ParsePrimary parser: Parser :: ASTNode {
    tok: Token = parser.cur

    // Numeric Literals
    if tok.kind == TokenType.TOK_NUMBER {
        numTok: Token = parser.advance
        numNode = ASTNode.createNum 0, numTok.line, numTok.col
        numNode.val = numTok.val
        -> numNode
    }

    // BigInt Literals
    if tok.kind == TokenType.TOK_BIGINT {
        biTok: Token = parser.advance
        -> ASTNode.createBigInt biTok.val, biTok.line, biTok.col
    }

    // String Literals
    if tok.kind == TokenType.TOK_STRING {
        strTok: Token = parser.advance
        -> ASTNode.createStr strTok.val, strTok.line, strTok.col
    }

    // Template Literals
    if tok.kind == TokenType.TOK_TEMPLATE_STRING {
        strTok: Token = parser.advance
        -> ParseTemplateStringExpr parser, strTok.val, strTok.line, strTok.col
    }

    // Booleans & Nil / Und
    if tok.kind == TokenType.TOK_TRUE {
        if parser.hasVar tok.val {
            idTok: Token = parser.advance
            -> ASTNode.createIdent idTok.val, idTok.line, idTok.col
        }
        bTok: Token = parser.advance
        -> ASTNode.createBool true, bTok.line, bTok.col
    }
    if tok.kind == TokenType.TOK_FALSE {
        if parser.hasVar tok.val {
            idTok: Token = parser.advance
            -> ASTNode.createIdent idTok.val, idTok.line, idTok.col
        }
        bTok: Token = parser.advance
        -> ASTNode.createBool false, bTok.line, bTok.col
    }
    if tok.kind == TokenType.TOK_NIL {
        nTok: Token = parser.advance
        -> ASTNode.createNil nTok.line, nTok.col
    }
    if tok.kind == TokenType.TOK_UND {
        uTok: Token = parser.advance
        -> ASTNode.createUnd uTok.line, uTok.col
    }

    // Arrow Lambdas: x => expr or fn => expr
    peekTok: Token = parser.peek
    if (tok.kind == TokenType.TOK_IDENT || tok.kind == TokenType.TOK_FN) && peekTok.kind == TokenType.TOK_FAT_ARROW {
        pTok: Token = parser.advance
        parser.advance // consume '=>'
        -> ParseLambda parser, [pTok.val], pTok.line, pTok.col
    }

    // Identifiers & Variable References / Built-in Names
    if tok.kind == TokenType.TOK_IDENT || tok.kind == TokenType.TOK_FN || tok.kind == TokenType.TOK_PRNT ||
       tok.kind == TokenType.TOK_LOG || tok.kind == TokenType.TOK_WARN ||
       tok.kind == TokenType.TOK_INFO || tok.kind == TokenType.TOK_PANIC ||
       tok.kind == TokenType.TOK_SIZEOF || tok.kind == TokenType.TOK_SZ ||
       tok.kind == TokenType.TOK_ERR || tok.kind == TokenType.TOK_OK ||
       tok.kind == TokenType.TOK_NAN || tok.kind == TokenType.TOK_INFINITY {
        idTok: Token = parser.advance
        idName: str = idTok.val
        if idTok.kind == TokenType.TOK_OK {
            idName = "result_ok"
        } els if idTok.kind == TokenType.TOK_ERR && (parser.check TokenType.TOK_LPAREN) {
            idName = "result_err"
        }
        identNode = ASTNode.createIdent idName, idTok.line, idTok.col

        curTok: Token = parser.cur
        isMathUnary: bool = (idTok.val == "abs" || idTok.val == "ceil" || idTok.val == "floor" ||
                             idTok.val == "round" || idTok.val == "trunc" || idTok.val == "sqrt" ||
                             idTok.val == "sin" || idTok.val == "cos" || idTok.val == "tan" ||
                             idTok.val == "asin" || idTok.val == "acos" || idTok.val == "atan" ||
                             idTok.val == "log" || idTok.val == "exp" ||
                             idTok.val == "isNan" || idTok.val == "isFin")
        allowMinusArg: bool = isMathUnary && curTok.kind == TokenType.TOK_MINUS
        if !parser.isAtEnd && curTok.line == idTok.line &&
           (curTok.kind == TokenType.TOK_NUMBER || curTok.kind == TokenType.TOK_STRING ||
            curTok.kind == TokenType.TOK_TEMPLATE_STRING || curTok.kind == TokenType.TOK_TRUE ||
            curTok.kind == TokenType.TOK_FALSE || curTok.kind == TokenType.TOK_NIL ||
            curTok.kind == TokenType.TOK_UND || curTok.kind == TokenType.TOK_IDENT || curTok.kind == TokenType.TOK_FN ||
            curTok.kind == TokenType.TOK_NAN || curTok.kind == TokenType.TOK_INFINITY || curTok.kind == TokenType.TOK_INFO ||
            curTok.kind == TokenType.TOK_ELLIPSIS || allowMinusArg) {
            argPrec: num = 1
            if idTok.val != "prnt" && idTok.val != "lg" && idTok.val != "wrn" && idTok.val != "panic" {
                argPrec = 12
            }
            args: ASTNode[] = []
            wh true {
                argExpr: ASTNode = ParseExpression parser, argPrec
                args.psh argExpr
                if parser.matchToken TokenType.TOK_COMMA {
                    // continue
                } els {
                    brk
                }
            }
            -> ASTNode.createCall identNode, args, idTok.line, idTok.col
        }

        // Check if typed struct literal: Point{ x: 1, y: 2 }
        if parser.check TokenType.TOK_LBRACE {
            isObjLit: bool = false
            if (parser.checkPeek TokenType.TOK_RBRACE) || (parser.checkPeek TokenType.TOK_ELLIPSIS) {
                isObjLit = true
            } els if parser.checkPeek TokenType.TOK_IDENT {
                t2: Token = parser.peekAhead 2
                if t2.kind == TokenType.TOK_COLON || t2.kind == TokenType.TOK_COMMA || t2.kind == TokenType.TOK_RBRACE {
                    isObjLit = true
                }
            }
            if isObjLit {
                objExpr: ASTNode = ParseObjectLiteral parser
                objExpr.name = idTok.val
                -> objExpr
            }
        }

        // Check if zero-argument function call shorthand
        if parser.isZeroArgFunc idTok.val {
            if parser.isAtEnd || curTok.line != idTok.line ||
               curTok.kind == TokenType.TOK_SEMICOLON || curTok.kind == TokenType.TOK_RBRACE ||
               curTok.kind == TokenType.TOK_RPAREN || curTok.kind == TokenType.TOK_COMMA {
                emptyArgs: ASTNode[] = []
                -> ASTNode.createCall identNode, emptyArgs, idTok.line, idTok.col
            }
        }

        -> identNode
    }

    // Array Literals: [1, 2, 3]
    if tok.kind == TokenType.TOK_LBRACKET {
        -> ParseArrayLiteral parser
    }

    // Object Literals: { x: 1, y: 2 }
    if tok.kind == TokenType.TOK_LBRACE {
        -> ParseObjectLiteral parser
    }

    // Parenthesized Expressions & Parameterized Arrow Lambdas: (a, b) => expr
    if tok.kind == TokenType.TOK_LPAREN {
        // Look ahead for (params) =>
        isLambda: bool = false
        off: num = 1
        wh true {
            tAhead: Token = parser.peekAhead off
            if tAhead.kind == TokenType.TOK_EOF || tAhead.kind == TokenType.TOK_SEMICOLON {
                brk
            }
            if tAhead.kind == TokenType.TOK_RPAREN {
                nextAfterParen: Token = parser.peekAhead (off + 1)
                if nextAfterParen.kind == TokenType.TOK_FAT_ARROW {
                    isLambda = true
                }
                brk
            }
            off = off + 1
        }

        if isLambda {
            parser.advance // consume '('
            paramNames: str[] = []
            wh !(parser.check TokenType.TOK_RPAREN) && !(parser.isAtEnd) {
                pTok: Token = parser.cur
                if pTok.kind == TokenType.TOK_IDENT || pTok.kind == TokenType.TOK_FN {
                    paramNames.psh pTok.val
                    parser.advance
                } els {
                    pTok = parser.consume TokenType.TOK_IDENT, "Expected parameter identifier"
                }
                if parser.matchToken TokenType.TOK_COMMA {
                    cont
                } els {
                    brk
                }
            }
            parser.consume TokenType.TOK_RPAREN, "Expected ')' after lambda parameter list"
            parser.consume TokenType.TOK_FAT_ARROW, "Expected '=>' after lambda parameter list"
            -> ParseLambda parser, paramNames, tok.line, tok.col
        }

        parser.advance // consume '('
        inner: ASTNode = ParseExpression parser, 1
        parser.consume TokenType.TOK_RPAREN, "Expected ')' after grouped expression"
        -> inner
    }

    // Fallback error recovery
    errTok: Token = parser.advance
    parser.addError "E0101", "Expected valid expression, got " + errTok.val, errTok.line, errTok.col, errTok.len, "expected expression"
    -> ASTNode.createIdent errTok.val, errTok.line, errTok.col
}

/**
 * Parses a 'new' instantiation expression (`new TypeName(...)`, `new TypeName{...}`, `new Prm ...`).
 *
 * @param {Parser} parser - Parser coordinator instance
 * @returns {ASTNode} NewExpr AST node
 */
ParseNewExpr parser: Parser :: ASTNode {
    newTok: Token = parser.advance // consume 'new'
    nameTok: Token = parser.consume TokenType.TOK_IDENT, "Expected type name after 'new'"
    typeName: str = nameTok.val

    if parser.check TokenType.TOK_LBRACE {
        objExpr: ASTNode = ParseObjectLiteral parser
        -> ASTNode.createNew typeName, [objExpr], newTok.line, newTok.col
    }

    if parser.matchToken TokenType.TOK_LPAREN {
        args: ASTNode[] = []
        wh !(parser.check TokenType.TOK_RPAREN) && !(parser.isAtEnd) {
            arg: ASTNode = ParseExpression parser, 1
            args.psh arg
            if parser.matchToken TokenType.TOK_COMMA {
                cont
            } els {
                brk
            }
        }
        parser.consume TokenType.TOK_RPAREN, "Expected ')' after constructor arguments"
        -> ASTNode.createNew typeName, args, newTok.line, newTok.col
    }

    // Check for lambda parameter list followed by =>: param1, param2 => body
    isLambda: bool = false
    off: num = 0
    curLTok: Token = parser.cur
    curL: num = curLTok.line
    wh true {
        tAhead: Token = parser.peekAhead off
        if tAhead.kind == TokenType.TOK_EOF || tAhead.kind == TokenType.TOK_SEMICOLON || tAhead.line != curL {
            brk
        }
        if tAhead.kind == TokenType.TOK_FAT_ARROW {
            isLambda = true
            brk
        }
        off = off + 1
    }

    if isLambda {
        paramNames: str[] = []
        wh true {
            pTokParam: Token = parser.cur
            if pTokParam.kind == TokenType.TOK_IDENT || pTokParam.kind == TokenType.TOK_FN {
                paramNames.psh pTokParam.val
                parser.advance
                if parser.matchToken TokenType.TOK_COMMA {
                    cont
                } els {
                    brk
                }
            } els {
                brk
            }
        }
        arrowTok: Token = parser.consume TokenType.TOK_FAT_ARROW, "Expected '=>' after lambda parameters"
        lambdaNode: ASTNode = ParseLambda parser, paramNames, nameTok.line, nameTok.col
        -> ASTNode.createNew typeName, [lambdaNode], newTok.line, newTok.col
    }

    // Check for juxtaposed constructor arguments on the same line: new User "Charlie", 42
    cTok: Token = parser.cur
    if !parser.isAtEnd && cTok.line == nameTok.line &&
       cTok.kind != TokenType.TOK_SEMICOLON && cTok.kind != TokenType.TOK_RBRACE &&
       cTok.kind != TokenType.TOK_RPAREN && cTok.kind != TokenType.TOK_RBRACKET &&
       cTok.kind != TokenType.TOK_COMMA && cTok.kind != TokenType.TOK_ASSIGN &&
       cTok.kind != TokenType.TOK_DOT && cTok.kind != TokenType.TOK_COLON &&
       cTok.kind != TokenType.TOK_FAT_ARROW {
        args: ASTNode[] = []
        wh true {
            argExpr: ASTNode = ParseExpression parser, 1
            args.psh argExpr
            if parser.matchToken TokenType.TOK_COMMA {
                cont
            } els {
                brk
            }
        }
        -> ASTNode.createNew typeName, args, newTok.line, newTok.col
    }

    -> ASTNode.createNew typeName, [], newTok.line, newTok.col
}

/**
 * Parses prefix unary expressions (`!x`, `-x`, `~x`, `&x`, `await x`, `new T`).
 *
 * @param {Parser} parser - Parser coordinator instance
 * @returns {ASTNode} Unary or primary expression AST node
 */
ParsePrefixExpr parser: Parser :: ASTNode {
    tok: Token = parser.cur

    if tok.kind == TokenType.TOK_NEW {
        -> ParseNewExpr parser
    }

    if tok.kind == TokenType.TOK_NOT || tok.kind == TokenType.TOK_MINUS || tok.kind == TokenType.TOK_TILDE {
        opTok: Token = parser.advance
        operand: ASTNode = ParseExpression parser, 17 // PREC_PREFIX
        -> ASTNode.createUnary opTok.val, operand, true, opTok.line, opTok.col
    }

    if tok.kind == TokenType.TOK_INC || tok.kind == TokenType.TOK_DEC {
        opTok: Token = parser.advance
        operand: ASTNode = ParseExpression parser, 17 // PREC_PREFIX
        -> ASTNode.createUnary opTok.val, operand, true, opTok.line, opTok.col
    }

    if tok.kind == TokenType.TOK_AMP || tok.kind == TokenType.TOK_AMP_LET {
        opTok: Token = parser.advance
        operand: ASTNode = ParseExpression parser, 17 // PREC_PREFIX
        node = ASTNode.createBase NodeKind.BorrowExpr, opTok.line, opTok.col
        node.isBorrow = true
        node.children = [operand]
        -> node
    }

    if tok.kind == TokenType.TOK_AWAIT {
        awTok: Token = parser.advance
        target: ASTNode = ParseExpression parser, 17 // PREC_PREFIX
        -> ASTNode.createAwait target, awTok.line, awTok.col
    }

    if tok.kind == TokenType.TOK_TYP {
        typTok: Token = parser.advance
        target: ASTNode = ParseExpression parser, 17 // PREC_PREFIX
        node = ASTNode.createBase NodeKind.TypExpr, typTok.line, typTok.col
        node.children = [target]
        -> node
    }

    if tok.kind == TokenType.TOK_SYM {
        symTok: Token = parser.advance
        target: ASTNode = ParseExpression parser, 17 // PREC_PREFIX
        node = ASTNode.createBase NodeKind.SymExpr, symTok.line, symTok.col
        node.children = [target]
        node.typeAnnotation = "sym"
        -> node
    }

    if tok.kind == TokenType.TOK_ELLIPSIS {
        opTok: Token = parser.advance
        pNext: Token = parser.cur
        pAfter: Token = parser.peek
        if (pNext.kind == TokenType.TOK_IDENT || pNext.kind == TokenType.TOK_FN) && pAfter.kind == TokenType.TOK_FAT_ARROW {
            paramName: str = "..." + pNext.val
            parser.advance
            parser.advance
            -> ParseLambda parser, [paramName], opTok.line, opTok.col
        }
        operand: ASTNode = ParseExpression parser, 17 // PREC_PREFIX
        -> ASTNode.createUnary opTok.val, operand, true, opTok.line, opTok.col
    }

    -> ParsePrimary parser
}

/**
 * Parses a target type name in an 'as' cast expression.
 *
 * Handles primitive type keywords (num, str, bool, void), custom types/identifiers,
 * pointer prefixes (*, &), and array suffixes ([]).
 *
 * @param {Parser} parser - Parser coordinator instance
 * @returns {str} The parsed type signature string
 */
ParseCastType parser: Parser :: str {
    prefix: str = ""
    wh parser.matchToken TokenType.TOK_ASTERISK {
        prefix = prefix + "*"
    }
    if prefix.ln == 0 && parser.matchToken TokenType.TOK_AMP {
        prefix = "&"
    }

    curTok: Token = parser.cur
    baseType: str = ""
    if curTok.kind == TokenType.TOK_IDENT || curTok.kind == TokenType.TOK_TYPE_NUM ||
       curTok.kind == TokenType.TOK_TYPE_STR || curTok.kind == TokenType.TOK_TYPE_BOOL ||
       curTok.kind == TokenType.TOK_TYPE_VOID {
        baseType = curTok.val
        parser.advance
    } els {
        parser.addError("E0102", "Expected type name after 'as'", curTok.line, curTok.col, curTok.len, "expected token")
        -> ""
    }

    wh parser.check TokenType.TOK_LBRACKET {
        if parser.checkPeek TokenType.TOK_RBRACKET {
            parser.advance
            parser.advance
            baseType = baseType + "[]"
        } els {
            brk
        }
    }

    if prefix.ln > 0 {
        -> prefix + baseType
    }
    -> baseType
}

/**
 * Parses postfix operations and binary infix expressions using Pratt precedence climbing.
 *
 * Handles calls `f(x)`, indexing `a[i]`, property access `o.p`, safe navigation `o?.p`,
 * postfix `++`/`--`, binary arithmetic/bitwise/logical, ternary `? :`, and casts `as Type`.
 *
 * @param {Parser} parser - Parser coordinator instance
 * @param {ASTNode} left - Left-hand side operand node
 * @param {num} prec - Current operator precedence level
 * @returns {ASTNode} Combined expression AST node
 */
ParseInfixExpr parser: Parser, left: ASTNode, prec: num :: ASTNode {
    opTok: Token = parser.cur

    // Postfix Call: callee(arg1, arg2)
    if opTok.kind == TokenType.TOK_LPAREN {
        parser.advance // consume '('
        args: ASTNode[] = []
        wh !(parser.check TokenType.TOK_RPAREN) && !(parser.isAtEnd) {
            arg: ASTNode = ParseExpression parser, 1
            args.psh arg
            if parser.matchToken TokenType.TOK_COMMA {
                // continue parsing next argument
            } els {
                brk
            }
        }
        parser.consume TokenType.TOK_RPAREN, "Expected ')' after call arguments"
        if left.kind == NodeKind.PropExpr {
            target = left.children[0]
            if target.kind == NodeKind.IdentExpr && (target.name == "fs" || target.name == "net" || target.name == "os" || target.name == "sys" || target.name == "io" || target.name == "Prm" || target.name == "Promise" || target.name == "mth" || target.name == "Math") {
                cName: str = target.name + "." + left.name
                calleeNode = ASTNode.createIdent cName, left.line, left.col
                -> ASTNode.createCall calleeNode, args, left.line, left.col
            }
            -> ASTNode.createMethodCall target, left.name, args, left.line, left.col
        }
        -> ASTNode.createCall left, args, left.line, left.col
    }

    // Postfix Index: target[index]
    if opTok.kind == TokenType.TOK_LBRACKET {
        parser.advance // consume '['
        idxExpr: ASTNode = ParseExpression parser, 1
        parser.consume TokenType.TOK_RBRACKET, "Expected ']' after index expression"
        -> ASTNode.createIndex left, idxExpr, left.line, left.col
    }

    // Postfix Member Access: target.property or target::property
    if opTok.kind == TokenType.TOK_DOT || opTok.kind == TokenType.TOK_COLON_COLON {
        parser.advance // consume '.' or '::'
        propTok: Token = parser.cur
        if propTok.kind == TokenType.TOK_IDENT || propTok.isKeyword {
            parser.advance
        } els {
            parser.consume TokenType.TOK_IDENT, "Expected property name after '.'"
        }
        propNode = ASTNode.createBase NodeKind.PropExpr, propTok.line, propTok.col
        propNode.name = propTok.val
        propNode.children = [left]

        curTok: Token = parser.cur
        isConstProp: bool = (left.name == "mth" || left.name == "Math") && (propTok.val == "PI" || propTok.val == "E" || propTok.val == "SQRT2" || propTok.val == "rand")
        isOpAfter: bool = curTok.kind != TokenType.TOK_MINUS && curTok.kind != TokenType.TOK_NOT && (IsOperator curTok.kind)
        allowBracket: bool = (left.name == "Prm" || left.name == "Promise")
        if left.kind == NodeKind.IdentExpr && !isConstProp && (left.name == "fs" || left.name == "net" || left.name == "os" || left.name == "sys" || left.name == "io" || left.name == "Prm" || left.name == "Promise" || left.name == "mem" || left.name == "ffi" || left.name == "mth" || left.name == "Math" || left.name == "dns" || left.name == "http" || left.name == "ws" || left.name == "ipc" || left.name == "time" || left.name == "term" || left.name == "pty") {
            if !parser.isAtEnd && curTok.line == propTok.line && !isOpAfter &&
               curTok.kind != TokenType.TOK_SEMICOLON && curTok.kind != TokenType.TOK_EOF &&
               curTok.kind != TokenType.TOK_RPAREN && curTok.kind != TokenType.TOK_RBRACE &&
               curTok.kind != TokenType.TOK_COMMA && curTok.kind != TokenType.TOK_ASSIGN &&
               curTok.kind != TokenType.TOK_LPAREN && (!allowBracket ? curTok.kind != TokenType.TOK_LBRACKET : true) &&
               curTok.kind != TokenType.TOK_DOT && curTok.kind != TokenType.TOK_FAT_ARROW {
                args: ASTNode[] = []
                wh true {
                    argExpr: ASTNode = ParseExpression parser, 1
                    args.psh argExpr
                    if parser.matchToken TokenType.TOK_COMMA {
                        // continue
                    } els {
                        brk
                    }
                }
                cName: str = left.name + "." + propTok.val
                calleeNode = ASTNode.createIdent cName, propTok.line, propTok.col
                -> ASTNode.createCall calleeNode, args, propTok.line, propTok.col
            }
        }

        curTok: Token = parser.cur
        if !parser.isAtEnd && curTok.line == propTok.line &&
           (curTok.kind == TokenType.TOK_NUMBER || curTok.kind == TokenType.TOK_STRING ||
            curTok.kind == TokenType.TOK_TEMPLATE_STRING || curTok.kind == TokenType.TOK_TRUE ||
            curTok.kind == TokenType.TOK_FALSE || curTok.kind == TokenType.TOK_NIL ||
            curTok.kind == TokenType.TOK_UND || curTok.kind == TokenType.TOK_IDENT ||
            curTok.kind == TokenType.TOK_ELLIPSIS) {
            args: ASTNode[] = []
            wh true {
                argExpr: ASTNode = ParseExpression parser, 1
                args.psh argExpr
                if parser.matchToken TokenType.TOK_COMMA {
                    // continue
                } els {
                    brk
                }
            }
            -> ASTNode.createMethodCall left, propTok.val, args, propTok.line, propTok.col
        }

        -> propNode
    }

    // Postfix Safe Navigation: target?.property or target?.[index]
    if opTok.kind == TokenType.TOK_OPT_DOT {
        parser.advance // consume '?.'
        if parser.check TokenType.TOK_LBRACKET {
            parser.advance // consume '['
            idxExpr: ASTNode = ParseExpression parser, 1
            parser.consume TokenType.TOK_RBRACKET, "Expected ']' after index expression"
            idxNode = ASTNode.createIndex left, idxExpr, opTok.line, opTok.col
            idxNode.op = "?."
            -> idxNode
        }
        propTok: Token = parser.cur
        if propTok.kind == TokenType.TOK_IDENT || propTok.isKeyword {
            parser.advance
        } els {
            parser.consume TokenType.TOK_IDENT, "Expected property name after '?.'"
        }
        propNode = ASTNode.createBase NodeKind.PropExpr, propTok.line, propTok.col
        propNode.name = propTok.val
        propNode.op = "?."
        propNode.children = [left]
        -> propNode
    }

    // Postfix Increment / Decrement: x++, x--
    if opTok.kind == TokenType.TOK_INC {
        parser.advance
        -> ASTNode.createUnary "++", left, false, opTok.line, opTok.col
    }
    if opTok.kind == TokenType.TOK_DEC {
        parser.advance
        -> ASTNode.createUnary "--", left, false, opTok.line, opTok.col
    }

    // Type Cast: expr as Type
    if opTok.kind == TokenType.TOK_AS {
        parser.advance // consume 'as'
        castType: str = ParseCastType parser
        -> ASTNode.createCast left, castType, opTok.line, opTok.col
    }

    // Ternary Conditional: cond ? thenVal : elseVal
    if opTok.kind == TokenType.TOK_QUESTION {
        parser.advance // consume '?'
        thenExpr: ASTNode = ParseExpression parser, 1
        parser.consume TokenType.TOK_COLON, "Expected ':' in ternary conditional"
        elseExpr: ASTNode = ParseExpression parser, 3 // PREC_TERNARY
        -> ASTNode.createTernary left, thenExpr, elseExpr, opTok.line, opTok.col
    }

    // Binary Infix Operations (+, -, *, /, %, ==, !=, <, >, <=, >=, &&, ||, ??, =, +=, -=, etc.)
    parser.advance // consume binary operator
    nextMinPrec: num = prec
    // Right-associative operators (assignment, pow) keep the same precedence level
    if opTok.kind == TokenType.TOK_ASSIGN || opTok.kind == TokenType.TOK_POW ||
       opTok.kind == TokenType.TOK_PLUS_EQ || opTok.kind == TokenType.TOK_MINUS_EQ {
        nextMinPrec = prec - 1
    }

    right: ASTNode = ParseExpression parser, nextMinPrec
    -> ASTNode.createBinary opTok.val, left, right, opTok.line, opTok.col
}

/**
 * Top-Down Operator Precedence (Pratt) Expression Parser.
 *
 * Climbs operator precedence to construct fully associative AST expressions.
 *
 * @param {Parser} parser - Parser coordinator instance
 * @param {num} minPrec - Minimum precedence boundary to continue climbing
 * @returns {ASTNode} Parsed expression AST node
 */
ParseExpression parser: Parser, minPrec: num :: ASTNode {
    left: ASTNode = ParsePrefixExpr parser

    wh !(parser.isAtEnd) {
        cTokPrec: Token = parser.cur
        curPrec: num = GetTokenPrecedence cTokPrec.kind
        if curPrec <= minPrec {
            brk
        }
        left = ParseInfixExpr parser, left, curPrec
    }

    -> left
}
