/*
 * =============================================================================
 * Zuv Bootstrap Compiler — Declaration Parser
 * Path: sub_projects/zuv/src/bootstrap/parser/decl.zv
 * =============================================================================
 *
 * Implements recursive descent parsing for top-level declarations:
 * - TypeScript-style `type Name = { ... };` schemas and type aliases
 * - Object definitions `obj Name { ... }` with methods and fields
 * - Function declarations `fn name params [:: Ret] { ... }` and `name => expr`
 * - Enumerations `enum Name { Variant1, Variant2 }`
 * - Foreign function interfaces `extern "lib" { ... }`
 * - Module imports `imp a, b frm path` and `imp os, fs`
 */

imp str, arr
imp Token, TokenType frm ../tokens
imp ASTNode, NodeKind, Param, FieldEntry frm ../ast
imp TypeInfo, TypeKind frm ../types
imp Diagnostic frm ../diagnostics
imp Parser frm parser

/**
 * Parses a type annotation string from the token stream.
 *
 * Handles primitives (num, str, bool, void), custom types, pointer types (&T),
 * and array types (T[]).
 *
 * @param {Parser} parser - Parser coordinator instance
 * @returns {str} The parsed type signature string
 */
ParseTypeString parser: Parser :: str {
    let isPtr: bool = false
    if parser.matchToken TokenType.TOK_AMP {
        isPtr = true
    }

    let c: Token = parser.cur
    let baseType: str = c.val
    parser.advance

    // Check for array dimensions: T[] or T[][]
    wh parser.check TokenType.TOK_LBRACKET {
        if parser.checkPeek TokenType.TOK_RBRACKET {
            parser.advance // consume '['
            parser.advance // consume ']'
            baseType = baseType + "[]"
        } els {
            brk
        }
    }

    if isPtr {
        -> "&" + baseType
    }
    -> baseType
}

/**
 * Parses a parameter list for functions or methods.
 *
 * Supports parenthesized lists `(p1: T1, ...rest)` and paren-free lists `p1: T1, p2: T2`.
 *
 * @param {Parser} parser - Parser coordinator instance
 * @returns {Param[]} Array of parsed parameter records
 */
ParseParamList parser: Parser :: Param[] {
    let params: Param[] = []
    let hasParen: bool = false

    if parser.matchToken TokenType.TOK_LPAREN {
        hasParen = true
        if parser.check TokenType.TOK_RPAREN {
            parser.advance
            -> params
        }
    }

    wh !(parser.isAtEnd) {
        let isRest: bool = false
        if parser.matchToken TokenType.TOK_ELLIPSIS {
            isRest = true
        }

        let pTok: Token = parser.consume TokenType.TOK_IDENT, "Expected parameter identifier"
        let pName: str = pTok.val
        let pType: str = ""
        let isOpt: bool = false

        if parser.matchToken TokenType.TOK_QUESTION {
            isOpt = true
        }

        if parser.matchToken TokenType.TOK_COLON {
            pType = ParseTypeString parser
        }

        let p: Param = {
            name: pName,
            typeAnnotation: pType,
            isRest: isRest,
            isOptional: isOpt,
            line: pTok.line,
            col: pTok.col
        }
        params.psh p

        if parser.matchToken TokenType.TOK_COMMA {
            // continue parsing next parameter
        } els {
            brk
        }
    }

    if hasParen {
        parser.consume TokenType.TOK_RPAREN, "Expected ')' after parameter list"
    }

    -> params
}

/**
 * Parses a TypeScript-style type alias declaration (`type Name = { ... };` or `type Alias = Type;`).
 *
 * @param {Parser} parser - Parser coordinator instance
 * @param {bool} isPub - True if exported public declaration
 * @returns {ASTNode} Type declaration AST node
 */
ParseTypeDecl parser: Parser, isPub: bool :: ASTNode {
    let typeTok: Token = parser.advance // consume 'type' / 'typ'
    let nameTok: Token = parser.consume TokenType.TOK_IDENT, "Expected type name identifier"
    let name: str = nameTok.val

    parser.consume TokenType.TOK_ASSIGN, "Expected '=' after type name"

    let node: ASTNode = ASTNode.createTypeDecl name, isPub, nameTok.line, nameTok.col

    if parser.matchToken TokenType.TOK_LBRACE {
        // Record schema definition: { field1: type; field2: type; }
        wh !(parser.check TokenType.TOK_RBRACE) && !(parser.isAtEnd) {
            let fTok: Token = parser.consume TokenType.TOK_IDENT, "Expected field identifier in type record"
            parser.consume TokenType.TOK_COLON, "Expected ':' after field name"
            let fType: str = ParseTypeString parser

            let entry: FieldEntry = {
                name: fTok.val,
                valStr: fType,
                isSpread: false,
                line: fTok.line,
                col: fTok.col
            }
            node.fields.psh entry

            if (parser.matchToken TokenType.TOK_SEMICOLON) || (parser.matchToken TokenType.TOK_COMMA) {
                // consume delimiter
            }
        }
        parser.consume TokenType.TOK_RBRACE, "Expected '}' after type record body"
    } els {
        // Simple type alias: type ID = num
        let aliasType: str = ParseTypeString parser
        node.typeAnnotation = aliasType
    }

    if parser.matchToken TokenType.TOK_SEMICOLON {
        // optional trailing semicolon
    }

    -> node
}

/**
 * Parses an object / struct declaration (`obj Name { field: Type, method: => { ... } }`).
 *
 * @param {Parser} parser - Parser coordinator instance
 * @param {bool} isPub - True if exported public declaration
 * @returns {ASTNode} Object declaration AST node
 */
ParseObjDecl parser: Parser, isPub: bool :: ASTNode {
    let objTok: Token = parser.advance // consume 'obj'
    let nameTok: Token = parser.consume TokenType.TOK_IDENT, "Expected object name identifier"
    let name: str = nameTok.val

    let node: ASTNode = ASTNode.createObjDecl name, isPub, nameTok.line, nameTok.col

    parser.consume TokenType.TOK_LBRACE, "Expected '{' before object body"

    wh !(parser.check TokenType.TOK_RBRACE) && !(parser.isAtEnd) {
        if (parser.matchToken TokenType.TOK_SEMICOLON) || (parser.matchToken TokenType.TOK_COMMA) {
            cont
        }

        let mTok: Token = parser.consume TokenType.TOK_IDENT, "Expected member name in object declaration"
        let mName: str = mTok.val

        if parser.matchToken TokenType.TOK_COLON {
            // Check if member is a method or a field
            if (parser.check TokenType.TOK_FAT_ARROW) || (parser.check TokenType.TOK_COLON_COLON) || (parser.check TokenType.TOK_LPAREN) {
                // Method definition: method: params :: Ret => { ... }
                let mParams: Param[] = []
                let mRet: str = ""

                if !(parser.check TokenType.TOK_FAT_ARROW) && !(parser.check TokenType.TOK_COLON_COLON) {
                    mParams = ParseParamList parser
                }

                if (parser.matchToken TokenType.TOK_COLON_COLON) || (parser.matchToken TokenType.TOK_ARROW) {
                    mRet = ParseTypeString parser
                }

                parser.consume TokenType.TOK_FAT_ARROW, "Expected '=>' before method body"

                let mNode: ASTNode = ASTNode.createFuncDecl mName, mRet, false, true, mTok.line, mTok.col
                mNode.params = mParams
                node.children.psh mNode
            } els {
                // Field definition: field: Type
                let fType: str = ParseTypeString parser
                let entry: FieldEntry = {
                    name: mName,
                    valStr: fType,
                    isSpread: false,
                    line: mTok.line,
                    col: mTok.col
                }
                node.fields.psh entry
            }
        } els {
            // Shorthand field or method alias
            let entry: FieldEntry = {
                name: mName,
                valStr: "any",
                isSpread: false,
                line: mTok.line,
                col: mTok.col
            }
            node.fields.psh entry
        }

        if (parser.matchToken TokenType.TOK_COMMA) || (parser.matchToken TokenType.TOK_SEMICOLON) {
            // optional separator
        }
    }

    parser.consume TokenType.TOK_RBRACE, "Expected '}' after object body"
    -> node
}

/**
 * Parses a function declaration (`fn name params [:: RetType] { body }` or `name p1, p2 => expr`).
 *
 * @param {Parser} parser - Parser coordinator instance
 * @param {bool} isPub - True if exported public function
 * @param {bool} isAsync - True if asynchronous function
 * @returns {ASTNode} Function declaration AST node
 */
ParseFuncDecl parser: Parser, isPub: bool, isAsync: bool :: ASTNode {
    if parser.matchToken TokenType.TOK_FN {
        // consumed optional 'fn'
    }

    let nameTok: Token = parser.consume TokenType.TOK_IDENT, "Expected function name identifier"
    let name: str = nameTok.val

    let params: Param[] = []
    if !(parser.check TokenType.TOK_LBRACE) && !(parser.check TokenType.TOK_COLON_COLON) && !(parser.check TokenType.TOK_ARROW) && !(parser.check TokenType.TOK_FAT_ARROW) {
        params = ParseParamList parser
    }

    let returnType: str = "void"
    if (parser.matchToken TokenType.TOK_COLON_COLON) || (parser.matchToken TokenType.TOK_ARROW) {
        returnType = ParseTypeString parser
    }

    let node: ASTNode = ASTNode.createFuncDecl name, returnType, isAsync, isPub, nameTok.line, nameTok.col
    node.params = params

    if parser.matchToken TokenType.TOK_FAT_ARROW {
        // Arrow function expression body
        let bodyNode: ASTNode = ASTNode.createBlock [], nameTok.line, nameTok.col
        node.children.psh bodyNode
    }

    -> node
}

/**
 * Parses an enum declaration (`enum Name { Variant1, Variant2 = 10 }`).
 *
 * @param {Parser} parser - Parser coordinator instance
 * @param {bool} isPub - True if exported public enum
 * @returns {ASTNode} Enum declaration AST node
 */
ParseEnumDecl parser: Parser, isPub: bool :: ASTNode {
    let enumTok: Token = parser.advance // consume 'enum'
    let nameTok: Token = parser.consume TokenType.TOK_IDENT, "Expected enum name identifier"
    let name: str = nameTok.val

    let node: ASTNode = ASTNode.createEnumDecl name, isPub, nameTok.line, nameTok.col

    parser.consume TokenType.TOK_LBRACE, "Expected '{' before enum body"

    wh !(parser.check TokenType.TOK_RBRACE) && !(parser.isAtEnd) {
        if (parser.matchToken TokenType.TOK_COMMA) || (parser.matchToken TokenType.TOK_SEMICOLON) {
            cont
        }

        let vTok: Token = parser.consume TokenType.TOK_IDENT, "Expected enum variant identifier"
        let vName: str = vTok.val
        let vVal: str = ""

        if parser.matchToken TokenType.TOK_ASSIGN {
            let valTok: Token = parser.advance
            vVal = valTok.val
        }

        let entry: FieldEntry = {
            name: vName,
            valStr: vVal,
            isSpread: false,
            line: vTok.line,
            col: vTok.col
        }
        node.fields.psh entry

        if parser.matchToken TokenType.TOK_COMMA {
            // optional trailing comma
        }
    }

    parser.consume TokenType.TOK_RBRACE, "Expected '}' after enum body"
    -> node
}

/**
 * Parses foreign function interface external declarations (`extern "lib" { fn ... }` or `ffi ...`).
 *
 * @param {Parser} parser - Parser coordinator instance
 * @returns {ASTNode} Extern declaration AST node
 */
ParseExternDecl parser: Parser :: ASTNode {
    let extTok: Token = parser.advance // consume 'extern' / 'ffi'
    let libName: str = "c"

    if parser.check TokenType.TOK_STRING {
        let sTok: Token = parser.advance
        libName = sTok.val
    }

    let node: ASTNode = ASTNode.createBase NodeKind.ExternDecl, extTok.line, extTok.col
    node.val = libName

    if parser.matchToken TokenType.TOK_LBRACE {
        wh !(parser.check TokenType.TOK_RBRACE) && !(parser.isAtEnd) {
            if parser.matchToken TokenType.TOK_SEMICOLON {
                cont
            }
            let fnNode: ASTNode = ParseFuncDecl parser, true, false
            node.children.psh fnNode
            if parser.matchToken TokenType.TOK_SEMICOLON {
                // optional delimiter
            }
        }
        parser.consume TokenType.TOK_RBRACE, "Expected '}' after extern block"
    } els {
        let fnNode: ASTNode = ParseFuncDecl parser, true, false
        node.children.psh fnNode
    }

    -> node
}

/**
 * Parses module import declarations (`imp a, b frm path` or `imp os, fs, str`).
 *
 * @param {Parser} parser - Parser coordinator instance
 * @returns {ASTNode} Import declaration AST node
 */
ParseImportDecl parser: Parser :: ASTNode {
    let impTok: Token = parser.advance // consume 'imp'
    let symbols: str[] = []
    let modulePath: str = ""

    // Parse imported symbol names
    wh (parser.check TokenType.TOK_IDENT) || (parser.check TokenType.TOK_TYPE_STR) || (parser.check TokenType.TOK_TYPE_NUM) || (parser.check TokenType.TOK_TYPE_BOOL) {
        let symTok: Token = parser.advance
        symbols.psh symTok.val

        if parser.matchToken TokenType.TOK_COMMA {
            // continue parsing next symbol
        } els {
            brk
        }
    }

    if parser.matchToken TokenType.TOK_FRM {
        // imp sym1, sym2 frm path
        let pathStr: str = ""
        wh (parser.check TokenType.TOK_IDENT) || (parser.check TokenType.TOK_DOT) || (parser.check TokenType.TOK_SLASH) || (parser.check TokenType.TOK_STRING) {
            let partTok: Token = parser.advance
            pathStr = pathStr + partTok.val
        }
        modulePath = pathStr
    } els {
        // imp os, fs, str (module names directly)
        if symbols.ln > 0 {
            modulePath = symbols[0]
        }
    }

    let node: ASTNode = ASTNode.createImportDecl modulePath, impTok.line, impTok.col
    fr s in symbols {
        let entry: FieldEntry = {
            name: s,
            valStr: s,
            isSpread: false,
            line: impTok.line,
            col: impTok.col
        }
        node.fields.psh entry
    }

    if parser.matchToken TokenType.TOK_SEMICOLON {
        // optional trailing semicolon
    }

    -> node
}

/**
 * Master dispatcher for parsing top-level declarations.
 *
 * Inspects leading modifiers (pub, asc) and delegates to appropriate declaration parser.
 *
 * @param {Parser} parser - Parser coordinator instance
 * @returns {ASTNode} Parsed declaration AST node
 */
ParseDeclaration parser: Parser :: ASTNode {
    let isPub: bool = false
    if parser.matchToken TokenType.TOK_PUB {
        isPub = true
    }

    let isAsync: bool = false
    if (parser.matchToken TokenType.TOK_ASYNC) || (parser.matchToken TokenType.TOK_ASYNC_ST) {
        isAsync = true
    }

    let c: Token = parser.cur
    if c.kind == TokenType.TOK_TYP || (c.kind == TokenType.TOK_IDENT && c.val == "type") {
        -> ParseTypeDecl parser, isPub
    }
    if c.kind == TokenType.TOK_STRUCT || (c.kind == TokenType.TOK_IDENT && c.val == "obj") {
        -> ParseObjDecl parser, isPub
    }
    if c.kind == TokenType.TOK_ENUM {
        -> ParseEnumDecl parser, isPub
    }
    if c.kind == TokenType.TOK_EXTERN {
        -> ParseExternDecl parser
    }
    if c.kind == TokenType.TOK_IMP {
        -> ParseImportDecl parser
    }
    if c.kind == TokenType.TOK_FN || c.kind == TokenType.TOK_IDENT {
        -> ParseFuncDecl parser, isPub, isAsync
    }

    // Default error recovery fallback
    let errTok: Token = parser.advance
    parser.addError "E0101", "Expected declaration statement, got " + errTok.val, errTok.line, errTok.col, errTok.len, "expected declaration"
    -> ASTNode.createBase NodeKind.ProgramDecl, errTok.line, errTok.col
}
