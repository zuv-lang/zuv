/*
 * =============================================================================
 * Zuv Bootstrap Compiler — Parser State & Core Coordinator
 * Path: sub_projects/zuv/src/bootstrap/parser/parser.zv
 * =============================================================================
 *
 * Provides the foundational `obj Parser` state machine managing the token
 * stream, cursor navigation, error diagnostics accumulation, and statement
 * boundary synchronization.
 */

imp str, arr
imp Token, TokenType frm ../tokens
imp Diagnostic frm ../diagnostics
imp ASTNode, NodeKind, ProgramDeclAST frm ../ast
imp TypeInfo, TypeKind frm ../types

obj ParserScope {
    names: str[],

    create: :: ParserScope => {
        emptyNames: str[] = []
        -> ParserScope {
            names: emptyNames
        }
    }
}

/**
 * Stateful recursive descent parser coordinator.
 *
 * Maintains token stream cursor, error collection, source file metadata,
 * and primitive lookahead/navigation operations.
 */
obj Parser {
    tokens: Token[],
    pos: num,
    len: num,
    file: str,
    source: str,
    errors: Diagnostic[],
    scopes: ParserScope[],

    /**
     * Creates and initializes a new Parser instance for the provided tokens.
     *
     * @param {Token[]} tokens - Array of scanned Token objects
     * @param {str} file - Source file path for diagnostic reporting
     * @param {str} source - Full original source code text
     * @returns {Parser} Initialized Parser coordinator instance
     */
    create: tokens: Token[], file: str, source: str :: Parser => {
        totalTokens: num = tokens.ln
        errs: Diagnostic[] = []
        initScope: ParserScope = ParserScope.create()
        initScopes: ParserScope[] = [initScope]
        -> {
            tokens,
            pos: 0,
            len: totalTokens,
            file,
            source,
            errors: errs,
            scopes: initScopes
        }
    },

    /**
     * Returns the token at the current cursor position, or EOF token if past end.
     *
     * @returns {Token} Current token
     */
    cur: :: Token => {
        if self.pos >= self.len {
            eofTok = Token.create TokenType.TOK_EOF, "", 0, 0, 0
            -> eofTok
        }
        tok: Token = self.tokens[self.pos]
        -> tok
    },

    /**
     * Peeks at the token immediately after the current cursor without advancing.
     *
     * @returns {Token} Next token (pos + 1) or EOF token
     */
    peek: :: Token => {
        nextPos: num = self.pos + 1
        if nextPos >= self.len {
            eofTok = Token.create TokenType.TOK_EOF, "", 0, 0, 0
            -> eofTok
        }
        tok: Token = self.tokens[nextPos]
        -> tok
    },

    /**
     * Peeks ahead by an arbitrary offset from current position without advancing.
     *
     * @param {num} offset - Number of tokens ahead to inspect
     * @returns {Token} Token at pos + offset, or EOF token if out of bounds
     */
    peekAhead: offset: num :: Token => {
        targetPos: num = self.pos + offset
        if targetPos >= self.len || targetPos < 0 {
            eofTok = Token.create TokenType.TOK_EOF, "", 0, 0, 0
            -> eofTok
        }
        tok: Token = self.tokens[targetPos]
        -> tok
    },

    /**
     * Returns the token immediately preceding the current cursor.
     *
     * @returns {Token} Previous token (pos - 1) or EOF token if at start
     */
    prev: :: Token => {
        if self.pos <= 0 {
            eofTok = Token.create TokenType.TOK_EOF, "", 0, 0, 0
            -> eofTok
        }
        prevPos: num = self.pos - 1
        tok: Token = self.tokens[prevPos]
        -> tok
    },

    /**
     * Checks whether the parser has reached the end of the token stream.
     *
     * @returns {bool} True if cursor is at or past EOF, false otherwise
     */
    isAtEnd: :: bool => {
        if self.pos >= self.len {
            -> true
        }
        curTok: Token = self.cur
        -> curTok.kind == TokenType.TOK_EOF
    },

    /**
     * Checks if current token matches the expected TokenType without consuming.
     *
     * @param {TokenType} kind - Expected token kind
     * @returns {bool} True if matching, false otherwise
     */
    check: kind: TokenType :: bool => {
        if self.isAtEnd {
            -> kind == TokenType.TOK_EOF
        }
        curTok: Token = self.cur
        -> curTok.kind == kind
    },

    /**
     * Checks if the next peek token matches expected TokenType.
     *
     * @param {TokenType} kind - Expected peek token kind
     * @returns {bool} True if matching, false otherwise
     */
    checkPeek: kind: TokenType :: bool => {
        peekTok: Token = self.peek
        -> peekTok.kind == kind
    },

    /**
     * Consumes and returns the current token, advancing cursor by one position.
     *
     * @returns {Token} The consumed token
     */
    advance: :: Token => {
        if !(self.isAtEnd) {
            self.pos = self.pos + 1
        }
        -> self.prev
    },

    /**
     * If the current token matches the given kind, consumes it and returns true.
     *
     * @param {TokenType} kind - Expected token kind to match
     * @returns {bool} True if matched and consumed, false otherwise
     */
    matchToken: kind: TokenType :: bool => {
        if self.check kind {
            self.advance
            -> true
        }
        -> false
    },

    /**
     * Consumes the current token if it matches expected kind, otherwise logs error.
     *
     * @param {TokenType} kind - Expected token kind
     * @param {str} errMsg - Error message to report on mismatch
     * @returns {Token} Consumed token on match, or current token on error
     */
    consume: kind: TokenType, errMsg: str :: Token => {
        if self.check kind {
            -> self.advance
        }
        curTok: Token = self.cur
        self.addError "E0102", errMsg, curTok.line, curTok.col, curTok.len, "expected token"
        -> curTok
    },

    /**
     * Records a new diagnostic error record attached to source coordinates.
     *
     * @param {str} code - Error code (e.g. 'E0101', 'E0102')
     * @param {str} msg - Primary diagnostic message
     * @param {num} line - 1-based source line number
     * @param {num} col - 1-based source column number
     * @param {num} len - Length of source span to underline
     * @param {str} help - Actionable suggestion or fix text
     * @returns {void}
     */
    addError: code: str, msg: str, line: num, col: num, len: num, help: str :: void => {
        diag = Diagnostic.create code, msg, self.file, line, col, len, help
        self.errors.psh diag
    },

    /**
     * Synchronizes token cursor at statement boundary after encountering an error.
     *
     * Skips tokens until encountering a semicolon or statement-starting keyword.
     *
     * @returns {void}
     */
    synchronize: :: void => {
        self.advance
        wh !(self.isAtEnd) {
            prevTok: Token = self.prev
            if prevTok.kind == TokenType.TOK_SEMICOLON {
                ret
            }
            curTok: Token = self.cur
            if curTok.kind == TokenType.TOK_LET || curTok.kind == TokenType.TOK_AMP_LET ||
               curTok.kind == TokenType.TOK_FN || curTok.kind == TokenType.TOK_STRUCT ||
               curTok.kind == TokenType.TOK_TYP || curTok.kind == TokenType.TOK_ENUM ||
               curTok.kind == TokenType.TOK_IF || curTok.kind == TokenType.TOK_WH ||
               curTok.kind == TokenType.TOK_FOR || curTok.kind == TokenType.TOK_MATCH ||
               curTok.kind == TokenType.TOK_RET || curTok.kind == TokenType.TOK_PUB ||
               curTok.kind == TokenType.TOK_EXTERN || curTok.kind == TokenType.TOK_IMP ||
               curTok.kind == TokenType.TOK_PRNT || curTok.kind == TokenType.TOK_LOG ||
               curTok.kind == TokenType.TOK_TRY || curTok.kind == TokenType.TOK_PANIC {
                ret
            }
            self.advance
        }
    },

    /**
     * Returns whether the parser recorded one or more diagnostic errors.
     *
     * @returns {bool} True if errors exist, false otherwise
     */
    hasErrors: :: bool => {
        count: num = self.errors.ln
        -> count > 0
    },

    /**
     * Returns the array of collected Diagnostic records.
     *
     * @returns {Diagnostic[]} Array of Diagnostic instances
     */
    getErrors: :: Diagnostic[] => {
        -> self.errors
    },

    /**
     * Formats all accumulated diagnostics into rustc-style error messages.
     *
     * @returns {str} Combined formatted error string
     */
    formatErrors: :: str => {
        res: str = ""
        fr diag of self.errors {
            formatted: str = diag.format self.source
            if res == "" {
                res = formatted
            } els {
                res = res + "\n\n" + formatted
            }
        }
        -> res
    },

    /**
     * Enters a new lexical scope level.
     */
    enterScope: :: void => {
        sc: ParserScope = ParserScope.create()
        self.scopes.psh sc
    },

    /**
     * Exits the current lexical scope level, preserving root scope.
     */
    exitScope: :: void => {
        if self.scopes.ln > 1 {
            self.scopes.pop
        }
    },

    /**
     * Registers a variable identifier in the current innermost scope.
     *
     * @param {str} name - Variable identifier name
     */
    addVar: name: str :: void => {
        if self.scopes.ln > 0 {
            topIdx: num = self.scopes.ln - 1
            curSc: ParserScope = self.scopes[topIdx]
            curSc.names.psh name
            self.scopes[topIdx] = curSc
        }
    },

    /**
     * Checks if a variable identifier has been declared in any active scope.
     *
     * @param {str} name - Variable identifier name to find
     * @returns {bool} True if declared, false otherwise
     */
    hasVar: name: str :: bool => {
        sIdx: num = self.scopes.ln
        wh sIdx > 0 {
            sIdx = sIdx - 1
            sc: ParserScope = self.scopes[sIdx]
            fr n of sc.names {
                if n == name {
                    -> true
                }
            }
        }
        -> false
    }
}
