/*
 * =============================================================================
 * Zuv Bootstrap Compiler — ParseSingleType Declaration Parser
 * Path: sub_projects/zuv/src/bootstrap/parser/decl/parseSingleType.zv
 * =============================================================================
 */

imp Token, TokenType frm ../../tokens
imp ASTNode, FieldEntry frm ../../ast
imp Parser frm ../parser
imp ParseTypeStringFull frm parseTypeString

/**
 * Parses a type annotation string from the token stream.
 *
 * Handles primitives (num, str, bool, void), custom types, pointer types (&T),
 * and array types (T[]).
 *
 * @param {Parser} parser - Parser coordinator instance
 * @returns {str} The parsed type signature string
 */
ParseSingleType parser: Parser, parentName: str, targetParentNode: ASTNode :: str {
    prefix: str = ""
    wh parser.matchToken TokenType.TOK_ASTERISK {
        prefix = prefix + "*"
    }
    if prefix.ln == 0 && parser.matchToken TokenType.TOK_AMP {
        prefix = "&"
    }

    res: str = ""
    if parser.matchToken TokenType.TOK_LBRACE {
        subNode: ASTNode = ASTNode.createTypeDecl parentName, false, 0, 0
        wh !(parser.check TokenType.TOK_RBRACE) && !(parser.isAtEnd) {
            if (parser.matchToken TokenType.TOK_SEMICOLON) || (parser.matchToken TokenType.TOK_COMMA) {
                cont
            }
            if !(parser.check TokenType.TOK_IDENT) {
                errTok: Token = parser.advance
                parser.addError "E0102", "Expected field identifier in type record, got " + errTok.val, errTok.line, errTok.col, errTok.len, "expected identifier"
                cont
            }
            fTok: Token = parser.consume TokenType.TOK_IDENT, "Expected field identifier in type record"
            subSubName: str = parentName + "_" + fTok.val
            fType: str = "any"
            if parser.matchToken TokenType.TOK_COLON {
                fType = ParseTypeStringFull parser, subSubName, targetParentNode
            }
            entry: FieldEntry = {
                name: fTok.val,
                valStr: fType,
                isSpread: false,
                line: fTok.line,
                col: fTok.col
            }
            subNode.fields.psh entry
            if (parser.matchToken TokenType.TOK_SEMICOLON) || (parser.matchToken TokenType.TOK_COMMA) {
                // delimiter
            }
        }
        parser.consume TokenType.TOK_RBRACE, "Expected '}' after type record body"
        subNode.typeAnnotation = parentName
        targetParentNode.children.psh subNode
        res = parentName
    } els if parser.matchToken TokenType.TOK_LBRACKET {
        res = "["
        first: bool = true
        wh !(parser.check TokenType.TOK_RBRACKET) && !(parser.isAtEnd) {
            if (parser.matchToken TokenType.TOK_COMMA) || (parser.matchToken TokenType.TOK_SEMICOLON) {
                cont
            }
            if !first {
                res = res + ", "
            }
            elemT: str = ParseTypeStringFull parser, parentName, targetParentNode
            res = res + elemT
            first = false
            if (parser.matchToken TokenType.TOK_COMMA) || (parser.matchToken TokenType.TOK_SEMICOLON) {
                // delimiter
            }
        }
        parser.consume TokenType.TOK_RBRACKET, "Expected ']' after bracket type"
        res = res + "]"
    } els {
        curTok: Token = parser.cur
        res = curTok.val
        parser.advance
    }

    wh parser.check TokenType.TOK_LBRACKET {
        if parser.checkPeek TokenType.TOK_RBRACKET {
            parser.advance // consume '['
            parser.advance // consume ']'
            res = res + "[]"
        } els {
            brk
        }
    }

    if parser.matchToken TokenType.TOK_QUESTION {
        res = res + "?"
    }

    if prefix.ln > 0 {
        -> prefix + res
    }
    -> res
}
