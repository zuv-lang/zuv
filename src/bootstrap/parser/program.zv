/*
 * =============================================================================
 * Zuv Bootstrap Compiler — Top-Level Program & Module Parser
 * Path: sub_projects/zuv/src/bootstrap/parser/program.zv
 * =============================================================================
 *
 * Implements full-file parsing into a root `ProgramDecl` AST node.
 * Coordinates top-level declarations (functions, objects, types, enums, extern,
 * imports) and statements while maintaining strict unidirectional module imports.
 */

imp str, arr
imp Token, TokenType frm ../tokens
imp ASTNode, NodeKind frm ../ast
imp Diagnostic frm ../diagnostics
imp Parser frm parser
imp ParseDeclaration frm decl
imp ParseStatement, ParseBlockStmt frm stmt

/**
 * Scans lookahead tokens on the current line to determine if an identifier begins a function declaration.
 *
 * Checks if the identifier is followed on the same line by '::', '->', '=>', or '{'.
 *
 * @param {Parser} parser - Parser coordinator instance
 * @returns {bool} True if lookahead indicates a function declaration
 */
IsFuncDecl parser: Parser :: bool {
    cTok: Token = parser.cur
    curLine: num = cTok.line

    firstTok: Token = parser.peekAhead 1
    if firstTok.kind == TokenType.TOK_EOF || firstTok.line != curLine {
        -> false
    }

    // 1. Variable assignment: ident = ...
    if firstTok.kind == TokenType.TOK_ASSIGN {
        -> false
    }

    // 2. Typed variable declaration: ident : Type = ...
    if firstTok.kind == TokenType.TOK_COLON {
        -> false
    }

    // 3. Array indexing statement: ident[...] = ...
    if firstTok.kind == TokenType.TOK_LBRACKET {
        -> false
    }

    // 4. Property assignment: ident.prop = ...
    if firstTok.kind == TokenType.TOK_DOT {
        t2: Token = parser.peekAhead 2
        t3: Token = parser.peekAhead 3
        if t2.kind == TokenType.TOK_IDENT && t3.kind == TokenType.TOK_ASSIGN {
            -> false
        }
    }

    // 5. Direct empty body or arrow: ident { ... } or ident => ...
    if firstTok.kind == TokenType.TOK_LBRACE || firstTok.kind == TokenType.TOK_FAT_ARROW {
        -> true
    }

    // 6. Parenthesized parameter list: ident(...) { ... } or ident(...) => ...
    if firstTok.kind == TokenType.TOK_LPAREN {
        pDepth: num = 1
        pOff: num = 2
        wh pDepth > 0 {
            pTok: Token = parser.peekAhead pOff
            if pTok.kind == TokenType.TOK_EOF || pTok.line != curLine {
                brk
            }
            if pTok.kind == TokenType.TOK_LPAREN {
                pDepth = pDepth + 1
            } els if pTok.kind == TokenType.TOK_RPAREN {
                pDepth = pDepth - 1
            }
            pOff = pOff + 1
        }
        if pDepth == 0 {
            wh true {
                nxtTok: Token = parser.peekAhead pOff
                if nxtTok.kind == TokenType.TOK_EOF || nxtTok.line != curLine {
                    brk
                }
                if nxtTok.kind == TokenType.TOK_LBRACE || nxtTok.kind == TokenType.TOK_FAT_ARROW {
                    -> true
                }
                if nxtTok.kind == TokenType.TOK_SEMICOLON {
                    brk
                }
                pOff = pOff + 1
            }
        }
        -> false
    }

    // 7. Unparenthesized parameter list, extension methods, or return type:
    // Scan ahead at statement depth 0 for { or => on the same line
    pDepth: num = 0
    bDepth: num = 0
    offset: num = 1
    wh true {
        tok: Token = parser.peekAhead offset
        if tok.kind == TokenType.TOK_EOF || tok.line != curLine {
            brk
        }
        if tok.kind == TokenType.TOK_LPAREN {
            pDepth = pDepth + 1
        } els if tok.kind == TokenType.TOK_RPAREN {
            if pDepth > 0 {
                pDepth = pDepth - 1
            }
        } els if tok.kind == TokenType.TOK_LBRACKET {
            bDepth = bDepth + 1
        } els if tok.kind == TokenType.TOK_RBRACKET {
            if bDepth > 0 {
                bDepth = bDepth - 1
            }
        } els if pDepth == 0 && bDepth == 0 {
            if tok.kind == TokenType.TOK_LBRACE || tok.kind == TokenType.TOK_FAT_ARROW {
                -> true
            }
            if tok.kind == TokenType.TOK_SEMICOLON {
                brk
            }
        }
        offset = offset + 1
    }
    -> false
}

/**
 * Parses an entire source file token stream into a root ProgramDecl AST node.
 *
 * Loops until reaching end of file (TOK_EOF), consuming declarations and statements.
 *
 * @param {Parser} parser - Parser coordinator instance
 * @returns {ASTNode} Root ProgramDecl AST node containing all parsed AST elements
 */
ParseProgram parser: Parser :: ASTNode {
    progNode: ASTNode = ASTNode.createBase NodeKind.ProgramDecl, 1, 1

    wh !(parser.isAtEnd) {
        if parser.matchToken TokenType.TOK_SEMICOLON {
            cont
        }
        curTok: Token = parser.cur
        if curTok.kind == TokenType.TOK_EOF {
            brk
        }

        if curTok.kind == TokenType.TOK_PUB || curTok.kind == TokenType.TOK_ASYNC ||
           curTok.kind == TokenType.TOK_ASYNC_ST || curTok.kind == TokenType.TOK_TYP ||
           curTok.kind == TokenType.TOK_STRUCT || curTok.kind == TokenType.TOK_ENUM ||
           curTok.kind == TokenType.TOK_EXTERN || curTok.kind == TokenType.TOK_IMP ||
           curTok.kind == TokenType.TOK_FN || curTok.kind == TokenType.TOK_AT {
            declNode: ASTNode = ParseDeclaration parser
            progNode.children.psh declNode
        } els if curTok.kind == TokenType.TOK_IDENT && (curTok.val == "obj" || (curTok.val == "type" && parser.peek.kind == TokenType.TOK_IDENT && parser.peekAhead(2).kind == TokenType.TOK_ASSIGN) || (curTok.val == "ffi" && (parser.peek.kind == TokenType.TOK_STRING || parser.peek.kind == TokenType.TOK_LBRACE))) {
            declNode: ASTNode = ParseDeclaration parser
            progNode.children.psh declNode
        } els if curTok.kind == TokenType.TOK_IDENT && parser.isStructType(curTok.val) && !(parser.hasVar curTok.val) && parser.peek.kind == TokenType.TOK_DOT && parser.peekAhead(2).kind == TokenType.TOK_IDENT && parser.peekAhead(3).kind == TokenType.TOK_ASSIGN && parser.peekAhead(4).kind == TokenType.TOK_IDENT && (parser.peekAhead(5).kind == TokenType.TOK_SEMICOLON || parser.peekAhead(5).line != parser.peekAhead(4).line || parser.peekAhead(5).kind == TokenType.TOK_EOF) {
            typeNameTok: Token = parser.advance
            parser.advance // consume '.'
            methodTok: Token = parser.advance
            parser.advance // consume '='
            targetTok: Token = parser.advance
            if parser.matchToken TokenType.TOK_SEMICOLON { }
            mangledName: str = typeNameTok.val + "_" + methodTok.val
            selfP: Param = {
                name: "self",
                typeAnnotation: typeNameTok.val,
                isRest: false,
                isOptional: false,
                defaultVal: "",
                line: typeNameTok.line,
                col: typeNameTok.col
            }
            callCallee: ASTNode = ASTNode.createIdent targetTok.val, targetTok.line, targetTok.col
            callNode: ASTNode = ASTNode.createCall callCallee, [], targetTok.line, targetTok.col
            retNode: ASTNode = ASTNode.createRet callNode, targetTok.line, targetTok.col
            bodyBlock: ASTNode = ASTNode.createBlock [retNode], targetTok.line, targetTok.col
            aliasFn: ASTNode = ASTNode.createFuncDecl mangledName, "", false, false, typeNameTok.line, typeNameTok.col
            aliasFn.params = [selfP]
            aliasFn.children = [bodyBlock]
            progNode.children.psh aliasFn
        } els if curTok.kind == TokenType.TOK_IDENT && IsFuncDecl(parser) {
            declNode: ASTNode = ParseDeclaration parser
            progNode.children.psh declNode
        } els {
            stmtNode: ASTNode = ParseStatement parser
            progNode.children.psh stmtNode
        }
    }

    fr lambdaNode of parser.lambdas {
        progNode.children.psh lambdaNode
    }

    -> progNode
}
