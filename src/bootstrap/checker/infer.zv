/*
 * =============================================================================
 * Zuv Bootstrap Compiler — Semantic Type Inference & AST Annotation Engine
 * Path: sub_projects/zuv/src/bootstrap/checker/infer.zv
 * =============================================================================
 *
 * Coordinates and re-exports semantic type inference components:
 * - InferExpression: Expression evaluation and type annotation (checker/infer/inferExpression)
 * - InferStatement: Statement type checking and scope validation (checker/infer/inferStatement)
 * - InferDeclaration: Scoped declaration and function inference (checker/infer/inferDeclaration)
 * - InferProgram: Top-level program AST traversal coordinator (checker/infer/inferProgram)
 */

imp InferExpression frm infer/inferExpression
imp InferStatement frm infer/inferStatement
imp InferDeclaration frm infer/inferDeclaration
imp InferProgram frm infer/inferProgram
