/*
 * =============================================================================
 * Zuv Bootstrap Compiler — emitDirectObjectFile Build Pipeline
 * Path: sub_projects/zuv/src/bootstrap/cli/build/emitDirectObjectFile.zv
 * =============================================================================
 */

extern "LLVMCore.lib" {
    LLVMInitializeX86TargetInfo :: void
    LLVMInitializeX86Target :: void
    LLVMInitializeX86TargetMC :: void
    LLVMInitializeX86AsmPrinter :: void
    LLVMInitializeX86AsmParser :: void

    LLVMInitializeAArch64TargetInfo :: void
    LLVMInitializeAArch64Target :: void
    LLVMInitializeAArch64TargetMC :: void
    LLVMInitializeAArch64AsmPrinter :: void
    LLVMInitializeAArch64AsmParser :: void

    LLVMContextCreate :: ptr
    LLVMContextDispose ctx: ptr :: void
    LLVMCreateMemoryBufferWithMemoryRange data: str, len: num, name: str, reqNull: num :: ptr
    LLVMParseIRInContext ctx: ptr, memBuf: ptr, outMod: ptr, outMsg: ptr :: num
    LLVMDisposeModule mod: ptr :: void
}

extern "LLVMTarget.lib" {
    LLVMGetTargetFromTriple triple: str, target: ptr, errMsg: ptr :: num
    LLVMCreateTargetMachine target: ptr, triple: str, cpu: str, feat: str, opt: num, reloc: num, codeModel: num :: ptr
    LLVMTargetMachineEmitToFile tm: ptr, mod: ptr, filename: str, codegenType: num, errMsg: ptr :: num
    LLVMDisposeTargetMachine tm: ptr :: void
}

//start debugging helper function to print a string pointer from LLVM
// extern "msvcrt.dll" {
//     puts strPtr: ptr :: i32
// }
//end debugging helper function to print a string pointer from LLVM

/**
 * Emits a native machine code object file (.obj) directly from LLVM IR in-process.
 *
 * Uses the embedded LLVM TargetMachine and CodeGen libraries without external clang drivers.
 *
 * @param {str} ir - Complete LLVM IR module text
 * @param {str} outputObjPath - Target .obj output file path
 * @param {bool} isRelease - True to enable -O3 optimizations, false for -O0
 * @param {str} targetTriple - Target architecture triple string
 * @returns {num} 0 on success, non-zero on compilation error
 */
emitDirectObjectFile ir: str, outputObjPath: str, isRelease: bool, targetTriple: str :: num {
    LLVMInitializeX86TargetInfo()
    LLVMInitializeX86Target()
    LLVMInitializeX86TargetMC()
    LLVMInitializeX86AsmPrinter()
    LLVMInitializeX86AsmParser()

    LLVMInitializeAArch64TargetInfo()
    LLVMInitializeAArch64Target()
    LLVMInitializeAArch64TargetMC()
    LLVMInitializeAArch64AsmPrinter()
    LLVMInitializeAArch64AsmParser()

    resolvedTriple: str = "x86_64-pc-windows-msvc"
    if targetTriple.ln > 0 {
        resolvedTriple = targetTriple
    }

    fullIr: str = "target triple = \"" + resolvedTriple + "\"\n" + ir

    unsafe {
        ctx: ptr = LLVMContextCreate()
        memBuf: ptr = LLVMCreateMemoryBufferWithMemoryRange(fullIr, fullIr.ln, "zuv_ir", 0)

        outMod: ptr = malloc 8
        outMsg: ptr = malloc 8
        parseRes: num = LLVMParseIRInContext(ctx, memBuf, outMod, outMsg)
        if parseRes != 0 {
            // If parsing fails, print the error message from LLVM  
            // errMsgPtr: ptr = zuv_ptr_deref outMsg
            // if errMsgPtr != nil {
            //     puts errMsgPtr
            // }
            // end print the error message from LLVM

            prnt "[LLVM Error] In-process IR parse failed"
            LLVMContextDispose ctx
            free outMod
            free outMsg
            -> 1
        }
        mod: ptr = zuv_ptr_deref outMod

        targetPtr: ptr = malloc 8
        tRes: num = LLVMGetTargetFromTriple(resolvedTriple, targetPtr, outMsg)
        if tRes != 0 {
            prnt "[LLVM Error] Target lookup failed for: " + resolvedTriple
            LLVMDisposeModule mod
            LLVMContextDispose ctx
            free outMod
            free outMsg
            free targetPtr
            -> 1
        }
        target: ptr = zuv_ptr_deref targetPtr

        optLevel: num = (isRelease ? 3 : 0)
        tm: ptr = LLVMCreateTargetMachine(target, resolvedTriple, "generic", "", optLevel, 0, 0)
        emitRes: num = LLVMTargetMachineEmitToFile(tm, mod, outputObjPath, 1, outMsg)
        if emitRes != 0 {
            prnt "[LLVM Error] Object code emission failed"
            LLVMDisposeTargetMachine tm
            LLVMDisposeModule mod
            LLVMContextDispose ctx
            free outMod
            free outMsg
            free targetPtr
            -> 1
        }

        LLVMDisposeTargetMachine tm
        LLVMDisposeModule mod
        LLVMContextDispose ctx
        free outMod
        free outMsg
        free targetPtr
        -> 0
    }
}
