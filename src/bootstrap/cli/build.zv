/*
 * =============================================================================
 * Zuv Bootstrap Compiler — Build Pipeline & Codegen Orchestration
 * Path: sub_projects/zuv/src/bootstrap/cli/build.zv
 * =============================================================================
 *
 * Emits LLVM IR, object files (.obj), and links native executables / cdylibs.
 */

imp time
imp Token frm ../tokens
imp TypeKind frm ../types
imp ASTNode, NodeKind frm ../ast
imp Lexer frm ../lexer
imp Parser frm ../parser/parser
imp ParseProgram frm ../parser/program
imp Checker frm ../checker/checker
imp InferProgram frm ../checker/infer
imp BorrowChecker, BorrowCheckProgram frm ../checker/borrow
imp Codegen frm ../codegen/codegen
imp ExternManager frm ../codegen/extern
imp llvmStackType, selectDefaultValue frm ../codegen/types
imp ObjectCodegen, StructLayoutRegistry, resolveFieldTypeKind frm ../codegen/decl
imp ArrayCodegen frm ../codegen/array
imp ExprCodegen frm ../codegen/expr
imp StmtCodegen frm ../codegen/stmt
imp RuntimeCodegen frm ../codegen/runtime

extern "LLVMCore.lib" {
    LLVMInitializeX86TargetInfo :: void
    LLVMInitializeX86Target :: void
    LLVMInitializeX86TargetMC :: void
    LLVMInitializeX86AsmPrinter :: void
    LLVMInitializeX86AsmParser :: void

    LLVMInitializeAArch64TargetInfo :: void
    LLVMInitializeAArch64Target :: void
    LLVMInitializeAArch64TargetMC :: void
    LLVMInitializeAArch64AsmPrinter :: void
    LLVMInitializeAArch64AsmParser :: void

    LLVMContextCreate :: ptr
    LLVMContextDispose ctx: ptr :: void
    LLVMCreateMemoryBufferWithMemoryRange data: str, len: num, name: str, reqNull: num :: ptr
    LLVMParseIRInContext ctx: ptr, memBuf: ptr, outMod: ptr, outMsg: ptr :: num
    LLVMDisposeModule mod: ptr :: void
}

extern "LLVMTarget.lib" {
    LLVMGetTargetFromTriple triple: str, target: ptr, errMsg: ptr :: num
    LLVMCreateTargetMachine target: ptr, triple: str, cpu: str, feat: str, opt: num, reloc: num, codeModel: num :: ptr
    LLVMTargetMachineEmitToFile tm: ptr, mod: ptr, filename: str, codegenType: num, errMsg: ptr :: num
    LLVMDisposeTargetMachine tm: ptr :: void
}

//start debugging helper function to print a string pointer from LLVM
// extern "msvcrt.dll" {
//     puts strPtr: ptr :: i32
// }
//end debugging helper function to print a string pointer from LLVM

/**
 * Emits a native machine code object file (.obj) directly from LLVM IR in-process.
 *
 * Uses the embedded LLVM TargetMachine and CodeGen libraries without external clang drivers.
 *
 * @param {str} ir - Complete LLVM IR module text
 * @param {str} outputObjPath - Target .obj output file path
 * @param {bool} isRelease - True to enable -O3 optimizations, false for -O0
 * @param {str} targetTriple - Target architecture triple string
 * @returns {num} 0 on success, non-zero on compilation error
 */
emitDirectObjectFile ir: str, outputObjPath: str, isRelease: bool, targetTriple: str :: num {
    LLVMInitializeX86TargetInfo()
    LLVMInitializeX86Target()
    LLVMInitializeX86TargetMC()
    LLVMInitializeX86AsmPrinter()
    LLVMInitializeX86AsmParser()

    LLVMInitializeAArch64TargetInfo()
    LLVMInitializeAArch64Target()
    LLVMInitializeAArch64TargetMC()
    LLVMInitializeAArch64AsmPrinter()
    LLVMInitializeAArch64AsmParser()

    resolvedTriple: str = "x86_64-pc-windows-msvc"
    if targetTriple.ln > 0 {
        resolvedTriple = targetTriple
    }

    fullIr: str = "target triple = \"" + resolvedTriple + "\"\n" + ir

    unsafe {
        ctx: ptr = LLVMContextCreate()
        memBuf: ptr = LLVMCreateMemoryBufferWithMemoryRange(fullIr, fullIr.ln, "zuv_ir", 0)

        outMod: ptr = malloc 8
        outMsg: ptr = malloc 8
        parseRes: num = LLVMParseIRInContext(ctx, memBuf, outMod, outMsg)
        if parseRes != 0 {
            // If parsing fails, print the error message from LLVM  
            // errMsgPtr: ptr = zuv_ptr_deref outMsg
            // if errMsgPtr != nil {
            //     puts errMsgPtr
            // }
            // end print the error message from LLVM

            prnt "[LLVM Error] In-process IR parse failed"
            LLVMContextDispose ctx
            free outMod
            free outMsg
            -> 1
        }
        mod: ptr = zuv_ptr_deref outMod

        targetPtr: ptr = malloc 8
        tRes: num = LLVMGetTargetFromTriple(resolvedTriple, targetPtr, outMsg)
        if tRes != 0 {
            prnt "[LLVM Error] Target lookup failed for: " + resolvedTriple
            LLVMDisposeModule mod
            LLVMContextDispose ctx
            free outMod
            free outMsg
            free targetPtr
            -> 1
        }
        target: ptr = zuv_ptr_deref targetPtr

        optLevel: num = (isRelease ? 3 : 0)
        tm: ptr = LLVMCreateTargetMachine(target, resolvedTriple, "generic", "", optLevel, 0, 0)
        emitRes: num = LLVMTargetMachineEmitToFile(tm, mod, outputObjPath, 1, outMsg)
        if emitRes != 0 {
            prnt "[LLVM Error] Object code emission failed"
            LLVMDisposeTargetMachine tm
            LLVMDisposeModule mod
            LLVMContextDispose ctx
            free outMod
            free outMsg
            free targetPtr
            -> 1
        }

        LLVMDisposeTargetMachine tm
        LLVMDisposeModule mod
        LLVMContextDispose ctx
        free outMod
        free outMsg
        free targetPtr
        -> 0
    }
}

/**
 * Checks whether a string ends with a given suffix string.
 *
 * @param {str} text - Input text string
 * @param {str} suffix - Target suffix to inspect
 * @returns {bool} True if text ends with suffix, false otherwise
 */
StrEndsWith text: str, suffix: str :: bool {
    tLen: num = text.ln
    sLen: num = suffix.ln
    if sLen > tLen || sLen == 0 {
        -> false
    }
    subStr: str = text.slc(tLen - sLen, tLen)
    -> subStr == suffix
}

/**
 * Resolves a friendly target name alias to its canonical LLVM target triple.
 *
 * @param {str} alias - Target alias name (e.g. 'win64', 'linux-x64', 'macos-arm64')
 * @returns {str} Canonical LLVM target triple string
 */
ResolveTargetTriple alias: str :: str => sw alias {
    "win64"         => "x86_64-pc-windows-msvc"
    "windows-x64"   => "x86_64-pc-windows-msvc"
    "linux-x64"     => "x86_64-unknown-linux-gnu"
    "linux-amd64"   => "x86_64-unknown-linux-gnu"
    "linux-arm64"   => "aarch64-unknown-linux-gnu"
    "linux-aarch64" => "aarch64-unknown-linux-gnu"
    "macos-arm64"   => "arm64-apple-darwin"
    "darwin-arm64"  => "arm64-apple-darwin"
    "macos-x64"     => "x86_64-apple-darwin"
    "darwin-x64"    => "x86_64-apple-darwin"
    _               => (alias.ln > 0 ? alias : "x86_64-pc-windows-msvc")
}

/**
 * Links a compiled object file (.obj) into an executable or shared library using lld-link.
 *
 * @param {str} objPath - Path to input .obj file
 * @param {str} outExePath - Destination binary path (.exe or .dll)
 * @param {bool} isCdylib - True to build a shared library (.dll), false for standalone executable
 * @returns {num} 0 on successful linkage, non-zero on failure
 */
linkDirectObjectFile objPath: str, outExePath: str, isCdylib: bool, extraLibs: str[] :: num {
    lldBin: str = "lld-link"
    if fE "D:/LLVM/bin/lld-link.exe" {
        lldBin = "D:/LLVM/bin/lld-link.exe"
    } els if fE "lld-link.exe" {
        lldBin = "lld-link.exe"
    } els if fE "bin/lld-link.exe" {
        lldBin = "bin/lld-link.exe"
    }

    isDll: bool = isCdylib
    if StrEndsWith(outExePath, ".dll") || StrEndsWith(outExePath, ".DLL") {
        isDll = true
    }

    dllFlags: str = "-subsystem:console -stack:33554432"
    if isDll {
        outLibPath: str = outExePath
        exeLen: num = outExePath.ln
        if StrEndsWith(outLibPath, ".dll") || StrEndsWith(outLibPath, ".DLL") {
            outLibPath = outLibPath.slc(0, exeLen - 4) + ".lib"
        } els {
            outLibPath = outLibPath + ".lib"
        }
        dllFlags = "-dll -implib:\"" + outLibPath + "\" -noentry -defaultlib:ucrt -defaultlib:vcruntime"
    }

    extraLibFlags: str = ""
    fr extraLib of extraLibs {
        libToLink: str = extraLib
        if StrEndsWith(libToLink, ".dll") || StrEndsWith(libToLink, ".DLL") {
            libToLink = libToLink.slc(0, libToLink.ln - 4) + ".lib"
        }
        resolvedLib: str = libToLink
        if fE libToLink {
            resolvedLib = libToLink
        } els if fE ("tests/" + libToLink) {
            resolvedLib = "tests/" + libToLink
        } els if fE ("sub_projects/zuv/" + libToLink) {
            resolvedLib = "sub_projects/zuv/" + libToLink
        }
        extraLibFlags = extraLibFlags + " \"" + resolvedLib + "\" "
    }

    cmd: str = lldBin + " \"" + objPath + "\" -out:\"" + outExePath + "\" " + dllFlags + extraLibFlags + " -defaultlib:libcmt -defaultlib:legacy_stdio_definitions -defaultlib:oldnames -defaultlib:user32 -defaultlib:kernel32 -defaultlib:ws2_32 -nologo"
    res: num = sh cmd
    -> res
}


/**
 * Compiles a Zuv source file into an LLVM IR module or linked executable.
 */
HandleBuild file: str, outputFile: str, targetTriple: str, isRelease: bool, emitLlvm: bool, isCdylib: bool, isQuiet: bool, isVerbose: bool :: num {
        if !(fE file) {
            prnt "error: source file not found: " + file
            -> 1
        }
        code: str = rF file
        if !(isQuiet) {
            prnt "==========================================="
            prnt "     Zuv Bootstrap Compiler [BUILD]        "
            prnt "==========================================="
            prnt "Compiling target file: " + file
            if isRelease {
                prnt "Optimization: Release Mode (-O3 Native)"
            } els {
                prnt "Optimization: Debug Mode"
            }
        }

        lex = Lexer.create(code)
        tokens: Token[] = lex.tokenizeAll()

        parser = Parser.create(tokens, file, code)
        prog: ASTNode = ParseProgram(parser)
        if parser.hasErrors() {
            prnt parser.formatErrors()
            -> 1
        }

        // Import resolution: parse imported local .zv modules and prepend declarations
        importedNodes: ASTNode[] = []
        fr child of prog.children {
            if child.kind == NodeKind.ImportDecl {
                modPath: str = child.val
                if modPath.ln > 0 && modPath != "os" && modPath != "fs" && modPath != "str" && modPath != "arr" && modPath != "time" {
                    fullPath: str = modPath + ".zv"
                    if !(fE fullPath) {
                        fullPath = "tests/" + modPath + ".zv"
                    }
                    if fE fullPath {
                        modCode: str = rF fullPath
                        modLex = Lexer.create(modCode)
                        modTokens: Token[] = modLex.tokenizeAll()
                        modParser = Parser.create(modTokens, fullPath, modCode)
                        modProg: ASTNode = ParseProgram(modParser)
                        fr modChild of modProg.children {
                            importedNodes.psh modChild
                        }
                    }
                }
            }
        }
        if importedNodes.ln > 0 {
            allChildren: ASTNode[] = []
            fr impItem of importedNodes {
                allChildren.psh impItem
            }
            fr origItem of prog.children {
                allChildren.psh origItem
            }
            prog.children = allChildren
        }

        checker = Checker.create file, code
        InferProgram checker, prog
        if checker.hasErrors() {
            prnt checker.formatErrors()
            -> 1
        }

        borrow = BorrowChecker.create(file, code)
        BorrowCheckProgram(borrow, prog)
        if borrow.hasErrors() {
            prnt borrow.formatErrors()
            -> 1
        }

        // LLVM Codegen
        cg = Codegen.create(targetTriple, isRelease)
        cg.sourceFile = file
        regLayouts = StructLayoutRegistry.create()
        rtGen = RuntimeCodegen.create(cg)
        rtGen.registry = regLayouts
        extMgr = ExternManager.create()

        rtGen.emitAll()
        extMgr.emitCRuntimeDecls(cg)

        targetExe: str = outputFile
        if targetExe.ln == 0 {
            targetExe = (isCdylib ? "output.dll" : "output.exe")
        }

        // Expand ObjDecl methods into synthetic FuncDecls so codegen emits their definitions
        expandedChildren: ASTNode[] = []
        fr topNode of prog.children {
            expandedChildren.psh topNode
            if topNode.kind == NodeKind.ObjDecl {
                fr mNode of topNode.children {
                    mangledName: str = topNode.name + "_" + mNode.name
                    mRetType: str = mNode.typeAnnotation
                    if mRetType.ln == 0 && mNode.children.ln > 0 {
                        retExpr: ASTNode = ASTNode.createNil(0, 0)
                        if mNode.children[0].kind == NodeKind.BlockStmt && mNode.children[0].children.ln > 0 {
                            lastStmt: ASTNode = mNode.children[0].children[mNode.children[0].children.ln - 1]
                            if lastStmt.kind == NodeKind.RetStmt && lastStmt.children.ln > 0 {
                                retExpr = lastStmt.children[0]
                            }
                        } els if mNode.children[0].kind != NodeKind.BlockStmt {
                            retExpr = mNode.children[0]
                        }
                        if retExpr.kind == NodeKind.StrExpr || (retExpr.kind == NodeKind.BinaryExpr && retExpr.op == "+") {
                            mRetType = "str"
                        } els if retExpr.kind == NodeKind.ArrExpr {
                            mRetType = "arr"
                        }
                    }
                    synthFn: ASTNode = ASTNode.createFuncDecl mangledName, mRetType, false, false, mNode.line, mNode.col
                    synthFn.params = mNode.params
                    if mRetType == "str" && synthFn.params.ln > 0 && synthFn.params[0].typeAnnotation.ln == 0 {
                        synthFn.params[0].typeAnnotation = "str"
                    }
                    if mNode.children.ln > 0 && mNode.children[0].kind != NodeKind.BlockStmt {
                        retNode: ASTNode = ASTNode.createRet mNode.children[0], mNode.children[0].line, mNode.children[0].col
                        synthBlock: ASTNode = ASTNode.createBlock [retNode], mNode.children[0].line, mNode.children[0].col
                        synthFn.children = [synthBlock]
                    } els {
                        synthFn.children = mNode.children
                    }
                    synthFn.attributes = []
                    expandedChildren.psh synthFn
                }
            }
        }
        prog.children = expandedChildren

        // Decorator tracking
        userDecorators: str[] = []
        decoratorFactories: str[] = []
        objDecorators: str[] = []
        decoratedFuncNames: str[] = []
        decoratedMethodNames: str[] = []

        fr topNode of prog.children {
            if topNode.kind == NodeKind.FuncDecl {
                fr attr of topNode.attributes {
                    aName: str = attr.name
                    if aName != "st" && aName != "single_threaded" && aName != "inline" && aName != "noinline" && aName != "test" && aName != "derive" && aName != "custom" {
                        userDecorators.psh aName
                        if attr.args.ln > 0 {
                            decoratorFactories.psh aName
                        }
                        decoratedFuncNames.psh topNode.name
                    }
                }
            } els if topNode.kind == NodeKind.ObjDecl {
                fr attr of topNode.attributes {
                    aName: str = attr.name
                    if aName != "st" && aName != "single_threaded" && aName != "inline" && aName != "noinline" && aName != "test" && aName != "derive" && aName != "custom" {
                        userDecorators.psh aName
                        if attr.args.ln > 0 {
                            decoratorFactories.psh aName
                        }
                        objDecorators.psh aName
                    }
                }
                fr mNode of topNode.children {
                    mName: str = topNode.name + "_" + mNode.name
                    fr mAttr of mNode.attributes {
                        aName: str = mAttr.name
                        if aName != "st" && aName != "single_threaded" && aName != "inline" && aName != "noinline" && aName != "test" && aName != "derive" && aName != "custom" {
                            userDecorators.psh aName
                            if mAttr.args.ln > 0 {
                                decoratorFactories.psh aName
                            }
                            decoratedMethodNames.psh mName
                        }
                    }
                }
            }
        }

        cg.emitExtern "@__active_decor_orig = global i64 0"
        cg.emitExtern "@__active_decor_ctx = global i64 0"
        cg.emitExtern "@__active_factory_arg = global i64 0"

        fr topNode of prog.children {
            if topNode.kind == NodeKind.ObjDecl {
                cg.emitExtern ("@" + topNode.name + "_prototype = global i64 0")
            }
        }
        fr dm of decoratedMethodNames {
            cg.emitExtern ("@" + dm + "_orig = global i64 0")
            cg.emitExtern ("@" + dm + "_ctx = global i64 0")
            cg.emitExtern ("@" + dm + "_fnptr = global i64 0")
        }
        fr df of decoratedFuncNames {
            cg.emitExtern ("@" + df + "_orig = global i64 0")
            cg.emitExtern ("@" + df + "_ctx = global i64 0")
            cg.emitExtern ("@" + df + "_fnptr = global i64 0")
        }

        // Emit functions and statements
        topLevelStmts: ASTNode[] = []
        hasExplicitMain: bool = false
        mainNode: ASTNode = ASTNode.createNil(0, 0)

        fr topNode of prog.children {
            if topNode.kind == NodeKind.TypeDecl || topNode.kind == NodeKind.ObjDecl {
                regLayouts.registerFromAST(topNode)
            } els if topNode.kind == NodeKind.EnumDecl {
                regLayouts.registerEnumFromAST(topNode)
            } els if topNode.kind == NodeKind.ExternDecl {
                extMgr.emitExternDeclNode(topNode, cg)
            } els if topNode.kind == NodeKind.FuncDecl {
                if topNode.name == "main" {
                    hasExplicitMain = true
                    mainNode = topNode
                }
            } els {
                topLevelStmts.psh(topNode)
            }
        }

        objGen = ObjectCodegen.create(cg, regLayouts)
        arrGen = ArrayCodegen.create(cg)
        exprGen = ExprCodegen.create(cg, objGen, arrGen)
        stmtGen = StmtCodegen.create(cg, exprGen)

        fr topNode of prog.children {
            if topNode.kind == NodeKind.ObjDecl {
                fr mNode of topNode.children {
                    mName: str = topNode.name + "_" + mNode.name
                    exprGen.addMethodMapping mNode.name, mName
                }
            }
        }
        fr dm of decoratedMethodNames {
            exprGen.decoratedMethods.psh dm
        }
        fr df of decoratedFuncNames {
            exprGen.decoratedMethods.psh df
        }

        // Pre-register user function signatures
        fr topNode of prog.children {
            if topNode.kind == NodeKind.FuncDecl {
                retLLVM: str = (topNode.typeAnnotation == "void" ? "void" : (topNode.typeAnnotation == "str" ? "ptr" : "i64"))
                pTypes: str[] = []
                fnHasRest: bool = false
                fr p of topNode.params {
                    pLLVM: str = "i64"
                    if p.isRest {
                        pLLVM = "ptr"
                        fnHasRest = true
                    } els if p.typeAnnotation == "str" || p.typeAnnotation == "ptr" || p.typeAnnotation == "arr" || StrEndsWith(p.typeAnnotation, "[]") {
                        pLLVM = "ptr"
                    } els if p.typeAnnotation == "bool" {
                        pLLVM = "i1"
                    } els if p.typeAnnotation == "i32" {
                        pLLVM = "i32"
                    } els if p.typeAnnotation == "num" || p.typeAnnotation == "double" {
                        pLLVM = "double"
                    }
                    pTypes.psh(pLLVM)
                }
                exprGen.registerFunc(topNode.name, retLLVM, pTypes, fnHasRest)
            }
        }

        fr extFn of extMgr.functions {
            exprGen.registerFunc(extFn.name, extFn.retType, extFn.paramTypes, false)
        }

        // Pre-register top-level global variables
        declaredGlobals: str[] = []
        fr topNode of topLevelStmts {
            if topNode.kind == NodeKind.VarDecl {
                isAlreadyDecl: bool = false
                fr gName of declaredGlobals {
                    if gName == topNode.name {
                        isAlreadyDecl = true
                    }
                }
                if !isAlreadyDecl {
                    declaredGlobals.psh(topNode.name)
                    gType = topNode.inferredType
                    if gType == TypeKind.Func {
                        gType = TypeKind.I64
                    }
                    gTypeName: str = topNode.typeAnnotation
                    if gTypeName.ln == 0 && topNode.children.ln > 0 {
                        gTypeName = topNode.children[0].typeAnnotation
                        if gTypeName.ln == 0 && topNode.children[0].name.ln > 0 {
                            gTypeName = topNode.children[0].name
                        }
                    }
                    if gType == TypeKind.Unknown && gTypeName.ln > 0 {
                        gType = resolveFieldTypeKind(gTypeName)
                    }
                    if gType == TypeKind.Unknown && topNode.children.ln > 0 {
                        cNode: ASTNode = topNode.children[0]
                        if cNode.kind == NodeKind.ObjLitExpr {
                            gType = TypeKind.Obj
                        } els if cNode.kind == NodeKind.AwaitExpr {
                            gType = cNode.inferredType
                            if gType == TypeKind.Unknown || gType == TypeKind.Func {
                                gType = TypeKind.I64
                            }
                        } els if cNode.kind == NodeKind.NumExpr {
                            gType = TypeKind.I64
                        } els if cNode.kind == NodeKind.StrExpr {
                            gType = TypeKind.Str
                        } els if cNode.kind == NodeKind.BoolExpr {
                            gType = TypeKind.Bool
                        } els if cNode.kind == NodeKind.MethodCallExpr {
                            mName: str = cNode.name
                            if mName == "sub" || mName == "substr" || mName == "slc" || mName == "slice" || mName == "chr" || mName == "charAt" || mName == "cat" || mName == "concat" {
                                gType = TypeKind.Str
                            } els if mName == "cnt" || mName == "contains" || mName == "eq" {
                                gType = TypeKind.Bool
                            } els if mName == "ln" || mName == "length" || mName == "psh" || mName == "push" {
                                gType = TypeKind.I64
                            } els {
                                mTarget: str = ""
                                if cNode.children.ln > 0 && cNode.children[0].kind == NodeKind.IdentExpr {
                                    mTarget = cNode.children[0].name
                                }
                                mangled: str = exprGen.getMethodMapping mName
                                if mangled.ln == 0 && mTarget.ln > 0 {
                                    mangled = mTarget + "_" + mName
                                }
                                if mangled.ln > 0 {
                                    mSig: FuncSignature = exprGen.findFunc mangled
                                    if mSig.name.ln > 0 {
                                        if mSig.retType == "ptr" {
                                            gType = TypeKind.Str
                                        } els if mSig.retType == "void" {
                                            gType = TypeKind.Void
                                        } els if mSig.retType == "double" {
                                            gType = TypeKind.Num
                                        } els if mSig.retType == "i1" {
                                            gType = TypeKind.Bool
                                        } els {
                                            gType = TypeKind.I64
                                        }
                                    }
                                }
                            }
                        } els if cNode.kind == NodeKind.CallExpr {
                            cName: str = ""
                            if cNode.children.ln > 0 && cNode.children[0].kind == NodeKind.IdentExpr {
                                cName = cNode.children[0].name
                            }
                            if cName.ln > 0 {
                                cSig: FuncSignature = exprGen.findFunc cName
                                if cSig.name.ln > 0 {
                                    if cSig.retType == "ptr" {
                                        gType = TypeKind.Str
                                    } els if cSig.retType == "void" {
                                        gType = TypeKind.Void
                                    } els if cSig.retType == "double" {
                                        gType = TypeKind.Num
                                    } els if cSig.retType == "i1" {
                                        gType = TypeKind.Bool
                                    } els {
                                        gType = TypeKind.I64
                                    }
                                }
                            }
                        } els if cNode.kind == NodeKind.IndexExpr {
                            if cNode.children.ln > 0 {
                                idxTarget: ASTNode = cNode.children[0]
                                if idxTarget.kind == NodeKind.StrExpr {
                                    gType = TypeKind.Str
                                } els if idxTarget.kind == NodeKind.IdentExpr {
                                    tSym: ScopeSymbol = exprGen.findGlobalSymbol(idxTarget.name)
                                    if tSym.typeKind == TypeKind.Str {
                                        gType = TypeKind.Str
                                    }
                                }
                            }
                        }
                    }
                    if gType == TypeKind.Unknown || gType == TypeKind.Void {
                        gType = TypeKind.I64
                    }
                    stType: str = llvmStackType(gType)
                    zeroVal: str = selectDefaultValue(gType)
                    if zeroVal.ln == 0 {
                        zeroVal = "0"
                    }
                    globReg: str = "@global_" + topNode.name
                    cg.emitExtern(globReg + " = global " + stType + " " + zeroVal)
                    exprGen.addGlobalSymbolWithType(topNode.name, globReg, gType, gTypeName)
                }
            }
        }

        // Emit custom functions (excluding main)
        stmtGen.setTopLevel(false)
        fr topNode of prog.children {
            if topNode.kind == NodeKind.FuncDecl {
                if topNode.name != "main" {
                    exprGen.clearSymbols()

                    parentFuncName: str = topNode.val
                    parentIsDecor: bool = false
                    parentIsFactory: bool = false
                    if parentFuncName.ln > 0 {
                        fr dec of userDecorators {
                            if dec == parentFuncName { parentIsDecor = true }
                        }
                        fr fac of decoratorFactories {
                            if fac == parentFuncName { parentIsFactory = true }
                        }
                    }
                    if parentIsDecor {
                        fr pNode of prog.children {
                            if pNode.kind == NodeKind.FuncDecl && pNode.name == parentFuncName {
                                if parentIsFactory {
                                    if pNode.params.ln > 0 {
                                        exprGen.setDecorRole pNode.params[0].name, 3
                                    }
                                    if topNode.params.ln > 0 {
                                        exprGen.setDecorRole topNode.params[0].name, 1
                                    }
                                    if topNode.params.ln > 1 {
                                        exprGen.setDecorRole topNode.params[1].name, 2
                                    }
                                } els {
                                    if pNode.params.ln > 0 {
                                        exprGen.setDecorRole pNode.params[0].name, 1
                                    }
                                    if pNode.params.ln > 1 {
                                        exprGen.setDecorRole pNode.params[1].name, 2
                                    }
                                }
                            }
                        }
                    }

                    retLLVM: str = (topNode.typeAnnotation == "void" ? "void" : (topNode.typeAnnotation == "str" ? "ptr" : "i64"))
                    paramsSig: str = ""
                    isFirstP = true
                    fr p of topNode.params {
                        pLLVM: str = "i64"
                        if p.isRest {
                            pLLVM = "ptr"
                        } els if p.typeAnnotation == "str" || p.typeAnnotation == "ptr" || p.typeAnnotation == "arr" || StrEndsWith(p.typeAnnotation, "[]") {
                            pLLVM = "ptr"
                        } els if p.typeAnnotation == "bool" {
                            pLLVM = "i1"
                        } els if p.typeAnnotation == "i32" {
                            pLLVM = "i32"
                        } els if p.typeAnnotation == "num" || p.typeAnnotation == "double" {
                            pLLVM = "double"
                        }
                        if !isFirstP {
                            paramsSig = paramsSig + ", "
                        }
                        paramsSig = paramsSig + pLLVM + " %arg_" + p.name
                        isFirstP = false
                    }
                    cg.startFunction("define " + retLLVM + " @" + topNode.name + "(" + paramsSig + ") {")
                    if retLLVM == "void" {
                        stmtGen.setReturnType(TypeKind.Void)
                    } els if retLLVM == "ptr" && topNode.typeAnnotation == "str" {
                        stmtGen.setReturnType(TypeKind.Str)
                    } els {
                        stmtGen.setReturnType(TypeKind.I64)
                    }

                    prmReg: str = ""
                    prevModeReg: str = ""
                    if topNode.isAsync {
                        asyncMode: num = 1
                        if topNode.val == "st" {
                            asyncMode = 0
                        }
                        prevModeReg = cg.newReg
                        cg.emit(`${prevModeReg} = call i32 @zuv_get_async_context()`)
                        cg.emit(`call void @zuv_set_async_context(i32 ${asyncMode})`)
                        prmReg = cg.newReg
                        cg.emit(`${prmReg} = call ptr @zuv_prm_new(i32 ${asyncMode})`)
                        stmtGen.setAsyncFunc(prmReg, prevModeReg)
                    }

                    fr p of topNode.params {
                        if p.isRest {
                            slotReg: str = cg.newReg
                            cg.emit `${slotReg} = alloca ptr`
                            cg.emit `store ptr %arg_${p.name}, ptr ${slotReg}`
                            exprGen.addSymbol(p.name, slotReg, TypeKind.Arr, true, true)
                        } els {
                            pLLVM: str = "i64"
                            pKind = TypeKind.Unknown
                            if p.typeAnnotation == "str" || p.typeAnnotation == "ptr" {
                                pLLVM = "ptr"
                                pKind = TypeKind.Str
                            } els if p.typeAnnotation == "arr" || StrEndsWith(p.typeAnnotation, "[]") {
                                pLLVM = "ptr"
                                pKind = TypeKind.Arr
                            } els if p.typeAnnotation == "bool" {
                                pLLVM = "i1"
                                pKind = TypeKind.Bool
                            } els if p.typeAnnotation == "i32" {
                                pLLVM = "i32"
                                pKind = TypeKind.I32
                            } els if p.typeAnnotation == "num" || p.typeAnnotation == "double" {
                                pLLVM = "double"
                                pKind = TypeKind.Num
                            }
                            slotReg: str = cg.newReg
                            cg.emit(`${slotReg} = alloca ${pLLVM}`)
                            cg.emit(`store ${pLLVM} %arg_${p.name}, ptr ${slotReg}`)
                            exprGen.addSymbol(p.name, slotReg, pKind, false, true)
                        }
                    }

                    hasExplicitRet: bool = false
                    if topNode.children.ln > 0 {
                        bodyBlock: ASTNode = topNode.children[0]
                        fr bodyStmt of bodyBlock.children {
                            stmtGen.emitStmt(bodyStmt)
                        }
                        if bodyBlock.children.ln > 0 {
                            lastStmt: ASTNode = bodyBlock.children[bodyBlock.children.ln - 1]
                            if lastStmt.kind == NodeKind.RetStmt {
                                hasExplicitRet = true
                            }
                        }
                    }

                    if topNode.isAsync {
                        if !hasExplicitRet {
                            cg.emit(`call void @zuv_prm_resolve(ptr ${prmReg}, i64 0)`)
                            if prevModeReg.ln > 0 {
                                cg.emit(`call void @zuv_set_async_context(i32 ${prevModeReg})`)
                            }
                            prmInt: str = cg.newReg
                            cg.emit(`${prmInt} = ptrtoint ptr ${prmReg} to i64`)
                            cg.emit(`ret i64 ${prmInt}`)
                        }
                        stmtGen.clearAsyncFunc()
                    } els {
                        if !hasExplicitRet {
                            if retLLVM == "void" {
                                cg.emit("ret void")
                            } els if retLLVM == "ptr" {
                                cg.emit("ret ptr null")
                            } els {
                                cg.emit("ret i64 0")
                            }
                        }
                    }
                    cg.finishFunction()
                }
            }
        }

        // Emit @main function
        exprGen.clearSymbols()
        if hasExplicitMain {
            cg.startFunction("define i32 @main(i32 %argc, ptr %argv) {")
            rtGen.emitInitArgsCall(file)
            rtGen.emitInitCrashHandlerCall()
            cg.emitExtern("@zuv_global_glb = global ptr null")
            glbMem: str = cg.newReg
            cg.emit(`${glbMem} = call ptr @malloc(i64 8192)`)
            cg.emit(`call ptr @memset(ptr ${glbMem}, i32 0, i64 8192)`)
            cg.emit(`store ptr ${glbMem}, ptr @zuv_global_glb`)

            // 1. Initialize decorated free functions
            fr topNode of prog.children {
                if topNode.kind == NodeKind.FuncDecl && topNode.name != "main" {
                    fr attr of topNode.attributes {
                        aName: str = attr.name
                        isUserDec: bool = false
                        fr uDec of userDecorators {
                            if uDec == aName { isUserDec = true }
                        }
                        if isUserDec {
                            fnName: str = topNode.name
                            fnBits: str = cg.newReg
                            cg.emit `${fnBits} = ptrtoint ptr @${fnName} to i64`
                            cg.emit `store i64 ${fnBits}, ptr @${fnName}_orig`

                            ctxAlloc: str = cg.newReg
                            cg.emit `${ctxAlloc} = call ptr @malloc(i64 8192)`
                            cg.emit `call ptr @memset(ptr ${ctxAlloc}, i32 0, i64 8192)`
                            nameConst: str = cg.addStringConstant fnName
                            nameBits: str = cg.newReg
                            cg.emit `${nameBits} = ptrtoint ptr ${nameConst} to i64`
                            cg.emit `store i64 ${nameBits}, ptr ${ctxAlloc}`
                            ctxGep: str = cg.newReg
                            cg.emit `${ctxGep} = getelementptr inbounds i64, ptr ${ctxAlloc}, i64 5`
                            cg.emit `store i64 ${nameBits}, ptr ${ctxGep}`
                            ctxInt: str = cg.newReg
                            cg.emit `${ctxInt} = ptrtoint ptr ${ctxAlloc} to i64`
                            cg.emit `store i64 ${ctxInt}, ptr @${fnName}_ctx`

                            cg.emit `store i64 ${fnBits}, ptr @__active_decor_orig`
                            cg.emit `store i64 ${ctxInt}, ptr @__active_decor_ctx`

                            if attr.args.ln > 0 {
                                rawArg: str = attr.args[0]
                                if rawArg.ln >= 2 && ((rawArg[0] == 34 && rawArg[rawArg.ln - 1] == 34) || (rawArg[0] == 39 && rawArg[rawArg.ln - 1] == 39)) {
                                    rawArg = rawArg.sub 1, (rawArg.ln - 2)
                                }
                                argConst: str = cg.addStringConstant rawArg
                                argBits: str = cg.newReg
                                cg.emit `${argBits} = ptrtoint ptr ${argConst} to i64`
                                cg.emit `store i64 ${argBits}, ptr @__active_factory_arg`
                                facRes: str = cg.newReg
                                cg.emit `${facRes} = call i64 @${aName}(i64 ${argBits})`
                                facPtr: str = cg.newReg
                                cg.emit `${facPtr} = inttoptr i64 ${facRes} to ptr`
                                wrapRes: str = cg.newReg
                                cg.emit `${wrapRes} = call i64 ${facPtr}(i64 ${fnBits}, i64 ${ctxInt})`
                                cg.emit `store i64 ${wrapRes}, ptr @${fnName}_fnptr`
                            } els {
                                wrapRes: str = cg.newReg
                                cg.emit `${wrapRes} = call i64 @${aName}(i64 ${fnBits}, i64 ${ctxInt})`
                                cg.emit `store i64 ${wrapRes}, ptr @${fnName}_fnptr`
                            }
                        }
                    }
                }
            }

            // 2. Initialize Object prototypes and Class Decorators
            fr topNode of prog.children {
                if topNode.kind == NodeKind.ObjDecl {
                    protoReg: str = "@" + topNode.name + "_prototype"
                    pAlloc: str = cg.newReg
                    cg.emit `${pAlloc} = call ptr @malloc(i64 8192)`
                    cg.emit `call ptr @memset(ptr ${pAlloc}, i32 0, i64 8192)`
                    pAllocInt: str = cg.newReg
                    cg.emit `${pAllocInt} = ptrtoint ptr ${pAlloc} to i64`
                    cg.emit `store i64 ${pAllocInt}, ptr ${protoReg}`

                    fr attr of topNode.attributes {
                        aName: str = attr.name
                        isUserDec: bool = false
                        fr uDec of userDecorators {
                            if uDec == aName { isUserDec = true }
                        }
                        if isUserDec {
                            cg.emit `call i64 @${aName}(i64 ${pAllocInt})`
                        }
                    }
                }
            }

            // 3. Initialize decorated methods
            fr topNode of prog.children {
                if topNode.kind == NodeKind.ObjDecl {
                    fr mNode of topNode.children {
                        fr mAttr of mNode.attributes {
                            aName: str = mAttr.name
                            isUserDec: bool = false
                            fr uDec of userDecorators {
                                if uDec == aName { isUserDec = true }
                            }
                            if isUserDec {
                                mangledName: str = topNode.name + "_" + mNode.name
                                fnBits: str = cg.newReg
                                cg.emit `${fnBits} = ptrtoint ptr @${mangledName} to i64`
                                cg.emit `store i64 ${fnBits}, ptr @${mangledName}_orig`

                                ctxAlloc: str = cg.newReg
                                cg.emit `${ctxAlloc} = call ptr @malloc(i64 8192)`
                                cg.emit `call ptr @memset(ptr ${ctxAlloc}, i32 0, i64 8192)`
                                nameConst: str = cg.addStringConstant mNode.name
                                nameBits: str = cg.newReg
                                cg.emit `${nameBits} = ptrtoint ptr ${nameConst} to i64`
                                cg.emit `store i64 ${nameBits}, ptr ${ctxAlloc}`
                                ctxGep: str = cg.newReg
                                cg.emit `${ctxGep} = getelementptr inbounds i64, ptr ${ctxAlloc}, i64 5`
                                cg.emit `store i64 ${nameBits}, ptr ${ctxGep}`
                                ctxInt: str = cg.newReg
                                cg.emit `${ctxInt} = ptrtoint ptr ${ctxAlloc} to i64`
                                cg.emit `store i64 ${ctxInt}, ptr @${mangledName}_ctx`

                                cg.emit `store i64 ${fnBits}, ptr @__active_decor_orig`
                                cg.emit `store i64 ${ctxInt}, ptr @__active_decor_ctx`

                                if mAttr.args.ln > 0 {
                                    rawArg: str = mAttr.args[0]
                                    if rawArg.ln >= 2 && ((rawArg[0] == 34 && rawArg[rawArg.ln - 1] == 34) || (rawArg[0] == 39 && rawArg[rawArg.ln - 1] == 39)) {
                                        rawArg = rawArg.sub 1, (rawArg.ln - 2)
                                    }
                                    argConst: str = cg.addStringConstant rawArg
                                    argBits: str = cg.newReg
                                    cg.emit `${argBits} = ptrtoint ptr ${argConst} to i64`
                                    cg.emit `store i64 ${argBits}, ptr @__active_factory_arg`
                                    facRes: str = cg.newReg
                                    cg.emit `${facRes} = call i64 @${aName}(i64 ${argBits})`
                                    facPtr: str = cg.newReg
                                    cg.emit `${facPtr} = inttoptr i64 ${facRes} to ptr`
                                    wrapRes: str = cg.newReg
                                    cg.emit `${wrapRes} = call i64 ${facPtr}(i64 ${fnBits}, i64 ${ctxInt})`
                                    cg.emit `store i64 ${wrapRes}, ptr @${mangledName}_fnptr`
                                } els {
                                    wrapRes: str = cg.newReg
                                    cg.emit `${wrapRes} = call i64 @${aName}(i64 ${fnBits}, i64 ${ctxInt})`
                                    cg.emit `store i64 ${wrapRes}, ptr @${mangledName}_fnptr`
                                }
                            }
                        }
                    }
                }
            }

            stmtGen.setReturnType(TypeKind.I32)
            stmtGen.setTopLevel(true)
            fr topStmt of topLevelStmts {
                stmtGen.emitStmt(topStmt)
            }
            if mainNode.children.ln > 0 {
                bodyBlock: ASTNode = mainNode.children[0]
                fr bodyStmt of bodyBlock.children {
                    stmtGen.emitStmt(bodyStmt)
                }
            }
            cg.emit("ret i32 0")
            cg.finishFunction()
        } els if !(isCdylib) {
            cg.startFunction("define i32 @main(i32 %argc, ptr %argv) {")
            rtGen.emitInitArgsCall(file)
            rtGen.emitInitCrashHandlerCall()
            cg.emitExtern("@zuv_global_glb = global ptr null")
            glbMem: str = cg.newReg
            cg.emit(`${glbMem} = call ptr @malloc(i64 8192)`)
            cg.emit(`call ptr @memset(ptr ${glbMem}, i32 0, i64 8192)`)
            cg.emit(`store ptr ${glbMem}, ptr @zuv_global_glb`)

            // 1. Initialize decorated free functions
            fr topNode of prog.children {
                if topNode.kind == NodeKind.FuncDecl && topNode.name != "main" {
                    fr attr of topNode.attributes {
                        aName: str = attr.name
                        isUserDec: bool = false
                        fr uDec of userDecorators {
                            if uDec == aName { isUserDec = true }
                        }
                        if isUserDec {
                            fnName: str = topNode.name
                            fnBits: str = cg.newReg
                            cg.emit `${fnBits} = ptrtoint ptr @${fnName} to i64`
                            cg.emit `store i64 ${fnBits}, ptr @${fnName}_orig`

                            ctxAlloc: str = cg.newReg
                            cg.emit `${ctxAlloc} = call ptr @malloc(i64 8192)`
                            cg.emit `call ptr @memset(ptr ${ctxAlloc}, i32 0, i64 8192)`
                            nameConst: str = cg.addStringConstant fnName
                            nameBits: str = cg.newReg
                            cg.emit `${nameBits} = ptrtoint ptr ${nameConst} to i64`
                            cg.emit `store i64 ${nameBits}, ptr ${ctxAlloc}`
                            ctxGep: str = cg.newReg
                            cg.emit `${ctxGep} = getelementptr inbounds i64, ptr ${ctxAlloc}, i64 5`
                            cg.emit `store i64 ${nameBits}, ptr ${ctxGep}`
                            ctxInt: str = cg.newReg
                            cg.emit `${ctxInt} = ptrtoint ptr ${ctxAlloc} to i64`
                            cg.emit `store i64 ${ctxInt}, ptr @${fnName}_ctx`

                            cg.emit `store i64 ${fnBits}, ptr @__active_decor_orig`
                            cg.emit `store i64 ${ctxInt}, ptr @__active_decor_ctx`

                            if attr.args.ln > 0 {
                                rawArg: str = attr.args[0]
                                if rawArg.ln >= 2 && ((rawArg[0] == 34 && rawArg[rawArg.ln - 1] == 34) || (rawArg[0] == 39 && rawArg[rawArg.ln - 1] == 39)) {
                                    rawArg = rawArg.sub 1, (rawArg.ln - 2)
                                }
                                argConst: str = cg.addStringConstant rawArg
                                argBits: str = cg.newReg
                                cg.emit `${argBits} = ptrtoint ptr ${argConst} to i64`
                                cg.emit `store i64 ${argBits}, ptr @__active_factory_arg`
                                facRes: str = cg.newReg
                                cg.emit `${facRes} = call i64 @${aName}(i64 ${argBits})`
                                facPtr: str = cg.newReg
                                cg.emit `${facPtr} = inttoptr i64 ${facRes} to ptr`
                                wrapRes: str = cg.newReg
                                cg.emit `${wrapRes} = call i64 ${facPtr}(i64 ${fnBits}, i64 ${ctxInt})`
                                cg.emit `store i64 ${wrapRes}, ptr @${fnName}_fnptr`
                            } els {
                                wrapRes: str = cg.newReg
                                cg.emit `${wrapRes} = call i64 @${aName}(i64 ${fnBits}, i64 ${ctxInt})`
                                cg.emit `store i64 ${wrapRes}, ptr @${fnName}_fnptr`
                            }
                        }
                    }
                }
            }

            // 2. Initialize Object prototypes and Class Decorators
            fr topNode of prog.children {
                if topNode.kind == NodeKind.ObjDecl {
                    protoReg: str = "@" + topNode.name + "_prototype"
                    pAlloc: str = cg.newReg
                    cg.emit `${pAlloc} = call ptr @malloc(i64 8192)`
                    cg.emit `call ptr @memset(ptr ${pAlloc}, i32 0, i64 8192)`
                    pAllocInt: str = cg.newReg
                    cg.emit `${pAllocInt} = ptrtoint ptr ${pAlloc} to i64`
                    cg.emit `store i64 ${pAllocInt}, ptr ${protoReg}`

                    fr attr of topNode.attributes {
                        aName: str = attr.name
                        isUserDec: bool = false
                        fr uDec of userDecorators {
                            if uDec == aName { isUserDec = true }
                        }
                        if isUserDec {
                            cg.emit `call i64 @${aName}(i64 ${pAllocInt})`
                        }
                    }
                }
            }

            // 3. Initialize decorated methods
            fr topNode of prog.children {
                if topNode.kind == NodeKind.ObjDecl {
                    fr mNode of topNode.children {
                        fr mAttr of mNode.attributes {
                            aName: str = mAttr.name
                            isUserDec: bool = false
                            fr uDec of userDecorators {
                                if uDec == aName { isUserDec = true }
                            }
                            if isUserDec {
                                mangledName: str = topNode.name + "_" + mNode.name
                                fnBits: str = cg.newReg
                                cg.emit `${fnBits} = ptrtoint ptr @${mangledName} to i64`
                                cg.emit `store i64 ${fnBits}, ptr @${mangledName}_orig`

                                ctxAlloc: str = cg.newReg
                                cg.emit `${ctxAlloc} = call ptr @malloc(i64 8192)`
                                cg.emit `call ptr @memset(ptr ${ctxAlloc}, i32 0, i64 8192)`
                                nameConst: str = cg.addStringConstant mNode.name
                                nameBits: str = cg.newReg
                                cg.emit `${nameBits} = ptrtoint ptr ${nameConst} to i64`
                                cg.emit `store i64 ${nameBits}, ptr ${ctxAlloc}`
                                ctxGep: str = cg.newReg
                                cg.emit `${ctxGep} = getelementptr inbounds i64, ptr ${ctxAlloc}, i64 5`
                                cg.emit `store i64 ${nameBits}, ptr ${ctxGep}`
                                ctxInt: str = cg.newReg
                                cg.emit `${ctxInt} = ptrtoint ptr ${ctxAlloc} to i64`
                                cg.emit `store i64 ${ctxInt}, ptr @${mangledName}_ctx`

                                cg.emit `store i64 ${fnBits}, ptr @__active_decor_orig`
                                cg.emit `store i64 ${ctxInt}, ptr @__active_decor_ctx`

                                if mAttr.args.ln > 0 {
                                    rawArg: str = mAttr.args[0]
                                    if rawArg.ln >= 2 && ((rawArg[0] == 34 && rawArg[rawArg.ln - 1] == 34) || (rawArg[0] == 39 && rawArg[rawArg.ln - 1] == 39)) {
                                        rawArg = rawArg.sub 1, (rawArg.ln - 2)
                                    }
                                    argConst: str = cg.addStringConstant rawArg
                                    argBits: str = cg.newReg
                                    cg.emit `${argBits} = ptrtoint ptr ${argConst} to i64`
                                    cg.emit `store i64 ${argBits}, ptr @__active_factory_arg`
                                    facRes: str = cg.newReg
                                    cg.emit `${facRes} = call i64 @${aName}(i64 ${argBits})`
                                    facPtr: str = cg.newReg
                                    cg.emit `${facPtr} = inttoptr i64 ${facRes} to ptr`
                                    wrapRes: str = cg.newReg
                                    cg.emit `${wrapRes} = call i64 ${facPtr}(i64 ${fnBits}, i64 ${ctxInt})`
                                    cg.emit `store i64 ${wrapRes}, ptr @${mangledName}_fnptr`
                                } els {
                                    wrapRes: str = cg.newReg
                                    cg.emit `${wrapRes} = call i64 @${aName}(i64 ${fnBits}, i64 ${ctxInt})`
                                    cg.emit `store i64 ${wrapRes}, ptr @${mangledName}_fnptr`
                                }
                            }
                        }
                    }
                }
            }

            stmtGen.setReturnType(TypeKind.I32)
            stmtGen.setTopLevel(true)
            fr topStmt of topLevelStmts {
                stmtGen.emitStmt(topStmt)
            }
            cg.emit("ret i32 0")
            cg.finishFunction()
        }

        moduleIR: str = cg.getModuleIR()

        if emitLlvm {
            llvmOut: str = targetExe
            if !(StrEndsWith(llvmOut, ".ll")) {
                llvmOut = llvmOut + ".ll"
            }
            wF llvmOut, moduleIR
            if !(isQuiet) {
                prnt "[zuv build] Emitted LLVM IR to " + llvmOut
            }
            -> 0
        }

        // 1. Emit native object file directly via in-process LLVM
        tmpObj: str = "_zuv_tmp_" + (time.now()) + ".obj"
        objRes: num = emitDirectObjectFile(moduleIR, tmpObj, isRelease, targetTriple)
        if objRes != 0 {
            prnt "[zuv build] In-process LLVM compilation failed"
            if fE tmpObj {
                rmF tmpObj
            }
            -> objRes
        }

        // 2. Link executable or library via lld-link
        linkRes: num = linkDirectObjectFile(tmpObj, targetExe, isCdylib, extMgr.getExternLibs())
        if fE tmpObj {
            rmF tmpObj
        }


        if linkRes == 0 {
            if !(isQuiet) {
                prnt "[zuv build] Successfully generated " + targetExe
            }
            -> 0
        }

        prnt "[zuv build] Compilation failed during linking (exit code " + linkRes + ")"
        -> 1

}
