/*
 * =============================================================================
 * Zuv Bootstrap Compiler — Common Utility Functions
 * Path: sub_projects/zuv/src/util/commonFunctions.zv
 * =============================================================================
 *
 * Implements shared utility functions for compiler analysis and type inference:
 * - IsIntegerLiteral: Validates whether a numeric literal string is an integer
 * - StrEndsWith: Checks whether a string ends with a given suffix string
 */

imp str

/**
 * Checks if a numeric literal string represents an integer without decimal point or exponent.
 *
 * @param {str} text - Number literal string
 * @returns {bool} True if integer literal format, false if float
 */
IsIntegerLiteral text: str :: bool {
    count = text.ln
    i = 0
    wh i < count {
        ch = text[i]
        if ch == "." || ch == "e" || ch == "E" {
            -> false
        }
        i++
    }
    -> true
}

/**
 * Checks whether a string ends with a given suffix string.
 *
 * @param {str} text - Input text string
 * @param {str} suffix - Target suffix to inspect
 * @returns {bool} True if text ends with suffix, false otherwise
 */
StrEndsWith text: str, suffix: str :: bool {
    tLen: num = text.ln
    sLen: num = suffix.ln
    if sLen > tLen || sLen == 0 {
        -> false
    }
    subStr: str = text.slc(tLen - sLen, tLen)
    -> subStr == suffix
}
