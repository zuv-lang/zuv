// Full Static Semantic & Borrow Checker for Zuv Self-Hosting Compiler (src/checker.zv)
imp str, arr, diagnostics
imp createDiagnostic, formatDiagnostic frm diagnostics

createScope {
    let vars = []
    res = { vars: vars }
    -> res
}

createChecker {
    let scopes = []
    let errors = []
    globalScope = createScope
    scopes.psh globalScope
    // Built-in project-wide global object (immutable binding; properties are writable)
    glbVar = { name: "glb", isMut: 0, isMoved: 0, immBorrows: 0, mutBorrows: 0 }
    globalScope.vars.psh glbVar
    res = { scopes: scopes, errors: errors, inUnsafe: 0, filePath: "", sourceText: "" }
    -> res
}

pushCheckerScope checker {
    newScope = createScope
    checker.scopes.psh newScope
}

popCheckerScope checker {
    if checker.scopes.ln > 0 {
        checker.scopes.pp
    }
}

findVarState checker, name {
    let i = checker.scopes.ln - 1
    wh i >= 0 {
        sc = checker.scopes[i]
        let j = 0
        wh j < sc.vars.ln {
            v = sc.vars[j]
            if v.name == name {
                -> v
            }
            j = j + 1
        }
        i = i - 1
    }
    emptyVar = { name: "", isMut: 0, isMoved: 0, immBorrows: 0, mutBorrows: 0 }
    -> emptyVar
}

findVarInCurrentScope checker, name {
    curIdx = checker.scopes.ln - 1
    if curIdx >= 0 {
        curScope = checker.scopes[curIdx]
        let j = 0
        wh j < curScope.vars.ln {
            v = curScope.vars[j]
            if v.name == name {
                -> v
            }
            j = j + 1
        }
    }
    emptyVar = { name: "", isMut: 0, isMoved: 0, immBorrows: 0, mutBorrows: 0 }
    -> emptyVar
}

declareVar checker, name, isMut, line, col {
    existingInCurrent = findVarInCurrentScope checker, name
    if isMut == 1 {
        if existingInCurrent.name != "" {
            mut dLine = line
            mut dCol = col
            if dLine == und || dLine == nil || dLine <= 0 { dLine = 1 }
            if dCol == und || dCol == nil || dCol <= 0 { dCol = 1 }
            errRedecl = formatDiagnostic "E0201", `Variable '${name}' is already declared in this scope`, checker.filePath, dLine, dCol, name.ln, "duplicate declaration", "remove the duplicate 'let' / 'mut' or rename the variable", checker.sourceText
            checker.errors.psh errRedecl
        } els {
            curIdx = checker.scopes.ln - 1
            if curIdx >= 0 {
                curScope = checker.scopes[curIdx]
                newVar = { name: name, isMut: 1, isMoved: 0, immBorrows: 0, mutBorrows: 0 }
                curScope.vars.psh newVar
            }
        }
    } els {
        if existingInCurrent.name == "" {
            curIdx = checker.scopes.ln - 1
            if curIdx >= 0 {
                curScope = checker.scopes[curIdx]
                newVar = { name: name, isMut: 0, isMoved: 0, immBorrows: 0, mutBorrows: 0 }
                curScope.vars.psh newVar
            }
        }
    }
}

checkExpr checker, expr {
    if expr.kind == "VariableExpr" {
        v = findVarState checker, expr.name
        if v.name != "" && v.isMoved == 1 {
            errVal = `error[E0202]: Use of moved value: '${expr.name}'`
            checker.errors.psh errVal
        }
    } els if expr.kind == "UnaryExpr" {
        if expr.op == "&mut" || expr.op == "&" {
            if expr.right.kind == "VariableExpr" {
                vName = expr.right.name
                v = findVarState checker, vName
                if v.name != "" {
                    if v.isMoved == 1 {
                        errMoved = `error[E0202]: Cannot borrow moved value: '${vName}'`
                        checker.errors.psh errMoved
                    }
                    if expr.op == "&mut" {
                        if v.isMut == 0 {
                            errImmut = `error[E0203]: Cannot borrow immutable variable '${vName}' as mutable (&mut)`
                            checker.errors.psh errImmut
                        }
                        if v.immBorrows > 0 || v.mutBorrows > 0 {
                            errActive = `error[E0204]: Cannot borrow '${vName}' as mutable (&mut) because it is already borrowed`
                            checker.errors.psh errActive
                        }
                        v.mutBorrows = v.mutBorrows + 1
                    } els {
                        if v.mutBorrows > 0 {
                            errMut = `error[E0204]: Cannot borrow '${vName}' as immutable (&) because it is borrowed as mutable (&mut)`
                            checker.errors.psh errMut
                        }
                        v.immBorrows = v.immBorrows + 1
                    }
                }
            } els {
                checkExpr checker, expr.right
            }
        } els if expr.op == "++" || expr.op == "--" {
            if expr.right.kind == "VariableExpr" {
                vName = expr.right.name
                v = findVarState checker, vName
                if v.name != "" && v.isMut == 0 {
                    errImmut = `error[E0203]: Cannot mutate immutable variable: '${vName}'`
                    checker.errors.psh errImmut
                }
            }
            checkExpr checker, expr.right
        } els {
            checkExpr checker, expr.right
        }
    } els if expr.kind == "DerefExpr" {
        if checker.inUnsafe == 0 {
            checker.errors.psh "error[E0205]: Dereference of raw pointer requires unsafe block"
        }
        checkExpr checker, expr.operand
    } els if expr.kind == "BinaryExpr" {
        if expr.op == "=" {
            if expr.left.kind == "VariableExpr" {
                vName = expr.left.name
                v = findVarState checker, vName
                if v.name != "" && v.isMut == 0 {
                    errMutate = `error[E0203]: Cannot mutate immutable variable: '${vName}'`
                    checker.errors.psh errMutate
                }
            }
        }
        checkExpr checker, expr.left
        checkExpr checker, expr.right
    } els if expr.kind == "CallExpr" {
        let i = 0
        wh i < expr.args.ln {
            arg = expr.args[i]
            checkExpr checker, arg
            i = i + 1
        }
    } els if expr.kind == "ArrayExpr" {
        let i = 0
        wh i < expr.elements.ln {
            elem = expr.elements[i]
            checkExpr checker, elem
            i = i + 1
        }
    } els if expr.kind == "IndexExpr" {
        checkExpr checker, expr.array
        checkExpr checker, expr.index
    } els if expr.kind == "PropertyAccess" {
        checkExpr checker, expr.object
    } els if expr.kind == "StructLiteral" {
        let i = 0
        wh i < expr.fields.ln {
            f = expr.fields[i]
            if f.value.kind != "" {
                checkExpr checker, f.value
            }
            i = i + 1
        }
    } els if expr.kind == "NewExpr" {
        let i = 0
        wh i < expr.fields.ln {
            f = expr.fields[i]
            if f.value.kind != "" {
                checkExpr checker, f.value
            }
            i = i + 1
        }
        let j = 0
        wh j < expr.args.ln {
            a = expr.args[j]
            checkExpr checker, a
            j = j + 1
        }
    }
}

checkStatement checker, stmt {
    if stmt.kind == "VarDecl" {
        // Allow explicit nil/und literals; reject missing/placeholder inits
        if stmt.value.kind == "" {
            checker.errors.psh (`Semantic Error: Invalid variable initialization for '${stmt.name}'`)
        } els if stmt.value.kind == "NilExpr" {
            if stmt.value.val != "nil" && stmt.value.val != "und" {
                checker.errors.psh (`Semantic Error: Invalid variable initialization for '${stmt.name}'`)
            }
        }
        checkExpr checker, stmt.value
        declareVar checker, stmt.name, stmt.isMut, stmt.line, stmt.col
    } els if stmt.kind == "DestructureStmt" {
        checkExpr checker, stmt.source
        let di = 0
        wh di < stmt.bindNames.ln {
            dName = stmt.bindNames[di]
            if dName != "" {
                declareVar checker, dName, stmt.isMut
            }
            di = di + 1
        }
    } els if stmt.kind == "StmtSequence" {
        let si = 0
        wh si < stmt.statements.ln {
            s = stmt.statements[si]
            checkStatement checker, s
            si = si + 1
        }
    } els if stmt.kind == "FunctionDecl" {
        declareVar checker, stmt.name, 0
        pushCheckerScope checker
        let i = 0
        wh i < stmt.params.ln {
            pName = stmt.params[i]
            if pName != "" {
                declareVar checker, pName, 0
            }
            i = i + 1
        }
        if stmt.body.kind == "BlockStmt" {
            let j = 0
            wh j < stmt.body.statements.ln {
                s = stmt.body.statements[j]
                checkStatement checker, s
                j = j + 1
            }
        }
        popCheckerScope checker
    } els if stmt.kind == "UnsafeBlock" {
        prev = checker.inUnsafe
        checker.inUnsafe = 1
        if stmt.body.kind == "BlockStmt" {
            pushCheckerScope checker
            let i = 0
            wh i < stmt.body.statements.ln {
                s = stmt.body.statements[i]
                checkStatement checker, s
                i = i + 1
            }
            popCheckerScope checker
        }
        checker.inUnsafe = prev
    } els if stmt.kind == "BlockStmt" {
        pushCheckerScope checker
        let i = 0
        wh i < stmt.statements.ln {
            s = stmt.statements[i]
            checkStatement checker, s
            i = i + 1
        }
        popCheckerScope checker
    } els if stmt.kind == "IfStmt" {
        checkExpr checker, stmt.condition
        checkStatement checker, stmt.thenBranch
        if stmt.elseBranch.kind != "NilExpr" && stmt.elseBranch.kind != "" {
            checkStatement checker, stmt.elseBranch
        }
    } els if stmt.kind == "WhileStmt" {
        checkExpr checker, stmt.condition
        checkStatement checker, stmt.body
    } els if stmt.kind == "ForStmt" {
        pushCheckerScope checker
        if stmt.init.kind == "VarDecl" {
            declareVar checker, stmt.init.name, 1
        } els if stmt.init.kind == "StmtSequence" {
            let si = 0
            wh si < stmt.init.statements.ln {
                s = stmt.init.statements[si]
                if s.kind == "VarDecl" {
                    declareVar checker, s.name, 1
                } els if s.kind != "" {
                    checkStatement checker, s
                }
                si = si + 1
            }
        } els if stmt.init.kind != "" {
            checkStatement checker, stmt.init
        }
        if stmt.condition.kind != "" {
            checkExpr checker, stmt.condition
        }
        if stmt.increment.kind != "" {
            checkStatement checker, stmt.increment
        }
        checkStatement checker, stmt.body
        popCheckerScope checker
    } els if stmt.kind == "ReturnStmt" {
        checkExpr checker, stmt.value
    } els if stmt.kind == "PrintStmt" {
        checkExpr checker, stmt.value
    } els if stmt.kind == "ExpressionStmt" {
        checkExpr checker, stmt.expr
    } els if stmt.kind == "ImportStmt" {
        let si = 0
        wh si < stmt.symbols.ln {
            impName = stmt.symbols[si]
            if impName != "" {
                declareVar checker, impName, 0
            }
            si = si + 1
        }
        let pi = 0
        wh pi < stmt.paths.ln {
            p = stmt.paths[pi]
            if p != "" {
                declareVar checker, p, 0
            }
            pi = pi + 1
        }
    } els if stmt.kind == "MatchStmt" {
        checkExpr checker, stmt.target
        pushCheckerScope checker
        if stmt.okVar != "" {
            declareVar checker, stmt.okVar, 0
        }
        if stmt.okBody.kind != "" {
            checkStatement checker, stmt.okBody
        }
        popCheckerScope checker
        pushCheckerScope checker
        if stmt.errVar != "" {
            declareVar checker, stmt.errVar, 0
        }
        if stmt.errBody.kind != "" {
            checkStatement checker, stmt.errBody
        }
        popCheckerScope checker
    } els if stmt.kind == "TryStmt" {
        if stmt.tryBody.kind != "" {
            checkStatement checker, stmt.tryBody
        }
        if stmt.catchBody.kind != "" {
            pushCheckerScope checker
            if stmt.catchName != "" {
                declareVar checker, stmt.catchName, 0
            }
            checkStatement checker, stmt.catchBody
            popCheckerScope checker
        }
        if stmt.finallyBody.kind != "" {
            checkStatement checker, stmt.finallyBody
        }
    } els if stmt.kind == "ThrowStmt" {
        checkExpr checker, stmt.value
    } els if stmt.kind == "ExternDecl" {
        if stmt.name != "" {
            declareVar checker, stmt.name, 0
        }
    } els if stmt.kind == "ObjDecl" {
        declareVar checker, stmt.name, 0
        let mi = 0
        wh mi < stmt.methods.ln {
            m = stmt.methods[mi]
            pushCheckerScope checker
            declareVar checker, "self", 0
            let pi = 0
            wh pi < m.params.ln {
                p = m.params[pi]
                declareVar checker, p.name, 0
                pi = pi + 1
            }
            if m.body.kind != "" {
                checkStatement checker, m.body
            }
            popCheckerScope checker
            mi = mi + 1
        }
    } els {
        checkExpr checker, stmt
    }
}

checkProgram program, filePath, sourceText {
    checker = createChecker
    mut fPath = filePath
    if fPath == und || fPath == nil { fPath = "" }
    mut src = sourceText
    if src == und || src == nil { src = "" }
    checker.filePath = fPath
    checker.sourceText = src
    let i = 0
    wh i < program.statements.ln {
        stmt = program.statements[i]
        checkStatement checker, stmt
        i = i + 1
    }

    if checker.errors.ln > 0 {
        let ei = 0
        wh ei < checker.errors.ln {
            program.errors.psh checker.errors[ei]
            ei = ei + 1
        }
        -> 0
    }

    -> 1
}
