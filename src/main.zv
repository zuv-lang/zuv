// Zuv Self-Hosting Compiler Main Entry Point (src/main.zv)
imp str, arr, fs, time
imp handleBuild, handleCheck, handleCheckAll, handleTest, handleRun, handleFmt frm cli
imp createLexer, tokenizeFull frm lexer
imp parseProgramFull frm parser

main cmd, fileArg, arg3, arg4 {
    let targetFile = fileArg
    if targetFile == "" {
        if fE "src/main.zv" {
            targetFile = "src/main.zv"
        } els {
            targetFile = "main.zv"
        }
    }

    let isRelease = 0
    let emitLlvm = 0
    let outExe = "output.exe"

    if arg3 == "-o" && arg4 != "" {
        outExe = arg4
    }
    if arg3 == "--release" || arg3 == "-r" {
        isRelease = 1
    }
    if arg3 == "--emit-llvm" || arg3 == "-S" {
        emitLlvm = 1
    }
    if arg4 == "--release" || arg4 == "-r" {
        isRelease = 1
    }

    if cmd == "checkall" || cmd == "check-all" {
        handleCheckAll
    } els if cmd == "test" || cmd == "" {
        handleTest
    } els {
        if cmd == "check" {
            handleCheck targetFile
        } els {
            if cmd == "build" {
                handleBuild targetFile, isRelease, emitLlvm, outExe
            } els {
                if cmd == "run" {
                    handleRun targetFile
                } els {
                    if cmd == "fmt" {
                        handleFmt targetFile
                    } els {
                        if fE cmd {
                            handleCheck cmd
                        } els {
                            handleCheckAll
                        }
                    }
                }
            }
        }
    }
}

