// Zuv Self-Hosting Compiler Main Entry Point (src/main.zv)
imp str, arr, fs
imp handleBuild, handleCheck, handleTest frm cli

main cmd {
    if cmd == "test" {
        handleTest
    } els {
        prnt "==========================================="
        prnt "        Zuv Self-Hosting Compiler (zuv)"
        prnt "==========================================="

        handleBuild "src/main.zv", 1, 0
    }
}
