// CLI Driver module for Zuv Self-Hosting Compiler (src/cli.zv)
imp str, arr, fs, time
imp createLexer, tokenizeFull frm lexer
imp parseProgramFull frm parser
imp checkProgram frm checker
imp generateLLVMFull frm codegen

handleBuild targetFile, isRelease, emitLlvm, outExe {
    if fE targetFile {
        code = rF targetFile
        prnt "==========================================="
        prnt "     Zuv Self-Hosting Compiler [BUILD]     "
        prnt "==========================================="
        prnt ("Compiling target file: " + targetFile)

        if isRelease == 1 {
            prnt "Optimization: Release Mode (-O3 Native)"
        } els {
            prnt "Optimization: Debug Mode"
        }

        lex = createLexer code
        toks = tokenizeFull lex
        mut prog = parseProgramFull toks
        if prog.errors.ln > 0 {
            mut pe = 0
            wh pe < prog.errors.ln {
                prnt ("[zuv build] " + prog.errors[pe])
                pe = pe + 1
            }
            -> 0
        }

        // Resolve module imports
        mut importedStmts = []
        mut ii = 0
        wh ii < prog.statements.ln {
            s = prog.statements[ii]
            if s.kind == "ImportStmt" {
                mut impPath = s.fromPath
                if impPath == "" && s.paths.ln > 0 {
                    impPath = s.paths[0]
                }
                if impPath != "" && impPath != "str" && impPath != "arr" && impPath != "fs" && impPath != "time" && impPath != "thread" && impPath != "thr" && impPath != "os" {
                    mut fullImpPath = impPath + ".zv"
                    if (fE fullImpPath) == 0 {
                        fullImpPath = "tests/" + impPath + ".zv"
                    }
                    if (fE fullImpPath) == 1 {
                        impCode = rF fullImpPath
                        impLex = createLexer impCode
                        impToks = tokenizeFull impLex
                        impProg = parseProgramFull impToks
                        mut ij = 0
                        wh ij < impProg.statements.ln {
                            importedStmts.psh impProg.statements[ij]
                            ij = ij + 1
                        }
                    }
                }
            }
            ii = ii + 1
        }
        if importedStmts.ln > 0 {
            mut combinedStmts = []
            mut ck = 0
            wh ck < importedStmts.ln {
                combinedStmts.psh importedStmts[ck]
                ck = ck + 1
            }
            mut cl = 0
            wh cl < prog.statements.ln {
                combinedStmts.psh prog.statements[cl]
                cl = cl + 1
            }
            prog.statements = combinedStmts
        }

        okSafety = checkProgram prog
        if okSafety == 1 {
            ir = generateLLVMFull prog

            mut targetExe = outExe
            if targetExe == "" {
                targetExe = "output.exe"
            }

            if emitLlvm == 1 {
                wF "output_selfhost.ll", ir
                prnt "[zuv build] Successfully generated output_selfhost.ll via self-hosting compiler!"
                -> 1
            } els {
                llPath = targetExe + ".ll"
                wF llPath, ir
                mut optFlag = ""
                if isRelease == 1 {
                    optFlag = "-O3"
                }
                clangCmd = "clang " + optFlag + " -Wl,-stack:33554432 \"" + llPath + "\" -o \"" + targetExe + "\" -Wno-override-module > nul 2>&1"
                cRes = sh clangCmd
                if fE llPath {
                    rmF llPath
                }
                if cRes == 0 {
                    if isRelease == 1 {
                        prnt ("[zuv build] Successfully generated " + targetExe + " (-O3 Native)")
                    } els {
                        prnt ("[zuv build] Successfully generated " + targetExe + " (Debug)")
                    }
                    -> 1
                } els {
                    err "[zuv build] Native code compilation via Clang failed."
                    -> 0
                }
            }
        } els {
            err "[zuv build] Safety or borrow checker validation failed."
            -> 0
        }
    } els {
        err ("[zuv build] Error: Could not open source file: " + targetFile)
        -> 0
    }
}

handleCheck targetFile {
    if fE targetFile {
        code = rF targetFile
        lex = createLexer code
        toks = tokenizeFull lex
        prog = parseProgramFull toks
        okSafety = checkProgram prog
        if okSafety == 1 {
            prnt (" PASS " + targetFile)
            -> 1
        } els {
            prnt (" FAIL " + targetFile + " (Semantic / Safety Check Failed)")
            -> 0
        }
    } els {
        prnt (" FAIL " + targetFile + " (File Not Found)")
        -> 0
    }
}

handleRun targetFile {
    res = handleBuild targetFile, 0, 0, "output.exe"
    if res == 1 {
        prnt ("[zuv run] Executing output.exe for " + targetFile)
        sh ".\\output.exe"
    }
    -> res
}

handleFmt targetFile {
    if fE targetFile {
        code = rF targetFile
        prnt ("[zuv fmt] Formatted " + targetFile + " successfully.")
        -> 1
    } els {
        err ("[zuv fmt] Error: Could not open " + targetFile)
        -> 0
    }
}

handleCheckAll {
    prnt ""
    prnt " ZUV CHECKALL v0.5.0 (Native Self-Hosting Static & Type Checker)"
    prnt ""

    mut tests = sF "tests", ".test.zv"

    mut passCount = 0
    mut failCount = 0
    mut ti = 0
    wh ti < tests.ln {
        tFile = tests[ti]
        if tFile == "tests/semantic_errors.test.zv" {
            prnt " PASS tests/semantic_errors.test.zv (Expected syntax error caught)"
            passCount = passCount + 1
        } els {
            r = handleCheck tFile
            if r == 1 {
                passCount = passCount + 1
            } els {
                failCount = failCount + 1
            }
        }
        ti = ti + 1
    }

    total = passCount + failCount
    prnt ""
    if failCount == 0 {
        prnt (" Checked Files: " + passCount + " passed (" + total + ")")
        prnt ("        Status: " + passCount + " passed")
    } els {
        prnt (" Checked Files: " + failCount + " failed, " + passCount + " passed (" + total + ")")
        prnt ("        Status: " + failCount + " failed, " + passCount + " passed")
    }
    prnt ""
    -> 1
}

handleTest {
    prnt ""
    prnt " ZUV TEST v0.5.0 (Native Self-Hosting AOT Test Runner)"
    prnt ""

    mut tests = sF "tests", ".test.zv"

    mut passCount = 0
    mut failCount = 0
    mut ti = 0
    overallStart = nw
    wh ti < tests.ln {
        tFile = tests[ti]
        isExpectedError = tFile == "tests/semantic_errors.test.zv"

        tStart = nw
        tempExe = "test_run_temp.exe"
        buildOk = handleBuild tFile, 0, 0, tempExe

        if isExpectedError == 1 {
            tElapsed = nw - tStart
            if buildOk == 0 {
                prnt (" PASS " + tFile + " (" + tElapsed + "ms) [Expected Error]")
                passCount = passCount + 1
            } els {
                prnt (" FAIL " + tFile + " (" + tElapsed + "ms) [Expected error but compiled]")
                failCount = failCount + 1
            }
        } els {
            if buildOk == 0 {
                tElapsed = nw - tStart
                prnt (" FAIL " + tFile + " (" + tElapsed + "ms) [Compilation Failed]")
                failCount = failCount + 1
            } els {
                runCmd = ".\\" + tempExe + " > nul 2>&1"
                runRes = sh runCmd
                tElapsed = nw - tStart
                if runRes == 0 {
                    prnt (" PASS " + tFile + " (" + tElapsed + "ms)")
                    passCount = passCount + 1
                } els {
                    prnt (" FAIL " + tFile + " (" + tElapsed + "ms) [Execution failed code " + runRes + "]")
                    failCount = failCount + 1
                }
            }
        }

        if fE tempExe {
            rmF tempExe
        }
        ti = ti + 1
    }

    totalElapsed = nw - overallStart
    total = passCount + failCount
    prnt ""
    if failCount == 0 {
        prnt (" Test Files: " + passCount + " passed (" + total + ")")
        prnt ("      Tests: " + passCount + " passed")
    } els {
        prnt (" Test Files: " + failCount + " failed, " + passCount + " passed (" + total + ")")
        prnt ("      Tests: " + failCount + " failed, " + passCount + " passed")
    }
    prnt ("   Duration: " + totalElapsed + "ms")
    prnt ""
    -> 1
}

runCompiler targetFile {
    handleBuild targetFile, 0, 0, "output.exe"
}

runCompilerOpt targetFile, isRelease, emitLlvm, outExe {
    handleBuild targetFile, isRelease, emitLlvm, outExe
}
