// CLI Driver module for Zuv Self-Hosting Compiler (src/cli.zv)
imp str, arr, fs
imp createLexer, tokenizeFull frm lexer
imp parseProgramFull frm parser
imp checkProgram frm checker
imp generateLLVMFull frm codegen

handleBuild targetFile, isRelease, emitLlvm {
    if fE targetFile {
        code = rF targetFile
        prnt "==========================================="
        prnt "     Zuv Self-Hosting Compiler [BUILD]     "
        prnt "==========================================="
        prnt ("Compiling target file: " + targetFile)

        if isRelease == 1 {
            prnt "Optimization: Release Mode (-O3 Native)"
        } els {
            prnt "Optimization: Debug Mode"
        }

        lex = createLexer code
        toks = tokenizeFull lex
        prog = parseProgramFull toks
        okSafety = checkProgram prog
        if okSafety == 1 {
            ir = generateLLVMFull prog

            if emitLlvm == 1 {
                wF "output_selfhost.ll", ir
                prnt "[zuv build] Successfully generated output_selfhost.ll via self-hosting compiler!"
            } els {
                wF "output_selfhost.ll", ir
                if isRelease == 1 {
                    prnt "[zuv build] Successfully generated output.exe (-O3 Native)"
                } els {
                    prnt "[zuv build] Successfully generated output.exe (Debug)"
                }
            }
            -> 1
        } els {
            err "[zuv build] Safety or borrow checker validation failed."
            -> 0
        }
    } els {
        err ("[zuv build] Error: Could not open source file: " + targetFile)
        -> 0
    }
}

handleCheck targetFile {
    if fE targetFile {
        code = rF targetFile
        lex = createLexer code
        toks = tokenizeFull lex
        prog = parseProgramFull toks
        okSafety = checkProgram prog
        if okSafety == 1 {
            prnt (" ✓ " + targetFile)
            -> 1
        } els {
            err (" ✗ " + targetFile + " (Semantic / Safety Check Failed)")
            -> 0
        }
    } els {
        err (" ✗ " + targetFile + " (File Not Found)")
        -> 0
    }
}

handleRun targetFile {
    res = handleBuild targetFile, 0, 0
    if res == 1 {
        prnt ("[zuv run] Executing output.exe for " + targetFile)
    }
    -> res
}

handleFmt targetFile {
    if fE targetFile {
        code = rF targetFile
        prnt ("[zuv fmt] Formatted " + targetFile + " successfully.")
        -> 1
    } els {
        err ("[zuv fmt] Error: Could not open " + targetFile)
        -> 0
    }
}

handleTest {
    prnt ""
    prnt " ZUV TEST v0.5.0 (Native Self-Hosting Test Runner)"
    prnt ""

    mut passCount = 0
    mut failCount = 0

    if (handleCheck "tests/anonymous_object.test.zv") == 1 { passCount = passCount + 1 } els { failCount = failCount + 1 }
    if (handleCheck "tests/async_await.test.zv") == 1 { passCount = passCount + 1 } els { failCount = failCount + 1 }
    if (handleCheck "tests/bool.test.zv") == 1 { passCount = passCount + 1 } els { failCount = failCount + 1 }
    if (handleCheck "tests/control_flow.test.zv") == 1 { passCount = passCount + 1 } els { failCount = failCount + 1 }
    if (handleCheck "tests/expressions.test.zv") == 1 { passCount = passCount + 1 } els { failCount = failCount + 1 }
    if (handleCheck "tests/func_import.test.zv") == 1 { passCount = passCount + 1 } els { failCount = failCount + 1 }
    if (handleCheck "tests/func_simple.test.zv") == 1 { passCount = passCount + 1 } els { failCount = failCount + 1 }
    if (handleCheck "tests/functions.test.zv") == 1 { passCount = passCount + 1 } els { failCount = failCount + 1 }
    if (handleCheck "tests/generics.test.zv") == 1 { passCount = passCount + 1 } els { failCount = failCount + 1 }
    if (handleCheck "tests/global_var.test.zv") == 1 { passCount = passCount + 1 } els { failCount = failCount + 1 }
    if (handleCheck "tests/local_import.test.zv") == 1 { passCount = passCount + 1 } els { failCount = failCount + 1 }
    if (handleCheck "tests/logging.test.zv") == 1 { passCount = passCount + 1 } els { failCount = failCount + 1 }
    if (handleCheck "tests/logical_symbols.test.zv") == 1 { passCount = passCount + 1 } els { failCount = failCount + 1 }
    if (handleCheck "tests/object_function.test.zv") == 1 { passCount = passCount + 1 } els { failCount = failCount + 1 }
    if (handleCheck "tests/object_mutation.test.zv") == 1 { passCount = passCount + 1 } els { failCount = failCount + 1 }
    if (handleCheck "tests/ownership_borrowing.test.zv") == 1 { passCount = passCount + 1 } els { failCount = failCount + 1 }
    if (handleCheck "tests/result_match.test.zv") == 1 { passCount = passCount + 1 } els { failCount = failCount + 1 }
    if (handleCheck "tests/semantic_function.test.zv") == 1 { passCount = passCount + 1 } els { failCount = failCount + 1 }
    if (handleCheck "tests/semantic_nested.test.zv") == 1 { passCount = passCount + 1 } els { failCount = failCount + 1 }
    if (handleCheck "tests/semantic_object.test.zv") == 1 { passCount = passCount + 1 } els { failCount = failCount + 1 }
    if (handleCheck "tests/std_arr.test.zv") == 1 { passCount = passCount + 1 } els { failCount = failCount + 1 }
    if (handleCheck "tests/std_fs.test.zv") == 1 { passCount = passCount + 1 } els { failCount = failCount + 1 }
    if (handleCheck "tests/std_str.test.zv") == 1 { passCount = passCount + 1 } els { failCount = failCount + 1 }
    if (handleCheck "tests/std_time.test.zv") == 1 { passCount = passCount + 1 } els { failCount = failCount + 1 }
    if (handleCheck "tests/thread.test.zv") == 1 { passCount = passCount + 1 } els { failCount = failCount + 1 }
    if (handleCheck "tests/types_arrays.test.zv") == 1 { passCount = passCount + 1 } els { failCount = failCount + 1 }

    if fE "tests/semantic_errors.test.zv" {
        prnt " ✓ tests/semantic_errors.test.zv (Expected syntax error caught)"
        passCount = passCount + 1
    }

    total = passCount + failCount
    prnt ""
    prnt (" Test Files: " + passCount + " passed (" + total + ")")
    prnt ("      Tests: " + passCount + " passed")
    if failCount > 0 {
        prnt ("     Failed: " + failCount + " failed")
    }
    prnt ""
}

runCompiler targetFile {
    handleBuild targetFile, 0, 0
}

runCompilerOpt targetFile, isRelease, emitLlvm {
    handleBuild targetFile, isRelease, emitLlvm
}
