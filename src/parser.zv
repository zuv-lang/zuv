// AST Nodes & Full Recursive Descent Parser for Zuv Self-Hosting Compiler (src/parser.zv)
imp str, arr, diagnostics
imp CreateToken frm tokens
imp CreateDiagnostic, FormatDiagnostic frm diagnostics
imp IsUpperChar frm util

// ── Precedence Constants ─────────────────────────────────────────────────────
getPrecLowest {
    -> 0
}
getPrecAssign {
    -> 1
}
getPrecTernary {
    -> 2
}
getPrecNullish {
    -> 3
}
getPrecLogicalOr {
    -> 4
}
getPrecLogicalAnd {
    -> 5
}
getPrecBitOr {
    -> 6
}
getPrecBitXor {
    -> 7
}
getPrecBitAnd {
    -> 8
}
getPrecEquals {
    -> 9
}
getPrecLessGreater {
    -> 10
}
getPrecShift {
    -> 11
}
getPrecSum {
    -> 12
}
getPrecProduct {
    -> 13
}
getPrecPow {
    -> 14
}
getPrecAs {
    -> 15
}
getPrecPrefix {
    -> 16
}
getPrecCall {
    -> 17
}

getTokenPrecedence tok {
    // Compare to string literal "as" (not a temp var) so C++ bootstrap
    // emits strcmp — var==var string compares can fall back to fcmp.
    if tok.val == "as" {
        -> 15
    }
    if tok.kind == "SYM" {
        if tok.val == "=" {
            -> 1
        }
        if tok.val == "?" {
            -> 2
        }
        if tok.val == "??" {
            -> 3
        }
        if tok.val == "||" {
            -> 4
        }
        if tok.val == "&&" {
            -> 5
        }
        if tok.val == "|" {
            -> 6
        }
        if tok.val == "^" {
            -> 7
        }
        if tok.val == "&" {
            -> 8
        }
        if tok.val == "==" || tok.val == "!=" {
            -> 9
        }
        if tok.val == "<" || tok.val == "<=" || tok.val == ">" || tok.val == ">=" {
            -> 10
        }
        if tok.val == "<<" || tok.val == ">>" || tok.val == ">>>" {
            -> 11
        }
        if tok.val == "+" || tok.val == "-" {
            -> 12
        }
        if tok.val == "*" || tok.val == "/" || tok.val == "%" {
            -> 13
        }
        if tok.val == "**" {
            -> 14
        }
        if tok.val == "++" || tok.val == "--" {
            -> 17
        }
        if tok.val == "." || tok.val == "?." || tok.val == "::" || tok.val == "(" || tok.val == "[" {
            -> 17
        }
    } els if tok.kind == "KEYWORD" {
        if tok.val == "or" {
            -> 4
        }
        if tok.val == "and" {
            -> 5
        }
    }
    -> 0
}

// ── Parser State ─────────────────────────────────────────────────────────────
createParser tokens, filePath, sourceText {
    l = tokens.ln
    emptyTok = CreateToken "EOF", "", 0, 0
    let emptyErrors = []
    mut fPath = filePath
    if fPath == und || fPath == nil { fPath = "" }
    mut src = sourceText
    if src == und || src == nil { src = "" }
    let p = { tokens: tokens, pos: 0, totalLen: l, curTok: emptyTok, peekTok: emptyTok, errors: emptyErrors, desCount: 0, allowIdentStruct: 1, filePath: fPath, sourceText: src }
    advanceParser p
    advanceParser p
    -> p
}

curTok p {
    -> p.curTok
}

peekTok p {
    -> p.peekTok
}

advanceParser p {
    p.curTok = p.peekTok
    if p.pos < p.totalLen {
        p.peekTok = p.tokens[p.pos]
        p.pos = p.pos + 1
    } els {
        p.peekTok = CreateToken "EOF", "", 0, 0
    }
}

expectPeekToken p, expectedKind, expectedVal {
    peekT = peekTok p
    if expectedVal != "" {
        if peekT.val == expectedVal {
            advanceParser p
            -> 1
        }
    } els {
        if peekT.kind == expectedKind {
            advanceParser p
            -> 1
        }
    }
    mut expMsg = expectedVal
    if expMsg == "" { expMsg = expectedKind }
    errPeek = FormatDiagnostic "E0102", `Expected '${expMsg}', got '${peekT.val}' instead`, p.filePath, peekT.line, peekT.col, peekT.val.ln, `expected ${expMsg}`, `add '${expMsg}' here`, p.sourceText
    p.errors.psh errPeek
    -> 0
}

// ── AST Node Constructors ────────────────────────────────────────────────────
createNumberNode val {
    res = { kind: "NumberExpr", val: val }
    -> res
}

createBigIntNode val {
    res = { kind: "BigIntExpr", val: val }
    -> res
}

createStringNode val {
    res = { kind: "StringExpr", val: val }
    -> res
}

createBoolNode val {
    res = { kind: "BoolExpr", val: val }
    -> res
}

createNilNode {
    res = { kind: "NilExpr", val: "nil" }
    -> res
}

createUndNode {
    res = { kind: "NilExpr", val: "und" }
    -> res
}

createVariableNode name {
    res = { kind: "VariableExpr", name: name }
    -> res
}

createBinaryNode op, left, right {
    res = { kind: "BinaryExpr", op: op, left: left, right: right }
    -> res
}

createUnaryNode op, right {
    res = { kind: "UnaryExpr", op: op, right: right, prefix: 1 }
    -> res
}

createPostfixUnaryNode op, left {
    res = { kind: "UnaryExpr", op: op, right: left, prefix: 0 }
    -> res
}

createDerefNode operand {
    res = { kind: "DerefExpr", operand: operand }
    -> res
}

createUnsafeNode body {
    res = { kind: "UnsafeBlock", body: body }
    -> res
}

createCastNode value, targetType {
    res = { kind: "CastExpr", value: value, targetType: targetType }
    -> res
}

createTernaryNode condition, thenExpr, elseExpr {
    res = { kind: "TernaryExpr", condition: condition, thenExpr: thenExpr, elseExpr: elseExpr }
    -> res
}

createCallNode callee, args {
    res = { kind: "CallExpr", callee: callee, args: args }
    -> res
}

createArrayNode elements {
    res = { kind: "ArrayExpr", elements: elements }
    -> res
}

createSpreadNode expr {
    res = { kind: "SpreadExpr", expr: expr }
    -> res
}

createIndexNode array, index {
    res = { kind: "IndexExpr", array: array, index: index, optional: 0 }
    -> res
}

createOptIndexNode array, index {
    res = { kind: "IndexExpr", array: array, index: index, optional: 1 }
    -> res
}

createPropertyAccessNode targetObj, prop {
    res = { kind: "PropertyAccess", object: targetObj, property: prop, optional: 0 }
    -> res
}

createOptPropertyAccessNode targetObj, prop {
    res = { kind: "PropertyAccess", object: targetObj, property: prop, optional: 1 }
    -> res
}

createStructLitNode name, fields {
    res = { kind: "StructLiteral", typeName: name, fields: fields }
    -> res
}

createVarDeclNode name, val, isMut, line, col {
    mut l = line
    mut c = col
    if l == und || l == nil { l = 0 }
    if c == und || c == nil { c = 0 }
    res = { kind: "VarDecl", name: name, value: val, isMut: isMut, line: l, col: c }
    -> res
}

createReturnNode val {
    res = { kind: "ReturnStmt", value: val }
    -> res
}

createPrintNode level, val {
    res = { kind: "PrintStmt", level: level, value: val }
    -> res
}

createIfNode cond, thenB, elseB {
    res = { kind: "IfStmt", condition: cond, thenBranch: thenB, elseBranch: elseB }
    -> res
}

createWhileNode cond, body {
    res = { kind: "WhileStmt", condition: cond, body: body }
    -> res
}

createTryNode tryBody, catchName, catchBody, finallyBody {
    res = { kind: "TryStmt", tryBody: tryBody, catchName: catchName, catchBody: catchBody, finallyBody: finallyBody }
    -> res
}

createThrowNode val {
    res = { kind: "ThrowStmt", value: val }
    -> res
}

createForNode initS, cond, incS, body {
    res = { kind: "ForStmt", init: initS, condition: cond, increment: incS, body: body }
    -> res
}

createFuncNode name, params, body, isAsync, hasRest {
    let emptyAttrs = []
    res = { kind: "FunctionDecl", name: name, params: params, body: body, isAsync: isAsync, hasRest: hasRest, attributes: emptyAttrs, isAsyncST: 0 }
    -> res
}

createImportNode paths, symbols, fromPath, lineNum, colNum {
    res = { kind: "ImportStmt", paths: paths, symbols: symbols, fromPath: fromPath, line: lineNum, col: colNum }
    -> res
}

createBlockNode statements {
    res = { kind: "BlockStmt", statements: statements }
    -> res
}

createStmtSequenceNode statements {
    res = { kind: "StmtSequence", statements: statements }
    -> res
}

createExpressionStmtNode expr {
    res = { kind: "ExpressionStmt", expr: expr }
    -> res
}

compoundBaseOp op {
    if op == "+=" { -> "+" }
    if op == "-=" { -> "-" }
    if op == "*=" { -> "*" }
    if op == "/=" { -> "/" }
    if op == "%=" { -> "%" }
    if op == "**=" { -> "**" }
    if op == "&=" { -> "&" }
    if op == "|=" { -> "|" }
    if op == "^=" { -> "^" }
    -> ""
}

createDestructureNode destructKind, bindNames, src, isMut {
    res = { kind: "DestructureStmt", destructKind: destructKind, bindNames: bindNames, source: src, isMut: isMut }
    -> res
}

peekAheadToken p, offset {
    if offset == 0 {
        -> p.curTok
    }
    if offset == 1 {
        -> p.peekTok
    }
    idx = p.pos + (offset - 2)
    if idx >= 0 && idx < p.totalLen {
        -> p.tokens[idx]
    }
    -> CreateToken "EOF", "", 0, 0
}

isObjectDestructureAssign p {
    mut t = peekAheadToken p, 1
    if t.kind != "IDENT" {
        -> 0
    }
    mut off = 2
    wh 1 == 1 {
        t = peekAheadToken p, off
        if t.val == "," {
            off = off + 1
            t = peekAheadToken p, off
            if t.kind != "IDENT" {
                -> 0
            }
            off = off + 1
        } els if t.val == "}" {
            off = off + 1
            t = peekAheadToken p, off
            if t.val == "=" {
                -> 1
            }
            -> 0
        } els {
            -> 0
        }
    }
    -> 0
}

isArrayDestructureAssign p {
    mut t = peekAheadToken p, 1
    if t.kind != "IDENT" {
        -> 0
    }
    mut off = 2
    wh 1 == 1 {
        t = peekAheadToken p, off
        if t.val == "," {
            off = off + 1
            t = peekAheadToken p, off
            if t.kind != "IDENT" {
                -> 0
            }
            off = off + 1
        } els if t.val == "]" {
            off = off + 1
            t = peekAheadToken p, off
            if t.val == "=" {
                -> 1
            }
            -> 0
        } els {
            -> 0
        }
    }
    -> 0
}

isMultiVarAssign p {
    mut t = peekAheadToken p, 1
    if t.val != "," {
        -> 0
    }
    mut off = 2
    t = peekAheadToken p, off
    if t.kind != "IDENT" {
        -> 0
    }
    off = off + 1
    wh (peekAheadToken p, off).val == "," {
        off = off + 1
        t = peekAheadToken p, off
        if t.kind != "IDENT" {
            -> 0
        }
        off = off + 1
    }
    if (peekAheadToken p, off).val == "=" {
        -> 1
    }
    -> 0
}

parseArrayDestructure p, isMut {
    advanceParser p
    mut n0 = ""
    mut n1 = ""
    mut n2 = ""
    mut n3 = ""
    mut count = 0
    wh (curTok p).val != "]" && (curTok p).kind != "EOF" {
        if (curTok p).kind == "IDENT" {
            if count == 0 { n0 = (curTok p).val }
            els if count == 1 { n1 = (curTok p).val }
            els if count == 2 { n2 = (curTok p).val }
            els if count == 3 { n3 = (curTok p).val }
            count = count + 1
        }
        if (peekTok p).val == "," {
            advanceParser p
        }
        advanceParser p
    }
    if (curTok p).val == "]" {
        advanceParser p
    }
    if (curTok p).val == "=" {
        advanceParser p
    }
    src = parseExpression p, 0
    tempName = `__darr${p.desCount}`
    p.desCount = p.desCount + 1
    let stmts = []
    stmts.psh (createVarDeclNode tempName, src, 1)
    tempVar = createVariableNode tempName
    if count > 0 {
        idx0 = createNumberNode "0"
        stmts.psh (createVarDeclNode n0, (createIndexNode tempVar, idx0), isMut)
    }
    if count > 1 {
        idx1 = createNumberNode "1"
        stmts.psh (createVarDeclNode n1, (createIndexNode tempVar, idx1), isMut)
    }
    if count > 2 {
        idx2 = createNumberNode "2"
        stmts.psh (createVarDeclNode n2, (createIndexNode tempVar, idx2), isMut)
    }
    if count > 3 {
        idx3 = createNumberNode "3"
        stmts.psh (createVarDeclNode n3, (createIndexNode tempVar, idx3), isMut)
    }
    -> createStmtSequenceNode stmts
}

parseObjectDestructure p, isMut {
    advanceParser p
    mut n0 = ""
    mut n1 = ""
    mut n2 = ""
    mut n3 = ""
    mut count = 0
    wh (curTok p).val != "}" && (curTok p).kind != "EOF" {
        if (curTok p).kind == "IDENT" {
            if count == 0 { n0 = (curTok p).val }
            els if count == 1 { n1 = (curTok p).val }
            els if count == 2 { n2 = (curTok p).val }
            els if count == 3 { n3 = (curTok p).val }
            count = count + 1
        }
        if (peekTok p).val == "," {
            advanceParser p
        }
        advanceParser p
    }
    if (curTok p).val == "}" {
        advanceParser p
    }
    if (curTok p).val == "=" {
        advanceParser p
    }
    src = parseExpression p, 0
    tempName = `__dobj${p.desCount}`
    p.desCount = p.desCount + 1
    let stmts = []
    stmts.psh (createVarDeclNode tempName, src, 1)
    tempVar = createVariableNode tempName
    if count > 0 {
        stmts.psh (createVarDeclNode n0, (createPropertyAccessNode tempVar, n0), isMut)
    }
    if count > 1 {
        stmts.psh (createVarDeclNode n1, (createPropertyAccessNode tempVar, n1), isMut)
    }
    if count > 2 {
        stmts.psh (createVarDeclNode n2, (createPropertyAccessNode tempVar, n2), isMut)
    }
    if count > 3 {
        stmts.psh (createVarDeclNode n3, (createPropertyAccessNode tempVar, n3), isMut)
    }
    -> createStmtSequenceNode stmts
}

parseMultiVarAssign p, isMut {
    mut n0 = (curTok p).val
    mut n1 = ""
    mut n2 = ""
    mut n3 = ""
    mut count = 1
    wh (peekTok p).val == "," {
        advanceParser p
        advanceParser p
        if (curTok p).kind == "IDENT" {
            if count == 1 { n1 = (curTok p).val }
            els if count == 2 { n2 = (curTok p).val }
            els if count == 3 { n3 = (curTok p).val }
            count = count + 1
        }
    }
    if (peekTok p).val == "=" {
        advanceParser p
    }
    advanceParser p
    src = parseExpression p, 0
    tempName = `__dmul${p.desCount}`
    p.desCount = p.desCount + 1
    let stmts = []
    stmts.psh (createVarDeclNode tempName, src, 1)
    tempVar = createVariableNode tempName
    if count > 0 {
        idx0 = createNumberNode "0"
        stmts.psh (createVarDeclNode n0, (createIndexNode tempVar, idx0), isMut)
    }
    if count > 1 {
        idx1 = createNumberNode "1"
        stmts.psh (createVarDeclNode n1, (createIndexNode tempVar, idx1), isMut)
    }
    if count > 2 {
        idx2 = createNumberNode "2"
        stmts.psh (createVarDeclNode n2, (createIndexNode tempVar, idx2), isMut)
    }
    if count > 3 {
        idx3 = createNumberNode "3"
        stmts.psh (createVarDeclNode n3, (createIndexNode tempVar, idx3), isMut)
    }
    -> createStmtSequenceNode stmts
}

parseMultiValueReturn p {
    advanceParser p
    if (curTok p).val == "}" || (curTok p).kind == "EOF" || (curTok p).val == ";" {
        -> createReturnNode createNilNode
    }
    first = parseExpression p, 0
    if (peekTok p).val == "," {
        let elements = [first]
        wh (peekTok p).val == "," {
            advanceParser p
            advanceParser p
            nextVal = parseExpression p, 0
            elements.psh nextVal
        }
        -> createReturnNode (createArrayNode elements)
    }
    -> createReturnNode first
}

isParenLambda p {
    mut scanPos = p.pos - 1
    if scanPos < 0 { scanPos = 0 }
    mut depth = 1
    wh scanPos < p.totalLen {
        tok = p.tokens[scanPos]
        if tok.val == "(" {
            depth = depth + 1
        } els if tok.val == ")" {
            depth = depth - 1
            if depth == 0 {
                if scanPos + 1 < p.totalLen {
                    nextT = p.tokens[scanPos + 1]
                    if nextT.val == "=>" {
                        -> 1
                    }
                }
                -> 0
            }
        }
        scanPos = scanPos + 1
    }
    -> 0
}

// ── Expression Parser ────────────────────────────────────────────────────────
parseExpression p, precedence {
    t = curTok p

    let left = createNilNode

    // Prefix Parsing
    if t.kind == "NUMBER" || t.kind == "NUM" {
        left = createNumberNode t.val
    } els if t.kind == "KEYWORD" && t.val == "nan" {
        left = createNumberNode "nan"
    } els if t.kind == "KEYWORD" && (t.val == "Infinity" || t.val == "inf") {
        // Expression-level `inf` / `Infinity` → +∞ (statement `inf expr` remains logging)
        left = createNumberNode "inf"
    } els if t.kind == "BIGINT" {
        left = createBigIntNode t.val
    } els if t.kind == "STRING" || t.kind == "STR" {
        left = createStringNode t.val
    } els if t.kind == "BOOL" {
        left = createBoolNode t.val
    } els if t.kind == "NIL" {
        if t.val == "und" {
            left = createUndNode
        } els {
            left = createNilNode
        }
    } els if t.val == "[" {
        // Array Literal (supports ...spread)
        let elements = []
        if (peekTok p).val != "]" {
            advanceParser p
            if (curTok p).val == "..." {
                advanceParser p
                firstInner = parseExpression p, 0
                sp0 = createSpreadNode firstInner
                elements.psh sp0
            } els {
                firstElem = parseExpression p, 0
                elements.psh firstElem
            }
            wh (peekTok p).val == "," {
                advanceParser p // consume ','
                advanceParser p // move to next elem
                if (curTok p).val == "..." {
                    advanceParser p
                    nextInner = parseExpression p, 0
                    spN = createSpreadNode nextInner
                    elements.psh spN
                } els {
                    nextElem = parseExpression p, 0
                    elements.psh nextElem
                }
            }
        }
        expectPeekToken p, "SYM", "]"
        left = createArrayNode elements
    } els if t.kind == "KEYWORD" && t.val == "new" {
        advanceParser p // consume 'new'
        typeName = (curTok p).val
        if (typeName == "Prm" || typeName == "Promise") && ((peekTok p).kind == "IDENT" || (peekTok p).val == "(") {
            let prmParams = []
            if (peekTok p).val == "(" {
                advanceParser p // consume '('
                wh (peekTok p).val != ")" && (peekTok p).kind != "EOF" {
                    advanceParser p
                    if (curTok p).kind == "IDENT" {
                        prmParams.psh { name: (curTok p).val, type: "", isRest: 0 }
                    }
                    if (peekTok p).val == "," {
                        advanceParser p // consume ','
                    }
                }
                expectPeekToken p, "SYM", ")"
            } els {
                wh (peekTok p).kind == "IDENT" {
                    advanceParser p
                    prmParams.psh { name: (curTok p).val, type: "", isRest: 0 }
                    if (peekTok p).val == "," {
                        advanceParser p // consume ','
                    } els {
                        brk
                    }
                }
            }
            if (peekTok p).val == "=>" {
                advanceParser p // consume '=>'
                mut prmBody = { kind: "BlockStmt", statements: [] }
                if (peekTok p).val == "{" {
                    advanceParser p // move to '{'
                    prmBody = parseBlock p
                } els {
                    let stmts = []
                    // Collect the indentation column of the first body token as the
                    // body indent level. Stop when we see a token at a lower or
                    // equal indent to the parent statement (column of prmParams[0]).
                    mut bodyIndent = 0 - 1
                    wh (peekTok p).kind != "EOF" {
                        // Stop if next token is at column 0 (top-level) or is a keyword
                        // that starts a new declaration (asc, ascST, new, etc.)
                        nextTok = peekTok p
                        mut shouldStop = 0
                        if nextTok.col == 0 && nextTok.kind != "EOF" && stmts.ln > 0 {
                            shouldStop = 1
                        }
                        if nextTok.val == "asc" || nextTok.val == "ascST" || nextTok.val == "asyncST" {
                            shouldStop = 1
                        }
                        if bodyIndent >= 0 && nextTok.col < bodyIndent && stmts.ln > 0 {
                            shouldStop = 1
                        }
                        if shouldStop == 1 {
                            brk
                        }
                        advanceParser p
                        if bodyIndent < 0 {
                            bodyIndent = (curTok p).col
                        }
                        s = parseStatement p
                        if s.kind != "" {
                            stmts.psh s
                            if s.kind == "ReturnStmt" {
                                brk
                            }
                            // Break on call to res/rej params (terminal Prm operations)
                            mut isTerminal = 0
                            if s.kind == "ExpressionStmt" {
                                if s.expr.kind == "CallExpr" {
                                    let pi = 0
                                    wh pi < prmParams.ln {
                                        if s.expr.callee == prmParams[pi].name {
                                            isTerminal = 1
                                        }
                                        pi = pi + 1
                                    }
                                }
                            }
                            if isTerminal == 1 {
                                brk
                            }
                        }
                    }
                    prmBody = createBlockNode stmts
                }
                let lambdaNode = { kind: "LambdaExpr", name: "", params: prmParams, body: prmBody }
                let prmArgs = [lambdaNode]
                let emptyFields = []
                left = { kind: "NewExpr", typeName: typeName, fields: emptyFields, args: prmArgs, isStructLiteral: 0 }
            }
        } els if (peekTok p).val == "{" {
            advanceParser p // consume '{'
            let fields = []
            wh (peekTok p).val != "}" && (peekTok p).kind != "EOF" {
                advanceParser p
                if (curTok p).val == "..." {
                    advanceParser p
                    fVal = parseExpression p, 0
                    fField = { name: "", value: fVal, isSpread: 1 }
                    fields.psh fField
                } els {
                    fName = (curTok p).val
                    if (peekTok p).val == ":" {
                        advanceParser p // consume ':'
                        advanceParser p
                        fVal = parseExpression p, 0
                        fField = { name: fName, value: fVal, isSpread: 0 }
                        fields.psh fField
                    } els {
                        fVar = createVariableNode fName
                        fField = { name: fName, value: fVar, isSpread: 0 }
                        fields.psh fField
                    }
                }
                if (peekTok p).val == "," {
                    advanceParser p // consume ','
                }
            }
            expectPeekToken p, "SYM", "}"
            let emptyArgs = []
            left = { kind: "NewExpr", typeName: typeName, fields: fields, args: emptyArgs, isStructLiteral: 1 }
        } els if (peekTok p).val == "(" {
            advanceParser p // consume '('
            let args = []
            if (peekTok p).val != ")" {
                advanceParser p
                firstArg = parseExpression p, 0
                args.psh firstArg
                wh (peekTok p).val == "," {
                    advanceParser p // consume ','
                    advanceParser p
                    nextArg = parseExpression p, 0
                    args.psh nextArg
                }
            }
            expectPeekToken p, "SYM", ")"
            let emptyFields = []
            left = { kind: "NewExpr", typeName: typeName, fields: emptyFields, args: args, isStructLiteral: 0 }
        } els if (peekTok p).line == t.line && ((peekTok p).kind == "NUM" || (peekTok p).kind == "NUMBER" || (peekTok p).kind == "STR" || (peekTok p).kind == "STRING" || (peekTok p).kind == "BOOL" || (peekTok p).kind == "IDENT" || (peekTok p).val == "{") {
            let args = []
            advanceParser p
            firstArg = parseExpression p, 0
            args.psh firstArg
            wh (peekTok p).val == "," {
                advanceParser p // consume ','
                advanceParser p
                nextArg = parseExpression p, 0
                args.psh nextArg
            }
            let emptyFields = []
            left = { kind: "NewExpr", typeName: typeName, fields: emptyFields, args: args, isStructLiteral: 0 }
        } els {
            let emptyArgs = []
            let emptyFields = []
            left = { kind: "NewExpr", typeName: typeName, fields: emptyFields, args: emptyArgs, isStructLiteral: 0 }
        }
    } els if t.kind == "IDENT" || (t.kind == "KEYWORD" && (t.val == "ok" || t.val == "err")) {
        varName = t.val
        peekT = peekTok p
        if peekT.val == "::" && (peekTok p).line == t.line {
            advanceParser p // consume '::'
            advanceParser p // method name
            methodName = (curTok p).val
            mangled = `${varName}_${methodName}`
            if (peekTok p).val == "(" {
                advanceParser p // consume '('
                let args = []
                if (peekTok p).val != ")" {
                    advanceParser p
                    firstArg = parseExpression p, 0
                    args.psh firstArg
                    wh (peekTok p).val == "," {
                        advanceParser p // consume ','
                        advanceParser p
                        nextArg = parseExpression p, 0
                        args.psh nextArg
                    }
                }
                expectPeekToken p, "SYM", ")"
                left = createCallNode mangled, args
            } els if (peekTok p).line == t.line && ((peekTok p).kind == "NUM" || (peekTok p).kind == "NUMBER" || (peekTok p).kind == "STR" || (peekTok p).kind == "STRING" || (peekTok p).kind == "BOOL" || (peekTok p).kind == "IDENT" || (peekTok p).val == "{") {
                let args = []
                advanceParser p
                firstArg = parseExpression p, 0
                args.psh firstArg
                wh (peekTok p).val == "," {
                    advanceParser p // consume ','
                    advanceParser p
                    nextArg = parseExpression p, 0
                    args.psh nextArg
                }
                left = createCallNode mangled, args
            } els {
                let emptyArgs = []
                left = createCallNode mangled, emptyArgs
            }
        } els if peekT.val == "{" && p.allowIdentStruct == 1 {
            // Struct or anonymous object literal
            advanceParser p // consume '{'
            let fields = []
            wh (peekTok p).val != "}" && (peekTok p).kind != "EOF" {
                advanceParser p
                if (curTok p).val == "..." {
                    advanceParser p
                    fVal = parseExpression p, 0
                    fField = { name: "", value: fVal, isSpread: 1 }
                    fields.psh fField
                } els {
                    fName = (curTok p).val
                    if (peekTok p).val == ":" {
                        advanceParser p // consume ':'
                        advanceParser p
                        fVal = parseExpression p, 0
                        fField = { name: fName, value: fVal, isSpread: 0 }
                        fields.psh fField
                    } els {
                        fVar = createVariableNode fName
                        fField = { name: fName, value: fVar, isSpread: 0 }
                        fields.psh fField
                    }
                }
                if (peekTok p).val == "," {
                    advanceParser p // consume ','
                }
            }
            expectPeekToken p, "SYM", "}"
            left = createStructLitNode varName, fields
        } els if (peekTok p).val == "=>" {
            advanceParser p // consume '=>'
            advanceParser p // body start
            lambdaExpr = parseExpression p, 0
            let lambdaStmts = [createReturnNode lambdaExpr]
            let lambdaBody = createBlockNode lambdaStmts
            let lambdaParams = [{ name: varName, type: "", isRest: 0 }]
            left = { kind: "LambdaExpr", name: "", params: lambdaParams, body: lambdaBody }
        } els if (peekTok p).val == "(" {
            advanceParser p // consume '('
            let args = []
            if (peekTok p).val != ")" {
                advanceParser p
                firstArg = parseExpression p, 0
                args.psh firstArg
                wh (peekTok p).val == "," {
                    advanceParser p // consume ','
                    advanceParser p
                    nextArg = parseExpression p, 0
                    args.psh nextArg
                }
            }
            expectPeekToken p, "SYM", ")"
            left = createCallNode varName, args
        } els {
            mut isBuiltinMathOrStd = 0
            if varName == "abs" || varName == "ceil" || varName == "floor" || varName == "round" ||
               varName == "trunc" || varName == "sqrt" || varName == "sin" || varName == "cos" ||
               varName == "tan" || varName == "asin" || varName == "acos" || varName == "atan" ||
               varName == "atan2" || varName == "pow" || varName == "log" || varName == "exp" ||
               varName == "sl" || varName == "fE" || varName == "rF" || varName == "wF" ||
               varName == "spn" || varName == "jn" || varName == "cnt" || varName == "contains" ||
               varName == "sub" || varName == "substr" || varName == "slc" || varName == "slice" ||
               varName == "chr" || varName == "charAt" || varName == "cat" || varName == "concat" ||
               varName == "eq" || varName == "streq" || varName == "push" || varName == "psh" ||
               varName == "pop" || varName == "pp" || varName == "len" || varName == "ln" ||
               varName == "ldLib" || varName == "loadLib" || varName == "getSym" ||
               varName == "clsLib" || varName == "closeLib" || varName == "call" {
                isBuiltinMathOrStd = 1
            }
            mut shouldCall = 0
            if (peekTok p).line == t.line {
                pVal = (peekTok p).val
                pKind = (peekTok p).kind
                if isBuiltinMathOrStd == 1 {
                    if pVal != ";" && pVal != ")" && pVal != "}" && pVal != "]" && pVal != "," && pVal != "=" && pVal != "." && pVal != ":" && pKind != "EOF" {
                        shouldCall = 1
                    }
                } els {
                    if pKind == "NUM" || pKind == "NUMBER" || pKind == "STR" || pKind == "STRING" || pKind == "BOOL" || pKind == "IDENT" {
                        shouldCall = 1
                    }
                }
            }
            if shouldCall == 1 {
                let args = []
                advanceParser p
                firstArg = parseExpression p, 0
                args.psh firstArg
                wh (peekTok p).val == "," {
                    advanceParser p // consume ','
                    advanceParser p
                    nextArg = parseExpression p, 0
                    args.psh nextArg
                }
                left = createCallNode varName, args
            } els {
                left = createVariableNode varName
            }
        }
    } els if t.kind == "SYM" && t.val == "{" {
        // Anonymous Object Literal
        let fields = []
        wh (peekTok p).val != "}" && (peekTok p).kind != "EOF" {
            advanceParser p
            if (curTok p).val == "..." {
                advanceParser p
                fVal = parseExpression p, 0
                fField = { name: "", value: fVal, isSpread: 1 }
                fields.psh fField
            } els {
                fName = (curTok p).val
                if (peekTok p).val == ":" {
                    advanceParser p // consume ':'
                    advanceParser p
                    fVal = parseExpression p, 0
                    fField = { name: fName, value: fVal, isSpread: 0 }
                    fields.psh fField
                } els {
                    fVar = createVariableNode fName
                    fField = { name: fName, value: fVar, isSpread: 0 }
                    fields.psh fField
                }
            }
            if (peekTok p).val == "," {
                advanceParser p // consume ','
            }
        }
        expectPeekToken p, "SYM", "}"
        left = createStructLitNode "", fields
    } els if t.kind == "SYM" && t.val == "[" {
        // Array Literal (supports ...spread)
        let elements = []
        if (peekTok p).val != "]" {
            advanceParser p
            if (curTok p).val == "..." {
                advanceParser p
                firstInner = parseExpression p, 0
                elements.psh (createSpreadNode firstInner)
            } els {
                firstElem = parseExpression p, 0
                elements.psh firstElem
            }
            wh (peekTok p).val == "," {
                advanceParser p // consume ','
                advanceParser p
                if (curTok p).val == "..." {
                    advanceParser p
                    nextInner = parseExpression p, 0
                    elements.psh (createSpreadNode nextInner)
                } els {
                    nextElem = parseExpression p, 0
                    elements.psh nextElem
                }
            }
        }
        expectPeekToken p, "SYM", "]"
        left = createArrayNode elements
    } els if t.kind == "SYM" && t.val == "(" {
        if (isParenLambda p) == 1 {
            let lambdaParams = []
            wh (peekTok p).val != ")" && (peekTok p).kind != "EOF" {
                advanceParser p
                if (curTok p).kind == "IDENT" {
                    pName = (curTok p).val
                    if (peekTok p).val == ":" {
                        advanceParser p // consume ':'
                        advanceParser p // consume type
                    }
                    lambdaParams.psh { name: pName, type: "", isRest: 0 }
                }
                if (peekTok p).val == "," {
                    advanceParser p // consume ','
                }
            }
            expectPeekToken p, "SYM", ")"
            expectPeekToken p, "SYM", "=>"
            advanceParser p // body start
            lambdaExpr = parseExpression p, 0
            let lambdaStmts = [createReturnNode lambdaExpr]
            let lambdaBody = createBlockNode lambdaStmts
            left = { kind: "LambdaExpr", name: "", params: lambdaParams, body: lambdaBody }
        } els {
            advanceParser p
            left = parseExpression p, 0
            expectPeekToken p, "SYM", ")"
        }
    } els if (t.kind == "SYM" && (t.val == "!" || t.val == "-" || t.val == "&" || t.val == "~" || t.val == "++" || t.val == "--" || t.val == "*")) || (t.kind == "KEYWORD" && (t.val == "not" || t.val == "awt" || t.val == "await" || t.val == "typ" || t.val == "sym" || t.val == "sizeof" || t.val == "sz")) {
        op = t.val
        if op == "&" && (peekTok p).val == "mut" {
            advanceParser p // skip 'mut'
        }
        advanceParser p
        right = parseExpression p, 16
        if op == "awt" || op == "await" {
            left = { kind: "AwaitExpr", expr: right }
        } els if op == "*" {
            left = createDerefNode right
        } els {
            left = createUnaryNode op, right
        }
    } els {
        left = createNilNode
    }

    // Infix & Postfix Parsing (Precedence Climbing)
    let keepClimbing = 1
    mut curT = curTok p
    wh keepClimbing == 1 {
        peekT = peekTok p
        if peekT.kind == "EOF" {
            keepClimbing = 0
        } els {
            // Explicit cast: `expr as Type` (literal "as" required for strcmp)
            mut isAsPeek = 0
            if peekT.val == "as" {
                if peekT.kind == "IDENT" || peekT.kind == "KEYWORD" {
                    isAsPeek = 1
                }
            }
            if isAsPeek == 1 {
                if precedence >= 15 {
                    keepClimbing = 0
                } els {
                    advanceParser p // consume 'as'
                    advanceParser p // move to type
                    mut targetType = ""
                    if (curTok p).val == "*" {
                        advanceParser p
                        targetType = "*" + (curTok p).val
                    } els {
                        targetType = (curTok p).val
                    }
                    left = createCastNode left, targetType
                }
            } els if peekT.val == "?" {
                if precedence >= 2 {
                    keepClimbing = 0
                } els {
                    advanceParser p // consume '?'
                    advanceParser p // move to then-expr
                    thenE = parseExpression p, 0
                    if (expectPeekToken p, "SYM", ":") == 0 {
                        keepClimbing = 0
                    } els {
                        advanceParser p // move to else-expr
                        // Right-associative: a ? b : c ? d : e => a ? b : (c ? d : e)
                        elseE = parseExpression p, 1
                        left = createTernaryNode left, thenE, elseE
                    }
                }
            } els {
            peekPrec = getTokenPrecedence peekT
            curT = curTok p
            if precedence >= peekPrec || peekPrec == 0 {
                keepClimbing = 0
            } els if curT.line != peekT.line && (peekT.val == "*" || peekT.val == "[" || peekT.val == "{" || peekT.val == "++" || peekT.val == "--") {
                keepClimbing = 0
            } els {
                if peekT.val == "." || peekT.val == "::" {
                    peekOp = peekT.val
                    advanceParser p // consume '.' or '::'
                    advanceParser p // consume property name
                    mut propName = (curTok p).val
                    if propName == "pp" || propName == "pop" {
                        let args = [left]
                        left = createCallNode propName, args
                    } els if (peekTok p).val == "(" {
                        advanceParser p // consume '('
                        let args = []
                        if left.kind == "VariableExpr" {
                            varNameStr = left.name
                            let isUpperV = 0
                            if varNameStr.ln > 0 {
                                c0Str = varNameStr.chr 0
                                if c0Str == "A" || c0Str == "B" || c0Str == "C" || c0Str == "D" || c0Str == "E" || c0Str == "F" ||
                                   c0Str == "G" || c0Str == "H" || c0Str == "I" || c0Str == "J" || c0Str == "K" || c0Str == "L" ||
                                   c0Str == "M" || c0Str == "N" || c0Str == "O" || c0Str == "P" || c0Str == "Q" || c0Str == "R" ||
                                   c0Str == "S" || c0Str == "T" || c0Str == "U" || c0Str == "V" || c0Str == "W" || c0Str == "X" ||
                                   c0Str == "Y" || c0Str == "Z" {
                                    isUpperV = 1
                                }
                            }
                            if varNameStr == "os" || varNameStr == "fs" || varNameStr == "mth" || varNameStr == "Math" || varNameStr == "thrd" || varNameStr == "mtx" || varNameStr == "atmc" || varNameStr == "chan" || varNameStr == "time" || varNameStr == "mem" || varNameStr == "ffi" || varNameStr == "net" || varNameStr == "http" || varNameStr == "dns" || varNameStr == "ws" || varNameStr == "Prm" || varNameStr == "Promise" {
                                propName = `${varNameStr}.${propName}`
                            } els if isUpperV == 1 {
                                propName = `${varNameStr}_${propName}`
                            } els {
                                if propName == "cls" || propName == "close" { propName = "chan.cls" }
                                els if propName == "snd" || propName == "send" { propName = "chan.snd" }
                                els if propName == "rcv" || propName == "recv" { propName = "chan.rcv" }
                                els if propName == "lck" || propName == "lock" { propName = "mtx.lck" }
                                els if propName == "unlck" || propName == "unlock" { propName = "mtx.unlck" }
                                els if propName == "destroy" || propName == "free" { propName = "mtx.destroy" }
                                args.psh left
                            }
                        } els {
                            if propName == "cls" || propName == "close" { propName = "chan.cls" }
                            els if propName == "snd" || propName == "send" { propName = "chan.snd" }
                            els if propName == "rcv" || propName == "recv" { propName = "chan.rcv" }
                            els if propName == "lck" || propName == "lock" { propName = "mtx.lck" }
                            els if propName == "unlck" || propName == "unlock" { propName = "mtx.unlck" }
                            els if propName == "destroy" || propName == "free" { propName = "mtx.destroy" }
                            args.psh left
                        }
                        if (peekTok p).val != ")" {
                            advanceParser p
                            firstArg = parseExpression p, 0
                            args.psh firstArg
                            wh (peekTok p).val == "," {
                                advanceParser p // consume ','
                                advanceParser p
                                nextArg = parseExpression p, 0
                                args.psh nextArg
                            }
                        }
                        expectPeekToken p, "SYM", ")"
                        left = createCallNode propName, args
                    } els if peekOp == "::" {
                        let args = []
                        if left.kind == "VariableExpr" {
                            vName = left.name
                            let isUpperV2 = 0
                            if vName.ln > 0 {
                                c02 = vName.cc 0
                                if c02 >= 65 && c02 <= 90 {
                                    isUpperV2 = 1
                                }
                            }
                            if isUpperV2 == 1 {
                                propName = `${vName}_${propName}`
                            } els {
                                args.psh left
                            }
                        } els {
                            args.psh left
                        }
                        left = createCallNode propName, args
                    } els {
                        mut isDotMethod = 0
                        if propName == "abs" || propName == "ceil" || propName == "floor" || propName == "round" ||
                           propName == "trunc" || propName == "sqrt" || propName == "sin" || propName == "cos" ||
                           propName == "tan" || propName == "asin" || propName == "acos" || propName == "atan" ||
                           propName == "atan2" || propName == "pow" || propName == "log" || propName == "exp" ||
                           propName == "cnt" || propName == "contains" || propName == "sub" || propName == "substr" ||
                           propName == "slc" || propName == "slice" || propName == "chr" || propName == "charAt" ||
                           propName == "cat" || propName == "concat" || propName == "eq" || propName == "streq" ||
                           propName == "push" || propName == "psh" || propName == "pop" || propName == "pp" ||
                           propName == "env" || propName == "getEnv" || propName == "setEnv" || propName == "chdir" || propName == "setPri" || propName == "watch" || propName == "wtch" ||
                           propName == "all" || propName == "race" || propName == "allSettled" ||
                           propName == "rFAsync" || propName == "wFAsync" || propName == "recvAsync" || propName == "sendAsync" ||
                           propName == "sleep" || propName == "sl" {
                            isDotMethod = 1
                        }
                        mut shouldDotCall = 0
                        if (peekTok p).line == (curTok p).line {
                            pVal = (peekTok p).val
                            pKind = (peekTok p).kind
                            if isDotMethod == 1 {
                                if pVal != ";" && pVal != ")" && pVal != "}" && pVal != "]" && pVal != "," && pVal != "=" && pVal != "." && pVal != ":" && pKind != "EOF" {
                                    shouldDotCall = 1
                                }
                            } els {
                                if pKind == "NUM" || pKind == "NUMBER" || pKind == "STR" || pKind == "STRING" || pKind == "BOOL" || pKind == "IDENT" {
                                    shouldDotCall = 1
                                }
                            }
                        }
                        if shouldDotCall == 1 {
                            let args = []
                            if left.kind == "VariableExpr" {
                                varNameStr = left.name
                                let isUpperV = 0
                                if varNameStr.ln > 0 {
                                    c0Str = varNameStr.chr 0
                                    if c0Str == "A" || c0Str == "B" || c0Str == "C" || c0Str == "D" || c0Str == "E" || c0Str == "F" ||
                                       c0Str == "G" || c0Str == "H" || c0Str == "I" || c0Str == "J" || c0Str == "K" || c0Str == "L" ||
                                       c0Str == "M" || c0Str == "N" || c0Str == "O" || c0Str == "P" || c0Str == "Q" || c0Str == "R" ||
                                       c0Str == "S" || c0Str == "T" || c0Str == "U" || c0Str == "V" || c0Str == "W" || c0Str == "X" ||
                                       c0Str == "Y" || c0Str == "Z" {
                                        isUpperV = 1
                                    }
                                }
                                if varNameStr == "os" || varNameStr == "fs" || varNameStr == "mth" || varNameStr == "Math" || varNameStr == "thrd" || varNameStr == "mtx" || varNameStr == "atmc" || varNameStr == "chan" || varNameStr == "time" || varNameStr == "mem" || varNameStr == "ffi" || varNameStr == "net" || varNameStr == "http" || varNameStr == "dns" || varNameStr == "ws" || varNameStr == "Prm" || varNameStr == "Promise" {
                                    propName = `${varNameStr}.${propName}`
                                } els if isUpperV == 1 {
                                    propName = `${varNameStr}_${propName}`
                                } els {
                                    args.psh left
                                }
                            } els {
                                args.psh left
                            }
                            advanceParser p
                            firstArg = parseExpression p, 0
                            args.psh firstArg
                            wh (peekTok p).val == "," {
                                advanceParser p // consume ','
                                advanceParser p
                                nextArg = parseExpression p, 0
                                args.psh nextArg
                            }
                            left = createCallNode propName, args
                        } els {
                            left = createPropertyAccessNode left, propName
                        }
                    }
                } els if peekT.val == "?." {
                    advanceParser p // consume '?.'
                    if (peekTok p).val == "[" {
                        advanceParser p // consume '['
                        advanceParser p
                        idx = parseExpression p, 0
                        if (peekTok p).val == "]" {
                            advanceParser p // consume ']'
                        }
                        left = createOptIndexNode left, idx
                    } els {
                        advanceParser p // property name
                        propName = (curTok p).val
                        left = createOptPropertyAccessNode left, propName
                    }
                } els if peekT.val == "[" {
                    // Do not treat '[' on a following line as indexing — that starts
                    // array destructuring / a new statement (e.g. vals = [1]\n[a, b] = vals).
                    if (curTok p).line != peekT.line {
                        keepClimbing = 0
                    } els {
                        advanceParser p // consume '['
                        advanceParser p
                        idx = parseExpression p, 0
                        if (peekTok p).val == "]" {
                            advanceParser p // consume ']'
                        }
                        if (peekTok p).line == (curTok p).line && ((peekTok p).kind == "NUM" || (peekTok p).kind == "NUMBER" || (peekTok p).kind == "STR" || (peekTok p).kind == "STRING" || (peekTok p).kind == "BOOL" || (peekTok p).kind == "IDENT") {
                            advanceParser p
                            arg = parseExpression p, 0
                            let callArgs = [arg]
                            if left.kind == "VariableExpr" {
                                left = createCallNode left.name, callArgs
                            } els {
                                left = createCallNode "", callArgs
                            }
                        } els {
                            left = createIndexNode left, idx
                        }
                    }
                } els if peekT.val == "(" {
                    advanceParser p // consume '('
                    let args = []
                    if (peekTok p).val != ")" {
                        advanceParser p
                        firstArg = parseExpression p, 0
                        args.psh firstArg
                        wh (peekTok p).val == "," {
                            advanceParser p
                            advanceParser p
                            nextArg = parseExpression p, 0
                            args.psh nextArg
                        }
                    }
                    expectPeekToken p, "SYM", ")"
                    if left.kind == "VariableExpr" {
                        left = createCallNode left.name, args
                    } els if left.kind == "PropertyAccess" {
                        if left.object.kind == "VariableExpr" {
                            left = createCallNode `${left.object.name}.${left.property}`, args
                        } els {
                            args.psh left.object
                            left = createCallNode left.property, args
                        }
                    } els {
                        left = createCallNode "", args
                    }
                } els if peekT.val == "++" || peekT.val == "--" {
                    advanceParser p
                    op = (curTok p).val
                    left = createPostfixUnaryNode op, left
                } els {
                    advanceParser p
                    curT = curTok p
                    op = curT.val
                    if op == "as" {
                        advanceParser p // move to type
                        mut targetType = ""
                        if (curTok p).val == "*" {
                            advanceParser p
                            targetType = "*" + (curTok p).val
                        } els {
                            targetType = (curTok p).val
                        }
                        left = createCastNode left, targetType
                    } els {
                        prec = getTokenPrecedence curT
                        advanceParser p
                        // ** is right-associative: 2 ** 3 ** 2 == 2 ** (3 ** 2)
                        mut rhsPrec = prec
                        if op == "**" {
                            rhsPrec = prec - 1
                        }
                        if op == "??" {
                            rhsPrec = prec - 1
                        }
                        right = parseExpression p, rhsPrec
                        left = createBinaryNode op, left, right
                    }
                }
            }
            }
        }
    }

    -> left
}

parseBlock p {
    if (peekTok p).val == "{" {
        advanceParser p // move curTok to '{'
    }
    advanceParser p // move curTok to first statement inside block
    let stmts = []
    wh (curTok p).val != "}" && (curTok p).kind != "EOF" {
        s = parseStatement p
        if s.kind != "" {
            stmts.psh s
        }
        if (peekTok p).val == "}" {
            advanceParser p
            brk
        }
        advanceParser p
    }
    -> createBlockNode stmts
}

parseAttributes p {
    let attrs = []
    wh (curTok p).val == "@" {
        advanceParser p // consume '@'
        if (curTok p).kind != "IDENT" {
            p.errors.psh "Expected attribute name after '@'"
            brk
        }
        attrName = (curTok p).val
        let attrArgs = []
        if (peekTok p).val == "(" {
            advanceParser p // consume '('
            advanceParser p // into arguments or ')'
            wh (curTok p).val != ")" && (curTok p).kind != "EOF" {
                if (curTok p).kind == "IDENT" || (curTok p).kind == "STR" || (curTok p).kind == "STRING" || (curTok p).kind == "NUM" || (curTok p).kind == "NUMBER" {
                    attrArgs.psh (curTok p).val
                    if (peekTok p).val == "," {
                        advanceParser p // consume ','
                    }
                }
                advanceParser p
            }
        }
        let attrObj = { name: attrName, args: attrArgs }
        attrs.psh attrObj
        advanceParser p // move past attribute / ')'
    }
    -> attrs
}

parseStatement p {
    t = curTok p

    if t.val == "@" {
        let attrs = parseAttributes p
        if (curTok p).kind == "EOF" {
            -> { kind: "" }
        }
        stmt = parseStatement p
        if stmt.kind == "FunctionDecl" {
            stmt.attributes = attrs
            let ai = 0
            wh ai < attrs.ln {
                if attrs[ai].name == "st" {
                    stmt.isAsyncST = 1
                    stmt.isAsync = 1
                }
                ai = ai + 1
            }
        } els if stmt.kind == "ObjDecl" {
            stmt.attributes = attrs
        } els if stmt.kind == "StmtSequence" {
            let ssi = 0
            wh ssi < stmt.statements.ln {
                subS = stmt.statements[ssi]
                if subS.kind == "FunctionDecl" || subS.kind == "ObjDecl" {
                    subS.attributes = attrs
                    if subS.kind == "FunctionDecl" {
                        let ai2 = 0
                        wh ai2 < attrs.ln {
                            if attrs[ai2].name == "st" {
                                subS.isAsyncST = 1
                                subS.isAsync = 1
                            }
                            ai2 = ai2 + 1
                        }
                    }
                }
                ssi = ssi + 1
            }
        }
        -> stmt
    }

    if t.kind == "KEYWORD" && t.val == "imp" {
        impLine = t.line
        impCol = t.col
        advanceParser p
        let items = [p.curTok.val]
        wh p.peekTok.val == "," {
            advanceParser p // consume ','
            advanceParser p // move to next item
            items.psh p.curTok.val
        }
        if p.peekTok.val == "frm" {
            advanceParser p // consume 'frm'
            let fromPath = ""
            wh p.peekTok.line == t.line && p.peekTok.kind != "EOF" {
                advanceParser p
                fromPath = fromPath + p.curTok.val
            }
            let emptyPaths = []
            -> createImportNode emptyPaths, items, fromPath, impLine, impCol
        } els {
            let emptySyms = []
            -> createImportNode items, emptySyms, "", impLine, impCol
        }
    } els if (t.kind == "KEYWORD" || t.kind == "IDENT") && (t.val == "extern" || (t.val == "ffi" && ((peekTok p).val == "{" || (peekTok p).kind == "STR" || (peekTok p).kind == "STRING"))) {
        mut libName = "c"
        advanceParser p
        if (curTok p).kind == "STR" || (curTok p).kind == "STRING" {
            libName = (curTok p).val
            advanceParser p
        }
        if (curTok p).val == "{" {
            advanceParser p // consume '{'
            let extStmts = []
            wh (curTok p).val != "}" && (curTok p).kind != "EOF" {
                if (curTok p).kind == "IDENT" {
                    eFnName = (curTok p).val
                    let eParams = []
                    let eLine = (curTok p).line
                    wh (peekTok p).line == eLine && (peekTok p).val != "->" && (peekTok p).kind != "ARROW" && (peekTok p).val != "}" && (peekTok p).kind != "EOF" {
                        advanceParser p
                        epName = (curTok p).val
                        mut epType = "num"
                        if (peekTok p).val == ":" {
                            advanceParser p // consume ':'
                            advanceParser p // type name
                            epType = (curTok p).val
                        }
                        epParamObj = { name: epName, typeName: epType }
                        eParams.psh epParamObj
                        if (peekTok p).val == "," {
                            advanceParser p
                        }
                    }
                    mut eRetType = "void"
                    if (peekTok p).val == "->" || (peekTok p).kind == "ARROW" {
                        advanceParser p // consume '->'
                        advanceParser p // ret type
                        eRetType = (curTok p).val
                    }
                    extNode = {
                        kind: "ExternDecl",
                        name: eFnName,
                        libName: libName,
                        params: eParams,
                        typeName: eRetType
                    }
                    extStmts.psh extNode
                }
                advanceParser p
            }
            -> createStmtSequenceNode extStmts
        }
        fnName = (curTok p).val
        let params = []
        wh (peekTok p).line == t.line && (peekTok p).val != "->" && (peekTok p).kind != "ARROW" && (peekTok p).kind != "EOF" {
            advanceParser p
            pName = (curTok p).val
            let pType = "num"
            if (peekTok p).val == ":" {
                advanceParser p // consume ':'
                advanceParser p // type name
                pType = (curTok p).val
            }
            paramObj = { name: pName, typeName: pType }
            params.psh paramObj
            if (peekTok p).val == "," {
                advanceParser p
            }
        }
        let retType = "void"
        if (peekTok p).val == "->" || (peekTok p).kind == "ARROW" {
            advanceParser p // consume '->'
            advanceParser p // ret type
            retType = (curTok p).val
        }
        -> {
            kind: "ExternDecl",
            name: fnName,
            libName: libName,
            params: params,
            typeName: retType
        }
    } els if t.kind == "KEYWORD" && (t.val == "prnt" || t.val == "lg" || t.val == "wrn" || t.val == "err" || t.val == "inf") {
        logLevel = t.val
        advanceParser p
        expr = parseExpression p, 0
        -> createPrintNode logLevel, expr
    } els if t.kind == "KEYWORD" && t.val == "ret" {
        -> parseMultiValueReturn p
    } els if t.kind == "ARROW" || (t.kind == "SYM" && t.val == "->") {
        -> parseMultiValueReturn p
    } els if t.kind == "KEYWORD" && (t.val == "wrk" || t.val == "worker" || t.val == "asc" || t.val == "async" || t.val == "ascST" || t.val == "asyncST") {
        mut isAsync = 0
        mut isAsyncST = 0
        if t.val == "asc" || t.val == "async" {
            isAsync = 1
        } els if t.val == "ascST" || t.val == "asyncST" {
            isAsyncST = 1
            isAsync = 1
        }
        advanceParser p
        fnName = (curTok p).val
        mut body = { kind: "BlockStmt", statements: [] }
        if (peekTok p).val == "=>" {
            advanceParser p // consume '=>'
            if (peekTok p).val == "{" {
                advanceParser p // move to '{'
                body = parseBlock p
            } els {
                let stmts = []
                wh (peekTok p).kind != "EOF" {
                    advanceParser p
                    s = parseStatement p
                    if s.kind != "" {
                        stmts.psh s
                        if s.kind == "ReturnStmt" {
                            brk
                        }
                    }
                }
                body = createBlockNode stmts
            }
        } els {
            body = parseBlock p
        }
        let emptyParams = []
        node = createFuncNode fnName, emptyParams, body, isAsync, 0
        node.isAsyncST = isAsyncST
        -> node
    } els if t.kind == "KEYWORD" && (t.val == "mch" || t.val == "sw") {
        advanceParser p
        // Match target must NOT use parseExpression — `ident {` is struct-literal
        // sugar there and would swallow the entire mch body.
        let targetExpr = createNilNode
        ct = curTok p
        if ct.kind == "IDENT" || ct.kind == "KEYWORD" {
            targetExpr = createVariableNode ct.val
            if (peekTok p).val == "." {
                advanceParser p // consume '.'
                advanceParser p // move to property
                targetExpr = createPropertyAccessNode targetExpr, (curTok p).val
            }
        } els {
            targetExpr = parseExpression p, 0
        }
        if (peekTok p).val == "{" {
            advanceParser p // move curTok to '{'
        }
        advanceParser p // move curTok to first case pattern (ok, err)
        let okVar = ""
        let okBody = { kind: "" }
        let errVar = ""
        let errBody = { kind: "" }
        let enumConds = []
        let enumBodies = []
        let isValueMatch = 0
        let hasWild = 0
        let wildBody = createNilNode
        wh (curTok p).val != "}" && (curTok p).kind != "EOF" {
            armKind = (curTok p).val
            armTokKind = (curTok p).kind
            if armKind == "ok" {
                if (peekTok p).val == "(" {
                    advanceParser p // consume '('
                    advanceParser p // move to var name
                    okVar = (curTok p).val
                    expectPeekToken p, "SYM", ")"
                }
                expectPeekToken p, "SYM", "=>"
                okBody = parseBlock p
                if (curTok p).val == "}" {
                    advanceParser p // move past '}' to next arm or outer '}'
                }
            } els if armKind == "err" {
                if (peekTok p).val == "(" {
                    advanceParser p // consume '('
                    advanceParser p // move to var name
                    errVar = (curTok p).val
                    expectPeekToken p, "SYM", ")"
                }
                expectPeekToken p, "SYM", "=>"
                errBody = parseBlock p
                if (curTok p).val == "}" {
                    advanceParser p // move past '}' to next arm or outer '}'
                }
            } els {
                // Value / enum / wildcard arm — desugar to if/els chain
                isValueMatch = 1
                let isWild = 0
                let cmpRight = createNilNode
                if armKind == "_" {
                    isWild = 1
                    hasWild = 1
                } els if armTokKind == "NUMBER" || armTokKind == "NUM" {
                    cmpRight = createNumberNode armKind
                } els if armTokKind == "STRING" || armTokKind == "STR" {
                    cmpRight = createStringNode armKind
                } els if armTokKind == "BOOL" {
                    cmpRight = createBoolNode armKind
                } els if (peekTok p).val == "." {
                    advanceParser p // consume '.'
                    advanceParser p // move to variant
                    let vName = (curTok p).val
                    enumObj = createVariableNode armKind
                    cmpRight = createPropertyAccessNode enumObj, vName
                } els {
                    // Bare enum variant: Pending
                    cmpRight = { kind: "EnumBareRef", name: armKind }
                }
                expectPeekToken p, "SYM", "=>"
                let armBody = { kind: "" }
                if (peekTok p).val == "{" {
                    armBody = parseBlock p
                    if (curTok p).val == "}" {
                        advanceParser p
                    }
                } els if (peekTok p).kind == "KEYWORD" && ((peekTok p).val == "prnt" || (peekTok p).val == "lg" || (peekTok p).val == "wrn" || (peekTok p).val == "inf") {
                    // Statement body: `2 => prnt "expr Two"`
                    advanceParser p // move to prnt/lg/...
                    logLevel = (curTok p).val
                    advanceParser p
                    printExpr = parseExpression p, 0
                    armStmts = []
                    armStmts.psh (createPrintNode logLevel, printExpr)
                    armBody = createBlockNode armStmts
                    if (peekTok p).val == "," {
                        advanceParser p
                    }
                    if (peekTok p).val != "}" && (peekTok p).kind != "EOF" {
                        advanceParser p
                    } els if (peekTok p).val == "}" {
                        advanceParser p
                    }
                } els {
                    // Expression body (e.g. `3 => otherFunc "Three"`)
                    advanceParser p
                    armExpr = parseExpression p, 0
                    armStmts = []
                    armStmts.psh (createExpressionStmtNode armExpr)
                    armBody = createBlockNode armStmts
                    if (peekTok p).val == "," {
                        advanceParser p
                    }
                    if (peekTok p).val != "}" && (peekTok p).kind != "EOF" {
                        advanceParser p
                    } els if (peekTok p).val == "}" {
                        advanceParser p
                    }
                }
                if isWild == 1 {
                    wildBody = armBody
                } els {
                    let tgt = targetExpr
                    if targetExpr.kind == "VariableExpr" {
                        tgt = createVariableNode targetExpr.name
                    }
                    cond = createBinaryNode "==", tgt, cmpRight
                    enumConds.psh cond
                    enumBodies.psh armBody
                }
            }
        }
        if isValueMatch == 1 {
            let n = enumConds.ln
            mut chain = createNilNode
            if hasWild == 1 {
                chain = wildBody
            }
            if n == 0 {
                -> chain
            }
            mut idx = n - 1
            wh idx >= 0 {
                chain = createIfNode enumConds[idx], enumBodies[idx], chain
                idx = idx - 1
            }
            -> chain
        }
        res = { kind: "MatchStmt", target: targetExpr, okVar: okVar, okBody: okBody, errVar: errVar, errBody: errBody }
        -> res
    } els if t.kind == "KEYWORD" && (t.val == "mut" || t.val == "let") {
        advanceParser p
        if (curTok p).val == "{" {
            -> parseObjectDestructure p, 1
        } els if (curTok p).val == "[" {
            -> parseArrayDestructure p, 1
        } els if (curTok p).kind == "IDENT" && (isMultiVarAssign p) == 1 {
            -> parseMultiVarAssign p, 1
        } els {
            vName = (curTok p).val
            vLine = (curTok p).line
            vCol = (curTok p).col
            if (peekTok p).val == "=" {
                advanceParser p
            }
            advanceParser p
            valExpr = parseExpression p, 0
            -> createVarDeclNode vName, valExpr, 1, vLine, vCol
        }
    } els if t.kind == "KEYWORD" && t.val == "main" {
        let paramName = ""
        if (peekTok p).kind == "IDENT" {
            advanceParser p
            paramName = (curTok p).val
        }
        body = parseBlock p
        let mainParams = [paramName]
        -> createFuncNode "main", mainParams, body, 0, 0
    } els if t.kind == "KEYWORD" && t.val == "obj" {
        advanceParser p
        structName = (curTok p).val
        expectPeekToken p, "SYM", "{"
        advanceParser p
        let structFields = []
        let methods = []
        wh (curTok p).val != "}" && (curTok p).kind != "EOF" {
            if (curTok p).kind == "IDENT" {
                member = (curTok p).val
                if (peekTok p).val == ":" {
                    advanceParser p // at ':'
                    if (peekTok p).val == "=>" {
                        advanceParser p // at '=>'
                        mBody = parseBlock p
                        mMangled = `${structName}_${member}`
                        let mParams = ["self"]
                        mFn = createFuncNode mMangled, mParams, mBody, 0, 0
                        methods.psh mFn
                    } els {
                        advanceParser p // token after ':'
                        firstLit = (curTok p).val
                        mut sawFatArrow = 0
                        let paramList = []
                        if (curTok p).kind == "IDENT" {
                            paramList.psh firstLit
                            wh (peekTok p).val == "," {
                                advanceParser p // consume ','
                                advanceParser p // next param
                                if (curTok p).kind == "IDENT" {
                                    secondLit = (curTok p).val
                                    paramList.psh secondLit
                                }
                            }
                            if (peekTok p).val == "=>" {
                                sawFatArrow = 1
                                advanceParser p // at '=>'
                                mBody = parseBlock p
                                mMangled = `${structName}_${member}`
                                mFn = createFuncNode mMangled, paramList, mBody, 0, 0
                                methods.psh mFn
                            }
                        }
                        if sawFatArrow == 0 {
                            structFields.psh member
                        }
                    }
                } els {
                    structFields.psh member
                }
                if (peekTok p).val == "," {
                    advanceParser p // consume ','
                }
            }
            advanceParser p
        }
        let objStmts = []
        objStmts.psh { kind: "StructDecl", name: structName, fields: structFields }
        let mi = 0
        wh mi < methods.ln {
            objStmts.psh methods[mi]
            mi = mi + 1
        }
        -> createStmtSequenceNode objStmts
    } els if t.kind == "KEYWORD" && t.val == "enum" {
        advanceParser p
        enumName = (curTok p).val
        expectPeekToken p, "SYM", "{"
        advanceParser p
        let joined = ""
        let first = 1
        wh (curTok p).val != "}" && (curTok p).kind != "EOF" {
            if (curTok p).kind == "IDENT" {
                if first == 0 {
                    joined = `${joined},`
                }
                joined = `${joined}${(curTok p).val}`
                first = 0
                if (peekTok p).val == "," {
                    advanceParser p // consume ','
                }
            }
            advanceParser p
        }
        // Pack variants into `src` string (stable field): "Pending,Active,Archived"
        enumDeclNode = { kind: "EnumDecl", name: enumName, src: joined }
        -> enumDeclNode
    } els if t.kind == "KEYWORD" && t.val == "if" {
        advanceParser p
        p.allowIdentStruct = 0
        condExpr = parseExpression p, 0
        p.allowIdentStruct = 1
        thenBranch = parseBlock p
        let elseBranch = createNilNode
        if (peekTok p).kind == "KEYWORD" && (peekTok p).val == "els" {
            advanceParser p // consume 'els'
            if (peekTok p).kind == "KEYWORD" && (peekTok p).val == "if" {
                advanceParser p
                elseBranch = parseStatement p
            } els {
                elseBranch = parseBlock p
            }
        }
        -> createIfNode condExpr, thenBranch, elseBranch
    } els if t.kind == "KEYWORD" && t.val == "wh" {
        advanceParser p
        p.allowIdentStruct = 0
        condExpr = parseExpression p, 0
        p.allowIdentStruct = 1
        body = parseBlock p
        -> createWhileNode condExpr, body
    } els if t.kind == "KEYWORD" && t.val == "try" {
        advanceParser p
        tryBody = parseBlock p
        let catchName = ""
        let catchBody = { kind: "" }
        let finallyBody = { kind: "" }
        if (peekTok p).kind == "KEYWORD" && (peekTok p).val == "cth" {
            advanceParser p // at 'cth'
            advanceParser p // binding name
            catchName = (curTok p).val
            catchBody = parseBlock p
        }
        if (peekTok p).kind == "KEYWORD" && (peekTok p).val == "fin" {
            advanceParser p // at 'fin'
            finallyBody = parseBlock p
        }
        -> createTryNode tryBody, catchName, catchBody, finallyBody
    } els if t.kind == "KEYWORD" && t.val == "thr" {
        advanceParser p
        thrVal = parseExpression p, 0
        -> createThrowNode thrVal
    } els if t.kind == "KEYWORD" && t.val == "unsafe" {
        advanceParser p
        unsafeBody = parseBlock p
        -> createUnsafeNode unsafeBody
    } els if t.kind == "KEYWORD" && (t.val == "fr" || t.val == "for") {
        advanceParser p // move past 'fr'
        // fr item of coll | fr item, idx of coll | fr key in obj
        ct = curTok p
        pk = peekTok p
        if (ct.kind == "IDENT" || ct.kind == "KEYWORD") && (pk.val == "of" || pk.val == "in" || pk.val == ",") {
            let itemName = ct.val
            let secondName = ""
            let isIn = 0
            if pk.val == "," {
                advanceParser p // cur was item → now at ','
                advanceParser p // move to second ident
                secondName = (curTok p).val
                if (peekTok p).val == "in" {
                    isIn = 1
                    expectPeekToken p, "KEYWORD", "in"
                } els {
                    expectPeekToken p, "KEYWORD", "of"
                }
            } els if pk.val == "in" {
                isIn = 1
                expectPeekToken p, "KEYWORD", "in"
            } els {
                expectPeekToken p, "KEYWORD", "of"
            }
            advanceParser p // move to collection expr
            p.allowIdentStruct = 0
            collExpr = parseExpression p, 0
            p.allowIdentStruct = 1
            armBody = parseBlock p
            p.desCount = p.desCount + 1
            let n = p.desCount
            if isIn == 1 {
                // fr key[, val] in coll — objects yield keys; arrays yield indices
                collTemp = `__fin_c${n}`
                keysTemp = `__fin_ks${n}`
                valsTemp = `__fin_v${n}`
                idxTemp = `__fin_i${n}`
                strTmp = `__fin_s${n}`
                zero0 = createNumberNode "0"
                zero1 = createNumberNode "0"
                outerStmts = []
                outerStmts.psh (createVarDeclNode collTemp, collExpr, 1)
                collVarK = createVariableNode collTemp
                keysAccess = createPropertyAccessNode collVarK, "__keys"
                outerStmts.psh (createVarDeclNode keysTemp, keysAccess, 1)
                outerStmts.psh (createVarDeclNode idxTemp, zero0, 1)
                outerStmts.psh (createVarDeclNode itemName, zero1, 1)
                if secondName != "" {
                    zero2 = createNumberNode "0"
                    outerStmts.psh (createVarDeclNode secondName, zero2, 1)
                }

                // Object branch: iterate __keys / __vals
                objStmts = []
                if secondName != "" {
                    collVarV = createVariableNode collTemp
                    valsAccess = createPropertyAccessNode collVarV, "__vals"
                    objStmts.psh (createVarDeclNode valsTemp, valsAccess, 1)
                }
                // String temp so array-branch item isn't marked str when both arms are codegen'd
                zeroS = createNumberNode "0"
                objStmts.psh (createVarDeclNode strTmp, zeroS, 1)
                keysVarCond = createVariableNode keysTemp
                lenKeys = createPropertyAccessNode keysVarCond, "ln"
                idxVarCond = createVariableNode idxTemp
                objCond = createBinaryNode "<", idxVarCond, lenKeys

                objBody = []
                idxLoad = createVariableNode idxTemp
                keysVarIdx = createVariableNode keysTemp
                keyElem = createIndexNode keysVarIdx, idxLoad
                strVar = createVariableNode strTmp
                objBody.psh (createExpressionStmtNode (createBinaryNode "=", strVar, keyElem))
                itemVar = createVariableNode itemName
                strVar2 = createVariableNode strTmp
                objBody.psh (createExpressionStmtNode (createBinaryNode "=", itemVar, strVar2))
                if secondName != "" {
                    valsVarIdx = createVariableNode valsTemp
                    idxLoad2 = createVariableNode idxTemp
                    valElem = createIndexNode valsVarIdx, idxLoad2
                    secVar = createVariableNode secondName
                    objBody.psh (createExpressionStmtNode (createBinaryNode "=", secVar, valElem))
                }
                if armBody.kind == "BlockStmt" {
                    let bi = 0
                    wh bi < armBody.statements.ln {
                        objBody.psh armBody.statements[bi]
                        bi = bi + 1
                    }
                } els if armBody.kind != "" {
                    objBody.psh armBody
                }
                loadI = createVariableNode idxTemp
                one = createNumberNode "1"
                addExpr = createBinaryNode "+", loadI, one
                storeI = createVariableNode idxTemp
                stepStmt = createExpressionStmtNode (createBinaryNode "=", storeI, addExpr)
                emptyInit = { kind: "" }
                objFor = createForNode emptyInit, objCond, stepStmt, (createBlockNode objBody)
                objStmts.psh objFor
                thenBranch = createBlockNode objStmts

                // Array branch: first binding = index, optional second = element
                arrBody = []
                idxAsItem = createVariableNode idxTemp
                itemVarA = createVariableNode itemName
                arrBody.psh (createExpressionStmtNode (createBinaryNode "=", itemVarA, idxAsItem))
                if secondName != "" {
                    collVarIdx = createVariableNode collTemp
                    idxLoad3 = createVariableNode idxTemp
                    arrElem = createIndexNode collVarIdx, idxLoad3
                    secVarA = createVariableNode secondName
                    arrBody.psh (createExpressionStmtNode (createBinaryNode "=", secVarA, arrElem))
                }
                if armBody.kind == "BlockStmt" {
                    let bi2 = 0
                    wh bi2 < armBody.statements.ln {
                        arrBody.psh armBody.statements[bi2]
                        bi2 = bi2 + 1
                    }
                } els if armBody.kind != "" {
                    arrBody.psh armBody
                }
                collVarLen = createVariableNode collTemp
                lenArr = createPropertyAccessNode collVarLen, "ln"
                idxVarCond2 = createVariableNode idxTemp
                arrCond = createBinaryNode "<", idxVarCond2, lenArr
                loadIA = createVariableNode idxTemp
                oneA = createNumberNode "1"
                addExprA = createBinaryNode "+", loadIA, oneA
                storeIA = createVariableNode idxTemp
                stepStmtA = createExpressionStmtNode (createBinaryNode "=", storeIA, addExprA)
                emptyInitA = { kind: "" }
                arrFor = createForNode emptyInitA, arrCond, stepStmtA, (createBlockNode arrBody)
                elseStmts = []
                elseStmts.psh arrFor
                elseBranch = createBlockNode elseStmts

                keysVarIf = createVariableNode keysTemp
                nilNode = createNilNode
                ifCond = createBinaryNode "!=", keysVarIf, nilNode
                outerStmts.psh (createIfNode ifCond, thenBranch, elseBranch)
                -> createBlockNode outerStmts
            }
            // Desugar fr … of: decls + for so cont hits index++
            collTemp = `__fov_c${n}`
            idxTemp = `__fov_i${n}`
            zero0 = createNumberNode "0"
            zero1 = createNumberNode "0"
            outerStmts = []
            outerStmts.psh (createVarDeclNode collTemp, collExpr, 1)
            outerStmts.psh (createVarDeclNode idxTemp, zero0, 1)
            outerStmts.psh (createVarDeclNode itemName, zero1, 1)
            if secondName != "" {
                zero2 = createNumberNode "0"
                outerStmts.psh (createVarDeclNode secondName, zero2, 1)
            }

            collVar = createVariableNode collTemp
            lenAccess = createPropertyAccessNode collVar, "ln"
            idxVarCond = createVariableNode idxTemp
            cond = createBinaryNode "<", idxVarCond, lenAccess

            bodyStmts = []
            idxLoad = createVariableNode idxTemp
            collVarIdx = createVariableNode collTemp
            elem = createIndexNode collVarIdx, idxLoad
            itemVar = createVariableNode itemName
            itemStore = createBinaryNode "=", itemVar, elem
            bodyStmts.psh (createExpressionStmtNode itemStore)
            if secondName != "" {
                secVar = createVariableNode secondName
                idxVar2 = createVariableNode idxTemp
                idxAssign = createBinaryNode "=", secVar, idxVar2
                bodyStmts.psh (createExpressionStmtNode idxAssign)
            }
            if armBody.kind == "BlockStmt" {
                let bi = 0
                wh bi < armBody.statements.ln {
                    bodyStmts.psh armBody.statements[bi]
                    bi = bi + 1
                }
            } els if armBody.kind != "" {
                bodyStmts.psh armBody
            }
            loopBody = createBlockNode bodyStmts

            loadI = createVariableNode idxTemp
            one = createNumberNode "1"
            addExpr = createBinaryNode "+", loadI, one
            storeI = createVariableNode idxTemp
            stepAssign = createBinaryNode "=", storeI, addExpr
            stepStmt = createExpressionStmtNode stepAssign

            emptyInit = { kind: "" }
            forNode = createForNode emptyInit, cond, stepStmt, loopBody
            outerStmts.psh forNode
            // Block scope so repeated `fr item of ...` bindings don't redeclare
            -> createBlockNode outerStmts
        }
        // C-style: fr init; cond; step
        initStmt = parseStatement p
        if (curTok p).val == ";" {
            advanceParser p
        } els if (peekTok p).val == ";" {
            advanceParser p // consume ';'
            advanceParser p // move to cond
        }
        p.allowIdentStruct = 0
        condExpr = parseExpression p, 0
        p.allowIdentStruct = 1
        if (curTok p).val == ";" {
            advanceParser p
        } els if (peekTok p).val == ";" {
            advanceParser p // consume ';'
            advanceParser p // move to inc
        }
        incStmt = parseStatement p
        body = parseBlock p
        -> createForNode initStmt, condExpr, incStmt, body
    } els if t.kind == "KEYWORD" && (t.val == "brk" || t.val == "break") {
        -> { kind: "BreakStmt" }
    } els if t.kind == "KEYWORD" && (t.val == "cont" || t.val == "continue") {
        -> { kind: "ContinueStmt" }
    } els if t.kind == "KEYWORD" && t.val == "pub" {
        advanceParser p // consume 'pub'
        mut isExternC = 0
        if (curTok p).kind == "KEYWORD" && (curTok p).val == "extern" {
            advanceParser p // consume 'extern'
            if (curTok p).kind == "STRING" && ((curTok p).val == "C" || (curTok p).val == "c") {
                isExternC = 1
                advanceParser p // consume 'C'
            }
        }
        if (curTok p).val == "{" {
            advanceParser p // consume '{'
            let pubStmts = []
            wh (curTok p).val != "}" && (curTok p).kind != "EOF" {
                if (curTok p).kind == "IDENT" {
                    pFnName = (curTok p).val
                    advanceParser p
                    mut pHasRest = 0
                    let pParams = []
                    if (curTok p).val == "(" {
                        advanceParser p // consume '('
                        if (curTok p).val != ")" {
                            pValFirst = (curTok p).val
                            if (peekTok p).val == ":" {
                                advanceParser p // consume ':'
                                advanceParser p // consume type
                            }
                            pParams.psh pValFirst
                            wh (peekTok p).val == "," {
                                advanceParser p // consume ','
                                advanceParser p
                                pVal = (curTok p).val
                                if (peekTok p).val == ":" {
                                    advanceParser p // consume ':'
                                    advanceParser p // consume type
                                }
                                pParams.psh pVal
                            }
                        }
                        if (peekTok p).val == ")" {
                            advanceParser p
                        }
                    } els if (curTok p).val != "{" && (curTok p).val != "->" {
                        let moreParams = 1
                        wh moreParams == 1 {
                            if (curTok p).val == "{" || (curTok p).val == "->" {
                                moreParams = 0
                            } els if (curTok p).val == "..." {
                                advanceParser p
                                pRest = (curTok p).val
                                if (peekTok p).val == ":" {
                                    advanceParser p
                                    advanceParser p
                                }
                                pParams.psh pRest
                                pHasRest = 1
                            } els if (curTok p).kind == "IDENT" {
                                pVal = (curTok p).val
                                if (peekTok p).val == ":" {
                                    advanceParser p
                                    advanceParser p
                                }
                                pParams.psh pVal
                            }
                            if moreParams == 1 {
                                if (peekTok p).val == "," {
                                    advanceParser p // consume ','
                                    advanceParser p // move to next param
                                } els {
                                    moreParams = 0
                                }
                            }
                        }
                    }
                    if (peekTok p).val == "->" {
                        advanceParser p // consume '->'
                        advanceParser p // consume return type
                    } els if (curTok p).val == "->" {
                        advanceParser p // consume '->'
                        advanceParser p // consume return type
                    }
                    body = parseBlock p
                    let emptyAttrs1 = []
                    pFnNode = { kind: "FunctionDecl", name: pFnName, params: pParams, body: body, isAsync: 0, hasRest: pHasRest, isExported: 1, isExternC: isExternC, attributes: emptyAttrs1 }
                    pubStmts.psh pFnNode
                }
                advanceParser p // unconditional advance (matches C++ nextToken at line 269)
            }
            -> createStmtSequenceNode pubStmts
        }
        if (curTok p).kind == "IDENT" {
            fnName = (curTok p).val
            advanceParser p
            mut hasRest = 0
            let params = []
            if (curTok p).val == "(" {
                advanceParser p // consume '('
                if (curTok p).val != ")" {
                    pValFirst = (curTok p).val
                    if (peekTok p).val == ":" {
                        advanceParser p // consume ':'
                        advanceParser p // consume type
                    }
                    params.psh pValFirst
                    wh (peekTok p).val == "," {
                        advanceParser p // consume ','
                        advanceParser p
                        pVal = (curTok p).val
                        if (peekTok p).val == ":" {
                            advanceParser p // consume ':'
                            advanceParser p // consume type
                        }
                        params.psh pVal
                    }
                }
                if (peekTok p).val == ")" {
                    advanceParser p
                }
            } els if (curTok p).val != "{" && (curTok p).val != "->" {
                let moreParams = 1
                wh moreParams == 1 {
                    if (curTok p).val == "{" || (curTok p).val == "->" {
                        moreParams = 0
                    } els if (curTok p).val == "..." {
                        advanceParser p
                        pRest = (curTok p).val
                        if (peekTok p).val == ":" {
                            advanceParser p
                            advanceParser p
                        }
                        params.psh pRest
                        hasRest = 1
                    } els if (curTok p).kind == "IDENT" {
                        pVal = (curTok p).val
                        if (peekTok p).val == ":" {
                            advanceParser p
                            advanceParser p
                        }
                        params.psh pVal
                    }
                    if moreParams == 1 {
                        if (peekTok p).val == "," {
                            advanceParser p // consume ','
                            advanceParser p // move to next param
                        } els {
                            moreParams = 0
                        }
                    }
                }
            }
            if (peekTok p).val == "->" {
                advanceParser p // consume '->'
                advanceParser p // consume return type
            } els if (curTok p).val == "->" {
                advanceParser p // consume '->'
                advanceParser p // consume return type
            }
            if (peekTok p).val == "=>" {
                advanceParser p // consume '=>'
                advanceParser p // expression body start
                arrowExpr = parseExpression p, 0
                let arrowStmts = [createReturnNode arrowExpr]
                arrowBody = createBlockNode arrowStmts
                let arrowAttrs = []
                -> { kind: "FunctionDecl", name: fnName, params: params, body: arrowBody, isAsync: 0, hasRest: hasRest, isExported: 1, isExternC: isExternC, attributes: arrowAttrs }
            }
            body = parseBlock p
            let emptyAttrs2 = []
            fnNode = { kind: "FunctionDecl", name: fnName, params: params, body: body, isAsync: 0, hasRest: hasRest, isExported: 1, isExternC: isExternC, attributes: emptyAttrs2 }
            -> fnNode
        }
        -> { kind: "" }
    } els if t.kind == "SYM" && t.val == "{" && (isObjectDestructureAssign p) == 1 {
        -> parseObjectDestructure p, 0
    } els if t.kind == "SYM" && t.val == "[" && (isArrayDestructureAssign p) == 1 {
        -> parseArrayDestructure p, 0
    } els if t.kind == "IDENT" {
        identName = t.val
        if (isMultiVarAssign p) == 1 {
            -> parseMultiVarAssign p, 0
        } els if (peekTok p).val == "=" {
            iLine = t.line
            iCol = t.col
            advanceParser p // consume '='
            if (peekTok p).kind == "EOF" {
                peekT = peekTok p
                errEof = FormatDiagnostic "E0101", "Expected valid expression, got EOF", p.filePath, peekT.line, peekT.col, 1, "expected expression", "provide a valid identifier, literal, or expression", p.sourceText
                p.errors.psh errEof
                -> { kind: "" }
            }
            advanceParser p
            valExpr = parseExpression p, 0
            -> createVarDeclNode identName, valExpr, 0, iLine, iCol
        } els if (peekTok p).val == "+=" || (peekTok p).val == "-=" || (peekTok p).val == "*=" || (peekTok p).val == "/=" || (peekTok p).val == "%=" || (peekTok p).val == "**=" || (peekTok p).val == "&=" || (peekTok p).val == "|=" || (peekTok p).val == "^=" {
            // x += rhs → x = x + rhs
            compOp = (peekTok p).val
            baseOp = compoundBaseOp compOp
            advanceParser p // consume compound
            if (peekTok p).kind == "EOF" {
                peekT = peekTok p
                errComp = FormatDiagnostic "E0101", "Expected valid expression after compound assign", p.filePath, peekT.line, peekT.col, 1, "expected expression", "provide a valid identifier, literal, or expression", p.sourceText
                p.errors.psh errComp
                -> { kind: "" }
            }
            advanceParser p
            valExpr = parseExpression p, 0
            loadVar = createVariableNode identName
            binExpr = createBinaryNode baseOp, loadVar, valExpr
            storeVar = createVariableNode identName
            assignExpr = createBinaryNode "=", storeVar, binExpr
            -> createExpressionStmtNode assignExpr
        } els if (peekTok p).val == ":" {
            advanceParser p // consume ':'
            advanceParser p // consume type
            if (peekTok p).val == "=" {
                advanceParser p // consume '='
                advanceParser p
                valExpr = parseExpression p, 0
                -> createVarDeclNode identName, valExpr, 0
            }
        } els if (peekTok p).val == "." {
            advanceParser p // consume '.'
            advanceParser p // consume method/prop name
            mut propName = (curTok p).val
            targetVar = createVariableNode identName
            if (peekTok p).val == "=" {
                advanceParser p // consume '='
                advanceParser p
                valExpr = parseExpression p, 0
                propAccess = createPropertyAccessNode targetVar, propName
                binNode = createBinaryNode "=", propAccess, valExpr
                -> createExpressionStmtNode binNode
            } els if (peekTok p).val == "+=" || (peekTok p).val == "-=" || (peekTok p).val == "*=" || (peekTok p).val == "/=" || (peekTok p).val == "%=" || (peekTok p).val == "**=" || (peekTok p).val == "&=" || (peekTok p).val == "|=" || (peekTok p).val == "^=" {
                compOp = (peekTok p).val
                baseOp = compoundBaseOp compOp
                advanceParser p
                advanceParser p
                valExpr = parseExpression p, 0
                loadObj = createVariableNode identName
                loadProp = createPropertyAccessNode loadObj, propName
                binExpr = createBinaryNode baseOp, loadProp, valExpr
                storeObj = createVariableNode identName
                storeProp = createPropertyAccessNode storeObj, propName
                assignExpr = createBinaryNode "=", storeProp, binExpr
                -> createExpressionStmtNode assignExpr
            } els if (peekTok p).val == "(" {
                advanceParser p // consume '('
                let args = []
                if identName == "os" || identName == "fs" || identName == "mth" || identName == "Math" || identName == "thrd" || identName == "mtx" || identName == "atmc" || identName == "chan" || identName == "time" || identName == "mem" || identName == "ffi" || identName == "net" || identName == "http" || identName == "dns" || identName == "ws" {
                    propName = `${identName}.${propName}`
                } els {
                    if propName == "cls" || propName == "close" { propName = "chan.cls" }
                    els if propName == "snd" || propName == "send" { propName = "chan.snd" }
                    els if propName == "rcv" || propName == "recv" { propName = "chan.rcv" }
                    els if propName == "lck" || propName == "lock" { propName = "mtx.lck" }
                    els if propName == "unlck" || propName == "unlock" { propName = "mtx.unlck" }
                    els if propName == "destroy" || propName == "free" { propName = "mtx.destroy" }
                    args.psh targetVar
                }
                if (peekTok p).val != ")" {
                    advanceParser p
                    firstArg = parseExpression p, 0
                    args.psh firstArg
                    wh (peekTok p).val == "," {
                        advanceParser p // consume ','
                        advanceParser p
                        nextArg = parseExpression p, 0
                        args.psh nextArg
                    }
                }
                expectPeekToken p, "SYM", ")"
                callNode = createCallNode propName, args
                -> createExpressionStmtNode callNode
            } els if propName == "pp" || propName == "pop" {
                let args = [targetVar]
                callNode = createCallNode propName, args
                -> createExpressionStmtNode callNode
            } els {
                let isTypeExt = 0
                if identName.ln > 0 {
                    c0E = identName.chr 0
                    if c0E == "A" || c0E == "B" || c0E == "C" || c0E == "D" || c0E == "E" || c0E == "F" ||
                       c0E == "G" || c0E == "H" || c0E == "I" || c0E == "J" || c0E == "K" || c0E == "L" ||
                       c0E == "M" || c0E == "N" || c0E == "O" || c0E == "P" || c0E == "Q" || c0E == "R" ||
                       c0E == "S" || c0E == "T" || c0E == "U" || c0E == "V" || c0E == "W" || c0E == "X" ||
                       c0E == "Y" || c0E == "Z" {
                        isTypeExt = 1
                    }
                }
                if isTypeExt == 1 && ((peekTok p).val == "{" || (peekTok p).kind == "IDENT") {
                    let mParams = ["self"]
                    wh (peekTok p).val != "{" && (peekTok p).kind != "EOF" {
                        advanceParser p
                        if (curTok p).kind == "IDENT" {
                            pVal = (curTok p).val
                            mParams.psh pVal
                        }
                        if (peekTok p).val == "," {
                            advanceParser p // consume ','
                        }
                    }
                    body = parseBlock p
                    mangled = `${identName}_${propName}`
                    -> createFuncNode mangled, mParams, body, 0, 0
                } els if (peekTok p).kind == "NUM" || (peekTok p).kind == "NUMBER" || (peekTok p).kind == "STR" || (peekTok p).kind == "STRING" || (peekTok p).kind == "BOOL" || (peekTok p).kind == "IDENT" {
                    advanceParser p
                    argExpr = parseExpression p, 0
                    mut callTarget = propName
                    let args = []
                    if identName == "os" || identName == "fs" || identName == "mth" || identName == "Math" || identName == "thrd" || identName == "mtx" || identName == "atmc" || identName == "chan" || identName == "time" || identName == "mem" || identName == "ffi" || identName == "net" || identName == "http" || identName == "dns" || identName == "ws" {
                        callTarget = `${identName}.${propName}`
                        args.psh argExpr
                    } els {
                        args.psh targetVar
                        args.psh argExpr
                    }
                    wh (peekTok p).val == "," {
                        advanceParser p // consume ','
                        advanceParser p // move to next arg
                        nextArg = parseExpression p, 0
                        args.psh nextArg
                    }
                    callNode = createCallNode callTarget, args
                    -> createExpressionStmtNode callNode
                } els {
                    propAccess = createPropertyAccessNode targetVar, propName
                    -> createExpressionStmtNode propAccess
                }
            }
        } els if (peekTok p).val == "[" {
            // Generic function declaration: fnName[T] ...
            advanceParser p // consume '['
            advanceParser p // consume type parameter
            if (peekTok p).val == "]" {
                advanceParser p // consume ']'
            }
            if (peekTok p).val == "{" {
                body = parseBlock p
                let emptyParams = []
                -> createFuncNode identName, emptyParams, body, 0, 0
            } els if (peekTok p).kind == "IDENT" || (peekTok p).val == "..." {
                advanceParser p
                mut hasRest = 0
                let params = []
                if (curTok p).val == "..." {
                    advanceParser p
                    pRest = (curTok p).val
                    params.psh pRest
                    hasRest = 1
                } els {
                    pValFirst = (curTok p).val
                    if (peekTok p).val == ":" {
                        advanceParser p // consume ':'
                        advanceParser p // consume type
                    }
                    params.psh pValFirst
                    wh (peekTok p).val == "," {
                        advanceParser p // consume ','
                        advanceParser p
                        if (curTok p).val == "..." {
                            advanceParser p
                            pRest2 = (curTok p).val
                            params.psh pRest2
                            hasRest = 1
                        } els {
                            pVal = (curTok p).val
                            if (peekTok p).val == ":" {
                                advanceParser p // consume ':'
                                advanceParser p // consume type
                            }
                            params.psh pVal
                        }
                    }
                }
                if (peekTok p).val == "{" {
                    body = parseBlock p
                    -> createFuncNode identName, params, body, 0, hasRest
                }
            }
        } els if (peekTok p).val == "{" {
            // Function declaration without params: fnName { ... }
            body = parseBlock p
            let emptyParams = []
            -> createFuncNode identName, emptyParams, body, 0, 0
        } els if (peekTok p).line == t.line && ((peekTok p).kind == "IDENT" || (peekTok p).val == "...") {
            // Function declaration with params or identifier call statement
            advanceParser p
            mut hasRest = 0
            let params = []
            if (curTok p).val == "..." {
                advanceParser p
                pRest = (curTok p).val
                params.psh pRest
                hasRest = 1
            } els {
                pValFirst = (curTok p).val
                if (peekTok p).val == ":" {
                    advanceParser p // consume ':'
                    advanceParser p // consume type
                }
                params.psh pValFirst
                wh (peekTok p).line == t.line && (peekTok p).val == "," {
                    advanceParser p // consume ','
                    advanceParser p
                    if (curTok p).val == "..." {
                        advanceParser p
                        pRest2 = (curTok p).val
                        params.psh pRest2
                        hasRest = 1
                    } els {
                        pVal = (curTok p).val
                        if (peekTok p).val == ":" {
                            advanceParser p // consume ':'
                            advanceParser p // consume type
                        }
                        params.psh pVal
                    }
                }
            }
            if (peekTok p).val == "{" {
                body = parseBlock p
                -> createFuncNode identName, params, body, 0, hasRest
            } els if (peekTok p).val == "=>" {
                advanceParser p // consume '=>'
                advanceParser p // expression body start
                arrowExpr = parseExpression p, 0
                let arrowStmts = [createReturnNode arrowExpr]
                arrowBody = createBlockNode arrowStmts
                -> createFuncNode identName, params, arrowBody, 0, hasRest
            } els {
                // Parenthesis-free call statement with identifiers
                let args = []
                let ai = 0
                wh ai < params.ln {
                    vNode = createVariableNode params[ai]
                    args.psh vNode
                    ai = ai + 1
                }
                callNode = createCallNode identName, args
                -> createExpressionStmtNode callNode
            }
        } els if (peekTok p).line == t.line && ((peekTok p).kind == "STR" || (peekTok p).kind == "STRING" || (peekTok p).kind == "NUM" || (peekTok p).kind == "NUMBER" || (peekTok p).kind == "BOOL") {
            // Parenthesis-free call statement with literal arguments
            advanceParser p
            firstArg = parseExpression p, 0
            let args = [firstArg]
            wh (peekTok p).line == t.line && (peekTok p).val == "," {
                advanceParser p // consume ','
                advanceParser p
                nextArg = parseExpression p, 0
                args.psh nextArg
            }
            callNode = createCallNode identName, args
            -> createExpressionStmtNode callNode
        } els {
            expr = parseExpression p, 0
            if expr.kind == "VariableExpr" && (peekTok p).line > t.line {
                // 0-argument function call statement
                let emptyArgs = []
                callNode = createCallNode expr.name, emptyArgs
                -> createExpressionStmtNode callNode
            }
            -> { kind: "ExpressionStmt", expr: expr }
        }
    } els {
        expr = parseExpression p, 0
        -> { kind: "ExpressionStmt", expr: expr }
    }
}

ParseProgramFull tokens, filePath, sourceText {
    p = createParser tokens, filePath, sourceText
    let rawStatements = []

    wh (curTok p).kind != "EOF" {
        stmt = parseStatement p
        if stmt.kind != "" {
            rawStatements.psh stmt
        }
        advanceParser p
    }

    let statements = []
    let ri = 0
    wh ri < rawStatements.ln {
        s = rawStatements[ri]
        if s.kind == "StmtSequence" {
            let ssi = 0
            wh ssi < s.statements.ln {
                subStmt = s.statements[ssi]
                if subStmt.kind != "" {
                    statements.psh subStmt
                }
                ssi = ssi + 1
            }
        } els if s.kind == "ExpressionStmt" {
            if s.expr.kind != "NilExpr" && s.expr.kind != "" {
                statements.psh s
            }
        } els {
            statements.psh s
        }
        ri = ri + 1
    }

    res = { statements: statements, errors: p.errors }
    -> res
}
