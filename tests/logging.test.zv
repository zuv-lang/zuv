// Dedicated test suite for logging statements: prnt, lg, wrn, inf, err

// ========================================================
// 1. Outside a function (top-level / global script scope)
// ========================================================

// 1.1 Basic literal logging for all levels
prnt "Print output message"
lg "Standard lg message"
inf "System status operational"
wrn "Resource usage is high"
err "Unhandled exception occurred"

// 1.2 Variable logging across levels
count = 42
prnt count
lg count
inf count
wrn count
err count

// 1.3 Floating-point and boolean literals
piVal = 3.14159
isReady = yes
isDegraded = no
lg piVal
inf isReady
wrn isDegraded

// 1.4 Parenthesized logging syntax
prnt("Parenthesized prnt")
lg("Parenthesized lg")
inf("Parenthesized inf")
wrn("Parenthesized wrn")

// 1.5 Arithmetic and comparison expressions
prnt 100 + 23
lg 50 * 2
inf 1000 / 10
wrn 15 - 8
lg 10 > 5

// 1.6 Array elements and Object fields
point = { x: 10, y: 20 }
lg "Object property x:"
lg point.x
inf "Object property y:"
inf point.y

sampleArr = [100, 200, 300]
lg "Array first item:"
lg sampleArr[0]
inf "Array second item:"
inf sampleArr[1]

// ========================================================
// 2. Inside functions
// ========================================================

// 2.1 Function logging parameters and local computations
logFromFunc prefix, code {
    prnt prefix
    lg prefix
    inf prefix
    wrn prefix
    err prefix

    detail = code + 10
    prnt detail
    lg detail
    inf detail
    wrn detail
    err detail
    -> detail
}

retVal = logFromFunc "FuncMsg", 100
lg retVal

// 2.2 Function with conditional logging across log levels
validateLevel level {
    if level >= 3 {
        err "Critical level exceeded"
    } els if level == 2 {
        wrn "Warning level reached"
    } els if level == 1 {
        inf "Info level notice"
    } els {
        lg "Normal operation level"
    }
}

validateLevel 0
validateLevel 1
validateLevel 2
validateLevel 3

// 2.3 Recursive function logging depth / countdown
countdown n {
    if n <= 0 {
        inf "Blastoff!"
        -> 0
    }
    lg n
    countdown n - 1
    -> 0
}

countdown 3

// ========================================================
// 3. Inside scopes (block scoping and nesting)
// ========================================================

{
    // Outer block scope
    outerScopeMsg = "Outer block active"
    outerCode = 101
    prnt outerScopeMsg
    lg outerCode
    inf outerCode
    wrn outerCode
    err outerCode

    // Nested block scope level 2
    {
        midScopeMsg = "Mid nested block active"
        midCode = 202
        prnt midScopeMsg
        lg midCode
        inf midCode
        wrn midCode
        err midCode

        // Deeply nested block scope level 3
        {
            deepScopeMsg = "Deep nested block active"
            deepCode = 303
            prnt deepScopeMsg
            lg deepCode
            inf deepCode
            wrn deepCode
            err deepCode
        }

        lg "Exited deep block"
    }

    lg "Exited mid block"
}

// ========================================================
// 4. Inside control flow structures
// ========================================================

// 4.1 if / els conditional branch logging
flag = 1
if flag == 1 {
    inf "In if branch: success"
    prnt flag
} els {
    err "In els branch: error"
}

if flag == 0 {
    prnt "Should not print"
} els {
    wrn "In els branch: flag not zero"
}

// 4.2 while loop logging
iter = 0
wh iter < 3 {
    lg iter
    iter = iter + 1
}

// 4.3 for loop logging
fr i = 0; i < 2; i++ {
    inf i
}

// 4.4 pattern matching (sw) logging branches
statusCode = 404
sw statusCode {
    200 => {
        inf "Status 200 OK"
    }
    404 => {
        wrn "Status 404 Not Found"
    }
    500 => {
        err "Status 500 Server Error"
    }
    _ => {
        lg "Unknown Status"
    }
}

// 4.5 try / catch block logging
try {
    lg "Inside try block: executing safely"
} cth errVal {
    err "Inside cth block: caught failure"
}

prnt "Logging test suite completed"
