// Test Suite for Raw Terminal Controls, ANSI Virtual Console & PTY Engine (`term`, `pty`)
imp term frm "term"
imp pty frm "pty"
imp time frm "time"

prnt "Testing term mode switching..."
initialRaw = term.isRaw()
prnt initialRaw

term.makeRaw()
afterMakeRaw = term.isRaw()
prnt afterMakeRaw

term.restore()
afterRestore = term.isRaw()
prnt afterRestore

prnt "Testing term dimensions & size..."
w = term.width()
h = term.height()
termSize = term.size()
prnt w
prnt h
prnt termSize

prnt "Testing non-blocking key reader..."
hk = term.hasKey()
prnt hk
k = term.readKey(0)
prnt k

prnt "Testing ANSI color and styling..."
cOk = term.color "green", "SUCCESS"
prnt cOk
bld = term.bold "BOLD_TEXT"
prnt bld
rTxt = term.red "RED_TEXT"
prnt rTxt
gTxt = term.green "GREEN_TEXT"
prnt gTxt
yTxt = term.yellow "YELLOW_TEXT"
prnt yTxt
bTxt = term.blue "BLUE_TEXT"
prnt bTxt
cTxt = term.cyan "CYAN_TEXT"
prnt cTxt
rst = term.reset()
prnt rst

prnt "Testing PTY open, resize, and close..."
p = pty.open 80, 24
prnt p
pty.resize p, 100, 30
pty.close p
prnt "PTY closed successfully."

prnt "Testing PTY process spawning..."
sp = pty.spawn "cmd.exe /c echo pty_spawn_ok", 80, 24
prnt sp
time.sleep 100
out = pty.read sp, 4096
prnt out
pty.close sp
prnt "PTY process spawn test complete."
