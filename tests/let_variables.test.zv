// Unit Test for 'let' Variable Declarations & Mutations

// 1. Declare variables using 'let'
count = 0
greeting = "Hello"
isReady = true

if count == 0 {
    prnt "Initial count is 0"
}

// 2. Reassign / mutate 'let' variables
count = count + 10
greeting = greeting + " World"
isReady = false

if count == 10 {
    prnt "Mutated count is 10"
}

if greeting == "Hello World" {
    prnt "Mutated greeting is Hello World"
}

// 3. 'let' inside loops and blocks
total = 0
i = 0
wh i < 5 {
    total = total + i
    i = i + 1
}

if total == 10 {
    prnt "Loop with accumulator passed"
}

// 4. Interoperability between 'let' and 'mut'
a = 5
b = 15
c = a + b
if c == 20 {
    prnt "Interoperability between and passed"
}

prnt "Variables Unit Test Passed"
