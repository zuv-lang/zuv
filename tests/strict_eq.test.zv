// Strict equality: == / != never coerce across concrete types,
// except bool <-> single-digit 0 / 1

if "5" == 5 {
    prnt "str==num fail"
} els {
    prnt "str==num ok"
}

if 5 == "5" {
    prnt "num==str fail"
} els {
    prnt "num==str ok"
}

if "5" == "5" {
    prnt "str==str ok"
}

if 5 == 5 {
    prnt "num==num ok"
}

if true == 1 {
    prnt "true==1 ok"
}

if false == 0 {
    prnt "false==0 ok"
}

if 1 == true {
    prnt "1==true ok"
}

if 0 == false {
    prnt "0==false ok"
}

if nil == 0 {
    prnt "nil==0 fail"
} els {
    prnt "nil==0 ok"
}

if false == nil {
    prnt "false==nil fail"
} els {
    prnt "false==nil ok"
}

if nil == und {
    prnt "nil==und fail"
} els {
    prnt "nil==und ok"
}

if true == true {
    prnt "true==true ok"
}

if false == false {
    prnt "false==false ok"
}

if nil == nil {
    prnt "nil==nil ok"
}

if (1 == 1) == 1 {
    prnt "boolexpr==1 ok"
}

if (1 == 1) == true {
    prnt "boolexpr==true ok"
}

if "hello" != 5 {
    prnt "str!=num ok"
}

if 2 == true {
    prnt "2==true fail"
} els {
    prnt "2==true ok"
}

prnt "strict eq complete"
