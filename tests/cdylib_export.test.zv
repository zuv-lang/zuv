// cdylib_export.test.zv - Testing shared dynamic library C exports

// 1. Grouped / Block 'pub extern "C"' definition
pub extern "C" {
    add a: num, b: num -> num {
        -> a + b
    }

    multiply a: num, b: num -> num {
        -> a * b
    }
}

// 2. Individual / Single 'pub extern "C"' definition
pub extern "C" calculateTax price: num, rate: num -> num {
    -> price * rate
}
