// Test for Task 13 & Task 28: Unsafe Blocks & Raw Memory Primitives (unsafe, *ptr, mem)

unsafe {
    ptr = malloc 64 as *byte
    *ptr = 42
    val = *ptr
    prnt val
    if val == 42 {
        prnt "Dereferenced malloc pointer matches 42"
    }
    free ptr
}

// Pointer arithmetic and offset dereferencing
unsafe {
    buffer = malloc 128 as *num
    *buffer = 10
    second = buffer + 8
    *second = 20
    third = buffer + 16
    *third = 30

    v1 = *buffer
    v2 = *second
    v3 = *third
    prnt v1
    prnt v2
    prnt v3

    if v1 == 10 and v2 == 20 and v3 == 30 {
        prnt "Pointer offset arithmetic passed"
    }

    free buffer
}

// Address-of variable
unsafe {
    x = 1234
    xPtr = &x
    xVal = *xPtr
    prnt xVal
    if xVal == 1234 {
        prnt "Address-of stack variable passed"
    }
}

// Task 28: Low-Level Memory Reallocation, Copy & Fill Primitives
unsafe {
    // 1. Heap Allocation & Byte Set
    p1 = mem.alloc 16
    mem.set p1, 65, 10
    prnt "Filled 10 bytes with 65 (ASCII 'A') using mem.set"

    // 2. Heap Reallocation
    p1_expanded = mem.realloc p1, 64
    prnt "Reallocated buffer to 64 bytes using mem.realloc"

    // 3. Fast Block Copy (mem.cp)
    p2 = mem.alloc 64
    mem.cp p2, p1_expanded, 10
    prnt "Copied 10 bytes using mem.cp"

    mem.free p1_expanded
    mem.free p2
}

// Size Layout Queries (sz / sizeof)
sz_byte = sz byte
sz_i16 = sz i16
sz_i32 = sz i32
sz_i64 = sz i64
sz_num = sz num
sz_str = sizeof str
sz_bool = sizeof bool
sz_ptr = sizeof ptr

if sz_byte == 1 and sz_i16 == 2 and sz_i32 == 4 and sz_i64 == 8 and sz_num == 8 {
    prnt "Size queries (sz / sizeof) passed"
}