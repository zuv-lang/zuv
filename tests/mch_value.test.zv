sayThree msg {
    prnt msg
}

n = 2
sw n {
    1 => {
        prnt "num One"
    }
    2 => {
        prnt "num Two ok"
    }
    3 => {
        prnt "num Three"
    }
    _ => {
        prnt "num Default"
    }
}

m = 9
sw m {
    1 => {
        prnt "wild miss"
    }
    2 => {
        prnt "wild miss2"
    }
    _ => {
        prnt "wild Default ok"
    }
}

s = "hi"
sw s {
    "bye" => {
        prnt "str bye"
    }
    "hi" => {
        prnt "str hi ok"
    }
    _ => {
        prnt "str Default"
    }
}

b = true
sw b {
    false => {
        prnt "bool no"
    }
    true => {
        prnt "bool yes ok"
    }
    _ => {
        prnt "bool Default"
    }
}

k = 3
sw k {
    1 => {
        prnt "expr One"
    }
    2 => prnt "expr Two"
    3 => sayThree "expr Three ok"
    _ => {
        prnt "expr Default"
    }
}

j = 2
sw j {
    1 => prnt "expr skip"
    2 => prnt "expr Two ok"
    _ => prnt "expr miss"
}

swN = 1
sw swN {
    1 => prnt "sw One ok"
    2 => prnt "sw Two"
    _ => prnt "sw Default"
}

prnt "sw value test complete"
