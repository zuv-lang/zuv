// Explicit type casting with `as`

if 3.7 as i32 == 3 {
    prnt "as i32 truncate ok"
}

if (3 as num) == 3 {
    prnt "as num ok"
}

if (0 as bool) == false {
    prnt "0 as bool ok"
}

if (5 as bool) {
    prnt "5 as bool ok"
}

if typ (42 as str) == "str" {
    prnt "as str typ ok"
}

p = 0 as *byte
q = p as num
if q == q {
    prnt "as *byte roundtrip ok"
}

if 9.9 as i32 as num == 9 {
    prnt "chained as ok"
}

if (1.5 + 2.5) as i32 == 4 {
    prnt "as after add ok"
}

f = 3.7
ti = f as i32
if ti == 3 {
    prnt "var as i32 ok"
}

prnt "as cast test complete"
