// Native Standard Library std/str Unit Test Suite
// Verifies imp str with pure dot-method syntax (.len, .contains, .sub, .slice, .chr, .concat, .eq)

imp str

lg "--- Testing std/str Pure Dot Method Syntax ---"

text = "Hello Zuv Standard Library"

// 1. Length (.len)
l1 = text.len
lg "Length via 'text.len':"
lg l1

// 2. Contains (.contains)
has1 = text.contains "Zuv"
lg "Contains via 'text.contains \"Zuv\"':"
lg has1

// 3. Substring (.sub start, len)
s1 = text.sub 6, 3
lg "Substr via 'text.sub 6, 3':"
lg s1

// 4. Slice (.slice start, end)
sl1 = text.slice 0, 5
lg "Slice via 'text.slice 0, 5':"
lg sl1

// 5. CharAt (.chr)
c1 = text.chr 0
lg "CharAt via 'text.chr 0':"
lg c1

c2 = text.chr 6
lg "CharAt via 'text.chr 6':"
lg c2

// 6. Concat (.concat)
res1 = text.concat " - Fast"
lg "Concat via 'text.concat \" - Fast\"':"
lg res1

// 7. Equality (.eq)
match1 = text.eq "Hello Zuv Standard Library"
lg "Equality via 'text.eq \"...\"':"
lg match1

mismatch = text.eq "Other String"
lg "Equality via 'text.eq \"Other String\"':"
lg mismatch


// 8. Template Literals with Backticks (`...`) and Quotes
quoted = `He's often called "Johnny"`
lg "Template literal with quotes:"
lg quoted

// 9. Multiline Template String
multi = `Line 1
Line 2
Line 3`
lg "Multiline template string:"
lg multi

// 10. String Interpolation (${...})
dog = "bulldog"
age = 4
interp = `The quick brown fox jumps over the lazy ${dog} of age ${age + 1}`
lg "String interpolation:"
lg interp

// 11. String Bracket Indexing (s[i])
greeting = "hello"
char0 = greeting[0]
char1 = greeting[1]
lg "Bracket indexing greeting[0]:"
lg char0
lg "Bracket indexing greeting[1]:"
lg char1

// String-like name heuristics / restrictions
file_name = "demo.zv"
source_path = "/tmp/demo.zv"
error_msg = "usage: demo"
code_text = "print(\"hi\")"
value_text = "42"
char_value = "x"
name_value = "zuv"

lg "String-like variable names via bracket indexing:"
lg file_name[0]
lg source_path[0]
lg error_msg[0]
lg code_text[0]
lg value_text[0]
lg char_value[0]
lg name_value[0]

lg "std/str Shortform Tests Completed!"
