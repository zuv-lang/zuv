// Unit Test for Inter-Process Communication (IPC) & Shared Memory (`ipc`, `mmap`, `Named Pipes`)
imp ipc frm "ipc"
imp net frm "net"

// 1. Cross-Process Synchronization: System-wide Named Mutex
mtx = ipc.mutex "zuv_ipc_mtx_test"
lockOk = ipc.lock mtx
tryOk = ipc.tryLock mtx
unOk1 = ipc.unlock mtx
unOk2 = ipc.unlock mtx
ipc.close mtx
if lockOk == 1 && unOk1 == 1 {
    prnt "ipc named mutex lock/unlock passed"
}

// 2. Cross-Process Synchronization: Named Semaphore
sem = ipc.sem "zuv_ipc_sem_test", 1, 2
sWaitOk = ipc.semWait sem, 100
sPostOk = ipc.semPost sem, 1
sTryOk = ipc.semTryWait sem
sPostOk2 = ipc.semPost sem, 1
ipc.close sem
if sWaitOk == 1 && sPostOk == 1 && sTryOk == 1 {
    prnt "ipc named semaphore wait/post passed"
}

// 3. Cross-Process Synchronization: Named Event
evt = ipc.event "zuv_ipc_evt_test", 1, 0
eSetOk = ipc.eventSet evt
eWaitOk = ipc.eventWait evt, 100
eResetOk = ipc.eventReset evt
ipc.close evt
if eSetOk == 1 && eWaitOk == 1 {
    prnt "ipc named event set/wait/reset passed"
}

// 4. Memory-Mapped Files & Shared RAM: Anonymous Shared Memory
shm = ipc.shm "zuv_ipc_shm_test", 4096
bytesWritten = ipc.write shm, 0, "Hello Shared Memory!"
readStr = ipc.readStr shm, 0
shmOpened = ipc.openShm "zuv_ipc_shm_test", 4096
readStr2 = ipc.readStr shmOpened, 0
flushRes = ipc.flush shm, 4096
unmapRes1 = ipc.unmap shm
unmapRes2 = ipc.unmap shmOpened
if readStr == "Hello Shared Memory!" && readStr2 == "Hello Shared Memory!" {
    prnt "ipc anonymous shared memory read/write passed"
}

// 5. File Memory Mapping: mmap & munmap
fmap = mmap "tests/mmap_sample.txt", 35
fContent = ipc.readStr fmap, 0
unmapFileRes = munmap fmap
if cnt fContent, "Zuv memory mapped" {
    prnt "ipc file mmap/munmap read passed"
}

// 6. Named Pipes IPC Stream
pipeName = "zuv_test_pipe_stream"
pipeServer = net.listen "pipe", pipeName
pipeClient = net.conn "pipe", pipeName
acceptedClient = net.accept pipeServer

sentBytes = net.send pipeClient, "ping from pipe client"
receivedMsg = net.recv pipeServer, 1024

net.close pipeClient
net.close pipeServer
if receivedMsg == "ping from pipe client" {
    prnt "ipc named pipe listen/conn/send/recv passed"
}

prnt "ipc test passed"
