// Decorator test suite (tests/decorators.test.zv)
imp time

// 1. Object / Class Decorator (1 parameter like TypeScript)
LogClass cls {
    cls.email = "default@example.com"
    cls.name = "Rohit"
}

@LogClass
obj User {
    name: str,
    email: str,

    greet: name => {
        -> "hi " + name
    }
}

// 2. Method Decorator
Log method, meta {
    -> ...args => {
        lg `Calling ${meta.name}`
        -> method ...args
    }
}

obj Greeter {
    @Log
    hello: name => {
        -> `Hello ${name}`
    }
}

// 3. Behavior-changing decorator (timing / profiling)
Measure fn, c {
    -> ...args => {
        start = time.mono
        result = fn ...args
        end_time = time.mono
        elapsed = (end_time - start) / 1000000.0
        lg `${c.name} took ${elapsed}ms`
        -> result
    }
}

obj App {
    @Measure
    calculate: => {
        i = 0
        wh i < 100000 { i = i + 1 }
        -> i
    }
}

// 4. Decorator Factory (parameterized)
Route endpoint {
    -> (m, ctxObj) => {
        lg `${ctxObj.name} -> ${endpoint}`
        -> m
    }
}

obj UserController {
    @Route "/users"
    getUsers: => {
        -> ["Rohit", "Alice"]
    }
}

// 5. Free-function decorator
Deprecated targetFn, info {
    lg `Warning: ${info.name} is deprecated`
    -> targetFn
}

@Deprecated
oldHelper x {
    -> x * 2
}

// Run verifications
u = new User()
prnt u.email
prnt u.name
msg = User.greet "World"
prnt msg

g = new Greeter()
h = g.hello "Rohit"
prnt h

app = new App()
calcRes = app.calculate()
prnt calcRes

ctrl = new UserController()
users = ctrl.getUsers()
prnt users.ln

oldRes = oldHelper 5
prnt oldRes

prnt "decorators test complete"
