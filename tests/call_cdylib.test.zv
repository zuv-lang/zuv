// Call Zuv-generated DLL via C FFI (tests/call_cdylib.test.zv)

extern "test_math.dll" {
    add a: num, b: num -> num
    multiply a: num, b: num -> num
}

extern "test_math.dll" calculateTax price: num, rate: num -> num
sum = add 10, 25
if sum == 35 {
    prnt "add ok: 35"
}

prod = multiply 7, 8
if prod == 56 {
    prnt "multiply ok: 56"
}

tax = calculateTax 100, 0.15
if tax == 15 {
    prnt "tax ok: 15"
}

prnt "Zuv DLL FFI test passed"
