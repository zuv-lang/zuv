// call_cdylib.test.zv - Testing consumption of generated DLL

// 1. Grouped / Block extern declaration
extern "test_math.dll" {
    add a: num, b: num -> num
    multiply a: num, b: num -> num
}

// 2. Individual / Single extern declaration
extern "test_math.dll" calculateTax price: num, rate: num -> num

sum = add 10, 20
mul = multiply 5, 6
tax = calculateTax 100, 0.15

if sum == 30 {
    prnt "add ok"
}
if mul == 30 {
    prnt "multiply ok"
}
if tax == 15 {
    prnt "calculateTax ok"
}

if sum == 30 {
    if mul == 30 {
        if tax == 15 {
            prnt "Zuv DLL FFI test passed"
        }
    }
}

