// --- 1. Parenthesized functions (using single ':' for return type, no '::') ---

add(a: num, b: num): num {
    -> a + b
}

square(x: i64): i64 {
    -> x * x
}

addI64(a: i64, b: i64): i64 {
    -> a + b
}

greet(name: str): str {
    -> "Hello, " + name
}

concatStr(a: str, b: str): str {
    -> a + " " + b
}

isPositive(n: num): bool {
    -> n > 0.0
}

andBool(a: bool, b: bool): bool {
    -> a && b
}

notBool(b: bool): bool {
    -> !b
}

sayHello(): void {
    lg "sayHello() invoked"
}

arrayReturnNum(a: num, b: num): num[] {
    -> [a, b]
}

arrayReturnI64(a: i64, b: i64): i64[] {
    -> [a, b]
}

arrayReturnStr(a: str, b: str): str[] {
    -> [a, b]
}

arrayReturnBool(a: bool, b: bool): bool[] {
    -> [a, b]
}

arrayParameterReturnNum(a: num[], b: num): num[] {
    -> a
}

arrayParameterReturnI64(a: i64[], b: i64): i64[] {
    -> a
}

arrayParameterReturnStr(a: str[], b: str): str[] {
    -> a
}

arrayParameterReturnBool(a: bool[], b: bool): bool[] {
    -> a
}

// --- 2. Parenthesis-free functions ---

addPF a: num, b: num :: num {
    -> a + b
}

multiplyFree a: num, b: num :: num {
    -> a * b
}

cubeFree x: i64 :: i64 {
    -> x * x * x
}

addI64Pf a: i64, b: i64 :: i64 {
    -> a + b
}

concatFree prefix: str, suffix: str :: str {
    -> prefix + " " + suffix
}

checkZeroFree n: num :: bool {
    -> n == 0.0
}

andBoolPf a: bool, b: bool :: bool {
    -> a && b
}

notBoolPf b: bool :: bool {
    -> !b
}

sayFree :: void {
    lg "sayFree invoked"
}

workerTask {
    lg "Worker Thread Started!"
    -> 0
}

arrayReturnNumPf a: num, b: num :: num[] {
    -> [a, b]
}

arrayReturnI64Pf a: i64, b: i64 :: i64[] {
    -> [a, b]
}

arrayReturnStrPf a: str, b: str :: str[] {
    -> [a, b]
}

arrayReturnBoolPf a: bool, b: bool :: bool[] {
    -> [a, b]
}

arrayParameterReturnNumPf a: num[], b: num :: num[] {
    -> a
}

arrayParameterReturnI64Pf a: i64[], b: i64 :: i64[] {
    -> a
}

arrayParameterReturnStrPf a: str[], b: str :: str[] {
    -> a
}

arrayParameterReturnBoolPf a: bool[], b: bool :: bool[] {
    -> a
}

// --- 3. Functions without types ---

addNoTypes(a, b) {
    -> a + b
}

doubleNoTypes(x) {
    -> x * 2
}

subNoTypes a, b {
    -> a - b
}

tripleNoTypes x {
    -> x * 3
}

noTypesVoid() {
    lg "noTypesVoid invoked"
}

arrayReturnNoTypes(a, b) {
    -> [a, b]
}

arrayParameterReturnBoolNoTypes a, b {
    -> a
}

// --- 4. Executing and console outputs of all functions ---

// Parenthesized calls
sayHello()

r1 = add(10.5, 20.25)
lg "add(10.5, 20.25):"
lg r1

r2 = square(7)
lg "square(7):"
lg r2

r2_add = addI64(15, 25)
lg "addI64(15, 25):"
lg r2_add

msg = greet("Zuv Developer")
lg msg

fullMsg = concatStr("Hello", "Zuv")
lg "concatStr(\"Hello\", \"Zuv\"):"
lg fullMsg

b1 = isPositive(42.0)
lg "isPositive(42.0):"
lg b1

b2 = isPositive(-5.0)
lg "isPositive(-5.0):"
lg b2

b3 = andBool(true, false)
lg "andBool(true, false):"
lg b3

b4 = notBool(true)
lg "notBool(true):"
lg b4

r3 = arrayReturnNum(10.5, 20.25)
lg "arrayReturnNum(10.5, 20.25):"
lg r3

r4 = arrayReturnI64(10, 20)
lg "arrayReturnI64(10, 20):"
lg r4

r5 = arrayReturnStr("Hello", "Zuv")
lg "arrayReturnStr(\"Hello\", \"Zuv\"):"
lg r5

r6 = arrayReturnBool(true, false)
lg "arrayReturnBool(true, false):"
lg r6

r7 = arrayParameterReturnNum([10.5, 20.25], 30.5)
lg "arrayParameterReturnNum([10.5, 20.25], 30.5):"
lg r7

r8 = arrayParameterReturnI64([10, 20], 30)
lg "arrayParameterReturnI64([10, 20], 30):"
lg r8

r9 = arrayParameterReturnStr(["Hello", "Zuv"], "World")
lg "arrayParameterReturnStr([\"Hello\", \"Zuv\"], \"World\"):"
lg r9

r10 = arrayParameterReturnBool([true], false)
lg "arrayParameterReturnBool([true], false):"
lg r10

// Parenthesis-free calls
sayFree

w = workerTask()
lg "workerTask result:"
lg w

mf = addPF 3.45, 2.73
lg "addPF 3.45, 2.73:"
lg mf

mf2 = multiplyFree 3.5, 2.0
lg "multiplyFree 3.5, 2.0:"
lg mf2

cf = cubeFree 3
lg "cubeFree 3:"
lg cf

cf_add = addI64Pf 12, 18
lg "addI64Pf 12, 18:"
lg cf_add

msgFree = concatFree "Parenthesis", "Free"
lg msgFree

cz1 = checkZeroFree 0.0
lg "checkZeroFree 0.0:"
lg cz1

cz2 = checkZeroFree 5.5
lg "checkZeroFree 5.5:"
lg cz2

ab1 = andBoolPf true, true
lg "andBoolPf true, true:"
lg ab1

ab2 = notBoolPf false
lg "notBoolPf false:"
lg ab2

apf = arrayReturnNumPf 5.5, 10.1
lg "arrayReturnNumPf 5.5, 10.1:"
lg apf

ai64f = arrayReturnI64Pf 5, 10
lg "arrayReturnI64Pf 5, 10:"
lg ai64f

asf = arrayReturnStrPf "Hello", "Zuv"
lg "arrayReturnStrPf \"Hello\", \"Zuv\":"
lg asf

abf = arrayReturnBoolPf true, false
lg "arrayReturnBoolPf true, false:"
lg abf

numArr = [5.5, 10.1]
apnf = arrayParameterReturnNumPf numArr, 20.2
lg "arrayParameterReturnNumPf [5.5, 10.1], 20.2:"
lg apnf

i64Arr = [5, 10]
api64f = arrayParameterReturnI64Pf i64Arr, 15
lg "arrayParameterReturnI64Pf [5, 10], 15:"
lg api64f

strArr = ["Hello", "Zuv"]
apsf = arrayParameterReturnStrPf strArr, "World"
lg "arrayParameterReturnStrPf [\"Hello\", \"Zuv\"], \"World\":"
lg apsf

boolArr = [true]
apbf = arrayParameterReturnBoolPf boolArr, false
lg "arrayParameterReturnBoolPf [true], false:"
lg apbf

// Calls without types
noTypesVoid()

nt1 = addNoTypes(40, 60)
lg "addNoTypes(40, 60):"
lg nt1

nt2 = doubleNoTypes(21)
lg "doubleNoTypes(21):"
lg nt2

nt3 = subNoTypes 100, 45
lg "subNoTypes 100, 45:"
lg nt3

nt4 = tripleNoTypes 15
lg "tripleNoTypes 15:"
lg nt4

arnt = arrayReturnNoTypes(5, 10)
lg "arrayReturnNoTypes(5, 10):"
lg arnt

aprbnt = arrayParameterReturnBoolNoTypes [true], false
lg "arrayParameterReturnBoolNoTypes [true], false:"
lg aprbnt

lg "done"
