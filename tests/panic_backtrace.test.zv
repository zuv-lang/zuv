// Test panic exit code and backtrace interception

failTask {
    panic "fatal error in failTask"
}

if (args.ln > 2 && args[2] == "child") || (args.ln > 1 && args[1] == "child") {
    failTask()
} els {
    // Parent process invokes child to verify exit code 101
    code = sh("\"" + args[0] + "\" child")
    if code == 101 {
        prnt "panic backtrace verified: child exited with code 101"
    } els {
        panic "child returned unexpected code"
    }
}