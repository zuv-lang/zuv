// Increment / decrement: ++x, x++, --x, x--

x = 10
x++
if x == 11 {
    prnt "postfix ++ ok"
}

++x
if x == 12 {
    prnt "prefix ++ ok"
}

x--
if x == 11 {
    prnt "postfix -- ok"
}

--x
if x == 10 {
    prnt "prefix -- ok"
}

a = 5
b = a++
if b == 5 {
    prnt "postfix ++ returns old ok"
}
if a == 6 {
    prnt "postfix ++ mutates ok"
}

c = 5
d = ++c
if d == 6 {
    prnt "prefix ++ returns new ok"
}
if c == 6 {
    prnt "prefix ++ mutates ok"
}

e = 3
f = e--
if f == 3 {
    prnt "postfix -- returns old ok"
}
if e == 2 {
    prnt "postfix -- mutates ok"
}

g = 3
h = --g
if h == 2 {
    prnt "prefix -- returns new ok"
}
if g == 2 {
    prnt "prefix -- mutates ok"
}

prnt "incr decr test complete"
