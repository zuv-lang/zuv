// Tests for Hardware Math Intrinsics & Constants (mth / Math)

// 1. Basic Unary Intrinsics
a1 = abs -42
prnt a1
a2 = mth.abs -15.5
prnt a2
c1 = ceil 3.2
prnt c1
f1 = floor 3.8
prnt f1
r1 = round 3.6
prnt r1
r2 = round 3.2
prnt r2
t1 = trunc 3.9
prnt t1
t2 = trunc -3.9
prnt t2

// 2. Sqrt & Pow
s1 = sqrt 16
prnt s1
s2 = mth.sqrt 25
prnt s2
p1 = pow 2, 3
prnt p1
p2 = mth.pow 3, 2
prnt p2

// 3. Min & Max
mx1 = max 10, 20
prnt mx1
mx2 = mth.max 5, 3
prnt mx2
mn1 = min 10, 20
prnt mn1
mn2 = mth.min 5, 3
prnt mn2

// 4. Trigonometry
sn1 = sin 0
prnt sn1
cs1 = cos 0
prnt cs1
tn1 = tan 0
prnt tn1
asn1 = asin 0
prnt asn1
acs1 = acos 1
prnt acs1
atn1 = atan 0
prnt atn1
atn2 = atan2 0, 1
prnt atn2

// 5. Log & Exp
l1 = log 1
prnt l1
e1 = exp 0
prnt e1

// 6. Constants
prnt (mth.PI > 3.14 and mth.PI < 3.15)
prnt (Math.PI > 3.14 and Math.PI < 3.15)
prnt (PI > 3.14 and PI < 3.15)
prnt (mth.E > 2.71 and mth.E < 2.72)
prnt (E > 2.71 and E < 2.72)
prnt (mth.SQRT2 > 1.41 and mth.SQRT2 < 1.42)

// 7. Random
rnd = mth.rand
prnt (rnd >= 0 and rnd < 1)
