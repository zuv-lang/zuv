flagTrue = true
flagFalse = false

lg "Testing boolean literals:"
lg flagTrue
lg flagFalse
if flagTrue {
    lg "flagTrue is yes"
}

if flagFalse {
    lg "ERROR: flagFalse triggered"
} els {
    lg "flagFalse is no"
}

if flagTrue && !flagFalse {
    lg "Symbol && and ! work correctly"
}

if flagFalse || flagTrue {
    lg "Symbol || works correctly"
}

