imp arr

users = []

greet name {
    -> "hi " + name
}

obj User {
    name: str,
    age: num,
    status: bool,
    no: i64,
    id: num,
    tags: str[],
    address: {
        city: str,
        zip: num,
        geo: {
            lat: num,
            lon: num
        }
    },
    scores: num[][],
    option: {
        role: str,
        level: num
    },

    fullLabel: => {
        -> self.name
    },
    create: n, a, status, no => {
        u = User{ name: n, age: a, status: status, no: no }
        users.psh(u)
        -> u
    },
    add: n, a, status, no => {
        u = User{ name: n, age: a, status: status, no: no }
        users.psh(u)
        -> u
    },
    get: i => {
        -> users[i]
    },
    update: i, n, a, status, no => {
        users[i] = User{ name: n, age: a, status: status, no: no }
        -> users[i]
    },
    arrowMethod: i => users[i],
    twoLineArowMethod: i => 
        users[i],
    multiLineArowMethod: i => 
        s ='daddsdd'
        -> s,
    delete: i => {
        out = []
        j = 0
        wh j < users.ln {
            if j != i {
                out.psh users[j]
            }
            j = j + 1
        }
        users = out
        -> users
    },

    greet,
    hello: greet
}

User.bumpAge a {
    self.age = self.age + a
    -> self
}

sayBye {
    -> "bye"
}
User.sayBye = sayBye

User.add "Ada", 30, true, 1001
User.add "Bob", 25, false, 1002
prnt users.ln

u = User.get 0
lbl = u.fullLabel
prnt lbl
prnt `name: ${u.name}`
prnt `age: ${u.age}`
prnt `status: ${u.status}`
prnt `no: ${u.no}`

u2 = User.update 0, "AdaL", 36, true, 1001

lbl2 = u2.fullLabel
prnt lbl2

User.delete 1
prnt users.ln

u3 = User.create "Eve", 20
prnt u3.age
msg = u3.greet "Eve"
prnt msg
msg2 = u3.hello "Eve"
prnt msg2

u4 = User.create "Zoe", 10
u4 = u4.bumpAge 5
prnt u4.age
prnt u4.sayBye

u1 = new User{ name: "Alice", age: 28 }
u1.fullLabel

prnt u1

u5 = new User({ name: "Alice", age: 28 })

prnt u5.fullLabel

prnt`========u6========`
u6 = new User({ name: "Alice", age: 28 }).fullLabel

prnt u6

rec = { title: "Zuv", version: 2, isFast: true }
prnt rec

rec2 = { active: false, count: 0, tag: "demo" }
prnt rec2

prnt`====arrowMethod====`
prnt u5.arrowMethod


prnt`====twoLineArowMethod====`
prnt u5.twoLineArowMethod

prnt`====multiLineArowMethod====`
prnt u5.multiLineArowMethod

prnt`====nested====`
nested = {
    id: 1,
    tags: ["a", "b", "c"],
    address: { city: "Paris", zip: 75001, geo: { lat: 48.85, lon: 2.35 } },
    scores: [ [1, 2], [3, 4] ]
}
prnt nested
prnt nested.address.city
prnt nested.address.geo.lat
prnt nested.tags[1]
prnt nested.scores[0][1]

inventory = [
    { name: "apple", stock: 10 },
    { name: "pear", stock: 5 }
]
prnt inventory.ln
prnt inventory[0].name
prnt inventory[1].stock

prnt`====u7 option====`
u7 = User{
    name: "Admin",
    age: 32,
    status: true,
    no: 2001,
    option: {
        role: "moderator",
        level: 5
    }
}
prnt u7.option.role
prnt u7.option.level
prnt u7

prnt`====u8 nested====`
u8 = User{
    name: "Dave",
    age: 40,
    status: true,
    no: 3001,
    id: 1,
    tags: ["a", "b", "c"],
    address: { city: "Paris", zip: 75001, geo: { lat: 48.85, lon: 2.35 } },
    scores: [ [1, 2], [3, 4] ],
    option: {
        role: "admin",
        level: 10
    }
}
prnt u8.address.city
prnt u8.address.geo.lat
prnt u8.tags[0]
prnt u8.scores[0][1]
prnt u8



