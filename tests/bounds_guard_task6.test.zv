// Task 6: Overflow Behavior — Safe Dynamic Expansion & Bounds Guard

mut mode = ""
if args.ln > 2 {
    mode = args[2]
} els if args.ln > 1 && args[1] != "tests/bounds_guard_task6.test.zv" && args[1] != "main.zv" {
    mode = args[1]
}
if mode != "" {
    if mode == "oob_read" {
        a = [10, 20, 30]
        x = a[10]
        exit 0
    }
    if mode == "neg_read" {
        a = [10, 20, 30]
        x = a[-1]
        exit 0
    }
    if mode == "oob_write" {
        a = [10, 20, 30]
        a[10] = 99
        exit 0
    }
    if mode == "neg_write" {
        a = [10, 20, 30]
        a[-1] = 99
        exit 0
    }
    if mode == "empty_read" {
        a = []
        x = a[0]
        exit 0
    }
    exit 0
}

// Parent Process Execution

// 1. In-Bounds Array Reads and Writes
arr = [100, 200, 300]
if arr[0] != 100 {
    panic "arr[0] != 100"
}
if arr[1] != 200 {
    panic "arr[1] != 200"
}
if arr[2] != 300 {
    panic "arr[2] != 300"
}
arr[1] = 555
if arr[1] != 555 {
    panic "arr[1] != 555"
}

// 2. Safe Dynamic Expansion (10,000 elements — far exceeding 1024-element buffer limit)
big = []
count = 10000
i = 0
wh i < count {
    big.psh i
    i = i + 1
}
if big.ln != 10000 {
    panic "big.ln != 10000"
}
if big[0] != 0 {
    panic "big[0] != 0"
}
if big[1023] != 1023 {
    panic "big[1023] != 1023"
}
if big[1024] != 1024 {
    panic "big[1024] != 1024"
}
if big[5000] != 5000 {
    panic "big[5000] != 5000"
}
if big[9999] != 9999 {
    panic "big[9999] != 9999"
}

// In-bounds mutation across expansion boundary
big[1024] = 88888
if big[1024] != 88888 {
    panic "big[1024] != 88888"
}

// 3. Optional Indexing (?.[i]) Safe Fallback
optArr = [10, 20, 30]
v0 = optArr?.[0]
if v0 != 10 {
    panic "optArr?.[0] != 10"
}
vOob = optArr?.[100]
if vOob != nil {
    panic "optArr?.[100] should be nil"
}
vNeg = optArr?.[-1]
if vNeg != nil {
    panic "optArr?.[-1] should be nil"
}
emptyArr = []
vEmpty = emptyArr?.[0]
if vEmpty != nil {
    panic "emptyArr?.[0] should be nil"
}
nilArr = nil
vNil = nilArr?.[0]
if vNil != nil {
    panic "nilArr?.[0] should be nil"
}

// 4. Subprocess Verification for Bounds Panic (exit code 101)
selfExe = args[0]
prnt "4. Verifying runtime bounds guard abortion on out-of-bounds access:"

c1 = sh("\"" + selfExe + "\" oob_read")
if c1 != 101 {
    panic "expected oob_read to exit with 101"
}
prnt "   - Positive out-of-bounds read aborts with exit code 101: OK"

c2 = sh("\"" + selfExe + "\" neg_read")
if c2 != 101 {
    panic "expected neg_read to exit with 101"
}
prnt "   - Negative index read aborts with exit code 101: OK"

c3 = sh("\"" + selfExe + "\" oob_write")
if c3 != 101 {
    panic "expected oob_write to exit with 101"
}
prnt "   - Positive out-of-bounds write aborts with exit code 101: OK"

c4 = sh("\"" + selfExe + "\" neg_write")
if c4 != 101 {
    panic "expected neg_write to exit with 101"
}
prnt "   - Negative index write aborts with exit code 101: OK"

c5 = sh("\"" + selfExe + "\" empty_read")
if c5 != 101 {
    panic "expected empty_read to exit with 101"
}
prnt "   - Empty array index read aborts with exit code 101: OK"

prnt "Task 6: All overflow behavior & bounds guard tests passed successfully!"
