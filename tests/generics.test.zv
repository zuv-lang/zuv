identity<T> x: T :: T {
    -> x
}

val = identity<num> 777
lg val
val = identity 777
lg "Generic function return value:"
lg val

identity2<T>(x: T): T {
    -> x
}

val = identity2<num>(777)
lg val
val = identity2(777)
lg "Generic function return value2:"
lg val

//multiple
pair<T, U>(x: T, y: U): [T, U] {
    ret [x, y]
}
p = pair(10, "hello")
lg "Pair value:"
lg p;
