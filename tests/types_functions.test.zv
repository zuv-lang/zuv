numbers: num[] = [1, 2, 3]
names: str[] = ["A", "B"]

obj Person {
    name: str,
    age: num
}

type Named = {
    name: str;
};

type Aged = {
    age: num;
};

type Agedi32 = {
    age: i32;
};

type Agedi64 = {
    age: i64;
};

type User = Named & Aged;
type Userwithagei32 = Named & Agedi32;
type Userwithagei64 = Named & Agedi64;

type UserWithId = Named & Aged & {
    id: num;
};

user : User = {
    name: "Rohit",
    age: 25
}

print_user user: User, type: str {
    lg `~~~~~~~~~~~~~`
    lg type
    lg user.name
    lg user.age
    lg `~~~~~~~~~~~~~`
}

print_user_default  user: User, type: str='default' {
    lg `~~~~~~~~~~~~~`
    lg type
    lg user.name
    lg user.age
    lg `~~~~~~~~~~~~~`
}

print_user_optional user: User, type?: str {
    lg `~~~~~~~~~~~~~`
    lg type ? type: 'no type'
    lg user.name
    lg user.age
    lg `~~~~~~~~~~~~~`
}

print_user_optional_without_type user, type? {
    lg `~~~~~~~~~~~~~`
    lg type ? type: 'no type'
    lg user.name
    lg user.age
    lg `~~~~~~~~~~~~~`
}

print_user_optional_with_default user, type ='default' {
    lg `~~~~~~~~~~~~~`
    lg type ? type: 'no type'
    lg user.name
    lg user.age
    lg `~~~~~~~~~~~~~`
}



// parenthises are optional in function calls
create_user_i32_paren(name: str, age: i32): Userwithagei32 {
    -> { name, age }
}

create_user_i64_paren(name: str, age: i64): Userwithagei64 {
    -> { name, age }
}

create_user_num_paren(name: str, age: num): User {
    -> { name, age }
}

// parenthises free
create_user_i32 name: str, age: i32 -> Userwithagei32 {
    -> { name, age }
}

create_user_i64 name: str, age: i64 -> Userwithagei64 {
    -> { name, age }
}

create_user_num name: str, age: num -> User {
    -> { name, age }
}

// create_user_num name: str, age: i64 -> User {
//     -> { name, age }
// }

users: User[] = [
    { name: "Rohit", age: 25 }
]

dd(a: num, b: num): num {
    -> a + b;
}

dd_bool(a: num, b: num): bool {
    -> true
}

dd_str(a: num, b: num): str {
    -> 'somestring'
}

greet(name: str): void {
    lg name
}

lg numbers[0]
lg names[0]
print_user user, 'user'
print_user_optional user
print_user_default user
print_user_optional_without_type user
print_user_optional_with_default user
unum = create_user_num "ZuvLang", 30
ui32 = create_user_i32 "ZuvLang", 30
ui64 = create_user_i64 "ZuvLang", 30

print_user unum, 'num'
print_user ui32, 'ui32'
print_user ui64, 'ui64'
unump = create_user_num_paren "ZuvLang", 30
ui32p = create_user_i32_paren "ZuvLang", 30
ui64p = create_user_i64_paren "ZuvLang", 30
print_user unump, 'nump'
print_user ui32p, 'ui32p'
print_user ui64p, 'ui64p'

u3 = new User { name: "Alice", age: 20 }
print_user u3, 'new'
lg users[0].name
sum = dd(10, 20)
lg sum
b = dd_bool(1, 2)
s = dd_str(1, 2)
lg s
greet("Done")

printoptional user: User, no: num, type: str {
    lg `~~~~~~~~~~~~~`
    lg no
    lg type
    lg user.name
    lg user.age
    lg `~~~~~~~~~~~~~`
}

printoptional unump, 1, 'nump'

printoptional2 user: User, no: num, type: str {
    lg `~~~~~~~~~~~~~`
    lg no
    lg type
    lg user.age
    lg `~~~~~~~~~~~~~`
}

printoptional2 unump, 2, 'nump'

printoptional3 user: User, no?: num, type?: str {
    lg `~~~~~~~~~~~~~`
    lg no ? no: 0
    lg type ? type: 'no type'
    lg user.age
    lg `~~~~~~~~~~~~~`
}

printoptional3 unump, 3, 'nump'

// =============================================================================
// Different Function Return Values Test Suite
// =============================================================================

enum StatusKind {
    Pending,
    Active,
    Completed
}

// 1. num return type (parenthesized and arrow syntax)
ret_num_val(a: num, b: num): num {
    -> a + b
}
ret_num_arrow a: num, b: num -> num {
    -> a * b
}

// 2. str return type
ret_str_val(prefix: str, suffix: str): str {
    -> prefix + " " + suffix
}
ret_str_arrow msg: str -> str {
    -> ">> " + msg
}

// 3. bool return type
ret_bool_val(flag: bool): bool {
    -> !flag
}
ret_bool_arrow a: num, b: num -> bool {
    -> a < b
}

// 4. i32 return type
ret_i32_val(a: i32, b: i32): i32 {
    -> a + b
}
ret_i32_arrow a: i32 -> i32 {
    -> a * 3
}

// 5. i64 return type
ret_i64_val(a: i64, b: i64): i64 {
    -> a + b
}
ret_i64_arrow a: i64 -> i64 {
    -> a * 10
}

// 6. void return type
ret_void_val(msg: str): void {
    lg "void call: " + msg
}
ret_void_arrow msg: str -> void {
    lg "void arrow: " + msg
}

// 7. Additional Zuv types: i8, u8, i16, ptr, T[], enum, any
ret_i8_val(x: i8): i8 {
    -> x
}

ret_u8_val(x: u8): u8 {
    -> x
}

ret_i16_val(x: i16): i16 {
    -> x
}

ret_num_arr(arr: num[]): num[] {
    -> arr
}

ret_str_arr(arr: str[]): str[] {
    -> arr
}

ret_any_val(x: any): any {
    -> x
}

// Invocations and verifications
lg 'ret_num_val'
lg ret_num_val(12.5, 7.5)

lg 'ret_num_arrow'
lg ret_num_arrow(3.0, 4.0)

lg 'ret_str_val'
lg ret_str_val("Zuv", "Language")

lg 'ret_str_arrow'
lg ret_str_arrow("testing")

lg 'ret_bool_val'
lg ret_bool_val(false)
lg 'ret_bool_arrow'
lg ret_bool_arrow(5, 10)

lg 'ret_i32_val'
lg ret_i32_val(15, 25)
lg 'ret_i32_arrow'
lg ret_i32_arrow(7)

lg 'ret_i64_val'
lg ret_i64_val(100, 250)
lg 'ret_i64_arrow'
lg ret_i64_arrow(42)

lg 'ret_void_val'
ret_void_val("executing void")
lg 'ret_void_arrow'
ret_void_arrow("executing void arrow")

lg 'ret_i8_val'
lg ret_i8_val(127)
lg 'ret_u8_val'
lg ret_u8_val(255)
lg 'ret_i16_val'
lg ret_i16_val(32000)
lg 'ret_num_arr'
numArr = ret_num_arr([100, 200, 300])
lg numArr[0]
lg numArr[2]
lg 'ret_str_arr'
strArr = ret_str_arr(["alpha", "beta", "gamma"])
lg strArr[0]
lg strArr[1]

lg "ret_any_val"
lg ret_any_val("any value")

// Enum datatype inspection via `typ` (returns "obj" for enum, "i8" for variant)
lg typ StatusKind
lg typ StatusKind.Completed
completedStatus = StatusKind.Completed
lg typ completedStatus

