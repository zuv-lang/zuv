lg 'ret_int_arrow'
lg ret_int_arrow(600)

lg 'ret_float_val'
lg ret_float_val(7.5)
lg 'ret_float_arrow'
lg ret_float_arrow(8.5)
lg 'ret_num_arr'
numArr = ret_num_arr([100, 200, 300])
lg numArr[0]
lg numArr[2]
lg 'ret_str_arr'
strArr = ret_str_arr(["alpha", "beta", "gamma"])
lg strArr[0]
lg strArr[1]

lg "ret_any_val"
lg ret_any_val("any value")

// Enum datatype inspection via `typ` (returns "obj" for enum, "i8" for variant)
lg typ StatusKind
lg typ StatusKind.Completed
let completedStatus = StatusKind.Completed
lg typ completedStatus

