isNan val :: bool {
    -> (val == val) == false
}

isFin val :: bool {
    if isNan val { -> false }
    if val == Infinity || val == 0 - Infinity { -> false }
    -> true
}

let n = nan
let p = Infinity
let q = Infinity
let ninf = 0 - Infinity

if isNan n {
    prnt "isNan nan ok"
}

let z0 = isNan 0
if z0 == false {
    prnt "isNan 0 false ok"
}

if isFin 1 {
    prnt "isFin 1 ok"
}

let zn = isFin n
if zn == false {
    prnt "isFin nan false ok"
}

let zp = isFin p
if zp == false {
    prnt "isFin inf false ok"
}

if p == q {
    prnt "inf == Infinity ok"
}

if p == ninf == false {
    prnt "+inf != -inf ok"
}

if (p == ninf) == false {
    prnt "+inf != -inf paren ok"
}

if isFin ninf == false {
    prnt "isFin -inf false ok"
}

if (isFin ninf) == false {
    prnt "isFin -inf paren ok"
}

if typ nan == "num" {
    prnt "typ nan ok"
}

if typ Infinity == "num" {
    prnt "typ inf ok"
}

if n == n == false {
    prnt "nan != nan ok"
}

if (n == n) == false {
    prnt "nan != nan paren ok"
}

prnt "nan inf test complete"
