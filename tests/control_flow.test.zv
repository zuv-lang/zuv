x = 15
if x > 10 {
    lg "x is greater than 10"
} els {
    lg "x is 10 or less"
}

count = 0
wh count < 5 {
    count = count + 1
    if count == 2 {
        cont
    }
    if count == 4 {
        brk
    }
    lg "while loop iteration:"
    lg count
}

lg "Testing fr loop:"
fr i = 0; i < 5; i++ {
    if i == 1 {
        cont
    }
    if i == 3 {
        brk
    }
    lg "for loop index:"
    lg i
}

// ── if / els if / els chain ──────────────────────────────────────────────────
grade = 85
if (grade >= 90) {
    prnt "grade A BAD"
} els if (grade >= 80) {
    prnt "els-if mid ok"
} els if (grade >= 70) {
    prnt "grade C BAD"
} els {
    prnt "grade F BAD"
}

low = 55
if (low >= 90) {
    prnt "low A BAD"
} els if (low >= 80) {
    prnt "low B BAD"
} els if (low >= 70) {
    prnt "low C BAD"
} els {
    prnt "els-if fallthrough ok"
}

top = 95
if (top >= 90) {
    prnt "els-if first ok"
} els if (top >= 80) {
    prnt "els-if first BAD"
} els {
    prnt "els-if first els BAD"
}

// ── nested if / els ──────────────────────────────────────────────────────────
n = 2
if (n > 0) {
    if (n == 2) {
        prnt "nested then ok"
    } els {
        prnt "nested then inner els BAD"
    }
} els {
    prnt "nested then outer els BAD"
}

m = 0
if (m > 0) {
    prnt "nested els outer then BAD"
} els {
    if (m == 0) {
        prnt "nested els ok"
    } els {
        prnt "nested els inner els BAD"
    }
}

a = 1
b = 2
if (a == 1) {
    if (b == 1) {
        prnt "nested deep BAD"
    } els if (b == 2) {
        prnt "nested els-if ok"
    } els {
        prnt "nested deep els BAD"
    }
} els {
    prnt "nested deep outer BAD"
}

// ── braceless single-statement if & els ─────────────────────────────────────
checkVal = 15

// 1. Single-line if
if checkVal > 10 prnt "single-line if ok"

// 2. Multi-line braceless if
if checkVal > 10
    prnt "multi-line braceless if ok"

// 3. Single-line if ... els ...
if checkVal < 0 prnt "single-line els BAD" els prnt "single-line els ok"

// 4. Multi-line braceless if ... els ...
if checkVal < 0
    prnt "multi-line els BAD"
els
    prnt "multi-line els ok"

// 5. Multi-line braceless if ... els if ... els ...
if checkVal == 1
    prnt "chain BAD 1"
els if checkVal == 15
    prnt "braceless els-if chain ok"
els
    prnt "chain BAD 2"

// 6. False condition must not swallow subsequent statement
gate = 5
if gate > 10
    prnt "gate BAD"
prnt "gate statement after braceless if ok"

// 7. Single-line wh loop
whCount = 0
wh whCount < 3 whCount = whCount + 1
if whCount == 3 prnt "single-line wh ok"

// 8. Multi-line braceless wh loop
whMulti = 0
wh whMulti < 3
    whMulti = whMulti + 1
if whMulti == 3 prnt "multi-line braceless wh ok"

prnt "control_flow test complete"
