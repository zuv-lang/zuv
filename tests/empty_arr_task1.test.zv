imp arr

// 1. Basic empty array creation and length
empty = []
prnt "Empty array length:"
prnt empty.len

// 2. Loop over empty array (should not execute body)
let loopRan = 0
fr item of empty {
    loopRan = loopRan + 1
}
prnt "Loop iterations over empty array:"
prnt loopRan

// 3. Lazy push onto empty array
let list = []
prnt "Initial list.len:"
prnt list.len
list.push 100
list.push 200
prnt "Length after 2 pushes:"
prnt list.len
prnt "First element:"
prnt list[0]
prnt "Second element:"
prnt list[1]

// 4. Pop from list
popped = list.pop
prnt "Popped element:"
prnt popped
prnt "Length after pop:"
prnt list.len

// 5. Pop from empty array (underflow guard)
let empty2 = []
empty2.pop
prnt "Empty array length after pop:"
prnt empty2.len

// 6. Function returning mutated array
addElem l, val {
    l.push val
    -> l
}

let fnArr = []
fnArr = addElem fnArr, 777
prnt "fnArr length after addElem:"
prnt fnArr.len
prnt "fnArr[0]:"
prnt fnArr[0]

// 7. Mass empty array allocation (zero heap overhead, fast)
let count = 0
let i = 0
wh i < 10000 {
    chunk = []
    count = count + chunk.len
    i = i + 1
}
prnt "Total length across 10000 empty arrays:"
prnt count

prnt "Task 1 Verification Passed!"
